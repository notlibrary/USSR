# --- layout and navigation
test_layout_and_navigation(r): [
    km_metrics(_m): 1024 700 1 false
    at(_v): _m 5
    eq(_): "rows" _v 8
    at(_v): _m 6
    eq(_): "columns" _v 10
    km_metrics(_m2): 2048 1400 2 true
    at(_v): _m2 4
    eq(_): "location bar moves the grid down" _v 64
    km_icon_at(_v): 109 173 _m 0 20
    eq(_): "icon under a point" _v 10
    km_icon_at(_v): 109 173 _m 1 20
    eq(_): "icon under a point, scrolled" _v 18
    km_icon_at(_v): 109 173 _m 0 5
    eq(_): "no icon past the last" _v {0 - 1}
    km_icon_at(_v): 3 3 _m 0 20
    eq(_): "no icon in the margin" _v {0 - 1}
    km_cell(_v): 10 _m 0
    joined(_v): _v
    eq(_): "cell corner" _v "104|168"
    km_nav(_v): 7 KM_KEY_DOWN 20 8 10
    eq(_): "down stops at the column end" _v 7
    km_nav(_v): 3 KM_KEY_DOWN 20 8 10
    eq(_): "down" _v 4
    km_nav(_v): 0 KM_KEY_UP 20 8 10
    eq(_): "up stops at the top" _v 0
    km_nav(_v): 0 KM_KEY_RIGHT 20 8 10
    eq(_): "right" _v 8
    km_nav(_v): 12 KM_KEY_RIGHT 20 8 10
    eq(_): "right into a short column" _v 19
    km_nav(_v): 17 KM_KEY_RIGHT 20 8 10
    eq(_): "right stops at the last column" _v 17
    km_nav(_v): 9 KM_KEY_LEFT 20 8 10
    eq(_): "left" _v 1
    km_nav(_v): 5 KM_KEY_END 20 8 10
    eq(_): "end" _v 19
    km_nav(_v): {0 - 1} KM_KEY_DOWN 20 8 10
    eq(_): "first arrow selects the first icon" _v 0
    km_nav(_v): 0 KM_KEY_DOWN 0 8 10
    eq(_): "nothing to select" _v {0 - 1}
    km_scroll_for(_v): 95 0 100 8 10
    eq(_): "scroll to show an icon" _v 2
    km_scroll_for(_v): 3 2 100 8 10
    eq(_): "scroll back" _v 0
    km_scroll_for(_v): {0 - 1} 9 100 8 10
    eq(_): "scroll stops at the last column" _v 3

    set(r): 0
]

# --- a scratch desktop
test_a_scratch_desktop(r): [
    set(_root): "tests/kremlin_tmp"
    remove_tree(_): _root
    getcwd(_cwd):
    km_slashes(_cwd): _cwd
    km_join(_root): _cwd _root
    kremlinreset(_): _root
    set(km_dryrun): true!
    kremlinitems(_v):
    joined(_v): _v
    eq(_): "first run makes a desktop" _v "Apps/|Documents/|Welcome.txt"
    km_join(_cfg): _root ".kremlin"
    file_exists(_v): _cfg
    eq(_): "first run saves the settings" _v true
    set(_v): km_source?
    km_ends_with(_v): _v "/src"
    eq(_): "the USSR source folder is found" _v true
    set(_pins): km_pins?
    joined(_v): _pins
    eq(_): "first run pins" _v "Apps/Terminal.kl|Apps/Files.kl|Apps/Calculator.kl|Apps/Home.kl"
    km_start_items(_menu):
    at(_v): _menu 0
    at(_v): _v 0
    eq(_): "the menu lists the apps" _v "Calculator"

    kremlinnewfolder(_v): "Projects"
    eq(_): "new folder" _v ""
    kremlinselected(_v):
    eq(_): "new folder is selected" _v "Projects/"
    kremlinnewfolder(_v): "Projects"
    eq(_): "new folder: name taken" _v "Something with that name is already here"
    kremlinnewfolder(_v): "a/b"
    eq(_): "new folder: bad name" _v "A name cannot contain slashes, colons, quotes or any of * ? < > |"
    kremlinnewfolder(_v): " "
    eq(_): "new folder: blank name" _v "Type a name"
    kremlinnewfile(_v): "notes.txt"
    eq(_): "new file" _v ""
    kremlinduplicate(_v): "notes.txt"
    eq(_): "duplicate" _v ""
    kremlinselected(_v):
    eq(_): "the copy is selected" _v "notes copy.txt"
    kremlinduplicate(_v): "notes.txt"
    kremlinselected(_v):
    eq(_): "second copy" _v "notes copy 2.txt"
    kremlinduplicate(_v): "Projects/"
    contains(_v): _v "cannot be duplicated"
    eq(_): "folders are not duplicated" _v true
    kremlinrename(_v): "notes copy.txt" "draft.txt"
    eq(_): "rename" _v ""
    kremlinselected(_v):
    eq(_): "renamed file is selected" _v "draft.txt"
    kremlinrename(_v): "draft.txt" "notes.txt"
    eq(_): "rename onto a name in use" _v "Something with that name is already here"
    kremlinitems(_v):
    joined(_v): _v
    eq(_): "listing, folders first" _v "Apps/|Documents/|Projects/|draft.txt|notes copy 2.txt|notes.txt|Welcome.txt"

    kremlinnewlauncher(_v): "Editor" "notepad notes.txt" false
    eq(_): "new launcher" _v ""
    kremlinselected(_v):
    eq(_): "launcher file" _v "Editor.kl"
    kremlinplan(_v): "Editor.kl"
    joined(_v): _v
    eq(_): "launcher plan" _v "launch|notepad|notes.txt|true"
    kremlinnewlauncher(_v): "Empty" "  " true
    eq(_): "launcher needs a command" _v "Type the command the launcher runs"
    kremlinrename(_v): "Editor.kl" "Writer"
    eq(_): "rename a launcher" _v ""
    kremlinselected(_v):
    eq(_): "a launcher keeps .kl" _v "Writer.kl"
    km_edit_launcher(_v): "Writer.kl" "wordpad" true
    kremlinplan(_v): "Writer.kl"
    joined(_v): _v
    eq(_): "edited launcher" _v "launch|wordpad||false"

    kremlinpin(_): "Writer.kl"
    kremlinpin(_): "Writer.kl"
    set(_pins): km_pins?
    len(_v): _pins
    eq(_): "pin once" _v 5
    at(_v): _pins 4
    eq(_): "pins are paths in the desktop" _v "Writer.kl"
    readfile(_txt): _cfg
    contains(_v): _txt "|Writer.kl"
    eq(_): "pins are saved" _v true
    kremlinpin(_): "Projects/"
    kremlinrename(_v): "Projects/" "Work"
    set(_pins): km_pins?
    at(_v): _pins 5
    eq(_): "a renamed folder stays pinned" _v "Work"
    kremlinselected(_v):
    eq(_): "renamed folder is selected" _v "Work/"
    kremlinunpin(_): "Writer.kl"
    set(_pins): km_pins?
    joined(_v): _pins
    contains(_v): _v "Writer"
    eq(_): "unpin" _v false

    kremlinplan(_p): "Work/"
    at(_v): _p 0
    eq(_): "a folder opens on the desktop" _v "folder"
    kremlinopenname(_v): "Work/"
    set(_v): km_dir?
    km_ends_with(_v): _v "/kremlin_tmp/Work"
    eq(_): "open a folder" _v true
    kremlinitems(_v):
    len(_v): _v
    eq(_): "it is empty" _v 0
    kremlinup(_v):
    eq(_): "back" _v true
    kremlinselected(_v):
    eq(_): "back selects the folder left" _v "Work/"
    kremlinup(_v):
    eq(_): "no back from the desktop" _v false

    km_join(_su): _root "hello.su"
    writefile(_): _su "print(_): 1\n"
    kremlinrefresh(_):
    kremlinplan(_p): "hello.su"
    at(_v): _p 0
    eq(_): "a script is started" _v "launch"
    at(_v): _p 2
    km_quote(_q): _su
    eq(_): "with its path" _v _q
    kremlinplan(_p): "notes.txt"
    at(_v): _p 1
    km_join(_txt): _root "notes.txt"
    eq(_): "a document opens with the system" _v _txt
    kremlinplan(_p): "missing.txt"
    at(_v): _p 0
    eq(_): "a missing file is an error" _v "error"
    kremlinopenname(_v): "Writer.kl"
    eq(_): "open a launcher" _v ""
    set(_log): km_launched?
    at(_v): _log 0
    joined(_v): _v
    eq(_): "it was started" _v "launch|wordpad||false"
    set(_v): km_status?
    eq(_): "and the panel says so" _v "Starting Writer"
    km_run(_v): "calc.exe /x \"a b\""
    set(_log): km_launched?
    at(_v): _log 1
    joined(_v): _v
    eq(_): "run a command" _v "launch|calc.exe|/x \"a b\"|false"

    kremlinselect(_): "Welcome.txt"
    km_type_ahead(_v): "d"
    kremlinselected(_v):
    eq(_): "typing jumps to a name" _v "Documents/"
    km_type_ahead(_v): "r"
    kremlinselected(_v):
    eq(_): "typing more narrows it" _v "draft.txt"

    km_toggle_sort(_):
    kremlinitems(_v):
    joined(_v): _v
    eq(_): "sort by type" _v "Apps/|Documents/|Work/|Writer.kl|hello.su|draft.txt|notes copy 2.txt|notes.txt|Welcome.txt"
    km_toggle_sort(_):

    kremlindelete(_v): "Apps/"
    contains(_v): _v "not empty"
    eq(_): "a full folder is not deleted" _v true
    kremlinselect(_): "Work/"
    kremlindelete(_v): "Work/"
    eq(_): "delete an empty folder" _v ""
    set(_pins): km_pins?
    joined(_v): _pins
    contains(_v): _v "Work"
    eq(_): "deleting unpins" _v false
    kremlinselected(_v):
    eq(_): "the next icon is selected" _v "draft.txt"
    kremlindelete(_v): "draft.txt"
    eq(_): "delete a file" _v ""
    km_index_of(_v): "draft.txt"
    eq(_): "it is gone" _v {0 - 1}

    km_autostart_text(_txt):
    contains(_v): _txt "kremlin/kremlin.su"
    km_windows(_win):
    if(_): _win [ contains(_v): _txt "kremlin\\kremlin.su" ]
    eq(_): "autostart runs kremlin.su" _v true
    contains(_v): _txt "kremlin_tmp"
    eq(_): "autostart opens this desktop" _v true

    km_cycle_wallpaper(_):
    set(_v): km_wall?
    eq(_): "next wallpaper" _v 1
    kremlinreset(_): _root
    set(_v): km_wall?
    eq(_): "settings survive a restart" _v 1

    remove_tree(_): _root
    file_exists(_v): _root
    eq(_): "scratch desktop removed" _v false
    set(r): 0
]

init(ret): arg_cnt arg_vec [
    test_paths_and_names(_):
    test_text(_):
    test_dates(_):
    test_launchers(_):
    test_settings(_):
    test_keys(_):
    test_layout_and_navigation(_):
    test_a_scratch_desktop(_):
    set(ret): 0
]
