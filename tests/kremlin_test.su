# Kremlin desktop engine: paths, kinds, labels, dates, launchers, settings,
# layout, keyboard navigation and the file operations on a scratch desktop
# in tests/kremlin_tmp. No window is needed and nothing is started
# (km_dryrun). Prints PASS or FAIL per check.
$include "../src/kremlin/kremlin.su"

eq(r): label got want [
    if(_): {got = want} [
        concat(_eq_line): "PASS " label
    ]
    else(_): [
        typeof(_eq_gt): got
        typeof(_eq_wt): want
        if(_): {_eq_gt != "string"} [ encode(got): got ]
        if(_): {_eq_wt != "string"} [ encode(want): want ]
        concat(_eq_line): "FAIL " label ": got " got ", want " want
    ]
    print(_): _eq_line
    set(r): 0
]

# The strings of v joined by "|".
joined(r): v [
    set(r): ""
    len(_jn_n): v
    set(_jn_i): 0
    while(_): {_jn_i < _jn_n} [
        at(_jn_x): v _jn_i
        typeof(_jn_t): _jn_x
        if(_): {_jn_t != "string"} [ encode(_jn_x): _jn_x ]
        if(_): {_jn_i > 0} [ concat(r): r "|" ]
        concat(r): r _jn_x
        set(_jn_i): {_jn_i + 1}
    ]
]

contains(r): s needle [
    str_find(_ct_i): s needle 0
    set(r): {_ct_i >= 0}
]

# Removes dir and everything in it (files, then folders deepest first).
remove_tree(r): dir [
    vec(_rt_dirs): ""
    push(_): _rt_dirs dir
    set(_rt_i): 0
    set(_rt_n): 1
    while(_): {_rt_i < _rt_n} [
        at(_rt_d): _rt_dirs _rt_i
        list_dir(_rt_names): _rt_d
        typeof(_rt_t): _rt_names
        if(_): {_rt_t = "vector"} [
            len(_rt_k): _rt_names
            set(_rt_j): 0
            while(_): {_rt_j < _rt_k} [
                at(_rt_name): _rt_names _rt_j
                km_strip_slash(_rt_plain): _rt_name
                km_join(_rt_p): _rt_d _rt_plain
                km_is_dir_name(_rt_isd): _rt_name
                if(_): _rt_isd [ push(_): _rt_dirs _rt_p ]
                else(_): [ remove_file(_): _rt_p ]
                set(_rt_j): {_rt_j + 1}
            ]
        ]
        len(_rt_n): _rt_dirs
        set(_rt_i): {_rt_i + 1}
    ]
    set(_rt_i): {_rt_n - 1}
    while(_): {_rt_i >= 0} [
        at(_rt_d): _rt_dirs _rt_i
        remove_dir(_): _rt_d
        set(_rt_i): {_rt_i - 1}
    ]
    set(r): 0
]

# --- paths and names
test_paths_and_names(r): [
    km_slashes(_v): "C:\\Users\\ivan\\kremlin"
    eq(_): "backslashes" _v "C:/Users/ivan/kremlin"
    km_parent(_v): "C:/Users/ivan"
    eq(_): "parent" _v "C:/Users"
    km_parent(_v): "C:/Users"
    eq(_): "parent of a top folder" _v "C:/"
    km_parent(_v): "C:/"
    eq(_): "parent of a drive" _v "C:/"
    km_parent(_v): "/home"
    eq(_): "parent of /home" _v "/"
    km_base(_v): "C:/Users/ivan/Apps/"
    eq(_): "base" _v "Apps"
    km_join(_v): "C:/" "kremlin"
    eq(_): "join at a drive" _v "C:/kremlin"
    km_join(_v): "/home/ivan" "kremlin"
    eq(_): "join" _v "/home/ivan/kremlin"
    km_strip_slash(_v): "Apps/"
    eq(_): "strip slash" _v "Apps"
    km_ext(_v): "Report.PDF"
    eq(_): "extension" _v "pdf"
    km_ext(_v): ".profile"
    eq(_): "dot file has no extension" _v ""
    km_ext(_v): "archive.tar.gz"
    eq(_): "last extension" _v "gz"
    km_ext(_v): "photos.2024/"
    eq(_): "folders have no extension" _v ""
    km_is_absolute(_v): "C:/x"
    eq(_): "absolute drive path" _v true
    km_is_absolute(_v): "Apps/Klin.kl"
    eq(_): "relative path" _v false

    km_kind(_v): "Apps/"
    eq(_): "kind folder" _v "folder"
    km_kind(_v): "Klin.kl"
    eq(_): "kind launcher" _v "launcher"
    km_kind(_v): "setup.EXE"
    eq(_): "kind program" _v "program"
    km_kind(_v): "game.su"
    eq(_): "kind code" _v "code"
    km_kind(_v): "notes.txt"
    eq(_): "kind text" _v "text"
    km_kind(_v): "cat.jpeg"
    eq(_): "kind image" _v "image"
    km_kind(_v): "plan.dxf"
    eq(_): "kind document" _v "document"
    km_kind(_v): "song.flac"
    eq(_): "kind audio" _v "audio"
    km_kind(_v): "backup.zip"
    eq(_): "kind archive" _v "archive"
    km_kind(_v): "README"
    eq(_): "kind file" _v "file"
    km_label(_v): "Calculator.kl"
    eq(_): "launcher label" _v "Calculator"
    km_label(_v): "Documents/"
    eq(_): "folder label" _v "Documents"
    km_hidden(_v): ".kremlin"
    eq(_): "settings file is hidden" _v true
    km_hidden(_v): "desktop.ini"
    eq(_): "desktop.ini is hidden" _v true
    km_hidden(_v): "Welcome.txt"
    eq(_): "files are shown" _v false

    set(r): 0
]

# --- text
test_text(r): [
    km_wrap_label(_v): "Calculator" 12
    joined(_v): _v
    eq(_): "short label, one line" _v "Calculator"
    km_wrap_label(_v): "Quarterly report final.txt" 12
    joined(_v): _v
    eq(_): "label breaks at a blank" _v "Quarterly|report fin.."
    km_wrap_label(_v): "abcdefghijklmnopq" 12
    joined(_v): _v
    eq(_): "label without blanks is cut" _v "abcdefghijkl|mnopq"
    km_fit(_v): "Programmer" 6
    eq(_): "fit" _v "Prog.."
    km_tail(_v): "Desktop/Apps/Games" 10
    eq(_): "tail" _v "..ps/Games"
    km_wrap_text(_v): "one two three four\n\nfive" 9
    joined(_v): _v
    eq(_): "wrap text" _v "one two|three|four||five"
    km_display(_v): "Привет, Ёлка.txt"
    eq(_): "Cyrillic is shown in Latin letters" _v "PRIVET, YOLKA.txt"
    km_display(_v): "Октябрь"
    eq(_): "soft signs drop out" _v "OKTYABR"
    km_display(_v): "café"
    eq(_): "other characters show as ?" _v "caf?"
    km_split(_v): "a||b" 124
    joined(_v): _v
    eq(_): "split keeps empty parts" _v "a||b"

    set(r): 0
]

# --- dates
test_dates(r): [
    km_weekday(_v): 2026 10 27
    eq(_): "27 Oct 2026 is a Tuesday" _v 2
    km_weekday(_v): 2000 1 1
    eq(_): "1 Jan 2000 is a Saturday" _v 6
    km_leap(_v): 2024
    eq(_): "2024 is a leap year" _v true
    km_leap(_v): 1900
    eq(_): "1900 is not" _v false
    km_leap(_v): 2000
    eq(_): "2000 is" _v true
    km_month_days(_v): 2026 2
    eq(_): "February 2026" _v 28
    km_month_days(_v): 2024 2
    eq(_): "February 2024" _v 29
    km_calendar(_cal): 2026 10
    at(_v): _cal 3
    eq(_): "October 2026 starts on Thursday" _v 1
    at(_v): _cal 2
    eq(_): "cells before the 1st are empty" _v 0
    at(_v): _cal 33
    eq(_): "31 October" _v 31
    at(_v): _cal 34
    eq(_): "cells after the last day are empty" _v 0
    vec(_t): ""
    push(_): _t 2026
    push(_): _t 10
    push(_): _t 27
    push(_): _t 9
    push(_): _t 5
    push(_): _t 0
    push(_): _t 2
    push(_): _t 300
    km_clock_text(_v): _t
    eq(_): "clock" _v "09:05"
    km_date_text(_v): _t
    eq(_): "date" _v "Tue 27 Oct"
    km_month_long(_v): 12
    eq(_): "month name" _v "December"
    localtime(_now):
    len(_v): _now
    eq(_): "localtime has eight fields" _v 8
    localtime(_v): 0
    at(_v): _v 0
    if(_): {_v = 1969} [ set(_v): 1970 ]
    eq(_): "localtime of 0" _v 1970

    set(r): 0
]

# --- launchers
test_launchers(r): [
    km_launcher_parse(_l): "# a launcher\nname: Klin\ncommand: ussr src/klin/klin.su\nconsole: no\n"
    joined(_v): _l
    eq(_): "parse launcher" _v "Klin|ussr src/klin/klin.su|false"
    km_launcher_parse(_l): "notepad.exe notes.txt\r\n"
    joined(_v): _l
    eq(_): "a plain line is the command" _v "|notepad.exe notes.txt|true"
    km_launcher_parse(_l): "C:/Tools/app.exe --fast"
    at(_v): _l 1
    eq(_): "a drive path is not a key" _v "C:/Tools/app.exe --fast"
    km_launcher_text(_txt): "Klin" "ussr klin.su" false
    km_launcher_parse(_l): _txt
    joined(_v): _l
    eq(_): "launcher text round trip" _v "Klin|ussr klin.su|false"
    km_split_command(_v): "ussr src/klin/klin.su sci"
    joined(_v): _v
    eq(_): "split command" _v "ussr|src/klin/klin.su sci"
    km_split_command(_v): "\"C:/Program Files/App/app.exe\"  -x \"a b\""
    joined(_v): _v
    eq(_): "split quoted command" _v "C:/Program Files/App/app.exe|-x \"a b\""
    km_split_command(_v): "notepad"
    joined(_v): _v
    eq(_): "command without arguments" _v "notepad|"

    set(r): 0
]

