# Omsk thumbnails: decodes small PNG pictures (made by Pillow,
# base64 below), shrinks them into 200x200 and 8x8 boxes, and prints each
# thumbnail's size and the CRC-32 of the JPEG that Omsk wrote for it. The
# thumbnails are read back by Omsk too, and the pictures it must refuse
# say why.
$include "../src/omsk/omsk.su"

show(r): name text side [
    omsk_thumb_base64(t): text side
    if(_): {t = null} [
        omsk_error(e):
        str_from_int(ss): side
        concat(s): name " " ss ": refused (" e ")"
        print(_): s
        set(r): 1
        return(r): r
    ]
    at(w): t 0
    at(h): t 1
    at(tw): t 2
    at(th): t 3
    at(b64): t 4
    omsk_unbase64(jpeg): b64
    crc32(c): jpeg
    len(n): jpeg
    omsk_thumb(again): jpeg 200
    set(back): "not readable"
    set(ok): false
    if(_): {again != null} [
        at(aw): again 0
        at(ah): again 1
        set(ok): {aw = tw && ah = th}
    ]
    if(_): ok [
        set(back): "reads back"
    ]
    str_from_int(ss): side
    str_from_int(w): w
    str_from_int(h): h
    str_from_int(tw): tw
    str_from_int(th): th
    str_from_int(n): n
    str_from_int(c): c
    concat(s): name " " ss ": " w "x" h " -> " tw "x" th ", " n " bytes, crc " c ", " back
    print(_): s
    set(r): 0
]

init(ret): arg_cnt arg_vec [
    set(img): ""
    show(_): "pngrgba" img 200
    show(_): "pngrgba" img 8
    set(img): "iVBORw0KGgoAAAANSUhEUgAAABAAAAAMBAMAAACZySCyAAAAMFBMVEXE3Kw330SRgYfuOj36HijuDCKhHWAlH84AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABiiDulAAAACHRSTlMAgP///////8/q9PAAAABQSURBVHicRcrBCYUwFAXR4/OvBTuxO6uxJbECtYO4FpJI/AsvDHcW081IkkBtBHmV6xFsToeQKZu3aau/95I97oWi6Eb9tA5nE+r1xX+58ABBXhm6fMHscAAAAABJRU5ErkJggg=="
    show(_): "pngpal" img 200
    show(_): "pngpal" img 8
    set(img): ""
    show(_): "pnggray16" img 200
    omsk_fit(d): 2048 1536 200
    encode(s): d
    concat(s): "fit 2048x1536: " s
    print(_): s
    omsk_fit(d): 30 4000 200
    encode(s): d
    concat(s): "fit 30x4000: " s
    print(_): s
    text_bytes(v): "Omsk"
    omsk_base64(s): v
    omsk_unbase64(back): s
    bytes_text(t): back
    concat(s): "base64: " s " " t
    print(_): s
    omsk_unbase64(bad): "abc"
    omsk_unbase64(bad2): "ab=c"
    encode(bad): bad
    encode(bad2): bad2
    concat(s): "bad base64: " bad " " bad2
    print(_): s
    show(_): "text" "aGVsbG8gd29ybGQh" 200
    set(omsk_max_pixels): 100
    set(img): ""
    show(_): "limit" img 200
    set(ret): 0

]
