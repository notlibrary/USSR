# Quadratic equation test

sqrt(root): x [
	if(done): {x == 0} [
	return(done): 0
	]

	set(guess): x
	set(i): 0

	while(done): {i < 20} [
		set(guess): {(guess + x / guess) / 2}
		set(i): {i + 1}
	]

	return(root): guess


]

solve(root): a b c [
	if(done): {a == 0} [
	print(out): "error: a must not be zero"
	return(done): 0
	]


	set(d): {b * b - 4 * a * c}

	if(done): {d < 0} [
		print(out): "error: complex roots"
		return(done): 0
	]

	sqrt(s): d

	set(x1): {(-b + s) / (2 * a)}
	set(x2): {(-b - s) / (2 * a)}

	print(out): x1
	print(out): x2

	return(done): 1


]

init(ret): arg_count arg_vec [
	print(out): "Quadratic equation: a*x^2 + b*x + c = 0"
	scan(ret): "Enter a b c: REAL;REAL;REAL" a b c

	solve(ret): a b c
]
