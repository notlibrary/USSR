]

tm_scale(r): [
    # 10 000 names sort and filter
    vec(be): ""
    set(bi): 0
    while(_): {bi < 10000} [
        str_from_int(bs): {(bi * 7919) % 10000}
        concat(bn): "file" bs ".txt"
        vec(e): ""
        push(_): e bn
        push(_): e bi
        push(_): be e
        set(bi): {bi + 1}
    ]
    tvm_sort(bs2): be "name" false true
    at(bv): bs2 0
    at(bv): bv 0
    tm_check(_): "10 000 names sorted" bv "file0.txt"
    vec(bn2): ""
    len(bnn): bs2
    set(bi): 0
    while(_): {bi < bnn} [
        at(e): bs2 bi
        at(nm): e 0
        push(_): bn2 nm
        set(bi): {bi + 1}
    ]
    tvm_jump(bv): bn2 "file9999" 0
    tm_check(_): "and searched" bv 9999
    # odd names: pipes, backslashes, spaces, Cyrillic
    tm_root(br):
    path_join(bd): br "odd"
    make_dir(_): bd
    str_split(odd): "a|b.txt;back\\slash.txt;  spaced  .txt;файл.txt" ";"
    set(made): 0
    len(on): odd
    set(bi): 0
    while(_): {bi < on} [
        at(nm): odd bi
        tvm_new_file(w): bd nm
        if(_): {w = ""} [ set(made): {made + 1} ]
        set(bi): {bi + 1}
    ]
    tm_check(_): "odd names that can be made" {made >= 2} true
    tvm_rename(bv): bd "файл.txt" "файл2.txt"
    tm_check(_): "a Cyrillic rename" bv ""
    tver_escape(bv): "a|b\\c"
    tm_check(_): "list separators escaped" bv "a\\|b\\\\c"
    tvm_tui(bv): "/left" bn2 0 "/right" bn2 1 0 20 4
    str_split(bl): bv "\n"
    at(bv): bl 0
    tm_check(_): "a terminal view" bv "┌*/left ─┐┌ /right ┐"
    set(r): 0
]

init(ret): arg_cnt arg_vec [
    set(ret): 0
    tm_root(ir):
    tvm_delete_tree(_): ir
    tm_files(_):
    tm_zip(_):
    tm_view(_):
    tm_moving(_):
    tm_marks(_):
    tm_tools(_):
    tm_settings(_):
    tm_scale(_):
    tvm_delete_tree(_): ir
    file_exists(gone): ir
    tm_check(_): "scratch removed" gone false
]
