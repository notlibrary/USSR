    sm_is(_): "user function" "=USSR(\"sm_double_all\",5)" "10"
    sm_is(_): "unknown" "=NOSUCH(1)" "#NAME?"
    sbm_define(_): "amounts" "B1:B4"
    sbm_define(_): "first" "B1"
    sm_is(_): "names" "=SUM(Amounts)" "100"
