# Siberia refine pass 1 (src/siberia/more.su), with no window: lookups,
# conditional aggregates, text, dates, maths, statistics, logic, finance,
# regression, bits and bases, SUBTOTAL, USSR() user functions, named
# ranges; sort, find and replace, fill series, inserting and deleting rows
# and columns, removing duplicates, transposing, text to columns, goal
# seek, the error checker, precedents and dependents, scenarios, undo and
# redo, number formats, CSV options and Windows-1251, HTML and Markdown,
# the command line, and a formula fuzz test. Run from the repository root.
$include "../src/siberia/siberia.su"

sm_check(r): label got want [
    set(r): 0
    if(_): {got = want} [ concat(smc_line): "PASS " label ]
    else(_): [
        set(smc_g): got
        set(smc_w): want
        typeof(smc_gt): got
        typeof(smc_wt): want
        if(_): {smc_gt != "string"} [ encode(smc_g): got ]
        if(_): {smc_wt != "string"} [ encode(smc_w): want ]
        concat(smc_line): "FAIL " label ": got " smc_g ", want " smc_w
    ]
    print(_): smc_line
]

# a formula's shown value, in A100
sm_eval(r): formula [
    sbset(_): "A100" formula
    sbshow(r): "A100"
]

sm_is(r): label formula want [
    sm_eval(sm_got): formula
    concat(sm_label): label " " formula
    sm_check(r): sm_label sm_got want
]

# a definition a cell calls through USSR()
sm_double_all(r): vals [
    set(r): 0
    len(n): vals
    set(i): 0
    while(_): {i < n} [
        at(v): vals i
        set(r): {r + v * 2}
        set(i): {i + 1}
    ]
]

sm_sum_first(r): vals [
    at(v): vals 0
    at(a): v 0
    at(b): v 1
    set(r): {a + b}
]

sm_data(r): [
    sbsheetreset(_):
    # A: names, B: amounts, C: regions, D: x, E: y
    sbset(_): "A1" "apple"
    sbset(_): "A2" "banana"
    sbset(_): "A3" "cherry"
    sbset(_): "A4" "date"
    sbset(_): "B1" "10"
    sbset(_): "B2" "20"
    sbset(_): "B3" "30"
    sbset(_): "B4" "40"
    sbset(_): "C1" "north"
    sbset(_): "C2" "south"
    sbset(_): "C3" "north"
    sbset(_): "C4" "south"
    sbset(_): "D1" "1"
    sbset(_): "D2" "2"
    sbset(_): "D3" "3"
    sbset(_): "D4" "4"
    sbset(_): "E1" "3"
    sbset(_): "E2" "5"
    sbset(_): "E3" "7"
    sbset(_): "E4" "9"
    set(r): 0
]

sm_functions(r): [
