    sm_is(_): "text" "=TEXT(1234.5,\"#,##0.00\")" "1,234.50"
    sm_is(_): "text" "=TEXT(0.256,\"0.0%\")" "25.6%"
    sm_is(_): "text" "=TEXT(12345,\"0.00E+00\")" "1.23E+04"
    sm_is(_): "text" "=TEXT(DATE(2026,11,17),\"yyyy-mm-dd\")" "2026-11-17"
    sm_is(_): "text" "=TEXT(0.75,\"hh:mm\")" "18:00"
    sm_is(_): "text" "=VALUE(\"42.5\")+1" "43.5"
    sm_is(_): "text" "=REPT(\"ab\",3)" "ababab"
    sm_is(_): "text" "=PROPER(\"hello big world\")" "Hello Big World"
    sm_is(_): "text" "=EXACT(\"a\",\"A\")" "FALSE"
    sm_is(_): "dates" "=DATE(2026,11,17)" "46343"
