]

sm_tools(r): [
    sm_data(_):
    vec(keys): ""
    vec(k): ""
    push(_): k 2
    push(_): k true
    push(_): keys k
    vec(k2): ""
    push(_): k2 1
    push(_): k2 false
    push(_): keys k2
    sbm_sort(_): 0 0 3 4 keys
    sbget(v): "A1"
    sbget(v2): "A2"
    sm_check(_): "sort by region, then amount down" {v = "cherry" && v2 = "apple"} true
    sbm_undo(n):
    sbget(v): "A1"
    sm_check(_): "undo the sort" v "apple"
    sbm_redo(_):
    sbget(v): "A1"
    sm_check(_): "redo it" v "cherry"
    sbm_undo(_):

    sbm_find(hits): "AN" false
    encode(v): hits
    sm_check(_): "find" v "[`A2`]"
    sbm_replace(n): "north" "N"
    sm_check(_): "replace" n 2
    sbget(v): "C3"
    sm_check(_): "replaced" v "N"
    sbm_undo(_):
    sbget(v): "C3"
    sm_check(_): "undo the replace" v "north"

    sbset(_): "H1" "1"
    sbset(_): "H2" "3"
    sbm_fill(_): 0 7 4 7 "down" 2
    sbget(v): "H5"
    sm_check(_): "a number series" v "9"
    sbset(_): "I1" "Mon"
    sbm_fill(_): 0 8 2 8 "down" 1
    sbget(v): "I3"
    sm_check(_): "weekdays" v "Wed"
    sbset(_): "J1" "Item9"
    sbm_fill(_): 0 9 1 9 "down" 1
    sbget(v): "J2"
    sm_check(_): "text with a number" v "Item10"
    sbset(_): "K1" "=B1*2"
    sbm_fill(_): 0 10 3 10 "down" 1
    sbget(v): "K4"
    sm_check(_): "a formula filled down" v "=B4*2"
    sbshow(v): "K4"
    sm_check(_): "and its value" v "80"
    sbset(_): "L1" "=$B$1+B1"
    sbm_fill(_): 0 11 0 12 "right" 1
    sbget(v): "M1"
    sm_check(_): "absolute references stay" v "=$B$1+C1"

    sbset(_): "F1" "=SUM(B1:B4)"
    sbm_insert(_): "row" 1 2
    sbget(v): "F1"
    sm_check(_): "rows inserted: the range grows" v "=SUM(B1:B6)"
    sbget(v): "A4"
    sm_check(_): "the rows moved down" v "banana"
    sbshow(v): "F1"
    sm_check(_): "the sum is the same" v "100"
    sbm_insert(_): "row" 1 -2
    sbget(v): "F1"
    sm_check(_): "and deleted again" v "=SUM(B1:B4)"
    sbset(_): "F2" "=B2+1"
    sbm_insert(_): "row" 1 -1
    sbget(v): "F1"
    sm_check(_): "a range shrinks" v "=SUM(B1:B3)"
    sbshow(v): "F1"
    sm_check(_): "without banana" v "80"
    sbget(v): "F1"
    sbm_insert(_): "col" 0 1
    sbget(v): "G1"
    sm_check(_): "a column inserted" v "=SUM(C1:C3)"

    sbsheetreset(_):
    sbset(_): "A1" "x"
    sbset(_): "A2" "y"
    sbset(_): "A3" "x"
    sbset(_): "A4" "z"
    sbset(_): "A5" "y"
    sbm_dedupe(n): 0 0 4 0
    sm_check(_): "duplicates removed" n 2
    sbget(v): "A3"
    sm_check(_): "what is left" v "z"
    sbm_transpose(_): 0 0 2 0 0 2
    sbget(v): "E1"
    sm_check(_): "transposed" v "z"
    sbset(_): "A10" "Ivanov, Ivan, 1990"
    sbm_text_to_columns(_): 9 9 0 ","
    sbget(v): "C10"
    sm_check(_): "text to columns" v "1990"

    sbsheetreset(_):
    sbset(_): "A1" "2"
    sbset(_): "B1" "=A1^2+3"
    sbm_goal_seek(v): "B1" 19 "A1"
    sbshow(v): "A1"
    sm_check(_): "goal seek" v "4"
    sbset(_): "C1" "=1/0"
    sbset(_): "C2" "=nosuch(1)"
    sbm_errors(errs):
    len(v): errs
    sm_check(_): "the error checker" v 2
    at(e): errs 0
    at(v): e 2
    sm_check(_): "says why" v "a division by zero"
    sbset(_): "D1" "=A1+SUM(A1:B1)"
    sbm_precedents(ps): "D1"
    encode(v): ps
    sm_check(_): "precedents" v "[`A1`,`A1:B1`]"
    sbm_dependents(ds): "A1"
    encode(v): ds
    sm_check(_): "dependents" v "[`B1`,`D1`]"
    vec(cells): ""
    push(_): cells "A1"
    sbm_scenario_save(_): "base" cells
    sbset(_): "A1" "10"
    sbm_scenario_apply(_): "base"
    sbget(v): "A1"
    sm_check(_): "a scenario" v "4"
    sbm_stats(v): 0 0 0 1
    sm_check(_): "selection stats" v "Sum 23  Average 11.5  Count 2"
    set(r): 0
]

sm_files(r): [
    sbsheetreset(_):
    sbm_csv_load(n): "name;amount\n\"a;b\";1,5\nc;2\n" ";" "\"" true true
    sm_check(_): "CSV with ; and a header" n 2
    sbget(v): "A1"
    sm_check(_): "a quoted field" v "a;b"
    sbshow(v): "B1"
    sm_check(_): "a decimal comma" v "1.5"
    sbm_csv_text(t): ";" true false
    sm_check(_): "CSV out with a decimal comma" t "\"a;b\";1,5\nc;2\n"
    sbm_csv_text(t): "," false true
    text_bytes(tb): t
    at(v): tb 0
    sm_check(_): "a BOM" v 239
    vec(win): ""
    push(_): win 207
    push(_): win 240
    push(_): win 232
    push(_): win 226
    push(_): win 229
    push(_): win 242
    push(_): win 185
    sbm_from_cp1251(v): win
    sm_check(_): "Windows-1251 in" v "Привет№"
    sbm_to_cp1251(back): v
    encode(v): back
    sm_check(_): "and out" v "[207,240,232,226,229,242,185]"
    sbm_html(h):
    str_contains(v): h "<td>a;b</td><td align=\"right\">1.5</td>"
    sm_check(_): "HTML" v true
    sbm_markdown(m):
    str_starts(v): m "| a;b | 1.5 |\n|---|---|\n"
    sm_check(_): "Markdown" v true

    # the command line
    sbsheetreset(_):
    sbset(_): "A1" "6"
    sbset(_): "A2" "=A1*7"
    sbsheetcsv(c):
    writefile(_): "tests/siberia-more-tmp.csv" c
    vec(args): ""
    push(_): args "--convert"
    push(_): args "tests/siberia-more-tmp.csv"
    push(_): args "tests/siberia-more-tmp.fods"
    sbm_cli(v): args
    sm_check(_): "--convert" v 0
    vec(args): ""
    push(_): args "--eval"
    push(_): args "tests/siberia-more-tmp.fods"
    push(_): args "Sheet1.A2"
    sbm_cli(v): args
    sm_check(_): "--eval" v 0
    vec(args): ""
    push(_): args "--open"
    sbm_cli(v): args
    sm_check(_): "other options: not the command line's" v -1
    remove_file(_): "tests/siberia-more-tmp.csv"
    remove_file(_): "tests/siberia-more-tmp.fods"

    sbsheetreset(_):
    sbm_format(v): 1234567.891 "#,##0.00"
    sm_check(_): "a number format" v "1,234,567.89"
    sbm_format(v): -0.5 "0%"
    sm_check(_): "a negative percent" v "-50%"
    sbm_format(v): 46343.5 "dd.mm.yyyy hh:mm"
    sm_check(_): "a date and time" v "17.11.2026 12:00"
    sbm_format(v): 3 "$#,##0.00"
    sm_check(_): "currency" v "$3.00"
    set(r): 0
]

sm_fuzz(r): [
    sbsheetreset(_):
    sbset(_): "A1" "5"
    vec(parts): ""
    str_split(parts): "A1 1 2.5 + - * / ^ & = < > <> ( ) , SUM( IF( VLOOKUP( \"x\" TRUE B2:C3 % : ; LEFT( TEXT( DATE( NAME" " "
    len(np): parts
    set(seed): 99
    set(bad): 0
    set(k): 0
    while(_): {k < 250} [
        set(f): "="
        set(seed): {(seed * 1103515245 + 12345) % 2147483648}
        set(len_): {seed % 8 + 1}
        set(i): 0
        while(_): {i < len_} [
            set(seed): {(seed * 1103515245 + 12345) % 2147483648}
            at(p): parts {seed % np}
            concat(f): f p
            set(i): {i + 1}
        ]
        sbset(_): "B1" f
        sbshow(v): "B1"
        typeof(t): v
        if(_): {t != "string"} [ set(bad): {bad + 1} ]
        set(k): {k + 1}
    ]
    sm_check(_): "random formulas never stop the sheet" bad 0
    set(r): 0
]

init(ret): arg_cnt arg_vec [
    set(ret): 0
    sbsetup(_):
    sm_functions(_):
    sm_tools(_):
    sm_files(_):
    sm_fuzz(_):
]
