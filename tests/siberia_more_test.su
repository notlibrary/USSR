    sm_is(_): "lookup" "=VLOOKUP(\"cherry\",A1:B4,2,FALSE)" "30"
    sm_is(_): "lookup" "=VLOOKUP(\"kiwi\",A1:B4,2,0)" "#N/A"
    sm_is(_): "lookup" "=VLOOKUP(25,B1:C4,2)" "south"
    sm_is(_): "lookup" "=HLOOKUP(\"south\",C2:D2,2,0)" "#REF!"
    sm_is(_): "lookup" "=INDEX(A1:B4,3,2)" "30"
    sm_is(_): "lookup" "=MATCH(\"date\",A1:A4,0)" "4"
    sm_is(_): "lookup" "=MATCH(25,B1:B4)" "2"
    sm_is(_): "lookup" "=XLOOKUP(\"banana\",A1:A4,B1:B4)" "20"
    sm_is(_): "lookup" "=XLOOKUP(\"kiwi\",A1:A4,B1:B4,\"none\")" "none"
    sm_is(_): "conditional" "=SUMIF(C1:C4,\"north\",B1:B4)" "40"
    sm_is(_): "conditional" "=SUMIF(B1:B4,\">15\")" "90"
    sm_is(_): "conditional" "=COUNTIF(A1:A4,\"*an*\")" "1"
    sm_is(_): "conditional" "=COUNTIF(A1:A4,\"?????\")" "1"
    sm_is(_): "conditional" "=AVERAGEIF(C1:C4,\"south\",B1:B4)" "30"
    sm_is(_): "conditional" "=SUMIFS(B1:B4,C1:C4,\"north\",B1:B4,\">10\")" "30"
    sm_is(_): "conditional" "=COUNTIFS(C1:C4,\"south\",D1:D4,\"<>2\")" "1"
    sm_is(_): "text" "=LEFT(\"Siberia\",3)" "Sib"
    sm_is(_): "text" "=RIGHT(\"Сибирь\",3)" "ирь"
    sm_is(_): "text" "=MID(\"Novosibirsk\",5,4)" "sibi"
    sm_is(_): "text" "=FIND(\"b\",\"abcabc\",3)" "5"
    sm_is(_): "text" "=SEARCH(\"B\",\"abc\")" "2"
    sm_is(_): "text" "=FIND(\"z\",\"abc\")" "#VALUE!"
    sm_is(_): "text" "=SUBSTITUTE(\"a-b-c\",\"-\",\"+\")" "a+b+c"
    sm_is(_): "text" "=SUBSTITUTE(\"a-b-c\",\"-\",\"+\",2)" "a-b+c"
