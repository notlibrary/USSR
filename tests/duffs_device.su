# Duff's device analogue in USSR.
#
# tests/duffs_device.su
#
# Sums 1..n with a loop body unrolled four times. The first pass jumps
# into the middle of the unrolled body (choose/option fall through like
# C's switch/case), so later passes always run all four copies. As in C,
# n must be at least 1: the do/loop body runs once before the test.

set(n): 10
set(i): 0
set(r): 0

set(entry): {n % 4}
if(_): {entry = 0} [
    set(entry): 4
]

do(_): 1 [
    choose(_): entry
    option(_): 4
    set(i): {i + 1}
    set(r): {r + i}
    option(_): 3
    set(i): {i + 1}
    set(r): {r + i}
    option(_): 2
    set(i): {i + 1}
    set(r): {r + i}
    option(_): 1
    set(i): {i + 1}
    set(r): {r + i}
    set(entry): 4
]
loop(_): {i < n}

print(_): r
