# Lenin: its text helpers, and a whole run with no network: USSR_AI_URL points
# curl at canned file:// replies in tests/ai/, as tests/prompt.su does. One model
# answers with code that fails the test, two with code that passes, one is down.
# Run from the repository root:
#     ussr tests/lenin_test.su
$include "../src/lenin/lenin.su"

check(r): label got want [
    set(r): 0
    if(_): {got = want} [ concat(line): "PASS " label ]
    else(_): [
        encode(g): got
        encode(w): want
        concat(line): "FAIL " label ": got " g ", want " w
    ]
    print(_): line
]

fixture(url): name [
    getcwd(d):
    byte(b): d 0
    set(u): "file:///"
    if(_): {b = 47} [ set(u): "file://" ]
    concat(url): u d "/tests/ai/" name
]

model(r): name file [
    fixture(url): file
    vec(r): ""
    push(_): r "openai"
    push(_): r name
    push(_): r "-"
    push(_): r url
]

clean(r): dir [
    set(r): 0
    list_dir(names): dir
    typeof(t): names
    if(_): {t != "vector"} [ return(r): r ]
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(name): names i
        concat(p): dir "/" name
        remove_file(_): p
        set(i): {i + 1}
    ]
    remove_dir(_): dir
]

# a test any shell has: the candidate holds the word "good"
word_test(r): [
    getenv(os): "OS"
    set(r): "grep good {file}"
    if(_): {os = "Windows_NT"} [ set(r): "findstr good {file}" ]
]

init(result): arg_count arg_values [
    set(result): 0
    set(dir): "tests/lenin-tmp"
    clean(_): dir
    make_dir(_): dir

    # the helpers
    lenin_replace(s): "run {file} now" "{file}" "a.py"
    check(_): "replace" s "run a.py now"
    lenin_safe(s): "org/model:1-a"
    check(_): "a model's name as a file name" s "org_model_1-a"
    chr(nl): 10
    concat(reply): "Here:" nl "```python" nl "x = 1" nl "```" nl "Done."
    lenin_code(s): reply
    concat(want): "x = 1" nl
    check(_): "the code of a fenced reply" s want
    lenin_code(s): "  no fence  "
    check(_): "a reply with no fence" s "no fence"
    lenin_words(w): "openai  gpt	-"
    len(n): w
    check(_): "words at spaces and tabs" n 3

    # models.conf
    concat(conf): dir "/models.conf"
    concat(text): "# a comment" nl nl "anthropic claude-x ANTHROPIC_API_KEY" nl "openai local - http://localhost/v1" nl
    writefile(_): conf text
    lenin_load_models(ms): conf
    len(n): ms
    check(_): "the models file" n 2
    at(m1): ms 1
    at(u): m1 3
    check(_): "a model's URL" u "http://localhost/v1"
    lenin_load_models(none): "tests/lenin-tmp/no-such-file"
    check(_): "no models file" none null

    # who beats whom
    lenin_measure(fail): "x" "p" "aaaaaaaaaa" "" "" "" "l" 0
    btput(_): fail "passed" false
    btput(_): fail "tested" true
    lenin_measure(big): "y" "p" "aaaaaaaaaaaaaaaaaaaaaaaaa" "" "" "" "l" 0
    btput(_): big "rate" 10
    lenin_measure(small): "z" "p" "aaaaaaaaaaaaaaaaaaaa" "" "" "" "l" 0
    btput(_): small "rate" 2
    lenin_better(b): small fail "size"
    check(_): "one that passes beats a smaller one that fails" b true
    lenin_better(b): small big "size"
    check(_): "by size the smaller" b true
    lenin_better(b): big small "speed"
    check(_): "by speed the faster" b true

    # a key that is not set skips the model, and no call goes out
    vec(nokey): ""
    push(_): nokey "openai"
    push(_): nokey "m"
    push(_): nokey "LENIN_TEST_NO_SUCH_KEY"
    push(_): nokey ""
    unsetenv(_): "LENIN_TEST_NO_SUCH_KEY"
    lenin_ask(a): nokey "s" "q"
    check(_): "a model without its key gives nothing" a null

    # a whole run
    vec(models): ""
    model(m): "wrong" "lenin_wrong.json"
    push(_): models m
    model(m): "big" "lenin_big.json"
    push(_): models m
    model(m): "down" "lenin_down.json"
    push(_): models m
    model(m): "slim" "lenin_slim.json"
    push(_): models m
    concat(rundir): dir "/run"
    btree(args):
    btput(_): args "models" models
    btput(_): args "prompt" "say good"
    btput(_): args "criteria" "size"
    btput(_): args "method" "rounds"
    btput(_): args "dir" rundir
    btput(_): args "cycles" 2
    word_test(t):
    btput(_): args "test" t
    btput(_): args "ext" ".txt"
    btput(_): args "baseline" ""
    btput(_): args "window" 0
    btput(_): args "refine" true
    lenin_run(st): args
    check(_): "the run finds a winner" st 0
    concat(p): rundir "/best.txt"
    readfile(best): p
    concat(want): "good" nl
    check(_): "the winner passes and is the smallest" best want
    concat(p): rundir "/report.md"
    readfile(rep): p
    str_find(i): rep "Best: cycle 1, slim." 0
    check(_): "the report names it" {i >= 0} true
    str_find(i): rep "| wrong | FAILED |" 0
    check(_): "the report has what failed" {i >= 0} true

    # rounds: in a cycle nobody sees what the others in it just said
    concat(p): rundir "/cycle1_slim.prompt.md"
    readfile(sent): p
    str_find(i): sent "good deal" 0
    check(_): "rounds: the last model in a cycle sees nothing of it" {i < 0} true
    concat(p): rundir "/cycle2_wrong.prompt.md"
    readfile(sent): p
    str_find(i): sent "The best answer so far:" 0
    check(_): "rounds: the next cycle sees the best" {i >= 0} true

    # chain: each model gets the best so far, right after the one before it
    btput(_): args "method" "chain"
    btput(_): args "cycles" 1
    btput(_): args "refine" false
    concat(rundir3): dir "/chain"
    btput(_): args "dir" rundir3
    lenin_run(st): args
    check(_): "chain: a winner" st 0
    concat(p): rundir3 "/cycle1_wrong.prompt.md"
    readfile(sent): p
    check(_): "chain: the first model has only the task" sent "say good"
    concat(p): rundir3 "/cycle1_big.prompt.md"
    readfile(sent): p
    str_find(i): sent "not it" 0
    check(_): "chain: the next one sees the answer before it" {i >= 0} true
    str_find(i): sent "It failed its test" 0
    check(_): "chain: and that it failed" {i >= 0} true
    concat(p): rundir3 "/cycle1_slim.prompt.md"
    readfile(sent): p
    str_find(i): sent "good deal" 0
    check(_): "chain: a model that is down is passed over" {i >= 0} true
    str_find(i): sent "not it" 0
    check(_): "chain: what passed replaces what failed" {i < 0} true
    concat(p): rundir3 "/report.md"
    readfile(rep): p
    str_find(i): rep "Method: chain" 0
    check(_): "chain: the report says so" {i >= 0} true

    # chain with no test: the latest answer goes on, not the smallest
    btput(_): args "test" ""
    vec(two): ""
    model(m): "slim" "lenin_slim.json"
    push(_): two m
    model(m): "big" "lenin_big.json"
    push(_): two m
    model(m): "last" "lenin_wrong.json"
    push(_): two m
    btput(_): args "models" two
    concat(rundir4): dir "/chain2"
    btput(_): args "dir" rundir4
    lenin_run(st): args
    concat(p): rundir4 "/cycle1_last.prompt.md"
    readfile(sent): p
    str_find(i): sent "good deal" 0
    check(_): "chain with no test: the latest goes on" {i >= 0} true
    str_find(i): sent "The answer so far:" 0
    check(_): "and it is not called the best" {i >= 0} true
    btput(_): args "models" models
    btput(_): args "method" "rounds"
    word_test(t):
    btput(_): args "test" t

    # refining: prompt A and sub-task A make prompt B
    lenin_last_number(k): "9 checks, passed 7"
    check(_): "a suite's score is its last number" k 7
    lenin_last_number(k): "12"
    check(_): "a number alone" k 12
    lenin_last_number(k): "no number"
    check(_): "no number" k -1
    vec(subs): ""
    push(_): subs "supports bold text"
    lenin_fold(folded): "make a text editor" subs
    concat(want): "make a text editor" nl nl "It must also:" nl "- supports bold text"
    check(_): "a sub-task folds into the prompt" folded want
    concat(listed): "- saves files" nl "* supports bold text" nl "NONE" nl "- saves files" nl "not a task"
    lenin_subtasks(new): listed subs
    len(nnew): new
    check(_): "only new sub-tasks, once each" nnew 1
    at(first_): new 0
    check(_): "and which" first_ "saves files"
    concat(listed): "- one" nl "  two" nl nl "* three"
    lenin_task_file(tf): listed
    len(ntf): tf
    check(_): "a tasks file, a line each" ntf 3

    # your sub-tasks, with no refining: they go after the prompt as they are
    vec(one): ""
    model(m): "slim" "lenin_slim.json"
    push(_): one m
    btput(_): args "models" one
    btput(_): args "tasks" subs
    btput(_): args "refine" false
    btput(_): args "cycles" 1
    concat(rundir6): dir "/tasks"
    btput(_): args "dir" rundir6
    lenin_run(st): args
    concat(p): rundir6 "/refined.md"
    readfile(sent): p
    concat(want): "say good" nl nl "It must also:" nl "- supports bold text"
    check(_): "your sub-tasks go to the centrifuge" sent want
    concat(p): rundir6 "/tasks.md"
    readfile(said): p
    str_find(i): said "- supports bold text (yours)" 0
    check(_): "tasks.md says whose they are" {i >= 0} true
    vec(none_): ""
    btput(_): args "tasks" none_

    # refining in rounds: a draft, what it shows is missing, until nothing new
    vec(one): ""
    model(m): "tasky" "lenin_tasky.json"
    push(_): one m
    btput(_): args "models" one
    btput(_): args "refine" true
    btput(_): args "refine_rounds" 4
    concat(rundir7): dir "/rounds"
    btput(_): args "dir" rundir7
    lenin_run(st): args
    concat(p): rundir7 "/tasks.md"
    readfile(said): p
    str_find(i): said "- handles bad input (round 2)" 0
    check(_): "round 2 finds a sub-task in its draft" {i >= 0} true
    str_find(i): said "(round 3)" 0
    check(_): "round 3 finds nothing new" {i < 0} true
    concat(p): rundir7 "/refined.md"
    readfile(sent): p
    str_find(i): sent "It must also:" 0
    check(_): "the found sub-task is in the prompt" {i >= 0} true
    concat(p): rundir7 "/refine2_draft.txt"
    open_file(h): p "rb"
    check(_): "the draft is kept" {h >= 0} true
    if(_): {h >= 0} [ close_file(_): h ]
    concat(p): rundir7 "/refine4.md"
    open_file(h): p "rb"
    check(_): "refining stops when a round finds nothing new" {h < 0} true
    if(_): {h >= 0} [ close_file(_): h ]
    btput(_): args "refine" false
    btput(_): args "refine_rounds" 1

    # a "what is better" suite: more of it passing beats fewer bytes
    getenv(os): "OS"
    set(score_cmd): "grep -c good {file}"
    if(_): {os = "Windows_NT"} [
        # cmd gets a quote as \", so the quotes find needs go in a script
        chr(q_): 34
        chr(crlf): 13
        chr(bs): 92
        concat(script): "@" q_ "%SystemRoot%" bs "system32" bs "find.exe" q_ " /c " q_ "good" q_ " %1" crlf nl
        concat(cmdfile): dir "/count.cmd"
        writefile(_): cmdfile script
        lenin_replace(cmdfile): cmdfile "/" bs
        concat(score_cmd): cmdfile " {file}"
    ]
    vec(two): ""
    model(m): "slim" "lenin_slim.json"
    push(_): two m
    model(m): "rich" "lenin_rich.json"
    push(_): two m
    model(m): "wrong" "lenin_wrong.json"
    push(_): two m
    btput(_): args "models" two
    btput(_): args "test" ""
    btput(_): args "score" score_cmd
    concat(rundir8): dir "/score"
    btput(_): args "dir" rundir8
    lenin_run(st): args
    check(_): "the suite finds a winner" st 0
    concat(p): rundir8 "/best.txt"
    readfile(best): p
    concat(want): "good" nl "good" nl
    check(_): "the higher score wins over the smaller" best want
    concat(p): rundir8 "/report.md"
    readfile(rep): p
    str_find(i): rep "| wrong | FAILED | 7 | 0 | 0 |" 0
    check(_): "what passes none of the suite fails" {i >= 0} true
    str_find(i): rep "nothing was run" 0
    check(_): "a suite is no vote" {i < 0} true

    # enrich: the chain, until a cycle finds nothing better
    btput(_): args "models" one
    btput(_): args "score" ""
    word_test(t):
    btput(_): args "test" t
    btput(_): args "method" "enrich"
    btput(_): args "cycles" 5
    concat(rundir9): dir "/enrich"
    btput(_): args "dir" rundir9
    lenin_run(st): args
    check(_): "enrich: a winner" st 0
    concat(p): rundir9 "/cycle2_tasky.prompt.md"
    readfile(sent): p
    str_find(i): sent "The best answer so far:" 0
    check(_): "enrich: the next cycle gets the best" {i >= 0} true
    concat(p): rundir9 "/cycle3_tasky.prompt.md"
    open_file(h): p "rb"
    check(_): "enrich: it stops once nothing better came" {h < 0} true
    if(_): {h >= 0} [ close_file(_): h ]
    concat(p): rundir9 "/report.md"
    readfile(rep): p
    str_find(i): rep "Stopped after cycle 2" 0
    check(_): "enrich: the report says where it stopped" {i >= 0} true
    vec(argv): ""
    push(_): argv "--models"
    push(_): argv conf
    push(_): argv "--method"
    push(_): argv "enrich"
    push(_): argv "the task"
    lenin_main(st): argv
    check(_): "enrich with nothing to measure" st 2
    btput(_): args "models" models
    btput(_): args "method" "rounds"
    btput(_): args "cycles" 1

    # a hidden test: it must pass too, and the models are never shown what it said
    getenv(os): "OS"
    set(deal_test): "grep deal {file}"
    set(never_test): "grep excellent {file}"
    if(_): {os = "Windows_NT"} [
        set(deal_test): "findstr deal {file}"
        set(never_test): "findstr excellent {file}"
    ]
    vec(two): ""
    model(m): "slim" "lenin_slim.json"
    push(_): two m
    model(m): "big" "lenin_big.json"
    push(_): two m
    btput(_): args "models" two
    word_test(t):
    btput(_): args "test" t
    btput(_): args "holdout" deal_test
    btput(_): args "method" "chain"
    btput(_): args "cycles" 2
    btput(_): args "refine" false
    concat(rundir10): dir "/hidden"
    btput(_): args "dir" rundir10
    lenin_run(st): args
    check(_): "hidden: a winner" st 0
    concat(p): rundir10 "/best.txt"
    readfile(best): p
    str_find(i): best "deal" 0
    check(_): "hidden: what fails it cannot win" {i >= 0} true
    concat(p): rundir10 "/cycle1_big.prompt.md"
    readfile(sent): p
    str_find(i): sent "fails a hidden one" 0
    check(_): "hidden: the next model hears that it failed" {i >= 0} true
    str_find(i): sent "The test said:" 0
    check(_): "hidden: and not what it said" {i < 0} true
    concat(p): rundir10 "/cycle2_slim.prompt.md"
    readfile(sent): p
    str_find(i): sent "Known defects of other answers" 0
    check(_): "handoff: the known defects go along" {i >= 0} true
    str_find(i): sent "cycle 1, slim: it passed the test shown but failed the hidden one" 0
    check(_): "handoff: which answer, and what was wrong" {i >= 0} true
    concat(p): rundir10 "/report.md"
    readfile(rep): p
    str_find(i): rep "| slim | FAILED hidden |" 0
    check(_): "hidden: the report has it" {i >= 0} true
    str_find(i): rep "Hidden test: 2 of the answers" 0
    check(_): "hidden: and counts it" {i >= 0} true
    btput(_): args "holdout" ""

    # --target: the requirements are met, so the run stops
    vec(three): ""
    model(m): "slim" "lenin_slim.json"
    push(_): three m
    model(m): "rich" "lenin_rich.json"
    push(_): three m
    model(m): "wrong" "lenin_wrong.json"
    push(_): three m
    btput(_): args "models" three
    btput(_): args "test" ""
    btput(_): args "score" score_cmd
    btput(_): args "target" 2
    btput(_): args "method" "rounds"
    concat(rundir11): dir "/target"
    btput(_): args "dir" rundir11
    lenin_run(st): args
    check(_): "target: a winner" st 0
    concat(p): rundir11 "/cycle1_wrong.prompt.md"
    open_file(h): p "rb"
    check(_): "target: nothing is asked once it is met" {h < 0} true
    if(_): {h >= 0} [ close_file(_): h ]
    concat(p): rundir11 "/report.md"
    readfile(rep): p
    str_find(i): rep "scores 2, the target" 0
    check(_): "target: the report says so" {i >= 0} true
    btput(_): args "target" -1
    btput(_): args "score" ""

    # --budget: no more calls than that
    btput(_): args "test" t
    btput(_): args "budget" 2
    concat(rundir12): dir "/budget"
    btput(_): args "dir" rundir12
    lenin_run(st): args
    concat(p): rundir12 "/cycle1_wrong.prompt.md"
    open_file(h): p "rb"
    check(_): "budget: the third call does not go out" {h < 0} true
    if(_): {h >= 0} [ close_file(_): h ]
    concat(p): rundir12 "/report.md"
    readfile(rep): p
    str_find(i): rep "the budget of 2 calls is spent" 0
    check(_): "budget: the report says so" {i >= 0} true
    btput(_): args "budget" -1

    # --patience: enrich stops after that many cycles with nothing better
    vec(one): ""
    model(m): "tasky" "lenin_tasky.json"
    push(_): one m
    btput(_): args "models" one
    btput(_): args "method" "enrich"
    btput(_): args "cycles" 6
    btput(_): args "patience" 2
    concat(rundir13): dir "/patience"
    btput(_): args "dir" rundir13
    lenin_run(st): args
    concat(p): rundir13 "/cycle3_tasky.prompt.md"
    open_file(h): p "rb"
    check(_): "patience: a second cycle with nothing better runs" {h >= 0} true
    if(_): {h >= 0} [ close_file(_): h ]
    concat(p): rundir13 "/cycle4_tasky.prompt.md"
    open_file(h): p "rb"
    check(_): "patience: and then it stops" {h < 0} true
    if(_): {h >= 0} [ close_file(_): h ]
    btput(_): args "patience" 1

    # back to refining: the best still fails when enrich stalls
    btput(_): args "test" never_test
    btput(_): args "refine" true
    btput(_): args "refine_rounds" 1
    btput(_): args "cycles" 6
    concat(rundir14): dir "/stall"
    btput(_): args "dir" rundir14
    lenin_run(st): args
    check(_): "stall: nothing passes" st 1
    concat(p): rundir14 "/tasks.md"
    readfile(said): p
    str_find(i): said "- handles bad input (cycle 2, the best still failing)" 0
    check(_): "stall: refining finds what the prompt leaves out" {i >= 0} true
    concat(p): rundir14 "/cycle3_tasky.prompt.md"
    readfile(sent): p
    str_find(i): sent "It must also:" 0
    check(_): "stall: the next cycle has the new prompt" {i >= 0} true
    str_find(i): sent "Requirements so far:" 0
    check(_): "handoff: the requirements go along" {i >= 0} true
    concat(p): rundir14 "/cycle4_tasky.prompt.md"
    open_file(h): p "rb"
    check(_): "stall: it stops when refining finds nothing new" {h < 0} true
    if(_): {h >= 0} [ close_file(_): h ]
    concat(p): rundir14 "/report.md"
    readfile(rep): p
    str_find(i): rep "Refining found nothing the prompt leaves out." 0
    check(_): "stall: the report says why it stopped" {i >= 0} true

    # what goes with what
    vec(argv): ""
    push(_): argv "--models"
    push(_): argv conf
    push(_): argv "--holdout"
    push(_): argv "x"
    push(_): argv "the task"
    lenin_main(st): argv
    check(_): "a hidden test alone" st 2
    vec(argv): ""
    push(_): argv "--models"
    push(_): argv conf
    push(_): argv "--test"
    push(_): argv "x"
    push(_): argv "--target"
    push(_): argv "3"
    push(_): argv "the task"
    lenin_main(st): argv
    check(_): "a target with no suite" st 2

    btput(_): args "models" models
    btput(_): args "method" "rounds"
    btput(_): args "refine" false
    btput(_): args "cycles" 1
    word_test(t):
    btput(_): args "test" t

    # a method there is not
    vec(argv): ""
    push(_): argv "--models"
    push(_): argv conf
    push(_): argv "--method"
    push(_): argv "sideways"
    push(_): argv "the task"
    lenin_main(st): argv
    check(_): "a method there is not" st 2

    # the blind vote: a reply that is not one letter does not count
    vec(voters): ""
    model(m): "v1" "lenin_vote_b.json"
    push(_): voters m
    model(m): "v2" "lenin_vote_talk.json"
    push(_): voters m
    vec(answers): ""
    push(_): answers fail
    push(_): answers small
    lenin_vote(won): voters answers "the task"
    btget(wm): won "model"
    check(_): "the vote goes to the letter" wm "z"
    vec(talkers): ""
    model(m): "v2" "lenin_vote_talk.json"
    push(_): talkers m
    lenin_vote(won): talkers answers "the task"
    check(_): "talk is no vote" won null

    # no test: the models vote, and the report says nothing was run
    btput(_): args "test" ""
    btput(_): args "cycles" 1
    btput(_): args "refine" false
    concat(rundir2): dir "/vote"
    btput(_): args "dir" rundir2
    lenin_run(st): args
    concat(p): rundir2 "/report.md"
    readfile(rep): p
    str_find(i): rep "nothing was run" 0
    check(_): "without a test the report says so" {i >= 0} true

    # the record: what a run adds, and what --stats makes of it
    concat(hist): dir "/history.tsv"
    btput(_): args "history" hist
    concat(rundir5): dir "/record"
    btput(_): args "dir" rundir5
    lenin_run(st): args
    word_test(wt):
    btput(_): args "test" wt
    lenin_run(st): args
    btput(_): args "test" ""
    readfile(said): hist
    lenin_lines(lines): said
    set(runs_seen): 0
    set(answers_seen): 0
    set(missed_seen): 0
    len(nlines): lines
    set(i): 0
    while(_): {i < nlines} [
        at(line): lines i
        lenin_fields(f): line
        at(kind): f 0
        if(_): {kind = "run"} [ set(runs_seen): {runs_seen + 1} ]
        if(_): {kind = "answer"} [
            set(answers_seen): {answers_seen + 1}
            at(state): f 4
            if(_): {state = "noanswer"} [ set(missed_seen): {missed_seen + 1} ]
        ]
        set(i): {i + 1}
    ]
    check(_): "the record has both runs" runs_seen 2
    check(_): "the record has a model that did not answer" {missed_seen > 0} true
    check(_): "the record has the answers" {answers_seen > missed_seen} true
    lenin_stats(st): hist
    check(_): "stats reads it" st 0
    concat(nofile): dir "/no-such-history.tsv"
    lenin_stats(st): nofile
    check(_): "stats with no history yet is no error" st 0
    lenin_task_id(id1): "a task"
    lenin_task_id(id2): "another task"
    check(_): "tasks have different numbers" {id1 != id2} true
    chr(tab_): 9
    concat(messy): "one" tab_ "two" nl "three"
    lenin_cell(cell): messy 100
    check(_): "a field stays on one line" cell "one two three"
    # a cut does not split a letter: this is two bytes, then two bytes
    lenin_cell(cell): "ЖЖ" 3
    len(celln): cell
    check(_): "a cut keeps letters whole" celln 2
    btdel(_): args "history"

    clean(_): rundir6
    clean(_): rundir7
    clean(_): rundir8
    clean(_): rundir9
    clean(_): rundir10
    clean(_): rundir11
    clean(_): rundir12
    clean(_): rundir13
    clean(_): rundir14
    clean(_): rundir5
    clean(_): rundir
    clean(_): rundir2
    clean(_): rundir3
    clean(_): rundir4
    clean(_): dir
    unsetenv(_): "USSR_AI_URL"
    unsetenv(_): "USSR_AI_SYSTEM"
    unsetenv(_): "USSR_AI_MODEL"
    unsetenv(_): "USSR_AI_PROVIDER"
]
