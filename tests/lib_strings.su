# Tests src/libs/strings.su. Every line prints PASS or FAIL with a label.
$include "../src/libs/strings.su"

check(r): label got want [
    if(_): {got = want} [
        concat(_chk_line): "PASS " label
    ]
    else(_): [
        concat(_chk_line): "FAIL " label
    ]
    print(_): _chk_line
    set(r): 0
]

str_from_int(s): 0
check(_): "int zero" s "0"
str_from_int(s): 12345
check(_): "int positive" s "12345"
str_from_int(s): {0 - 907}
check(_): "int negative" s "-907"

str_trunc(t): 7.9
check(_): "trunc positive" t 7
str_trunc(t): -7.9
check(_): "trunc negative" t {0 - 7}
str_trunc(t): 1048576.25
check(_): "trunc large" t 1048576

str_from_number(s): 42 3
check(_): "number integer" s "42"
str_from_number(s): 2.5 3
check(_): "number half" s "2.5"
str_from_number(s): -0.125 3
check(_): "number negative fraction" s "-0.125"
str_from_number(s): 3.14159 2
check(_): "number rounded" s "3.14"
str_from_number(s): 9.9996 3
check(_): "number carry" s "10"
str_from_number(s): 1.05 4
check(_): "number padded fraction" s "1.05"
str_from_number(s): -0.0001 2
check(_): "number rounds to zero" s "0"

str_to_number(n): "17"
check(_): "parse integer" n 17
str_to_number(n): "  -42  "
check(_): "parse blanks and sign" n {0 - 42}
str_to_number(n): "3.25"
check(_): "parse real" n 3.25
str_to_number(n): "-0.5"
check(_): "parse negative real" n -0.5
str_to_number(n): "1.5e3"
check(_): "parse exponent" n 1500.0
str_to_number(n): "25E-2"
check(_): "parse negative exponent" n 0.25
str_to_number(n): ".5"
check(_): "parse leading point" n 0.5
str_to_number(n): "abc"
check(_): "reject letters" n null
str_to_number(n): "1.2.3"
check(_): "reject two points" n null
str_to_number(n): ""
check(_): "reject empty" n null
str_to_number(n): "-"
check(_): "reject bare sign" n null
str_to_number(n): "4e"
check(_): "reject bare exponent" n null

str_lower(s): "Tver/README.MD"
check(_): "lower" s "tver/readme.md"
str_find(i): "a|b|c" "|" 0
check(_): "find first" i 1
str_find(i): "a|b|c" "|" 2
check(_): "find from" i 3
str_find(i): "abc" "x" 0
check(_): "find missing" i {0 - 1}
str_trim(s): "  \t padded \r\n"
check(_): "trim" s "padded"
str_trim(s): "   "
check(_): "trim blank" s ""
str_repeat(s): "ab" 3
check(_): "repeat" s "ababab"

# UTF-8: "Ж" is 2 bytes, "€" 3 bytes, "😀" 4 bytes
set(ru): "Мир, world!"
utf8_count(n): ru
check(_): "utf8 count mixed" n 11
len(n): ru
check(_): "utf8 byte length" n 14
utf8_next(i): ru 0
check(_): "utf8 next over cyrillic" i 2
utf8_prev(i): ru 6
check(_): "utf8 prev over cyrillic" i 4
utf8_index(i): ru 4
check(_): "utf8 index of column" i 7
utf8_column(c): ru 7
check(_): "utf8 column of index" c 4
set(e): "a€😀b"
utf8_count(n): e
check(_): "utf8 count 3 and 4 byte" n 4
utf8_next(i): e 1
check(_): "utf8 next over euro" i 4
utf8_prev(i): e 8
check(_): "utf8 prev over emoji" i 4
utf8_index(i): e 9
check(_): "utf8 index past end" i 9
vec(bytes): ""
push(_): bytes 208
push(_): bytes 150
utf8_from_bytes(s): bytes
check(_): "utf8 from bytes" s "Ж"
chr(c): 65
check(_): "chr ascii" c "A"
