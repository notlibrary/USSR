
# ln.su
# Range-reduced series for the natural logarithm.
#
# For x > 0:
#
#     x = m * 2^e
#
# with
#
#     sqrt(1/2) <= m <= sqrt(2)
#
# Then:
#
#     ln(x) = ln(m) + e * ln(2)
#
# ln(m) uses the atanh series with z = (m - 1) / (m + 1):
#
#     ln(m) = 2 * (z + z^3/3 + z^5/5 + ...)
#
# On the reduced interval |z| <= 0.1716, so 12 terms land at full
# double precision (worst-case error about 1e-19 before rounding).

ln(r): x [
    set(sqrt_half): 0.7071067811865475
    set(sqrt_two): 1.4142135623730951
    set(ln_two): 0.6931471805599453
    set(e): 0

    # Domain check.
    # USSR currently has no standard NaN/domain-error value,
    # so return 0 for x <= 0.
    if(_): {x <= 0} [
        set(r): 0
        return(r): r
    ]

    # Range reduction.
    #
    # x = m * 2^e
    #
    # Keep m in [sqrt(1/2), sqrt(2)].

    while(_): {x > sqrt_two} [
        set(x): {x / 2}
        set(e): {e + 1}
    ]

    while(_): {x < sqrt_half} [
        set(x): {x * 2}
        set(e): {e - 1}
    ]

    # atanh series variable.
    #
    # z = (m - 1) / (m + 1)

    set(z): {(x - 1) / (x + 1)}
    set(zsq): {z * z}
    set(term): z
    set(sum): z

    # 12 odd-power terms: z^3/3 .. z^25/25.

    set(i): 1
    while(_): {i < 12} [
        set(term): {term * zsq}
        set(denom): {2 * i + 1}
        set(sum): {sum + term / denom}
        add(i): i 1
    ]

    # ln(m) = 2 * atanh(z); restore the exponent contribution.

    set(r): {2 * sum + e * ln_two}

    return(r): r
]

init(ret): arg_cnt arg_vec [
    scan(ok): "x: REAL;" x
    ln(r): x
    print(_): r
    return(ret): 0
]
