
# ln.su
# Range-reduced polynomial approximation of natural logarithm.
#
# For x > 0:
#
#     x = m * 2^e
#
# with
#
#     sqrt(1/2) <= m <= sqrt(2)
#
# Then:
#
#     ln(x) = ln(m) + e * ln(2)
#
# ln(m) is approximated by a fitted degree-12 polynomial.
# The polynomial is evaluated with Horner's method.
#
# This is NOT a Taylor-series implementation.

ln(r): x [
    set(sqrt_half): 0.7071067811865475
    set(sqrt_two): 1.4142135623730951
    set(ln_two): 0.6931471805599453
    set(e): 0

    # Domain check.
    # USSR currently has no standard NaN/domain-error value,
    # so return 0 for x <= 0.
    if(_): {x <= 0} [
        set(r): 0
        return(r): r
    ]

    # Range reduction.
    #
    # x = m * 2^e
    #
    # Keep m in [sqrt(1/2), sqrt(2)].

    while(_): {x > sqrt_two} [
        set(x): {x / 2}
        set(e): {e + 1}
    ]

    while(_): {x < sqrt_half} [
        set(x): {x * 2}
        set(e): {e - 1}
    ]

    # Polynomial variable.
    #
    # t = x - 1
    #
    # The polynomial coefficients are fitted to ln(x)
    # over the reduced interval.

    set(t): {x - 1}

    # Degree 12 fitted polynomial.
    #
    # r = (((((c12*t + c11)*t + c10)*t + ...)*t + c1)*t + c0)

    set(r): 0.057457993591416102
    set(r): {r * t + 0.79591197965958238}
    set(r): {r * t - 5.0724633898296609}
    set(r): {r * t + 19.700726110340572}
    set(r): {r * t - 52.053431326793479}
    set(r): {r * t + 98.895517061264641}
    set(r): {r * t - 139.20308643650262}
    set(r): {r * t + 147.36949817037649}
    set(r): {r * t - 117.93752207290035}
    set(r): {r * t + 71.249121208646372}
    set(r): {r * t - 32.528916223050715}
    set(r): {r * t + 11.942979116723437}
    set(r): {r * t - 3.1008762043328355}

    # Restore the exponent contribution.

    set(r): {r + e * ln_two}

    return(r): r
]

# Test the USSR range-reduced polynomial ln.
init(ret): arg_cnt arg_vec [
    scan(ok): "x: REAL;" x
    ln(r): x
    print(_): r
    return(ret): 0
]
