# moscow_tick.su - a task that runs next to the shell, for qemu_test.py:
# five ticks a fifth of a second apart, then the status 7. A task that
# is not the console's reads the end of its input. It waits a second
# first, so that all it prints comes after the wait that follows spawn:
# compiled for the NASM runtime it starts at once.
init(result): arg_count arg_values [
    sleep(_): 1000
    terminal_getch(c):
    print(_): "tick: the console gives this task"
    print(_): c
    set(i): 0
    while(_): {i < 5} [
        print(_): "tick"
        sleep(_): 200
        set(i): {i + 1}
    ]
    set(result): 7
]
