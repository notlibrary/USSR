# io.su feature test: open_file/write_file/close_file/read_file
# roundtrip through a temporary file, plus append ("a") and binary
# ("rb") modes and a counted read.
$include "io.su"

init(ret): arg_cnt arg_vec [
    open_file(h): "tests/lib_io_tmp.txt" "w"
    write_file(n): h "ussr io roundtrip"
    close_file(ok): h
    open_file(h2): "tests/lib_io_tmp.txt" "r"
    read_file(s): h2
    close_file(ok2): h2
    print(_): s
    open_file(h3): "tests/lib_io_tmp.txt" "a"
    write_file(n3): h3 "!"
    close_file(ok3): h3
    open_file(h4): "tests/lib_io_tmp.txt" "rb"
    read_file(s2): h4
    close_file(ok4): h4
    print(_): s2
    open_file(h5): "tests/lib_io_tmp.txt" "r"
    read_file(s3): h5 4
    close_file(ok5): h5
    print(_): s3
    set(ret): 0
]
