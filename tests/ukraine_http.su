# Minimal ukraine.su app. Run from the repository root:
#   ussr tests/ukraine_http.su
$include "src/ukraine/ukraine.su"

uk_route(result): method target raw_request [
    if(_): {method = "GET"} [
        if(_): {target = "/"} [
            uk_response(result): "200 OK" "text/html; charset=utf-8" "<!doctype html><title>Ukraine</title><h1>Ukraine HTTP framework</h1>\n"
            return(result): result
        ]
        if(_): {target = "/health"} [
            uk_response(result): "200 OK" "text/plain; charset=utf-8" "ok\n"
            return(result): result
        ]
    ]
    if(_): {method != "GET"} [
        uk_response(result): "405 Method Not Allowed" "text/plain; charset=utf-8" "Method Not Allowed\n"
        return(result): result
    ]
    uk_response(result): "404 Not Found" "text/plain; charset=utf-8" "Not Found\n"
]

init(result): arg_cnt arg_vec [
    uk_server(result): "127.0.0.1" 18992
]
