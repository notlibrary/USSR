# Automated Tula test. Needs a GUI-enabled ussr (GLFW) and a display; the
# window is never shown. Run from the repository root:
#     ussr tests/gui/tula_test.su
# Drives the CAD with injected button clicks and canvas pointer events, then
# compares the exported DXF with the expected text. Prints PASS or FAIL.
$include "../../src/tula/tula.su"

line_tool(result): widget [
    tulatool(_): "line"
]

circle_tool(result): widget [
    tulatool(_): "circle"
]

canvas_input(result): canvas x y [
    tulaclick(_): canvas x y
]

canvas_menu(result): canvas x y [
    tulamenu(_): canvas x y
]

save_drawing(result): widget [
    tulasave(_):
]

check(r): label got want [
    if(_): {got = want} [
        concat(_chk_line): "PASS " label
        print(_): _chk_line
    ]
    else(_): [
        concat(_chk_line): "FAIL " label
        print(_): _chk_line
        print(_): got
        print(_): want
    ]
    set(r): 0
]

settle(r): [
    sleep(_): 60
    uiidle(_st_idle):
    set(_st_tries): 0
    while(_): {_st_idle = false && _st_tries < 200} [
        sleep(_): 10
        uiidle(_st_idle):
        set(_st_tries): {_st_tries + 1}
    ]
    if(_): {_st_idle = false} [
        print(_): "FAIL handler did not finish"
        uiunlock(_):
    ]
    set(r): 0
]

point(r): canvas x y [
    inject(_): canvas "pointer" x y 0
    settle(_):
    set(r): 0
]

click(r): widget [
    inject(_): widget "click" 0 0 0
    settle(_):
    set(r): 0
]

init(result): arg_count arg_values [
    # the recent-file lists go to a scratch HOME, not the user's
    getcwd(_home_cwd):
    concat(_home_dir): _home_cwd "/tests/gui/home_tmp"
    make_dir(_): _home_dir
    setenv(_): "HOME" _home_dir
    createwindow(window): "Tula test" 1100 800
    button(line_button): window "Line"
    button(circle_button): window "Circle"
    textbox(filename): window "tula_test_out.dxf"
    button(save_button): window "Save DXF"
    label(status): window ""
    on(_): line_button "click" "line_tool"
    on(_): circle_button "click" "circle_tool"
    on(_): save_button "click" "save_drawing"
    tulainitialize(canvas): window status filename
    on(_): canvas "pointer" "canvas_input"
    on(_): canvas "menu" "canvas_menu"
    pack(_): canvas true

    canvascount(grid_shapes): canvas
    check(_): "grid drawn" {grid_shapes > 100} true
    gettext(t): status
    check(_): "ready status" t "Choose a tool; cursor snapping is off"
    set(tula_snap_grid): true!

    point(_): canvas 50 650
    gettext(t): status
    check(_): "tool required" t "Choose SELECT, LINE, CIRCLE, CIRCLE SEGMENT or SPLINE first"

    click(_): line_button
    gettext(t): status
    check(_): "line tool" t "LINE tool: click the first point; right-click to finish"
    point(_): canvas 50 650
    gettext(t): status
    check(_): "first point set" t "Line start set; click the next point"
    canvascount(n): canvas
    check(_): "anchor cross drawn" n {grid_shapes + 2}
    point(_): canvas 151 451
    gettext(t): status
    check(_): "first segment added" t "Line segment added; click another point or right-click to finish"
    inject(_): canvas "menu" 151 451 0
    settle(_):
    gettext(t): status
    check(_): "right-click ends line sequence" t "Line sequence finished"

    tulatool(_): "line"
    click(_): circle_button
    point(_): canvas 100 600
    point(_): canvas 125 600
    gettext(t): status
    check(_): "circle added" t "Circle added; 2 object(s)"
    canvascount(n): canvas
    check(_): "entities drawn" n {grid_shapes + 2}

    click(_): save_button
    gettext(t): status
    check(_): "saved" t "Saved 2 object(s) to tula_test_out.dxf"
    readfile(dxf): "tula_test_out.dxf"
    check(_): "dxf content" dxf "0\nSECTION\n2\nHEADER\n9\n$ACADVER\n1\nAC1015\n9\n$INSUNITS\n70\n4\n0\nENDSEC\n0\nSECTION\n2\nENTITIES\n0\nLINE\n8\n0\n10\n10\n20\n10\n30\n0\n11\n30\n21\n50\n31\n0\n0\nCIRCLE\n8\n0\n10\n20\n20\n20\n30\n0\n40\n5\n0\nENDSEC\n0\nEOF\n"
    remove_file(_): "tula_test_out.dxf"

    tulatool(_): "arc"
    tula_draw_click(_): 0 0
    tula_draw_click(_): 10 0
    tula_draw_click(_): 0 10
    set(entities): tula_entities?
    at(arc): entities 2
    at(arc_kind): arc 0
    check(_): "center-radius-angle creates an arc segment" arc_kind "ARC"
    tulatool(_): "spline"
    tula_draw_click(_): 0 0
    tula_draw_click(_): 10 0
    tula_draw_click(_): 10 10
    tulafinish(_):
    set(entities): tula_entities?
    at(spline): entities 3
    at(spline_kind): spline 0
    check(_): "three clicks and right-click create a spline" spline_kind "SPLINE"
    at(spline_degree): spline 1
    check(_): "three control points use a valid spline degree" spline_degree 2
    at(control_points): spline 2
    len(control_point_values): control_points
    check(_): "spline keeps its control points" control_point_values 6
    tl_bspline_points(approximation): spline_degree control_points 64
    len(approximation_values): approximation
    check(_): "spline is approximated by a smooth point sequence" {approximation_values > control_point_values} true

    tulatool(_): "line"
    tula_draw_click(_): 0 0
    tula_draw_click(_): 5 0
    tula_draw_click(_): 5 5
    set(entities): tula_entities?
    len(entity_count): entities
    check(_): "line tool keeps adding segments" entity_count 6
    at(last_segment): entities 5
    at(last_start_x): last_segment 1
    at(last_start_y): last_segment 2
    check(_): "next line starts at the preceding point" {last_start_x = 5 && last_start_y = 0} true
    tulafinish(_):
    set(anchor): tula_anchor?
    len(anchor_points): anchor
    check(_): "right-click clears the line preview anchor" anchor_points 0

    tulatool(_): "ellipse"
    gettext(t): status
    check(_): "unknown tool refused" t "Tula's tools are select, line, circle segment and spline"

    settext(_): filename ""
    click(_): save_button
    gettext(t): status
    check(_): "filename required" t "Enter a DXF filename before saving"

    close(_): window
    set(result): 0
]
