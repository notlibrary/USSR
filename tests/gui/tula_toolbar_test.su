# Tula toolbar test. Needs a GLFW-enabled ussr and a display; the window is
# never shown. Run from the repository root:
#     ussr tests/gui/tula_toolbar_test.su
# Clicks every toolbar button through Petersburg's input path and checks the
# action it is connected to. Prints PASS or FAIL per check.
$include "../../src/tula/tula.su"

check(r): label got want [
    if(_): {got = want} [
        concat(_chk_line): "PASS " label
        print(_): _chk_line
    ]
    else(_): [
        concat(_chk_line): "FAIL " label
        print(_): _chk_line
        print(_): got
        print(_): want
    ]
    set(r): 0
]

near(r): label got want [
    set(_nr_d): {got - want}
    if(_): {_nr_d < 0} [
        set(_nr_d): {0 - _nr_d}
    ]
    check(r): label {_nr_d < 0.001} true
]

# the open file dialog: waits for it, puts path in its box and clicks its
# button (Open or Save); true when there was one
fd_answer(r): path [
    set(r): false
    set(k): 0
    while(_): {k < 100} [
        sleep(_): 20
        set(st): pfd_dialog?
        btget(w): st "win" null
        btget(done): st "done" true
        if(_): {w != null && done = false} [
            btget(text): st "text"
            settext(_): text path
            pfd_cb_text(_): text
            btget(ok): st "ok"
            inject(_): ok "click" 0 0 0
            sleep(_): 150
            set(r): true
            return(r): r
        ]
        set(k): {k + 1}
    ]
]

settle(r): [
    sleep(_): 60
    uiidle(_st_idle):
    set(_st_tries): 0
    while(_): {_st_idle = false && _st_tries < 200} [
        sleep(_): 10
        uiidle(_st_idle):
        set(_st_tries): {_st_tries + 1}
    ]
    set(r): 0
]

# Clicks the toolbar button with this label.
press(r): label [
    set(_pr_buttons): tula_buttons?
    set(_pr_names): tula_button_names?
    len(_pr_n): _pr_buttons
    set(_pr_i): 0
    set(r): false
    while(_): {_pr_i < _pr_n} [
        at(_pr_name): _pr_names _pr_i
        if(_): {_pr_name = label} [
            at(_pr_button): _pr_buttons _pr_i
            inject(_): _pr_button "click" 0 0 0
            settle(_):
            set(r): true
        ]
        set(_pr_i): {_pr_i + 1}
    ]
]

button_for(r): label [
    set(_bf_buttons): tula_buttons?
    set(_bf_names): tula_button_names?
    len(_bf_n): _bf_buttons
    set(_bf_i): 0
    while(_): {_bf_i < _bf_n} [
        at(_bf_name): _bf_names _bf_i
        if(_): {_bf_name = label} [
            at(r): _bf_buttons _bf_i
        ]
        set(_bf_i): {_bf_i + 1}
    ]
]

view(r): index [
    set(_vw_v): tula_view?
    at(r): _vw_v index
]

status(r): [
    set(_su_w): tula_status?
    gettext(r): _su_w
]

init(result): arg_count arg_values [
    # the recent-file lists go to a scratch HOME, not the user's
    getcwd(_home_cwd):
    concat(_home_dir): _home_cwd "/tests/gui/home_tmp"
    make_dir(_): _home_dir
    setenv(_): "HOME" _home_dir
    createwindow(window): "Tula toolbar test" 1100 800
    textbox(filename): window ""
    label(status_label): window ""
    tulainitialize(_): window status_label filename
    tulatoolbar(bar): window
    on(_): window "key" "tulakey"

    set(names): tula_button_names?
    set(all): ""
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(x): names i
        concat(all): all x "|"
        set(i): {i + 1}
    ]
    check(_): "toolbar buttons" all "Open|Save|Save As|Line|Circle|Zoom +|Zoom -|Fit|Left|Right|Up|Down|"

    press(_): "Circle"
    status(t):
    check(_): "Circle button selects tool" t "CIRCLE tool: click the snapped center"
    button_for(b): "Circle"
    getchecked(c): b
    check(_): "Circle button pressed" c true
    button_for(b): "Line"
    getchecked(c): b
    check(_): "Line button released" c false
    press(_): "Line"
    getchecked(c): b
    check(_): "Line button pressed" c true
    status(t):
    check(_): "Line button selects tool" t "LINE tool: click the first snapped endpoint"

    view(s0): 2
    press(_): "Zoom +"
    view(s1): 2
    near(_): "Zoom + scales by 1.25" s1 {s0 * 1.25}
    press(_): "Zoom -"
    view(s2): 2
    near(_): "Zoom - scales back" s2 s0

    view(x0): 0
    view(y0): 1
    press(_): "Left"
    view(x1): 0
    near(_): "Left shows more on the left" x1 {x0 + 100}
    press(_): "Right"
    view(x1): 0
    near(_): "Right undoes Left" x1 x0
    press(_): "Up"
    view(y1): 1
    near(_): "Up shows more above" y1 {y0 + 100}
    press(_): "Down"
    view(y1): 1
    near(_): "Down undoes Up" y1 y0

    press(_): "Fit"
    status(t):
    check(_): "Fit on an empty drawing" t "Nothing to fit: the drawing is empty"

    # Open: Petersburg's file dialog, answered with the fixture
    getcwd(_tt_cwd):
    concat(_tt_sample): _tt_cwd "/tests/gui/fixtures/sample.dxf"
    press(_): "Open"
    fd_answer(_tt_had): _tt_sample
    check(_): "Open shows the file dialog" _tt_had true
    sleep(_): 200
    set(e): tula_entities?
    len(n): e
    check(_): "Open loads the file chosen" n 9
    gettext(_tt_box): filename
    str_replace(_tt_sample2): _tt_sample "\\" "/"
    check(_): "the filename box shows it" _tt_box _tt_sample2
    press(_): "Zoom +"
    press(_): "Fit"
    set(v): tula_view?
    at(sfit): v 2
    # the scale that fits the drawing's box (x1.1) in the canvas as it is
    tula_canvas_center(_tt_c):
    at(_tt_cx): _tt_c 0
    at(_tt_cy): _tt_c 1
    set(_tt_es): tula_entities?
    tula_bounds(_tt_b): _tt_es
    at(_tt_x0): _tt_b 0
    at(_tt_y0): _tt_b 1
    at(_tt_x1): _tt_b 2
    at(_tt_y1): _tt_b 3
    set(_tt_want): {_tt_cx * 2 / ((_tt_x1 - _tt_x0) * 1.1)}
    set(_tt_hs): {_tt_cy * 2 / ((_tt_y1 - _tt_y0) * 1.1)}
    if(_): {_tt_hs < _tt_want} [ set(_tt_want): _tt_hs ]
    near(_): "Fit button refits" sfit _tt_want

    settext(_): filename "tula_toolbar_out.dxf"
    press(_): "Save"
    status(t):
    check(_): "Save writes the file named in the box" t "Saved 9 object(s) to tula_toolbar_out.dxf"
    file_exists(f): "tula_toolbar_out.dxf"
    check(_): "saved file exists" f true
    remove_file(_): "tula_toolbar_out.dxf"
    # Save As: the dialog, a new name; the extension is added
    concat(_tt_as): _tt_cwd "/tula_toolbar_as"
    press(_): "Save As"
    fd_answer(_tt_had): _tt_as
    check(_): "Save As shows the file dialog" _tt_had true
    sleep(_): 200
    concat(_tt_asf): _tt_as ".dxf"
    file_exists(f): _tt_asf
    check(_): "Save As writes the new name, with .dxf" f true
    # the File menu: saved and opened drawings come first in its list
    recentfiles(_tt_rl): "tula"
    at(_tt_r0): _tt_rl 0
    str_replace(_tt_r0): _tt_r0 "\\" "/"
    str_replace(_tt_asf2): _tt_asf "\\" "/"
    check(_): "the drawing saved last is first in the recent list" _tt_r0 _tt_asf2
    set(_tt_menu): tula_filemenu?
    gettext(_tt_ml): _tt_menu
    check(_): "the File menu is on the toolbar" _tt_ml "File"
    inject(_): _tt_menu "select" 0 0 0
    sleep(_): 300
    set(e): tula_entities?
    len(n): e
    check(_): "File > New empties the drawing" n 0
    gettext(_tt_box): filename
    check(_): "and the filename box" _tt_box ""
    inject(_): _tt_menu "select" 5 0 0
    sleep(_): 300
    set(e): tula_entities?
    len(n): e
    check(_): "File > the first recent drawing opens it" n 9
    remove_file(_): _tt_asf

    # keyboard shortcuts through the window key event
    view(x0): 0
    inject(_): window "key" 263 0 0
    settle(_):
    view(x1): 0
    near(_): "Left arrow pans" x1 {x0 + 100}
    view(s0): 2
    inject(_): window "key" 61 0 0
    settle(_):
    view(s1): 2
    near(_): "= key zooms in" s1 {s0 * 1.25}
    inject(_): window "key" 70 0 0
    settle(_):
    view(s2): 2
    near(_): "F key fits" s2 sfit

    close(_): window
    set(result): 0
]
