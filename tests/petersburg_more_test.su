    ps_raster(wi_img): wi_s3 120 16 16777215
    ps_crc(wi_c): wi_img
    str_from_int(wi_cs): wi_c
    concat(wi_line): "crc widgets " wi_cs
    print(_): wi_line
    set(r): 0
]

pm_handler(r): name [
    concat(r): "ran " name
]

pm_tick(r): n [
    set(r): {n < 3}
]

pm_services(r): [
    pb_undo_new(se_u): 3
    pb_undo_push(_): se_u "type a" "" "a"
    pb_undo_push(_): se_u "type a" "a" "ab"
    pb_undo_push(_): se_u "bold" "ab" "**ab**"
    pb_undo_modified(se_v): se_u
    pm_check(_): "modified" se_v true
    pb_undo(se_v): se_u
    pm_check(_): "undo" se_v "ab"
    pb_undo(se_v): se_u
    pm_check(_): "typing merged into one step" se_v ""
    pb_undo(se_v): se_u
    pm_check(_): "nothing more" se_v null
    pb_redo(se_v): se_u
    pm_check(_): "redo" se_v "ab"
    pb_undo_mark_saved(_): se_u
    pb_undo_modified(se_v): se_u
    pm_check(_): "saved" se_v false
    set(se_i): 0
    while(_): {se_i < 5} [
        str_from_int(se_is): se_i
        pb_undo_push(_): se_u se_is se_i {se_i + 1}
        set(se_i): {se_i + 1}
    ]
    btget(se_d): se_u "done"
    len(se_v): se_d
    pm_check(_): "the limit" se_v 3

    pb_commands(se_c):
    pb_command(_): se_c "save" "Save" "Ctrl+S" "pm_handler"
    pb_command(_): se_c "quit" "Quit" "Ctrl+Q" "pm_handler"
    pb_accelerator(se_v): se_c "ctrl+s"
    pm_check(_): "a shortcut finds its command" se_v "save"
    pb_run_command(se_v): se_c "save"
    pm_check(_): "it runs" se_v "ran save"
    pb_enable(_): se_c "save" false
    pb_accelerator(se_v): se_c "Ctrl+S"
    pm_check(_): "a disabled command takes no key" se_v ""
    pb_run_command(se_v): se_c "save"
    pm_check(_): "and does not run" se_v null
    vec(se_names): ""
    push(_): se_names "save"
    push(_): se_names "-"
    push(_): se_names "quit"
    pb_command_menu(se_m): se_c se_names
    at(se_v): se_m 2
    encode(se_v): se_v
    pm_check(_): "a menu from commands" se_v "[`Quit`,`ctrl+q`,`quit`]"

    pb_model(se_mod):
    pw_slider(se_sl): 0 0 100 10 0 0 100
    pb_bind(_): se_mod "volume" se_sl "value"
    pb_set(se_v): se_mod "volume" 70
    pm_check(_): "a bound value reaches its widget" se_v 1
    btget(se_v): se_sl "value"
    pm_check(_): "the slider shows it" se_v 70
    pw_pointer(_): se_sl 20 5 "click"
    pb_pull(_): se_mod "volume" se_sl "value"
    btget(se_v): se_mod "volume"
    pm_check(_): "and back from the widget" se_v 20

    pb_ease(se_v): "in" 0.5
    pm_check(_): "ease in" se_v 0.25
    pb_ease(se_v): "out" 0.5
    pm_check(_): "ease out" se_v 0.75
    pb_ease(se_v): "bounce" 1
    pm_check(_): "bounce lands" se_v 1.0
    pb_tween(se_v): 0 100 1000 200 "linear" 1100
    pm_check(_): "half way" se_v 50.0
    pb_tween(se_v): 0 100 1000 200 "linear" 5000
    pm_check(_): "past the end" se_v 100

    pb_job(se_j): 4
    pb_job_step(_): se_j
    pb_job_percent(se_v): se_j
    pm_check(_): "a job's progress" se_v 25
    pb_job_cancel(_): se_j
    pb_job_step(se_v): se_j
    pm_check(_): "a cancelled job stops" se_v false
    btget(se_v): se_j "state"
    pm_check(_): "and says so" se_v "cancelled"

    pb_tab_next(se_v): 2 3 false
    pm_check(_): "Tab wraps round" se_v 0
    pb_tab_next(se_v): 0 3 true
    pm_check(_): "Shift+Tab goes back" se_v 2

    pb_record(_): 5 "click" 0 0 0
    pb_record(_): 7 "key" 65 0 0
    pb_recording_text(se_t):
    pb_replay_events(se_e): se_t
    len(se_v): se_e
    pm_check(_): "recorded events" se_v 2
    at(se_v): se_e 1
    at(se_v): se_v 2
    pm_check(_): "with their values" se_v 65

    pb_note(_): 10 1 "button"
    pb_note(_): 11 1 "label"
    pb_note(_): 12 10 "label"
    pb_children(se_v): 1
    encode(se_v): se_v
    pm_check(_): "children" se_v "[10,11]"
    pb_parent(se_v): 12
    pm_check(_): "a parent" se_v 10
    pb_kind(se_v): 11
    pm_check(_): "a kind" se_v "label"

    pb_ui_parse(se_ui): "window{title=`Hello`, label{text=`Name:`, row=0, col=0}, textbox{name=\"who\", row=0, col=1, expand=true}, button{text=`OK`, on_click=`ok_pressed`}, listbox{items=[`a`, `b`]}}"
    btget(se_v): se_ui "kind"
    pm_check(_): "a declarative UI" se_v "window"
    btget(se_k): se_ui "children"
    len(se_v): se_k
    pm_check(_): "its children" se_v 4
    at(se_tb): se_k 1
    btget(se_v): se_tb "name"
    pm_check(_): "a quoted string" se_v "who"
    btget(se_v): se_tb "expand"
    pm_check(_): "a true" se_v true
    btget(se_v): se_tb "col"
    pm_check(_): "a number" se_v 1
    at(se_lb): se_k 3
    btget(se_v): se_lb "items"
    encode(se_v): se_v
    pm_check(_): "a list" se_v "[`a`,`b`]"

    pb_clipboard_set(_): "copied"
    pb_clipboard_get(se_v):
    pm_check(_): "the clipboard" se_v "copied"

    pb_every(se_id): 5 "pm_tick"
    set(se_wait): 0
    btget(se_stop): se_id "stop"
    while(_): {se_stop = false && se_wait < 400} [
        sleep(_): 5
        set(se_wait): {se_wait + 1}
        btget(se_stop): se_id "stop"
    ]
    pb_timer_ticks(se_n): se_id
    pm_check(_): "a timer ticks until its handler says no" se_n 3
    set(r): 0
]

init(ret): arg_cnt arg_vec [
    set(ret): 0
    pm_scene(_):
    pm_raster(_):
    pm_tui(_):
    pm_layout(_):
    pm_widgets(_):
    pm_services(_):
]
