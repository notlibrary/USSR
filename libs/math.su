# math.su - numeric helpers.
# Constants arrive as preprocessor macros:
#   M_PI, M_E
# Library-provided functions (pure USSR):
#   sqrt(r): x      -> Newton iterations, -1 after error for x < 0
#   sin(r): x       -> range-reduced fitted polynomials, radians
#   cos(r): x       -> same reduction, radians
#   ln(r): x        -> atanh series, x > 0 (0 after error otherwise)
#   exp(r): x       -> range-reduced series
#   pow(r): x y     -> exp(y * ln(x))
#   floor(r): x     -> largest integer <= x
#   ceil(r): x      -> smallest integer >= x
#   atan(r): x      -> inverse tangent via reduction + Taylor series
#   asin(r): x      -> atan(x / sqrt(1 - x^2)), |x| <= 1
#   acos(r): x      -> pi/2 - asin(x), |x| <= 1
#   atan2(r): y x   -> angle of point (x, y) in (-pi, pi]

$define M_PI 3.14159265358979323846
$define M_E 2.71828182845904523536

sqrt(r): x [
    if(_): {x < 0} [
        print(_): "sqrt: negative input"
        set(r): {0 - 1}
    ]
    if(_): {x = 0} [
        set(r): 0
    ]
    if(_): {x > 0} [
        set(math_x): {x * 1.0}
        set(math_g): math_x
        set(math_i): 0
        while(_): {math_i < 40} [
            set(math_g): {(math_g + math_x / math_g) / 2.0}
            add(math_i): math_i 1
        ]
        set(r): math_g
    ]
]

# sin.su - range-reduced polynomial sine for USSR.
#
# Range reduction:
#   x -> [-pi, pi] -> [-pi/2, pi/2] -> [-pi/4, pi/4]
#
# The final approximations are fitted polynomials, not Taylor expansions.
# A degree-7 odd sine polynomial is used in the center and a degree-8
# even cosine polynomial is used near +/-pi/2.
#
# Approximation error on [-pi/4, pi/4]:
#   sine polynomial: about 3.3e-9
#   cosine polynomial: about 1.4e-10
#
# The reduction uses loops instead of a dependency on fmod().

sin(r): x [
    set(pi): 3.141592653589793
    set(two_pi): 6.283185307179586
    set(half_pi): 1.570796326794897
    set(quarter_pi): 0.785398163397448
    set(neg_pi): {0 - pi}
    set(neg_half_pi): {0 - half_pi}
    set(neg_quarter_pi): {0 - quarter_pi}

    while(_): {x > pi} [
        set(x): {x - two_pi}
    ]
    while(_): {x < neg_pi} [
        set(x): {x + two_pi}
    ]

    # Fold the second and third quadrants onto [-pi/2, pi/2].
    if(_): {x > half_pi} [
        set(x): {pi - x}
    ]
    if(_): {x < neg_half_pi} [
        set(t): {0 - pi}
        set(x): {t - x}
    ]

    # Fitted odd polynomial for sin(x), valid on [-pi/4, pi/4].
    # Evaluate as a sum of powers rather than Horner: this also keeps the
    # arithmetic explicit for USSR's current real-expression evaluator.
    set(xsq): {x * x}
    set(xcube): {x * xsq}
    set(xquint): {xcube * xsq}
    set(xsept): {xquint * xsq}
    set(t1): {0.999999989793263 * x}
    set(tsq): {0.166666423788931 * xcube}
    set(t3): {0.00833179568404441 * xquint}
    set(tquart): {0.000194842004366703 * xsept}
    set(r): {t1 - tsq}
    set(r): {r + t3}
    set(r): {r - tquart}

    # For the outer part use sin(x) = cos(pi/2-|x|), with the sign.
    if(_): {x > quarter_pi} [
        set(t): {half_pi - x}
        set(tsq): {t * t}
        set(tquart): {tsq * tsq}
        set(tsext): {tquart * tsq}
        set(toct): {tsext * tsq}
        set(cc): 0.999999999966839
        set(csq): {0.499999997041751 * tsq}
        set(cquart): {0.041666625073429 * tquart}
        set(csext): {0.00138868635757995 * tsext}
        set(coct): {0.000024401924633 * toct}
        set(r): {cc - csq}
        set(r): {r + cquart}
        set(r): {r - csext}
        set(r): {r + coct}
    ]

    if(_): {x < neg_quarter_pi} [
        set(t): {half_pi + x}
        set(tsq): {t * t}
        set(tquart): {tsq * tsq}
        set(tsext): {tquart * tsq}
        set(toct): {tsext * tsq}
        set(cc): 0.999999999966839
        set(csq): {0.499999997041751 * tsq}
        set(cquart): {0.041666625073429 * tquart}
        set(csext): {0.00138868635757995 * tsext}
        set(coct): {0.000024401924633 * toct}
        set(r): {0 - cc}
        set(r): {r + csq}
        set(r): {r - cquart}
        set(r): {r + csext}
        set(r): {r - coct}
    ]

]

# ln.su
# Range-reduced series for the natural logarithm.
#
# For x > 0:
#
#     x = m * 2^e
#
# with
#
#     sqrt(1/2) <= m <= sqrt(2)
#
# Then:
#
#     ln(x) = ln(m) + e * ln(2)
#
# ln(m) uses the atanh series with z = (m - 1) / (m + 1):
#
#     ln(m) = 2 * (z + z^3/3 + z^5/5 + ...)
#
# On the reduced interval |z| <= 0.1716, so 12 terms land at full
# double precision (worst-case error about 1e-19 before rounding).

ln(r): x [
    set(sqrt_half): 0.7071067811865475
    set(sqrt_two): 1.4142135623730951
    set(ln_two): 0.6931471805599453
    set(e): 0

    # Domain check.
    # USSR currently has no standard NaN/domain-error value,
    # so return 0 for x <= 0.
    if(_): {x <= 0} [
        set(r): 0
        return(r): r
    ]

    # Range reduction.
    #
    # x = m * 2^e
    #
    # Keep m in [sqrt(1/2), sqrt(2)].

    while(_): {x > sqrt_two} [
        set(x): {x / 2}
        set(e): {e + 1}
    ]

    while(_): {x < sqrt_half} [
        set(x): {x * 2}
        set(e): {e - 1}
    ]

    # atanh series variable.
    #
    # z = (m - 1) / (m + 1)

    set(z): {(x - 1) / (x + 1)}
    set(zsq): {z * z}
    set(term): z
    set(sum): z

    # 12 odd-power terms: z^3/3 .. z^25/25.

    set(i): 1
    while(_): {i < 12} [
        set(term): {term * zsq}
        set(denom): {2 * i + 1}
        set(sum): {sum + term / denom}
        add(i): i 1
    ]

    # ln(m) = 2 * atanh(z); restore the exponent contribution.

    set(r): {2 * sum + e * ln_two}

    return(r): r
]

# cos.su
# Cosine based on the USSR polynomial sin() implementation.

cos(r): x [
    set(pi): 3.14159265358979323846
    set(half_pi): 1.57079632679489661923

    set(r): {x + half_pi}

    sin(r): r

    return(r): r
]

# tan.su
# Tangent based on sin() and cos().

tan(r): x [
    cos(c): x
    sin(s): x

    # tan(x) = sin(x) / cos(x)
    set(r): {s / c}

    return(r): r
]

# ctg.su
# Cotangent based on sin() and cos().

ctg(r): x [
    cos(c): x
    sin(s): x

    # ctg(x) = cos(x) / sin(x)
    set(r): {c / s}

    return(r): r
]

# abs.su
# Absolute value.

abs(r): x [
    if(_): {x < 0} [
        set(x): {-x}
    ]

    set(r): x
    return(r): r
]

# exp.su
# Exponential function.
#
# exp(x) = e^x
#
# Range reduction:
#
#     x = k * ln(2) + r
#
# therefore:
#
#     e^x = 2^k * e^r
#
# The polynomial is evaluated with Horner's method.

exp(r): x [
    set(ln_two): 0.69314718055994530942

    # Split x into an integer multiple of ln(2)
    # and a small remainder.
    #
    # k is chosen so that r is approximately
    # in [-ln(2)/2, ln(2)/2].

    set(k): {x / ln_two}

    if(_): {k >= 0} [
        set(k): {k + 0.5}
    ]

    if(_): {k < 0} [
        set(k): {k - 0.5}
    ]

    # USSR integer conversion through division/modulo
    # is not yet guaranteed to provide floor(), so
    # keep the reduction explicit.

    set(n): 0

    while(_): {k >= 1} [
        set(k): {k - 1}
        set(n): {n + 1}
    ]

    while(_): {k <= -1} [
        set(k): {k + 1}
        set(n): {n - 1}
    ]

    set(r): {x - n * ln_two}

    # e^r polynomial.
    #
    # Coefficients of the Taylor polynomial are used
    # only over the small reduced interval.
    #
    # e^r ≈
    #
    # 1 + r + r²/2! + ... + r^12/12!

    set(p): 0.00000000208767569878681
    set(p): {p * r + 0.0000000250521083854417}
    set(p): {p * r + 0.000000275573192239859}
    set(p): {p * r + 0.00000275573192239859}
    set(p): {p * r + 0.0000248015873015873}
    set(p): {p * r + 0.000198412698412698}
    set(p): {p * r + 0.00138888888888889}
    set(p): {p * r + 0.00833333333333333}
    set(p): {p * r + 0.0416666666666667}
    set(p): {p * r + 0.166666666666667}
    set(p): {p * r + 0.5}
    set(p): {p * r + 1}
    set(p): {p * r + 1}

    # Restore the power of two.
    #
    # p = e^r
    # result = p * 2^n

    if(_): {n > 0} [
        while(_): {n > 0} [
            set(p): {p * 2}
            set(n): {n - 1}
        ]
    ]

    if(_): {n < 0} [
        while(_): {n < 0} [
            set(p): {p / 2}
            set(n): {n + 1}
        ]
    ]

    set(r): p
    return(r): r
]

pow(r): x y [
    ln(l): x
    set(t): {y * l}
    exp(r): t
    return(r): r
]

# floor/ceil use a binary-step search, so the number of iterations is
# logarithmic in |x| rather than proportional to its magnitude. The
# integer step is doubled until it no longer fits, then halved back down.
# This avoids relying on a real-to-integer cast or a native math function.

# floor/ceil use a binary-step search, so the number of iterations is
# logarithmic in |x| rather than proportional to its magnitude. The
# integer step is doubled until it no longer fits, then halved back down.
# This avoids relying on a real-to-integer cast or a native math function.

floor(r): x [
    set(neg): 0
    if(_): {x < 0} [
        set(neg): 1
        set(x): {0 - x}
    ]

    set(i): 0
    set(step): 1

    while(_): {i + step <= x} [
        set(i): {i + step}
        set(step): {step * 2}
    ]

    while(_): {step >= 1} [
        if(_): {i + step <= x} [
            set(i): {i + step}
        ]
        set(step): {step / 2}
    ]

    if(_): {neg = 1} [
        if(_): {x > i} [
            set(i): {i + 1}
        ]
        set(i): {0 - i}
    ]

    set(r): i
    return(r): r
]

ceil(r): x [
    set(neg): 0
    if(_): {x < 0} [
        set(neg): 1
        set(x): {0 - x}
    ]

    set(i): 0
    set(step): 1

    while(_): {i + step <= x} [
        set(i): {i + step}
        set(step): {step * 2}
    ]

    while(_): {step >= 1} [
        if(_): {i + step <= x} [
            set(i): {i + step}
        ]
        set(step): {step / 2}
    ]

    if(_): {neg = 0} [
        if(_): {x > i} [
            set(i): {i + 1}
        ]
    ]
    if(_): {neg = 1} [
        set(i): {0 - i}
    ]

    set(r): i
    return(r): r
]

# atan.su - inverse tangent.
#
# Range reduction for x >= 0:
#   x > 1            -> atan(x) = pi/2 - atan(1/x)
#   x > tan(pi/12)   -> atan(x) = pi/6 + atan((x - t6) / (1 + x*t6))
#                       with t6 = tan(pi/6) = 1/sqrt(3)
#
# The reduced argument is within |x| <= tan(pi/12) ~= 0.268, where the
# Taylor series x - x^3/3 + x^5/5 - ... converges fast; 13 odd terms
# give full double precision. Negative input is mirrored at the end.

atan(r): x [
    set(pi): 3.141592653589793
    set(half_pi): 1.5707963267948966
    set(sixth_pi): 0.5235987755982988
    set(tan12): 0.2679491924311228
    set(tan6): 0.5773502691896258

    set(neg): 0
    if(_): {x < 0} [
        set(neg): 1
        set(x): {0 - x}
    ]

    set(add): 0
    if(_): {x > 1} [
        set(x): {1.0 / x}
        set(add): 1
    ]

    set(adj): 0
    if(_): {x > tan12} [
        set(x): {(x - tan6) / (1.0 + x * tan6)}
        set(adj): 1
    ]

    set(xsq): {x * x}
    set(term): x
    set(sum): x
    set(i): 1
    while(_): {i < 14} [
        set(term): {0 - term * xsq}
        set(denom): {2 * i + 1}
        set(sum): {sum + term / denom}
        add(i): i 1
    ]

    if(_): {adj = 1} [
        set(sum): {sum + sixth_pi}
    ]
    if(_): {add = 1} [
        set(sum): {half_pi - sum}
    ]
    if(_): {neg = 1} [
        set(sum): {0 - sum}
    ]

    set(r): sum
    return(r): r
]

# asin.su - inverse sine through atan:
#   asin(x) = atan(x / sqrt(1 - x^2)), |x| < 1
# asin(+/-1) = +/-pi/2. Out-of-domain input prints an error and
# returns 0, like ln returns 0 for x <= 0.

asin(r): x [
    set(half_pi): 1.5707963267948966
    set(neg_one): {0 - 1}
    set(ok): 1

    if(_): {x > 1} [
        print(_): "asin: out of domain"
        set(ok): 0
    ]
    if(_): {x < neg_one} [
        print(_): "asin: out of domain"
        set(ok): 0
    ]

    set(r): 0
    if(_): {ok = 1} [
        if(_): {x = 1} [
            set(r): half_pi
        ]
        if(_): {x = neg_one} [
            set(r): {0 - half_pi}
        ]
        set(inner): 0
        if(_): {x < 1} [
            if(_): {x > neg_one} [
                set(inner): 1
            ]
        ]
        if(_): {inner = 1} [
            sqrt(q): {1.0 - x * x}
            atan(r): {x / q}
        ]
    ]
    return(r): r
]

# acos.su - inverse cosine:
#   acos(x) = pi/2 - asin(x)

acos(r): x [
    set(half_pi): 1.5707963267948966
    asin(a): x
    set(r): {half_pi - a}
    return(r): r
]

# atan2.su - two-argument inverse tangent: the angle of the point
# (x, y), result in (-pi, pi]. atan2(0, 0) is undefined and returns 0.

atan2(r): y x [
    set(pi): 3.141592653589793
    set(half_pi): 1.5707963267948966
    set(r): 0

    if(_): {x > 0} [
        atan(a): {y / x}
        set(r): a
    ]
    if(_): {x < 0} [
        atan(a): {y / x}
        if(_): {y >= 0} [
            set(r): {a + pi}
        ]
        if(_): {y < 0} [
            set(r): {a - pi}
        ]
    ]
    if(_): {x = 0} [
        if(_): {y > 0} [
            set(r): half_pi
        ]
        if(_): {y < 0} [
            set(r): {0 - half_pi}
        ]
    ]

    return(r): r
]


# Great-circle distance between two geographic coordinates.
# Inputs: latitude/longitude pairs in degrees.
# Output: distance in kilometers using Earth's mean radius.
#
# The haversine central-angle form is stable for small distances:
#   a = sin^2(dlat/2) + cos(lat1)*cos(lat2)*sin^2(dlon/2)
#   central_angle = 2*atan2(sqrt(a), sqrt(1-a))
#   distance = Earth_radius * central_angle

grcirc_dist(r): lat1 long1 lat2 long2 [
    set(deg_to_rad): {3.14159265358979323846 / 180.0}
    set(earth_radius_km): 6371.0088

    set(phi1): {lat1 * deg_to_rad}
    set(phi2): {lat2 * deg_to_rad}
    set(dphi): {(lat2 - lat1) * deg_to_rad}
    set(dlambda): {(long2 - long1) * deg_to_rad}
    set(half_dphi): {dphi / 2.0}
    set(half_dlambda): {dlambda / 2.0}

    sin(s1): half_dphi
    sin(s2): half_dlambda
    cos(c1): phi1
    cos(c2): phi2

    set(a): {s1 * s1 + c1 * c2 * s2 * s2}

    # Protect square roots from tiny floating-point overshoots.
    if(_): {a < 0} [
        set(a): 0
    ]
    if(_): {a > 1} [
        set(a): 1
    ]

    sqrt(root_a): a
    set(complement): {1.0 - a}
    sqrt(root_complement): complement
    atan2(angle_half): root_a root_complement
    set(angle): {2.0 * angle_half}
    set(r): {earth_radius_km * angle}
    return(r): r
]

# log2.su - Base-2 logarithm.

log2(r): x [
    ln(l): x
    set(r): {l / 0.69314718055994530942}
    return(r): r
]

# log10.su - Base-10 logarithm.

log10(r): x [
    ln(l): x
    set(r): {l / 2.30258509299404568402}
    return(r): r
]

# hypot.su - Stable Euclidean hypotenuse.

hypot(r): x y [
    abs(ax): x
    abs(ay): y

    if(_): {ax >= ay} [
        if(_): {ax = 0} [
            set(r): 0
            return(r): r
        ]

        set(t): {ay / ax}
        sqrt(s): {1 + t * t}
        set(r): {ax * s}
    ]

    if(_): {ay > ax} [
        set(t): {ax / ay}
        sqrt(s): {1 + t * t}
        set(r): {ay * s}
    ]

    return(r): r
]