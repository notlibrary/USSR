# math.su - numeric helpers.
# Native VM primitives owned by this module:
#   sin(r): x   -> sine of x (x in radians)
#   ln(r): x    -> natural logarithm of x, x must be positive
# Constants arrive as preprocessor macros:
#   M_PI, M_E
# sqrt(r): x uses Newton iterations and returns a real root.
# Negative input returns -1 after printing an error.

$define M_PI 3.14159265358979323846
$define M_E 2.71828182845904523536

sqrt(r): x [
    if(_): {x < 0} [
        print(_): "sqrt: negative input"
        set(r): {0 - 1}
    ]
    if(_): {x = 0} [
        set(r): 0
    ]
    if(_): {x > 0} [
        set(math_x): {x * 1.0}
        set(math_g): math_x
        set(math_i): 0
        while(_): {math_i < 40} [
            set(math_g): {(math_g + math_x / math_g) / 2.0}
            add(math_i): math_i 1
        ]
        set(r): math_g
    ]
]

# sin.su - range-reduced polynomial sine for USSR.
#
# Range reduction:
#   x -> [-pi, pi] -> [-pi/2, pi/2] -> [-pi/4, pi/4]
#
# The final approximations are fitted polynomials, not Taylor expansions.
# A degree-7 odd sine polynomial is used in the center and a degree-8
# even cosine polynomial is used near +/-pi/2.
#
# Approximation error on [-pi/4, pi/4]:
#   sine polynomial: about 3.3e-9
#   cosine polynomial: about 1.4e-10
#
# The reduction uses loops instead of a dependency on fmod().

sine(r): x [
    set(pi): 3.141592653589793
    set(two_pi): 6.283185307179586
    set(half_pi): 1.570796326794897
    set(quarter_pi): 0.785398163397448
    set(neg_pi): {0 - pi}
    set(neg_half_pi): {0 - half_pi}
    set(neg_quarter_pi): {0 - quarter_pi}

    while(_): {x > pi} [
        set(x): {x - two_pi}
    ]
    while(_): {x < neg_pi} [
        set(x): {x + two_pi}
    ]

    # Fold the second and third quadrants onto [-pi/2, pi/2].
    if(_): {x > half_pi} [
        set(x): {pi - x}
    ]
    if(_): {x < neg_half_pi} [
        set(t): {0 - pi}
        set(x): {t - x}
    ]

    # Fitted odd polynomial for sin(x), valid on [-pi/4, pi/4].
    # Evaluate as a sum of powers rather than Horner: this also keeps the
    # arithmetic explicit for USSR's current real-expression evaluator.
    set(xsq): {x * x}
    set(xcube): {x * xsq}
    set(xquint): {xcube * xsq}
    set(xsept): {xquint * xsq}
    set(t1): {0.999999989793263 * x}
    set(tsq): {0.166666423788931 * xcube}
    set(t3): {0.00833179568404441 * xquint}
    set(tquart): {0.000194842004366703 * xsept}
    set(r): {t1 - tsq}
    set(r): {r + t3}
    set(r): {r - tquart}

    # For the outer part use sin(x) = cos(pi/2-|x|), with the sign.
    if(_): {x > quarter_pi} [
        set(t): {half_pi - x}
        set(tsq): {t * t}
        set(tquart): {tsq * tsq}
        set(tsext): {tquart * tsq}
        set(toct): {tsext * tsq}
        set(cc): 0.999999999966839
        set(csq): {0.499999997041751 * tsq}
        set(cquart): {0.041666625073429 * tquart}
        set(csext): {0.00138868635757995 * tsext}
        set(coct): {0.000024401924633 * toct}
        set(r): {cc - csq}
        set(r): {r + cquart}
        set(r): {r - csext}
        set(r): {r + coct}
    ]

    if(_): {x < neg_quarter_pi} [
        set(t): {half_pi + x}
        set(tsq): {t * t}
        set(tquart): {tsq * tsq}
        set(tsext): {tquart * tsq}
        set(toct): {tsext * tsq}
        set(cc): 0.999999999966839
        set(csq): {0.499999997041751 * tsq}
        set(cquart): {0.041666625073429 * tquart}
        set(csext): {0.00138868635757995 * tsext}
        set(coct): {0.000024401924633 * toct}
        set(r): {0 - cc}
        set(r): {r + csq}
        set(r): {r - cquart}
        set(r): {r + csext}
        set(r): {r - coct}
    ]

]

# ln.su - range-reduced polynomial natural logarithm for USSR.
#
# Algorithm:
#   x = m * 2^e
#   sqrt(1/2) <= m <= sqrt(2)
#   ln(x) = ln(m) + e*ln(2)
#
# The reduction uses repeated multiplication/division by 2, so it does not
# need floor(), log2(), or a C math library.
#
# ln(m) is approximated by a degree-12 fitted polynomial on
# [sqrt(1/2), sqrt(2)].  This is a polynomial approximation after range
# reduction, rather than evaluating a Taylor series at runtime.
#
# Max absolute fit error on the reduced interval: 6.540e-11

ln(r): x [
    set(sqrt_half): 0.707106781186548
    set(sqrt_two): 1.414213562373095
    set(ln_two): 0.6931471805599453
    set(e): 0

    # ln is defined here only for positive real x.
    if(_): {x <= 0} [
        set(r): 0
        return(r): r
    ]

    # Range reduction: x = m * 2^e.
    while(_): {x > sqrt_two} [
        set(x): {x / 2}
        set(e): {e + 1}
    ]
    while(_): {x < sqrt_half} [
        set(x): {x * 2}
        set(e): {e - 1}
    ]

    # Fitted degree-12 polynomial for ln(m).
    # Evaluate powers explicitly to keep this friendly to the current
    # USSR real-expression evaluator.
    set(t): {x - 1}
    set(t2): {t * t}
    set(t3): {t2 * t}
    set(t4): {t3 * t}
    set(t5): {t4 * t}
    set(t6): {t5 * t}
    set(t7): {t6 * t}
    set(t8): {t7 * t}
    set(t9): {t8 * t}
    set(t10): {t9 * t}
    set(t11): {t10 * t}
    set(t12): {t11 * t}

    set(r): -3.1008762043328355
    set(r): -3.1008762043328355
    set(term): {11.942979116723437 * t}
    set(r): {r + term}
    set(term): {32.528916223050715 * t2}
    set(r): {r - term}
    set(term): {71.249121208646372 * t3}
    set(r): {r + term}
    set(term): {117.93752207290035 * t4}
    set(r): {r - term}
    set(term): {147.36949817037649 * t5}
    set(r): {r + term}
    set(term): {139.20308643650262 * t6}
    set(r): {r - term}
    set(term): {98.895517061264641 * t7}
    set(r): {r + term}
    set(term): {52.053431326793479 * t8}
    set(r): {r - term}
    set(term): {19.700726110340572 * t9}
    set(r): {r + term}
    set(term): {5.0724633898296609 * t10}
    set(r): {r - term}
    set(term): {0.79591197965958238 * t11}
    set(r): {r + term}
    set(term): {0.057457993591416102 * t12}
    set(r): {r - term}
    set(term): {e * ln_two}
    set(r): {r + term}
    return(r): r
]
