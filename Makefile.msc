# Makefile.msc - MSVC build, invoked as:
#
#     nmake /f Makefile.msc
#
# Requires cl.exe (a "Developer Command Prompt for VS" shell) and
# win_bison.exe / win_flex.exe on PATH -- MSVC ships neither yacc nor
# lex. The winflexbison project provides Bison/Flex-compatible
# binaries for Windows: https://github.com/lexxmark/winflexbison
#
# If you'd rather not take that dependency, generate parser.tab.c /
# parser.tab.h / lexer.c once (on any machine with real bison/flex,
# including WSL) and check them into src\; then override:
#     nmake /f Makefile.msc PREGENERATED=1
# which skips the win_bison/win_flex rules entirely and just compiles
# whatever src\parser.tab.c/src\lexer.c already exist.
#
# All sources live under src\. Windows-only replacements (fork/exec ->
# CreateProcess, bestline -> the native console line editor named
# worstline.*, deliberately not bestline.*, so grepping a symbol never
# leaves you wondering which implementation you're looking at) live
# under src\win\, alongside the shared cross-platform
# src\process.h/src\process_posix.c that the POSIX build also uses.
# Object files are written back into src\ (and src\win\) too, next to
# their sources, rather than the project root.

CC      = cl.exe
BISON   = win_bison.exe
FLEX    = win_flex.exe

SRC     = src
WIN     = src\win

CFLAGS  = /nologo /W3 /Zi /Od /D_CRT_SECURE_NO_WARNINGS /DYY_NO_UNISTD_H /I$(SRC) /I$(WIN)
LDFLAGS = /nologo /Zi /Fe:ussr.exe
LIBS    = user32.lib

TARGET  = ussr.exe

OBJS = \
    $(SRC)\ussr.obj \
    $(SRC)\pp.obj \
    $(SRC)\main.obj \
    $(SRC)\uno.obj \
    $(SRC)\ussr_oop_builtins.obj \
    $(SRC)\ussr_bytecode.obj \
    $(SRC)\parser.tab.obj \
    $(SRC)\lexer.obj \
    $(WIN)\process_win32.obj \
    $(WIN)\worstline.obj \
    $(WIN)\getopt.obj

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) $(OBJS) $(LIBS)

# --- generated parser/lexer ------------------------------------------
# Skipped when PREGENERATED=1 is passed on the nmake command line.

!IFNDEF PREGENERATED
$(SRC)\parser.tab.c $(SRC)\parser.tab.h: $(SRC)\parser.y
	$(BISON) -d -o $(SRC)\parser.tab.c $(SRC)\parser.y

$(SRC)\lexer.c: $(SRC)\lexer.l $(SRC)\parser.tab.h
	$(FLEX) -o $(SRC)\lexer.c $(SRC)\lexer.l
!ENDIF

# --- object files -----------------------------------------------------
# Written as explicit per-file rules (rather than relying on nmake's
# automatic $** / $< inside multi-dependency rules, which behaves
# inconsistently across nmake versions outside simple inference
# rules) so this stays predictable everywhere.

$(SRC)\ussr.obj: $(SRC)\ussr.c $(SRC)\ussr.h $(SRC)\uthash.h $(SRC)\uno.h $(SRC)\ussr_oop_builtins.h $(SRC)\process.h
	$(CC) $(CFLAGS) /c /Fo:$(SRC)\ussr.obj $(SRC)\ussr.c

$(SRC)\pp.obj: $(SRC)\pp.c $(SRC)\pp.h
	$(CC) $(CFLAGS) /c /Fo:$(SRC)\pp.obj $(SRC)\pp.c

$(SRC)\main.obj: $(SRC)\main.c $(WIN)\worstline.h $(WIN)\getopt.h $(SRC)\ussr.h $(SRC)\ussr_version.h $(SRC)\pp.h $(SRC)\uno.h $(SRC)\ussr_bytecode.h $(SRC)\ussr_oop_builtins.h
	$(CC) $(CFLAGS) /c /Fo:$(SRC)\main.obj $(SRC)\main.c

$(SRC)\uno.obj: $(SRC)\uno.c $(SRC)\uno.h $(SRC)\ussr.h
	$(CC) $(CFLAGS) /c /Fo:$(SRC)\uno.obj $(SRC)\uno.c

$(SRC)\ussr_oop_builtins.obj: $(SRC)\ussr_oop_builtins.c $(SRC)\ussr_oop_builtins.h $(SRC)\uno.h $(SRC)\ussr.h
	$(CC) $(CFLAGS) /c /Fo:$(SRC)\ussr_oop_builtins.obj $(SRC)\ussr_oop_builtins.c

$(SRC)\ussr_bytecode.obj: $(SRC)\ussr_bytecode.c $(SRC)\ussr_bytecode.h $(SRC)\ussr.h
	$(CC) $(CFLAGS) /c /Fo:$(SRC)\ussr_bytecode.obj $(SRC)\ussr_bytecode.c

$(SRC)\parser.tab.obj: $(SRC)\parser.tab.c $(SRC)\parser.tab.h
	$(CC) $(CFLAGS) /c /Fo:$(SRC)\parser.tab.obj $(SRC)\parser.tab.c

$(SRC)\lexer.obj: $(SRC)\lexer.c $(SRC)\parser.tab.h
	$(CC) $(CFLAGS) /c /Fo:$(SRC)\lexer.obj $(SRC)\lexer.c

$(WIN)\process_win32.obj: $(WIN)\process_win32.c $(SRC)\process.h
	$(CC) $(CFLAGS) /c /Fo:$(WIN)\process_win32.obj $(WIN)\process_win32.c

$(WIN)\worstline.obj: $(WIN)\worstline.c $(WIN)\worstline.h
	$(CC) $(CFLAGS) /c /Fo:$(WIN)\worstline.obj $(WIN)\worstline.c

$(WIN)\getopt.obj: $(WIN)\getopt.c $(WIN)\getopt.h
	$(CC) $(CFLAGS) /c /Fo:$(WIN)\getopt.obj $(WIN)\getopt.c

$(WIN)\getopt.obj: $(WIN)\getopt.c $(WIN)\getopt.h
	$(CC) $(CFLAGS) /c /Fo:$(WIN)\getopt.obj $(WIN)\getopt.c

clean:
	-del /q $(SRC)\*.obj $(WIN)\*.obj $(TARGET) *.pdb 2>NUL
	-del /q $(SRC)\parser.tab.c $(SRC)\parser.tab.h $(SRC)\lexer.c 2>NUL
