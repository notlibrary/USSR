# docgen.su - docs refine pass 1: documents generated from the sources,
# so they cannot drift, and checks over the docs. Run from the repository
# root:
#
#   ussr docs/tools/docgen.su builtins   docs/BUILTINS.md from src/help.c
#   ussr docs/tools/docgen.su libs       docs/LIBRARY.md from src/libs/*.su
#   ussr docs/tools/docgen.su roadmap    docs/ROADMAP.md from every REFINE.md
#   ussr docs/tools/docgen.su map        docs/REPOSITORY_MAP.md from every box.uno
#   ussr docs/tools/docgen.su all        all four
#   ussr docs/tools/docgen.su check      is docs/BUILTINS.md up to date? (exit 1)
#   ussr docs/tools/docgen.su links [FILE...]  broken relative links in
#                                        docs/*.md and src/*/README.md
#   ussr docs/tools/docgen.su coverage   builtins with no entry in help.c
$once
$include "../../src/libs/strings.su"

# --- files

dg_read(r): path [
    set(r): null
    file_exists(e): path
    if(_): {e = false} [ return(r): r ]
    readfile(r): path
    str_replace(r): r "\r" ""
]

dg_write(r): path text [
    set(r): 0
    writefile(_): path text
    concat(m): "wrote " path
    print(_): m
]

# names in a directory, sorted (list_dir gives the host's order)
dg_sorted_dir(r): dir [
    vec(r): ""
    list_dir(names): dir
    typeof(t): names
    if(_): {t != "vector"} [ return(r): r ]
    btree(s):
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(x): names i
        # list_dir marks folders with a "/" on some hosts
        str_ends(sl): x "/"
        if(_): sl [
            len(xl): x
            slice(x): x 0 {xl - 1}
        ]
        if(_): {x != "." && x != ".." && x != ""} [ btput(_): s x true ]
        set(i): {i + 1}
    ]
    btkeys(r): s
]

dg_is_dir(r): path [
    is_dir(d): path
    set(r): {d = 1 || d = true}
]

# the subproject folders: src/NAME holding a box.uno (and docs)
dg_projects(r): [
    vec(r): ""
    dg_sorted_dir(names): "src"
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(x): names i
        concat(d): "src/" x
        concat(b): d "/box.uno"
        dg_is_dir(isd): d
        file_exists(e): b
        if(_): {isd && e} [ push(_): r d ]
        set(i): {i + 1}
    ]
    file_exists(de): "docs/box.uno"
    if(_): de [ push(_): r "docs" ]
]

# --- C string literals: the text of "a" "b" with \" and \\ undone
dg_c_strings(r): text [
    vec(r): ""
    re_all(lits): "\"([^\"\\\\]|\\\\.)*\"" text
    typeof(t): lits
    if(_): {t != "vector"} [ return(r): r ]
    len(n): lits
    set(i): 0
    while(_): {i < n} [
        at(l): lits i
        len(ll): l
        slice(s): l 1 {ll - 2}
        str_replace(s): s "\\\"" "\""
        str_replace(s): s "\\n" " "
        str_replace(s): s "\\\\" "\\"
        push(_): r s
        set(i): {i + 1}
    ]
]

# the help table: [name group usage text] each, in its order
dg_help_entries(r): [
    vec(r): ""
    dg_read(c): "src/help.c"
    if(_): {c = null} [ return(r): r ]
    str_find(a): c "g_help[] = {" 0
    str_find(b): c "{ NULL, NULL, NULL, NULL }" a
    if(_): {a < 0 || b < 0} [ return(r): r ]
    slice(body): c a {b - a}
    # one entry per { "...", ... " }, (a usage may hold braces: split
    # where a string literal closes the entry)
    str_split(chunks): body "\" },"
    len(n): chunks
    set(i): 0
    while(_): {i < n} [
        at(ch): chunks i
        str_find(open): ch "{ \"" 0
        if(_): {open >= 0} [
            len(cl): ch
            slice(e): ch open {cl - open}
            concat(e): e "\""
            dg_c_strings(s): e
            len(ns): s
            if(_): {ns >= 4} [
                vec(row): ""
                at(x0): s 0
                at(x1): s 1
                at(x2): s 2
                push(_): row x0
                push(_): row x1
                push(_): row x2
                set(txt): ""
                set(k): 3
                while(_): {k < ns} [
                    at(xk): s k
                    concat(txt): txt xk
                    set(k): {k + 1}
                ]
                push(_): row txt
                push(_): r row
            ]
        ]
        set(i): {i + 1}
    ]
]

dg_md_cell(r): s [
    str_replace(r): s "|" "\\|"
]

# --- docs/BUILTINS.md

dg_builtins_text(r): [
    dg_help_entries(rows):
    set(r): "# USSR builtin reference\n\n"
    concat(r): r "Generated by `ussr docs/tools/docgen.su builtins` from the help table in\n"
    concat(r): r "`src/help.c` (what `help(_): \"GROUP\"` prints in the REPL), so it cannot\n"
    concat(r): r "drift from the program. Do not edit by hand: change `src/help.c` and run\n"
    concat(r): r "the generator; `tests/docs_test.su` fails when this file is stale.\n\n"
    # the groups, in their first order
    vec(groups): ""
    btree(seen):
    len(n): rows
    set(i): 0
    while(_): {i < n} [
        at(row): rows i
        at(g): row 1
        btget(was): seen g false
        if(_): {was = false} [
            btput(_): seen g true
            push(_): groups g
        ]
        set(i): {i + 1}
    ]
    len(ng): groups
    concat(r): r "Groups:"
    set(j): 0
    while(_): {j < ng} [
        at(g): groups j
        if(_): {j > 0} [ concat(r): r "," ]
        concat(r): r " [" g "](#" g ")"
        set(j): {j + 1}
    ]
    str_from_int(cs): n
    concat(r): r ". " cs " commands.\n"
    set(j): 0
    while(_): {j < ng} [
        at(g): groups j
        concat(r): r "\n## " g "\n\n| Command | Use | Does |\n|---------|-----|------|\n"
        set(i): 0
        while(_): {i < n} [
            at(row): rows i
            at(rg): row 1
            if(_): {rg = g} [
                at(name): row 0
                at(usage): row 2
                at(text): row 3
                dg_md_cell(us): usage
                dg_md_cell(ts): text
                concat(r): r "| `" name "` | `" us "` | " ts " |\n"
            ]
            set(i): {i + 1}
        ]
        set(j): {j + 1}
    ]
]

# --- docs/LIBRARY.md: each library's header comment

dg_header_comment(r): text [
    set(r): ""
    str_split(lines): text "\n"
    len(n): lines
    set(i): 0
    set(go): true
    while(_): {go && i < n} [
        at(l): lines i
        str_starts(c): l "#"
        if(_): c [
            len(ll): l
            set(from): 1
            if(_): {ll > 1} [
                slice(sp): l 1 1
                if(_): {sp = " "} [ set(from): 2 ]
            ]
            if(_): {from > ll} [ set(from): ll ]
            slice(body): l from {ll - from}
            concat(r): r body "\n"
        ]
        else(_): [ set(go): false ]
        set(i): {i + 1}
    ]
]

dg_libs_text(r): [
    set(r): "# USSR standard library reference\n\n"
    concat(r): r "Generated by `ussr docs/tools/docgen.su libs` from the header comment of\n"
    concat(r): r "each `src/libs/*.su` file: what each library says it provides, in its own\n"
    concat(r): r "words. Include one with `$include \"src/libs/NAME.su\"` (a path relative to\n"
    concat(r): r "the including file).\n\n"
    dg_sorted_dir(names): "src/libs"
    vec(libs): ""
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(x): names i
        str_ends(su): x ".su"
        if(_): su [ push(_): libs x ]
        set(i): {i + 1}
    ]
    len(nl): libs
    set(i): 0
    while(_): {i < nl} [
        at(x): libs i
        len(xl): x
        slice(stem): x 0 {xl - 3}
        concat(r): r "- [" x "](#" stem "su)\n"
        set(i): {i + 1}
    ]
    set(i): 0
    while(_): {i < nl} [
        at(x): libs i
        concat(p): "src/libs/" x
        dg_read(t): p
        dg_header_comment(h): t
        concat(r): r "\n## " x "\n\n"
        if(_): {h = ""} [ concat(r): r "(no header comment)\n" ]
        else(_): [ concat(r): r "```\n" h "```\n" ]
        set(i): {i + 1}
    ]
]

# --- docs/ROADMAP.md: the REFINE.md files counted

# [done partly open title] of a REFINE.md
dg_refine_counts(r): text [
    set(done): 0
    set(part): 0
    set(open): 0
    set(title): ""
    set(inbody): false
    str_split(lines): text "\n"
    len(n): lines
    set(i): 0
    while(_): {i < n} [
        at(l): lines i
        str_starts(h1): l "# "
        str_starts(h2): l "## "
        if(_): {h1 && title = ""} [
            len(ll): l
            slice(title): l 2 {ll - 2}
        ]
        if(_): h2 [ set(inbody): true ]
        str_starts(x): l "- [x] "
        str_starts(p): l "- [~] "
        str_starts(b): l "- "
        if(_): inbody [
            if(_): x [ set(done): {done + 1} ]
            elif(_): p [ set(part): {part + 1} ]
            elif(_): b [ set(open): {open + 1} ]
        ]
        set(i): {i + 1}
    ]
    vec(r): ""
    push(_): r done
    push(_): r part
    push(_): r open
    push(_): r title
]

dg_roadmap_text(r): [
    set(r): "# Roadmap\n\n"
    concat(r): r "Generated by `ussr docs/tools/docgen.su roadmap` from every subproject's\n"
    concat(r): r "`REFINE.md`: ideas marked `[x]` are done, `[~]` partly done, the rest open.\n"
    concat(r): r "A snapshot: run the generator again after a refine pass.\n\n"
    concat(r): r "| Subproject | Done | Partly | Open | Progress |\n|------------|-----:|-------:|-----:|----------|\n"
    dg_projects(ps):
    set(td): 0
    set(tp): 0
    set(to): 0
    len(n): ps
    set(i): 0
    while(_): {i < n} [
        at(d): ps i
        concat(f): d "/REFINE.md"
        dg_read(t): f
        if(_): {t != null} [
            dg_refine_counts(c): t
            at(cd): c 0
            at(cp): c 1
            at(co): c 2
            set(td): {td + cd}
            set(tp): {tp + cp}
            set(to): {to + co}
            set(all): {cd + cp + co}
            set(bar): ""
            if(_): {all > 0} [
                str_trunc(filled): {(cd * 2 + cp) * 10.0 / (all * 2)}
                str_repeat(a): "#" filled
                str_repeat(b): "." {10 - filled}
                concat(bar): "`" a b "`"
            ]
            len(dl): d
            set(name): d
            str_starts(s): d "src/"
            if(_): s [ slice(name): d 4 {dl - 4} ]
            str_from_int(s1): cd
            str_from_int(s2): cp
            str_from_int(s3): co
            concat(r): r "| [" name "](../" f ") | " s1 " | " s2 " | " s3 " | " bar " |\n"
        ]
        set(i): {i + 1}
    ]
    str_from_int(s1): td
    str_from_int(s2): tp
    str_from_int(s3): to
    concat(r): r "| **all** | **" s1 "** | **" s2 "** | **" s3 "** | |\n"
]

# --- docs/REPOSITORY_MAP.md: the packages and what they depend on

dg_box(r): path [
    set(r): null
    dg_read(t): path
    if(_): {t = null} [ return(r): r ]
    str_trim(t): t
    len(n): t
    if(_): {n > 2} [
        slice(q): t 0 1
        if(_): {q = "'"} [ slice(t): t 1 {n - 2} ]
    ]
    btree(r):
    vec(keys): ""
    push(_): keys "name"
    push(_): keys "version"
    push(_): keys "description"
    push(_): keys "entry"
    len(nk): keys
    set(i): 0
    while(_): {i < nk} [
        at(k): keys i
        concat(pat): k "=`([^`]*)`"
        re_find(m): pat t
        typeof(tm): m
        set(v): ""
        if(_): {tm = "vector"} [ at(v): m 1 ]
        btput(_): r k v
        set(i): {i + 1}
    ]
    re_find(dm): "dependencies=\\[([^\\]]*)\\]" t
    vec(deps): ""
    typeof(tdm): dm
    if(_): {tdm = "vector"} [
        at(inner): dm 1
        re_all(ds): "`[^`]*`" inner
        typeof(tds): ds
        if(_): {tds = "vector"} [
            len(nd): ds
            set(j): 0
            while(_): {j < nd} [
                at(x): ds j
                len(xl): x
                slice(x): x 1 {xl - 2}
                push(_): deps x
                set(j): {j + 1}
            ]
        ]
    ]
    btput(_): r "deps" deps
]

dg_map_text(r): [
    set(r): "# Repository map\n\n"
    concat(r): r "Generated by `ussr docs/tools/docgen.su map` from every `box.uno`: each\n"
    concat(r): r "package (the folders are named after towns and countries), its version,\n"
    concat(r): r "what it is and what it depends on. The interpreter itself is the C in\n"
    concat(r): r "`src/` (`main.c`, `ussr.c`, `parser.y`, ...); `tests/` holds the suites.\n\n"
    concat(r): r "| Package | Version | Entry | What it is | Depends on |\n|---------|---------|-------|------------|------------|\n"
    dg_projects(ps):
    btree(needed_by):
    len(n): ps
    set(i): 0
    while(_): {i < n} [
        at(d): ps i
        concat(f): d "/box.uno"
        dg_box(b): f
        if(_): {b != null} [
            btget(name): b "name"
            btget(ver): b "version"
            btget(desc): b "description"
            btget(entry): b "entry"
            btget(deps): b "deps"
            str_join(dj): deps ", "
            dg_md_cell(desc): desc
            concat(r): r "| [" name "](../" d ") | " ver " | `" entry "` | " desc " | " dj " |\n"
            len(nd): deps
            set(j): 0
            while(_): {j < nd} [
                at(x): deps j
                btget(was): needed_by x ""
                if(_): {was != ""} [ concat(was): was ", " ]
                concat(was): was name
                btput(_): needed_by x was
                set(j): {j + 1}
            ]
        ]
        set(i): {i + 1}
    ]
    concat(r): r "\n## Needed by\n\n"
    btrange(rows): needed_by
    len(nr): rows
    set(i): 0
    while(_): {i < nr} [
        at(row): rows i
        at(k): row 0
        at(v): row 1
        concat(r): r "- **" k "**: " v "\n"
        set(i): {i + 1}
    ]
]

# --- links: [text](target) whose relative target is missing

dg_links_in(r): file [
    vec(r): ""
    dg_read(t): file
    if(_): {t = null} [ return(r): r ]
    # code blocks hold no links
    str_split(lines): t "\n"
    set(code): false
    len(n): lines
    set(i): 0
    while(_): {i < n} [
        at(l): lines i
        str_starts(fence): l "```"
        if(_): fence [ set(code): {code = false} ]
        elif(_): {code = false} [
            re_all(ms): "\\]\\([^) ]+\\)" l
            typeof(tm): ms
            if(_): {tm = "vector"} [
                len(nm): ms
                set(k): 0
                while(_): {k < nm} [
                    at(m): ms k
                    len(ml): m
                    slice(target): m 2 {ml - 3}
                    vec(e): ""
                    push(_): e {i + 1}
                    push(_): e target
                    push(_): r e
                    set(k): {k + 1}
                ]
            ]
        ]
        set(i): {i + 1}
    ]
]

dg_dir_of(r): file [
    set(r): "."
    len(n): file
    set(i): {n - 1}
    while(_): {i >= 0} [
        slice(c): file i 1
        if(_): {c = "/"} [
            slice(r): file 0 i
            return(r): r
        ]
        set(i): {i - 1}
    ]
]

# file_exists with the case of every part checked, as on Linux (Windows
# and macOS would find "Readme.md" for "README.md")
dg_exists_exact(r): path [
    set(r): false
    file_exists(e): path
    if(_): {e = false} [ return(r): r ]
    str_split(parts): path "/"
    set(cur): ""
    len(n): parts
    set(i): 0
    while(_): {i < n} [
        at(p): parts i
        if(_): {p = "" || p = "."} [
            if(_): {cur = ""} [ set(cur): "." ]
        ]
        elif(_): {p = ".."} [
            if(_): {cur = "" || cur = "."} [ set(cur): ".." ]
            else(_): [ concat(cur): cur "/.." ]
        ]
        else(_): [
            set(base): cur
            if(_): {base = ""} [ set(base): "." ]
            dg_sorted_dir(names): base
            set(found): false
            len(nn): names
            set(k): 0
            while(_): {k < nn} [
                at(x): names k
                if(_): {x = p} [ set(found): true ]
                set(k): {k + 1}
            ]
            if(_): {found = false} [ return(r): r ]
            if(_): {cur = ""} [ set(cur): p ]
            else(_): [ concat(cur): cur "/" p ]
        ]
        set(i): {i + 1}
    ]
    set(r): true
]

dg_check_links(r): files [
    set(r): 0
    len(n): files
    set(i): 0
    while(_): {i < n} [
        at(f): files i
        dg_links_in(ls): f
        dg_dir_of(dir): f
        len(nl): ls
        set(k): 0
        while(_): {k < nl} [
            at(e): ls k
            at(ln): e 0
            at(target): e 1
            str_starts(web): target "http"
            str_starts(mail): target "mailto:"
            str_starts(anchor): target "#"
            if(_): {web = false && mail = false && anchor = false} [
                set(path): target
                str_find(h): path "#" 0
                if(_): {h >= 0} [ slice(path): path 0 h ]
                str_replace(path): path "%20" " "
                concat(full): dir "/" path
                dg_exists_exact(ok): full
                if(_): {ok = false} [
                    str_from_int(ls_): ln
                    concat(m): f ":" ls_ ": broken link " target
                    print(_): m
                    set(r): {r + 1}
                ]
            ]
            set(k): {k + 1}
        ]
        set(i): {i + 1}
    ]
]

dg_doc_files(r): [
    vec(r): ""
    dg_sorted_dir(names): "docs"
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(x): names i
        str_ends(md): x ".md"
        if(_): md [
            concat(p): "docs/" x
            push(_): r p
        ]
        set(i): {i + 1}
    ]
    dg_projects(ps):
    len(np): ps
    set(i): 0
    while(_): {i < np} [
        at(d): ps i
        concat(p): d "/README.md"
        file_exists(e): p
        if(_): {e && d != "docs"} [ push(_): r p ]
        set(i): {i + 1}
    ]
]

# --- coverage: builtins the autocompleter knows and help.c does not

dg_coverage(r): [
    set(r): 0
    dg_help_entries(rows):
    btree(have):
    len(n): rows
    set(i): 0
    while(_): {i < n} [
        at(row): rows i
        at(name): row 0
        btput(_): have name true
        set(i): {i + 1}
    ]
    dg_read(c): "src/autocomplete.c"
    str_find(a): c "ac_builtin_commands[] =" 0
    str_find(b): c "};" a
    slice(body): c a {b - a}
    dg_c_strings(names): body
    btree(missing):
    len(nn): names
    set(i): 0
    while(_): {i < nn} [
        at(x): names i
        btget(h): have x false
        if(_): {h = false} [ btput(_): missing x true ]
        set(i): {i + 1}
    ]
    btkeys(ms): missing
    len(nm): ms
    str_join(list): ms " "
    str_from_int(cs): nm
    str_from_int(hs): n
    concat(m): hs " commands documented; " cs " known to the REPL without a help entry:"
    print(_): m
    print(_): list
    set(r): nm
]

# --- main

dg_main(r): args [
    set(r): 0
    len(n): args
    set(cmd): "help"
    if(_): {n > 0} [ at(cmd): args 0 ]
    if(_): {cmd = "builtins" || cmd = "all"} [
        dg_builtins_text(t):
        dg_write(_): "docs/BUILTINS.md" t
    ]
    if(_): {cmd = "libs" || cmd = "all"} [
        dg_libs_text(t):
        dg_write(_): "docs/LIBRARY.md" t
    ]
    if(_): {cmd = "roadmap" || cmd = "all"} [
        dg_roadmap_text(t):
        dg_write(_): "docs/ROADMAP.md" t
    ]
    if(_): {cmd = "map" || cmd = "all"} [
        dg_map_text(t):
        dg_write(_): "docs/REPOSITORY_MAP.md" t
    ]
    if(_): {cmd = "check"} [
        dg_builtins_text(want):
        dg_read(have): "docs/BUILTINS.md"
        if(_): {have = want} [ print(_): "docs/BUILTINS.md is up to date" ]
        else(_): [
            print(_): "docs/BUILTINS.md is stale: ussr docs/tools/docgen.su builtins"
            set(r): 1
        ]
    ]
    if(_): {cmd = "links"} [
        vec(files): ""
        if(_): {n > 1} [
            set(i): 1
            while(_): {i < n} [
                at(f): args i
                push(_): files f
                set(i): {i + 1}
            ]
        ]
        else(_): [ dg_doc_files(files): ]
        dg_check_links(bad): files
        len(nf): files
        str_from_int(fs): nf
        str_from_int(bs): bad
        concat(m): fs " files, " bs " broken link(s)"
        print(_): m
        if(_): {bad > 0} [ set(r): 1 ]
    ]
    if(_): {cmd = "coverage"} [ dg_coverage(_): ]
    if(_): {cmd = "help" || cmd = "--help"} [
        print(_): "docgen: builtins | libs | roadmap | map | all | check | links [FILE...] | coverage"
    ]
]

$ifdef __MAIN__
init(ret): arg_count arg_values [
    vec(args): ""
    set(i): 0
    while(_): {i < arg_count} [
        at(a): arg_values i
        push(_): args a
        set(i): {i + 1}
    ]
    dg_main(ret): args
]
$endif
