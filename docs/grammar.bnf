# USSR Unified Shell Script REPL (USSR) grammar
#
# Matches src/parser.y (conflict-free: bison reports no shift/reduce or
# reduce/reduce conflicts) and src/lexer.l.
#
# Notation:
#   ::=       production
#   |         alternative
#   { ... }   zero or more repetitions
#   [ ... ]   optional syntax (meta-notation, not USSR brackets)
#   terminals in double quotes are literal source characters/tokens
#   REGEX(...) describes a token recognized by the lexer
#
# The lexer discards spaces/tabs/carriage returns and # comments.
# Newline tokens remain significant between command lines.
# Preprocessor directives ($define, $if, ...) are processed before the
# lexer/parser; their syntax is summarised at the end of this file.

# ---------------------------------------------------------------------
# Program structure
# ---------------------------------------------------------------------

<program> ::= <command-lines>

<command-lines> ::= <empty>
                  | <command-lines> <command-line>

<command-line> ::= <newline>
                 | <command>
                 | <advanced-control>
# A newline is an empty command line of its own: the newline that ends a
# command is not part of the command, so blank lines, the line break
# after a command and trailing newlines at the end of the file all parse
# the same way.

<command> ::= <command-head> "(" <identifier> ")" <command-tail>
# The identifier in parentheses names the variable that receives the
# command's result; "_" discards it.

<command-head> ::= REGEX([A-Za-z0-9_./\\:-]+ followed by "(")
# The lexer returns the matched command head without its opening
# parenthesis. A slash or backslash separates an optional path from the
# command name. Whether a command may have trailing [] blocks is checked
# semantically: blocks must come last, and built-ins such as set, print,
# add or return cannot take one. Any other command name with a block is a
# user-defined function declaration.
# Because "-" is a command-head character, "-(" inside {...} lexes as a
# command head; write "- (" for unary minus before a parenthesis.

<command-tail> ::= ":"
                 | ":" <argument-list>

<argument-list> ::= <argument>
                  | <argument-list> <argument>
# Arguments are separated by lexer-discarded whitespace; there are no
# comma separators.

<argument> ::= <argument-base>
             | <identifier> "?"
             | <argument-base> "!"
# Hash-variable sigils (one namespace shared by every process):
# NAME?  reads NAME from the hash variables.
# ARG!   stores the result into the hash variables instead.

<argument-base> ::= <literal>
                  | <identifier>
                  | <expression>
                  | <block-argument>
                  | <uno-literal>

<block-argument> ::= "[" <command-lines> "]"

<advanced-control> ::= "@" "[" <command-lines> "]"
                       <advanced-control-separator>
                       "[" <command-lines> "]"
# Two-block form used for advanced control flow (the "@" command).

<advanced-control-separator> ::= { <newline> }

# ---------------------------------------------------------------------
# Literals
# ---------------------------------------------------------------------

<literal> ::= <unsigned-literal>
            | "-" <integer>
            | "-" <real>
# A negative number is a single literal in argument position
# (add(x): x -1). Inside {...} "-" is an operator, so there the same text
# is parsed as unary minus; the parser folds -<number> back into a
# negative literal, giving the same value.

<unsigned-literal> ::= <string>
                     | <integer>
                     | <real>
                     | <boolean>
                     | <null>

# ---------------------------------------------------------------------
# Expressions (only inside {...})
# ---------------------------------------------------------------------

<expression> ::= "{" <logical-or-expression> "}"

<logical-or-expression> ::= <logical-and-expression>
                          | <logical-or-expression> "||" <logical-and-expression>

<logical-and-expression> ::= <bitwise-or-expression>
                           | <logical-and-expression> "&&" <bitwise-or-expression>

<bitwise-or-expression> ::= <bitwise-xor-expression>
                          | <bitwise-or-expression> "|" <bitwise-xor-expression>

<bitwise-xor-expression> ::= <bitwise-and-expression>
                           | <bitwise-xor-expression> "^" <bitwise-and-expression>

<bitwise-and-expression> ::= <comparison-expression>
                           | <bitwise-and-expression> "&" <comparison-expression>

<comparison-expression> ::= <shift-expression>
                          | <shift-expression> ">" <shift-expression>
                          | <shift-expression> "<" <shift-expression>
                          | <shift-expression> ">=" <shift-expression>
                          | <shift-expression> "<=" <shift-expression>
                          | <shift-expression> "=" <shift-expression>
                          | <shift-expression> "!=" <shift-expression>
# Comparisons do not chain: {a < b < c} is a syntax error.

<shift-expression> ::= <additive-expression>
                     | <shift-expression> "<<" <additive-expression>
                     | <shift-expression> ">>" <additive-expression>

<additive-expression> ::= <multiplicative-expression>
                        | <additive-expression> "+" <multiplicative-expression>
                        | <additive-expression> "-" <multiplicative-expression>

<multiplicative-expression> ::= <unary-expression>
                              | <multiplicative-expression> "*" <unary-expression>
                              | <multiplicative-expression> "/" <unary-expression>
                              | <multiplicative-expression> "%" <unary-expression>

<unary-expression> ::= <primary-expression>
                     | "-" <unary-expression>
# Unary minus is the only unary operator.

<primary-expression> ::= <unsigned-literal>
                       | <identifier>
                       | "(" <logical-or-expression> ")"

# ---------------------------------------------------------------------
# Tokens (src/lexer.l)
# ---------------------------------------------------------------------

<identifier> ::= REGEX([a-zA-Z_][a-zA-Z_0-9]*)

<boolean> ::= "true" | "false"

<null> ::= "null"

<integer> ::= <decimal-integer> | <hex-integer>

<decimal-integer> ::= REGEX([0-9]+)
# Must fit in a signed 64-bit integer; a larger one is a lexer error
# (write it as a real instead).

<hex-integer> ::= REGEX(0[xX][0-9a-fA-F]+)
# 0xCAFEBABE, 0xdeadbeef, 0X1f: at most 16 digits after leading zeros
# (more is a lexer error), read as the 64-bit two's complement pattern,
# so 0x7FFFFFFFFFFFFFFF is the largest integer and 0xFFFFFFFFFFFFFFFF
# is -1. The value is an ordinary integer; "-" <integer> negates it.

<real> ::= REGEX([0-9]+ "." [0-9]+)

<string> ::= "\"" { <string-character> | <escape-sequence> } "\""

<string-character> ::= any character except quote, backslash, or newline

<escape-sequence> ::= "\\" ("n" | "t" | "r" | "\\" | "\"" | any other character)
# The lexer decodes \n, \t, \r, \\ and \"; for other escaped characters
# it keeps the character following the backslash.

<uno-literal> ::= REGEX('([^'\\\n]|\\.)*')
# UNO literals use single quotes and are stored as deferred raw text.

<comment> ::= "#" { any character except carriage return or newline }
# Comments are discarded by the lexer; the newline after a comment is kept.

<newline> ::= "\n"

<whitespace> ::= space | tab | carriage return
# Whitespace is discarded outside string/UNO literals.

<operator> ::= "+" | "-" | "*" | "/" | "%"
             | ">" | "<" | ">=" | "<=" | "=" | "!="
             | "&&" | "||" | "<<" | ">>" | "^" | "&" | "|"

<punctuation> ::= "(" | ")" | "[" | "]" | "{" | "}" | ":" | "@" | "?" | "!"

# Any other character is a lexer error.

<empty> ::= epsilon

# ---------------------------------------------------------------------
# Preprocessor (src/pp.c) - applied line by line before lexing
# ---------------------------------------------------------------------

<directive-line> ::= "$" <directive>

<directive> ::= "define" <name> [ <text> ]
              | "define" <name> "(" [ <name> { "," <name> } ] ")" <text>
              | "include" ( <string> | <path> )
              | "once"
              | "ifdef" <name>
              | "if" <defined-test>
              | "elif" <defined-test>
              | "else"
              | "endif"

<defined-test> ::= "defined" "(" <name> ")"
                 | "defined" <name>

<conditional> ::= ( "$ifdef" <name> | "$if" <defined-test> ) <lines>
                  { "$elif" <defined-test> <lines> }
                  [ "$else" <lines> ]
                  "$endif"
# The first branch whose test holds is kept, the rest are skipped; $else
# is kept only when no earlier branch was. __MAIN__ is defined only in
# the file ussr was started with.
