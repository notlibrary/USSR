# USSR Unified Shell Script (USSR) grammar
#
# Updated from the previous grammar.bnf to match src/parser.y and
# src/lexer.l in the supplied project archive.
#
# Notation:
#   ::=       production
#   |         alternative
#   { ... }   zero or more repetitions
#   [ ... ]   optional syntax (meta-notation, not USSR brackets)
#   terminals in double quotes are literal source characters/tokens
#   REGEX(...) describes a token recognized by the lexer
#
# The lexer discards spaces/tabs/carriage returns and # comments.
# Newline tokens remain significant between command lines.
# Preprocessor directives ($define, $ifdef, etc.) are processed before
# the lexer/parser and are intentionally not part of this grammar.

<program> ::= <command-lines> <trailing-newlines>

<trailing-newlines> ::= { <newline> }

<command-lines> ::= <empty>
                  | <command-lines> <command-line>

<command-line> ::= <newline>
                 | <command> <newline>
                 | <command>
                 | <advanced-control> <newline>
                 | <advanced-control>

<command> ::= <command-head> "(" <identifier> ")" <command-tail>

<command-head> ::= REGEX([A-Za-z0-9_./\\:-]+ followed by "(")
# The lexer returns the matched command head without its opening parenthesis.
# A slash or backslash separates an optional path from the command name.
# Whether a command may have trailing [] blocks is checked semantically.

<command-tail> ::= ":"
                 | ":" <argument-list>

<argument-list> ::= <argument>
                  | <argument-list> <argument>
# Arguments are separated by one or more lexer-discarded whitespace
# characters; there are no comma separators in the current grammar.

<argument> ::= <argument-base>
             | <identifier> "?"
             | <argument-base> "!"

<argument-base> ::= <literal>
                  | <identifier>
                  | <expression>
                  | <block-argument>
                  | <uno-literal>

<block-argument> ::= "[" <command-lines> "]"

<advanced-control> ::= "@" "[" <command-lines> "]"
                       { <newline> }
                       "[" <command-lines> "]"
# This two-block form is used by the parser for advanced control flow.

<literal> ::= <string>
            | <integer>
            | <real>
            | <boolean>
            | <null>

<expression> ::= "{" <logical-or-expression> "}"

<logical-or-expression> ::= <logical-and-expression>
                          | <logical-or-expression> "||" <logical-and-expression>

<logical-and-expression> ::= <bitwise-or-expression>
                            | <logical-and-expression> "&&" <bitwise-or-expression>

<bitwise-or-expression> ::= <bitwise-xor-expression>
                           | <bitwise-or-expression> "|" <bitwise-xor-expression>

<bitwise-xor-expression> ::= <bitwise-and-expression>
                            | <bitwise-xor-expression> "^" <bitwise-and-expression>

<bitwise-and-expression> ::= <comparison-expression>
                            | <bitwise-and-expression> "&" <comparison-expression>

<comparison-expression> ::= <shift-expression>
                           | <shift-expression> ">" <shift-expression>
                           | <shift-expression> "<" <shift-expression>
                           | <shift-expression> ">=" <shift-expression>
                           | <shift-expression> "<=" <shift-expression>
                           | <shift-expression> "=" <shift-expression>
                           | <shift-expression> "!=" <shift-expression>

<shift-expression> ::= <additive-expression>
                      | <shift-expression> "<<" <additive-expression>
                      | <shift-expression> ">>" <additive-expression>

<additive-expression> ::= <multiplicative-expression>
                         | <additive-expression> "+" <multiplicative-expression>
                         | <additive-expression> "-" <multiplicative-expression>

<multiplicative-expression> ::= <unary-expression>
                               | <multiplicative-expression> "*" <unary-expression>
                               | <multiplicative-expression> "/" <unary-expression>
                               | <multiplicative-expression> "%" <unary-expression>

<unary-expression> ::= <primary-expression>
                      | "-" <unary-expression>
# Unary minus is currently the only unary operator in parser.y.

<primary-expression> ::= <literal>
                        | <identifier>
                        | "(" <logical-or-expression> ")"

<uno-literal> ::= REGEX('([^'\\\n]|\\.)*')
# UNO literals use single quotes and are stored as deferred raw text.

<identifier> ::= REGEX([a-zA-Z_] [a-zA-Z_0-9]*)

<command-name> ::= <identifier>
# Actual command heads are broader than identifiers: see <command-head>.

<return-variable> ::= <identifier>

<variable-reference> ::= <identifier>

<boolean> ::= "true" | "false"

<null> ::= "null"

<integer> ::= REGEX([0-9]+)

<real> ::= REGEX([0-9]+ "." [0-9]+)
# Numeric tokens are unsigned. Negative values are expressed using unary
# minus inside {...}, for example {0 - 5} or {-5}.

<string> ::= "\"" { <string-character> | <escape-sequence> } "\""

<string-character> ::= any character except quote, backslash, or newline

<escape-sequence> ::= "\\" ("n" | "t" | "r" | "\\" | "\"" | any other character)
# The lexer decodes \n, \t, \r, \\, and \"; for other escaped
# characters it keeps the character following the backslash.

<comment> ::= "#" { any character except carriage return or newline }
# Comments are discarded by the lexer; the newline after a comment is kept.

<newline> ::= "\n"

<whitespace> ::= space | tab | carriage return
# Whitespace is discarded outside string/UNO literals.

<operator> ::= "+" | "-" | "*" | "/" | "%"
             | ">" | "<" | ">=" | "<=" | "=" | "!="
             | "&&" | "||" | "<<" | ">>" | "^" | "&" | "|"

<empty> ::= epsilon
