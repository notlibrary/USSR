        if(_): {cv_ff = 0} [
            byte(cv_fb): s cv_fp
            if(_): {cv_fb = 58} [
                set(cv_ff): 1
            ]
            if(_): {cv_ff = 0} [
                add(cv_fp): cv_fp 1
            ]
        ]
        if(_): {cv_ff = 1} [
            set(cv_fp): cv_fl3
        ]
    ]
    slice(r): s 0 cv_fp
]
cv_struct2(r): nd [
