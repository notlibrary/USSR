            getf(rt_p0n): rt_p0 "s1"
            at(rt_p1): rt_cp3 1
            getf(rt_p1n): rt_p1 "s1"
            rt_write(_): rt_p0n acnt
            rt_write(_): rt_p1n avec
        ]
        ex_alias(_): rt_fd3 "rt_initret" rt_sv2
        getf(rt_cb3): rt_fd3 "body"
        ex_block(_): rt_cb3
