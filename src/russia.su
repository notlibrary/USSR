ex_concat_i(r): kids idx acc [
    len(rt_cl): kids
    set(r): acc
    if(_): {idx < rt_cl} [
        at(rt_cn3): kids idx
        ex_val(rt_cv): rt_cn3
        concat(rt_c2): acc rt_cv
