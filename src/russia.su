# ---------- cooperative scheduler (bootstrap port of the C scheduler) ----------
# A process is a saved slice of the fully-global VM state: instruction
# pointer, stack pointer, register vector, frame vector and variable
# store. cv_code/cv_consts/cv_names/cv_funcs stay shared — processes
# share compiled code, like threads share text in the C version.
# Scheduling is cooperative with a quantum: vm_loop counts down
# vm_qleft instructions per slice and suspends the process at an
# instruction boundary when the slice is spent; sleep/await suspend
# voluntarily. The event queue is the run queue plus the timer edges
# (wake_at) and await edges (wait_pid) stored on each process; sc_idle
# fires expired timers when nothing is runnable. Time is a logical
# tick — one slice is one tick, idle time jumps straight to the next
# timer, so no host sleeping is needed.
# Process states: 0 runnable 1 sleeping 2 waiting(await) 3 zombie.

sc_regs_i(r): regs i [
    if(_): {i < 32} [
        new(sc_rvx): "vm_rv" 0
        push(_): regs sc_rvx
        add(sc_ri2): i 1
        sc_regs_i(r): regs sc_ri2
    ]
    if(_): {i = 32} [
        set(r): 0
    ]
]
sc_args_i(r): regs args i n [
    set(r): 0
    if(_): {i < n} [
        if(_): {i < 16} [
            at(sc_av2): args i
            add(sc_rk2): 16 i
            at(sc_rv3): regs sc_rk2
            setf(_): sc_rv3 "v" sc_av2
        ]
        add(sc_ai3): i 1
        sc_args_i(r): regs args sc_ai3 n
    ]
]
sc_store_ci(r): src dst i n [
    set(r): 0
    if(_): {i < n} [
        at(sc_ss): src i
        getf(sc_sn): sc_ss "n"
        getf(sc_sv2): sc_ss "v"
        getf(sc_st3): sc_ss "t"
        new(sc_ns): "rt_sp" sc_sn sc_sv2 sc_st3
        push(_): dst sc_ns
        add(sc_si2): i 1
        sc_store_ci(r): src dst sc_si2 n
    ]
]
sc_store_clone(r): src [
    vec(r): "rt_sp"
    len(sc_sl): src
    sc_store_ci(_): src r 0 sc_sl
]
sc_store_gi(r): store nm i n [
    set(r): 0
    if(_): {i < n} [
        at(sc_gs): store i
        getf(sc_gn): sc_gs "n"
        set(sc_gf): 0
        if(_): {sc_gn = nm} [ set(sc_gf): 1 ]
        if(_): {sc_gf = 1} [
            getf(sc_gt): sc_gs "t"
            if(_): {sc_gt = ""} [
                getf(r): sc_gs "v"
            ]
        ]
        if(_): {sc_gf = 0} [
            add(sc_gi2): i 1
            sc_store_gi(r): store nm sc_gi2 n
        ]
    ]
]
sc_store_get(r): store nm [
    len(sc_gl): store
    sc_store_gi(r): store nm 0 sc_gl
]
# Wrap the currently loaded VM state as the main process (pid 1).
sc_boot(r): [
    new(sc_bp): "sc_pr" 1 "init" 0 vm_ip vm_sp vm_regs vm_frames rt_store 0 0 0 0
    push(_): sc_procs sc_bp
    push(_): sc_runq 1
    set(r): 0
]
# Spawn function fi(args...) as a new process: append a private
# trampoline (CALL fi + HALT) to the shared code and point the new
# process at it. fork=1 clones the caller's variable store (async
# semantics), fork=0 starts an empty one (load/exec semantics).
# Spawning by table index (not name) is what lets load() spawn the
# loaded file's own entry even when its name collides with a main
# file definition — the C version gives each loaded file a separate
# program, the bootstrap shares one function table instead. r = pid.
sc_spawn_i(r): fi fname args fork [
    set(r): {0 - 1}
    if(_): {fi + 1 > 0} [
        len(sc_al): args
        cv_name(sc_rni): "__sc_result"
        cv_emit(_): 5 16 sc_al sc_rni fi
        cv_emit(_): 15 0 0 0 0
        len(sc_tl): cv_code
        sub(sc_ti): sc_tl 2
        vec(sc_newregs): "vm_rv"
        sc_regs_i(_): sc_newregs 0
        sc_args_i(_): sc_newregs args 0 sc_al
        vec(sc_newframes): "vm_fr"
        vec(sc_newstore): "rt_sp"
        if(_): {fork = 1} [
            sc_store_clone(sc_cl): rt_store
            set(sc_newstore): sc_cl
