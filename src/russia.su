vm_newobj(r): nb [
    vec(vm_av): ""
    if(_): {nb > 1} [ push(_): vm_av rt_na1 ]
    if(_): {nb > 2} [ push(_): vm_av rt_na2 ]
    if(_): {nb > 3} [ push(_): vm_av rt_na3 ]
    if(_): {nb > 4} [ push(_): vm_av rt_na4 ]
