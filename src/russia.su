        if(_): {cv_op = "-"} [ set(cv_opc): 11 ]
        if(_): {cv_op = "*"} [ set(cv_opc): 12 ]
        if(_): {cv_op = "/"} [ set(cv_opc): 13 ]
        if(_): {cv_op = "%"} [ set(cv_opc): 14 ]
        if(_): {cv_op = "="} [ set(cv_opc): 16 ]
        if(_): {cv_op = "!="} [ set(cv_opc): 17 ]
        if(_): {cv_op = "<"} [ set(cv_opc): 18 ]
        if(_): {cv_op = "<="} [ set(cv_opc): 19 ]
        if(_): {cv_op = ">"} [ set(cv_opc): 20 ]
        if(_): {cv_op = ">="} [ set(cv_opc): 21 ]
        if(_): {cv_op = "&&"} [ set(cv_opc): 22 ]
        if(_): {cv_op = "||"} [ set(cv_opc): 23 ]
        if(_): {cv_op = "<<"} [ set(cv_opc): 24 ]
