# ---------- parser: AST dump (preorder, depth field) ----------
ps_dump(r): nd depth [
    getf(ps_d_tag): nd "tag"
    getf(ps_d_s1): nd "s1"
    getf(ps_d_s2): nd "s2"
    getf(ps_d_n1): nd "n1"
    getf(ps_d_kids): nd "kids"
    len(ps_d_nk): ps_d_kids
    template(_): "INT;INT;INT;STR;STR;INT;INT;STR" depth ps_d_tag ps_d_tag ps_d_s1 ps_d_s2 ps_d_n1 ps_d_nk "\n"
    ps_dump_kids(r): ps_d_kids 0 depth
]
ps_dump_kids(r): kids idx depth [
    len(ps_kn): kids
    set(r): 0
    if(_): {idx < ps_kn} [
        at(ps_kd): kids idx
        add(ps_d2): depth 1
        ps_dump(_): ps_kd ps_d2
        add(ps_i2): idx 1
        ps_dump_kids(r): kids ps_i2 depth
    ]
]

# ---------- parser stage entry ----------
ps_parse(r): src [
    set(ps_i): 0
    set(ps_stop): 0
    vec(ps_opstack): ""
    set(ps_err): ""
    if(_): {ps_nddef = 0} [
        struct(nd): "tag:number" "s1:string" "s2:string" "n1:number" "kids:any"
        set(ps_nddef): 1
    ]
    ps_prog(ps_root): 
    set(r): 0
    if(_): {ps_stop = 1} [
        set(r): 1
    ]
]
# store pair: n=name v=value t=alias-target
rt_find_i(r): nm i [
    len(rt_fl): rt_store
    set(r): {0 - 1}
    if(_): {i < rt_fl} [
        at(rt_fp): rt_store i
        getf(rt_fn): rt_fp "n"
        set(rt_fok): 0
        if(_): {rt_fn = nm} [
            set(rt_fok): 1
        ]
        if(_): {rt_fok = 1} [
            set(r): i
        ]
        if(_): {rt_fok = 0} [
            add(rt_fi2): i 1
            rt_find_i(r): nm rt_fi2
        ]
    ]
]
rt_find(r): nm [
    rt_find_i(r): nm 0
]
rt_write(r): nm val [
    rt_find(rt_wi): nm
    if(_): {rt_wi < 0} [
        new(rt_wp): "rt_sp" nm val ""
        setf(_): rt_wp "n" nm
        setf(_): rt_wp "v" val
        setf(_): rt_wp "t" ""
        push(_): rt_store rt_wp
    ]
    if(_): {rt_wi + 1 > 0} [
        at(rt_wp2): rt_store rt_wi
        getf(rt_wt): rt_wp2 "t"
        if(_): {rt_wt = ""} [
            setf(_): rt_wp2 "v" val
        ]
        set(rt_we): 0
        if(_): {rt_wt = ""} [
            set(rt_we): 1
        ]
        if(_): {rt_we = 0} [
            rt_write(r): rt_wt val
        ]
    ]
    set(r): 0
]
rt_read(r): nm [
    rt_find(rt_ri): nm
    set(r): 0
    if(_): {rt_ri < 0} [
        print(_): "undefined variable"
    ]
    if(_): {rt_ri + 1 > 0} [
        at(rt_rp): rt_store rt_ri
        getf(rt_rt): rt_rp "t"
        if(_): {rt_rt = ""} [
            getf(r): rt_rp "v"
        ]
        set(rt_re): 0
        if(_): {rt_rt = ""} [
            set(rt_re): 1
        ]
        if(_): {rt_re = 0} [
            rt_read(r): rt_rt
        ]
    ]
]

# expression evaluation: node -> value in r
ex_val(r): nd [
    if(_): {ps_stop = 0} [
        getf(rt_ev_t): nd "tag"
        ex_val_t(r): nd rt_ev_t
    ]
]
ex_val_t(r): nd t [
    set(r): 0
    if(_): {ps_stop = 0} [
        if(_): {t = 4} [
            getf(rt_s1): nd "s1"
            rt_read(r): rt_s1
        ]
        if(_): {t = 5} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 6} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 7} [
            getf(r): nd "s1"
        ]
        if(_): {t = 8} [
            getf(rt_b1): nd "s1"
            set(r): {1 = 2}
            if(_): {rt_b1 = "true"} [
                set(r): {1 = 1}
            ]
        ]
        if(_): {t = 9} [
            set(r): null
        ]
        if(_): {t = 10} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 12} [
            ex_bin(r): nd
        ]
        if(_): {t = 13} [
            ex_un(r): nd
        ]
    ]
]
ex_bin(r): nd [
    getf(rt_bo): nd "s1"
    getf(rt_bk): nd "kids"
    at(rt_bl): rt_bk 0
    at(rt_br): rt_bk 1
    ex_bin_a(r): rt_bo rt_bl rt_br
]
ex_bin_a(r): op ln rn [
    ex_val(rt_lx): ln
    ex_bin_b(r): op rt_lx rn
]
ex_bin_b(r): op lv rn [
    ex_val(rt_rx): rn
    ex_bin_do(r): op lv rt_rx
]
ex_bin_do(r): op lv rv [
    set(r): 0
    if(_): {op = "+"} [
        add(r): lv rv
    ]
    if(_): {op = "-"} [
        sub(r): lv rv
    ]
    if(_): {op = "*"} [
        mul(r): lv rv
    ]
    if(_): {op = "/"} [
        div(r): lv rv
    ]
    if(_): {op = "%"} [
        mod(r): lv rv
    ]
    if(_): {op = "="} [
        set(r): {lv = rv}
    ]
    if(_): {op = "!="} [
        set(r): {lv != rv}
    ]
    if(_): {op = "<"} [
        set(r): {lv < rv}
    ]
    if(_): {op = "<="} [
        set(r): {lv <= rv}
    ]
    if(_): {op = ">"} [
        set(r): {lv > rv}
    ]
    if(_): {op = ">="} [
        set(r): {lv >= rv}
    ]
    if(_): {op = "&&"} [
        set(r): {lv && rv}
    ]
    if(_): {op = "||"} [
        set(r): {lv || rv}
    ]
    if(_): {op = "<<"} [
        set(r): {lv << rv}
    ]
    if(_): {op = ">>"} [
        set(r): {lv >> rv}
    ]
    if(_): {op = "^"} [
        set(r): {lv ^ rv}
    ]
    if(_): {op = "&"} [
        set(r): {lv & rv}
    ]
    if(_): {op = "|"} [
        set(r): {lv | rv}
    ]
]
ex_un(r): nd [
    getf(rt_uo): nd "s1"
    getf(rt_uk): nd "kids"
    at(rt_uc): rt_uk 0
    ex_val(rt_uv): rt_uc
    if(_): {rt_uo = "-"} [
        sub(r): 0 rt_uv
    ]
    if(_): {rt_uo = "!"} [
        set(r): {rt_uv = false}
    ]
]
# ---- flow state: 0 normal 1 break 2 continue 3 return (deepest-writer discipline) ----

# ---- function definitions table ----
rt_reg(r): cmd [
    getf(rt_rn): cmd "s1"
    getf(rt_rr): cmd "s2"
    getf(rt_rk): cmd "kids"
    len(rt_rkl): rt_rk
    set(rt_rb): {0 - 1}
    if(_): {rt_rkl > 0} [
        sub(rt_rl1): rt_rkl 1
        at(rt_rlast): rt_rk rt_rl1
        getf(rt_rlt): rt_rlast "tag"
        if(_): {rt_rlt = 3} [
            set(rt_rb): rt_rl1
        ]
    ]
    vec(rt_prm): ""
    set(rt_ri): 0
    ex_reg_i(r): cmd rt_prm rt_ri rt_rb
]
ex_reg_i(r): cmd prm i blim [
    if(_): {i < blim} [
        getf(rt_rk2): cmd "kids"
        at(rt_pk): rt_rk2 i
        push(_): prm rt_pk
        add(rt_ri2): i 1
        ex_reg_i(r): cmd prm rt_ri2 blim
    ]
    if(_): {i = blim} [
        getf(rt_rk3): cmd "kids"
        set(rt_body): {0 - 1}
        if(_): {blim + 1 > 0} [
            at(rt_body): rt_rk3 blim
        ]
        getf(rt_nm2): cmd "s1"
        getf(rt_rt2): cmd "s2"
        new(rt_fd): "rt_fd" rt_nm2 prm rt_rt2 rt_body
        setf(_): rt_fd "n" rt_nm2
        setf(_): rt_fd "prm" prm
        setf(_): rt_fd "ret" rt_rt2
        setf(_): rt_fd "body" rt_body
        push(_): rt_fdefs rt_fd
        set(r): 0
    ]
]
rt_findf_i(r): nm i [
    len(rt_fl): rt_fdefs
    set(r): {0 - 1}
    if(_): {i + 1 > 0} [
        at(rt_fp): rt_fdefs i
        getf(rt_fn): rt_fp "n"
        if(_): {rt_fn = nm} [
            set(r): i
        ]
        if(_): {rt_fn != nm} [
            sub(rt_fi2): i 1
            rt_findf_i(r): nm rt_fi2
        ]
    ]
]
rt_findf(r): nm [
    len(rt_fl2): rt_fdefs
    set(r): {0 - 1}
    if(_): {rt_fl2 > 0} [
        sub(rt_fstart): rt_fl2 1
        rt_findf_i(r): nm rt_fstart
    ]
]

# ---- function call (save-vec as param: recursion-safe) ----
rt_call(r): fd args cret [
    vec(rt_sv): ""
    getf(rt_cp): fd "prm"
    len(rt_cn): rt_cp
    ex_bind(r): fd args rt_cp rt_sv 0 rt_cn
    ex_alias(r): fd cret rt_sv
    getf(rt_cb): fd "body"
    ex_block(_): rt_cb
    if(_): {rt_flow = 3} [
        set(rt_flow): 0
        rt_write(_): cret rt_rv
    ]
    add(rt_cn1): rt_cn 1
    ex_rest(r): rt_sv 0 rt_cn1
    set(r): 0
]
ex_bind(r): fd args prm sv i n [
    if(_): {i < n} [
        at(rt_bn): prm i
        getf(rt_bnm): rt_bn "s1"
        getf(rt_ak): args "kids"
        at(rt_an): rt_ak i
        ex_val(rt_av): rt_an
        rt_find(rt_bi): rt_bnm
        new(rt_sp2): "rt_sv" rt_bnm 0 0 ""
        setf(_): rt_sp2 "n" rt_bnm
        if(_): {rt_bi < 0} [
            setf(_): rt_sp2 "had" 0
            setf(_): rt_sp2 "v" 0
            setf(_): rt_sp2 "t" ""
        ]
        if(_): {rt_bi + 1 > 0} [
            setf(_): rt_sp2 "had" 1
            at(rt_bp): rt_store rt_bi
            getf(rt_bv): rt_bp "v"
            getf(rt_bt): rt_bp "t"
            setf(_): rt_sp2 "v" rt_bv
            setf(_): rt_sp2 "t" rt_bt
        ]
        push(_): sv rt_sp2
        rt_write(_): rt_bnm rt_av
        add(rt_bi2): i 1
        ex_bind(r): fd args prm sv rt_bi2 n
    ]
    if(_): {i = n} [
        set(r): 0
    ]
]
ex_alias(r): fd cret sv [
    getf(rt_anm): fd "ret"
    rt_find(rt_ai): rt_anm
    new(rt_ap): "rt_sv" rt_anm 0 0 ""
    setf(_): rt_ap "n" rt_anm
    set(rt_asame): 0
    if(_): {rt_anm = cret} [ set(rt_asame): 1 ]
    if(_): {rt_ai < 0} [
        setf(_): rt_ap "had" 0
        setf(_): rt_ap "v" 0
        setf(_): rt_ap "t" ""
        new(rt_np): "rt_sp" rt_anm 0 ""
        setf(_): rt_np "n" rt_anm
        setf(_): rt_np "v" 0
        if(_): {rt_asame = 0} [
            setf(_): rt_np "t" cret
        ]
        push(_): rt_store rt_np
    ]
    if(_): {rt_ai + 1 > 0} [
        setf(_): rt_ap "had" 1
        at(rt_op): rt_store rt_ai
        getf(rt_ov): rt_op "v"
        getf(rt_ot): rt_op "t"
        setf(_): rt_ap "v" rt_ov
        setf(_): rt_ap "t" rt_ot
        if(_): {rt_asame = 0} [
            setf(_): rt_op "t" cret
        ]
        if(_): {rt_asame = 1} [
            setf(_): rt_ap "had" 2
        ]
    ]
    push(_): sv rt_ap
    set(r): 0
]
ex_rest(r): sv i n [
    if(_): {i < n} [
        at(rt_rp2): sv i
        getf(rt_rsn): rt_rp2 "n"
        getf(rt_rsh): rt_rp2 "had"
        if(_): {rt_rsh = 1} [
            rt_find(rt_ri3): rt_rsn
            if(_): {rt_ri3 + 1 > 0} [
                at(rt_rpp): rt_store rt_ri3
                getf(rt_rvv): rt_rp2 "v"
                getf(rt_rtt): rt_rp2 "t"
                setf(_): rt_rpp "v" rt_rvv
                setf(_): rt_rpp "t" rt_rtt
            ]
        ]
        add(rt_ri4): i 1
        ex_rest(r): sv rt_ri4 n
    ]
    if(_): {i = n} [
        set(r): 0
    ]
]
