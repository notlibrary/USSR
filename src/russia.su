    ]
]
ex_arith(r): nd nm [
    getf(rt_ak2): nd "kids"
    at(rt_a0): rt_ak2 0
    at(rt_a1): rt_ak2 1
    ex_val(rt_v0): rt_a0
    ex_arith2(r): nd nm rt_v0
]
ex_arith2(r): nd nm v0 [
    getf(rt_ak3): nd "kids"
    at(rt_a1b): rt_ak3 1
    ex_val(rt_v1): rt_a1b
    if(_): {nm = "add"} [
        add(rt_t): v0 rt_v1
    ]
    if(_): {nm = "sub"} [
        sub(rt_t): v0 rt_v1
    ]
    if(_): {nm = "mul"} [
        mul(rt_t): v0 rt_v1
    ]
    if(_): {nm = "div"} [
        div(rt_t): v0 rt_v1
    ]
    if(_): {nm = "mod"} [
