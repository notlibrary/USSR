                if(_): {rt_spn < rt_sfl} [
                    byte(rt_sab): fmt rt_spn
                    if(_): {rt_sab = 59} [ set(rt_saft): 1 ]
                    if(_): {rt_sab = 32} [ set(rt_saft): 1 ]
                    if(_): {rt_sab = 9} [ set(rt_saft): 1 ]
                ]
            ]
            if(_): {rt_stok = 1} [
                if(_): {rt_sbd = 1} [
                    if(_): {rt_saft = 1} [ set(rt_sdone): 2 ]
                ]
            ]
            if(_): {rt_sdone = 0} [
                byte(rt_spch): fmt rt_sp
                putch(_): rt_spch
                add(rt_sp): rt_sp 1
            ]
        ]
    ]
    set(r): 0
]

