]
ex_tout(r): s [
    # Emit the whole string with one host template call so every byte
    # (ESC, CR, high bytes) survives exactly; the old per-byte putch
    # loop silently dropped anything outside 9/10/13/32..126.
    template(_): "STR" s
    set(r): 0
]

ex_tval(r): v [
    encode(rt_tve): v
    ex_tout(r): rt_tve
]

ex_template(r): nd [
    getf(rt_tk): nd "kids"
    at(rt_tf0): rt_tk 0
    ex_val(rt_fmt): rt_tf0
    set(rt_tslot): ""
    set(rt_targ): 0
    set(rt_tp): 0
    len(rt_tfl): rt_fmt
    while(_): {rt_tp < rt_tfl} [
        byte(rt_tb): rt_fmt rt_tp
        set(rt_tnom): 1
        if(_): {rt_tb = 59} [
            ex_tflush(_): rt_tslot rt_targ nd
            set(rt_tslot): ""
            add(rt_targ): rt_targ 1
            add(rt_tp): rt_tp 1
            set(rt_tnom): 0
        ]
        if(_): {rt_tb = 92} [
            add(rt_tp): rt_tp 1
            byte(rt_tb2): rt_fmt rt_tp
