]

ex_targ(r): nd k [
    getf(rt_tk2): nd "kids"
    add(rt_tkk): k 1
    at(rt_tn): rt_tk2 rt_tkk
    ex_val(r): rt_tn
]

ex_tflush(r): slot aidx nd [
    if(_): {slot = "STR"} [
        ex_targ(rt_tsv): nd aidx
        ex_tout(_): rt_tsv
    ]
    if(_): {slot != "STR"} [
        if(_): {slot != ""} [
            ex_targ(rt_tiv): nd aidx
            ex_tval(_): rt_tiv
        ]
    ]
    set(r): 0
]

ex_oop(r): nd nm [
    set(r): 0
