            if(_): {rt_sw3 = "INT"} [ set(rt_stok): 1 ]
            if(_): {rt_sw3 = "STR"} [ set(rt_stok): 1 ]
            slice(rt_sw4): fmt rt_sp 4
            if(_): {rt_sw4 = "REAL"} [
                set(rt_stok): 1
                set(rt_stl2): 4
            ]
            if(_): {rt_sw4 = "BOOL"} [
                set(rt_stok): 1
                set(rt_stl2): 4
            ]
            set(rt_sbd): 0
            if(_): {rt_sp = 0} [ set(rt_sbd): 1 ]
            if(_): {rt_sp > 0} [
                byte(rt_spb): fmt {rt_sp - 1}
                if(_): {rt_spb = 32} [ set(rt_sbd): 1 ]
                if(_): {rt_spb = 9} [ set(rt_sbd): 1 ]
