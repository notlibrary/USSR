            cv_name_i(r): s cv_ni2
        ]
    ]
]
cv_name(r): s [
    cv_name_i(r): s 0
    if(_): {r < 0} [
        push(_): cv_names s
        len(cv_nj): cv_names
        sub(r): cv_nj 1
    ]
]
cv_const(r): v [
    push(_): cv_consts v
    len(cv_cl): cv_consts
    sub(r): cv_cl 1
]

