            add(rt_inx2): idx 1
            ex_block_h(r): items rt_inx2
        ]
        if(_): {hasblk = 0} [
            add(rt_inx3): idx 2
            ex_block_h(r): items rt_inx3
        ]
    ]
]
skip_chain(r): items i [
    len(rt_scl): items
    set(r): i
    if(_): {i < rt_scl} [
        at(rt_sci): items i
        getf(rt_sct): rt_sci "tag"
        set(rt_scm): 0
