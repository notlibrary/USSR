    ]
    if(_): {nm = "decode"} [
        at(rt_o1): rt_ok2 0
        ex_val(rt_ov1): rt_o1
        decode(rt_rv7): rt_ov1
        rt_write(_): rt_or rt_rv7
    ]
    if(_): {nm = "byte"} [
