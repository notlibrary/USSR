        if(_): {hasblk = 0} [
            add(rt_ip): idx 1
            at(rt_ipl): items rt_ip
            ex_single(rt_ipl): rt_ipl
            add(rt_isc): idx 2
            skip_chain(rt_sc): items rt_isc
            ex_block_h(r): items rt_sc
        ]
    ]
    if(_): {c = false} [
