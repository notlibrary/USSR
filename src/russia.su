            if(_): {rt_scn = "else"} [ set(rt_scm): 1 ]
        ]
        if(_): {rt_scm = 1} [
            add(rt_sci2): i 2
            skip_chain(r): items rt_sci2
        ]
    ]
]
# skip a block-style elif/else chain: each label carries its body
