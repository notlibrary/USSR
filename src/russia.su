cv_do(r): nd [
    set(r): 0
]

# ---- VM runtime ----
# register = vm_rv{v}; frame = vm_fr{rip, sv, crt}
vm_reg(r): k [
    at(r): vm_regs k
    getf(r): r "v"
]
vm_setreg(r): k val [
    at(r): vm_regs k
    setf(_): r "v" val
]
vm_loop(r): [
    set(r): 0
    set(vm_lgo): 1
    while(_): {vm_lgo = 1} [
        set(vm_lgo): 0
        if(_): {vm_flow = 0} [
            if(_): {vm_suspend = 0} [
                len(vm_codelen): cv_code
                if(_): {vm_ip < vm_codelen} [
                    set(vm_lgo): 1
                ]
            ]
        ]
        if(_): {vm_lgo = 1} [
            at(vm_cur): cv_code vm_ip
            getf(vm_op): vm_cur "op"
            vm_step(r): vm_cur vm_op
            add(vm_ip): vm_ip 1
            # Quantum countdown: sc_run charges vm_qleft before each
            # slice; when it runs out the process suspends at the next
            # instruction boundary and the scheduler picks another one.
            if(_): {vm_qleft > 0} [
                sub(vm_qleft): vm_qleft 1
                if(_): {vm_qleft = 0} [
                    set(vm_suspend): 1
                ]
            ]
        ]
    ]
]
vm_bind_i(r): prm sv ab i n [
    if(_): {i < n} [
        at(vm_bn): prm i
        getf(vm_bnm): vm_bn "s1"
        add(vm_bk): ab i
        vm_reg(vm_bv): vm_bk
        rt_find(vm_bi): vm_bnm
        new(vm_bs): "rt_sv" vm_bnm 0 0 ""
        setf(_): vm_bs "n" vm_bnm
        if(_): {vm_bi < 0} [
            setf(_): vm_bs "had" 0
            setf(_): vm_bs "v" 0
            setf(_): vm_bs "t" ""
        ]
        if(_): {vm_bi + 1 > 0} [
            setf(_): vm_bs "had" 1
            at(vm_bp): rt_store vm_bi
            getf(vm_bv2): vm_bp "v"
            getf(vm_bt2): vm_bp "t"
            setf(_): vm_bs "v" vm_bv2
            setf(_): vm_bs "t" vm_bt2
        ]
        push(_): sv vm_bs
        rt_write(_): vm_bnm vm_bv
        rt_read(vm_ck): vm_bnm
        add(vm_bi2): i 1
        vm_bind_i(r): prm sv ab vm_bi2 n
    ]
    if(_): {i = n} [
        set(r): 0
    ]
]
vm_alias2(r): rnm crt sv [
    rt_find(vm_ai): rnm
    new(vm_as): "rt_sv" vm_rnm 0 0 ""
    setf(_): vm_as "n" rnm
    set(vm_asame): 0
    if(_): {rnm = crt} [ set(vm_asame): 1 ]
    if(_): {vm_ai < 0} [
        setf(_): vm_as "had" 0
        setf(_): vm_as "v" 0
        setf(_): vm_as "t" ""
        new(vm_an): "rt_sp" vm_rnm 0 ""
        setf(_): vm_an "n" rnm
        setf(_): vm_an "v" 0
        if(_): {vm_asame = 0} [
            setf(_): vm_an "t" crt
        ]
        push(_): rt_store vm_an
    ]
    if(_): {vm_ai + 1 > 0} [
        setf(_): vm_as "had" 1
        at(vm_ap): rt_store vm_ai
        getf(vm_av): vm_ap "v"
        getf(vm_at): vm_ap "t"
        setf(_): vm_as "v" vm_av
        setf(_): vm_as "t" vm_at
        if(_): {vm_asame = 0} [
            setf(_): vm_ap "t" crt
        ]
    ]
    if(_): {vm_asame = 0} [
        push(_): sv vm_as
    ]
    set(r): 0
]
vm_step(r): cur op [
    set(r): 0
    if(_): {op = 1} [
        getf(vm_ci): cur "imm"
        getf(vm_d): cur "a"
        at(vm_cv): cv_consts vm_ci
        vm_setreg(_): vm_d vm_cv
    ]
    if(_): {op = 2} [
        getf(vm_nx): cur "imm"
        getf(vm_d2): cur "a"
        at(vm_nm3): cv_names vm_nx
        rt_read(vm_rv2): vm_nm3
        vm_setreg(_): vm_d2 vm_rv2
    ]
    if(_): {op = 3} [
        getf(vm_nx2): cur "imm"
        getf(vm_s): cur "a"
        at(vm_nm4): cv_names vm_nx2
        vm_reg(vm_rv3): vm_s
        rt_write(_): vm_nm4 vm_rv3
    ]
    if(_): {op = 4} [
        getf(vm_na): cur "a"
        getf(vm_nb): cur "b"
        getf(vm_nc): cur "c"
        getf(vm_ni): cur "imm"
        at(vm_nm5): cv_names vm_ni
        if(_): {vm_nb > 0} [ add(vm_i0): vm_na 0
            vm_reg(rt_na0): vm_i0 ]
        if(_): {vm_nb > 1} [ add(vm_i1): vm_na 1
            vm_reg(rt_na1): vm_i1 ]
        if(_): {vm_nb > 2} [ add(vm_i2): vm_na 2
            vm_reg(rt_na2): vm_i2 ]
        if(_): {vm_nb > 3} [ add(vm_i3): vm_na 3
            vm_reg(rt_na3): vm_i3 ]
        if(_): {vm_nb > 4} [ add(vm_i4): vm_na 4
            vm_reg(rt_na4): vm_i4 ]
        if(_): {vm_nb > 5} [ add(vm_i5): vm_na 5
            vm_reg(rt_na5): vm_i5 ]
        vm_native(r): vm_nm5 vm_nc vm_nb
    ]
    if(_): {op = 5} [
        getf(vm_fi): cur "imm"
        getf(vm_ab): cur "a"
        getf(vm_bc): cur "b"
        getf(vm_cc2): cur "c"
        at(vm_fd): cv_funcs vm_fi
        vec(vm_sv): ""
        add(vm_rp): vm_ip 1
        at(vm_crt): cv_names vm_cc2
        new(vm_fr): "vm_fr" vm_rp vm_sv vm_crt
        push(_): vm_frames vm_fr
        add(vm_sp): vm_sp 1
        getf(vm_prm): vm_fd "prm"
        getf(vm_npp): vm_fd "nparams"
        vm_bind_i(_): vm_prm vm_sv vm_ab 0 vm_npp
        getf(vm_rnn): vm_fd "retname"
        vm_alias2(_): vm_rnn vm_crt vm_sv
        getf(vm_ent): vm_fd "entry"
        # Flat dispatch: ip = entry - 1 so the caller's vm_loop
        # advances to entry. No recursive vm_loop here — machine
        # state is fully global, and a flat loop is what lets the
        # scheduler suspend a process at any instruction boundary.
        set(vm_ip): {vm_ent - 1}
    ]
    if(_): {op = 6} [
        getf(vm_ra): cur "a"
        vm_reg(rt_rv): vm_ra
        sub(vm_lx): vm_sp 1
        at(vm_fr2): vm_frames vm_lx
        getf(vm_sv3): vm_fr2 "sv"
        len(vm_sv3l): vm_sv3
        ex_rest(_): vm_sv3 0 vm_sv3l
        getf(vm_crt2): vm_fr2 "crt"
        getf(vm_rvb): cur "b"
        if(_): {vm_rvb = 1} [
            rt_write(_): vm_crt2 rt_rv
        ]
        getf(vm_rp2): vm_fr2 "rip"
        sub(vm_ip2): vm_rp2 1
        set(vm_ip): vm_ip2
        sub(vm_sp): vm_sp 1
        if(_): {vm_sp = 0} [
            set(vm_flow): 1
        ]
    ]
    if(_): {op = 7} [
        getf(vm_jt): cur "imm"
        sub(vm_jt2): vm_jt 1
        set(vm_ip): vm_jt2
    ]
    if(_): {op = 8} [
        getf(vm_ta): cur "a"
        getf(vm_tt): cur "imm"
        vm_reg(vm_tv): vm_ta
        if(_): {vm_tv = true} [
            sub(vm_tt2): vm_tt 1
            set(vm_ip): vm_tt2
        ]
    ]
    if(_): {op = 9} [
        getf(vm_fa): cur "a"
        getf(vm_ft): cur "imm"
        vm_reg(vm_fv): vm_fa
        if(_): {vm_fv = false} [
            sub(vm_ft2): vm_ft 1
            set(vm_ip): vm_ft2
        ]
    ]
    if(_): {op = 10} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_xc): cur "c"
        vm_reg(vm_vb): vm_xb
        vm_reg(vm_vc): vm_xc
        add(vm_vr): vm_vb vm_vc
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 11} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_xc): cur "c"
        vm_reg(vm_vb): vm_xb
        vm_reg(vm_vc): vm_xc
        sub(vm_vr): vm_vb vm_vc
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 12} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_xc): cur "c"
        vm_reg(vm_vb): vm_xb
        vm_reg(vm_vc): vm_xc
        mul(vm_vr): vm_vb vm_vc
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 13} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_vc2): cur "c"
        vm_reg(vm_vb2): vm_xb
        vm_reg(vm_vc3): vm_vc2
        div(vm_vr): vm_vb2 vm_vc3
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 14} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_xc3): cur "c"
        vm_reg(vm_vb3): vm_xb
        vm_reg(vm_vc4): vm_xc3
        mod(vm_vr): vm_vb3 vm_vc4
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 16} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_xc): cur "c"
        vm_reg(vm_vb): vm_xb
        vm_reg(vm_vc): vm_xc
        set(vm_vr): {vm_vb = vm_vc}
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 17} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_xc): cur "c"
        vm_reg(vm_vb): vm_xb
        vm_reg(vm_vc): vm_xc
        set(vm_vr): {vm_vb != vm_vc}
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 18} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_xc): cur "c"
        vm_reg(vm_vb): vm_xb
        vm_reg(vm_vc): vm_xc
        set(vm_vr): {vm_vb < vm_vc}
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 19} [
        getf(vm_xa): cur "a"
        getf(vm_xb): cur "b"
        getf(vm_xc): cur "c"
        vm_reg(vm_vb): vm_xb
        vm_reg(vm_vc): vm_xc
        set(vm_vr): {vm_vb <= vm_vc}
        vm_setreg(_): vm_xa vm_vr
    ]
    if(_): {op = 20} [
