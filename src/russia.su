        ]
    ]
    if(_): {ps_mode != "tokens"} [
        set(rt_md): 0
        if(_): {ps_mode = "ast"} [ set(rt_md): 1 ]
        if(_): {ps_mode = "walk"} [ set(rt_md): 2 ]
        if(_): {ps_mode = "dump"} [ set(rt_md): 3 ]
        if(_): {rt_md = 1} [
            ps_dump(_): ps_root 0
        ]
        # Build the target's argument vector: strip arg_vec[0] (the target
        # path itself, like argv[0]) and a trailing mode flag, matching the
        # host convention where programs see only their own arguments.
        vec(rt_argv): ""
        set(rt_ai): 1
        set(rt_aend): arg_cnt
        if(_): {rt_md > 0} [
            set(rt_aend): {arg_cnt - 1}
        ]
        while(_): {rt_ai < rt_aend} [
            at(rt_av): arg_vec rt_ai
            push(_): rt_argv rt_av
            set(rt_ai): {rt_ai + 1}
        ]
        len(rt_acnt): rt_argv
        if(_): {rt_md = 2} [
            rt_run(_): ps_root rt_acnt rt_argv
        ]
        if(_): {rt_md = 3} [
            cv_stmt(_): ps_root
            cv_dump(_): 
        ]
        if(_): {rt_md = 0} [
            cv_driver(_): ps_root rt_acnt rt_argv
        ]
    ]
]

# ---------- REPL ----------
# Read-eval-print loop, entered when russia.su itself runs with no target
# program (./ussr russia.su). Each line is read through the host one at a
# time (Enter-terminated, no Ctrl-D needed): a nested eval runs head -1
# and captures its stdout through the chain machinery into a scratch file.
# Input accumulates until square brackets balance (string-aware, like the
# host REPL), then the buffered command list is lexed, parsed and executed
# by the tree walker against the persistent rt_store/rt_fdefs, so
# variables and function definitions survive between lines. Ctrl-D (an
# empty read) exits the loop.

repl_rd(r): [
    set(rrd_h1): null
    set(rrd_src): "head(rrd_h1): \"-1\"\nchain(_):\nfile(_): \"/tmp/ussr_repl_line.txt\"\n"
    eval(rrd_ok): rrd_src
    readfile(r): "/tmp/ussr_repl_line.txt"
]

repl_dep(r): s d [
    len(rd_n): s
    set(rd_i): 0
    set(rd_str): 0
    set(rd_esc): 0
    set(rd_d): d
    while(_): {rd_i < rd_n} [
        byte(rd_b): s rd_i
        set(rd_was): rd_str
        if(_): {rd_was = 1} [
            set(rd_skip): 0
            if(_): {rd_esc = 1} [
                set(rd_esc): 0
                set(rd_skip): 1
            ]
            if(_): {rd_skip = 0} [
                if(_): {rd_b = 92} [
                    set(rd_esc): 1
                ]
                if(_): {rd_b = 34} [
                    set(rd_str): 0
                ]
            ]
        ]
        if(_): {rd_was = 0} [
            if(_): {rd_b = 34} [
                set(rd_str): 1
            ]
            if(_): {rd_b = 91} [
                set(rd_d): {rd_d + 1}
            ]
            if(_): {rd_b = 93} [
                if(_): {rd_d > 0} [
                    set(rd_d): {rd_d - 1}
                ]
            ]
        ]
        set(rd_i): {rd_i + 1}
    ]
    set(r): rd_d
]

repl_exec(r): src [
    vec(lx_tokens): "lx_Tok"
    lx_scan(rex_ls): src
    if(_): {rex_ls = 0} [
        ps_parse(rex_ps): src
        if(_): {rex_ps = 0} [
            getf(rex_kids): ps_root "kids"
            ex_block_h(_): rex_kids 0
        ]
    ]
    set(rt_flow): 0
    set(r): 0
]

repl(r): [
    print(_): "USSR Unified Shell Script REPL"
    print(_): "USSR v0.4"
    print(_): "Enter a command list or press Ctrl-D to exit."
    print(_): ""
    set(rp_buf): ""
    set(rp_dep): 0
    set(rp_eof): 0
    while(_): {rp_eof = 0} [
        if(_): {rp_dep = 0} [
            template(_): "STR" "ussr> "
        ]
        if(_): {rp_dep > 0} [
            template(_): "STR" "... "
        ]
        repl_rd(rp_line): 
        len(rp_ll): rp_line
        if(_): {rp_ll = 0} [
            set(rp_eof): 1
        ]
        if(_): {rp_eof = 0} [
            concat(rp_buf): rp_buf rp_line
            repl_dep(rp_dep): rp_line rp_dep
            if(_): {rp_dep < 1} [
                repl_exec(_): rp_buf
                set(rp_buf): ""
                set(rp_dep): 0
            ]
        ]
    ]
    print(_): ""
    set(r): 0
]
