    if(_): {n > 1} [ concat(rt_xes): rt_xes " rt_xa2" ]
    if(_): {n > 2} [ concat(rt_xes): rt_xes " rt_xa3" ]
    if(_): {n > 3} [ concat(rt_xes): rt_xes " rt_xa4" ]
    if(_): {n > 4} [ concat(rt_xes): rt_xes " rt_xa5" ]
    if(_): {n > 5} [ concat(rt_xes): rt_xes " rt_xa6" ]
    eval(rt_xer): rt_xes
    getf(rt_xrn): nd "s2"
    rt_write(_): rt_xrn rt_xrv
