    set(r): 0
]

kgb_problem(r): text [
    print(_): text
    set(r): 1
]

kgb_cmd_check(r): p [
    set(r): 0
    # names shared by several objects need a path to be named
    vec(seen): ""
    len(no): kgb_objects
    set(i): 0
    while(_): {i < no} [
        at(o): kgb_objects i
        kgb_base(b): o
        kgb_index(done): seen b
        if(_): {done < 0} [
            push(_): seen b
            kgb_matches(hits): kgb_objects b
            len(nh): hits
            if(_): {nh > 1} [
                kgb_joined(all): hits ", "
                concat(m): "shared name '" b "': " all
                kgb_problem(r): m
            ]
        ]
        add(i): i 1
    ]
    kgb_folders_in(all): ""
    len(n): all
    set(i): 0
    while(_): {i < n} [
        at(rel): all i
        kgb_label(lab): rel
        kgb_facts(fs): rel
        len(k): fs
        kgb_is_object(obj): rel
        if(_): {obj && k = 0} [
            concat(m): "no facts: " rel
            kgb_problem(r): m
        ]
        # md files without a single fact
        kgb_entries(md): rel false
        len(nm): md
        set(j): 0
        while(_): {j < nm} [
            at(file): md j
            set(count): 0
            set(x): 0
            while(_): {x < k} [
                at(f): fs x
                getf(ff): f "file"
                if(_): {ff = file} [
                    add(count): count 1
                ]
                add(x): x 1
            ]
            if(_): {count = 0 && obj} [
                concat(m): "no facts in " rel "/" file
                kgb_problem(r): m
            ]
            add(j): j 1
        ]
        vec(texts): ""
        set(j): 0
        while(_): {j < k} [
            at(f): fs j
            getf(t): f "text"
            str_lower(low): t
            kgb_index(dup): texts low
            if(_): {dup >= 0} [
                concat(m): "repeated fact in " lab ": " t
                kgb_problem(r): m
            ]
            push(_): texts low
            kgb_links_of(ls): t
            len(nl): ls
            set(l): 0
            while(_): {l < nl} [
                at(link): ls l
                kgb_matches(hits): kgb_objects link
                len(nh): hits
                if(_): {nh = 0} [
                    concat(m): "broken link [[" link "]] in " lab
                    kgb_problem(r): m
                ]
                if(_): {nh > 1} [
                    concat(m): "ambiguous link [[" link "]] in " lab
                    kgb_problem(r): m
                ]
                add(l): l 1
            ]
            add(j): j 1
        ]
        add(i): i 1
    ]
    if(_): {r = 0} [
        print(_): "ok"
    ]
]

kgb_dump_at(r): rel [
    set(r): 0
    kgb_facts(fs): rel
    len(k): fs
    if(_): {k > 0 && rel != ""} [
        kgb_label(lab): rel
        concat(head): "# " lab
        print(_): head
        print(_): ""
        set(section): ""
        set(file): ""
        set(j): 0
        while(_): {j < k} [
            at(f): fs j
            getf(t): f "text"
            getf(s): f "section"
            getf(ff): f "file"
            if(_): {s != section || (ff != file && j > 0)} [
                if(_): {j > 0} [
                    print(_): ""
                ]
                if(_): {s != ""} [
                    concat(sh): "## " s
                    print(_): sh
                    print(_): ""
                ]
                set(section): s
            ]
            set(file): ff
            concat(item): "- " t
            print(_): item
            add(j): j 1
        ]
        print(_): ""
    ]
    kgb_entries(subs): rel true
    len(n): subs
    set(i): 0
    while(_): {i < n} [
        at(s): subs i
        kgb_join(child): rel s
        kgb_dump_at(_): child
        add(i): i 1
    ]
]

kgb_cmd_dump(r): p [
    kgb_words(name): p 1
    if(_): {name = ""} [
        set(name): kgb_opt_in
    ]
    kgb_category(cat): name
    kgb_is_string(ok): cat
    if(_): {ok = false} [
        return(r): 2
    ]
    kgb_dump_at(r): cat
]

# Runs one command line: a vector of strings without the program name.
kgb_main(r): args [
    kgb_types(_):
    set(kgb_opt_in): ""
    set(kgb_opt_file): ""
    set(given): ""
    vec(p): ""
    len(n): args
    set(plain): false
    set(i): 0
    while(_): {i < n} [
        at(a): args i
        set(option): {plain = false && i + 1 < n}
        if(_): {plain = false && a = "--"} [
            set(plain): true
        ]
        elif(_): {option && a = "--kb"} [
            at(given): args {i + 1}
            add(i): i 1
        ]
        elif(_): {option && a = "--in"} [
            at(kgb_opt_in): args {i + 1}
            add(i): i 1
        ]
        elif(_): {option && a = "--file"} [
            at(kgb_opt_file): args {i + 1}
            add(i): i 1
        ]
        else(_): [
            push(_): p a
        ]
        add(i): i 1
    ]
    len(np): p
    set(cmd): "help"
    if(_): {np > 0} [
        at(cmd): p 0
    ]
    if(_): {cmd = "help" || cmd = "--help" || cmd = "-h"} [
        kgb_usage(r):
        return(r): r
    ]
    if(_): {cmd = "init"} [
        kgb_cmd_init(r): p
        return(r): r
    ]
    kgb_find_root(kgb_root): given
    kgb_full(top): ""
    is_dir(d): top
    if(_): {d = 0} [
        concat(m): "no knowledge base at " top
        kgb_err(r): m
        return(r): r
    ]
    kgb_scan(_):
    set(r): -1
    if(_): {cmd = "tree"} [ kgb_cmd_tree(r): p ]
    elif(_): {cmd = "ls"} [ kgb_cmd_list(r): p true ]
    elif(_): {cmd = "cats"} [ kgb_cmd_list(r): p false ]
    elif(_): {cmd = "show"} [ kgb_cmd_show(r): p ]
    elif(_): {cmd = "new"} [ kgb_cmd_new(r): p ]
    elif(_): {cmd = "add"} [ kgb_cmd_add(r): p ]
    elif(_): {cmd = "edit"} [ kgb_cmd_edit(r): p ]
    elif(_): {cmd = "rm"} [ kgb_cmd_rm(r): p ]
    elif(_): {cmd = "get"} [ kgb_cmd_get(r): p ]
    elif(_): {cmd = "set"} [ kgb_cmd_set(r): p ]
    elif(_): {cmd = "unset"} [ kgb_cmd_unset(r): p ]
    elif(_): {cmd = "find"} [ kgb_cmd_find(r): p ]
    elif(_): {cmd = "where"} [ kgb_cmd_where(r): p ]
    elif(_): {cmd = "table"} [ kgb_cmd_table(r): p ]
    elif(_): {cmd = "props"} [ kgb_cmd_props(r): p ]
    elif(_): {cmd = "type"} [ kgb_cmd_type(r): p ]
    elif(_): {cmd = "is"} [ kgb_cmd_is(r): p ]
    elif(_): {cmd = "mv"} [ kgb_cmd_mv(r): p ]
    elif(_): {cmd = "rename"} [ kgb_cmd_rename(r): p ]
    elif(_): {cmd = "del"} [ kgb_cmd_del(r): p ]
    elif(_): {cmd = "links"} [ kgb_cmd_links(r): p ]
    elif(_): {cmd = "refs"} [ kgb_cmd_refs(r): p ]
    elif(_): {cmd = "stats"} [ kgb_cmd_stats(r): p ]
    elif(_): {cmd = "check"} [ kgb_cmd_check(r): p ]
    elif(_): {cmd = "dump"} [ kgb_cmd_dump(r): p ]
    if(_): {r = -1} [
        concat(m): "unknown command '" cmd "' (kgb help lists them)"
        kgb_err(r): m
    ]
]

$ifdef __MAIN__
init(ret): arg_count arg_values [
    vec(args): ""
    set(i): 0
    while(_): {i < arg_count} [
        at(a): arg_values i
        push(_): args a
        add(i): i 1
    ]
    kgb_main(ret): args
]
$endif
