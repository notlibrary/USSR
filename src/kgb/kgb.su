        kgb_keys_in(keys): fs keys
        kgb_entries(md): rel false
        len(m): md
        add(files): files m
        set(j): 0
        while(_): {j < k} [
            at(f): fs j
            getf(t): f "text"
            kgb_key(key): t
            kgb_is_string(is_k): key
            if(_): is_k [
                add(props): props 1
            ]
            add(j): j 1
        ]
        add(i): i 1
    ]
    len(no): kgb_objects
    len(nc): kgb_cats
