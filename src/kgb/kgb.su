                return(r): 2
            ]
            set(first): 2
        ]
    ]
    kgb_objects_in(objs): cat
    len(no): objs
    vec(keys): ""
    if(_): {first < n} [
        set(i): first
        while(_): {i < n} [
            at(k): p i
            push(_): keys k
            add(i): i 1
        ]
    ]
    else(_): [
        set(i): 0
        while(_): {i < no} [
            at(o): objs i
            kgb_keys(ks): o
            len(nk): ks
            set(j): 0
            while(_): {j < nk} [
                at(k): ks j
                kgb_index(at): keys k
                if(_): {at < 0} [
                    push(_): keys k
                ]
                add(j): j 1
            ]
            add(i): i 1
        ]
    ]
    len(nk): keys
    set(head): "| object |"
    set(rule): "|---|"
    set(j): 0
    while(_): {j < nk} [
        at(k): keys j
        kgb_cell(kc): k
        concat(head): head " " kc " |"
        concat(rule): rule "---|"
        add(j): j 1
    ]
    print(_): head
    print(_): rule
    set(skip): 0
    if(_): {cat != ""} [
        len(cl): cat
        set(skip): {cl + 1}
    ]
    set(i): 0
    while(_): {i < no} [
        at(o): objs i
        kgb_from(shown): o skip
        kgb_cell(sc): shown
        concat(row): "| " sc " |"
        set(j): 0
        while(_): {j < nk} [
            at(k): keys j
            kgb_lookup(vs): o k
            kgb_joined(v): vs ", "
            kgb_cell(vc): v
            concat(row): row " " vc " |"
            add(j): j 1
        ]
        print(_): row
        add(i): i 1
    ]
    set(r): 0
    if(_): {no = 0} [
        set(r): 1
    ]
]

kgb_cmd_props(r): p [
    kgb_words(name): p 1
    kgb_category(cat): name
    kgb_is_string(ok): cat
    if(_): {ok = false} [
        return(r): 2
    ]
    kgb_objects_in(objs): cat
    vec(keys): ""
    vec(counts): ""
    len(no): objs
    set(i): 0
    while(_): {i < no} [
        at(o): objs i
        kgb_keys(ks): o
        len(nk): ks
        set(j): 0
        while(_): {j < nk} [
            at(k): ks j
            kgb_index(at): keys k
            if(_): {at < 0} [
                push(_): keys k
                push(_): counts 1
            ]
            else(_): [
                # vectors have no store: rebuild counts with one more at at
                vec(next): ""
                len(nc): counts
                set(c): 0
                while(_): {c < nc} [
                    at(x): counts c
                    if(_): {c = at} [
                        add(x): x 1
                    ]
                    push(_): next x
                    add(c): c 1
                ]
                set(counts): next
            ]
            add(j): j 1
        ]
        add(i): i 1
    ]
    kgb_sorted(order): keys
    len(nk): order
    set(r): 1
    set(j): 0
    while(_): {j < nk} [
        at(k): order j
        kgb_index(at): keys k
        at(c): counts at
        kgb_int(cs): c
        concat(line): k "  " cs
        print(_): line
        set(r): 0
        add(j): j 1
    ]
]

kgb_cmd_type(r): p [
