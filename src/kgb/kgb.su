kgb_cmd_is(r): p [
    kgb_need(ok): p 3 "is OBJ CAT"
    if(_): {ok = false} [
        return(r): 2
    ]
    at(name): p 1
    at(cname): p 2
    kgb_object(obj): name
    kgb_is_string(ok): obj
    if(_): {ok = false} [
        return(r): 2
    ]
    kgb_clean(c): cname
    # a category path, or the name of any category the object is under
    kgb_under(r1): obj c
    concat(mid): "/" c "/"
    concat(wrapped): "/" obj
    str_find(at): wrapped mid 0
    set(yes): {(r1 && c != obj) || at >= 0}
    if(_): yes [
        print(_): "yes"
        set(r): 0
    ]
    else(_): [
        print(_): "no"
        set(r): 1
    ]
]

kgb_cmd_mv(r): p [
    kgb_need(ok): p 3 "mv OBJ CAT"
    if(_): {ok = false} [
        return(r): 2
    ]
    at(name): p 1
    at(cname): p 2
    kgb_object(obj): name
    kgb_is_string(ok): obj
    if(_): {ok = false} [
        return(r): 2
    ]
    # an existing category by name, else a new path below the root
    kgb_clean(cat): cname
    kgb_matches(cats): kgb_cats cat
    kgb_matches(objs): kgb_objects cat
    len(nc): cats
    len(nob): objs
    if(_): {nc > 0 || nob > 0} [
        kgb_category(cat): cat
        kgb_is_string(ok): cat
        if(_): {ok = false} [
            return(r): 2
        ]
    ]
    kgb_under(inside): cat obj
    if(_): {inside && cat != ""} [
        kgb_err(r): "cannot move an object into itself"
        return(r): r
    ]
    kgb_base(b): obj
    kgb_join(dest): cat b
    kgb_full(to): dest
    is_dir(d): to
    if(_): {d = 1} [
        concat(m): dest " already exists"
        kgb_err(r): m
        return(r): r
    ]
    if(_): {cat != ""} [
        kgb_mkdirs(_): cat
    ]
    kgb_full(from): obj
    rename_path(bad): from to
    if(_): {bad != 0} [
        concat(m): "cannot move " obj " to " dest
        kgb_err(r): m
        return(r): r
    ]
    concat(m): obj " -> " dest
    print(_): m
    kgb_parent(old): obj
    kgb_prune(_): old
    set(r): 0
]

kgb_cmd_rename(r): p [
    kgb_need(ok): p 3 "rename OBJ NAME"
    if(_): {ok = false} [
        return(r): 2
    ]
    at(name): p 1
    at(newname): p 2
    kgb_object(obj): name
    kgb_is_string(ok): obj
    if(_): {ok = false} [
        return(r): 2
    ]
    str_find(slash): newname "/" 0
    byte(b0): newname 0
    if(_): {slash >= 0 || newname = "" || b0 = 46} [
        kgb_err(r): "a new name has no slashes and does not start with a dot (kgb mv reclassifies)"
        return(r): r
    ]
    kgb_parent(up): obj
    kgb_join(dest): up newname
    kgb_full(to): dest
    is_dir(d): to
    if(_): {d = 1} [
        concat(m): dest " already exists"
        kgb_err(r): m
        return(r): r
    ]
    kgb_full(from): obj
    rename_path(bad): from to
    if(_): {bad != 0} [
        concat(m): "cannot rename " obj
        kgb_err(r): m
        return(r): r
    ]
    concat(m): obj " -> " dest
    print(_): m
    set(r): 0
]

kgb_cmd_del(r): p [
