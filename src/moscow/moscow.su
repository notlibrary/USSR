# moscow.su - Moscow, the USSR amd64 kernel.
#
# The boot loader (arch/amd64/boot.nasm) puts the machine in long mode
# and starts the NASM USSR runtime (arch/amd64/ussr_rt.nasm), which runs
# this program, compiled to moscow.ru, as the first process. Moscow
# reports the machine, mounts its root file system - the first Belarus
# file system on the disks (src/belarus) - and then runs the shell,
# russia.ru, from the boot image, again whenever it fails; when the
# shell exits normally (Ctrl-D) the machine halts. russia.ru is
# src/russia/russia.su, the USSR interpreter written in USSR: its REPL
# is the shell, and the commands it does not know itself go to the
# runtime through its host calls.
#
# Moscow is also the file system's keeper: it takes the file commands
# over with k_syscall, so in the shell ls, cat, readfile, writefile,
# file_exists, list_dir, is_dir, make_dir, remove_file and the handle
# calls (open_file, read_line, read_file, write_file, close_file) work on
# the root file system, run starts a program of /bin - or a .su source,
# through russia.ru - and install starts the installer (/bin/install.ru). A kernel command runs in the calling
# program's memory and keeps nothing between calls but the root's device
# and first sector: it mounts the file system each time.
#
#     sh src/moscow/build.sh          # builds moscow.img and ussr.img
#     sh src/moscow/run.sh            # boots ussr.img in QEMU
#
# The k_* commands are the runtime's kernel services; src/moscow/README.md
# lists them.
$include "../belarus/belarus.su"
$include "net.su"
$include "dhcp.su"
$include "../murmansk/murmansk.su"
$include "tls.su"

global(_): mo_dev mo_base mo_files

mo_kb(r): bytes [
    str_trunc(kb): {bytes / 1024}
    str_from_int(r): kb
    concat(r): r " KiB"
]

# The root file system: the first Belarus file system on the disks.
mo_find_root(r): [
    set(r): false
    set(mo_dev): ""
    set(mo_base): -1
    bdevices(devs):
    len(n): devs
    set(i): 0
    while(_): {i < n} [
        at(d): devs i
        at(dev): d 0
        bl_locate(base): dev 0
        if(_): {base >= 0} [
            set(mo_dev): dev
            set(mo_base): base
            set(r): true
            return(r): r
        ]
        set(i): {i + 1}
    ]
]

# the root, mounted for one command, or null
mo_fs(r): [
    set(r): null
    if(_): {mo_base < 0} [
        bl_err(_): "no root file system"
        return(r): r
    ]
    bl_mount(r): mo_dev mo_base
]

# argument i of a kernel command, or def
mo_arg(r): a i def [
    set(r): def
    len(n): a
    if(_): {i < n} [ at(r): a i ]
]

mo_sync(r): fs [
    set(r): 0
    btget(dirty): fs "dirty"
    if(_): dirty [ bl_sync(r): fs ]
]

# --- the kernel's commands: each gets its arguments as one vector

sys_ls(r): a [
    set(r): null
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 "/"
    bl_cmd_ls(st): fs path
    if(_): {st = 0} [
        bl_is_dir(d): fs path
        if(_): d [ bl_list(r): fs path ]
        else(_): [ bl_clean(r): path ]
    ]
]

sys_tree(r): a [
    set(r): 0
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 "/"
    bl_cmd_tree(r): fs path
]

sys_cat(r): a [
    set(r): null
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_read_text(r): fs path
    typeof(tr): r
    if(_): {tr = "string"} [ print_raw(_): r ]
]

sys_readfile(r): a [
    set(r): null
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_exists(e): fs path
    if(_): e [ bl_read_text(r): fs path ]
]

sys_writefile(r): a [
    set(r): -1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    mo_arg(text): a 1 ""
    bl_clean(p): path
    bl_parent(up): p
    bl_mkdirs(_): fs up
    typeof(tt): text
    if(_): {tt = "vector"} [ bl_write_bytes(r): fs path text ]
    else(_): [ bl_write_text(r): fs path text ]
    mo_sync(_): fs
]

sys_file_exists(r): a [
    set(r): false
    mo_arg(path): a 0 ""
    len(n): path
    if(_): {n > 5} [
        slice(p5): path 0 5
        if(_): {p5 = "/dev/"} [
            bsize(b): path
            set(r): {b >= 0}
            return(r): r
        ]
    ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_exists(r): fs path
]

sys_is_dir(r): a [
    set(r): false
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_is_dir(r): fs path
]

sys_list_dir(r): a [
    set(r): null
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 "/"
    bl_list(r): fs path
]

sys_make_dir(r): a [
    set(r): -1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_mkdirs(r): fs path
    mo_sync(_): fs
]

sys_remove_file(r): a [
    set(r): -1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_remove(r): fs path
    mo_sync(_): fs
]

sys_df(r): a [
    set(r): 0
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    concat(m): "root: " mo_dev
    print(_): m
    bl_cmd_info(r): fs
]

sys_fsck(r): a [
    set(r): -1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_fsck(r): fs
]

# --- files by handle, as the hosted ussr has them: open_file gives a
# number, read_line, read_file and write_file use it, close_file ends it.
# Reading takes the file's text when it is opened; what is written is
# kept and goes onto the disk when the handle is closed. mo_files maps
# each open handle to a btree of path, write (opened "w" or "a"), text,
# pos and changed; "next" is the next handle.

mo_file(r): h [
    set(r): null
    typeof(th): h
    if(_): {th != "integer"} [ return(r): r ]
    bthas(has): mo_files h
    if(_): has [ btget(r): mo_files h ]
]

# open_file(h): path [mode] -> a handle, or -1 (no such file to read)
sys_open_file(r): a [
    set(r): -1
    mo_arg(path): a 0 ""
    mo_arg(mode): a 1 "r"
    str_find(w): mode "w" 0
    str_find(ap): mode "a" 0
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree" || path = ""} [ return(r): r ]
    bl_is_dir(d): fs path
    if(_): d [ return(r): r ]
    set(text): ""
    if(_): {w < 0} [
        bl_exists(e): fs path
        if(_): e [ bl_read_text(text): fs path ]
        elif(_): {ap < 0} [ return(r): r ]
    ]
    btget(r): mo_files "next"
    btput(_): mo_files "next" {r + 1}
    btree(f):
    btput(_): f "path" path
    btput(_): f "write" {w >= 0 || ap >= 0}
    btput(_): f "text" text
    btput(_): f "pos" 0
    btput(_): f "changed" {w >= 0}
    btput(_): mo_files r f
]

# read_line(s): h -> the next line without its LF (or CR LF), null at
# the end
sys_read_line(r): a [
    set(r): null
    mo_arg(h): a 0 -1
    mo_file(f): h
    typeof(tf): f
    if(_): {tf != "btree"} [ return(r): r ]
    btget(text): f "text"
    btget(pos): f "pos"
    len(n): text
    if(_): {pos >= n} [ return(r): r ]
    str_find(nl): text "\n" pos
    set(next): {nl + 1}
    if(_): {nl < 0} [
        set(nl): n
        set(next): n
    ]
    slice(r): text pos {nl - pos}
    len(k): r
    if(_): {k > 0} [
        byte(last): r {k - 1}
        if(_): {last = 13} [ slice(r): r 0 {k - 1} ]
    ]
    btput(_): f "pos" next
]

# read_file(s): h [n] -> the rest of the file, or its next n bytes
sys_read_file(r): a [
    set(r): null
    mo_arg(h): a 0 -1
    mo_file(f): h
    typeof(tf): f
    if(_): {tf != "btree"} [ return(r): r ]
    btget(text): f "text"
    btget(pos): f "pos"
    len(n): text
    mo_arg(k): a 1 {n - pos}
    if(_): {k > n - pos} [ set(k): {n - pos} ]
    if(_): {k < 0} [ set(k): 0 ]
    slice(r): text pos k
    btput(_): f "pos" {pos + k}
]

# write_file(n): h data -> the bytes written, -1 for no such handle
sys_write_file(r): a [
    set(r): -1
    mo_arg(h): a 0 -1
    mo_file(f): h
    typeof(tf): f
    if(_): {tf != "btree"} [ return(r): r ]
    btget(wr): f "write"
    if(_): {wr = false} [ return(r): r ]
    mo_arg(data): a 1 ""
    typeof(td): data
    if(_): {td != "string"} [ encode(data): data ]
    btget(text): f "text"
    concat(text): text data
    btput(_): f "text" text
    btput(_): f "changed" true
    len(r): data
]

# close_file(ok): h -> 0, or -1 for no such handle or a failed write
sys_close_file(r): a [
    set(r): -1
    mo_arg(h): a 0 -1
    mo_file(f): h
    typeof(tf): f
    if(_): {tf != "btree"} [ return(r): r ]
    btdel(_): mo_files h
    set(r): 0
    btget(changed): f "changed"
    if(_): changed [
        mo_fs(fs):
        typeof(t): fs
        if(_): {t != "btree"} [
            set(r): -1
            return(r): r
        ]
        btget(path): f "path"
        btget(text): f "text"
        bl_clean(p): path
        bl_parent(up): p
        bl_mkdirs(_): fs up
        bl_write_text(r): fs p text
        mo_sync(_): fs
    ]
]

# --- bread, bwrite and bsize: the runtime's on a disk (/dev/hda ...),
# and on any other path inside a file of the root file system, so a
# program keeps a store of pages (Dubna KV) in a file as on the hosted
# ussr

mo_is_dev(r): path [
    set(r): false
    typeof(t): path
    if(_): {t != "string"} [ return(r): r ]
    len(n): path
    if(_): {n > 5} [
        slice(p5): path 0 5
        set(r): {p5 = "/dev/"}
    ]
]

# bread(v): path lba [count [sector]]
sys_bread(r): a [
    set(r): null
    mo_arg(path): a 0 ""
    mo_arg(lba): a 1 0
    mo_arg(count): a 2 1
    mo_arg(sector): a 3 512
    mo_is_dev(d): path
    if(_): d [
        bread(r): path lba count sector
        return(r): r
    ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_pread(r): fs path {lba * sector} {count * sector}
]

# bwrite(n): path lba bytes [sector]
sys_bwrite(r): a [
    set(r): -1
    mo_arg(path): a 0 ""
    mo_arg(lba): a 1 0
    mo_arg(bytes): a 2 null
    mo_arg(sector): a 3 512
    mo_is_dev(d): path
    if(_): d [
        bwrite(r): path lba bytes sector
        return(r): r
    ]
    typeof(tb): bytes
    if(_): {tb != "vector"} [ return(r): r ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_pwrite(r): fs path {lba * sector} bytes
    mo_sync(_): fs
]

# bsize(n): path -> a disk's or a file's size in bytes, -1
sys_bsize(r): a [
    set(r): -1
    mo_arg(path): a 0 ""
    mo_is_dev(d): path
    if(_): d [
        bsize(r): path
        return(r): r
    ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_get(rec): fs path
    typeof(tr): rec
    if(_): {tr = "vector"} [
        at(ty): rec 0
        if(_): {ty = "f"} [ at(r): rec 1 ]
    ]
]

# --- Murmansk, the firewall (src/murmansk)

# the rules in /etc/murmansk.rules; a line saying what came of it
mo_fw_load(r): fs [
    murmansk_reset(_):
    bl_read_text(text): fs "/etc/murmansk.rules"
    typeof(t): text
    set(from): "no /etc/murmansk.rules"
    set(bad): 0
    if(_): {t = "string"} [
        murmansk_load_text(bad): text
        set(from): "/etc/murmansk.rules"
    ]
    btlen(n): mu_rules
    str_from_int(ns): n
    concat(r): "fw:      Murmansk, " ns " rules from " from "; in " mu_in ", out " mu_out
    if(_): {bad > 0} [
        str_from_int(bs): bad
        murmansk_error(why):
        concat(r): r " (" bs " wrong lines left out: " why ")"
    ]
]

# the rules back from text kept before a program ran: what it changed
# lived in its memory, given back now
mo_fw_restore(r): text [
    set(drops): mu_drops
    murmansk_reset(_):
    murmansk_load_text(r): text
    set(mu_drops): drops
]

# fw(s): [command] -> the firewall's report, which it prints. A command
# is a rule to add at the end ("allow in tcp 8080"), "delete N", "policy
# in|out allow|deny", "save" (into /etc/murmansk.rules) or "load".
sys_fw(r): a [
    mo_arg(cmd): a 0 ""
    mu_words(w): cmd
    len(n): w
    set(st): 0
    set(first): ""
    if(_): {n > 0} [ at(first): w 0 ]
    if(_): {first = "delete" && n = 2} [
        at(x): w 1
        mu_number(k): x
        murmansk_delete(st): k
    ]
    elif(_): {first = "save"} [
        murmansk_text(text):
        mo_fs(fs):
        typeof(t): fs
        set(st): -1
        if(_): {t = "btree"} [
            bl_write_text(st): fs "/etc/murmansk.rules" text
            mo_sync(_): fs
        ]
        if(_): {st = 0} [ print(_): "saved in /etc/murmansk.rules" ]
        else(_): [ mu_fail(_): "/etc/murmansk.rules could not be written" ]
    ]
    elif(_): {first = "load"} [
        mo_fs(fs):
        typeof(t): fs
        if(_): {t = "btree"} [
            mo_fw_load(line): fs
            print(_): line
        ]
    ]
    elif(_): {n > 0} [ murmansk_add(st): cmd ]
    if(_): {st != 0} [
        murmansk_error(why):
        concat(m): "fw: " why "\n"
        write_stderr(_): m
    ]
    murmansk_report(r):
    print(_): r
]

# c_load(lib): path -> a C library of the root file system (an ELF shared
# object built freestanding, see arch/amd64/cffi.inc), its number, or
# null; a bare name is looked for in /lib. c_sym, c_call and the others
# are the runtime's.
sys_c_load(r): a [
    set(r): null
    mo_arg(path): a 0 ""
    str_find(slash): path "/" 0
    if(_): {slash < 0} [ concat(path): "/lib/" path ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_is_dir(d): fs path
    bl_exists(e): fs path
    if(_): {e = false || d} [ return(r): r ]
    bl_read_bytes(bytes): fs path
    typeof(tb): bytes
    if(_): {tb = "vector"} [ k_elf_load(r): bytes ]
]

# rename_path(r): from to -> 0, 1 when it failed (there is something at
# to already, among other things)
sys_rename_path(r): a [
    set(r): 1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(from): a 0 ""
    mo_arg(to): a 1 ""
    bl_rename(st): fs from to
    if(_): {st = 0} [
        mo_sync(_): fs
        set(r): 0
    ]
]

# localtime(v): [seconds] -> [year month day hour minute second weekday
# yearday] (weekday 0 Sunday, yearday 0 for 1 January); the clock is UTC
sys_localtime(r): a [
    time(now):
    mo_arg(t): a 0 now
    typeof(tt): t
    if(_): {tt != "integer"} [ str_trunc(t): t ]
    str_trunc(days): {t / 86400}
    set(secs): {t - days * 86400}
    if(_): {secs < 0} [
        set(secs): {secs + 86400}
        set(days): {days - 1}
    ]
    # Howard Hinnant's civil_from_days
    set(z): {days + 719468}
    set(era): 0
    if(_): {z >= 0} [ str_trunc(era): {z / 146097} ]
    else(_): [ str_trunc(era): {(z - 146096) / 146097} ]
    set(doe): {z - era * 146097}
    str_trunc(a1): {doe / 1460}
    str_trunc(a2): {doe / 36524}
    str_trunc(a3): {doe / 146096}
    str_trunc(yoe): {(doe - a1 + a2 - a3) / 365}
    str_trunc(b1): {yoe / 4}
    str_trunc(b2): {yoe / 100}
    set(doy): {doe - (365 * yoe + b1 - b2)}
    str_trunc(mp): {(5 * doy + 2) / 153}
    str_trunc(c1): {(153 * mp + 2) / 5}
    set(d): {doy - c1 + 1}
    set(m): {mp + 3}
    if(_): {mp >= 10} [ set(m): {mp - 9} ]
    set(y): {yoe + era * 400}
    if(_): {m <= 2} [ set(y): {y + 1} ]
    # the day of the year
    set(leap): {(y % 4 = 0 && y % 100 != 0) || y % 400 = 0}
    vec(before): ""
    push(_): before 0
    push(_): before 31
    push(_): before 59
    push(_): before 90
    push(_): before 120
    push(_): before 151
    push(_): before 181
    push(_): before 212
    push(_): before 243
    push(_): before 273
    push(_): before 304
    push(_): before 334
    at(yd): before {m - 1}
    set(yd): {yd + d - 1}
    if(_): {leap && m > 2} [ set(yd): {yd + 1} ]
    set(wd): {(days + 4) % 7}
    if(_): {wd < 0} [ set(wd): {wd + 7} ]
    str_trunc(hh): {secs / 3600}
    str_trunc(mi): {(secs - hh * 3600) / 60}
    vec(r): ""
    push(_): r y
    push(_): r m
    push(_): r d
    push(_): r hh
    push(_): r mi
    push(_): r {secs - hh * 3600 - mi * 60}
    push(_): r wd
    push(_): r yd
]

# run(status): name [args ...]: /bin/name.ru (or the path given) from
# the root file system, else a program of the boot image
sys_run(r): a [
    set(r): 127
    len(n): a
    if(_): {n = 0} [
        bl_err(_): "run(status): program [args ...]"
        return(r): r
    ]
    at(name): a 0
    vec(args): ""
    set(i): 1
    while(_): {i < n} [
        at(x): a i
        push(_): args x
        set(i): {i + 1}
    ]
    mo_run(r): name args
]

# the last three bytes of s, "" when it is shorter
mo_ext(r): s [
    set(r): ""
    len(n): s
    if(_): {n > 3} [ slice(r): s {n - 3} 3 ]
]

# A program: a .ru file runs as it is, a .su file through russia.ru, the
# USSR interpreter (from /bin, else /boot), which reads the source from
# the disk. A bare name is looked for as /bin/name.ru, /bin/name.su and
# then the project's own src/name/name.su under /src/ussr, so
# run(_): "Mbl" "notes.txt" starts the editor from its source.
mo_run(r): name args [
    set(r): 127
    vec(tries): ""
    str_find(slash): name "/" 0
    mo_ext(ext): name
    if(_): {slash >= 0} [ push(_): tries name ]
    elif(_): {ext = ".ru" || ext = ".su"} [
        concat(p): "/bin/" name
        push(_): tries p
    ]
    else(_): [
        concat(p): "/bin/" name ".ru"
        push(_): tries p
        concat(p): "/bin/" name ".su"
        push(_): tries p
        concat(p): "/src/ussr/src/" name "/" name ".su"
        push(_): tries p
    ]
    set(path): ""
    if(_): {mo_base >= 0} [
        mo_fs(fs):
        len(nt): tries
        set(i): 0
        while(_): {i < nt && path = ""} [
            at(p): tries i
            set(d): true
            bl_exists(e): fs p
            if(_): e [ bl_is_dir(d): fs p ]
            if(_): {e && d = false} [ set(path): p ]
            set(i): {i + 1}
        ]
    ]
    if(_): {path != ""} [
        mo_ext(ext): path
        if(_): {ext = ".su"} [
            # russia.ru path args ...
            vec(rargs): ""
            push(_): rargs path
            len(na): args
            set(i): 0
            while(_): {i < na} [
                at(x): args i
                push(_): rargs x
                set(i): {i + 1}
            ]
            set(args): rargs
            set(path): "/bin/russia.ru"
            bl_exists(e): fs path
            if(_): {e = false} [ set(path): "/boot/russia.ru" ]
        ]
        bl_read_bytes(bytes): fs path
        typeof(tb): bytes
        if(_): {tb = "vector"} [
            murmansk_text(fwkeep):
            k_exec_bytes(r): bytes args
            # what the program allocated is given back: its sockets too,
            # and the firewall's rules, kept as text across it
            net_reset(_):
            tls_reset(_):
            mo_fw_restore(_): fwkeep
            return(r): r
        ]
    ]
    # not on the disk: the boot image has russia.ru and moscow.ru
    len(na): args
    if(_): {na = 0} [ k_exec(r): name ]
    else(_): [
        concat(m): name ": no such program in /bin"
        bl_err(r): m
        set(r): 127
    ]
]

# install(status): [args ...] runs the installer, /bin/install.ru
sys_install(r): a [
    mo_run(r): "/bin/install.ru" a
]

sys_help(r): a [
    set(r): 0
    print(_): "Moscow kernel commands (USSR commands; each prints and returns):"
    print(_): "  help(_):                this list"
    print(_): "  ls(_): [path]           a directory of the root file system"
    print(_): "  tree(_): [path]         everything under a path"
    print(_): "  cat(_): path            a file's text"
    print(_): "  readfile(s): path       a file as a string; writefile(r): path text"
    print(_): "  make_dir(r): path       remove_file(r): path   file_exists(b): path"
    print(_): "  run(status): name ...   /bin/name.ru (stalin, belarus, install, ...), a .su"
    print(_): "                          through russia: run(_): \"Mbl\" \"/home/notes.txt\" edits"
    print(_): "  open_file(h): path mode read_line(s): h write_file(n): h text close_file(r): h"
    print(_): "  install(status):        install USSR onto another disk"
    print(_): "  df(_):  fsck(_):        the root file system, its free space, a check"
    print(_): "  uptime(_): mem(_): cpu(_): uname(_): pwd(_): clear(_): color(_): fg bg"
    print(_): "  net(_): ping(n): host   the network card and address; ICMP echo"
    print(_): "  fw(s): [rule|delete N|policy in|out allow|deny|save|load]  Murmansk, the firewall"
    print(_): "  socket_tcp bind listen accept recv send close connect, wait_readable"
    print(_): "  reboot(_): halt(_):     restart or stop the machine (Ctrl-D halts too)"
]

mo_syscalls(r): [
    set(r): 0
    k_syscall(_): "help" "sys_help"
    k_syscall(_): "ls" "sys_ls"
    k_syscall(_): "tree" "sys_tree"
    k_syscall(_): "cat" "sys_cat"
    k_syscall(_): "readfile" "sys_readfile"
    k_syscall(_): "writefile" "sys_writefile"
    k_syscall(_): "file_exists" "sys_file_exists"
    k_syscall(_): "is_dir" "sys_is_dir"
    k_syscall(_): "list_dir" "sys_list_dir"
    k_syscall(_): "make_dir" "sys_make_dir"
    k_syscall(_): "remove_file" "sys_remove_file"
    k_syscall(_): "run" "sys_run"
    k_syscall(_): "install" "sys_install"
    k_syscall(_): "df" "sys_df"
    k_syscall(_): "fsck" "sys_fsck"
    k_syscall(_): "open_file" "sys_open_file"
    k_syscall(_): "read_line" "sys_read_line"
    k_syscall(_): "read_file" "sys_read_file"
    k_syscall(_): "write_file" "sys_write_file"
    k_syscall(_): "close_file" "sys_close_file"
    k_syscall(_): "rename_path" "sys_rename_path"
    k_syscall(_): "localtime" "sys_localtime"
    k_syscall(_): "bread" "sys_bread"
    k_syscall(_): "bwrite" "sys_bwrite"
    k_syscall(_): "bsize" "sys_bsize"
    k_syscall(_): "fw" "sys_fw"
    k_syscall(_): "c_load" "sys_c_load"
    tls_syscalls(_):
    net_syscalls(_):
]

init(ret): arg_cnt arg_vec [
    k_color(_): 14 1
    print(_): "USSR Moscow kernel for amd64"
    k_color(_): 7 0
    k_cpu(cpu):
    concat(line): "cpu:     " cpu
    print(_): line
    k_mem(m):
    at(total): m 0
    at(free): m 1
    mo_kb(ts): total
    mo_kb(fs): free
    concat(line): "heap:    " ts ", " fs " free"
    print(_): line
    k_modules(mods):
    len(n): mods
    set(list): ""
    set(i): 0
    while(_): {i < n} [
        at(name): mods i
        if(_): {i > 0} [ concat(list): list " " ]
        concat(list): list name
        set(i): {i + 1}
    ]
    concat(line): "image:   " list
    print(_): line
    bdevices(devs):
    len(nd): devs
    set(i): 0
    while(_): {i < nd} [
        at(d): devs i
        at(dev): d 0
        at(bytes): d 1
        at(model): d 4
        str_trunc(mib): {bytes / 1048576}
        str_from_int(sm): mib
        concat(line): "disk:    " dev ", " sm " MiB, " model
        print(_): line
        set(i): {i + 1}
    ]
    # in deny, out allow until the rules come from the disk
    murmansk_reset(_):
    net_start(netok):
    net_describe(nd):
    concat(line): "net:     " nd
    print(_): line
    mo_find_root(found):
    if(_): found [
        mo_fs(root):
        btget(label): root "label"
        str_from_int(sb): mo_base
        concat(line): "root:    " mo_dev " from sector " sb ", Belarus '" label "'"
        print(_): line
        mo_fw_load(fwline): root
        print(_): fwline
        tls_start(tlsok): root
        if(_): tlsok [ print(_): "tls:     BearSSL from /lib/tls.so" ]
        else(_): [ print(_): "tls:     none (no /lib/tls.so)" ]
        bl_read_text(host): root "/etc/hostname"
        typeof(th): host
        if(_): {th = "string"} [
            str_trim(host): host
            if(_): {host != ""} [ setenv(_): "HOSTNAME" host ]
        ]
        # the installer copies from here
        setenv(_): "USSR_ROOT" mo_dev
        str_from_int(sb): mo_base
        setenv(_): "USSR_ROOT_SECTOR" sb
        bl_read_text(motd): root "/etc/motd"
        typeof(tm): motd
        if(_): {tm = "string"} [ print_raw(_): motd ]
    ]
    else(_): [
        print(_): "root:    no Belarus file system on the disks; the boot image only"
    ]
    btree(mo_files):
    btput(_): mo_files "next" 3
    mo_syscalls(_):
    set(ret): 0
    set(go): true
    while(_): go [
        print(_): "moscow: starting russia.ru"
        murmansk_text(fwkeep):
        k_exec(status): "russia.ru"
        net_reset(_):
        tls_reset(_):
        mo_fw_restore(_): fwkeep
        if(_): {status = 0} [ set(go): false ]
        else(_): [
            str_from_int(ss): status
            concat(line): "moscow: russia.ru failed with status " ss "; restarting"
            print(_): line
        ]
    ]
    print(_): "moscow: the shell has exited; system halted"
    k_halt(_):
]
