# moscow.su - Moscow, the USSR amd64 kernel.
#
# The boot loader (arch/amd64/boot.nasm) puts the machine in long mode
# and starts the NASM USSR runtime (arch/amd64/ussr_rt.nasm), which runs
# this program, compiled to moscow.ru, as the first process. Moscow
# reports the machine, mounts its root file system - the first Belarus
# file system on the disks (src/belarus) - and then runs the shell,
# russia.ru, from the boot image, again whenever it fails; when the
# shell exits normally (Ctrl-D) the machine halts. russia.ru is
# src/russia/russia.su, the USSR interpreter written in USSR: its REPL
# is the shell, and the commands it does not know itself go to the
# runtime through its host calls.
#
# Moscow is also the file system's keeper: it takes the file commands
# over with k_syscall, so in the shell ls, cat, readfile, writefile,
# file_exists, list_dir, is_dir, make_dir, remove_file and the handle
# calls (open_file, read_line, read_file, write_file, close_file) work on
# the root file system, run starts a program of /bin - or a .su source,
# through russia.ru - and install starts the installer (/bin/install.ru). A kernel command runs in the calling
# program's memory and keeps nothing between calls but the root's device
# and first sector: it mounts the file system each time.
#
#     sh src/moscow/build.sh          # builds moscow.img and ussr.img
#     sh src/moscow/run.sh            # boots ussr.img in QEMU
#
# The k_* commands are the runtime's kernel services; src/moscow/README.md
# lists them.
$include "../belarus/belarus.su"
$include "net.su"
$include "dhcp.su"
$include "../murmansk/murmansk.su"
$include "tls.su"
$include "gui.su"
$include "linux.su"

global(_): mo_dev mo_base mo_files mo_cwd

mo_kb(r): bytes [
    str_trunc(kb): {bytes / 1024}
    str_from_int(r): kb
    concat(r): r " KiB"
]

# The root file system: the first Belarus file system on the disks.
mo_find_root(r): [
    set(r): false
    set(mo_dev): ""
    set(mo_base): -1
    bdevices(devs):
    len(n): devs
    # booted from a CD, its image is the root, whatever else is on the disks
    set(pass): 0
    while(_): {pass < 2} [
        set(i): 0
        while(_): {i < n} [
            at(d): devs i
            at(dev): d 0
            at(model): d 4
            if(_): {pass = 1 || model = "USSR live CD"} [
                bl_locate(base): dev 0
                if(_): {base >= 0} [
                    set(mo_dev): dev
                    set(mo_base): base
                    set(r): true
                    return(r): r
                ]
            ]
            set(i): {i + 1}
        ]
        set(pass): {pass + 1}
    ]
]

# the root, mounted for one command, or null
mo_fs(r): [
    set(r): null
    if(_): {mo_base < 0} [
        bl_err(_): "no root file system"
        return(r): r
    ]
    bl_mount(r): mo_dev mo_base
]

# argument i of a kernel command, or def
mo_arg(r): a i def [
    set(r): def
    len(n): a
    if(_): {i < n} [ at(r): a i ]
]

mo_sync(r): fs [
    set(r): 0
    btget(dirty): fs "dirty"
    if(_): dirty [ bl_sync(r): fs ]
]

# --- the kernel's commands: each gets its arguments as one vector

sys_ls(r): a [
    set(r): null
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 "/"
    bl_cmd_ls(st): fs path
    if(_): {st = 0} [
        bl_is_dir(d): fs path
        if(_): d [ bl_list(r): fs path ]
        else(_): [ bl_clean(r): path ]
    ]
]

sys_tree(r): a [
    set(r): 0
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 "/"
    bl_cmd_tree(r): fs path
]

sys_cat(r): a [
    set(r): null
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_read_text(r): fs path
    typeof(tr): r
    if(_): {tr = "string"} [ print_raw(_): r ]
]

sys_readfile(r): a [
    set(r): null
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_exists(e): fs path
    if(_): e [ bl_read_text(r): fs path ]
]

sys_writefile(r): a [
    set(r): -1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    mo_arg(text): a 1 ""
    bl_clean(p): path
    bl_parent(up): p
    bl_mkdirs(_): fs up
    typeof(tt): text
    if(_): {tt = "vector"} [ bl_write_bytes(r): fs path text ]
    else(_): [ bl_write_text(r): fs path text ]
    mo_sync(_): fs
]

sys_file_exists(r): a [
    set(r): false
    mo_arg(path): a 0 ""
    len(n): path
    if(_): {n > 5} [
        slice(p5): path 0 5
        if(_): {p5 = "/dev/"} [
            bsize(b): path
            set(r): {b >= 0}
            return(r): r
        ]
    ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_exists(r): fs path
]

# is_dir(n): path -> 1 for a directory, else 0, as the hosted ussr
sys_is_dir(r): a [
    set(r): 0
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_is_dir(d): fs path
    if(_): d [ set(r): 1 ]
]

sys_list_dir(r): a [
    set(r): null
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 "/"
    bl_list(names): fs path
    typeof(tn): names
    if(_): {tn != "vector"} [ return(r): r ]
    # folders end with "/", as the hosted ussr gives them
    vec(r): ""
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(name): names i
        concat(full): path "/" name
        bl_is_dir(d): fs full
        if(_): d [ concat(name): name "/" ]
        push(_): r name
        set(i): {i + 1}
    ]
]

sys_make_dir(r): a [
    set(r): -1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_mkdirs(r): fs path
    mo_sync(_): fs
]

# cd(r): path -> 0, or 1 when it is not a directory: the folder getcwd
# answers (file commands take absolute paths; programs such as Tver
# build theirs from getcwd)
sys_cd(r): a [
    set(r): 1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 "/"
    typeof(tp): path
    if(_): {tp != "string"} [ return(r): r ]
    byte(b0): path 0
    if(_): {b0 != 47} [
        set(base): mo_cwd
        if(_): {base = null} [ set(base): "/" ]
        concat(path): base "/" path
    ]
    bl_clean(path): path
    bl_is_dir(d): fs path
    if(_): d [
        set(mo_cwd): path
        set(r): 0
    ]
]

# getcwd(s): -> the folder cd went to, "/" at first
sys_getcwd(r): a [
    set(r): mo_cwd
    if(_): {r = null} [ set(r): "/" ]
]

# copy_file(r): from to -> 0, or 1 when it failed (the hosted ussr's)
sys_copy_file(r): a [
    set(r): 1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(from): a 0 ""
    mo_arg(to): a 1 ""
    bl_exists(e): fs from
    if(_): {e = false} [ return(r): r ]
    bl_is_dir(d): fs from
    if(_): d [ return(r): r ]
    bl_read_bytes(bytes): fs from
    typeof(tb): bytes
    if(_): {tb != "vector"} [ return(r): r ]
    bl_write_bytes(st): fs to bytes
    mo_sync(_): fs
    if(_): {st = 0} [ set(r): 0 ]
]

# remove_dir(r): path -> 0, or 1 (not an empty directory)
sys_remove_dir(r): a [
    set(r): 1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_is_dir(d): fs path
    if(_): {d = false} [ return(r): r ]
    bl_remove(st): fs path
    mo_sync(_): fs
    if(_): {st = 0} [ set(r): 0 ]
]

sys_remove_file(r): a [
    set(r): -1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(path): a 0 ""
    bl_remove(r): fs path
    mo_sync(_): fs
]

sys_df(r): a [
    set(r): 0
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    concat(m): "root: " mo_dev
    print(_): m
    bl_cmd_info(r): fs
]

sys_fsck(r): a [
    set(r): -1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_fsck(r): fs
]

# --- files by handle, as the hosted ussr has them: open_file gives a
# number, read_line, read_file and write_file use it, close_file ends it.
# Reading takes the file's text when it is opened; what is written is
# kept and goes onto the disk when the handle is closed. mo_files maps
# each open handle to a btree of path, write (opened "w" or "a"), text,
# pos and changed; "next" is the next handle.

mo_file(r): h [
    set(r): null
    typeof(th): h
    if(_): {th != "integer"} [ return(r): r ]
    bthas(has): mo_files h
    if(_): has [ btget(r): mo_files h ]
]

# open_file(h): path [mode] -> a handle, or -1 (no such file to read)
sys_open_file(r): a [
    set(r): -1
    mo_arg(path): a 0 ""
    mo_arg(mode): a 1 "r"
    str_find(w): mode "w" 0
    str_find(ap): mode "a" 0
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree" || path = ""} [ return(r): r ]
    bl_is_dir(d): fs path
    if(_): d [ return(r): r ]
    set(text): ""
    if(_): {w < 0} [
        bl_exists(e): fs path
        if(_): e [ bl_read_text(text): fs path ]
        elif(_): {ap < 0} [ return(r): r ]
    ]
    btget(r): mo_files "next"
    btput(_): mo_files "next" {r + 1}
    btree(f):
    btput(_): f "path" path
    btput(_): f "write" {w >= 0 || ap >= 0}
    btput(_): f "text" text
    btput(_): f "pos" 0
    btput(_): f "changed" {w >= 0}
    btput(_): mo_files r f
]

# read_line(s): h -> the next line without its LF (or CR LF), null at
# the end
sys_read_line(r): a [
    set(r): null
    mo_arg(h): a 0 -1
    mo_file(f): h
    typeof(tf): f
    if(_): {tf != "btree"} [ return(r): r ]
    btget(text): f "text"
    btget(pos): f "pos"
    len(n): text
    if(_): {pos >= n} [ return(r): r ]
    str_find(nl): text "\n" pos
    set(next): {nl + 1}
    if(_): {nl < 0} [
        set(nl): n
        set(next): n
    ]
    slice(r): text pos {nl - pos}
    len(k): r
    if(_): {k > 0} [
        byte(last): r {k - 1}
        if(_): {last = 13} [ slice(r): r 0 {k - 1} ]
    ]
    btput(_): f "pos" next
]

# read_file(s): h [n] -> the rest of the file, or its next n bytes
sys_read_file(r): a [
    set(r): null
    mo_arg(h): a 0 -1
    mo_file(f): h
    typeof(tf): f
    if(_): {tf != "btree"} [ return(r): r ]
    btget(text): f "text"
    btget(pos): f "pos"
    len(n): text
    mo_arg(k): a 1 {n - pos}
    if(_): {k > n - pos} [ set(k): {n - pos} ]
    if(_): {k < 0} [ set(k): 0 ]
    slice(r): text pos k
    btput(_): f "pos" {pos + k}
]

# write_file(n): h data -> the bytes written, -1 for no such handle
sys_write_file(r): a [
    set(r): -1
    mo_arg(h): a 0 -1
    mo_file(f): h
    typeof(tf): f
    if(_): {tf != "btree"} [ return(r): r ]
    btget(wr): f "write"
    if(_): {wr = false} [ return(r): r ]
    mo_arg(data): a 1 ""
    typeof(td): data
    if(_): {td != "string"} [ encode(data): data ]
    btget(text): f "text"
    concat(text): text data
    btput(_): f "text" text
    btput(_): f "changed" true
    len(r): data
]

# close_file(ok): h -> 0, or -1 for no such handle or a failed write
sys_close_file(r): a [
    set(r): -1
    mo_arg(h): a 0 -1
    mo_file(f): h
    typeof(tf): f
    if(_): {tf != "btree"} [ return(r): r ]
    btdel(_): mo_files h
    set(r): 0
    btget(changed): f "changed"
    if(_): changed [
        mo_fs(fs):
        typeof(t): fs
        if(_): {t != "btree"} [
            set(r): -1
            return(r): r
        ]
        btget(path): f "path"
        btget(text): f "text"
        bl_clean(p): path
        bl_parent(up): p
        bl_mkdirs(_): fs up
        bl_write_text(r): fs p text
        mo_sync(_): fs
    ]
]

# --- bread, bwrite and bsize: the runtime's on a disk (/dev/hda ...),
# and on any other path inside a file of the root file system, so a
# program keeps a store of pages (Dubna KV) in a file as on the hosted
# ussr

mo_is_dev(r): path [
    set(r): false
    typeof(t): path
    if(_): {t != "string"} [ return(r): r ]
    len(n): path
    if(_): {n > 5} [
        slice(p5): path 0 5
        set(r): {p5 = "/dev/"}
    ]
]

# bread(v): path lba [count [sector]]
sys_bread(r): a [
    set(r): null
    mo_arg(path): a 0 ""
    mo_arg(lba): a 1 0
    mo_arg(count): a 2 1
    mo_arg(sector): a 3 512
    mo_is_dev(d): path
    if(_): d [
        bread(r): path lba count sector
        return(r): r
    ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_pread(r): fs path {lba * sector} {count * sector}
]

# bwrite(n): path lba bytes [sector]
sys_bwrite(r): a [
    set(r): -1
    mo_arg(path): a 0 ""
    mo_arg(lba): a 1 0
    mo_arg(bytes): a 2 null
    mo_arg(sector): a 3 512
    mo_is_dev(d): path
    if(_): d [
        bwrite(r): path lba bytes sector
        return(r): r
    ]
    typeof(tb): bytes
    if(_): {tb != "vector"} [ return(r): r ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_pwrite(r): fs path {lba * sector} bytes
    mo_sync(_): fs
]

# bsize(n): path -> a disk's or a file's size in bytes, -1
sys_bsize(r): a [
    set(r): -1
    mo_arg(path): a 0 ""
    mo_is_dev(d): path
    if(_): d [
        bsize(r): path
        return(r): r
    ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_get(rec): fs path
    typeof(tr): rec
    if(_): {tr = "vector"} [
        at(ty): rec 0
        if(_): {ty = "f"} [ at(r): rec 1 ]
    ]
]

# --- Murmansk, the firewall (src/murmansk)

# the rules in /etc/murmansk.rules; a line saying what came of it
mo_fw_load(r): fs [
    murmansk_reset(_):
    bl_read_text(text): fs "/etc/murmansk.rules"
    typeof(t): text
    set(from): "no /etc/murmansk.rules"
    set(bad): 0
    if(_): {t = "string"} [
        murmansk_load_text(bad): text
        set(from): "/etc/murmansk.rules"
    ]
    btlen(n): mu_rules
    str_from_int(ns): n
    concat(r): "fw:      Murmansk, " ns " rules from " from "; in " mu_in ", out " mu_out
    if(_): {bad > 0} [
        str_from_int(bs): bad
        murmansk_error(why):
        concat(r): r " (" bs " wrong lines left out: " why ")"
    ]
]

# the rules back from text kept before a program ran: what it changed
# lived in its memory, given back now
mo_fw_restore(r): text [
    set(drops): mu_drops
    murmansk_reset(_):
    murmansk_load_text(r): text
    set(mu_drops): drops
]

# fw(s): [command] -> the firewall's report, which it prints. A command
# is a rule to add at the end ("allow in tcp 8080"), "delete N", "policy
# in|out allow|deny", "save" (into /etc/murmansk.rules) or "load".
sys_fw(r): a [
    mo_arg(cmd): a 0 ""
    mu_words(w): cmd
    len(n): w
    set(st): 0
    set(first): ""
    if(_): {n > 0} [ at(first): w 0 ]
    if(_): {first = "delete" && n = 2} [
        at(x): w 1
        mu_number(k): x
        murmansk_delete(st): k
    ]
    elif(_): {first = "save"} [
        murmansk_text(text):
        mo_fs(fs):
        typeof(t): fs
        set(st): -1
        if(_): {t = "btree"} [
            bl_write_text(st): fs "/etc/murmansk.rules" text
            mo_sync(_): fs
        ]
        if(_): {st = 0} [ print(_): "saved in /etc/murmansk.rules" ]
        else(_): [ mu_fail(_): "/etc/murmansk.rules could not be written" ]
    ]
    elif(_): {first = "load"} [
        mo_fs(fs):
        typeof(t): fs
        if(_): {t = "btree"} [
            mo_fw_load(line): fs
            print(_): line
        ]
    ]
    elif(_): {n > 0} [ murmansk_add(st): cmd ]
    if(_): {st != 0} [
        murmansk_error(why):
        concat(m): "fw: " why "\n"
        write_stderr(_): m
    ]
    murmansk_report(r):
    print(_): r
]

# c_load(lib): path -> a C library of the root file system (an ELF shared
# object built freestanding, see arch/amd64/cffi.inc), its number, or
# null; a bare name is looked for in /lib. c_sym, c_call and the others
# are the runtime's.
sys_c_load(r): a [
    set(r): null
    mo_arg(path): a 0 ""
    str_find(slash): path "/" 0
    if(_): {slash < 0} [ concat(path): "/lib/" path ]
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_is_dir(d): fs path
    bl_exists(e): fs path
    if(_): {e = false || d} [ return(r): r ]
    bl_read_bytes(bytes): fs path
    typeof(tb): bytes
    if(_): {tb = "vector"} [ k_elf_load(r): bytes ]
]

# rename_path(r): from to -> 0, 1 when it failed (there is something at
# to already, among other things)
sys_rename_path(r): a [
    set(r): 1
    mo_fs(fs):
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    mo_arg(from): a 0 ""
    mo_arg(to): a 1 ""
    bl_rename(st): fs from to
    if(_): {st = 0} [
        mo_sync(_): fs
        set(r): 0
    ]
]

# localtime(v): [seconds] -> [year month day hour minute second weekday
# yearday] (weekday 0 Sunday, yearday 0 for 1 January); the clock is UTC
sys_localtime(r): a [
    time(now):
    mo_arg(t): a 0 now
    typeof(tt): t
    if(_): {tt != "integer"} [ str_trunc(t): t ]
    str_trunc(days): {t / 86400}
    set(secs): {t - days * 86400}
    if(_): {secs < 0} [
        set(secs): {secs + 86400}
        set(days): {days - 1}
    ]
    # Howard Hinnant's civil_from_days
    set(z): {days + 719468}
    set(era): 0
    if(_): {z >= 0} [ str_trunc(era): {z / 146097} ]
    else(_): [ str_trunc(era): {(z - 146096) / 146097} ]
    set(doe): {z - era * 146097}
    str_trunc(a1): {doe / 1460}
    str_trunc(a2): {doe / 36524}
    str_trunc(a3): {doe / 146096}
    str_trunc(yoe): {(doe - a1 + a2 - a3) / 365}
    str_trunc(b1): {yoe / 4}
    str_trunc(b2): {yoe / 100}
    set(doy): {doe - (365 * yoe + b1 - b2)}
    str_trunc(mp): {(5 * doy + 2) / 153}
    str_trunc(c1): {(153 * mp + 2) / 5}
    set(d): {doy - c1 + 1}
    set(m): {mp + 3}
    if(_): {mp >= 10} [ set(m): {mp - 9} ]
    set(y): {yoe + era * 400}
    if(_): {m <= 2} [ set(y): {y + 1} ]
    # the day of the year
    set(leap): {(y % 4 = 0 && y % 100 != 0) || y % 400 = 0}
    vec(before): ""
    push(_): before 0
    push(_): before 31
    push(_): before 59
    push(_): before 90
    push(_): before 120
    push(_): before 151
    push(_): before 181
    push(_): before 212
    push(_): before 243
    push(_): before 273
    push(_): before 304
    push(_): before 334
    at(yd): before {m - 1}
    set(yd): {yd + d - 1}
    if(_): {leap && m > 2} [ set(yd): {yd + 1} ]
    set(wd): {(days + 4) % 7}
    if(_): {wd < 0} [ set(wd): {wd + 7} ]
    str_trunc(hh): {secs / 3600}
    str_trunc(mi): {(secs - hh * 3600) / 60}
    vec(r): ""
    push(_): r y
    push(_): r m
    push(_): r d
    push(_): r hh
    push(_): r mi
    push(_): r {secs - hh * 3600 - mi * 60}
    push(_): r wd
    push(_): r yd
]

# run(status): name [args ...]: /bin/name.ru (or the path given) from
# the root file system, else a program of the boot image
sys_run(r): a [
    set(r): 127
    len(n): a
    if(_): {n = 0} [
        bl_err(_): "run(status): program [args ...]"
        return(r): r
    ]
    at(name): a 0
    vec(args): ""
    set(i): 1
    while(_): {i < n} [
        at(x): a i
        push(_): args x
        set(i): {i + 1}
    ]
    mo_run(r): name args
]

# the last three bytes of s, "" when it is shorter
mo_ext(r): s [
    set(r): ""
    len(n): s
    if(_): {n > 3} [ slice(r): s {n - 3} 3 ]
]

# Moscow has three runtimes for USSR:
#   1. the native ussr, /bin/ussr, a Linux program (arch/amd64/native.inc)
#   2. the NASM USSR runtime, which runs .ru bytecode (ussr_rt.nasm)
#   3. russia.ru, the USSR interpreter written in USSR, itself on 2
# A .ru runs on 2. A .su is compiled by 1 (ussr -c) and runs on 2, from
# the russia shell too; only when there is no /bin/ussr to compile with
# does it run on 3. "ussr" itself is 1: run(_): "ussr" "a.su" runs a.su
# there, from start to end.

# the .su at path compiled for runtime 2 by runtime 1: [status, bytes,
# missing]: status -1 and bytes null when there is no /bin/ussr to compile
# with, or when the .ru calls a command runtime 2 does not have, missing
# (else ""); otherwise ussr -c's exit status, with the .ru's bytes when it
# is 0
mo_compile(r): fs path [
    vec(r): ""
    set(miss): ""
    set(st): -1
    set(bytes): null
    set(ussr): "/bin/ussr"
    bl_exists(e): fs ussr
    if(_): e [
        bl_read_bytes(ub): fs ussr
        typeof(tu): ub
        set(elf): false
        if(_): {tu = "vector"} [
            len(nb): ub
            if(_): {nb > 3} [
                at(b0): ub 0
                at(b1): ub 1
                set(elf): {b0 = 127 && b1 = 69}
            ]
        ]
        if(_): elf [
            # one task compiles one program at a time: the .ru is read
            # and removed before it runs
            k_task(id):
            str_from_int(ids): id
            concat(out): "/tmp/moscow-" ids ".ru"
            bl_is_dir(td): fs "/tmp"
            if(_): {td = false} [
                bl_mkdirs(_): fs "/tmp"
                mo_sync(_): fs
            ]
            vec(cargs): ""
            push(_): cargs ussr
            push(_): cargs "-c"
            push(_): cargs path
            push(_): cargs out
            k_exec_bytes(st): ub cargs
            k_owner(own):
            set(depth): {own % 64 + 1}
            net_drop(_): id depth
            tls_drop(_): id depth
            gui_drop(_): id depth
            lx_drop(_): id depth
            # ussr wrote the .ru: the root as it is now
            mo_fs(fs2):
            typeof(tf): fs2
            if(_): {tf = "btree"} [
                bl_exists(made): fs2 out
                if(_): made [
                    if(_): {st = 0} [ bl_read_bytes(bytes): fs2 out ]
                    bl_remove(_): fs2 out
                    mo_sync(_): fs2
                ]
            ]
            typeof(tb): bytes
            if(_): {st = 0 && tb != "vector"} [
                bl_err(_): "ussr -c wrote no .ru"
                set(st): 1
                set(bytes): null
            ]
            # a command the NASM runtime does not have (async, say) is for
            # russia.ru, which has more of the language: the load is only
            # checked here, nothing runs
            if(_): {st = 0} [
                k_ru_check(_):
                k_exec_bytes(_): bytes
                k_ru_missing(miss):
                if(_): {miss != ""} [
                    set(st): -1
                    set(bytes): null
                ]
            ]
        ]
    ]
    push(_): r st
    push(_): r bytes
    push(_): r miss
]

# A program: a .ru file runs as it is on runtime 2; a .su is compiled to
# a .ru by /bin/ussr and runs on 2, else through russia.ru (3), which
# reads the source from the disk. A bare name is looked for as
# /bin/name.ru, /bin/name.su and then the project's own src/name/name.su
# under /src/ussr, so run(_): "Mbl" "notes.txt" starts the editor from
# its source.
# Where a program comes from: [path, args, bytes, runtime], runtime 1 for
# a Linux program, 2 or 3; a .su run through russia.ru has its own path
# first in the arguments. Null when it is not on the disk; bytes null
# when it did not compile, and then a fifth item, ussr -c's status.
mo_find(r): name args [
    set(r): null
    set(fs): null
    if(_): {mo_base >= 0} [ mo_fs(fs): ]
    mo_locate(path): fs name
    if(_): {path != ""} [
        mo_ext(ext): path
        set(runtime): 2
        if(_): {ext = ".su"} [
            mo_compile(made): fs path
            at(cst): made 0
            at(cbytes): made 1
            if(_): {cst > 0} [
                # it does not compile: ussr said why, and russia would too
                vec(r): ""
                push(_): r path
                push(_): r args
                push(_): r null
                push(_): r 2
                push(_): r cst
                return(r): r
            ]
            if(_): {cst = 0} [
                vec(r): ""
                push(_): r path
                push(_): r args
                push(_): r cbytes
                push(_): r 2
                return(r): r
            ]
            set(runtime): 3
            # russia.ru path args ...
            vec(rargs): ""
            push(_): rargs path
            len(na): args
            set(i): 0
            while(_): {i < na} [
                at(x): args i
                push(_): rargs x
                set(i): {i + 1}
            ]
            set(args): rargs
            set(path): "/bin/russia.ru"
            bl_exists(e): fs path
            if(_): {e = false} [ set(path): "/boot/russia.ru" ]
        ]
        bl_read_bytes(bytes): fs path
        typeof(tb): bytes
        if(_): {tb = "vector"} [
            # a Linux program has its path as argv[0]
            mo_is_elf(elf): bytes
            if(_): elf [
                set(runtime): 1
                vec(rargs): ""
                push(_): rargs path
                len(na): args
                set(i): 0
                while(_): {i < na} [
                    at(x): args i
                    push(_): rargs x
                    set(i): {i + 1}
                ]
                set(args): rargs
            ]
            vec(r): ""
            push(_): r path
            push(_): r args
            push(_): r bytes
            push(_): r runtime
        ]
    ]
]

mo_is_elf(r): bytes [
    set(r): false
    len(nb): bytes
    if(_): {nb > 3} [
        at(b0): bytes 0
        at(b1): bytes 1
        set(r): {b0 = 127 && b1 = 69}
    ]
]

# runtime(r): name -> which runtime run(_) gives the program: 1 the native
# ussr (a Linux program), 2 the NASM runtime (a .ru, or a .su that
# /bin/ussr compiles), 3 russia.ru (a .su with no /bin/ussr, or one
# calling a command 2 does not have), 0 none. A .su is compiled to know.
sys_runtime(r): a [
    set(r): 0
    mo_arg(name): a 0 ""
    if(_): {mo_base < 0 || name = ""} [ return(r): r ]
    mo_fs(fs):
    mo_locate(path): fs name
    if(_): {path = ""} [ return(r): r ]
    mo_ext(ext): path
    set(r): 2
    if(_): {ext = ".su"} [
        # as run(_) does it: compiled and checked, so this is what it gets
        mo_compile(made): fs path
        at(cst): made 0
        set(r): 2
        if(_): {cst < 0} [ set(r): 3 ]
        return(r): r
    ]
    bl_read_bytes(bytes): fs path
    typeof(tb): bytes
    if(_): {tb = "vector"} [
        mo_is_elf(elf): bytes
        if(_): elf [ set(r): 1 ]
    ]
]

# the path of a program on the root, "" when it is not there
mo_locate(r): fs name [
    set(r): ""
    vec(tries): ""
    str_find(slash): name "/" 0
    mo_ext(ext): name
    if(_): {slash >= 0} [ push(_): tries name ]
    elif(_): {ext = ".ru" || ext = ".su"} [
        concat(p): "/bin/" name
        push(_): tries p
    ]
    else(_): [
        concat(p): "/bin/" name ".ru"
        push(_): tries p
        concat(p): "/bin/" name ".su"
        push(_): tries p
        # a Linux program
        concat(p): "/bin/" name
        push(_): tries p
        # the boot image's programs: "russia" is the shell, not russia.su
        # run by itself
        concat(p): "/boot/" name ".ru"
        push(_): tries p
        concat(p): "/src/ussr/src/" name "/" name ".su"
        push(_): tries p
    ]
    if(_): {fs = null} [ return(r): r ]
    len(nt): tries
    set(i): 0
    while(_): {i < nt && r = ""} [
        at(p): tries i
        set(d): true
        bl_exists(e): fs p
        if(_): e [ bl_is_dir(d): fs p ]
        if(_): {e && d = false} [ set(r): p ]
        set(i): {i + 1}
    ]
]

# what a found program that did not compile gives: ussr -c's status, else 0
mo_unbuilt(r): found [
    set(r): 0
    at(bytes): found 2
    typeof(tb): bytes
    if(_): {tb != "vector"} [
        set(r): 1
        len(n): found
        if(_): {n > 4} [ at(r): found 4 ]
    ]
]

mo_run(r): name args [
    set(r): 127
    mo_find(found): name args
    typeof(tf): found
    if(_): {tf = "vector"} [
        mo_unbuilt(bad): found
        if(_): {bad != 0} [
            set(r): bad
            return(r): r
        ]
        at(args): found 1
        at(bytes): found 2
        k_exec_bytes(r): bytes args
        # what the program run made goes with it: its sockets, windows,
        # TLS credentials (k_owner is the running program's again)
        k_owner(own):
        k_task(id):
        set(depth): {own % 64 + 1}
        net_drop(_): id depth
        tls_drop(_): id depth
        gui_drop(_): id depth
        lx_drop(_): id depth
        return(r): r
    ]
    # not on the disk: the boot image has russia.ru and moscow.ru
    len(na): args
    if(_): {na = 0} [ k_exec(r): name ]
    else(_): [
        concat(m): name ": no such program in /bin"
        bl_err(r): m
        set(r): 127
    ]
]

# --- tasks: programs side by side (arch/amd64/task.inc)

# __task_ended: id -> the runtime's call when a task ends or is killed:
# what it had in the kernel goes
mo_task_ended(r): a [
    set(r): 0
    mo_arg(id): a 0 -1
    if(_): {id <= 0} [ return(r): r ]
    net_drop(_): id 0
    tls_drop(_): id 0
    gui_drop(_): id 0
    lx_drop(_): id 0
]

# spawn(id): name [args ...] -> a task running the program next to the
# shell, in an address space of its own; its id, or -1
sys_spawn(r): a [
    set(r): -1
    len(n): a
    if(_): {n = 0} [
        bl_err(_): "spawn(id): program [args ...]"
        return(r): r
    ]
    at(name): a 0
    vec(args): ""
    set(i): 1
    while(_): {i < n} [
        at(x): a i
        typeof(tx): x
        if(_): {tx != "string"} [ str_from_number(x): x 6 ]
        push(_): args x
        set(i): {i + 1}
    ]
    mo_find(found): name args
    typeof(tf): found
    if(_): {tf != "vector"} [
        concat(m): name ": no such program"
        bl_err(_): m
        return(r): r
    ]
    mo_unbuilt(bad): found
    if(_): {bad != 0} [ return(r): r ]
    at(fargs): found 1
    at(bytes): found 2
    k_spawn(r): bytes fargs name
    if(_): {r < 0} [ bl_err(_): "spawn: no room for another task" ]
    else(_): [
        str_from_int(ids): r
        concat(m): "[" ids "] " name
        print(_): m
    ]
]

# tasks(v): -> [[id, name, state, cpu ms, KiB], ...], and prints them
sys_tasks(r): a [
    k_tasks(r):
    print(_): "   ID  STATE       CPU ms     KiB  NAME"
    len(n): r
    set(i): 0
    while(_): {i < n} [
        at(t): r i
        at(id): t 0
        at(nm): t 1
        at(st): t 2
        at(ms): t 3
        at(kb): t 4
        str_from_int(ids): id
        str_from_int(mss): ms
        str_from_int(kbs): kb
        mo_pad(ids): ids 5
        mo_pad_right(st): st 10
        mo_pad(mss): mss 8
        mo_pad(kbs): kbs 8
        concat(line): ids "  " st mss kbs "  " nm
        print(_): line
        set(i): {i + 1}
    ]
]

# s padded on the left to width
mo_pad(r): s width [
    set(r): s
    len(n): r
    while(_): {n < width} [
        concat(r): " " r
        set(n): {n + 1}
    ]
]

# s padded on the right to width
mo_pad_right(r): s width [
    set(r): s
    len(n): r
    while(_): {n < width} [
        concat(r): r " "
        set(n): {n + 1}
    ]
]

# kill(r): id -> 0 when the task is ended, -1 when there is none
sys_kill(r): a [
    mo_arg(id): a 0 -1
    k_kill(r): id
    if(_): {r < 0} [
        str_from_int(ids): id
        concat(m): "kill: no task " ids " to end (task 0 is the kernel's)"
        bl_err(_): m
    ]
]

# wait(status): id -> waits for the task to end: its status, or -1
sys_wait(r): a [
    mo_arg(id): a 0 -1
    k_wait(r): id
]

# fg(status): id -> the task gets the console until it ends: its status;
# Ctrl-C ends it (130), Ctrl-Z gives the console back with the task
# still running (-2); -1 when there is none
sys_fg(r): a [
    mo_arg(id): a 0 -1
    k_fg(r): id
    if(_): {r = -2} [
        str_from_int(ids): id
        concat(m): "[" ids "] goes on in the background"
        print(_): m
    ]
    if(_): {r = -1} [
        str_from_int(ids): id
        concat(m): "fg: no task " ids " to give the console to"
        bl_err(_): m
    ]
]

# prio(old): id n -> the task's slice is n ticks (1 .. 20): next to tasks
# that never wait it gets n times the CPU of one at 1; the old slice
sys_prio(r): a [
    mo_arg(id): a 0 -1
    mo_arg(n): a 1 1
    k_prio(r): id n
    if(_): {r < 0} [
        str_from_int(ids): id
        concat(m): "prio: no task " ids
        bl_err(_): m
    ]
]

# limit(old): id kib -> the task may have this much memory of its own (0:
# no limit); over it, it ends; the old limit
sys_limit(r): a [
    mo_arg(id): a 0 -1
    mo_arg(kib): a 1 0
    k_limit(r): id kib
    if(_): {r < 0} [
        str_from_int(ids): id
        concat(m): "limit: no task " ids " (task 0 has none)"
        bl_err(_): m
    ]
]

# install(status): [args ...] runs the installer, /bin/install.ru
sys_install(r): a [
    mo_run(r): "/bin/install.ru" a
]

sys_help(r): a [
    set(r): 0
    print(_): "Moscow kernel commands (USSR commands; each prints and returns):"
    print(_): "  help(_):                this list"
    print(_): "  ls(_): [path]           a directory of the root file system"
    print(_): "  tree(_): [path]         everything under a path"
    print(_): "  cat(_): path            a file's text"
    print(_): "  readfile(s): path       a file as a string; writefile(r): path text"
    print(_): "  make_dir(r): path       remove_file(r): path   file_exists(b): path"
    print(_): "  run(status): name ...   /bin/name.ru (stalin, belarus, install, ...), a .su"
    print(_): "                          compiled: run(_): \"Mbl\" \"/home/notes.txt\" edits"
    print(_): "  runtime(r): name        what runs it: 1 /bin/ussr, 2 NASM (a .ru, or a .su"
    print(_): "                          /bin/ussr -c compiles), 3 russia.ru (no /bin/ussr)"
    print(_): "  open_file(h): path mode read_line(s): h write_file(n): h text close_file(r): h"
    print(_): "  install(status):        install USSR onto another disk"
    print(_): "  spawn(id): name ...     the program as a task of its own, next to the shell"
    print(_): "  tasks(_):  kill(r): id  wait(status): id   the tasks, ending one, its end"
    print(_): "  fg(status): id          the console to a task (Ctrl-C ends it, Ctrl-Z: back)"
    print(_): "  prio(old): id n  limit(old): id kib   its slice (1 .. 20 ticks), its memory"
    print(_): "  df(_):  fsck(_):        the root file system, its free space, a check"
    print(_): "  uptime(_): mem(_): cpu(_): uname(_): pwd(_): clear(_): color(_): fg bg"
    print(_): "  net(_): ping(n): host   the network card and address; ICMP echo"
    print(_): "  fw(s): [rule|delete N|policy in|out allow|deny|save|load]  Murmansk, the firewall"
    print(_): "  socket_tcp bind listen accept recv send close connect, wait_readable"
    print(_): "  run(_): \"kremlin\"      the desktop; Petersburg windows (gui.su), gui(s): [WxH]"
    print(_): "  launch(r): prog [params]  terminal_open(t): canvas  terminal_run(st): t [prog]"
    print(_): "  reboot(_): halt(_):     restart or stop the machine (Ctrl-D halts too)"
]

mo_syscalls(r): [
    set(r): 0
    k_syscall(_): "help" "sys_help"
    k_syscall(_): "ls" "sys_ls"
    k_syscall(_): "tree" "sys_tree"
    k_syscall(_): "cat" "sys_cat"
    k_syscall(_): "readfile" "sys_readfile"
    k_syscall(_): "writefile" "sys_writefile"
    k_syscall(_): "file_exists" "sys_file_exists"
    k_syscall(_): "is_dir" "sys_is_dir"
    k_syscall(_): "list_dir" "sys_list_dir"
    k_syscall(_): "make_dir" "sys_make_dir"
    k_syscall(_): "remove_file" "sys_remove_file"
    k_syscall(_): "run" "sys_run"
    k_syscall(_): "runtime" "sys_runtime"
    k_syscall(_): "install" "sys_install"
    k_syscall(_): "spawn" "sys_spawn"
    k_syscall(_): "tasks" "sys_tasks"
    k_syscall(_): "kill" "sys_kill"
    k_syscall(_): "wait" "sys_wait"
    k_syscall(_): "fg" "sys_fg"
    k_syscall(_): "prio" "sys_prio"
    k_syscall(_): "limit" "sys_limit"
    k_syscall(_): "__task_ended" "mo_task_ended"
    k_syscall(_): "__linux" "sys_linux"
    k_syscall(_): "df" "sys_df"
    k_syscall(_): "fsck" "sys_fsck"
    k_syscall(_): "open_file" "sys_open_file"
    k_syscall(_): "read_line" "sys_read_line"
    k_syscall(_): "read_file" "sys_read_file"
    k_syscall(_): "write_file" "sys_write_file"
    k_syscall(_): "close_file" "sys_close_file"
    k_syscall(_): "rename_path" "sys_rename_path"
    k_syscall(_): "copy_file" "sys_copy_file"
    k_syscall(_): "cd" "sys_cd"
    k_syscall(_): "getcwd" "sys_getcwd"
    k_syscall(_): "remove_dir" "sys_remove_dir"
    k_syscall(_): "localtime" "sys_localtime"
    k_syscall(_): "bread" "sys_bread"
    k_syscall(_): "bwrite" "sys_bwrite"
    k_syscall(_): "bsize" "sys_bsize"
    k_syscall(_): "fw" "sys_fw"
    k_syscall(_): "c_load" "sys_c_load"
    tls_syscalls(_):
    net_syscalls(_):
    gui_syscalls(_):
]

# true when a key comes within ticks (100 a second); it is taken
mo_key_within(r): ticks [
    set(r): false
    k_ticks(now):
    set(until): {now + ticks}
    while(_): {now < until} [
        terminal_key_ready(k):
        if(_): k [
            terminal_raw(_):
            terminal_getch(_):
            terminal_sane(_):
            set(r): true
            return(r): r
        ]
        sleep(_): 20
        k_ticks(now):
    ]
]

init(ret): arg_cnt arg_vec [
    k_color(_): 14 1
    print(_): "USSR Moscow kernel for amd64"
    k_color(_): 7 0
    k_cpu(cpu):
    concat(line): "cpu:     " cpu
    print(_): line
    k_mem(m):
    at(total): m 0
    at(free): m 1
    mo_kb(ts): total
    mo_kb(fs): free
    concat(line): "heap:    " ts ", " fs " free"
    print(_): line
    k_modules(mods):
    len(n): mods
    set(list): ""
    set(i): 0
    while(_): {i < n} [
        at(name): mods i
        if(_): {i > 0} [ concat(list): list " " ]
        concat(list): list name
        set(i): {i + 1}
    ]
    concat(line): "image:   " list
    print(_): line
    bdevices(devs):
    len(nd): devs
    set(i): 0
    while(_): {i < nd} [
        at(d): devs i
        at(dev): d 0
        at(bytes): d 1
        at(model): d 4
        str_trunc(mib): {bytes / 1048576}
        str_from_int(sm): mib
        concat(line): "disk:    " dev ", " sm " MiB, " model
        print(_): line
        set(i): {i + 1}
    ]
    # in deny, out allow until the rules come from the disk
    murmansk_reset(_):
    net_start(netok):
    net_describe(nd):
    concat(line): "net:     " nd
    print(_): line
    mo_find_root(found):
    if(_): found [
        mo_fs(root):
        btget(label): root "label"
        str_from_int(sb): mo_base
        concat(line): "root:    " mo_dev " from sector " sb ", Belarus '" label "'"
        print(_): line
        mo_fw_load(fwline): root
        print(_): fwline
        tls_start(tlsok): root
        if(_): tlsok [ print(_): "tls:     BearSSL from /lib/tls.so" ]
        else(_): [ print(_): "tls:     none (no /lib/tls.so)" ]
        gui_start(guiok): root
        if(_): guiok [
            str_from_int(gw): gui_width
            str_from_int(gh): gui_height
            concat(line): "gui:     Petersburg from /lib/gui.so, " gw "x" gh
            if(_): gui_desktop [ concat(line): line ", the desktop at boot" ]
            print(_): line
        ]
        else(_): [ print(_): "gui:     none (no /lib/gui.so)" ]
        bl_read_text(host): root "/etc/hostname"
        typeof(th): host
        if(_): {th = "string"} [
            str_trim(host): host
            if(_): {host != ""} [ setenv(_): "HOSTNAME" host ]
        ]
        # the installer copies from here
        setenv(_): "USSR_ROOT" mo_dev
        # what programs look for: the system's name (Windows says
        # Windows_NT here), the home folder, the USSR source
        setenv(_): "OS" "Moscow"
        getenv(home): "HOME"
        if(_): {home = null} [ setenv(_): "HOME" "/home" ]
        bl_is_dir(hassrc): root "/src/ussr/src"
        if(_): hassrc [ setenv(_): "USSR_HOME" "/src/ussr" ]
        str_from_int(sb): mo_base
        setenv(_): "USSR_ROOT_SECTOR" sb
        bl_read_text(motd): root "/etc/motd"
        typeof(tm): motd
        if(_): {tm = "string"} [ print_raw(_): motd ]
    ]
    else(_): [
        print(_): "root:    no Belarus file system on the disks; the boot image only"
    ]
    btree(mo_files):
    lx_init(_):
    btput(_): mo_files "next" 3
    set(mo_cwd): "/"
    mo_syscalls(_):
    set(ret): 0
    # an installed system starts with the desktop, the shell after it;
    # a key within 3 seconds (the keyboard or the serial line) skips it
    if(_): {gui_desktop && gui_lib != null} [
        print(_): "moscow: the desktop, Kremlin, in 3 seconds (a key: the shell)"
        mo_key_within(skip): 300
        if(_): skip [ print(_): "moscow: no desktop" ]
        else(_): [
            print(_): "moscow: starting the desktop, Kremlin"
            vec(noargs): ""
            mo_run(_): "kremlin" noargs
        ]
    ]
    set(go): true
    while(_): go [
        print(_): "moscow: starting russia.ru"
        k_exec(status): "russia.ru"
        # what the shell's run made goes with it
        net_drop(_): 0 1
        tls_drop(_): 0 1
        gui_drop(_): 0 1
        lx_drop(_): 0 1
        if(_): {status = 0} [ set(go): false ]
        else(_): [
            str_from_int(ss): status
            concat(line): "moscow: russia.ru failed with status " ss "; restarting"
            print(_): line
        ]
    ]
    print(_): "moscow: the shell has exited; system halted"
    k_halt(_):
]
