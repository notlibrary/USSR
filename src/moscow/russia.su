# russia.su - Russia, the shell of the Moscow kernel.
#
# Moscow (moscow.su) runs this program as russia.ru with k_exec when the
# machine boots: it reads command lines from the console (the keyboard
# and the first serial port) and runs them. The name is the same as the
# self-hosted interpreter in src/russia, and the job is the same at a
# smaller scale: the hosted Russia interprets USSR, this one interprets
# the shell's commands on bare metal, on the NASM USSR runtime
# (arch/amd64/ussr_rt.nasm).
#
# The k_* commands are the runtime's kernel services (see README.md):
#   k_getline(line):            -> one line from the console, without its end
#   k_prompt(_): text           -> text on the console, no line end
#   k_clear(_):               -> blank screen, cursor home
#   k_color(_): fg bg           -> VGA text colours (0..15) for what follows
#   k_ticks(n):                 -> timer ticks since boot (100 per second)
#   k_mem(v):                   -> [total free] heap bytes
#   k_cpu(s):                   -> the CPU vendor and brand
#   k_modules(v):               -> names of the files in the boot image
#   k_exec(status): name        -> runs a .ru file of the image; its status
#   k_reboot(_): / k_halt(_):   -> reset the machine / stop it
$include "../libs/strings.su"

# Splits a line into words at runs of spaces and tabs.
sh_words(r): line [
    vec(r): ""
    len(n): line
    set(i): 0
    set(from): {0 - 1}
    while(_): {i <= n} [
        set(b): 32
        if(_): {i < n} [ byte(b): line i ]
        if(_): {b = 32 || b = 9} [
            if(_): {from >= 0} [
                slice(word): line from {i - from}
                push(_): r word
                set(from): {0 - 1}
            ]
        ]
        elif(_): {from < 0} [ set(from): i ]
        set(i): {i + 1}
    ]
]

# The words from index i on, joined by single spaces.
sh_rest(r): words i [
    set(r): ""
    len(n): words
    while(_): {i < n} [
        at(w): words i
        if(_): {r = ""} [ set(r): w ] else(_): [ concat(r): r " " w ]
        set(i): {i + 1}
    ]
]

# Shell variables live in two vectors (no maps in this runtime yet):
# sh_names and sh_values in the hash namespace, index for index.
sh_var_index(r): name [
    set(names): sh_names?
    len(n): names
    set(r): {0 - 1}
    set(i): 0
    while(_): {i < n && r < 0} [
        at(k): names i
        if(_): {k = name} [ set(r): i ]
        set(i): {i + 1}
    ]
]

sh_var_get(r): name [
    sh_var_index(i): name
    set(r): ""
    if(_): {i >= 0} [
        set(values): sh_values?
        at(r): values i
    ]
]

sh_var_set(r): name value [
    set(r): 0
    set(names): sh_names?
    set(values): sh_values?
    sh_var_index(i): name
    if(_): {i < 0} [
        push(_): names name
        push(_): values value
    ]
    else(_): [
        # vectors have no element store: rebuild the values
        vec(fresh): ""
        len(n): values
        set(k): 0
        while(_): {k < n} [
            at(v): values k
            if(_): {k = i} [ set(v): value ]
            push(_): fresh v
            set(k): {k + 1}
        ]
        set(sh_values): fresh!
    ]
]

sh_is_name_byte(r): b [
    set(r): {(b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b = 95}
]

# $NAME in text replaced by the variable's value ("" when it is unset).
sh_expand(r): text [
    set(r): ""
    len(n): text
    set(i): 0
    set(from): 0
    while(_): {i < n} [
        byte(b): text i
        if(_): {b = 36} [
            set(j): {i + 1}
            set(go): {j < n}
            while(_): go [
                byte(c): text j
                sh_is_name_byte(ok): c
                if(_): ok [
                    set(j): {j + 1}
                    set(go): {j < n}
                ]
                else(_): [ set(go): false ]
            ]
            if(_): {j > i + 1} [
                slice(run): text from {i - from}
                slice(name): text {i + 1} {j - i - 1}
                sh_var_get(value): name
                concat(r): r run value
                set(from): j
                set(i): {j - 1}
            ]
        ]
        set(i): {i + 1}
    ]
    slice(run): text from {n - from}
    concat(r): r run
]

# --- calc: integer expressions ------------------------------------------
# Tokens are strings: numbers, and the operators + - * / % ( ). / and %
# are integer division and remainder (toward zero), as in C.

sh_calc_tokens(r): text [
    vec(r): ""
    len(n): text
    set(i): 0
    while(_): {i < n} [
        byte(b): text i
        if(_): {b >= 48 && b <= 57} [
            set(j): i
            set(go): true
            while(_): go [
                set(j): {j + 1}
                set(go): false
                if(_): {j < n} [
                    byte(c): text j
                    set(go): {c >= 48 && c <= 57}
                ]
            ]
            slice(t): text i {j - i}
            push(_): r t
            set(i): j
        ]
        else(_): [
            if(_): {b != 32 && b != 9} [
                chr(t): b
                push(_): r t
            ]
            set(i): {i + 1}
        ]
    ]
]

# The calculator's state: sh_ctoks (tokens), sh_cpos (next token),
# sh_cerr ("" or what went wrong).
sh_calc_peek(r): [
    set(toks): sh_ctoks?
    set(pos): sh_cpos?
    len(n): toks
    set(r): ""
    if(_): {pos < n} [ at(r): toks pos ]
]

sh_calc_next(r): [
    sh_calc_peek(r):
    set(pos): sh_cpos?
    set(sh_cpos): {pos + 1}!
]

sh_calc_fail(r): why [
    set(err): sh_cerr?
    if(_): {err = ""} [ set(sh_cerr): why! ]
    set(r): 0
]

sh_calc_primary(r): [
    set(r): 0
    sh_calc_next(t):
    if(_): {t = "("} [
        sh_calc_sum(r):
        sh_calc_next(close):
        if(_): {close != ")"} [ sh_calc_fail(_): "missing )" ]
    ]
    elif(_): {t = "-"} [
        sh_calc_primary(v):
        set(r): {0 - v}
    ]
    elif(_): {t = ""} [ sh_calc_fail(_): "unexpected end" ]
    else(_): [
        byte(b): t 0
        if(_): {b >= 48 && b <= 57} [ str_to_number(r): t ]
        else(_): [
            concat(why): "unexpected " t
            sh_calc_fail(_): why
        ]
    ]
]

sh_calc_product(r): [
    sh_calc_primary(r):
    set(go): true
    while(_): go [
        sh_calc_peek(op):
        set(go): {op = "*" || op = "/" || op = "%"}
        if(_): go [
            sh_calc_next(_):
            sh_calc_primary(v):
            if(_): {op = "*"} [ set(r): {r * v} ]
            elif(_): {v = 0} [
                sh_calc_fail(_): "division by zero"
                set(go): false
            ]
            elif(_): {op = "/"} [
                # truncate the exact quotient toward zero
                set(q): {(r - r % v) / v}
                str_trunc(r): q
            ]
            else(_): [ set(r): {r % v} ]
        ]
    ]
]

sh_calc_sum(r): [
    sh_calc_product(r):
    set(go): true
    while(_): go [
        sh_calc_peek(op):
        set(go): {op = "+" || op = "-"}
        if(_): go [
            sh_calc_next(_):
            sh_calc_product(v):
            if(_): {op = "+"} [ set(r): {r + v} ] else(_): [ set(r): {r - v} ]
        ]
    ]
]

# The value of an integer expression, or the reason it has none.
sh_calc(r): text [
    sh_calc_tokens(toks): text
    set(sh_ctoks): toks!
    set(sh_cpos): 0!
    set(sh_cerr): ""!
    sh_calc_sum(v):
    sh_calc_peek(rest):
    if(_): {rest != ""} [
        concat(why): "unexpected " rest
        sh_calc_fail(_): why
    ]
    set(err): sh_cerr?
    if(_): {err = ""} [ str_from_int(r): v ]
    else(_): [ concat(r): "calc: " err ]
]

# --- commands -------------------------------------------------------------

sh_help(r): [
    print(_): "Russia, the Moscow shell. Commands:"
    print(_): "  help                 this list"
    print(_): "  echo TEXT            print TEXT ($NAME is a variable)"
    print(_): "  set NAME VALUE       set a shell variable; env lists them"
    print(_): "  calc EXPR            integer arithmetic: + - * / % ( )"
    print(_): "  clear                clear the screen"
    print(_): "  color FG BG          text colours, 0..15"
    print(_): "  mem                  heap size and free bytes"
    print(_): "  uptime               seconds since boot"
    print(_): "  cpu                  the processor"
    print(_): "  ls                   files in the boot image"
    print(_): "  run FILE             run a .ru file of the image"
    print(_): "  history              lines typed so far"
    print(_): "  uname                system name"
    print(_): "  exit                 leave the shell (Moscow halts)"
    print(_): "  reboot / halt        reset or stop the machine"
    set(r): 0
]

sh_kb(r): bytes [
    str_trunc(kb): {bytes / 1024}
    str_from_int(r): kb
    concat(r): r " KiB"
]

# Runs one command line; false when the shell should end.
sh_run(r): line [
    set(r): true
    sh_words(words): line
    len(n): words
    if(_): {n = 0} [ return(_): r ]
    at(cmd): words 0
    sh_rest(args): words 1
    sh_expand(args): args
    if(_): {cmd = "help"} [ sh_help(_): ]
    elif(_): {cmd = "echo"} [ print(_): args ]
    elif(_): {cmd = "set"} [
        if(_): {n < 2} [ print(_): "usage: set NAME VALUE" ]
        else(_): [
            at(name): words 1
            sh_rest(value): words 2
            sh_expand(value): value
            sh_var_set(_): name value
        ]
    ]
    elif(_): {cmd = "env"} [
        set(names): sh_names?
        set(values): sh_values?
        len(vn): names
        set(i): 0
        while(_): {i < vn} [
            at(k): names i
            at(v): values i
            concat(out): k "=" v
            print(_): out
            set(i): {i + 1}
        ]
    ]
    elif(_): {cmd = "calc"} [
        sh_calc(out): args
        print(_): out
    ]
    elif(_): {cmd = "clear"} [ k_clear(_): ]
    elif(_): {cmd = "color"} [
        if(_): {n != 3} [ print(_): "usage: color FG BG (0..15)" ]
        else(_): [
            at(fs): words 1
            at(bs): words 2
            str_to_number(fg): fs
            str_to_number(bg): bs
            k_color(_): fg bg
        ]
    ]
    elif(_): {cmd = "mem"} [
        k_mem(m):
        at(total): m 0
        at(free): m 1
        sh_kb(ts): total
        sh_kb(fs): free
        concat(out): "heap " ts ", free " fs
        print(_): out
    ]
    elif(_): {cmd = "uptime"} [
        k_ticks(t):
        str_trunc(s): {t / 100}
        str_from_int(ss): s
        concat(out): "up " ss " s"
        print(_): out
    ]
    elif(_): {cmd = "cpu"} [
        k_cpu(c):
        print(_): c
    ]
    elif(_): {cmd = "ls"} [
        k_modules(mods):
        len(mn): mods
        set(i): 0
        while(_): {i < mn} [
            at(m): mods i
            print(_): m
            set(i): {i + 1}
        ]
    ]
    elif(_): {cmd = "run"} [
        if(_): {n != 2} [ print(_): "usage: run FILE" ]
        else(_): [
            at(file): words 1
            k_exec(status): file
            str_from_int(ss): status
            concat(out): file " exited with " ss
            print(_): out
        ]
    ]
    elif(_): {cmd = "history"} [
        set(h): sh_history?
        len(hn): h
        set(i): 0
        while(_): {i < hn} [
            at(e): h i
            str_from_int(num): {i + 1}
            concat(out): "  " num "  " e
            print(_): out
            set(i): {i + 1}
        ]
    ]
    elif(_): {cmd = "uname"} [ print(_): "USSR Moscow amd64" ]
    elif(_): {cmd = "exit"} [ set(r): false ]
    elif(_): {cmd = "reboot"} [ k_reboot(_): ]
    elif(_): {cmd = "halt"} [ k_halt(_): ]
    else(_): [
        concat(out): cmd ": command not found (try help)"
        print(_): out
    ]
]

init(ret): arg_cnt arg_vec [
    vec(names): ""
    set(sh_names): names!
    vec(values): ""
    set(sh_values): values!
    vec(h): ""
    set(sh_history): h!
    sh_var_set(_): "SHELL" "russia"
    sh_var_set(_): "OS" "moscow"
    print(_): "Russia shell. Type help for the commands."
    set(go): true
    while(_): go [
        k_prompt(_): "russia> "
        k_getline(line):
        str_trim(line): line
        if(_): {line != ""} [
            set(h): sh_history?
            push(_): h line
        ]
        sh_run(go): line
    ]
    print(_): "bye"
    set(ret): 0
]
