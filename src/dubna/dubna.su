        socket_close(_): s
        concat(msg): "dubna: could not connect to " host ":" port_text
        dubna_fail(r): msg
        return(r): r
    ]
    vec(inbuf): ""
    vec(params): ""
    vec(notices): ""
    new(c): "DubnaConn" s false inbuf 0 params "I" 0 0 true notices
    tls_backend(backend):
    if(_): {sslmode != "disable" && sslmode != "allow" && backend != "none"} [
        dubna_ssl_request(m):
        dubna_send(sent): c m
        set(answer): null
        set(tries): 0
        while(_): {answer = null && sent = 0 && tries < 100} [
            wait_readable(_): s
            socket_recv_bytes(answer): s 1
            add(tries): tries 1
        ]
        if(_): {answer = null} [
            vec(answer): ""
        ]
        set(a): 0
        len(an): answer
        if(_): {an = 1} [
            at(a): answer 0
        ]
        if(_): {a = 83} [
            tls_client(started): s host
            set(shaken): {0 - 1}
            if(_): {started = 0} [
                ryazan_handshake(shaken): s
