dubna_password_message(r): text [
    vec(body): ""
    dubna_put_cstr(_): body text
    dubna_message(r): "p" body
]

# Runs the server's authentication exchange: "" once it says AuthenticationOk,
# else why not.
dubna_authenticate(r): c user password [
    set(r): ""
    set(expect): ""
    set(client_first): ""
    while(_): {true} [
        dubna_read(msg): c
        if(_): {msg = null} [
            set(r): "dubna: the server closed the connection during login"
            return(r): r
        ]
        at(type): msg 0
        at(body): msg 1
        if(_): {type = "E"} [
            dubna_error_text(text): body null
            concat(r): "dubna: " text
            return(r): r
        ]
        if(_): {type != "R"} [
            concat(r): "dubna: unexpected message " type " during login"
            return(r): r
        ]
        dubna_int32(code): body 0
        if(_): {code = 0} [
            if(_): {expect != ""} [
                set(r): "dubna: the server skipped its SCRAM signature"
            ]
            return(r): r
        ]
        if(_): {code = 3 || code = 5 || code = 10} [
            if(_): {password = ""} [
                set(r): "dubna: the server wants a password and none was given"
                return(r): r
            ]
        ]
        if(_): {code = 3} [
            dubna_password_message(m): password
            dubna_send(_): c m
        ]
        elif(_): {code = 5} [
            dubna_vslice(salt): body 4 4
            dubna_md5_password(answer): user password salt
            dubna_password_message(m): answer
            dubna_send(_): c m
        ]
        elif(_): {code = 10} [
            # mechanism names, each zero-terminated, then a zero
            len(n): body
            set(i): 4
            set(found): false
            while(_): {i < n} [
                dubna_zero(j): body i
                if(_): {j = i} [
                    break(_): ""
                ]
                bytes_text(mech): body i {j - i}
                if(_): {mech = "SCRAM-SHA-256"} [
                    set(found): true
                ]
                set(i): {j + 1}
            ]
            if(_): {found = false} [
                set(r): "dubna: the server offers no SASL mechanism Dubna knows (it speaks SCRAM-SHA-256)"
                return(r): r
            ]
            dubna_nonce(nonce):
            # PostgreSQL takes the user from the startup message
            dubna_scram_first(client_first): "" nonce
            concat(first): "n,," client_first
            text_bytes(first_bytes): first
            len(fl): first_bytes
            vec(sb): ""
            dubna_put_cstr(_): sb "SCRAM-SHA-256"
            dubna_put_int32(_): sb fl
            dubna_put_bytes(_): sb first_bytes
            dubna_message(m): "p" sb
            dubna_send(_): c m
        ]
        elif(_): {code = 11} [
            len(n): body
            bytes_text(server_first): body 4 {n - 4}
            dubna_scram_final(final): password client_first server_first
            if(_): {final = null} [
                set(r): "dubna: the server's SCRAM message is malformed"
                return(r): r
            ]
            at(client_final): final 0
            at(expect): final 1
            text_bytes(fb): client_final
            vec(sb): ""
            dubna_put_bytes(_): sb fb
            dubna_message(m): "p" sb
            dubna_send(_): c m
        ]
        elif(_): {code = 12} [
            len(n): body
            bytes_text(server_final): body 4 {n - 4}
            dubna_scram_attr(v): server_final "v"
            if(_): {expect = "" || v != expect} [
                set(r): "dubna: the server's SCRAM signature is wrong; it does not know the password"
                return(r): r
            ]
            set(expect): ""
        ]
        else(_): [
            str_from_int(cs): code
            concat(r): "dubna: unsupported authentication method " cs " (Dubna speaks trust, password, md5 and SCRAM-SHA-256)"
            return(r): r
        ]
    ]
]

dubna_drop(r): c [
    getf(s): c "socket"
    getf(tls): c "tls"
    if(_): tls [
        tls_close(_): s
    ]
    socket_close(r): s
    setf(_): c "open" false
]

dubna_close(r): c [
    set(r): 0
    if(_): {c = null} [
        return(r): r
    ]
    getf(open): c "open"
    if(_): open [
        vec(empty): ""
        dubna_message(m): "X" empty
        dubna_send(_): c m
        dubna_drop(r): c
    ]
]

# ---------------------------------------------------------------- queries

dubna_new_result(r): [
    vec(columns): ""
    vec(types): ""
    vec(rows): ""
    new(r): "DubnaResult" columns types rows "" "" ""
]

dubna_row_description(r): res body [
    vec(columns): ""
    vec(types): ""
    dubna_int16(n): body 0
    set(i): 2
    set(k): 0
    while(_): {k < n} [
        dubna_zero(z): body i
        bytes_text(name): body i {z - i}
        push(_): columns name
        dubna_int32(oid): body {z + 7}
        push(_): types oid
        set(i): {z + 19}
        add(k): k 1
    ]
    setf(_): res "columns" columns
    setf(_): res "types" types
    vec(rows): ""
    setf(_): res "rows" rows
    set(r): n
]

dubna_data_row(r): body [
    vec(r): ""
    dubna_int16(n): body 0
    set(i): 2
    set(k): 0
    while(_): {k < n} [
        dubna_int32(size): body i
        if(_): {size < 0} [
            push(_): r null
            add(i): i 4
        ]
        else(_): [
            bytes_text(v): body {i + 4} size
            push(_): r v
            set(i): {i + 4 + size}
        ]
        add(k): k 1
    ]
]

# Reads replies up to ReadyForQuery into a result.
dubna_collect(r): c [
    dubna_new_result(r):
    while(_): {true} [
        dubna_read(msg): c
        if(_): {msg = null} [
            setf(_): r "error" "dubna: the server closed the connection"
            dubna_fail(_): "dubna: the server closed the connection"
            return(r): r
        ]
        at(type): msg 0
        at(body): msg 1
        if(_): {type = "T"} [
            dubna_row_description(_): r body
        ]
        elif(_): {type = "D"} [
            dubna_data_row(row): body
            getf(rows): r "rows"
            push(_): rows row
        ]
        elif(_): {type = "C"} [
            dubna_cstr(tag): body 0
            setf(_): r "tag" tag
        ]
        elif(_): {type = "E"} [
            vec(code_out): ""
            dubna_error_text(text): body code_out
            at(code): code_out 0
            concat(text): "dubna: " text
            setf(_): r "error" text
            setf(_): r "code" code
            dubna_fail(_): text
        ]
        elif(_): {type = "N"} [
            dubna_error_text(text): body null
            getf(notices): c "notices"
            push(_): notices text
        ]
        elif(_): {type = "S"} [
            dubna_cstr(name): body 0
            dubna_zero(z): body 0
            dubna_cstr(value): body {z + 1}
            getf(params): c "params"
            push(_): params name
            push(_): params value
        ]
        elif(_): {type = "Z"} [
            at(st): body 0
            chr(status): st
            setf(_): c "status" status
            return(r): r
        ]
    ]
]

dubna_query(r): c sql [
    dubna_query_message(m): sql
    dubna_send(sent): c m
    if(_): {sent != 0} [
        dubna_new_result(r):
        setf(_): r "error" "dubna: could not send the query"
        dubna_fail(_): "dubna: could not send the query"
        return(r): r
    ]
    dubna_collect(r): c
]

# A parameter as text, or null for SQL NULL.
dubna_param_text(r): v [
    typeof(t): v
    set(r): v
    if(_): {t = "integer"} [
        str_from_int(r): v
    ]
    elif(_): {t = "real"} [
        str_from_number(r): v 15
    ]
    elif(_): {t = "boolean"} [
        set(r): "false"
        if(_): v [
            set(r): "true"
        ]
    ]
    elif(_): {t != "string" && t != "null"} [
        encode(r): v
    ]
]

# Parse, Bind, Describe, Execute and Sync for one statement with parameters.
dubna_exec_messages(r): sql params [
    vec(r): ""
    vec(parse): ""
    dubna_put_cstr(_): parse ""
    dubna_put_cstr(_): parse sql
    dubna_put_int16(_): parse 0
    dubna_message(m): "P" parse
    dubna_put_bytes(_): r m
    vec(bind): ""
    dubna_put_cstr(_): bind ""
    dubna_put_cstr(_): bind ""
    dubna_put_int16(_): bind 0
    len(n): params
    dubna_put_int16(_): bind n
    set(i): 0
    while(_): {i < n} [
        at(p): params i
        dubna_param_text(text): p
        if(_): {text = null} [
            dubna_put_int32(_): bind {0 - 1}
        ]
        else(_): [
            text_bytes(bytes): text
            len(bl): bytes
            dubna_put_int32(_): bind bl
            dubna_put_bytes(_): bind bytes
        ]
        add(i): i 1
    ]
    dubna_put_int16(_): bind 0
    dubna_message(m): "B" bind
    dubna_put_bytes(_): r m
    vec(describe): ""
    push(_): describe 80
    push(_): describe 0
    dubna_message(m): "D" describe
    dubna_put_bytes(_): r m
    vec(execute): ""
    dubna_put_cstr(_): execute ""
    dubna_put_int32(_): execute 0
    dubna_message(m): "E" execute
    dubna_put_bytes(_): r m
    vec(sync): ""
    dubna_message(m): "S" sync
    dubna_put_bytes(_): r m
]

dubna_exec(r): c sql params [
    dubna_exec_messages(m): sql params
    dubna_send(sent): c m
    if(_): {sent != 0} [
        dubna_new_result(r):
        setf(_): r "error" "dubna: could not send the query"
        dubna_fail(_): "dubna: could not send the query"
        return(r): r
    ]
    dubna_collect(r): c
]

# ---------------------------------------------------------------- results

dubna_ok(r): res [
    getf(e): res "error"
    set(r): {e = ""}
]

dubna_count(r): res [
    getf(rows): res "rows"
    len(r): rows
    getf(columns): res "columns"
    len(nc): columns
    if(_): {nc > 0} [
        return(r): r
    ]
    # INSERT 0 5, UPDATE 3, DELETE 2: the last word of the tag
    getf(tag): res "tag"
    set(r): 0
    len(n): tag
    set(i): n
    while(_): {i > 0} [
        byte(b): tag {i - 1}
        if(_): {b = 32} [
            break(_): ""
        ]
        sub(i): i 1
    ]
    slice(last): tag i {n - i}
    str_to_number(x): last
    if(_): {x != null} [
        set(r): x
    ]
]

dubna_column(r): res name [
    set(r): {0 - 1}
    getf(columns): res "columns"
    len(n): columns
    set(i): 0
    while(_): {i < n} [
        at(cn): columns i
        if(_): {cn = name} [
            set(r): i
            return(r): r
        ]
        add(i): i 1
    ]
]

dubna_value(r): res row col [
    set(r): null
    typeof(t): col
    if(_): {t = "string"} [
        dubna_column(col): res col
    ]
    getf(rows): res "rows"
    len(n): rows
    if(_): {row < 0 || row >= n || col < 0} [
        return(r): r
    ]
    at(cells): rows row
    len(nc): cells
    if(_): {col < nc} [
        at(r): cells col
    ]
]

# The server setting name (server_version, TimeZone, ...), or "".
dubna_parameter(r): c name [
    set(r): ""
    getf(params): c "params"
    len(n): params
    set(i): 0
    while(_): {i + 1 < n} [
        at(k): params i
        if(_): {k = name} [
            at(r): params {i + 1}
        ]
        add(i): i 2
    ]
]
