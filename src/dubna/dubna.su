# ---------------------------------------------------------------- connect

dubna_connect(r): conninfo [
    dubna_init(_):
    set(r): null
    dubna_conninfo(settings): conninfo
    getenv(os_user): "USERNAME"
    if(_): {os_user = null} [
        getenv(os_user): "USER"
    ]
    if(_): {os_user = null} [
        set(os_user): "postgres"
    ]
    dubna_setting(host): settings "host" "PGHOST" "localhost"
    dubna_setting(port_text): settings "port" "PGPORT" "5432"
    dubna_setting(user): settings "user" "PGUSER" os_user
    dubna_setting(password): settings "password" "PGPASSWORD" ""
    dubna_setting(database): settings "dbname" "PGDATABASE" user
    dubna_setting(sslmode): settings "sslmode" "PGSSLMODE" "prefer"
