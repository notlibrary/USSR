dubna_open(r): host port user password database sslmode [
    set(r): null
    str_from_int(port_text): port
    socket_tcp(s):
    if(_): {s < 1} [
        dubna_fail(r): "dubna: could not create a socket"
        return(r): r
    ]
    socket_connect(ok): s host port
