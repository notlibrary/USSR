    dubna_send(_): c m
    dubna_authenticate(why): c user password
    if(_): {why != ""} [
        dubna_drop(_): c
        dubna_fail(r): why
        return(r): r
    ]
    # parameters, the backend key, then ReadyForQuery
    while(_): {true} [
        dubna_read(msg): c
        if(_): {msg = null} [
            dubna_drop(_): c
            dubna_fail(r): "dubna: the server closed the connection"
            return(r): r
        ]
        at(type): msg 0
        at(body): msg 1
        if(_): {type = "S"} [
            dubna_cstr(name): body 0
            dubna_zero(z): body 0
            dubna_cstr(value): body {z + 1}
            push(_): params name
            push(_): params value
        ]
        elif(_): {type = "K"} [
            dubna_int32(pid): body 0
            setf(_): c "pid" pid
            dubna_int32(key): body 4
            setf(_): c "key" key
        ]
        elif(_): {type = "Z"} [
            at(st): body 0
            chr(status): st
            setf(_): c "status" status
            set(r): c
            return(r): r
        ]
        elif(_): {type = "E"} [
            dubna_error_text(text): body null
            dubna_drop(_): c
            concat(msg): "dubna: " text
            dubna_fail(r): msg
            return(r): r
        ]
        elif(_): {type = "N"} [
            dubna_error_text(text): body null
            push(_): notices text
