ryazan_multipart(r): parts [
    random64(x):
    set(x): {x & 0xFFFFFFFFFFFF}
    str_from_int_base(tag): x 16
    concat(boundary): "----ussr-ryazan-" tag
    set(body): ""
    len(n): parts
    set(i): 0
    while(_): {i < n} [
