            at(fname): p 1
            at(ctype): p 2
            at(data): p 3
            concat(body): body "Content-Disposition: form-data; name=\"" name "\"; filename=\"" fname "\"\r\nContent-Type: " ctype "\r\n\r\n" data "\r\n"
        ]
        else(_): [
            at(value): p 1
            concat(body): body "Content-Disposition: form-data; name=\"" name "\"\r\n\r\n" value "\r\n"
        ]
        set(i): {i + 1}
    ]
    concat(body): body "--" boundary "--\r\n"
    concat(ctype): "multipart/form-data; boundary=" boundary
    vec(r): ""
    push(_): r ctype
    push(_): r body
