# --- downloads and checks ---------------------------------------------------

ryazan_download(r): url path opts [
    btree(o):
    typeof(ot): opts
    if(_): {ot = "btree"} [
        btkeys(keys): opts
        len(n): keys
        set(i): 0
        while(_): {i < n} [
            at(k): keys i
            btget(v): opts k
            btput(_): o k v
            set(i): {i + 1}
        ]
    ]
    btput(_): o "binary" true
    _rzo(want): o "sha256" ""
    _rzo(progress): o "progress" false
    set(r): {0 - 1}
    ryazan_fetch(resp): "GET" url "" "" o
    typeof(t): resp
    if(_): {t != "btree"} [
        return(r): r
    ]
    btget(code): resp "status"
    btget(complete): resp "complete"
    if(_): {code < 200 || code >= 300 || complete = false} [
        str_from_int(cs): code
        concat(m): "download failed: HTTP " cs
        _rzh_fail(_): m
        return(r): r
    ]
    btget(data): resp "bytes" null
    typeof(dt): data
    if(_): {dt != "vector"} [
        btget(text): resp "body"
        text_bytes(data): text
    ]
    if(_): {want != ""} [
        sha256(d): data
        hex_encode(got): d
        str_lower(want): want
        if(_): {got != want} [
            _rzh_fail(_): "download failed: SHA-256 mismatch"
            return(r): r
        ]
    ]
    write_bytes(n): path data
    len(total): data
    if(_): progress [
        str_from_int(ts): total
        concat(m): ts " bytes saved to " path "\n"
        write_stderr(_): m
    ]
    if(_): {n = total} [
        set(r): 0
    ]
]

ryazan_check(r): url [
    ryazan_url_parse(u): url
    tls_backend(b):
    concat(r): "backend: " b "\n"
    typeof(ut): u
    if(_): {ut != "btree"} [
        concat(r): r "error: bad URL\n"
        return(r): r
    ]
    btget(host): u "host"
    btget(port): u "port"
    btget(scheme): u "scheme"
    if(_): {scheme = "https"} [
        ryazan_connect_timeout(s): host port 10000
        if(_): {s > 0} [
            tls_info(info): s
            concat(r): r "tls: " info "\n"
            ryazan_close(_): s
        ]
        else(_): [
            tls_error(why):
            ryazan_explain(hint): why
            concat(r): r "tls: failed: " why "\nhint: " hint "\n"
            return(r): r
        ]
    ]
    btree(o):
    btput(_): o "max_redirects" 0
    btput(_): o "timeout" 20
    ryazan_fetch(resp): "HEAD" url "" "" o
    typeof(t): resp
    if(_): {t = "btree"} [
        btget(code): resp "status"
        str_from_int(cs): code
        ryazan_resp_header(sts): resp "strict-transport-security"
        ryazan_resp_header(server): resp "server"
        concat(r): r "status: " cs "\n"
        if(_): {sts != ""} [
            concat(r): r "hsts: " sts "\n"
        ]
        else(_): [
            concat(r): r "hsts: none\n"
        ]
        if(_): {server != ""} [
            concat(r): r "server: " server "\n"
        ]
    ]
    else(_): [
        ryazan_fetch_error(e):
        concat(r): r "http: failed: " e "\n"
    ]
]
