# --- cookies ---------------------------------------------------------------
# A jar maps "domain|path|name" to [name, value, domain, path, secure,
# host_only].

ryazan_cookies_new(r): [
    btree(r):
]

ryazan_cookies_store(r): jar url text [
    ryazan_url_parse(u): url
    set(r): 0
    typeof(ut): u
    if(_): {ut != "btree"} [
        return(r): r
    ]
    btget(host): u "host"
    str_lower(host): host
    btget(path): u "path"
    str_split(parts): text ";"
    at(first): parts 0
    str_find(eq): first "=" 0
    if(_): {eq <= 0} [
        return(r): r
    ]
    slice(name): first 0 eq
    str_trim(name): name
    len(fl): first
    slice(value): first {eq + 1} {fl - eq - 1}
    str_trim(value): value
    set(domain): host
    set(host_only): true
    str_rfind(slash): path "/"
    set(cpath): "/"
    if(_): {slash > 0} [
        slice(cpath): path 0 slash
    ]
    set(secure): false
    set(remove): false
    len(np): parts
    set(i): 1
    while(_): {i < np} [
        at(attr): parts i
        str_trim(attr): attr
        str_find(aeq): attr "=" 0
        set(an): attr
        set(av): ""
        if(_): {aeq > 0} [
            slice(an): attr 0 aeq
            len(al): attr
            slice(av): attr {aeq + 1} {al - aeq - 1}
        ]
        str_lower(an): an
        if(_): {an = "domain" && av != ""} [
            str_lower(d): av
            str_starts(dot): d "."
            if(_): dot [
                len(dl): d
                slice(d): d 1 {dl - 1}
            ]
            # only the host itself or a parent domain of it
            concat(suffix): "." d
            str_ends(under): host suffix
            if(_): {d = host || under} [
                set(domain): d
                set(host_only): false
            ]
            else(_): [
                return(r): r
            ]
        ]
        elif(_): {an = "path" && av != ""} [
            set(cpath): av
        ]
        elif(_): {an = "secure"} [
            set(secure): true
        ]
        elif(_): {an = "max-age"} [
            str_to_int(age): av 10
            typeof(agt): age
            if(_): {agt = "integer" && age <= 0} [
                set(remove): true
            ]
        ]
        set(i): {i + 1}
    ]
    concat(key): domain "|" cpath "|" name
    if(_): remove [
        btdel(_): jar key
    ]
    else(_): [
        vec(c): ""
        push(_): c name
        push(_): c value
        push(_): c domain
        push(_): c cpath
        push(_): c secure
        push(_): c host_only
        btput(_): jar key c
    ]
    set(r): 1
]

ryazan_cookies_header(r): jar url [
    ryazan_url_parse(u): url
    set(r): ""
    typeof(ut): u
    if(_): {ut != "btree"} [
        return(r): r
    ]
    btget(host): u "host"
    str_lower(host): host
    btget(path): u "path"
    btget(scheme): u "scheme"
    btkeys(keys): jar
    len(n): keys
    set(i): 0
    while(_): {i < n} [
        at(k): keys i
        btget(c): jar k
        at(name): c 0
        at(value): c 1
        at(domain): c 2
        at(cpath): c 3
        at(secure): c 4
        at(host_only): c 5
        set(dom_ok): {host = domain}
        if(_): {host_only = false} [
            concat(suffix): "." domain
            str_ends(under): host suffix
            set(dom_ok): {dom_ok || under}
        ]
        str_starts(path_ok): path cpath
        set(sec_ok): {secure = false || scheme = "https"}
        if(_): {dom_ok && path_ok && sec_ok} [
            if(_): {r != ""} [
                concat(r): r "; "
            ]
            concat(r): r name "=" value
        ]
        set(i): {i + 1}
    ]
]

# --- HSTS ------------------------------------------------------------------

_rzh_hsts(r): [
