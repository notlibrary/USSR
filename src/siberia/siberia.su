# siberia.su - Siberia, a small spreadsheet for USSR on a Petersburg canvas.
#
#     ussr src/siberia/siberia.su [file.fods|file.csv]
#
# Files are OpenDocument in its flat, single-XML form (.fods), which
# LibreOffice and other ODF programs open and save; sheets also read and
# write CSV. The document editor that used to be `siberia.su --pad` is
# Novosibirsk (src/novosibirsk/novosibirsk.su): it defines SB_PAD and
# includes this file for the shared parts (helpers, XML, dialogs, events),
# so the pad hooks here sit under $ifdef SB_PAD.
#
# The engine (cells, formulas, files) works without a window and is what
# tests/siberia_test.su checks. Public API:
#   sbsetup(r):                   -> types and starting state; call first
#   sbinitialize(canvas): window mode  -> sbsetup, toolbar and canvas
#   sbsheetreset(r):              -> an empty sheet
#   sbset(r): name text           -> sets a cell ("B3") to typed text
#   sbget(r): name                -> the cell's typed text
#   sbshow(r): name               -> the cell's value as displayed
#   sbsheetfods(r): / sbsheetcsv(r):        -> the sheet as file text
#   sbsheetload(r): text kind     -> loads "fods" or "csv" text; "" or why not
#
# Callbacks are separate processes, so the state lives in the hash
# namespace (sb_*): the sheet's cells are SbCell structs in sb_cells.
$once
$include "../petersburg/petersburg.su"
$include "../libs/strings.su"
$include "../libs/math.su"

$define SB_COLS 52
$define SB_ROWS 2000
$define SB_COLW 96
$define SB_ROWH 22
$define SB_HEADW 48
$define SB_BARH 28
$define SB_STATUSH 22
$define SB_UIPX 14
$define SB_MARGIN 56
$define SB_WIDTH 960
$define SB_HEIGHT 640

$define SB_KEY_ESC 256
$define SB_KEY_ENTER 257
$define SB_KEY_TAB 258
$define SB_KEY_BACKSPACE 259
$define SB_KEY_DELETE 261
$define SB_KEY_RIGHT 262
$define SB_KEY_LEFT 263
$define SB_KEY_DOWN 264
$define SB_KEY_UP 265
$define SB_KEY_PAGE_UP 266
$define SB_KEY_PAGE_DOWN 267
$define SB_KEY_HOME 268
$define SB_KEY_END 269
$define SB_KEY_F1 290
$define SB_KEY_F2 291
$define SB_KEY_KP_ENTER 335

# --- small helpers ----------------------------------------------------------

# Declares the types and gives every piece of state its starting value;
# call it once before anything else.
sbsetup(r): [
    struct(SbCell): "text:string" "value:any" "gen:number"
$ifdef SB_PAD
    struct(SbFamily): "name:string" "key:string" "regular:string" "bold:string" "italic:string" "bolditalic:string"
    struct(SbPara): "text:string"
$endif
    struct(SbParse): "toks:vector" "pos:number"
    struct(SbRow): "cells:vector"
    sbstate(r):
]

# Every piece of state back to its starting value (an empty sheet, with
# Novosibirsk an empty document, no file).
sbstate(r): [
    new(blank): "SbCell" "" null 0
    set(sb_blank): blank!
    set(sb_window): 0!
    set(sb_canvas): 0!
    set(sb_mode): "sheet"!
    set(sb_path): ""!
    set(sb_dirty): false!
    set(sb_message): ""!
    set(sb_status_left): ""!
    set(sb_dialog): ""!
    set(sb_dlg_text): ""!
    set(sb_dlg_next): ""!
    set(sb_shift): false!
    set(sb_ctrl): false!
    set(sb_alt): false!
    set(sb_uifont): 0!
    vec(v): ""
    set(sb_buttons): v!
    vec(v): ""
    set(sb_rows): v!
    set(sb_gen): 1!
    set(sb_maxrow): {0 - 1}!
    set(sb_maxcol): {0 - 1}!
    set(sb_row): 0!
    set(sb_col): 0!
    set(sb_top): 0!
    set(sb_left): 0!
    set(sb_edit): false!
    set(sb_buf): ""!
    # the pad's view follows its cursor; the shared key handlers set it
    set(sb_pfollow): true!
$ifdef SB_PAD
    vec(v): ""
    set(sb_families): v!
    set(sb_family): ""!
    set(sb_size): 12!
    set(sb_bold): false!
    set(sb_italic): false!
    set(sb_pfont): 0!
    set(sb_ppx): 16!
    set(sb_pwidth): 600!
    set(sb_plines_visible): 20!
    vec(v): ""
    set(sb_plines): v!
    set(sb_picker): false!
    set(sb_pick): 0!
    set(sb_pick_top): 0!
    sbpadreset(_):
$endif
    set(r): 0
]

sb_minus_one(r): [
    set(r): {0 - 1}
]

sb_is_number(r): v [
    typeof(t): v
    set(r): {t = "integer" || t = "real"}
]

sb_starts(r): s prefix [
    len(n): s
    len(m): prefix
    set(r): false
    if(_): {m <= n} [
        slice(head): s 0 m
        set(r): {head = prefix}
    ]
]

sb_ends(r): s suffix [
    len(n): s
    len(m): suffix
    set(r): false
    if(_): {m <= n} [
        slice(tail): s {n - m} m
        set(r): {tail = suffix}
    ]
]

sb_upper(r): s [
    set(r): ""
    len(n): s
    set(i): 0
    set(from): 0
    while(_): {i < n} [
        byte(b): s i
        if(_): {b >= 97 && b <= 122} [
            slice(run): s from {i - from}
            chr(c): {b - 32}
            concat(r): r run c
            set(from): {i + 1}
        ]
        set(i): {i + 1}
    ]
    slice(run): s from {n - from}
    concat(r): r run
]

# -1, 0 or 1: a against b, bytes compared without regard to ASCII case.
sb_compare_text(r): a b [
    str_lower(x): a
    str_lower(y): b
    len(n): x
    len(m): y
    set(r): 0
    set(i): 0
    while(_): {r = 0 && i < n && i < m} [
        byte(p): x i
        byte(q): y i
        if(_): {p < q} [ sb_minus_one(r): ]
        elif(_): {p > q} [ set(r): 1 ]
        set(i): {i + 1}
    ]
    if(_): {r = 0 && n < m} [ sb_minus_one(r): ]
    if(_): {r = 0 && n > m} [ set(r): 1 ]
]

# UTF-8 text of one code point.
sb_utf8(r): cp [
    if(_): {cp < 128} [ chr(r): cp ]
    else(_): [
        vec(v): ""
        if(_): {cp < 2048} [
            push(_): v {192 | (cp >> 6)}
        ]
        elif(_): {cp < 65536} [
            push(_): v {224 | (cp >> 12)}
            push(_): v {128 | ((cp >> 6) & 63)}
        ]
        else(_): [
            push(_): v {240 | (cp >> 18)}
            push(_): v {128 | ((cp >> 12) & 63)}
            push(_): v {128 | ((cp >> 6) & 63)}
        ]
        push(_): v {128 | (cp & 63)}
        utf8_from_bytes(r): v
    ]
]

# Text without its last character.
sb_drop_last(r): s [
    len(n): s
    set(r): s
    if(_): {n > 0} [
        utf8_prev(i): s n
        slice(r): s 0 i
    ]
]

sb_basename(r): path [
    len(n): path
    set(i): n
    set(go): {i > 0}
    while(_): go [
        byte(b): path {i - 1}
        if(_): {b = 47 || b = 92} [ set(go): false ]
        else(_): [
            set(i): {i - 1}
            set(go): {i > 0}
        ]
    ]
    slice(r): path i {n - i}
]

# Lower-case extension with its dot (".fods"), or "".
sb_extension(r): path [
    sb_basename(name): path
    len(n): name
    set(r): ""
    set(i): {n - 1}
    set(go): {i > 0}
    while(_): go [
        byte(b): name i
        if(_): {b = 46} [
            slice(ext): name i {n - i}
            str_lower(r): ext
            set(go): false
        ]
        else(_): [
            set(i): {i - 1}
            set(go): {i > 0}
        ]
    ]
]

# Whole file, or null when it cannot be read.
sb_read(r): path [
    set(r): null
    file_exists(e): path
    if(_): e [
        open_file(h): path "rb"
        if(_): {h >= 0} [
            read_file(r): h
            close_file(_): h
        ]
    ]
]

# true when the text was written.
sb_write(r): path text [
    set(r): false
    open_file(h): path "wb"
    if(_): {h >= 0} [
        len(n): text
        write_file(w): h text
        close_file(_): h
        set(r): {w = n}
    ]
]

# --- values -----------------------------------------------------------------
# A cell value is null (empty), a number, a string, a boolean or an error:
# a string starting with byte 1, then the name ("#DIV/0!").

sb_err(r): name [
    chr(r): 1
    concat(r): r name
]

sb_is_err(r): v [
    set(r): false
    typeof(t): v
    if(_): {t = "string"} [
        len(n): v
        if(_): {n > 0} [
            byte(b): v 0
            set(r): {b = 1}
        ]
    ]
]

# A number with up to 10 significant digits.
sb_fmt(r): x [
    typeof(t): x
    if(_): {t = "integer"} [
        str_from_int(r): x
        return(_): r
    ]
    if(_): {x != x || x - x != 0.0} [
        set(r): "#NUM!"
        return(_): r
    ]
    set(ax): x
    if(_): {x < 0} [ set(ax): {0 - x} ]
    if(_): {ax = 0} [
        set(r): "0"
        return(_): r
    ]
    if(_): {ax >= 1000000000000000.0 || ax < 0.000001} [
        set(e): 0
        set(m): ax
        while(_): {m >= 10} [
            set(m): {m / 10}
            set(e): {e + 1}
        ]
        while(_): {m < 1} [
            set(m): {m * 10}
            set(e): {e - 1}
        ]
        str_from_number(ms): m 9
        if(_): {ms = "10"} [
            set(ms): "1"
            set(e): {e + 1}
        ]
        str_from_int(es): e
        set(r): ""
        if(_): {x < 0} [ set(r): "-" ]
        concat(r): r ms "E" es
        return(_): r
    ]
    set(k): 1
    set(p): 10.0
    while(_): {ax >= p} [
        set(p): {p * 10}
        set(k): {k + 1}
    ]
    set(d): {10 - k}
    if(_): {ax < 1} [ set(d): 10 ]
    if(_): {d < 0} [ set(d): 0 ]
    str_from_number(r): x d
]

# A value as the cell shows it.
sb_show_value(r): v [
    typeof(t): v
    set(r): ""
    if(_): {t = "integer" || t = "real"} [ sb_fmt(r): v ]
    elif(_): {t = "boolean"} [
        set(r): "FALSE"
        if(_): v [ set(r): "TRUE" ]
    ]
    elif(_): {t = "string"} [
        sb_is_err(e): v
        set(r): v
        if(_): e [
            len(n): v
            slice(r): v 1 {n - 1}
        ]
    ]
    elif(_): {t = "vector"} [ set(r): "#VALUE!" ]
]

# A value as a number for arithmetic, or an error.
sb_num(r): v [
    typeof(t): v
    set(r): v
    if(_): {t = "null"} [ set(r): 0 ]
    elif(_): {t = "boolean"} [
        set(r): 0
        if(_): v [ set(r): 1 ]
    ]
    elif(_): {t = "vector"} [ sb_err(r): "#VALUE!" ]
    elif(_): {t = "string"} [
        sb_is_err(e): v
        if(_): {e = false} [
            str_trim(s): v
            if(_): {s = ""} [ set(r): 0 ]
            else(_): [
                str_to_number(r): s
                typeof(t2): r
                if(_): {t2 = "null"} [ sb_err(r): "#VALUE!" ]
            ]
        ]
    ]
]

sb_text_of(r): v [
    sb_is_number(n): v
    if(_): n [ sb_fmt(r): v ]
    else(_): [ sb_show_value(r): v ]
]

# --- cells ------------------------------------------------------------------

# Column letters: 0 -> A, 25 -> Z, 26 -> AA.
sb_colname(r): c [
    set(r): ""
    set(n): {c + 1}
    while(_): {n > 0} [
        set(m): {(n - 1) % 26}
        chr(ch): {65 + m}
        concat(r): ch r
        str_trunc(n): {(n - 1 - m) / 26}
    ]
]

sb_cellname(r): index [
    set(col): {index % SB_COLS}
    str_trunc(row): {(index - col) / SB_COLS}
    sb_colname(r): col
    str_from_int(rs): {row + 1}
    concat(r): r rs
]

# Cell index of a reference ("B3", "$B$3"); -1 when it is not one, -2
# when it is shaped like one but lies outside the sheet.
sb_ref(r): s [
    sb_minus_one(r):
    len(n): s
    set(i): 0
    set(col): 0
    set(letters): 0
    set(row): 0
    set(digits): 0
    if(_): {n > 0} [
        byte(b): s 0
        if(_): {b = 36} [ set(i): 1 ]
    ]
    set(go): {i < n}
    while(_): go [
        byte(b): s i
        if(_): {b >= 97 && b <= 122} [ set(b): {b - 32} ]
        if(_): {b >= 65 && b <= 90 && letters < 3} [
            set(col): {col * 26 + b - 64}
            set(letters): {letters + 1}
            set(i): {i + 1}
            set(go): {i < n}
        ]
        else(_): [ set(go): false ]
    ]
    if(_): {i < n} [
        byte(b): s i
        if(_): {b = 36} [ set(i): {i + 1} ]
    ]
    set(go): {i < n}
    while(_): go [
        byte(b): s i
        if(_): {b >= 48 && b <= 57 && digits < 8} [
            set(row): {row * 10 + b - 48}
            set(digits): {digits + 1}
            set(i): {i + 1}
            set(go): {i < n}
        ]
        else(_): [ set(go): false ]
    ]
    if(_): {letters > 0 && digits > 0 && i = n} [
        set(r): {0 - 2}
        if(_): {row >= 1 && row <= SB_ROWS && col <= SB_COLS} [
            set(r): {(row - 1) * SB_COLS + col - 1}
        ]
    ]
]

# Rows (SbRow in sb_rows) get their cells on the first write; until then
# every cell of the row is the shared empty cell sb_blank. Allocating the
# whole grid up front is slow, and slower again while a previous grid is
# still waiting for the collector.
sbsheetreset(r): [
    set(rows): sb_rows?
    len(n): rows
    if(_): {n = 0} [
        set(i): 0
        while(_): {i < SB_ROWS} [
            vec(cells): "SbCell"
            new(row): "SbRow" cells
            push(_): rows row
            set(i): {i + 1}
        ]
    ]
    else(_): [
        set(maxrow): sb_maxrow?
        set(i): 0
        while(_): {i <= maxrow} [
            at(row): rows i
            vec(cells): "SbCell"
            setf(_): row "cells" cells
            set(i): {i + 1}
        ]
    ]
    set(sb_gen): 1!
    set(sb_maxrow): {0 - 1}!
    set(sb_maxcol): {0 - 1}!
    set(r): 0
]

sb_cell(r): index [
    set(col): {index % SB_COLS}
    str_trunc(rn): {(index - col) / SB_COLS}
    set(rows): sb_rows?
    at(row): rows rn
    getf(cells): row "cells"
    len(n): cells
    if(_): {n = 0} [ set(r): sb_blank? ] else(_): [ at(r): cells col ]
]

# The cell itself, giving its row cells when it has none yet.
sb_cell_for_write(r): index [
    set(col): {index % SB_COLS}
    str_trunc(rn): {(index - col) / SB_COLS}
    set(rows): sb_rows?
    at(row): rows rn
    getf(cells): row "cells"
    len(n): cells
    if(_): {n = 0} [
        set(i): 0
        while(_): {i < SB_COLS} [
            new(c): "SbCell" "" null 0
            push(_): cells c
            set(i): {i + 1}
        ]
    ]
    at(r): cells col
]

sb_set_index(r): index text [
    sb_cell_for_write(c): index
    setf(_): c "text" text
    set(gen): sb_gen?
    set(sb_gen): {gen + 1}!
    if(_): {text != ""} [
        set(col): {index % SB_COLS}
        str_trunc(row): {(index - col) / SB_COLS}
        set(mr): sb_maxrow?
        set(mc): sb_maxcol?
        if(_): {row > mr} [ set(sb_maxrow): row! ]
        if(_): {col > mc} [ set(sb_maxcol): col! ]
    ]
    set(r): 0
]

# The value of a cell, computed once per change of the sheet.
sb_value(r): index [
    sb_cell(c): index
    getf(g): c "gen"
    set(gen): sb_gen?
    if(_): {g = gen} [ getf(r): c "value" ]
    elif(_): {g = 0 - gen} [ sb_err(r): "#CYCLE!" ]
    else(_): [
        setf(_): c "gen" {0 - gen}
        getf(text): c "text"
        sb_compute(r): text
        setf(_): c "value" r
        setf(_): c "gen" gen
    ]
]

sb_compute(r): text [
    set(r): null
    len(n): text
    if(_): {n > 0} [
        byte(b): text 0
        if(_): {b = 61 && n > 1} [
            slice(f): text 1 {n - 1}
            sb_formula(r): f
        ]
        else(_): [
            str_trim(s): text
            set(num): null
            if(_): {s != ""} [ str_to_number(num): s ]
            typeof(t): num
            if(_): {t = "null"} [ set(r): text ]
            else(_): [ set(r): num ]
        ]
    ]
]

sbset(r): name text [
    sb_ref(i): name
    if(_): {i < 0} [ fail(_): "sbset: not a cell name" ]
    sb_set_index(r): i text
]

sbget(r): name [
    sb_ref(i): name
    sb_cell(c): i
    getf(r): c "text"
]

sbshow(r): name [
    sb_ref(i): name
    sb_value(v): i
    sb_show_value(r): v
]

# --- formulas ---------------------------------------------------------------
# Tokens are [kind text value]: kind "num", "str", "ref" (value: the cell
# index), "name", "op" or "bad". References may also be written the
# OpenFormula way, "[.A1]" and "[.A1:.B2]", as .fods files store them.

sb_is_letter(r): b [
    set(r): {(b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b = 95 || b = 36}
]

sb_is_digit(r): b [
    set(r): {b >= 48 && b <= 57}
]

sb_push_tok(r): toks kind text value [
    vec(t): ""
    push(_): t kind
    push(_): t text
    push(_): t value
    push(_): toks t
    set(r): 0
]

# One side of an OpenFormula reference: "$Sheet1.$A$1" -> "A1".
sb_of_ref(r): s [
    len(n): s
    set(i): n
    set(go): {i > 0}
    while(_): go [
        byte(b): s {i - 1}
        if(_): {b = 46} [ set(go): false ]
        else(_): [
            set(i): {i - 1}
            set(go): {i > 0}
        ]
    ]
    slice(r): s i {n - i}
]

sb_tokens(r): s [
    vec(r): ""
    len(n): s
    set(i): 0
    while(_): {i < n} [
        byte(b): s i
        set(b2): 0
        if(_): {i + 1 < n} [ byte(b2): s {i + 1} ]
        sb_is_digit(dg): b
        sb_is_digit(dg2): b2
        sb_is_letter(lt): b
        if(_): {b = 32 || b = 9 || b = 10 || b = 13} [ set(i): {i + 1} ]
        elif(_): {dg || (b = 46 && dg2)} [
            set(j): i
            set(go): true
            set(seen_e): false
            while(_): go [
                set(j): {j + 1}
                set(go): false
                if(_): {j < n} [
                    byte(c): s j
                    sb_is_digit(cd): c
                    if(_): {cd || c = 46} [ set(go): true ]
                    elif(_): {(c = 69 || c = 101) && seen_e = false && j + 1 < n} [
                        byte(c2): s {j + 1}
                        sb_is_digit(cd2): c2
                        set(sign): {c2 = 43 || c2 = 45}
                        if(_): {sign && j + 2 < n} [
                            byte(c3): s {j + 2}
                            sb_is_digit(cd2): c3
                            if(_): cd2 [ set(j): {j + 1} ]
                        ]
                        if(_): cd2 [
                            set(go): true
                            set(seen_e): true
                        ]
                    ]
                ]
            ]
            slice(text): s i {j - i}
            str_to_number(v): text
            typeof(t): v
            if(_): {t = "null"} [ sb_push_tok(_): r "bad" text null ]
            else(_): [ sb_push_tok(_): r "num" text v ]
            set(i): j
        ]
        elif(_): {b = 34} [
            set(text): ""
            set(j): {i + 1}
            set(go): {j < n}
            while(_): go [
                byte(c): s j
                if(_): {c = 34} [
                    set(c2): 0
                    if(_): {j + 1 < n} [ byte(c2): s {j + 1} ]
                    if(_): {c2 = 34} [
                        concat(text): text "\""
                        set(j): {j + 2}
                    ]
                    else(_): [
                        set(j): {j + 1}
                        set(go): false
                    ]
                ]
                else(_): [
                    chr(ch): c
                    concat(text): text ch
                    set(j): {j + 1}
                ]
                if(_): {j >= n} [ set(go): false ]
            ]
            sb_push_tok(_): r "str" text text
            set(i): j
        ]
        elif(_): {b = 91} [
            str_find(close): s "]" i
            if(_): {close < 0} [ set(close): n ]
            slice(inner): s {i + 1} {close - i - 1}
            str_find(colon): inner ":" 0
            if(_): {colon < 0} [
                sb_of_ref(a): inner
                sb_ref(ia): a
                sb_upper(a): a
                sb_push_tok(_): r "ref" a ia
            ]
            else(_): [
                len(il): inner
                slice(left): inner 0 colon
                slice(right): inner {colon + 1} {il - colon - 1}
                sb_of_ref(a): left
                sb_of_ref(z): right
                sb_ref(ia): a
                sb_ref(iz): z
                sb_upper(a): a
                sb_upper(z): z
                sb_push_tok(_): r "ref" a ia
                sb_push_tok(_): r "op" ":" null
                sb_push_tok(_): r "ref" z iz
            ]
            set(i): {close + 1}
        ]
        elif(_): lt [
            set(j): i
            set(go): true
            while(_): go [
                set(j): {j + 1}
                set(go): false
                if(_): {j < n} [
                    byte(c): s j
                    sb_is_letter(cl): c
                    sb_is_digit(cd): c
                    set(go): {cl || cd || c = 46}
                ]
            ]
            slice(word): s i {j - i}
            sb_upper(word): word
            set(k): j
            set(go): {k < n}
            set(next): 0
            while(_): go [
                byte(next): s k
                if(_): {next = 32} [
                    set(k): {k + 1}
                    set(go): {k < n}
                ]
                else(_): [ set(go): false ]
            ]
            sb_ref(idx): word
