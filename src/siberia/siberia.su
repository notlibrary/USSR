        str_to_number(x): v
        typeof(tx): x
        if(_): {tx = "integer"} [ set(r): x ]
    ]
]

# The text of an XML text run, decoded.
sb_xml_text(r): s from to [
    slice(run): s from {to - from}
    sb_xml_unescape(r): run
]

# Index of the next "<" at or after i, or n.
sb_next_lt(r): s i n [
    set(r): i
    set(go): {r < n}
    while(_): go [
        byte(b): s r
        if(_): {b = 60} [ set(go): false ]
        else(_): [
            set(r): {r + 1}
            set(go): {r < n}
        ]
    ]
]

$define SB_ODF_HEAD "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<office:document xmlns:office=\"urn:oasis:names:tc:opendocument:xmlns:office:1.0\" xmlns:style=\"urn:oasis:names:tc:opendocument:xmlns:style:1.0\" xmlns:text=\"urn:oasis:names:tc:opendocument:xmlns:text:1.0\" xmlns:table=\"urn:oasis:names:tc:opendocument:xmlns:table:1.0\" xmlns:fo=\"urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0\" xmlns:svg=\"urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0\" xmlns:of=\"urn:oasis:names:tc:opendocument:xmlns:of:1.2\" office:version=\"1.2\" "

# --- sheet files ------------------------------------------------------------

# A number as xsd:double text.
sb_xml_number(r): x [
    typeof(t): x
    if(_): {t = "integer"} [ str_from_int(r): x ]
    else(_): [
        set(ax): x
        if(_): {x < 0} [ set(ax): {0 - x} ]
        if(_): {ax >= 1000000000000000.0 || (ax < 0.000001 && ax > 0)} [ sb_fmt(r): x ]
        else(_): [ str_from_number(r): x 15 ]
    ]
]

sb_fods_cell(r): index [
    sb_cell(c): index
    getf(text): c "text"
    sb_value(v): index
    typeof(t): v
    sb_is_err(e): v
    sb_show_value(shown): v
    sb_odf_text(p): shown
    set(r): "<table:table-cell"
    byte(b0): text 0
    if(_): {b0 = 61} [
        len(tl): text
        slice(f): text 1 {tl - 1}
        sb_tokens(toks): f
        sb_emit(of): toks true
        sb_xml_escape(of): of
        concat(r): r " table:formula=\"of:=" of "\""
    ]
    if(_): {(t = "integer" || t = "real") && e = false} [
        sb_xml_number(xn): v
        concat(r): r " office:value-type=\"float\" office:value=\"" xn "\""
    ]
    elif(_): {t = "boolean"} [
        set(bv): "false"
        if(_): v [ set(bv): "true" ]
        concat(r): r " office:value-type=\"boolean\" office:boolean-value=\"" bv "\""
    ]
    else(_): [ concat(r): r " office:value-type=\"string\"" ]
    concat(r): r "><text:p>" p "</text:p></table:table-cell>"
]

sb_repeat_attr(r): name count [
    set(r): ""
    if(_): {count > 1} [
        str_from_int(cs): count
        concat(r): " " name "=\"" cs "\""
    ]
]

sbsheetfods(r): [
    set(maxrow): sb_maxrow?
    set(maxcol): sb_maxcol?
    set(cells): {maxcol + 1}
    if(_): {cells < 1} [ set(cells): 1 ]
    str_from_int(cs): cells
    concat(r): SB_ODF_HEAD "office:mimetype=\"application/vnd.oasis.opendocument.spreadsheet\">\n<office:body>\n<office:spreadsheet>\n<table:table table:name=\"Sheet1\">\n<table:table-column table:number-columns-repeated=\"" cs "\"/>\n"
    set(row): 0
    set(blank_rows): 0
    while(_): {row <= maxrow} [
        set(line): ""
        set(empty): 0
        set(col): 0
        set(used): false
        while(_): {col <= maxcol} [
            set(index): {row * SB_COLS + col}
            sb_cell(c): index
            getf(text): c "text"
            if(_): {text = ""} [ set(empty): {empty + 1} ]
            else(_): [
                if(_): {empty > 0} [
                    sb_repeat_attr(ra): "table:number-columns-repeated" empty
                    concat(line): line "<table:table-cell" ra "/>"
                    set(empty): 0
                ]
                sb_fods_cell(cell): index
                concat(line): line cell
                set(used): true
            ]
            set(col): {col + 1}
        ]
        if(_): used [
            if(_): {blank_rows > 0} [
                sb_repeat_attr(ra): "table:number-rows-repeated" blank_rows
                concat(r): r "<table:table-row" ra "><table:table-cell/></table:table-row>\n"
                set(blank_rows): 0
            ]
            concat(r): r "<table:table-row>" line "</table:table-row>\n"
        ]
        else(_): [ set(blank_rows): {blank_rows + 1} ]
        set(row): {row + 1}
    ]
    if(_): {maxrow < 0} [ concat(r): r "<table:table-row><table:table-cell/></table:table-row>\n" ]
    concat(r): r "</table:table>\n</office:spreadsheet>\n</office:body>\n</office:document>\n"
]

sb_csv_field(r): s [
    set(r): s
    str_find(a): s "," 0
    str_find(b): s "\"" 0
    str_find(c): s "\n" 0
    str_find(d): s ";" 0
    if(_): {a >= 0 || b >= 0 || c >= 0 || d >= 0} [
        set(r): "\""
        len(n): s
