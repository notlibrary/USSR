    sb_ui_text(_): 8 {h - SB_STATUSH + 3} left 3355443
    sb_ui_width(nw): name
    sb_ui_text(_): {w - nw - 10} {h - SB_STATUSH + 3} name 3355443
    set(r): 0
]

# The file-name or yes/no box over everything else.
sb_draw_dialog(r): w h [
    set(kind): sb_dialog?
    set(r): 0
    if(_): {kind = ""} [ return(_): r ]
    set(canvas): sb_canvas?
    set(bw): 560
    if(_): {bw > w - 20} [ set(bw): {w - 20} ]
    set(bh): 116
