        while(_): {i < n} [
            byte(x): s i
            chr(ch): x
            concat(r): r ch
            if(_): {x = 34} [ concat(r): r "\"" ]
            set(i): {i + 1}
        ]
        concat(r): r "\""
    ]
]

# The sheet's values as CSV (formulas are saved as their results).
sbsheetcsv(r): [
    set(r): ""
    set(maxrow): sb_maxrow?
    set(maxcol): sb_maxcol?
    set(row): 0
    while(_): {row <= maxrow} [
        set(col): 0
        set(line): ""
        while(_): {col <= maxcol} [
            sb_value(v): {row * SB_COLS + col}
            sb_is_number(isn): v
            if(_): isn [ sb_xml_number(s): v ] else(_): [ sb_show_value(s): v ]
            sb_csv_field(s): s
            if(_): {col > 0} [ concat(line): line "," ]
            concat(line): line s
            set(col): {col + 1}
        ]
        concat(r): r line "\n"
        set(row): {row + 1}
    ]
]

sb_load_csv(r): text [
    set(r): ""
    len(n): text
    # comma, or semicolon when the first line has semicolons and no commas
    str_find(nl): text "\n" 0
    if(_): {nl < 0} [ set(nl): n ]
    slice(first): text 0 nl
    str_find(hc): first "," 0
    str_find(hs): first ";" 0
    set(sep): 44
    if(_): {hc < 0 && hs >= 0} [ set(sep): 59 ]
    set(row): 0
    set(col): 0
    set(i): 0
    set(field): ""
    set(quoted): false
    set(dirty): false
    while(_): {i < n} [
        byte(b): text i
        if(_): quoted [
            if(_): {b = 34} [
                set(b2): 0
                if(_): {i + 1 < n} [ byte(b2): text {i + 1} ]
                if(_): {b2 = 34} [
                    concat(field): field "\""
                    set(i): {i + 1}
                ]
                else(_): [ set(quoted): false ]
            ]
            else(_): [
                chr(ch): b
                concat(field): field ch
            ]
        ]
        elif(_): {b = 34} [
            set(quoted): true
            set(dirty): true
        ]
        elif(_): {b = sep || b = 10} [
            if(_): {row < SB_ROWS && col < SB_COLS && field != ""} [ sb_set_index(_): {row * SB_COLS + col} field ]
            set(field): ""
            set(dirty): false
            set(col): {col + 1}
            if(_): {b = 10} [
                set(row): {row + 1}
                set(col): 0
            ]
        ]
        elif(_): {b != 13} [
            chr(ch): b
            concat(field): field ch
            set(dirty): true
        ]
        set(i): {i + 1}
    ]
    if(_): {(dirty || field != "") && row < SB_ROWS && col < SB_COLS} [ sb_set_index(_): {row * SB_COLS + col} field ]
]

sb_load_fods(r): s [
    set(r): "no table in this file"
    str_find(start): s "<table:table " 0
    if(_): {start < 0} [ str_find(start): s "<table:table>" 0 ]
    if(_): {start < 0} [ return(_): r ]
    set(r): ""
    len(n): s
    set(i): start
    set(row): 0
    set(col): 0
    set(rows_rep): 1
    vec(rowbuf): ""
    set(cols_rep): 1
    set(formula): null
    set(vtype): ""
    set(value): null
    set(bvalue): null
    set(text): ""
    set(paras): 0
    set(in_p): false
    set(hidden): 0
    set(in_cell): false
    set(done): false
    while(_): {i < n && done = false} [
        byte(b): s i
        if(_): {b != 60} [
            sb_next_lt(j): s i n
            if(_): {in_p && hidden = 0} [
                sb_xml_text(t): s i j
                concat(text): text t
            ]
            set(i): j
        ]
        else(_): [
            sb_xml_tag(tag): s i
            at(kind): tag 0
            at(name): tag 1
            at(attrs): tag 2
            at(i): tag 3
            set(finish): false
            if(_): {name = "table:table-row" && (kind = "open" || kind = "empty")} [
                sb_attr_int(rows_rep): attrs "table:number-rows-repeated" 1
                set(col): 0
                vec(rowbuf): ""
                if(_): {kind = "empty"} [ set(row): {row + rows_rep} ]
            ]
            elif(_): {name = "table:table-row" && kind = "close"} [
                len(cells): rowbuf
                if(_): {cells > 0} [
                    set(k): 0
                    while(_): {k < rows_rep && row + k < SB_ROWS} [
                        set(m): 0
                        while(_): {m < cells} [
                            at(entry): rowbuf m
                            at(ec): entry 0
                            at(et): entry 1
                            sb_set_index(_): {(row + k) * SB_COLS + ec} et
                            set(m): {m + 1}
                        ]
                        set(k): {k + 1}
                    ]
                ]
                set(row): {row + rows_rep}
            ]
            elif(_): {(name = "table:table-cell" || name = "table:covered-table-cell") && (kind = "open" || kind = "empty")} [
                sb_attr_int(cols_rep): attrs "table:number-columns-repeated" 1
                sb_xml_attr(formula): attrs "table:formula"
                sb_xml_attr(vtype): attrs "office:value-type"
                typeof(tv): vtype
                if(_): {tv = "null"} [ set(vtype): "" ]
                sb_xml_attr(value): attrs "office:value"
                sb_xml_attr(bvalue): attrs "office:boolean-value"
                set(text): ""
                set(paras): 0
                set(in_cell): true
                if(_): {kind = "empty"} [ set(finish): true ]
            ]
            elif(_): {(name = "table:table-cell" || name = "table:covered-table-cell") && kind = "close"} [ set(finish): true ]
            elif(_): {name = "text:p" && kind = "open" && in_cell} [
                if(_): {hidden = 0} [
                    if(_): {paras > 0} [ concat(text): text " " ]
                    set(paras): {paras + 1}
                ]
                set(in_p): true
            ]
            elif(_): {name = "text:p" && kind = "close"} [ set(in_p): false ]
            elif(_): {name = "office:annotation" && kind = "open"} [ set(hidden): {hidden + 1} ]
            elif(_): {name = "office:annotation" && kind = "close"} [ set(hidden): {hidden - 1} ]
            elif(_): {in_p && hidden = 0 && (name = "text:s" || name = "text:tab" || name = "text:line-break")} [
                set(count): 1
                if(_): {name = "text:s"} [ sb_attr_int(count): attrs "text:c" 1 ]
                str_repeat(sp): " " count
                concat(text): text sp
            ]
            elif(_): {name = "table:table" && kind = "close"} [ set(done): true ]
            if(_): finish [
                set(stored): text
                typeof(tf): formula
                typeof(tval): value
                if(_): {tf = "string"} [
                    str_find(eq): formula "=" 0
                    len(fl): formula
                    slice(body): formula {eq + 1} {fl - eq - 1}
                    sb_tokens(toks): body
                    sb_emit(plain): toks false
                    concat(stored): "=" plain
                ]
                elif(_): {(vtype = "float" || vtype = "percentage" || vtype = "currency") && tval = "string"} [ set(stored): value ]
                elif(_): {vtype = "boolean"} [
                    set(stored): "FALSE"
                    if(_): {bvalue = "true"} [ set(stored): "TRUE" ]
                ]
                if(_): {stored != ""} [
                    set(k): 0
                    while(_): {k < cols_rep && col + k < SB_COLS} [
                        vec(entry): ""
                        push(_): entry {col + k}
                        push(_): entry stored
                        push(_): rowbuf entry
                        set(k): {k + 1}
                    ]
                ]
                set(col): {col + cols_rep}
                set(in_cell): false
                set(in_p): false
            ]
        ]
    ]
]

sbsheetload(r): text kind [
    sbsheetreset(_):
    if(_): {kind = "csv"} [ sb_load_csv(r): text ]
    else(_): [ sb_load_fods(r): text ]
]

