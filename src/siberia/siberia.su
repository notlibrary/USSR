# The tag at s[i] = "<": [kind name attrs end]; kind is "open", "close",
# "empty" or "other" (declarations, comments), end the index past ">".
sb_xml_tag(r): s i [
    len(n): s
    set(j): {i + 1}
    set(q): 0
    set(go): {j < n}
    while(_): go [
        byte(b): s j
        if(_): {q != 0} [
            if(_): {b = q} [ set(q): 0 ]
            set(j): {j + 1}
        ]
        elif(_): {b = 34 || b = 39} [
            set(q): b
            set(j): {j + 1}
        ]
        elif(_): {b = 62} [ set(go): false ]
        else(_): [ set(j): {j + 1} ]
        if(_): {j >= n} [ set(go): false ]
    ]
    slice(inner): s {i + 1} {j - i - 1}
    len(m): inner
    set(kind): "open"
    set(name): ""
    set(attrs): ""
    if(_): {m > 0} [
        byte(first): inner 0
        byte(last): inner {m - 1}
        if(_): {first = 47} [
            set(kind): "close"
            slice(name): inner 1 {m - 1}
            str_trim(name): name
        ]
        elif(_): {first = 63 || first = 33} [ set(kind): "other" ]
        else(_): [
            if(_): {last = 47} [
                set(kind): "empty"
                slice(inner): inner 0 {m - 1}
                set(m): {m - 1}
            ]
            set(k): 0
            set(go): {k < m}
            while(_): go [
                byte(c): inner k
                if(_): {c = 32 || c = 9 || c = 10 || c = 13} [ set(go): false ]
                else(_): [
                    set(k): {k + 1}
                    set(go): {k < m}
                ]
            ]
            slice(name): inner 0 k
            slice(attrs): inner k {m - k}
        ]
    ]
    vec(r): ""
    push(_): r kind
    push(_): r name
    push(_): r attrs
    push(_): r {j + 1}
]

# An attribute's value from a tag's attribute text, or null.
sb_xml_attr(r): attrs name [
    set(r): null
    concat(key): name "=\""
    len(kl): key
    set(pos): 0
    set(go): true
    while(_): go [
        str_find(pos): attrs key pos
        set(go): false
        if(_): {pos > 0} [
            byte(before): attrs {pos - 1}
            if(_): {before = 32 || before = 9 || before = 10 || before = 13} [
                set(from): {pos + kl}
                str_find(close): attrs "\"" from
                if(_): {close >= 0} [
                    slice(v): attrs from {close - from}
                    sb_xml_unescape(r): v
                ]
            ]
            else(_): [
                set(pos): {pos + 1}
                set(go): true
            ]
        ]
    ]
]

sb_attr_int(r): attrs name default [
    sb_xml_attr(v): attrs name
