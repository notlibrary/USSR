    set(r): 0
]

sb_is_dirty(r): [
    set(r): sb_dirty?
    if(_): {r != true} [ set(r): false ]
]

# New, open, save and save as, asking first when changes would be lost.
sb_action(r): action [
    set(r): 0
    sb_status(_): ""
    sb_is_dirty(dirty):
    if(_): {(action = "new" || action = "open") && dirty} [
        set(sb_dlg_next): action!
        set(sb_dialog): "discard"!
        return(_): r
    ]
    if(_): {action = "new"} [ sb_new(_): ]
    elif(_): {action = "open"} [ sb_dialog_open(_): "open" ]
    elif(_): {action = "save"} [
        set(path): sb_path?
        if(_): {path = ""} [ sb_dialog_open(_): "save" ]
        else(_): [ sb_save(_): path ]
    ]
    elif(_): {action = "saveas"} [ sb_dialog_open(_): "save" ]
]

sb_new(r): [
$ifdef SB_PAD
    set(mode): sb_mode?
    if(_): {mode = "pad"} [ sbpadreset(_): ] else(_): [ sb_sheet_new(_): ]
$else
    sb_sheet_new(_):
$endif
    set(sb_path): ""!
    set(sb_dirty): false!
    set(r): 0
]

sb_sheet_new(r): [
    sbsheetreset(_):
    set(sb_row): 0!
    set(sb_col): 0!
    set(sb_top): 0!
    set(sb_left): 0!
    set(sb_edit): false!
    set(sb_buf): ""!
    set(r): 0
]

sb_open(r): path [
    set(r): false
$ifdef SB_PAD
    set(mode): sb_mode?
$endif
    sb_extension(ext): path
    if(_): {ext = ".ods" || ext = ".odt" || ext = ".xlsx" || ext = ".docx"} [
        sb_status(_): "Packed (zip) files are not supported: save it as flat ODF (.fods/.fodt) first"
        return(_): r
    ]
    sb_read(text): path
    typeof(tt): text
    if(_): {tt != "string"} [
        concat(msg): "Cannot read " path
        sb_status(_): msg
        return(_): r
    ]
$ifdef SB_PAD
    if(_): {mode = "pad"} [
        set(kind): "txt"
        if(_): {ext = ".fodt"} [ set(kind): "fodt" ]
        sbpadload(err): text kind
        sb_apply_font(_):
        sb_pad_tool_labels(_):
    ]
    else(_): [
$endif
        set(kind): "fods"
        if(_): {ext = ".csv" || ext = ".txt"} [ set(kind): "csv" ]
        sb_sheet_new(_):
        sbsheetload(err): text kind
$ifdef SB_PAD
    ]
$endif
    if(_): {err != ""} [
        concat(msg): "Cannot open " path ": " err
        sb_status(_): msg
        return(_): r
    ]
    set(sb_path): path!
    set(sb_dirty): false!
    sb_basename(base): path
    concat(msg): "Opened " base
    sb_status(_): msg
    set(r): true
]

sb_save(r): path [
    set(r): false
$ifdef SB_PAD
    set(mode): sb_mode?
$endif
    sb_extension(ext): path
    if(_): {ext = ".ods" || ext = ".odt" || ext = ".xlsx" || ext = ".docx"} [
        sb_status(_): "Packed (zip) files are not supported: use .fods or .fodt"
        return(_): r
    ]
$ifdef SB_PAD
    if(_): {ext = ""} [
        if(_): {mode = "pad"} [ concat(path): path ".fodt" ] else(_): [ concat(path): path ".fods" ]
        sb_extension(ext): path
    ]
    if(_): {mode = "pad"} [
        if(_): {ext = ".fodt"} [ sbpadfodt(text): ] else(_): [ sbpadtext(text): ]
    ]
    else(_): [
        if(_): {ext = ".csv"} [ sbsheetcsv(text): ] else(_): [ sbsheetfods(text): ]
    ]
$else
    if(_): {ext = ""} [
        concat(path): path ".fods"
        sb_extension(ext): path
    ]
    if(_): {ext = ".csv"} [ sbsheetcsv(text): ] else(_): [ sbsheetfods(text): ]
$endif
    sb_write(ok): path text
    if(_): ok [
        set(sb_path): path!
        set(sb_dirty): false!
        sb_basename(base): path
        concat(msg): "Saved " base
        if(_): {ext = ".csv"} [ concat(msg): msg " (formulas as their values)" ]
        sb_status(_): msg
        set(r): true
    ]
    else(_): [
        concat(msg): "Cannot write " path
        sb_status(_): msg
    ]
]

# A key while the dialog is up.
sb_dialog_key(r): key [
    set(r): 0
    set(kind): sb_dialog?
    set(ctrl): sb_ctrl?
    if(_): {key = SB_KEY_ESC} [ set(sb_dialog): ""! ]
    elif(_): {key = SB_KEY_ENTER || key = SB_KEY_KP_ENTER} [
        set(sb_dialog): ""!
        if(_): {kind = "discard"} [
            set(next): sb_dlg_next?
            set(sb_dirty): false!
            sb_action(_): next
        ]
        else(_): [
            set(text): sb_dlg_text?
            str_trim(text): text
            if(_): {text != ""} [
                if(_): {kind = "open"} [ sb_open(_): text ] else(_): [ sb_save(_): text ]
            ]
        ]
    ]
    elif(_): {key = SB_KEY_BACKSPACE} [
        set(text): sb_dlg_text?
        sb_drop_last(text): text
        set(sb_dlg_text): text!
    ]
    elif(_): {key = 85 && ctrl = true} [ set(sb_dlg_text): ""! ]
]

sb_dialog_char(r): s [
    set(kind): sb_dialog?
    if(_): {kind != "discard"} [
        set(text): sb_dlg_text?
        concat(text): text s
        set(sb_dlg_text): text!
    ]
    set(r): 0
]

sb_modifier(r): key down [
    set(r): true
    if(_): {key = 340 || key = 344} [ set(sb_shift): down! ]
    elif(_): {key = 341 || key = 345} [ set(sb_ctrl): down! ]
    elif(_): {key = 342 || key = 346} [ set(sb_alt): down! ]
    else(_): [ set(r): false ]
]

# Ctrl shortcuts both modes share; true when the key was one.
sb_common_key(r): key [
    set(r): false
    set(ctrl): sb_ctrl?
    set(shift): sb_shift?
    if(_): {ctrl != true} [
        if(_): {key = SB_KEY_F1} [
            sb_help(_):
            set(r): true
        ]
        return(_): r
    ]
    set(r): true
    if(_): {key = 78} [ sb_action(_): "new" ]
    elif(_): {key = 79} [ sb_action(_): "open" ]
    elif(_): {key = 83 && shift = true} [ sb_action(_): "saveas" ]
    elif(_): {key = 83} [ sb_action(_): "save" ]
    elif(_): {key = 81} [
        set(window): sb_window?
        close(_): window
    ]
    else(_): [ set(r): false ]
]

sb_help(r): [
$ifdef SB_PAD
    set(mode): sb_mode?
$endif
    set(title): "Siberia"
$ifdef SB_PAD
    if(_): {mode = "pad"} [
        set(title): "Novosibirsk"
        set(text): "Type to write. Arrows, Home/End, Ctrl+Home/End and Page Up/Down move the cursor. FONT picks a system font; - and + change the size, B and I make the text bold or italic (Ctrl+B, Ctrl+I, Ctrl+[ and Ctrl+]). Ctrl+N new, Ctrl+O open, Ctrl+S save, Ctrl+Shift+S save as, Ctrl+Q quit. Files: .fodt (OpenDocument text) or .txt."
    ]
    else(_): [
$else
    if(_): true [
$endif
        set(text): "Arrows, Tab, Enter, Page Up/Down and Ctrl+Home move between cells. Type to replace a cell, F2 to change it, Enter to keep it, Esc to cancel, Delete to clear. Formulas start with =: + - * / ^ & %, comparisons, A1 references, A1:B5 ranges and SUM AVERAGE MIN MAX COUNT ABS INT ROUND SQRT MOD POWER IF AND OR NOT LEN UPPER LOWER PI. Ctrl+N new, Ctrl+O open, Ctrl+S save, Ctrl+Shift+S save as, Ctrl+Q quit. Files: .fods (OpenDocument) or .csv."
    ]
    messagebox(_): title text
    set(r): 0
]

# --- the GUI: sheet -----------------------------------------------------------

sb_visible_rows(r): h [
    str_trunc(r): {(h - SB_BARH - SB_ROWH - SB_STATUSH) / SB_ROWH}
    if(_): {r < 1} [ set(r): 1 ]
]

sb_visible_cols(r): w [
    str_trunc(r): {(w - SB_HEADW) / SB_COLW}
    if(_): {r < 1} [ set(r): 1 ]
]

# Scrolls so that the current cell is in view.
sb_reveal(r): [
    sb_canvas_size(size):
    at(w): size 0
    at(h): size 1
    sb_visible_rows(vr): h
    sb_visible_cols(vc): w
    set(row): sb_row?
    set(col): sb_col?
    set(top): sb_top?
    set(left): sb_left?
    if(_): {row < top} [ set(top): row ]
    if(_): {row >= top + vr} [ set(top): {row - vr + 1} ]
    if(_): {col < left} [ set(left): col ]
    if(_): {col >= left + vc} [ set(left): {col - vc + 1} ]
    set(sb_top): top!
    set(sb_left): left!
    set(r): 0
]

sb_sheet_draw(r): [
    set(canvas): sb_canvas?
    sb_canvas_size(size):
    at(w): size 0
    at(h): size 1
    canvasclear(_): canvas 16777215
    set(row): sb_row?
    set(col): sb_col?
    set(top): sb_top?
    set(left): sb_left?
    set(editing): sb_edit?
    set(index): {row * SB_COLS + col}
    # formula bar
    canvasfill(_): canvas 0 0 w SB_BARH 16250871
    canvasline(_): canvas 0 {SB_BARH - 1} w {SB_BARH - 1} 13158600
    sb_cellname(name): index
    sb_ui_text(_): 10 6 name 2236962
    canvasline(_): canvas 64 4 64 {SB_BARH - 5} 13158600
    if(_): {editing = true} [ set(content): sb_buf? ]
    else(_): [
        sb_cell(cur): index
        getf(content): cur "text"
    ]
    sb_fit(shown): content {w - 90}
    sb_ui_text(_): 74 6 shown 0
    if(_): {editing = true} [
        sb_ui_width(cw): shown
        canvasfill(_): canvas {75 + cw} 6 1 16 0
    ]
    # headers
    sb_visible_rows(vr): h
    sb_visible_cols(vc): w
    set(gy): {SB_BARH + SB_ROWH}
    canvasfill(_): canvas 0 SB_BARH w SB_ROWH 15329769
    canvasfill(_): canvas 0 SB_BARH SB_HEADW {h - SB_BARH - SB_STATUSH} 15329769
    set(c): 0
    while(_): {c <= vc && left + c < SB_COLS} [
        set(x): {SB_HEADW + c * SB_COLW}
        sb_colname(cn): {left + c}
        sb_ui_width(cnw): cn
        set(fill): 15329769
        if(_): {left + c = col} [
            canvasfill(_): canvas x SB_BARH SB_COLW SB_ROWH 13883606
        ]
        str_trunc(cx): {x + (SB_COLW - cnw) / 2}
        sb_ui_text(_): cx {SB_BARH + 3} cn 3355443
        canvasline(_): canvas {x + SB_COLW} SB_BARH {x + SB_COLW} {h - SB_STATUSH} 14211288
        set(c): {c + 1}
    ]
    set(k): 0
    while(_): {k <= vr && top + k < SB_ROWS} [
        set(y): {gy + k * SB_ROWH}
        if(_): {top + k = row} [
            canvasfill(_): canvas 0 y SB_HEADW SB_ROWH 13883606
        ]
        str_from_int(rn): {top + k + 1}
        sb_ui_width(rnw): rn
        str_trunc(rx): {(SB_HEADW - rnw) / 2}
        sb_ui_text(_): rx {y + 3} rn 3355443
        canvasline(_): canvas 0 {y + SB_ROWH} w {y + SB_ROWH} 14211288
        set(k): {k + 1}
    ]
    canvasline(_): canvas SB_HEADW SB_BARH SB_HEADW {h - SB_STATUSH} 11842740
    canvasline(_): canvas 0 gy w gy 11842740
    # cells
    set(k): 0
    while(_): {k <= vr && top + k < SB_ROWS} [
        set(c): 0
        while(_): {c <= vc && left + c < SB_COLS} [
            set(ci): {(top + k) * SB_COLS + left + c}
            sb_cell(cell): ci
            getf(text): cell "text"
            if(_): {text != "" && (ci != index || editing != true)} [
                sb_value(v): ci
                sb_show_value(s): v
                sb_fit(s): s {SB_COLW - 8}
                sb_is_number(isn): v
                sb_is_err(ise): v
                set(color): 0
                if(_): ise [ set(color): 12592896 ]
                set(x): {SB_HEADW + c * SB_COLW + 4}
                if(_): isn [
                    sb_ui_width(sw): s
                    set(x): {SB_HEADW + (c + 1) * SB_COLW - 4 - sw}
                ]
                sb_ui_text(_): x {gy + k * SB_ROWH + 3} s color
            ]
            set(c): {c + 1}
        ]
        set(k): {k + 1}
    ]
    # the current cell
    if(_): {row >= top && col >= left} [
        set(x): {SB_HEADW + (col - left) * SB_COLW}
        set(y): {gy + (row - top) * SB_ROWH}
        if(_): {editing = true} [
            set(buf): sb_buf?
            canvasfill(_): canvas {x + 1} {y + 1} {SB_COLW - 1} {SB_ROWH - 1} 16777215
            sb_ui_width(bw): buf
            set(shown): buf
            while(_): {bw > SB_COLW - 10} [
                utf8_next(cut): shown 0
                len(sl): shown
                slice(shown): shown cut {sl - cut}
                sb_ui_width(bw): shown
            ]
            sb_ui_text(_): {x + 4} {y + 3} shown 0
            canvasfill(_): canvas {x + 5 + bw} {y + 3} 1 16 0
        ]
        canvasrect(_): canvas x y {SB_COLW + 1} {SB_ROWH + 1} 2192198
        canvasrect(_): canvas {x + 1} {y + 1} {SB_COLW - 1} {SB_ROWH - 1} 2192198
    ]
    sb_draw_status(_): w h
    sb_draw_dialog(_): w h
    set(r): 0
]

sb_sheet_move(r): drow dcol [
    set(row): sb_row?
    set(col): sb_col?
    set(row): {row + drow}
    set(col): {col + dcol}
    if(_): {row < 0} [ set(row): 0 ]
    if(_): {col < 0} [ set(col): 0 ]
    if(_): {row >= SB_ROWS} [ set(row): {SB_ROWS - 1} ]
    if(_): {col >= SB_COLS} [ set(col): {SB_COLS - 1} ]
    set(sb_row): row!
    set(sb_col): col!
    sb_reveal(_):
    set(r): 0
]

sb_sheet_commit(r): [
    set(editing): sb_edit?
    if(_): {editing = true} [
        set(buf): sb_buf?
        set(row): sb_row?
        set(col): sb_col?
        sb_set_index(_): {row * SB_COLS + col} buf
        set(sb_edit): false!
        set(sb_dirty): true!
    ]
    set(r): 0
]

sb_sheet_key(r): key [
    set(r): 0
    set(editing): sb_edit?
    set(shift): sb_shift?
    set(ctrl): sb_ctrl?
    sb_canvas_size(size):
    at(h): size 1
    sb_visible_rows(vr): h
    set(back): {shift = true}
    if(_): {editing = true} [
        if(_): {key = SB_KEY_ESC} [ set(sb_edit): false! ]
        elif(_): {key = SB_KEY_BACKSPACE} [
            set(buf): sb_buf?
            sb_drop_last(buf): buf
            set(sb_buf): buf!
        ]
        elif(_): {key = SB_KEY_ENTER || key = SB_KEY_KP_ENTER} [
            sb_sheet_commit(_):
            if(_): back [ sb_sheet_move(_): {0 - 1} 0 ] else(_): [ sb_sheet_move(_): 1 0 ]
        ]
        elif(_): {key = SB_KEY_TAB} [
            sb_sheet_commit(_):
            if(_): back [ sb_sheet_move(_): 0 {0 - 1} ] else(_): [ sb_sheet_move(_): 0 1 ]
        ]
        elif(_): {key = SB_KEY_UP} [
            sb_sheet_commit(_):
            sb_sheet_move(_): {0 - 1} 0
        ]
        elif(_): {key = SB_KEY_DOWN} [
            sb_sheet_commit(_):
            sb_sheet_move(_): 1 0
        ]
        elif(_): {key = SB_KEY_LEFT} [
            sb_sheet_commit(_):
            sb_sheet_move(_): 0 {0 - 1}
        ]
        elif(_): {key = SB_KEY_RIGHT} [
            sb_sheet_commit(_):
            sb_sheet_move(_): 0 1
        ]
        return(_): r
    ]
    set(row): sb_row?
    set(col): sb_col?
    if(_): {key = SB_KEY_UP} [ sb_sheet_move(_): {0 - 1} 0 ]
    elif(_): {key = SB_KEY_DOWN || key = SB_KEY_ENTER || key = SB_KEY_KP_ENTER} [
        if(_): {back && key != SB_KEY_DOWN} [ sb_sheet_move(_): {0 - 1} 0 ] else(_): [ sb_sheet_move(_): 1 0 ]
    ]
    elif(_): {key = SB_KEY_LEFT} [ sb_sheet_move(_): 0 {0 - 1} ]
    elif(_): {key = SB_KEY_RIGHT} [ sb_sheet_move(_): 0 1 ]
    elif(_): {key = SB_KEY_TAB} [
        if(_): back [ sb_sheet_move(_): 0 {0 - 1} ] else(_): [ sb_sheet_move(_): 0 1 ]
    ]
    elif(_): {key = SB_KEY_PAGE_UP} [ sb_sheet_move(_): {0 - vr} 0 ]
    elif(_): {key = SB_KEY_PAGE_DOWN} [ sb_sheet_move(_): vr 0 ]
    elif(_): {key = SB_KEY_HOME && ctrl = true} [ sb_sheet_move(_): {0 - row} {0 - col} ]
    elif(_): {key = SB_KEY_HOME} [ sb_sheet_move(_): 0 {0 - col} ]
    elif(_): {key = SB_KEY_END && ctrl = true} [
        set(mr): sb_maxrow?
        set(mc): sb_maxcol?
        if(_): {mr < 0} [ set(mr): 0 ]
        if(_): {mc < 0} [ set(mc): 0 ]
        sb_sheet_move(_): {mr - row} {mc - col}
    ]
    elif(_): {key = SB_KEY_F2} [
        sb_cell(cell): {row * SB_COLS + col}
        getf(text): cell "text"
        set(sb_buf): text!
        set(sb_edit): true!
    ]
    elif(_): {key = SB_KEY_DELETE} [
        sb_set_index(_): {row * SB_COLS + col} ""
        set(sb_dirty): true!
    ]
    elif(_): {key = SB_KEY_BACKSPACE} [
        set(sb_buf): ""!
        set(sb_edit): true!
    ]
]

sb_sheet_char(r): s [
    set(editing): sb_edit?
    if(_): {editing = true} [
        set(buf): sb_buf?
        concat(buf): buf s
        set(sb_buf): buf!
    ]
    else(_): [
        set(sb_buf): s!
        set(sb_edit): true!
    ]
    set(r): 0
]

sb_sheet_click(r): x y double [
    set(r): 0
    set(top): sb_top?
    set(left): sb_left?
    set(gy): {SB_BARH + SB_ROWH}
    if(_): {x < SB_HEADW || y < gy} [ return(_): r ]
    str_trunc(c): {(x - SB_HEADW) / SB_COLW}
    str_trunc(k): {(y - gy) / SB_ROWH}
    set(row): {top + k}
    set(col): {left + c}
    if(_): {row >= SB_ROWS || col >= SB_COLS} [ return(_): r ]
    sb_sheet_commit(_):
    set(sb_row): row!
    set(sb_col): col!
    sb_reveal(_):
    if(_): double [
        sb_cell(cell): {row * SB_COLS + col}
        getf(text): cell "text"
        set(sb_buf): text!
        set(sb_edit): true!
    ]
]

sb_sheet_wheel(r): direction [
    set(top): sb_top?
    set(top): {top - direction * 3}
    if(_): {top < 0} [ set(top): 0 ]
    if(_): {top > SB_ROWS - 1} [ set(top): {SB_ROWS - 1} ]
    set(sb_top): top!
    set(r): 0
]

# --- the GUI: events ----------------------------------------------------------

sb_redraw(r): [
$ifdef SB_PAD
    set(mode): sb_mode?
    if(_): {mode = "pad"} [ sb_pad_draw(r): ] else(_): [ sb_sheet_draw(r): ]
$else
    sb_sheet_draw(r):
$endif
]

sbkey(r): key [
    uilock(_):
    sb_modifier(mod): key true
    if(_): {mod = false} [
        set(sb_pfollow): true!
        set(dialog): sb_dialog?
$ifdef SB_PAD
        set(mode): sb_mode?
$endif
        if(_): {dialog != ""} [ sb_dialog_key(_): key ]
        else(_): [
            sb_common_key(used): key
            if(_): {used = false} [
$ifdef SB_PAD
                if(_): {mode = "pad"} [ sb_pad_key_gui(_): key ] else(_): [ sb_sheet_key(_): key ]
$else
                sb_sheet_key(_): key
$endif
            ]
        ]
        sb_redraw(_):
    ]
    uiunlock(_):
    set(r): 0
]

sbkeyup(r): key [
    sb_modifier(_): key false
    set(r): 0
]

sbchar(r): cp [
    uilock(_):
    set(ctrl): sb_ctrl?
    set(alt): sb_alt?
    if(_): {ctrl != true || alt = true} [
        set(sb_pfollow): true!
        sb_utf8(s): cp
        set(dialog): sb_dialog?
$ifdef SB_PAD
        set(mode): sb_mode?
$endif
        if(_): {dialog != ""} [ sb_dialog_char(_): s ]
$ifdef SB_PAD
        elif(_): {mode = "pad"} [ sb_pad_char(_): s ]
$endif
        else(_): [ sb_sheet_char(_): s ]
        sb_redraw(_):
    ]
    uiunlock(_):
    set(r): 0
]

sbclick(r): x y double [
    uilock(_):
    set(dialog): sb_dialog?
$ifdef SB_PAD
    set(mode): sb_mode?
$endif
    if(_): {dialog = ""} [
        set(sb_pfollow): true!
$ifdef SB_PAD
        if(_): {mode = "pad"} [
            if(_): {double = false} [ sb_pad_click(_): x y ]
        ]
        else(_): [ sb_sheet_click(_): x y double ]
$else
        sb_sheet_click(_): x y double
$endif
        sb_redraw(_):
    ]
    uiunlock(_):
    set(r): 0
]

sbwheel(r): direction [
    uilock(_):
$ifdef SB_PAD
    set(mode): sb_mode?
    if(_): {mode = "pad"} [ sb_pad_wheel(_): direction ]
    else(_): [ sb_sheet_wheel(_): direction ]
$else
    sb_sheet_wheel(_): direction
$endif
    sb_redraw(_):
    uiunlock(_):
    set(r): 0
]

sbtool(r): button [
    uilock(_):
    set(buttons): sb_buttons?
    len(n): buttons
    set(action): ""
    set(i): 0
    while(_): {i < n} [
        at(entry): buttons i
        at(handle): entry 0
        if(_): {handle = button} [ at(action): entry 1 ]
        set(i): {i + 1}
    ]
    set(dialog): sb_dialog?
    if(_): {dialog = ""} [
        set(mode): sb_mode?
        if(_): {mode != "pad"} [ sb_sheet_commit(_): ]
        if(_): {action = "new" || action = "open" || action = "save" || action = "saveas"} [ sb_action(_): action ]
        elif(_): {action = "help"} [ sb_help(_): ]
$ifdef SB_PAD
        elif(_): {mode = "pad"} [ sb_pad_tool(_): action ]
$endif
    ]
$ifdef SB_PAD
    set(mode): sb_mode?
    if(_): {mode = "pad"} [ sb_pad_tool_labels(_): ]
$endif
    sb_redraw(_):
    uiunlock(_):
    set(r): 0
]

sbfocus(r): focused [
    set(sb_shift): false!
    set(sb_ctrl): false!
    set(sb_alt): false!
    set(r): 0
]

sb_add_button(r): bar label action [
    button(r): bar label
    on(_): r "click" "sb_app_tool"
    set(buttons): sb_buttons?
    vec(entry): ""
    push(_): entry r
    push(_): entry action
    push(_): buttons entry
]

# Builds the toolbar and the canvas of window for mode ("sheet" or
# "pad"); returns the canvas.
sbinitialize(canvas): window mode [
    sbsetup(_):
    sbbuild(canvas): window mode
]

# sbinitialize after sbsetup (or sbstate) has run.
sbbuild(canvas): window mode [
    set(sb_window): window!
    set(sb_mode): mode!
    sb_find_ui_font(ui):
    set(sb_uifont): ui!
    toolbar(bar): window
    sb_add_button(_): bar "NEW" "new"
    sb_add_button(_): bar "OPEN" "open"
    sb_add_button(_): bar "SAVE" "save"
    sb_add_button(_): bar "SAVE AS" "saveas"
$ifdef SB_PAD
    if(_): {mode = "pad"} [ sb_pad_toolbar(_): bar ]
    else(_): [ sb_sheet_new(_): ]
$else
    sb_sheet_new(_):
$endif
    sb_add_button(_): bar "HELP" "help"
    canvas(canvas): window
    set(sb_canvas): canvas!
    pack(_): canvas true
$ifdef SB_PAD
    if(_): {mode = "pad"} [ sb_pad_tool_labels(_): ]
$endif
    sb_redraw(_):
]

# `ussr src/siberia/siberia.su` runs the spreadsheet and
# `ussr src/novosibirsk/novosibirsk.su` the pad: the started file defines
# SB_APP for the window callbacks and sb_app_main. Scripts that $include
# siberia.su (the tests) keep their own init.
$ifdef __MAIN__
$define SB_APP 1
$endif
$ifdef SB_APP
sb_app_tool(result): button [
    sbtool(_): button
]

sb_app_pointer(result): canvas x y [
    sbclick(_): x y false
]

sb_app_double(result): canvas x y [
    sbclick(_): x y true
]

sb_app_wheel(result): canvas x y direction [
    sbwheel(_): direction
]

sb_app_key(result): window key [
    sbkey(_): key
]

sb_app_keyup(result): window key [
    sbkeyup(_): key
]

sb_app_char(result): window cp [
    sbchar(_): cp
]

sb_app_focus(result): window focused [
    sbfocus(_): focused
]

# Redraws when the window changes size.
sb_app_tick(result): window [
    set(result): 0
    set(last): ""
    set(go): true
    while(_): go [
        sleep(_): 500
        alive(go): window
        if(_): go [
            set(canvas): sb_canvas?
            getwidth(w): canvas
            getheight(h): canvas
            str_from_int(ws): w
            str_from_int(hs): h
            concat(now): ws "x" hs
            if(_): {now != last} [
                set(last): now
                uilock(_):
                sb_redraw(_):
                uiunlock(_):
            ]
        ]
    ]
]

# Runs the window for mode ("sheet" or "pad") on the file named by the
# arguments, if any; usage is printed when they are wrong.
sb_app_main(result): mode title usage arg_count arg_values [
    set(result): 0
    set(file): ""
    set(bad): false
    set(i): 0
    while(_): {i < arg_count} [
        at(a): arg_values i
        sb_starts(opt): a "-"
        if(_): {opt || file != ""} [ set(bad): true ] else(_): [ set(file): a ]
        set(i): {i + 1}
    ]
    if(_): bad [
        print(_): usage
        set(result): 2
        return(_): result
    ]
    createwindow(window): title SB_WIDTH SB_HEIGHT
    sbinitialize(canvas): window mode
    if(_): {file != ""} [
        file_exists(e): file
        if(_): e [ sb_open(_): file ]
        else(_): [
            set(sb_path): file!
            sb_basename(base): file
            concat(msg): "New file " base
            sb_status(_): msg
        ]
    ]
    on(_): canvas "pointer" "sb_app_pointer"
    on(_): canvas "double" "sb_app_double"
    on(_): canvas "wheel" "sb_app_wheel"
    on(_): window "key" "sb_app_key"
    on(_): window "keyup" "sb_app_keyup"
    on(_): window "char" "sb_app_char"
    on(_): window "focus" "sb_app_focus"
    show(_): window
    async(_): "sb_app_tick" window
    run(_):
    sleep(_): 150
    uilock(_):
    sb_redraw(_):
    uiunlock(_):
]
$endif

$ifdef __MAIN__
init(result): arg_count arg_values [
    sb_app_main(result): "sheet" "Siberia" "usage: ussr siberia.su [file.fods|file.csv]" arg_count arg_values
]
$endif
