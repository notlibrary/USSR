            sb_ui_width(tw): shown
        ]
        sb_ui_text(_): {x + 20} {y + 45} shown 0
        canvasfill(_): canvas {x + 21 + tw} {y + 44} 2 20 0
        set(hint): ".fods or .csv"
$ifdef SB_PAD
        set(mode): sb_mode?
        if(_): {mode = "pad"} [ set(hint): ".fodt or .txt" ]
$endif
        concat(hint): "Enter: OK    Esc: cancel    Formats: " hint
        sb_ui_text(_): {x + 14} {y + 82} hint 6316128
    ]
]

sb_dialog_open(r): kind [
    set(sb_dialog): kind!
    set(path): sb_path?
$ifdef SB_PAD
    set(mode): sb_mode?
$endif
    set(text): path
    if(_): {text = ""} [
        getcwd(cwd):
        set(name): "untitled.fods"
$ifdef SB_PAD
        if(_): {mode = "pad"} [ set(name): "untitled.fodt" ]
$endif
