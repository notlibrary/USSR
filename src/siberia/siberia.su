    str_trunc(y): {(h - bh) / 3}
    canvasfill(_): canvas {x + 3} {y + 3} bw bh 10066329
    canvasfill(_): canvas x y bw bh 16250871
    canvasrect(_): canvas x y bw bh 7368816
    set(title): "Open file"
    if(_): {kind = "save"} [ set(title): "Save as" ]
    if(_): {kind = "discard"} [ set(title): "Discard the unsaved changes?" ]
    sb_ui_text(_): {x + 14} {y + 12} title 2236962
    if(_): {kind = "discard"} [
        sb_ui_text(_): {x + 14} {y + 48} "Enter: discard them      Esc: keep editing" 4473924
    ]
    else(_): [
        canvasfill(_): canvas {x + 14} {y + 40} {bw - 28} 28 16777215
        canvasrect(_): canvas {x + 14} {y + 40} {bw - 28} 28 8421504
        set(text): sb_dlg_text?
        sb_ui_width(tw): text
        set(room): {bw - 48}
        set(shown): text
        # long paths show their end
