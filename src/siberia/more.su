    ]
    if(_): {name = "PERCENTILE" || name = "QUARTILE"} [
        at(a): args 0
        vec(one): ""
        push(_): one a
        sbm_nums(v): one
        sbm_num_arg(k): args 1
        if(_): {name = "QUARTILE"} [ set(k): {k / 4.0} ]
        len(nv): v
        if(_): {nv = 0 || k < 0 || k > 1} [
            set(r): numerr
            return(r): r
        ]
        list_sort(s): v
        set(pos): {k * (nv - 1)}
        sbm_int(lo): pos
        set(fr): {pos - lo}
        at(a1): s lo
        set(r): a1
        if(_): {lo + 1 < nv && fr > 0} [
            at(a2): s {lo + 1}
            set(r): {a1 + (a2 - a1) * fr}
        ]
        return(r): r
    ]
    # --- finance
    if(_): {name = "PMT" || name = "FV" || name = "PV"} [
        set(r): bad
        if(_): {n < 3} [ return(r): r ]
        sbm_num_arg(rate): args 0
        sbm_num_arg(np): args 1
        sbm_num_arg(c): args 2
        set(d): 0
        set(type): 0
        if(_): {n >= 4} [ sbm_num_arg(d): args 3 ]
        if(_): {n >= 5} [ sbm_num_arg(type): args 4 ]
        if(_): {rate = 0} [
            if(_): {name = "PMT"} [ set(r): {0 - (c + d) / np} ]
            elif(_): {name = "FV"} [ set(r): {0 - (d + c * np)} ]
            else(_): [ set(r): {0 - (d + c * np)} ]
            return(r): r
        ]
        pow(g): {1 + rate} np
        if(_): {name = "PMT"} [
            # c is pv, d is fv
            set(r): {0 - rate * (c * g + d) / ((1 + rate * type) * (g - 1))}
        ]
        elif(_): {name = "FV"} [
            # c is pmt, d is pv
            set(r): {0 - (d * g + c * (1 + rate * type) * (g - 1) / rate)}
        ]
        else(_): [
            # c is pmt, d is fv
            set(r): {0 - (d + c * (1 + rate * type) * (g - 1) / rate) / g}
        ]
        return(r): r
    ]
    if(_): {name = "NPV"} [
        sbm_num_arg(rate): args 0
        vec(rest): ""
        set(i): 1
        while(_): {i < n} [
            at(a): args i
            push(_): rest a
            set(i): {i + 1}
        ]
        sbm_nums(v): rest
        set(r): 0
        len(nv): v
        set(i): 0
        while(_): {i < nv} [
            at(x): v i
            pow(g): {1 + rate} {i + 1}
            set(r): {r + x / g}
            set(i): {i + 1}
        ]
        return(r): r
    ]
    if(_): {name = "IRR"} [
        at(a): args 0
        vec(one): ""
        push(_): one a
        sbm_nums(v): one
        set(rate): 0.1
        if(_): {n >= 2} [ sbm_num_arg(rate): args 1 ]
        len(nv): v
        set(k): 0
        while(_): {k < 100} [
            set(f): 0
            set(df): 0
            set(i): 0
            while(_): {i < nv} [
                at(x): v i
                pow(g): {1 + rate} i
                set(f): {f + x / g}
                set(df): {df - i * x / (g * (1 + rate))}
                set(i): {i + 1}
            ]
            if(_): {df = 0} [
                set(r): numerr
                return(r): r
            ]
            set(nr): {rate - f / df}
            abs(step): {nr - rate}
            set(rate): nr
            if(_): {step < 0.0000000001} [
                set(r): rate
                return(r): r
            ]
            set(k): {k + 1}
        ]
        set(r): numerr
        return(r): r
    ]
    # --- regression: pairs of ys and xs
    if(_): {name = "SLOPE" || name = "INTERCEPT" || name = "CORREL" || name = "FORECAST" || name = "TREND"} [
        set(off): 0
        set(x0): 0
        if(_): {name = "FORECAST"} [
            sbm_num_arg(x0): args 0
            set(off): 1
        ]
        at(ya): args off
        at(xa): args {off + 1}
        if(_): {name = "CORREL"} [
            at(xa): args 0
            at(ya): args 1
        ]
        if(_): {name = "TREND"} [ sbm_num_arg(x0): args 2 ]
        sbm_values(ys): ya
        sbm_values(xs): xa
        len(ny): ys
        len(nx): xs
        if(_): {ny != nx} [
            set(r): na
            return(r): r
        ]
        set(sx): 0
        set(sy): 0
        set(sxx): 0
        set(syy): 0
        set(sxy): 0
        set(k): 0
        set(i): 0
        while(_): {i < ny} [
            at(x): xs i
            at(y): ys i
            sbm_isnum(xn): x
            sbm_isnum(yn): y
            if(_): {xn && yn} [
                set(sx): {sx + x}
                set(sy): {sy + y}
                set(sxx): {sxx + x * x}
                set(syy): {syy + y * y}
                set(sxy): {sxy + x * y}
                set(k): {k + 1}
            ]
            set(i): {i + 1}
        ]
        set(dx): {k * sxx - sx * sx}
        if(_): {k < 2 || dx = 0} [
            set(r): div0
            return(r): r
        ]
        set(slope): {(k * sxy - sx * sy) / (dx * 1.0)}
        set(icpt): {(sy - slope * sx) / k}
        if(_): {name = "SLOPE"} [ set(r): slope ]
        elif(_): {name = "INTERCEPT"} [ set(r): icpt ]
        elif(_): {name = "CORREL"} [
            set(dy): {k * syy - sy * sy}
            sqrt(den): {dx * dy}
            if(_): {den = 0} [ set(r): div0 ]
            else(_): [ set(r): {(k * sxy - sx * sy) / den} ]
        ]
        else(_): [ set(r): {icpt + slope * x0} ]
        return(r): r
    ]
    # --- bits and bases
    if(_): {name = "BITAND" || name = "BITOR" || name = "BITXOR" || name = "BITLSHIFT" || name = "BITRSHIFT"} [
        sbm_num_arg(a): args 0
        sbm_num_arg(b): args 1
        sbm_int(a): a
        sbm_int(b): b
        if(_): {a < 0 || b < 0 && name != "BITLSHIFT" && name != "BITRSHIFT"} [
            set(r): numerr
            return(r): r
        ]
        if(_): {name = "BITAND"} [ set(r): {a & b} ]
        elif(_): {name = "BITOR"} [ set(r): {a | b} ]
        elif(_): {name = "BITXOR"} [ set(r): {(a | b) - (a & b)} ]
        elif(_): {name = "BITLSHIFT"} [ set(r): {a << b} ]
        else(_): [ set(r): {a >> b} ]
        return(r): r
    ]
    if(_): {name = "DEC2HEX" || name = "DEC2BIN" || name = "DEC2OCT"} [
        sbm_num_arg(x): args 0
        sbm_int(x): x
        set(base): 16
        if(_): {name = "DEC2BIN"} [ set(base): 2 ]
        if(_): {name = "DEC2OCT"} [ set(base): 8 ]
        set(places): 0
        if(_): {n >= 2} [ sbm_num_arg(places): args 1 ]
        if(_): {x < 0} [
            # ten digits' two's complement, as LibreOffice
            pow(lim): base 10
            set(x): {lim + x}
        ]
        sbm_to_base(r): x base
        len(rl): r
        while(_): {rl < places} [
            concat(r): "0" r
            set(rl): {rl + 1}
        ]
        return(r): r
    ]
    if(_): {name = "HEX2DEC" || name = "BIN2DEC" || name = "OCT2DEC"} [
        sbm_text_arg(s): args 0
        set(base): 16
        if(_): {name = "BIN2DEC"} [ set(base): 2 ]
        if(_): {name = "OCT2DEC"} [ set(base): 8 ]
        str_to_int(r): s base
        typeof(t): r
        if(_): {t != "integer"} [
            set(r): numerr
            return(r): r
        ]
        len(sl): s
        pow(lim): base 10
        if(_): {sl = 10 && r >= lim / 2} [ set(r): {r - lim} ]
        return(r): r
    ]
    if(_): {name = "SUBTOTAL"} [
        sbm_num_arg(f): args 0
        sbm_int(f): f
        if(_): {f > 100} [ set(f): {f - 100} ]
        vec(names): ""
        str_split(names): "AVERAGE COUNT COUNTA MAX MIN PRODUCT STDEV STDEVP SUM VAR VARP" " "
        if(_): {f < 1 || f > 11} [
            set(r): bad
            return(r): r
        ]
        at(fn): names {f - 1}
        vec(rest): ""
        set(i): 1
        while(_): {i < n} [
            at(a): args i
            push(_): rest a
            set(i): {i + 1}
        ]
        sb_call(r): fn rest
        return(r): r
    ]
    if(_): {name = "USSR"} [
        set(r): bad
        if(_): {n < 1} [ return(r): r ]
        sbm_text_arg(fname): args 0
        vec(vals): ""
        set(i): 1
        while(_): {i < n} [
            at(a): args i
            sbm_is_range(isr): a
            if(_): isr [
                sbm_values(vs): a
                push(_): vals vs
            ]
            else(_): [ push(_): vals a ]
            set(i): {i + 1}
        ]
        async(p): fname vals
        await(r): p
        if(_): {r = null} [ set(r): bad ]
        return(r): r
    ]
]

sbm_gcd(r): a b [
    abs(x): a
    abs(y): b
    while(_): {y != 0} [
        set(t): {x % y}
        set(x): y
        set(y): t
    ]
    set(r): x
]

sbm_to_base(r): x base [
    str_trunc(x): x
    set(d): "0123456789ABCDEF"
    set(r): ""
    if(_): {x = 0} [ set(r): "0" ]
    while(_): {x > 0} [
        set(k): {x % base}
        slice(c): d k 1
        concat(r): c r
        sbm_int(x): {x / base}
    ]
]

# a character index in s as a byte index
sbm_char_to_byte(r): s k [
    set(r): 0
    len(n): s
    set(c): 0
    while(_): {r < n && c < k} [
        set(r): {r + 1}
        set(go): true
        while(_): {go && r < n} [
            byte(b): s r
            if(_): {(b & 192) = 128} [ set(r): {r + 1} ]
            else(_): [ set(go): false ]
        ]
        set(c): {c + 1}
    ]
]

# --- names: "TAXES" = "B1", "DATA" = "A1:C10"

sbm_define(r): name ref [
    sb_upper(k): name
    set(names): sb_names?
    btput(_): names k ref
    set(sb_names): names!
    set(gen): sb_gen?
    set(sb_gen): {gen + 1}!
    set(r): 0
]

sbm_name(r): word [
    sb_err(r): "#NAME?"
    set(names): sb_names?
    btget(ref): names word null
    if(_): {ref = null} [ return(r): r ]
    str_find(colon): ref ":" 0
    if(_): {colon > 0} [
        slice(a): ref 0 colon
        len(rl): ref
        slice(b): ref {colon + 1} {rl - colon - 1}
        sb_ref(ia): a
        sb_ref(ib): b
        sb_range(r): ia ib
    ]
    else(_): [
        sb_ref(i): ref
        if(_): {i < 0} [ sb_err(r): "#REF!" ]
        else(_): [ sb_value(r): i ]
    ]
]

# --- whole-sheet helpers

sbm_used(r): [
    set(mr): sb_maxrow?
    set(mc): sb_maxcol?
    vec(r): ""
    push(_): r mr
    push(_): r mc
]

sbm_text_at(r): row col [
    sb_cell(c): {row * SB_COLS + col}
    getf(r): c "text"
]

sbm_put(r): row col text [
    set(r): 0
    if(_): {row < 0 || col < 0 || row >= SB_ROWS || col >= SB_COLS} [ return(r): r ]
    sbm_text_at(old): row col
    if(_): {old = text} [ return(r): r ]
    sbm_record(_): row col old text
    sb_set_index(_): {row * SB_COLS + col} text
]

# --- undo: [index old new] changes, grouped by sbm_mark

sbm_record(r): row col old new [
    set(u): sb_undo?
    vec(e): ""
    push(_): e {row * SB_COLS + col}
    push(_): e old
    push(_): e new
    push(_): u e
    set(sb_undo): u!
    vec(none): ""
    set(sb_redo): none!
    set(r): 0
]

# a boundary: one undo goes back to the last mark
sbm_mark(r): [
    set(u): sb_undo?
    push(_): u "mark"
    set(sb_undo): u!
    set(r): 0
]

sbm_undo(r): [
    set(u): sb_undo?
    set(rd): sb_redo?
    set(r): 0
    len(n): u
    # past the marks at the end
    while(_): {n > 0} [
        at(top): u {n - 1}
        typeof(t): top
        if(_): {t = "string"} [
            pop(_): u
            set(n): {n - 1}
        ]
        else(_): [ set(n): {0 - n} ]
    ]
    set(n): {0 - n}
    if(_): {n <= 0} [ return(r): r ]
    push(_): rd "mark"
    set(go): true
    while(_): go [
        len(n): u
        if(_): {n = 0} [ set(go): false ]
        else(_): [
            at(top): u {n - 1}
            typeof(t): top
            if(_): {t = "string"} [ set(go): false ]
            else(_): [
                pop(e): u
                at(i): e 0
                at(old): e 1
                sb_set_index(_): i old
                push(_): rd e
                set(r): {r + 1}
            ]
        ]
    ]
    set(sb_undo): u!
    set(sb_redo): rd!
]

sbm_redo(r): [
    set(u): sb_undo?
    set(rd): sb_redo?
    set(r): 0
    set(go): true
    set(started): false
    while(_): go [
        len(n): rd
        if(_): {n = 0} [ set(go): false ]
        else(_): [
            pop(e): rd
            typeof(t): e
            if(_): {t = "string"} [
                if(_): started [ set(go): false ]
                push(_): u "mark"
            ]
            else(_): [
                set(started): true
                at(i): e 0
                at(nw): e 2
                sb_set_index(_): i nw
                push(_): u e
                set(r): {r + 1}
            ]
        ]
    ]
    set(sb_undo): u!
    set(sb_redo): rd!
]

# --- references in formulas, moved

# a reference ("$B3") moved by drow, dcol where it is relative; "" off the
# sheet
sbm_shift_ref(r): ref drow dcol [
    re_find(m): "^(\\$?)([A-Z]+)(\\$?)([0-9]+)$" ref
    set(r): ref
    typeof(mt): m
    if(_): {mt != "vector"} [ return(r): r ]
    at(da): m 1
    at(letters): m 2
    at(db): m 3
    at(digits): m 4
    sbm_col_of(c): letters
    str_to_int(row): digits 10
    if(_): {da = ""} [ set(c): {c + dcol} ]
    if(_): {db = ""} [ set(row): {row + drow} ]
    if(_): {c < 0 || row < 1} [
        set(r): ""
        return(r): r
    ]
    sb_colname(cn): c
    str_from_int(rs): row
    concat(r): da cn db rs
]

sbm_col_of(r): letters [
    set(r): 0
    len(n): letters
    set(i): 0
    while(_): {i < n} [
        byte(b): letters i
        set(r): {r * 26 + b - 64}
        set(i): {i + 1}
    ]
    set(r): {r - 1}
]

# a formula's references moved (copying a formula drow, dcol away)
sbm_shift_formula(r): text drow dcol [
    set(r): text
    sb_starts(f): text "="
    if(_): {f = false} [ return(r): r ]
    len(n): text
    slice(body): text 1 {n - 1}
    sb_tokens(toks): body
    len(nt): toks
    set(i): 0
    while(_): {i < nt} [
        at(t): toks i
        at(kind): t 0
        if(_): {kind = "ref"} [
            at(word): t 1
            sbm_shift_ref(nw): word drow dcol
            if(_): {nw = ""} [ set(nw): "#REF!" ]
            set(t): 1 nw
        ]
        set(i): {i + 1}
    ]
    sb_emit(e): toks false
    concat(r): "=" e
]

# a formula's references after rows (or columns) at..at+count-1 were
# inserted (count > 0) or deleted (count < 0)
sbm_adjust_formula(r): text axis at count [
    set(r): text
    sb_starts(f): text "="
    if(_): {f = false} [ return(r): r ]
    len(n): text
    slice(body): text 1 {n - 1}
    sb_tokens(toks): body
    len(nt): toks
    set(i): 0
    while(_): {i < nt} [
        at(t): toks i
        at(kind): t 0
        if(_): {kind = "ref"} [
            at(word): t 1
            re_find(m): "^(\\$?)([A-Z]+)(\\$?)([0-9]+)$" word
            typeof(mt): m
            if(_): {mt = "vector"} [
                at(da): m 1
                at(letters): m 2
                at(db): m 3
                at(digits): m 4
                sbm_col_of(c): letters
                str_to_int(row): digits 10
                set(row): {row - 1}
                set(pos): row
                if(_): {axis = "col"} [ set(pos): c ]
                set(nw): word
                if(_): {count > 0 && pos >= at} [ set(pos): {pos + count} ]
                if(_): {count < 0 && pos >= at} [
                    if(_): {pos < at - count} [ set(pos): -1 ]
                    else(_): [ set(pos): {pos + count} ]
                ]
                if(_): {pos < 0} [ set(nw): "#REF!" ]
                else(_): [
                    if(_): {axis = "col"} [ set(c): pos ]
                    else(_): [ set(row): pos ]
                    sb_colname(cn): c
                    str_from_int(rs): {row + 1}
                    concat(nw): da cn db rs
                ]
                set(t): 1 nw
            ]
        ]
        set(i): {i + 1}
    ]
    sb_emit(e): toks false
    concat(r): "=" e
]

# rows (axis "row") or columns inserted at a position, count of them
# (negative: deleted); every formula follows
sbm_insert(r): axis at count [
    sbm_mark(_):
    sbm_used(u):
    at(mr): u 0
    at(mc): u 1
    # read everything first
    vec(cells): ""
    set(row): 0
    while(_): {row <= mr} [
        set(col): 0
        while(_): {col <= mc} [
            sbm_text_at(t): row col
            if(_): {t != ""} [
                vec(e): ""
                push(_): e row
                push(_): e col
                push(_): e t
                push(_): cells e
                sbm_put(_): row col ""
            ]
            set(col): {col + 1}
        ]
        set(row): {row + 1}
    ]
    len(n): cells
    set(r): 0
    set(i): 0
    while(_): {i < n} [
        at(e): cells i
        at(row): e 0
        at(col): e 1
        at(t): e 2
        set(pos): row
        if(_): {axis = "col"} [ set(pos): col ]
        set(keep): true
        if(_): {count > 0 && pos >= at} [ set(pos): {pos + count} ]
        if(_): {count < 0 && pos >= at} [
            if(_): {pos < at - count} [ set(keep): false ]
            else(_): [ set(pos): {pos + count} ]
        ]
        if(_): keep [
            sbm_adjust_formula(t2): t axis at count
            if(_): {axis = "col"} [ sbm_put(_): row pos t2 ]
            else(_): [ sbm_put(_): pos col t2 ]
            set(r): {r + 1}
        ]
        set(i): {i + 1}
    ]
]

# --- sort, find, replace, fill

# rows r1..r2 of columns c1..c2 sorted by keys [[col ascending]...]
sbm_sort(r): r1 c1 r2 c2 keys [
    sbm_mark(_):
    vec(rows): ""
    set(row): r1
    while(_): {row <= r2} [
        vec(texts): ""
        vec(vals): ""
        set(col): c1
        while(_): {col <= c2} [
            sbm_text_at(t): row col
            push(_): texts t
            sb_value(v): {row * SB_COLS + col}
            push(_): vals v
            set(col): {col + 1}
        ]
        vec(e): ""
        push(_): e texts
        push(_): e vals
        push(_): rows e
        set(row): {row + 1}
    ]
    # insertion sort: stable, keys in order
    len(n): rows
    vec(out): ""
    set(i): 0
    while(_): {i < n} [
        at(e): rows i
        len(no): out
        set(place): no
        set(j): 0
        while(_): {j < no} [
            at(o): out j
            sbm_row_less(lt): e o keys c1
            if(_): lt [
                set(place): j
                set(j): no
            ]
            set(j): {j + 1}
        ]
        vec(nw): ""
        set(j): 0
        while(_): {j < no} [
            if(_): {j = place} [ push(_): nw e ]
            at(o): out j
            push(_): nw o
            set(j): {j + 1}
        ]
        if(_): {place = no} [ push(_): nw e ]
        set(out): nw
        set(i): {i + 1}
    ]
    set(i): 0
    while(_): {i < n} [
        at(e): out i
        at(texts): e 0
        set(col): c1
        while(_): {col <= c2} [
            at(t): texts {col - c1}
            sbm_put(_): {r1 + i} col t
            set(col): {col + 1}
        ]
        set(i): {i + 1}
    ]
    set(r): n
]

sbm_row_less(r): a b keys c1 [
    set(r): false
    at(va): a 1
    at(vb): b 1
    len(nk): keys
    set(k): 0
    while(_): {k < nk} [
        at(key): keys k
        at(col): key 0
        at(asc): key 1
        at(x): va {col - c1}
        at(y): vb {col - c1}
        typeof(tx): x
        typeof(ty): y
        # blanks last either way
        if(_): {tx = "null" && ty != "null"} [ return(r): r ]
        if(_): {ty = "null" && tx != "null"} [
            set(r): true
            return(r): r
        ]
        sb_compare_op(lt): x y "<"
        sb_compare_op(gt): x y ">"
        if(_): {asc = false} [
            set(t): lt
            set(lt): gt
            set(gt): t
        ]
        if(_): {lt = true} [
            set(r): true
            return(r): r
        ]
        if(_): {gt = true} [ return(r): r ]
        set(k): {k + 1}
    ]
]

# cells whose typed text holds find: their names
sbm_find(r): find match_case [
    vec(r): ""
    sbm_used(u):
    at(mr): u 0
    at(mc): u 1
    set(f): find
    if(_): {match_case = false} [ str_lower(f): find ]
    set(row): 0
    while(_): {row <= mr} [
        set(col): 0
        while(_): {col <= mc} [
            sbm_text_at(t): row col
            if(_): {match_case = false} [ str_lower(t): t ]
            str_contains(hit): t f
            if(_): {hit && f != ""} [
                sb_cellname(nm): {row * SB_COLS + col}
                push(_): r nm
            ]
            set(col): {col + 1}
        ]
        set(row): {row + 1}
    ]
]

sbm_replace(r): find repl [
    sbm_mark(_):
    set(r): 0
    sbm_used(u):
    at(mr): u 0
    at(mc): u 1
    set(row): 0
    while(_): {row <= mr} [
        set(col): 0
        while(_): {col <= mc} [
            sbm_text_at(t): row col
            str_contains(hit): t find
            if(_): {hit && find != ""} [
                str_replace(t2): t find repl
                sbm_put(_): row col t2
                set(r): {r + 1}
            ]
            set(col): {col + 1}
        ]
        set(row): {row + 1}
    ]
]

# the next item of a series from its first items (texts): numbers step,
# weekday and month names go round, text with a number counts up
sbm_series(r): seeds k [
    len(n): seeds
    at(first): seeds 0
    str_to_number(fn): first
    sbm_isnum(isn): fn
    if(_): isn [
        set(step): 1
        if(_): {n >= 2} [
            at(second): seeds 1
            str_to_number(sn): second
            sbm_isnum(sok): sn
            if(_): sok [ set(step): {sn - fn} ]
        ]
        if(_): {n = 1} [ set(step): 0 ]
        set(v): {fn + step * k}
        sb_fmt(r): v
        return(r): r
    ]
    vec(lists): ""
    push(_): lists "Mon Tue Wed Thu Fri Sat Sun"
    push(_): lists "Monday Tuesday Wednesday Thursday Friday Saturday Sunday"
    push(_): lists "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec"
    push(_): lists "January February March April May June July August September October November December"
    set(li): 0
    while(_): {li < 4} [
        at(ls): lists li
        str_split(words): ls " "
        len(nw): words
        set(i): 0
        while(_): {i < nw} [
            at(w): words i
            if(_): {w = first} [
                at(r): words {(i + k) % nw}
                return(r): r
            ]
            set(i): {i + 1}
        ]
        set(li): {li + 1}
    ]
    re_find(m): "^(.*?)([0-9]+)$" first
    typeof(mt): m
    if(_): {mt = "vector"} [
        at(pre): m 1
        at(num): m 2
        str_to_int(nv): num 10
        str_from_int(ns): {nv + k}
        concat(r): pre ns
        return(r): r
    ]
    at(r): seeds {k % n}
]

# fill r1..r2 (down) or c1..c2 (right) from the first rows/columns:
# formulas move their references, other cells follow a series
sbm_fill(r): r1 c1 r2 c2 dir seeds_n [
    sbm_mark(_):
    set(r): 0
    if(_): {dir = "down"} [
        set(col): c1
        while(_): {col <= c2} [
            vec(seeds): ""
            set(k): 0
            while(_): {k < seeds_n} [
                sbm_text_at(t): {r1 + k} col
                push(_): seeds t
                set(k): {k + 1}
            ]
            at(s0): seeds 0
            sb_starts(isf): s0 "="
            set(row): {r1 + seeds_n}
            while(_): {row <= r2} [
                set(k): {row - r1}
                if(_): isf [
                    at(src): seeds {k % seeds_n}
                    sbm_shift_formula(t): src {k - k % seeds_n} 0
                ]
                else(_): [ sbm_series(t): seeds k ]
                sbm_put(_): row col t
                set(r): {r + 1}
                set(row): {row + 1}
            ]
            set(col): {col + 1}
        ]
    ]
    else(_): [
        set(row): r1
        while(_): {row <= r2} [
            vec(seeds): ""
            set(k): 0
            while(_): {k < seeds_n} [
                sbm_text_at(t): row {c1 + k}
                push(_): seeds t
                set(k): {k + 1}
            ]
            at(s0): seeds 0
            sb_starts(isf): s0 "="
            set(col): {c1 + seeds_n}
            while(_): {col <= c2} [
                set(k): {col - c1}
                if(_): isf [
                    at(src): seeds {k % seeds_n}
                    sbm_shift_formula(t): src 0 {k - k % seeds_n}
                ]
                else(_): [ sbm_series(t): seeds k ]
                sbm_put(_): row col t
                set(r): {r + 1}
                set(col): {col + 1}
            ]
            set(row): {row + 1}
        ]
    ]
]

# rows of the range that repeat an earlier row are removed; the count
sbm_dedupe(r): r1 c1 r2 c2 [
    sbm_mark(_):
    btree(seen):
    vec(keep): ""
    set(row): r1
    while(_): {row <= r2} [
        set(key): ""
        vec(texts): ""
        set(col): c1
        while(_): {col <= c2} [
            sbm_text_at(t): row col
            push(_): texts t
            sb_value(v): {row * SB_COLS + col}
            sb_text_of(vs): v
            concat(key): key vs "\t"
            set(col): {col + 1}
        ]
        bthas(dup): seen key
        if(_): {dup = false} [
            btput(_): seen key true
            push(_): keep texts
        ]
        set(row): {row + 1}
    ]
    len(nk): keep
    set(r): {r2 - r1 + 1 - nk}
    set(row): r1
    while(_): {row <= r2} [
        set(i): {row - r1}
        set(col): c1
        while(_): {col <= c2} [
            set(t): ""
            if(_): {i < nk} [
                at(texts): keep i
                at(t): texts {col - c1}
            ]
            sbm_put(_): row col t
            set(col): {col + 1}
        ]
        set(row): {row + 1}
    ]
]

# the range's values copied turned over, to start at (dr, dc)
sbm_transpose(r): r1 c1 r2 c2 dr dc [
    sbm_mark(_):
    set(r): 0
    vec(cells): ""
    set(row): r1
    while(_): {row <= r2} [
        set(col): c1
        while(_): {col <= c2} [
            sb_value(v): {row * SB_COLS + col}
            typeof(t): v
            set(s): ""
            if(_): {t != "null"} [ sb_text_of(s): v ]
            vec(e): ""
            push(_): e {dr + col - c1}
            push(_): e {dc + row - r1}
            push(_): e s
            push(_): cells e
            set(col): {col + 1}
        ]
        set(row): {row + 1}
    ]
    len(n): cells
    set(i): 0
    while(_): {i < n} [
        at(e): cells i
        at(a): e 0
        at(b): e 1
        at(s): e 2
        sbm_put(_): a b s
        set(r): {r + 1}
        set(i): {i + 1}
    ]
]

# a column's texts split at a delimiter into the columns to its right
sbm_text_to_columns(r): r1 r2 col delim [
    sbm_mark(_):
    set(r): 0
    set(row): r1
    while(_): {row <= r2} [
        sbm_text_at(t): row col
        if(_): {t != ""} [
            str_split(parts): t delim
            len(np): parts
            set(k): 0
            while(_): {k < np} [
                at(p): parts k
                str_trim(p): p
                sbm_put(_): row {col + k} p
                set(k): {k + 1}
            ]
            set(r): {r + 1}
        ]
        set(row): {row + 1}
    ]
]

# --- analysis

# the input of changing cell that makes target's value want: the input
# (and it is left in place), or an error text
sbm_goal_seek(r): target want changing [
    sb_ref(ti): target
    sb_ref(ci): changing
    sbm_mark(_):
    sb_cell(c): ci
    getf(t0): c "text"
    str_to_number(x0): t0
    sbm_isnum(ok): x0
    if(_): {ok = false} [ set(x0): 0 ]
    set(x1): {x0 + 1}
    if(_): {x0 != 0} [ set(x1): {x0 * 1.1} ]
    sbm_seek_at(f0): ti ci x0 want
    sbm_seek_at(f1): ti ci x1 want
    set(k): 0
    while(_): {k < 100} [
        sb_is_err(e0): f0
        sb_is_err(e1): f1
        if(_): {e0 || e1} [
            set(r): "the target gives an error"
            return(r): r
        ]
        abs(af): f1
        if(_): {af < 0.0000001} [
            sb_fmt(xs): x1
            sb_set_index(_): ci xs
            set(r): x1
            return(r): r
        ]
        if(_): {f1 = f0} [
            set(r): "no answer found"
            return(r): r
        ]
        set(x2): {x1 - f1 * (x1 - x0) / (f1 - f0)}
        set(x0): x1
        set(f0): f1
        set(x1): x2
        sbm_seek_at(f1): ti ci x1 want
        set(k): {k + 1}
    ]
    set(r): "no answer found"
]

sbm_seek_at(r): ti ci x want [
    sb_fmt(xs): x
    sb_set_index(_): ci xs
    sb_value(v): ti
    sb_num(n): v
    sb_is_err(e): n
    set(r): n
    if(_): {e = false} [ set(r): {n - want} ]
]

# every cell showing an error: [[name error why]...]
sbm_errors(r): [
    vec(r): ""
    sbm_used(u):
    at(mr): u 0
    at(mc): u 1
    btree(why):
    btput(_): why "#DIV/0!" "a division by zero"
    btput(_): why "#REF!" "a reference outside the sheet, or deleted"
    btput(_): why "#NAME?" "an unknown function or name"
    btput(_): why "#VALUE!" "text where a number belongs, or a wrong argument"
    btput(_): why "#N/A" "a lookup found nothing"
    btput(_): why "#NUM!" "a number out of range"
    btput(_): why "#CYCLE!" "the formula depends on itself"
    btput(_): why "#ERROR!" "the formula cannot be read"
    set(row): 0
    while(_): {row <= mr} [
        set(col): 0
        while(_): {col <= mc} [
            sb_value(v): {row * SB_COLS + col}
            sb_is_err(e): v
            if(_): e [
                sb_show_value(s): v
                sb_cellname(nm): {row * SB_COLS + col}
                vec(x): ""
                push(_): x nm
                push(_): x s
                btget(w): why s "an error"
                push(_): x w
                push(_): r x
            ]
            set(col): {col + 1}
        ]
        set(row): {row + 1}
    ]
]

# the cells a formula reads (ranges as A1:B3)
sbm_precedents(r): name [
    vec(r): ""
    sb_ref(i): name
    sb_cell(c): i
    getf(t): c "text"
    sb_starts(f): t "="
    if(_): {f = false} [ return(r): r ]
    len(n): t
    slice(body): t 1 {n - 1}
    sb_tokens(toks): body
    len(nt): toks
    set(k): 0
    while(_): {k < nt} [
        at(tk): toks k
        at(kind): tk 0
        if(_): {kind = "ref"} [
            at(word): tk 1
            str_replace(w): word "$" ""
            set(nx): k
            if(_): {k + 2 < nt} [
                at(t1): toks {k + 1}
                at(t2): toks {k + 2}
                at(k1): t1 0
                at(x1): t1 1
                at(k2): t2 0
                if(_): {k1 = "op" && x1 = ":" && k2 = "ref"} [
                    at(w2): t2 1
                    str_replace(w2): w2 "$" ""
                    concat(w): w ":" w2
                    set(nx): {k + 2}
                ]
            ]
            push(_): r w
            set(k): nx
        ]
        set(k): {k + 1}
    ]
]

# the cells whose formulas read name (directly)
sbm_dependents(r): name [
    vec(r): ""
    sb_ref(target): name
    set(tc): {target % SB_COLS}
    sbm_int(tr): {target / SB_COLS}
    sbm_used(u):
    at(mr): u 0
    at(mc): u 1
    set(row): 0
    while(_): {row <= mr} [
        set(col): 0
        while(_): {col <= mc} [
            sb_cellname(nm): {row * SB_COLS + col}
            sbm_precedents(ps): nm
            len(np): ps
            set(k): 0
            set(hit): false
            while(_): {k < np} [
                at(p): ps k
                str_find(colon): p ":" 0
                if(_): {colon < 0} [
                    sb_ref(pi): p
                    if(_): {pi = target} [ set(hit): true ]
                ]
                else(_): [
                    slice(a): p 0 colon
                    len(pl): p
                    slice(b): p {colon + 1} {pl - colon - 1}
                    sb_ref(ia): a
                    sb_ref(ib): b
                    sb_range(rg): ia ib
                    at(r1): rg 0
                    at(c1): rg 1
                    at(r2): rg 2
                    at(c2): rg 3
                    if(_): {tr >= r1 && tr <= r2 && tc >= c1 && tc <= c2} [ set(hit): true ]
                ]
                set(k): {k + 1}
            ]
            if(_): hit [ push(_): r nm ]
            set(col): {col + 1}
        ]
        set(row): {row + 1}
    ]
]

# a scenario: the texts of some cells, saved and put back
sbm_scenario_save(r): name cells [
    set(sc): sb_scenarios?
    btree(s):
    len(n): cells
    set(i): 0
    while(_): {i < n} [
        at(c): cells i
        sbget(t): c
        btput(_): s c t
        set(i): {i + 1}
    ]
    btput(_): sc name s
    set(sb_scenarios): sc!
    set(r): n
]

sbm_scenario_apply(r): name [
    set(sc): sb_scenarios?
    btget(s): sc name null
    set(r): 0
    if(_): {s = null} [ return(r): r ]
    sbm_mark(_):
    btkeys(ks): s
    len(n): ks
    set(i): 0
    while(_): {i < n} [
        at(k): ks i
        btget(t): s k
        sb_ref(ix): k
        set(col): {ix % SB_COLS}
        sbm_int(row): {ix / SB_COLS}
        sbm_put(_): row col t
        set(i): {i + 1}
    ]
    set(r): n
]

# "Sum 6  Average 2  Count 3" for a range
sbm_stats(r): r1 c1 r2 c2 [
    vec(rg): ""
    push(_): rg r1
    push(_): rg c1
    push(_): rg r2
    push(_): rg c2
    vec(args): ""
    push(_): args rg
    sbm_nums(v): args
    sb_is_err(e): v
    set(r): ""
    if(_): e [ return(r): r ]
    len(n): v
    set(sum): 0
    set(i): 0
    while(_): {i < n} [
        at(x): v i
        set(sum): {sum + x}
        set(i): {i + 1}
    ]
    sb_fmt(ss): sum
    str_from_int(ns): n
    concat(r): "Sum " ss "  Count " ns
    if(_): {n > 0} [
        sb_fmt(as): {sum / (n * 1.0)}
        concat(r): "Sum " ss "  Average " as "  Count " ns
    ]
]

# --- CSV with options, encodings, HTML and Markdown

# rows of fields: delimiter, quote character, a decimal comma ("," numbers
# become "." numbers)
sbm_csv_rows(r): text delim quote [
    vec(r): ""
    vec(row): ""
    set(field): ""
    set(inq): false
    len(n): text
    byte(qb): quote 0
    byte(db): delim 0
    set(i): 0
    while(_): {i < n} [
        byte(b): text i
        if(_): inq [
            if(_): {b = qb} [
                set(b2): 0
                if(_): {i + 1 < n} [ byte(b2): text {i + 1} ]
                if(_): {b2 = qb} [
                    concat(field): field quote
                    set(i): {i + 1}
                ]
                else(_): [ set(inq): false ]
            ]
            else(_): [
                slice(c): text i 1
                concat(field): field c
            ]
        ]
        elif(_): {b = qb} [ set(inq): true ]
        elif(_): {b = db} [
            push(_): row field
            set(field): ""
        ]
        elif(_): {b = 10} [
            push(_): row field
            push(_): r row
            vec(row): ""
            set(field): ""
        ]
        elif(_): {b != 13} [
            slice(c): text i 1
            concat(field): field c
        ]
        set(i): {i + 1}
    ]
    len(nrow): row
    if(_): {field != "" || nrow > 0} [
        push(_): row field
        push(_): r row
    ]
]

# loads CSV text with options into the sheet: delimiter, quote, header
# (the first row skipped), decimal comma; the rows loaded
sbm_csv_load(r): text delim quote header comma [
    sbsheetreset(_):
    set(t): text
    chr(b1): 239
    chr(b2): 187
    chr(b3): 191
    concat(bomtext): b1 b2 b3
    sb_starts(hasbom): t bomtext
    if(_): hasbom [
        len(tl): t
        slice(t): t 3 {tl - 3}
    ]
    sbm_csv_rows(rows): t delim quote
    len(n): rows
    set(start): 0
    if(_): header [ set(start): 1 ]
    set(r): 0
    set(i): start
    while(_): {i < n && i - start < SB_ROWS} [
        at(row): rows i
        len(nc): row
        set(j): 0
        while(_): {j < nc && j < SB_COLS} [
            at(f): row j
            if(_): comma [
                re_test(isnum): "^-?[0-9 ]+,[0-9]+$" f
                if(_): isnum [
                    str_replace(f): f "," "."
                    str_replace(f): f " " ""
                ]
            ]
            if(_): {f != ""} [ sb_set_index(_): {(i - start) * SB_COLS + j} f ]
            set(j): {j + 1}
        ]
        set(r): {r + 1}
        set(i): {i + 1}
    ]
]

# the sheet as CSV with options: delimiter, decimal comma, a BOM
sbm_csv_text(r): delim comma bom [
    set(r): ""
    if(_): bom [
        chr(b1): 239
        chr(b2): 187
        chr(b3): 191
        concat(r): b1 b2 b3
    ]
    sbm_used(u):
    at(mr): u 0
    at(mc): u 1
    set(row): 0
    while(_): {row <= mr} [
        set(col): 0
        while(_): {col <= mc} [
            sb_value(v): {row * SB_COLS + col}
            typeof(t): v
            set(s): ""
            if(_): {t != "null"} [ sb_show_value(s): v ]
            sbm_isnum(isn): v
            if(_): {isn && comma} [ str_replace(s): s "." "," ]
            str_contains(q1): s delim
            str_contains(q2): s "\""
            str_contains(q3): s "\n"
            if(_): {q1 || q2 || q3} [
                str_replace(s): s "\"" "\"\""
                concat(s): "\"" s "\""
            ]
            if(_): {col > 0} [ concat(r): r delim ]
            concat(r): r s
            set(col): {col + 1}
        ]
        concat(r): r "\n"
        set(row): {row + 1}
    ]
]

# Windows-1251 bytes -> UTF-8 text, and back (bytes as a vector)
sbm_cp1251_table(r): [
    # 0x80..0xBF: the code points; 0xC0..0xFF are А..я (U+0410..U+044F)
    tl_sb_nums(r): "1026 1027 8218 1107 8222 8230 8224 8225 8364 8240 1033 8249 1034 1036 1035 1039 1106 8216 8217 8220 8221 8226 8211 8212 152 8482 1113 8250 1114 1116 1115 1119 160 1038 1118 1032 164 1168 166 167 1025 169 1028 171 172 173 174 1031 176 177 1030 1110 1169 181 182 183 1105 8470 1108 187 1112 1029 1109 1111"
]

tl_sb_nums(r): text [
    str_split(p): text " "
    vec(r): ""
    len(n): p
    set(i): 0
    while(_): {i < n} [
        at(x): p i
        str_to_int(v): x 10
        push(_): r v
        set(i): {i + 1}
    ]
]

sbm_from_cp1251(r): bytes [
    sbm_cp1251_table(tab):
    vec(o): ""
    len(n): bytes
    set(i): 0
    while(_): {i < n} [
        at(b): bytes i
        set(cp): b
        if(_): {b >= 192} [ set(cp): {b - 192 + 1040} ]
        elif(_): {b >= 128} [ at(cp): tab {b - 128} ]
        sbm_put_utf8(_): o cp
        set(i): {i + 1}
    ]
    bytes_text(r): o
]

sbm_to_cp1251(r): text [
    sbm_cp1251_table(tab):
    btree(back):
    set(i): 0
    while(_): {i < 64} [
        at(cp): tab i
        btput(_): back cp {i + 128}
        set(i): {i + 1}
    ]
    text_bytes(b): text
    vec(r): ""
    len(n): b
    set(i): 0
    while(_): {i < n} [
        at(x): b i
        set(cp): x
        set(len_): 1
        if(_): {x >= 240} [
            set(cp): {x & 7}
            set(len_): 4
        ]
        elif(_): {x >= 224} [
            set(cp): {x & 15}
            set(len_): 3
        ]
        elif(_): {x >= 192} [
            set(cp): {x & 31}
            set(len_): 2
        ]
        set(k): 1
        while(_): {k < len_ && i + k < n} [
            at(y): b {i + k}
            set(cp): {(cp << 6) | (y & 63)}
            set(k): {k + 1}
        ]
        set(i): {i + len_}
        if(_): {cp < 128} [ push(_): r cp ]
        elif(_): {cp >= 1040 && cp <= 1103} [ push(_): r {cp - 1040 + 192} ]
        else(_): [
            btget(v): back cp 63
            push(_): r v
        ]
    ]
]

sbm_put_utf8(r): v cp [
    set(r): 0
    if(_): {cp < 128} [ push(_): v cp ]
    elif(_): {cp < 2048} [
        push(_): v {192 | (cp >> 6)}
        push(_): v {128 | (cp & 63)}
    ]
    else(_): [
        push(_): v {224 | (cp >> 12)}
        push(_): v {128 | ((cp >> 6) & 63)}
        push(_): v {128 | (cp & 63)}
    ]
]

sbm_html(r): [
    set(r): "<table>\n"
    sbm_used(u):
    at(mr): u 0
    at(mc): u 1
    set(row): 0
    while(_): {row <= mr} [
        concat(r): r "<tr>"
        set(col): 0
        while(_): {col <= mc} [
            sb_value(v): {row * SB_COLS + col}
            typeof(t): v
            set(s): ""
            if(_): {t != "null"} [ sb_show_value(s): v ]
            sb_xml_escape(s): s
            sbm_isnum(isn): v
            if(_): isn [ concat(r): r "<td align=\"right\">" s "</td>" ]
            else(_): [ concat(r): r "<td>" s "</td>" ]
            set(col): {col + 1}
        ]
        concat(r): r "</tr>\n"
        set(row): {row + 1}
    ]
    concat(r): r "</table>\n"
]

sbm_markdown(r): [
    set(r): ""
    sbm_used(u):
    at(mr): u 0
    at(mc): u 1
    set(row): 0
    while(_): {row <= mr} [
        concat(r): r "|"
        set(col): 0
        while(_): {col <= mc} [
            sb_value(v): {row * SB_COLS + col}
            typeof(t): v
            set(s): ""
            if(_): {t != "null"} [ sb_show_value(s): v ]
            str_replace(s): s "|" "\\|"
            concat(r): r " " s " |"
            set(col): {col + 1}
        ]
        concat(r): r "\n"
        if(_): {row = 0} [
            concat(r): r "|"
            set(col): 0
            while(_): {col <= mc} [
                concat(r): r "---|"
                set(col): {col + 1}
            ]
            concat(r): r "\n"
        ]
        set(row): {row + 1}
    ]
]

# --- the command line: --eval file cell, --convert in out

sbm_cli(r): args [
    set(r): -1
    len(n): args
    if(_): {n < 1} [ return(r): r ]
    at(a0): args 0
    if(_): {a0 != "--eval" && a0 != "--convert"} [ return(r): r ]
    set(r): 2
    if(_): {n < 3} [
        print(_): "usage: ussr siberia.su --eval file.fods|file.csv CELL..."
        print(_): "       ussr siberia.su --convert in.csv|in.fods out.fods|.csv|.html|.md"
        return(r): r
    ]
    if(_): {sbm_ready != true} [ sbsetup(_): ]
    sbsheetreset(_):
    at(path): args 1
    sb_read(text): path
    if(_): {text = null} [
        concat(m): "siberia: cannot read " path
        print(_): m
        return(r): r
    ]
    sb_extension(ext): path
    set(kind): "fods"
    if(_): {ext = ".csv"} [ set(kind): "csv" ]
    sbsheetload(why): text kind
    if(_): {why != ""} [
        concat(m): "siberia: " why
        print(_): m
        return(r): r
    ]
    set(r): 0
    if(_): {a0 = "--eval"} [
        set(i): 2
        while(_): {i < n} [
            at(c): args i
            # "Sheet1.B5": the sheet name is left aside
            str_find(dot): c "." 0
            if(_): {dot >= 0} [
                len(cl): c
                slice(c): c {dot + 1} {cl - dot - 1}
            ]
            sb_ref(ix): c
            if(_): {ix < 0} [
                concat(m): "siberia: not a cell: " c
                print(_): m
                set(r): 1
            ]
            else(_): [
                sb_value(v): ix
                sb_show_value(s): v
                print(_): s
            ]
            set(i): {i + 1}
        ]
        return(r): r
    ]
    at(out): args 2
    sb_extension(oe): out
    set(t): ""
    if(_): {oe = ".csv"} [ sbsheetcsv(t): ]
    elif(_): {oe = ".html" || oe = ".htm"} [ sbm_html(t): ]
    elif(_): {oe = ".md"} [ sbm_markdown(t): ]
    else(_): [ sbsheetfods(t): ]
    sb_write(_): out t
    concat(m): "siberia: wrote " out
    print(_): m
]

# count characters of s from character from (UTF-8 aware)
utf8_slice(r): s from count [
    utf8_index(a): s from
    utf8_index(b): s {from + count}
    slice(r): s a {b - a}
]
