# more.su - Siberia refine pass 1: functions, names and sheet tools
# beyond 0.2. siberia.su includes it; sb_call asks sbm_call first and an
# unknown name in a formula asks sbm_name.
#
# Functions: VLOOKUP HLOOKUP INDEX MATCH XLOOKUP; SUMIF(S) COUNTIF(S)
# AVERAGEIF(S); LEFT RIGHT MID FIND SEARCH SUBSTITUTE TRIM CONCAT
# CONCATENATE TEXTJOIN TEXT VALUE REPT EXACT PROPER CHAR CODE; TODAY NOW
# DATE TIME YEAR MONTH DAY HOUR MINUTE WEEKDAY DATEDIF EDATE EOMONTH
# (serial days from 1899-12-30); SUMPRODUCT PRODUCT ROUNDUP ROUNDDOWN
# CEILING FLOOR TRUNC SIGN LOG LOG10 LN EXP RAND RANDBETWEEN SIN COS TAN
# ASIN ACOS ATAN ATAN2 DEGREES RADIANS FACT GCD LCM; MEDIAN MODE STDEV
# STDEVP VAR VARP LARGE SMALL RANK PERCENTILE COUNTA COUNTBLANK; IFERROR
# IFNA IFS SWITCH XOR ISBLANK ISNUMBER ISTEXT ISERROR ISLOGICAL; PMT FV PV
# NPV IRR; SLOPE INTERCEPT CORREL FORECAST TREND; BITAND BITOR BITXOR
# BITLSHIFT BITRSHIFT DEC2HEX HEX2DEC DEC2BIN BIN2DEC DEC2OCT OCT2DEC;
# SUBTOTAL; USSR("definition", args...) calls a USSR definition with a
# vector of the argument values.
#
# Sheet tools (sbm_*): names, sort, find and replace, fill series, insert
# and delete rows and columns (references follow), remove duplicates,
# transpose, text to columns, goal seek, the error checker, precedents and
# dependents, scenarios, undo and redo, number formats, CSV with options
# and Windows-1251, HTML and Markdown out, and the command line:
#     ussr src/siberia/siberia.su --eval file.fods B5
#     ussr src/siberia/siberia.su --convert in.csv out.fods|.html|.md
$once
$include "../libs/dates.su"
$include "../libs/lists.su"

global(_): sbm_ready

sbm_state(r): [
    set(sbm_ready): true
    btree(names):
    set(sb_names): names!
    vec(u): ""
    set(sb_undo): u!
    vec(rd): ""
    set(sb_redo): rd!
    btree(sc):
    set(sb_scenarios): sc!
    set(r): 0
]

# --- argument helpers

sbm_is_range(r): a [
    typeof(t): a
    set(r): {t = "vector"}
]

# a range's values, row by row
sbm_values(r): a [
    vec(r): ""
    sbm_is_range(isr): a
    if(_): {isr = false} [
        push(_): r a
        return(r): r
    ]
    at(r1): a 0
    at(c1): a 1
    at(r2): a 2
    at(c2): a 3
    set(row): r1
    while(_): {row <= r2} [
        set(col): c1
        while(_): {col <= c2} [
            sb_value(v): {row * SB_COLS + col}
            push(_): r v
            set(col): {col + 1}
        ]
        set(row): {row + 1}
    ]
]

sbm_rows(r): a [
    set(r): 1
    sbm_is_range(isr): a
    if(_): isr [
        at(r1): a 0
        at(r2): a 2
        set(r): {r2 - r1 + 1}
    ]
]

sbm_cols(r): a [
    set(r): 1
    sbm_is_range(isr): a
    if(_): isr [
        at(c1): a 1
        at(c2): a 3
        set(r): {c2 - c1 + 1}
    ]
]

# one value from an argument: a single-cell range gives its value
sbm_one(r): a [
    set(r): a
    sbm_is_range(isr): a
    if(_): isr [
        at(r1): a 0
        at(c1): a 1
        sb_value(r): {r1 * SB_COLS + c1}
    ]
]

sbm_arg(r): args i [
    at(a): args i
    sbm_one(r): a
]

sbm_num_arg(r): args i [
    sbm_arg(a): args i
    sb_num(r): a
]

sbm_text_arg(r): args i [
    sbm_arg(a): args i
    sb_text_of(r): a
]

# the first error among the arguments (ranges not looked into), or null
sbm_first_err(r): args [
    set(r): null
    len(n): args
    set(i): 0
    while(_): {i < n} [
        at(a): args i
        sb_is_err(e): a
        if(_): e [
            set(r): a
            return(r): r
        ]
        set(i): {i + 1}
    ]
]

sbm_isnum(r): v [
    typeof(t): v
    set(r): {t = "integer" || t = "real"}
]

sbm_int(r): x [
    str_trunc(r): x
    if(_): {r > x} [ set(r): {r - 1} ]
]

# numbers of the arguments, ranges expanded, text and blanks skipped
sbm_nums(r): args [
    sb_collect(r): args
]

# --- criteria for the IF functions: 5, ">5", "<>x", "a*", "=b?"

sbm_crit(r): v crit [
    set(r): false
    sbm_isnum(cn): crit
    sbm_isnum(vn): v
    if(_): cn [
        if(_): vn [ set(r): {v = crit} ]
        return(r): r
    ]
    typeof(ct): crit
    if(_): {ct = "boolean"} [
        set(r): {v = crit}
        return(r): r
    ]
    sb_text_of(c): crit
    set(op): "="
    vec(ops): ""
    str_split(ops): "<= >= <> < > =" " "
    set(k): 0
    while(_): {k < 6} [
        at(o): ops k
        sb_starts(s): c o
        if(_): s [
            set(op): o
            len(ol): o
            len(cl): c
            slice(c): c ol {cl - ol}
            set(k): 6
        ]
        set(k): {k + 1}
    ]
    str_trim(ct2): c
    set(num): null
    if(_): {ct2 != ""} [ str_to_number(num): ct2 ]
    sbm_isnum(isn): num
    if(_): isn [
        if(_): {vn = false} [
            set(r): {op = "<>"}
            return(r): r
        ]
        sb_compare_op(r): v num op
        return(r): r
    ]
    # text: case folded, * and ? wildcards for = and <>
    typeof(vt): v
    set(vs): ""
    if(_): {vt != "null"} [ sb_text_of(vs): v ]
    str_lower(vs): vs
    str_lower(cs): c
    if(_): {op = "=" || op = "<>"} [
        sbm_wild(m): cs vs
        set(r): m
        if(_): {op = "<>"} [ set(r): {m = false} ]
    ]
    else(_): [
        sb_compare_text(cmp): vs cs
        if(_): {op = "<"} [ set(r): {cmp < 0} ]
        elif(_): {op = ">"} [ set(r): {cmp > 0} ]
        elif(_): {op = "<="} [ set(r): {cmp <= 0} ]
        else(_): [ set(r): {cmp >= 0} ]
    ]
]

# pattern with * and ? against text
sbm_wild(r): p s [
    len(np): p
    len(ns): s
    set(pi): 0
    set(si): 0
    set(star): -1
    set(mark): 0
    while(_): {si < ns} [
        set(pc): 0
        if(_): {pi < np} [ byte(pc): p pi ]
        byte(sc): s si
        if(_): {pi < np && (pc = 63 || pc = sc)} [
            set(pi): {pi + 1}
            set(si): {si + 1}
        ]
        elif(_): {pi < np && pc = 42} [
            set(star): pi
            set(mark): si
            set(pi): {pi + 1}
        ]
        elif(_): {star >= 0} [
            set(pi): {star + 1}
            set(mark): {mark + 1}
            set(si): mark
        ]
        else(_): [
            set(r): false
            return(r): r
        ]
    ]
    while(_): {pi < np} [
        byte(pc): p pi
        if(_): {pc != 42} [
            set(r): false
            return(r): r
        ]
        set(pi): {pi + 1}
    ]
    set(r): true
]

# --- dates: serial numbers, day 1 = 1899-12-31 (as LibreOffice: 0 is
# 1899-12-30), fractions are the time of day

sbm_serial(r): y m d [
    # months past 12 roll over, as DATE does
    set(yy): y
    set(mm): {m - 1}
    sbm_int(q): {mm / 12}
    set(yy): {yy + q}
    set(mm): {mm - q * 12 + 1}
    days_from_civil(dd): yy mm 1
    set(r): {dd + 25569 + d - 1}
]

sbm_ymd(r): serial [
    sbm_int(s): serial
    civil_from_days(r): {s - 25569}
]

sbm_days_in(r): y m [
    sbm_serial(a): y m 1
    sbm_serial(b): y {m + 1} 1
    set(r): {b - a}
]

sbm_now(r): [
    time(t):
    localtime(lt): t
    at(y): lt 0
    at(mo): lt 1
    at(d): lt 2
    at(h): lt 3
    at(mi): lt 4
    at(se): lt 5
    sbm_serial(day): y mo d
    set(r): {day + (h * 3600 + mi * 60 + se) / 86400.0}
]

# --- number formats: 0 0.00 #,##0 #,##0.00 0% 0.0% $#,##0.00 0.00E+00
# yyyy-mm-dd dd.mm.yyyy mm/dd/yyyy hh:mm hh:mm:ss @ General

sbm_format(r): v code [
    sbm_isnum(isn): v
    if(_): {isn = false || code = "" || code = "General" || code = "@"} [
        sb_show_value(r): v
        return(r): r
    ]
    str_lower(lc): code
    str_contains(isdate): lc "yy"
    str_contains(istime): lc "hh"
    if(_): {isdate || istime} [
        sbm_ymd(ymd): v
        at(y): ymd 0
        at(mo): ymd 1
        at(d): ymd 2
        sbm_int(day): v
        set(frac): {v - day}
        sbm_int(secs): {frac * 86400 + 0.5}
        sbm_int(h): {secs / 3600}
        sbm_int(mi): {(secs - h * 3600) / 60}
        set(se): {secs - h * 3600 - mi * 60}
        str_from_int(ys): y
        sbm_two(ms): mo
        sbm_two(ds): d
        sbm_two(hs): h
        sbm_two(mis): mi
        sbm_two(ses): se
        # minutes come after hours: "hh:mm" first, then months
        set(r): lc
        concat(hm): hs ":" mis
        str_replace(r): r "hh:mm" hm
        str_replace(r): r "yyyy" ys
        str_replace(r): r "mm" ms
        str_replace(r): r "dd" ds
        str_replace(r): r "ss" ses
        str_replace(r): r "hh" hs
        return(r): r
    ]
    str_ends(pct): code "%"
    set(x): v
    if(_): pct [ set(x): {v * 100} ]
    str_contains(sci): code "E+"
    str_find(dot): code "." 0
    set(dec): 0
    if(_): {dot >= 0} [
        set(k): {dot + 1}
        len(cl): code
        while(_): {k < cl} [
            byte(b): code k
            if(_): {b = 48 || b = 35} [ set(dec): {dec + 1} ]
            set(k): {k + 1}
        ]
        if(_): sci [
            str_find(epos): code "E" 0
            set(dec): {epos - dot - 1}
        ]
    ]
    if(_): sci [
        set(ax): x
        if(_): {x < 0} [ set(ax): {0 - x} ]
        set(e): 0
        if(_): {ax > 0} [
            while(_): {ax >= 10} [
                set(ax): {ax / 10.0}
                set(e): {e + 1}
            ]
            while(_): {ax < 1} [
                set(ax): {ax * 10.0}
                set(e): {e - 1}
            ]
        ]
        sb_round(m): ax dec
        str_from_number(ms): m dec
        if(_): {dec > 0} [ sbm_pad_dec(ms): ms dec ]
        set(sign): "+"
        if(_): {e < 0} [
            set(sign): "-"
            set(e): {0 - e}
        ]
        sbm_two(es): e
        set(r): ""
        if(_): {x < 0} [ set(r): "-" ]
        concat(r): r ms "E" sign es
        return(r): r
    ]
    sb_round(rx): x dec
    set(ax): rx
    if(_): {rx < 0} [ set(ax): {0 - rx} ]
    str_from_number(s): ax dec
    if(_): {dec = 0} [
        sbm_int(ai): {ax + 0.0000001}
        str_from_int(s): ai
    ]
    else(_): [ sbm_pad_dec(s): s dec ]
    str_contains(group): code ","
    if(_): group [ sbm_group(s): s ]
    set(r): s
    if(_): {rx < 0} [ concat(r): "-" r ]
    str_starts(cur): code "$"
    if(_): cur [ concat(r): "$" r ]
    if(_): pct [ concat(r): r "%" ]
]

sbm_two(r): n [
    str_from_int(r): n
    if(_): {n < 10} [ concat(r): "0" r ]
]

sbm_pad_dec(r): s dec [
    set(r): s
    str_find(dot): r "." 0
    if(_): {dot < 0} [
        concat(r): r "."
        len(dot): s
    ]
    len(n): r
    set(have): {n - dot - 1}
    while(_): {have < dec} [
        concat(r): r "0"
        set(have): {have + 1}
    ]
]

sbm_group(r): s [
    str_find(dot): s "." 0
    set(intp): s
    set(rest): ""
    if(_): {dot >= 0} [
        slice(intp): s 0 dot
        len(n): s
        slice(rest): s dot {n - dot}
    ]
    set(r): ""
    len(n): intp
    set(i): 0
    while(_): {i < n} [
        slice(c): intp i 1
        if(_): {i > 0 && (n - i) % 3 = 0} [ concat(r): r "," ]
        concat(r): r c
        set(i): {i + 1}
    ]
    concat(r): r rest
]

# --- the functions

# [handled value]
sbm_call(r): name args [
    vec(r): ""
    len(n): args
    sbm_fn(v): name args n
    sbm_none(none):
    set(done): true
    typeof(vt): v
    if(_): {vt = "string"} [
        if(_): {v = none} [ set(done): false ]
    ]
    push(_): r done
    push(_): r v
]

sbm_none(r): [
    chr(z): 2
    concat(r): z "none"
]

sbm_fn(r): name args n [
    sbm_none(r):
    sb_err(bad): "#VALUE!"
    sb_err(na): "#N/A"
    sb_err(numerr): "#NUM!"
    sb_err(div0): "#DIV/0!"
    # --- lookup
    if(_): {name = "VLOOKUP" || name = "HLOOKUP"} [
        set(r): bad
        if(_): {n < 3} [ return(r): r ]
        sbm_arg(key): args 0
        at(tab): args 1
        sbm_num_arg(idx): args 2
        set(exact): false
        if(_): {n >= 4} [
            sbm_arg(ex): args 3
            sb_num(exn): ex
            set(exact): {exn = 0}
        ]
        sbm_is_range(isr): tab
        if(_): {isr = false} [ return(r): r ]
        at(r1): tab 0
        at(c1): tab 1
        at(r2): tab 2
        at(c2): tab 3
        set(vert): {name = "VLOOKUP"}
        set(count): {r2 - r1 + 1}
        set(width): {c2 - c1 + 1}
        if(_): {vert = false} [
            set(count): {c2 - c1 + 1}
            set(width): {r2 - r1 + 1}
        ]
        if(_): {idx < 1 || idx > width} [
            sb_err(r): "#REF!"
            return(r): r
        ]
        set(found): -1
        set(i): 0
        while(_): {i < count} [
            set(cell): {(r1 + i) * SB_COLS + c1}
            if(_): {vert = false} [ set(cell): {r1 * SB_COLS + c1 + i} ]
            sb_value(cv): cell
            if(_): exact [
                sbm_crit(m): cv key
                sbm_isnum(kn): key
                if(_): kn [ set(m): {cv = key} ]
                if(_): m [
                    set(found): i
                    set(i): count
                ]
            ]
            else(_): [
                # sorted: the last not greater than the key
                sb_compare_op(le): cv key "<="
                typeof(lt_): cv
                if(_): {le = true && lt_ != "null"} [ set(found): i ]
                if(_): {le = false} [ set(i): count ]
            ]
            set(i): {i + 1}
        ]
        if(_): {found < 0} [
            set(r): na
            return(r): r
        ]
        if(_): vert [ sb_value(r): {(r1 + found) * SB_COLS + c1 + idx - 1} ]
        else(_): [ sb_value(r): {(r1 + idx - 1) * SB_COLS + c1 + found} ]
        return(r): r
    ]
    if(_): {name = "INDEX"} [
        set(r): bad
        if(_): {n < 2} [ return(r): r ]
        at(tab): args 0
        sbm_is_range(isr): tab
        if(_): {isr = false} [ return(r): r ]
        sbm_num_arg(ri): args 1
        set(ci): 1
        if(_): {n >= 3} [ sbm_num_arg(ci): args 2 ]
        sbm_rows(nr): tab
        sbm_cols(nc): tab
        if(_): {nr = 1 && n = 2} [
            set(ci): ri
            set(ri): 1
        ]
        if(_): {ri < 1 || ri > nr || ci < 1 || ci > nc} [
            sb_err(r): "#REF!"
            return(r): r
        ]
        at(r1): tab 0
        at(c1): tab 1
        sb_value(r): {(r1 + ri - 1) * SB_COLS + c1 + ci - 1}
        return(r): r
    ]
    if(_): {name = "MATCH"} [
        set(r): bad
        if(_): {n < 2} [ return(r): r ]
        sbm_arg(key): args 0
        at(tab): args 1
        set(mt): 1
        if(_): {n >= 3} [ sbm_num_arg(mt): args 2 ]
        sbm_values(vs): tab
        len(nv): vs
        set(found): -1
        set(i): 0
        while(_): {i < nv} [
            at(cv): vs i
            if(_): {mt = 0} [
                sbm_crit(m): cv key
                sbm_isnum(kn): key
                if(_): kn [ set(m): {cv = key} ]
                if(_): m [
                    set(found): i
                    set(i): nv
                ]
            ]
            elif(_): {mt > 0} [
                sb_compare_op(le): cv key "<="
                if(_): le [ set(found): i ]
                else(_): [ set(i): nv ]
            ]
            else(_): [
                sb_compare_op(ge): cv key ">="
                if(_): ge [ set(found): i ]
                else(_): [ set(i): nv ]
            ]
            set(i): {i + 1}
        ]
        set(r): na
        if(_): {found >= 0} [ set(r): {found + 1} ]
        return(r): r
    ]
    if(_): {name = "XLOOKUP"} [
        set(r): bad
        if(_): {n < 3} [ return(r): r ]
        sbm_arg(key): args 0
        at(look): args 1
        at(ret): args 2
        sbm_values(lv): look
        sbm_values(rv): ret
        len(nv): lv
        set(i): 0
        while(_): {i < nv} [
            at(cv): lv i
            sbm_crit(m): cv key
            sbm_isnum(kn): key
            if(_): kn [ set(m): {cv = key} ]
            if(_): m [
                at(r): rv i
                return(r): r
            ]
            set(i): {i + 1}
        ]
        set(r): na
        if(_): {n >= 4} [ sbm_arg(r): args 3 ]
        return(r): r
    ]
    # --- conditional aggregates
    if(_): {name = "SUMIF" || name = "COUNTIF" || name = "AVERAGEIF"} [
        set(r): bad
        if(_): {n < 2} [ return(r): r ]
        at(rg): args 0
        sbm_arg(crit): args 1
        set(sr): rg
        if(_): {n >= 3} [ at(sr): args 2 ]
        sbm_values(cv): rg
        sbm_values(sv): sr
        set(sum): 0
        set(cnt): 0
        len(nc): cv
        len(ns): sv
        set(i): 0
        while(_): {i < nc} [
            at(v): cv i
            sbm_crit(m): v crit
            if(_): m [
                set(cnt): {cnt + 1}
                if(_): {i < ns} [
                    at(x): sv i
                    sbm_isnum(xn): x
                    if(_): xn [ set(sum): {sum + x} ]
                    elif(_): {name = "AVERAGEIF"} [ set(cnt): {cnt - 1} ]
                ]
            ]
            set(i): {i + 1}
        ]
        if(_): {name = "SUMIF"} [ set(r): sum ]
        elif(_): {name = "COUNTIF"} [ set(r): cnt ]
        elif(_): {cnt = 0} [ set(r): div0 ]
        else(_): [ sb_arith(r): sum cnt "/" ]
        return(r): r
    ]
    if(_): {name = "SUMIFS" || name = "COUNTIFS" || name = "AVERAGEIFS"} [
        set(r): bad
        set(first): 1
        if(_): {name = "COUNTIFS"} [ set(first): 0 ]
        if(_): {n < first + 2 || (n - first) % 2 != 0} [ return(r): r ]
        vec(sv): ""
        if(_): {first = 1} [
            at(sr): args 0
            sbm_values(sv): sr
        ]
        vec(lists): ""
        vec(crits): ""
        set(k): first
        while(_): {k + 1 < n} [
            at(rg): args k
            sbm_values(cv): rg
            push(_): lists cv
            sbm_arg(c): args {k + 1}
            push(_): crits c
            set(k): {k + 2}
        ]
        at(l0): lists 0
        len(nl): l0
        len(nk): lists
        set(sum): 0
        set(cnt): 0
        set(i): 0
        while(_): {i < nl} [
            set(all): true
            set(j): 0
            while(_): {j < nk && all} [
                at(lv): lists j
                at(c): crits j
                len(lvn): lv
                set(v): null
                if(_): {i < lvn} [ at(v): lv i ]
                sbm_crit(all): v c
                set(j): {j + 1}
            ]
            if(_): all [
                if(_): {first = 0} [ set(cnt): {cnt + 1} ]
                else(_): [
                    len(svn): sv
                    if(_): {i < svn} [
                        at(x): sv i
                        sbm_isnum(xn): x
                        if(_): xn [
                            set(sum): {sum + x}
                            set(cnt): {cnt + 1}
                        ]
                    ]
                ]
            ]
            set(i): {i + 1}
        ]
        if(_): {name = "SUMIFS"} [ set(r): sum ]
        elif(_): {name = "COUNTIFS"} [ set(r): cnt ]
        elif(_): {cnt = 0} [ set(r): div0 ]
        else(_): [ sb_arith(r): sum cnt "/" ]
        return(r): r
    ]
    # --- logic (errors are values here, not stoppers)
    if(_): {name = "IFERROR" || name = "IFNA"} [
        set(r): bad
        if(_): {n != 2} [ return(r): r ]
        sbm_arg(a): args 0
        sb_is_err(e): a
        if(_): {e && name = "IFNA"} [ set(e): {a = na} ]
        if(_): e [ sbm_arg(r): args 1 ]
        else(_): [ set(r): a ]
        return(r): r
    ]
    if(_): {name = "ISERROR" || name = "ISBLANK" || name = "ISNUMBER" || name = "ISTEXT" || name = "ISLOGICAL" || name = "ISNA"} [
        set(r): bad
        if(_): {n != 1} [ return(r): r ]
        sbm_arg(a): args 0
        typeof(t): a
        sb_is_err(e): a
        if(_): {name = "ISERROR"} [ set(r): e ]
        elif(_): {name = "ISNA"} [ set(r): {a = na} ]
        elif(_): {name = "ISBLANK"} [ set(r): {t = "null"} ]
        elif(_): {name = "ISNUMBER"} [ set(r): {t = "integer" || t = "real"} ]
