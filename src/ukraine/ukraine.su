# Ukraine HTTP/1.1 server and small handler framework.
#
# Applications include this file and define:
#   uk_route(result): method target raw_request [ ... uk_response(result): ... ]
# The server owns a nonblocking listener. Each accepted connection is handled
# by a USSR scheduler task; this module does not spawn operating-system tasks.
#
#   uk_server(result): host port                      plain HTTP
#   uk_request_header(v): request name               header value, "" if absent
#   uk_request_body(b): request                      bytes after the head
#   uk_response_ex(r): status type headers body      response with extra
#       "\n"-separated header lines
# Bodies are read through Content-Length, up to the global uk_max_body
# (1 MiB when unset); longer requests get 413.
#
#   uk_server_tls(result): host port cert secret      HTTPS through ryazan.su;
#       cert is a PKCS#12 file (.p12/.pfx) and secret its password (with
#       OpenSSL also a PEM certificate chain and the PEM key file)
$include "../ryazan/ryazan.su"

uk_find(result): text needle start [
    len(uk_find_text_len): text
    len(uk_find_needle_len): needle
    set(result): {0 - 1}
    set(uk_find_i): start
    if(_): {uk_find_i < 0} [
        set(uk_find_i): 0
    ]
    while(_): {uk_find_i <= uk_find_text_len - uk_find_needle_len} [
        slice(uk_find_part): text uk_find_i uk_find_needle_len
        if(_): {uk_find_part = needle} [
            set(result): uk_find_i
            return(result): result
        ]
        add(uk_find_i): uk_find_i 1
    ]
]

# One chunk of the request: text, "" once the peer closed, null on error.
uk_recv(result): client tls [
    if(_): {tls = 0} [
        wait_readable(uk_recv_ready): client
        socket_recv(result): client 4096
    ]
    else(_): [
        ryazan_read(result): client 4096
    ]
]

# The whole request: head and, when it has a Content-Length, the body.
# "" when the request is malformed or the peer went away; the integer 413
# when the body is longer than uk_max_body (1 MiB unless the application
# sets the global uk_max_body before uk_server).
uk_read_request(result): client tls [
    set(result): ""
    set(uk_read_done): 0
    set(uk_read_failed): 0
    set(uk_read_end): {0 - 1}
    set(uk_read_from): 0
    set(uk_read_need): 0
    set(uk_read_limit): uk_max_body
    if(_): {uk_read_limit = null} [
        set(uk_read_limit): 1048576
    ]
    while(_): {uk_read_done = 0} [
        uk_recv(uk_read_chunk): client tls
        if(_): {uk_read_chunk = null} [
            set(uk_read_failed): 1
            set(uk_read_done): 1
        ]
        if(_): {uk_read_chunk != null} [
            len(uk_read_chunk_len): uk_read_chunk
            if(_): {uk_read_chunk_len = 0} [
                set(uk_read_failed): 1
                set(uk_read_done): 1
            ]
            if(_): {uk_read_chunk_len > 0} [
                concat(result): result uk_read_chunk
                len(uk_read_total): result
                if(_): {uk_read_end < 0} [
                    # only the new bytes (and three before them) can end the head
                    uk_find(uk_read_end): result "\r\n\r\n" uk_read_from
                    set(uk_read_from): {uk_read_total - 3}
                    if(_): {uk_read_end < 0 && uk_read_total > 16384} [
                        set(uk_read_failed): 1
                        set(uk_read_done): 1
                    ]
                    if(_): {uk_read_end > 16380} [
                        set(uk_read_failed): 1
                        set(uk_read_done): 1
                    ]
                    if(_): {uk_read_end >= 0 && uk_read_failed = 0} [
                        uk_request_header(uk_read_length): result "content-length"
                        set(uk_read_body): 0
                        if(_): {uk_read_length != ""} [
                            str_to_number(uk_read_body): uk_read_length
                            typeof(uk_read_type): uk_read_body
                            if(_): {uk_read_type != "integer"} [
                                set(uk_read_body): {0 - 1}
                            ]
                        ]
                        if(_): {uk_read_body < 0} [
                            set(uk_read_failed): 1
                            set(uk_read_done): 1
                        ]
                        if(_): {uk_read_body > uk_read_limit} [
                            set(uk_read_failed): 2
                            set(uk_read_done): 1
                        ]
                        set(uk_read_need): {uk_read_end + 4 + uk_read_body}
                    ]
                ]
                if(_): {uk_read_end >= 0 && uk_read_failed = 0 && uk_read_total >= uk_read_need} [
                    set(uk_read_done): 1
                ]
            ]
        ]
    ]
    if(_): {uk_read_failed = 1} [
        set(result): ""
    ]
    if(_): {uk_read_failed = 2} [
        set(result): 413
    ]
]

# Value of the request header name (ASCII case-insensitive), blanks
# trimmed; "" when the request has no such header.
uk_request_header(result): request name [
    set(result): ""
    uk_find(uk_header_end): request "\r\n\r\n" 0
    if(_): {uk_header_end < 0} [
        return(result): result
    ]
    slice(uk_header_head): request 0 {uk_header_end + 2}
    str_lower(uk_header_lower): uk_header_head
    str_lower(uk_header_name): name
    concat(uk_header_key): "\r\n" uk_header_name ":"
    uk_find(uk_header_at): uk_header_lower uk_header_key 0
    if(_): {uk_header_at < 0} [
        return(result): result
    ]
    len(uk_header_key_len): uk_header_key
    add(uk_header_from): uk_header_at uk_header_key_len
    uk_find(uk_header_stop): uk_header_head "\r\n" uk_header_from
    slice(uk_header_value): uk_header_head uk_header_from {uk_header_stop - uk_header_from}
    str_trim(result): uk_header_value
]

# The bytes after the blank line that ends the head ("" when none).
uk_request_body(result): request [
    set(result): ""
    uk_find(uk_body_at): request "\r\n\r\n" 0
    if(_): {uk_body_at >= 0} [
        len(uk_body_total): request
        slice(result): request {uk_body_at + 4} {uk_body_total - uk_body_at - 4}
    ]
]

uk_request_method(result): request [
    uk_find(uk_method_end): request " " 0
    if(_): {uk_method_end < 1} [
        set(result): ""
        return(result): result
    ]
    slice(result): request 0 uk_method_end
]

uk_request_target(result): request [
    uk_find(uk_target_first): request " " 0
    if(_): {uk_target_first < 0} [
        set(result): ""
        return(result): result
    ]
    add(uk_target_start): uk_target_first 1
    uk_find(uk_target_end): request " " uk_target_start
    if(_): {uk_target_end <= uk_target_start} [
        set(result): ""
        return(result): result
    ]
    slice(result): request uk_target_start {uk_target_end - uk_target_start}
]

uk_response(result): status_line content_type body [
    uk_response_ex(result): status_line content_type "" body
]

# uk_response with extra header lines, separated by "\n" (a trailing newline
# is optional; "" for none), for example "Location: /\nCache-Control: no-store".
uk_response_ex(result): status_line content_type headers body [
    len(uk_resp_length): body
    str_from_int(uk_resp_length_text): uk_resp_length
    set(result): "HTTP/1.1 "
    concat(result): result status_line "\r\n"
    concat(result): result "Content-Type: " content_type "\r\n"
    concat(result): result "Content-Length: " uk_resp_length_text "\r\n"
    concat(result): result "Connection: close\r\n"
    concat(result): result "X-Content-Type-Options: nosniff\r\n"
    len(uk_resp_headers_len): headers
    set(uk_resp_from): 0
    while(_): {uk_resp_from < uk_resp_headers_len} [
        uk_find(uk_resp_stop): headers "\n" uk_resp_from
        if(_): {uk_resp_stop < 0} [
            set(uk_resp_stop): uk_resp_headers_len
        ]
        slice(uk_resp_line): headers uk_resp_from {uk_resp_stop - uk_resp_from}
        str_trim(uk_resp_line): uk_resp_line
        if(_): {uk_resp_line != ""} [
            concat(result): result uk_resp_line "\r\n"
        ]
        add(uk_resp_from): uk_resp_stop 1
    ]
    concat(result): result "\r\n" body
]

uk_send_all(result): client response tls [
    if(_): {tls != 0} [
        ryazan_write(result): client response
        return(result): result
    ]
    len(uk_send_total): response
    set(uk_send_offset): 0
    set(uk_send_retries): 0
    set(uk_send_failed): 0
    while(_): {uk_send_offset < uk_send_total} [
        slice(uk_send_chunk): response uk_send_offset {uk_send_total - uk_send_offset}
        socket_send(uk_send_count): client uk_send_chunk
        if(_): {uk_send_count > 0} [
            add(uk_send_offset): uk_send_offset uk_send_count
            set(uk_send_retries): 0
        ]
        if(_): {uk_send_count <= 0} [
            add(uk_send_retries): uk_send_retries 1
            if(_): {uk_send_retries > 8} [
                set(uk_send_failed): 1
                set(uk_send_offset): uk_send_total
            ]
            if(_): {uk_send_failed = 0} [
                wait_writable(uk_send_ready): client
            ]
        ]
    ]
    set(result): {0 - 1}
    if(_): {uk_send_failed = 0} [
        set(result): 0
    ]
]

uk_client(result): client [
    uk_connection(result): client 0
]

uk_client_tls(result): client credential secret [
    ryazan_accept(uk_client_shaken): client credential secret
    if(_): {uk_client_shaken != 0} [
        # not TLS, an untrusted client certificate check, ...: drop it
        socket_close(uk_client_closed): client
        set(result): {0 - 1}
        return(result): result
    ]
    uk_connection(result): client 1
]

uk_connection(result): client tls [
    uk_read_request(uk_client_request): client tls
    if(_): {uk_client_request = 413} [
        uk_response(uk_client_response): "413 Content Too Large" "text/plain; charset=utf-8" "Content Too Large\n"
        uk_send_all(uk_client_sent): client uk_client_response tls
        set(uk_client_request): ""
    ]
    len(uk_client_request_len): uk_client_request
    if(_): {uk_client_request_len > 0} [
        uk_request_method(uk_client_method): uk_client_request
        uk_request_target(uk_client_target): uk_client_request
        if(_): {uk_client_method = ""} [
            uk_response(uk_client_response): "400 Bad Request" "text/plain; charset=utf-8" "Bad Request\n"
        ]
        if(_): {uk_client_method != ""} [
            if(_): {uk_client_target = ""} [
                uk_response(uk_client_response): "400 Bad Request" "text/plain; charset=utf-8" "Bad Request\n"
            ]
            if(_): {uk_client_target != ""} [
                uk_route(uk_client_response): uk_client_method uk_client_target uk_client_request
            ]
        ]
        uk_send_all(uk_client_sent): client uk_client_response tls
    ]
    if(_): {tls != 0} [
        ryazan_close(uk_client_closed): client
    ]
    else(_): [
        socket_close(uk_client_closed): client
    ]
    set(result): 0
]

uk_server(result): host port [
    uk_serve(result): host port "" ""
]

uk_server_tls(result): host port credential secret [
    tls_backend(uk_tls_backend):
    if(_): {uk_tls_backend = "none"} [
        print(_): "ukraine: this ussr was built without TLS\n"
        set(result): {0 - 1}
        return(result): result
    ]
    uk_serve(result): host port credential secret
]

uk_serve(result): host port credential secret [
    socket_tcp(uk_listener):
    if(_): {uk_listener < 1} [
        print(_): "ukraine: could not create TCP socket\n"
        set(result): {0 - 1}
        return(result): result
    ]
    socket_bind(uk_bound): uk_listener host port
    if(_): {uk_bound != 0} [
        print(_): "ukraine: could not bind listener\n"
        socket_close(uk_closed): uk_listener
        set(result): {0 - 1}
        return(result): result
    ]
    socket_listen(uk_listening): uk_listener 128
    if(_): {uk_listening != 0} [
        print(_): "ukraine: could not listen on socket\n"
        socket_close(uk_closed): uk_listener
        set(result): {0 - 1}
        return(result): result
    ]
    set(uk_listening_message): "ukraine: listening on "
    if(_): {credential != ""} [
        set(uk_listening_message): "ukraine: listening (HTTPS) on "
    ]
    concat(uk_listening_message): uk_listening_message host "\n"
    print(_): uk_listening_message
    while(_): {true} [
        wait_readable(uk_accept_ready): uk_listener
        socket_accept(uk_client_socket): uk_listener
        if(_): {uk_client_socket > 0} [
            if(_): {credential = ""} [
                async(uk_client_pid): "uk_client" uk_client_socket
            ]
            else(_): [
                async(uk_client_pid): "uk_client_tls" uk_client_socket credential secret
            ]
            if(_): {uk_client_pid < 0} [
                socket_close(uk_rejected_client): uk_client_socket
                print(_): "ukraine: could not schedule client handler\n"
            ]
        ]
    ]
]
