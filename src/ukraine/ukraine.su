# Ukraine HTTP/1.1 server and small handler framework.
#
# Applications include this file and define:
#   uk_route(result): method target raw_request [ ... uk_response(result): ... ]
# The server owns a nonblocking listener. Each accepted connection is handled
# by a USSR scheduler task; this module does not spawn operating-system tasks.
#
#   uk_server(result): host port                      plain HTTP
#   uk_request_header(v): request name               header value, "" if absent
#   uk_request_body(b): request                      bytes after the head
#   uk_response_ex(r): status type headers body      response with extra
#       "\n"-separated header lines
# Bodies are read through Content-Length or chunked transfer coding, up to
# the global uk_max_body (1 MiB when unset); longer requests get 413.
# Keep-alive, timeouts, a connection limit and strict parsing are set with
# globals (see "Settings" below); the framework layer is app.su.
#
#   uk_server_tls(result): host port cert secret      HTTPS through ryazan.su;
#       cert is a PKCS#12 file (.p12/.pfx) and secret its password (with
#       OpenSSL also a PEM certificate chain and the PEM key file)
$include "../ryazan/ryazan.su"

uk_find(result): text needle start [
    len(uk_find_text_len): text
    len(uk_find_needle_len): needle
    set(result): {0 - 1}
    set(uk_find_i): start
    if(_): {uk_find_i < 0} [
        set(uk_find_i): 0
    ]
    while(_): {uk_find_i <= uk_find_text_len - uk_find_needle_len} [
        slice(uk_find_part): text uk_find_i uk_find_needle_len
        if(_): {uk_find_part = needle} [
            set(result): uk_find_i
            return(result): result
        ]
        add(uk_find_i): uk_find_i 1
    ]
]

# One chunk of the request: text, "" once the peer closed, null on error.
# With a deadline (time(s): seconds, 0 for none) it gives the integer 408
# when nothing came in time.
uk_recv(result): client tls [
    uk_recv_until(result): client tls 0
]

uk_recv_until(result): client tls deadline [
    set(result): null
    set(go): true
    while(_): go [
        if(_): {deadline = 0} [
            if(_): {tls = 0} [
                wait_readable(_): client
                socket_recv(result): client 4096
            ]
            else(_): [
                ryazan_read(result): client 4096
            ]
            set(go): false
        ]
        else(_): [
            if(_): {tls = 0} [
                socket_recv(result): client 4096
            ]
            else(_): [
                tls_recv(result): client 4096
            ]
            typeof(t): result
            if(_): {t != "null"} [
                set(go): false
            ]
            else(_): [
                time(now):
                if(_): {now >= deadline} [
                    set(result): 408
                    set(go): false
                ]
                else(_): [
                    sleep(_): 10
                ]
            ]
        ]
    ]
]

# Settings an application may set as globals before uk_server (all
# optional; unset means the default in brackets):
#   uk_max_body        largest request body in bytes [1 MiB]
#   uk_keepalive       true: several requests per connection, pipelined
#                      requests answered in order [false]
#   uk_max_requests    requests per kept-alive connection [100]
#   uk_header_timeout  seconds to receive a request head, 0 for none [0]
#   uk_body_timeout    seconds to receive a body after its head [0]
#   uk_idle_timeout    seconds a kept-alive connection may sit idle [5]
#   uk_max_connections connections served at once, 0 for no limit [0];
#                      others get 503 at once
#   uk_server_name     the Server header ["ukraine"]; "" sends none
#   uk_lenient         true: accept duplicate Content-Length and
#                      Content-Length with Transfer-Encoding [false]
# Every response gets Date, Server (unless "") and X-Request-Id headers
# when the handler did not set them.

_uk_setting(result): value default [
    set(result): value
    typeof(t): value
    if(_): {t = "null"} [
        set(result): default
    ]
]

_uk_now_deadline(result): seconds [
    set(result): 0
    if(_): {seconds > 0} [
        time(now):
        set(result): {now + seconds}
    ]
]

# How many times a header occurs in the head (names case-insensitive).
uk_header_count(result): request name [
    uk_find(end): request "\r\n\r\n" 0
    set(result): 0
    if(_): {end < 0} [
        return(result): result
    ]
    slice(head): request 0 {end + 2}
    str_lower(lower): head
    str_lower(lname): name
    concat(key): "\r\n" lname ":"
    len(klen): key
    uk_find(at): lower key 0
    while(_): {at >= 0} [
        set(result): {result + 1}
        uk_find(at): lower key {at + klen}
    ]
]

# Checks the request line and header lines strictly: "" when they are
# fine, else the reason (the caller answers 400).
uk_check_head(result): head [
    set(result): ""
    str_split(lines): head "\r\n"
    at(first): lines 0
    re_test(good): "^[A-Z]+ [^ ]+ HTTP/1\\.[01]$" first
    if(_): {good = false} [
        set(result): "bad request line"
        return(result): result
    ]
    len(n): lines
    set(i): 1
    while(_): {i < n} [
        at(line): lines i
        if(_): {line != ""} [
            re_test(field): "^[!#$%&'*+.^_`|~0-9A-Za-z-]+:" line
            if(_): {field = false} [
                set(result): "bad header line"
                return(result): result
            ]
        ]
        set(i): {i + 1}
    ]
]

# Decodes a chunked body that starts at body; [decoded, bytes used] or
# null when it is not complete yet, or the integer 400 when malformed.
uk_dechunk(result): body limit [
    set(result): null
    set(out): ""
    set(p): 0
    len(n): body
    while(_): {true} [
        uk_find(eol): body "\r\n" p
        if(_): {eol < 0} [
            return(result): result
        ]
        slice(sizeline): body p {eol - p}
        uk_find(semi): sizeline ";" 0
        if(_): {semi >= 0} [
            slice(sizeline): sizeline 0 semi
        ]
        str_trim(sizeline): sizeline
        re_test(hex): "^[0-9A-Fa-f]{1,8}$" sizeline
        if(_): {hex = false} [
            set(result): 400
            return(result): result
        ]
        str_to_int(size): sizeline 16
        set(start): {eol + 2}
        if(_): {size = 0} [
            # trailers end with an empty line
            uk_find(fin): body "\r\n\r\n" {eol}
            if(_): {fin < 0} [
                slice(rest): body start 2
                if(_): {rest = "\r\n"} [
                    set(fin): eol
                ]
                else(_): [
                    return(result): result
                ]
            ]
            vec(result): ""
            push(_): result out
            push(_): result {fin + 4}
            return(result): result
        ]
        len(have): out
        if(_): {have + size > limit} [
            set(result): 413
            return(result): result
        ]
        if(_): {start + size + 2 > n} [
            return(result): result
        ]
        slice(piece): body start size
        concat(out): out piece
        slice(crlf): body {start + size} 2
        if(_): {crlf != "\r\n"} [
            set(result): 400
            return(result): result
        ]
        set(p): {start + size + 2}
    ]
]

# One request from the connection, starting with the bytes in buf (left
# over from a pipelined earlier request). [request, leftover]; request is
# the text (a chunked body arrives decoded, with a Content-Length), or ""
# when the peer closed or sent garbage, or an integer status to answer
# with: 400, 408, 413.
uk_read_one(result): client tls buf first [
    _uk_setting(limit): uk_max_body 1048576
    _uk_setting(htimeout): uk_header_timeout 0
    _uk_setting(btimeout): uk_body_timeout 0
    _uk_setting(itimeout): uk_idle_timeout 5
    _uk_setting(lenient): uk_lenient false
    set(wait): htimeout
    if(_): {first = false && itimeout > 0} [
        set(wait): itimeout
    ]
    _uk_now_deadline(deadline): wait
    set(data): buf
    set(status): ""
    set(end): {0 - 1}
    set(from): 0
    set(continued): false
    set(go): true
    while(_): go [
        len(total): data
        if(_): {end < 0} [
            uk_find(end): data "\r\n\r\n" from
            set(from): {total - 3}
            if(_): {from < 0} [
                set(from): 0
            ]
            if(_): {end < 0 && total > 16384} [
                set(status): 400
                set(go): false
            ]
            if(_): {end >= 0} [
                # the head is in: from now on the body deadline applies
                _uk_now_deadline(deadline): btimeout
            ]
        ]
        if(_): {go && end >= 0} [
            slice(head): data 0 end
            uk_check_head(why): head
            uk_request_header(te): data "transfer-encoding"
            str_lower(te): te
            uk_header_count(ncl): data "content-length"
            uk_request_header(cl): data "content-length"
            set(chunked): {te != ""}
            if(_): {why != ""} [
                set(status): 400
                set(go): false
            ]
            elif(_): {lenient = false && (ncl > 1 || (chunked && ncl > 0))} [
                # request smuggling forms
                set(status): 400
                set(go): false
            ]
            elif(_): {chunked && te != "chunked"} [
                set(status): 400
                set(go): false
            ]
            else(_): [
                uk_request_header(expect): data "expect"
                str_lower(expect): expect
                slice(after): data {end + 4} {total - end - 4}
                len(have): after
                set(need_body): {chunked || (cl != "" && cl != "0")}
                if(_): {expect = "100-continue" && need_body && have = 0 && continued = false} [
                    uk_send_all(_): client "HTTP/1.1 100 Continue\r\n\r\n" tls
                    set(continued): true
                ]
                if(_): chunked [
                    uk_dechunk(dc): after limit
                    typeof(dt): dc
                    if(_): {dt = "integer"} [
                        set(status): dc
                        set(go): false
                    ]
                    elif(_): {dt = "vector"} [
                        at(plain): dc 0
                        at(used): dc 1
                        len(pl): plain
                        str_from_int(pls): pl
                        # the head without Transfer-Encoding, with a length
                        str_split(lines): head "\r\n"
                        set(newhead): ""
                        len(ln): lines
                        set(i): 0
                        while(_): {i < ln} [
                            at(line): lines i
                            str_lower(ll): line
                            str_starts(is_te): ll "transfer-encoding:"
                            if(_): {is_te = false} [
                                concat(newhead): newhead line "\r\n"
                            ]
                            set(i): {i + 1}
                        ]
                        concat(status): newhead "Content-Length: " pls "\r\n\r\n" plain
                        slice(left): after used {have - used}
                        set(data): left
                        set(go): false
                    ]
                ]
                else(_): [
                    set(body): 0
                    if(_): {cl != ""} [
                        str_to_number(body): cl
                        typeof(bt): body
                        if(_): {bt != "integer"} [
                            set(body): {0 - 1}
                        ]
                    ]
                    if(_): {body < 0} [
                        set(status): 400
                        set(go): false
                    ]
                    elif(_): {body > limit} [
                        set(status): 413
                        set(go): false
                    ]
                    elif(_): {have >= body} [
                        slice(status): data 0 {end + 4 + body}
                        slice(left): data {end + 4 + body} {total - end - 4 - body}
                        set(data): left
                        set(go): false
                    ]
                ]
            ]
        ]
        if(_): go [
            uk_recv_until(chunk): client tls deadline
            typeof(ct): chunk
            if(_): {ct = "integer"} [
                # a timeout: 408 only when part of a request had come
                set(status): ""
                len(dl): data
                if(_): {dl > 0} [
                    set(status): 408
                ]
                set(go): false
            ]
            elif(_): {ct = "null" || chunk = ""} [
                set(status): ""
                set(go): false
            ]
            else(_): [
                concat(data): data chunk
            ]
        ]
    ]
    typeof(st): status
    if(_): {st = "integer"} [
        set(data): ""
    ]
    vec(result): ""
    push(_): result status
    push(_): result data
]

# The whole request: head and, when it has a Content-Length, the body.
# "" when the request is malformed or the peer went away; the integer 413
# when the body is longer than uk_max_body (1 MiB unless the application
# sets the global uk_max_body before uk_server).
uk_read_request(result): client tls [
    uk_read_one(got): client tls "" true
    at(result): got 0
    typeof(t): result
    if(_): {t = "integer" && result != 413} [
        set(result): ""
    ]
]

# Value of the request header name (ASCII case-insensitive), blanks
# trimmed; "" when the request has no such header.
uk_request_header(result): request name [
    set(result): ""
    uk_find(uk_header_end): request "\r\n\r\n" 0
    if(_): {uk_header_end < 0} [
        return(result): result
    ]
    slice(uk_header_head): request 0 {uk_header_end + 2}
    str_lower(uk_header_lower): uk_header_head
    str_lower(uk_header_name): name
    concat(uk_header_key): "\r\n" uk_header_name ":"
    uk_find(uk_header_at): uk_header_lower uk_header_key 0
    if(_): {uk_header_at < 0} [
        return(result): result
    ]
    len(uk_header_key_len): uk_header_key
    add(uk_header_from): uk_header_at uk_header_key_len
    uk_find(uk_header_stop): uk_header_head "\r\n" uk_header_from
    slice(uk_header_value): uk_header_head uk_header_from {uk_header_stop - uk_header_from}
    str_trim(result): uk_header_value
]

# The bytes after the blank line that ends the head ("" when none).
uk_request_body(result): request [
    set(result): ""
    uk_find(uk_body_at): request "\r\n\r\n" 0
    if(_): {uk_body_at >= 0} [
        len(uk_body_total): request
        slice(result): request {uk_body_at + 4} {uk_body_total - uk_body_at - 4}
    ]
]

uk_request_method(result): request [
    uk_find(uk_method_end): request " " 0
    if(_): {uk_method_end < 1} [
        set(result): ""
        return(result): result
    ]
    slice(result): request 0 uk_method_end
]

uk_request_target(result): request [
    uk_find(uk_target_first): request " " 0
    if(_): {uk_target_first < 0} [
        set(result): ""
        return(result): result
    ]
    add(uk_target_start): uk_target_first 1
    uk_find(uk_target_end): request " " uk_target_start
    if(_): {uk_target_end <= uk_target_start} [
        set(result): ""
        return(result): result
    ]
    slice(result): request uk_target_start {uk_target_end - uk_target_start}
]

uk_response(result): status_line content_type body [
    uk_response_ex(result): status_line content_type "" body
]

# uk_response with extra header lines, separated by "\n" (a trailing newline
# is optional; "" for none), for example "Location: /\nCache-Control: no-store".
uk_response_ex(result): status_line content_type headers body [
    len(uk_resp_length): body
    str_from_int(uk_resp_length_text): uk_resp_length
    set(result): "HTTP/1.1 "
    concat(result): result status_line "\r\n"
    concat(result): result "Content-Type: " content_type "\r\n"
    concat(result): result "Content-Length: " uk_resp_length_text "\r\n"
    concat(result): result "Connection: close\r\n"
    concat(result): result "X-Content-Type-Options: nosniff\r\n"
    len(uk_resp_headers_len): headers
    set(uk_resp_from): 0
    while(_): {uk_resp_from < uk_resp_headers_len} [
        uk_find(uk_resp_stop): headers "\n" uk_resp_from
        if(_): {uk_resp_stop < 0} [
            set(uk_resp_stop): uk_resp_headers_len
        ]
        slice(uk_resp_line): headers uk_resp_from {uk_resp_stop - uk_resp_from}
        str_trim(uk_resp_line): uk_resp_line
        if(_): {uk_resp_line != ""} [
            concat(result): result uk_resp_line "\r\n"
        ]
        add(uk_resp_from): uk_resp_stop 1
    ]
    concat(result): result "\r\n" body
]

uk_send_all(result): client response tls [
    if(_): {tls != 0} [
        ryazan_write(result): client response
        return(result): result
    ]
    len(uk_send_total): response
    set(uk_send_offset): 0
    set(uk_send_retries): 0
    set(uk_send_failed): 0
    while(_): {uk_send_offset < uk_send_total} [
        slice(uk_send_chunk): response uk_send_offset {uk_send_total - uk_send_offset}
        socket_send(uk_send_count): client uk_send_chunk
        if(_): {uk_send_count > 0} [
            add(uk_send_offset): uk_send_offset uk_send_count
            set(uk_send_retries): 0
        ]
        if(_): {uk_send_count <= 0} [
            add(uk_send_retries): uk_send_retries 1
            if(_): {uk_send_retries > 8} [
                set(uk_send_failed): 1
                set(uk_send_offset): uk_send_total
            ]
            if(_): {uk_send_failed = 0} [
                wait_writable(uk_send_ready): client
            ]
        ]
    ]
    set(result): {0 - 1}
    if(_): {uk_send_failed = 0} [
        set(result): 0
    ]
]

uk_client(result): client [
    uk_connection(result): client 0
]

uk_client_tls(result): client credential secret [
    global(_): uk_open_counter
    ryazan_accept(uk_client_shaken): client credential secret
    if(_): {uk_client_shaken != 0} [
        # not TLS, an untrusted client certificate check, ...: drop it
        socket_close(uk_client_closed): client
        typeof(ot): uk_open_counter
        if(_): {ot = "btree"} [
            btget(open_now): uk_open_counter "open" 1
            btput(_): uk_open_counter "open" {open_now - 1}
        ]
        set(result): {0 - 1}
        return(result): result
    ]
    uk_connection(result): client 1
]

# "Sun, 06 Nov 1994 08:49:37 GMT" for a time(s): value
uk_http_date(result): seconds [
    set(days): {seconds / 86400}
    str_trunc(days): days
    if(_): {days * 86400 > seconds} [
        set(days): {days - 1}
    ]
    set(rest): {seconds - days * 86400}
    # civil from days (Howard Hinnant)
    set(z): {days + 719468}
    str_trunc(era): {z / 146097}
    set(doe): {z - era * 146097}
    str_trunc(a): {doe / 1460}
    str_trunc(b): {doe / 36524}
    str_trunc(c): {doe / 146096}
    str_trunc(yoe): {(doe - a + b - c) / 365}
    str_trunc(q4): {yoe / 4}
    str_trunc(q100): {yoe / 100}
    set(doy): {doe - (365 * yoe + q4 - q100)}
    str_trunc(mp): {(5 * doy + 2) / 153}
    str_trunc(dd): {(153 * mp + 2) / 5}
    set(d): {doy - dd + 1}
    set(m): {mp + 3}
    if(_): {mp >= 10} [
        set(m): {mp - 9}
    ]
    set(y): {yoe + era * 400}
    if(_): {m <= 2} [
        set(y): {y + 1}
    ]
    set(wd): {(days + 4) % 7}
    str_split(dnames): "Sun,Mon,Tue,Wed,Thu,Fri,Sat" ","
    str_split(mnames): "Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec" ","
    at(dn): dnames wd
    at(mn): mnames {m - 1}
    str_trunc(hh): {rest / 3600}
    set(rest): {rest - hh * 3600}
    str_trunc(mi): {rest / 60}
    set(ss): {rest - mi * 60}
    str_from_int(ds): d
    str_pad_left(ds): ds 2 "0"
    str_from_int(ys): y
    str_from_int(hs): hh
    str_pad_left(hs): hs 2 "0"
    str_from_int(ms): mi
    str_pad_left(ms): ms 2 "0"
    str_from_int(sx): ss
    str_pad_left(sx): sx 2 "0"
    concat(result): dn ", " ds " " mn " " ys " " hs ":" ms ":" sx " GMT"
]

uk_request_id(result): [
    random64(x):
    set(x): {x & 0xFFFFFFFFFFFF}
    str_from_int_base(result): x 16
    str_pad_left(result): result 12 "0"
]

# Adds Date, Server and X-Request-Id when missing, and sets the
# Connection header to keep-alive or close.
uk_finish_response(result): response keep request_id [
    set(result): response
    uk_find(end): response "\r\n\r\n" 0
    if(_): {end < 0} [
        return(result): result
    ]
    slice(head): response 0 end
    len(n): response
    slice(body): response {end + 4} {n - end - 4}
    concat(probe): head "\r\n\r\n"
    str_split(lines): head "\r\n"
    at(status_line): lines 0
    set(out): status_line
    len(ln): lines
    set(i): 1
    set(saw_conn): false
    while(_): {i < ln} [
        at(line): lines i
        str_lower(ll): line
        str_starts(is_conn): ll "connection:"
        if(_): is_conn [
            set(saw_conn): true
            if(_): keep [
                set(line): "Connection: keep-alive"
            ]
            else(_): [
                set(line): "Connection: close"
            ]
        ]
        concat(out): out "\r\n" line
        set(i): {i + 1}
    ]
    if(_): {saw_conn = false} [
        if(_): keep [
            concat(out): out "\r\nConnection: keep-alive"
        ]
        else(_): [
            concat(out): out "\r\nConnection: close"
        ]
    ]
    uk_header_count(has_date): probe "date"
    if(_): {has_date = 0} [
        time(now):
        uk_http_date(date): now
        concat(out): out "\r\nDate: " date
    ]
    _uk_setting(name): uk_server_name "ukraine"
    uk_header_count(has_server): probe "server"
    if(_): {has_server = 0 && name != ""} [
        concat(out): out "\r\nServer: " name
    ]
    uk_header_count(has_id): probe "x-request-id"
    if(_): {has_id = 0 && request_id != ""} [
        concat(out): out "\r\nX-Request-Id: " request_id
    ]
    concat(result): out "\r\n\r\n" body
]

uk_status_response(result): code [
    set(line): "400 Bad Request"
    if(_): {code = 408} [
        set(line): "408 Request Timeout"
    ]
    elif(_): {code = 413} [
        set(line): "413 Content Too Large"
    ]
    elif(_): {code = 503} [
        set(line): "503 Service Unavailable"
    ]
    len(ll): line
    slice(text): line 4 {ll - 4}
    concat(text): text "\n"
    uk_response(result): line "text/plain; charset=utf-8" text
]

uk_connection(result): client tls [
    _uk_setting(keepalive): uk_keepalive false
    _uk_setting(max_requests): uk_max_requests 100
    _uk_setting(htimeout): uk_header_timeout 0
    _uk_setting(itimeout): uk_idle_timeout 5
    if(_): {htimeout > 0 || (keepalive && itimeout > 0)} [
        socket_nonblocking(_): client
    ]
    set(buf): ""
    set(served): 0
    set(go): true
    while(_): go [
        uk_read_one(got): client tls buf {served = 0}
        at(request): got 0
        at(buf): got 1
        typeof(rt): request
        set(response): ""
        set(keep): false
        uk_request_id(rid):
        if(_): {rt = "integer"} [
            uk_status_response(response): request
            set(go): false
        ]
        elif(_): {request = ""} [
            set(go): false
        ]
        else(_): [
            uk_request_method(method): request
            uk_request_target(target): request
            if(_): {method = "" || target = ""} [
                uk_status_response(response): 400
                set(go): false
            ]
            else(_): [
                uk_route(response): method target request
                set(served): {served + 1}
