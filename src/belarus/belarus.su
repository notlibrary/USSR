# Belarus - the USSR file system: inodes whose blocks are found through
# B+ trees, on a disk, a disk image or a partition of either. Library
# and command line:
#
#     ussr src/belarus/belarus.su mkfs disk.img --label ussr
#     ussr src/belarus/belarus.su put disk.img README.md /README.md
#     ussr src/belarus/belarus.su ls disk.img /
#     ussr src/belarus/belarus.su help            # every command
#
# The layout (4096-byte blocks, counted from the start of the partition):
#   block 0              the superblock, "BELARUS1": the root directory's
#                        inode, the size, label and UUID
#   blocks 1 .. 16       the free-space map, "BLFREE01"
#   the other blocks     inodes ("BLINODE1"), block map nodes ("BLBMAP01")
#                        and the data of files and directories
# A metadata block is a 24-byte ASCII header - the magic, the text's
# length and its CRC-32, each 8 hex digits - and then the text: a value
# in UNO, padded with spaces to a whole sector. A hex viewer shows it all.
#
# Every file and directory is an inode: a block holding its type, size
# and time and the root of its block map, a B+ tree from the index of a
# block of the file (0, 1, 2, ...) to the LBA of the disk sector where
# that block is. Every read and write finds the file's blocks through
# it. The root lives in the inode; when it fills up its entries move
# down into a node of their own and the tree grows a level (as ext4's
# extent trees grow out of the inode). Leaves are linked in index order,
# so a whole file reads along the chain, a run of consecutive LBAs at a
# time.
#
# Directories are not in a tree: a directory is a file whose data is its
# [name, inode] pairs in UNO, sorted by name. A path is looked up a name
# at a time from the root directory.
#
# In memory the mounted file system, every node, every directory, the
# node cache and the free-space map are btree containers (src/btree.c):
# a leaf maps index to LBA, an internal node finds a child with btfloor,
# the free extents are kept by first block so that btfloor and btget
# find the neighbours a freed extent joins. Nothing is written until
# bl_sync: the changed directories, the changed nodes, the free-space
# map, the superblock last.
#
# Every sector moves through bread, bwrite and bcopy, so the same code
# runs on a disk image under ussr and on an ATA disk under the Moscow
# kernel (/dev/hda .. /dev/hdd).
$once
$include "../libs/strings.su"

# ---------------------------------------------------------------- helpers

bl_err(r): m [
    concat(line): "belarus: " m "\n"
    write_stderr(_): line
    set(r): -1
]

bl_int(r): n [
    str_from_int(r): n
]

# 8 lower-case hex digits of n (0 .. 2^32 - 1)
bl_hex8(r): n [
    set(r): ""
    set(k): 28
    while(_): {k >= 0} [
        slice(d): "0123456789abcdef" {(n >> k) & 15} 1
        concat(r): r d
        set(k): {k - 4}
    ]
]

# the number in 8 hex digits, or -1
bl_unhex8(r): s [
    set(r): 0
    set(i): 0
    while(_): {i < 8} [
        byte(b): s i
        set(d): -1
        if(_): {b >= 48 && b <= 57} [ set(d): {b - 48} ]
        if(_): {b >= 97 && b <= 102} [ set(d): {b - 87} ]
        if(_): {d < 0} [
            set(r): -1
            return(r): r
        ]
        set(r): {(r << 4) | d}
        set(i): {i + 1}
    ]
]

# the index of the last "/" in path, or -1
bl_last_slash(r): path [
    len(n): path
    set(r): {n - 1}
    while(_): {r >= 0} [
        byte(b): path r
        if(_): {b = 47} [ return(r): r ]
        set(r): {r - 1}
    ]
]

# "/a//b/" -> "/a/b"; "" and "." -> "/"
bl_clean(r): path [
    set(r): ""
    set(prev): 47
    len(n): path
    set(i): 0
    while(_): {i < n} [
        byte(b): path i
        if(_): {b != 47 || prev != 47} [
            slice(c): path i 1
            concat(r): r c
        ]
        set(prev): b
        set(i): {i + 1}
    ]
    len(m): r
    if(_): {m > 0} [
        byte(e): r {m - 1}
        if(_): {e = 47} [ slice(r): r 0 {m - 1} ]
    ]
    if(_): {r = "" || r = "."} [ set(r): "/" ]
    else(_): [ concat(r): "/" r ]
]

# the directory holding path ("/" for "/x")
bl_parent(r): path [
    bl_last_slash(i): path
    set(r): "/"
    if(_): {i > 0} [ slice(r): path 0 i ]
]

# the last part of path
bl_base(r): path [
    bl_last_slash(i): path
    len(n): path
    slice(r): path {i + 1} {n - i - 1}
]

bl_now(r): [
    time(r):
]

# ---------------------------------------------------------------- blocks

# the first sector of block blk
bl_lba(r): fs blk [
    btget(base): fs "base"
    set(r): {base + (blk << 3)}
]

# The value in the metadata block blk, or null when the block does not
# start with magic or its text is damaged.
bl_read_meta(r): fs blk magic [
    set(r): null
    btget(dev): fs "dev"
    bl_lba(lba): fs blk
    bread(v): dev lba 1
    typeof(tv): v
    if(_): {tv != "vector"} [ return(r): r ]
    bytes_text(h): v 0 24
    typeof(th): h
    if(_): {th != "string"} [ return(r): r ]
    slice(m): h 0 8
    if(_): {m != magic} [ return(r): r ]
    slice(hn): h 8 8
    bl_unhex8(n): hn
    slice(hc): h 16 8
    bl_unhex8(c): hc
    if(_): {n < 0 || c < 0 || n > 65536 - 24} [ return(r): r ]
    set(sectors): {(n + 24 + 511) >> 9}
    if(_): {sectors > 1} [
        bread(v): dev lba sectors
        typeof(tv): v
        if(_): {tv != "vector"} [ return(r): r ]
    ]
    crc32(got): v 24 n
    if(_): {got != c} [ return(r): r ]
    bytes_text(t): v 24 n
    typeof(tt): t
    if(_): {tt != "string"} [ return(r): r ]
    decode(r): t
]

# Writes value into block blk (and the blocks after it, up to blocks of
# them) as magic + text; 0, or -1 when it does not fit or the write fails.
bl_write_meta(r): fs blk magic value blocks [
    set(r): -1
    encode(t): value
    text_bytes(tb): t
    len(n): tb
    if(_): {n + 24 > (blocks << 12)} [
        bl_int(sn): n
        concat(m): magic " text of " sn " bytes does not fit"
        bl_err(r): m
        return(r): r
    ]
    crc32(c): tb
    bl_hex8(hn): n
    bl_hex8(hc): c
    set(total): {(n + 24 + 511) & -512}
    set(pad): ""
    set(want): {total - n - 24}
    while(_): {want > 0} [
        set(k): want
        if(_): {k > 512} [ set(k): 512 ]
        slice(sp): "                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                " 0 k
        concat(pad): pad sp
        set(want): {want - k}
    ]
    concat(all): magic hn hc t pad
    text_bytes(v): all
    btget(dev): fs "dev"
    bl_lba(lba): fs blk
    bwrite(w): dev lba v
    if(_): {w = total} [ set(r): 0 ]
    else(_): [
        bl_int(sb): blk
        concat(m): "cannot write block " sb " of " dev
        bl_err(r): m
    ]
]

# ---------------------------------------------------------------- free space

# Takes count blocks: a vector of [block, count] extents (one when the
# space allows), or null when there is not enough room.
bl_alloc(r): fs count [
    set(r): null
    btget(free): fs "free"
    btrange(spans): free
    len(n): spans
    # the first span big enough
    set(i): 0
    while(_): {i < n} [
        at(p): spans i
        at(s): p 0
        at(l): p 1
        if(_): {l >= count} [
            btdel(_): free s
            if(_): {l > count} [ btput(_): free {s + count} {l - count} ]
            vec(r): ""
            vec(e): ""
            push(_): e s
            push(_): e count
            push(_): r e
            return(r): r
        ]
        set(i): {i + 1}
    ]
    # else pieces, in order
    set(have): 0
    set(i): 0
    while(_): {i < n} [
        at(p): spans i
        at(l): p 1
        set(have): {have + l}
        set(i): {i + 1}
    ]
    if(_): {have < count} [ return(r): r ]
    vec(r): ""
    set(left): count
    set(i): 0
    while(_): {left > 0} [
        at(p): spans i
        at(s): p 0
        at(l): p 1
        set(take): l
        if(_): {take > left} [ set(take): left ]
        btdel(_): free s
        if(_): {l > take} [ btput(_): free {s + take} {l - take} ]
        vec(e): ""
        push(_): e s
        push(_): e take
        push(_): r e
        set(left): {left - take}
        set(i): {i + 1}
    ]
]

# Gives count blocks from start back, joining the free spans around them.
bl_free(r): fs start count [
    set(r): 0
    btget(free): fs "free"
    btfloor(p): free start
    typeof(tp): p
    if(_): {tp = "integer"} [
        btget(pl): free p
        if(_): {p + pl = start} [
            btdel(_): free p
            set(start): p
            set(count): {count + pl}
        ]
    ]
    set(after): {start + count}
    btget(al): free after
    typeof(ta): al
    if(_): {ta = "integer"} [
        btdel(_): free after
        set(count): {count + al}
    ]
    btput(_): free start count
]

# blocks free
bl_free_count(r): fs [
    set(r): 0
    btget(free): fs "free"
    btrange(spans): free
    len(n): spans
    set(i): 0
    while(_): {i < n} [
        at(p): spans i
        at(l): p 1
        set(r): {r + l}
        set(i): {i + 1}
    ]
]

# ---------------------------------------------------------------- block maps

# Every file and directory has an inode, a block of its own (its number
# is the inode's number). The inode holds the file's type, size and time
# and the root of its block map: a B+ tree from the index of a block in
# the file (0, 1, 2, ...) to the LBA, the disk sector where that block
# starts. Reading or writing block i of a file looks i up in the tree.
#
# A node, the inode's root included, is a btree with "kind" ("L" leaf,
# "I" internal), "map", "next" (a leaf's right neighbour, 0 for none),
# "block" and "dirty"; an inode has "type", "size" and "mtime" too. A
# leaf's map goes from block index to LBA, an internal node's from the
# first index under a child to that child's block (btfloor finds the
# child for an index). A node holds at most BL_FANOUT entries: one more
# splits it in two and the separator goes up; the inode's root, when it
# is full, moves its entries down into a new node and keeps only that
# node, as ext4's inodes do with their extent trees. Leaves are linked in
# index order, so a whole file is read along the chain.

bl_fanout(r): [
    set(r): 128
]

# The node in block blk (cached), an inode when inode is true; null when
# the block is not one.
bl_node(r): fs blk inode [
    btget(cache): fs "nodes"
    btget(r): cache blk
    typeof(t): r
    if(_): {t = "btree"} [ return(r): r ]
    set(magic): "BLBMAP01"
    if(_): inode [ set(magic): "BLINODE1" ]
    bl_read_meta(v): fs blk magic
    set(r): null
    typeof(tv): v
    if(_): {tv != "vector"} [
        bl_int(sb): blk
        concat(m): "block " sb " is not a " magic " block"
        bl_err(_): m
        return(r): r
    ]
    btree(r):
    btput(_): r "block" blk
    btput(_): r "dirty" false
    btput(_): r "inode" inode
    set(at): 0
    if(_): inode [
        at(ty): v 0
        at(sz): v 1
        at(mt): v 2
        btput(_): r "type" ty
        btput(_): r "size" sz
        btput(_): r "mtime" mt
        set(at): 3
    ]
    at(kind): v at
    at(next): v {at + 1}
    at(pairs): v {at + 2}
    btput(_): r "kind" kind
    btput(_): r "next" next
    btree(map):
    len(n): pairs
    set(i): 0
    while(_): {i < n} [
        at(p): pairs i
        at(k): p 0
        at(x): p 1
        btput(_): map k x
        set(i): {i + 1}
    ]
    btput(_): r "map" map
    btput(_): cache blk r
]

# A new node in a block of its own (an inode when type is "d" or "f").
bl_node_new(r): fs kind type [
    set(r): null
    bl_alloc(ext): fs 1
    typeof(te): ext
    if(_): {te != "vector"} [
        bl_err(_): "no room for a node"
        return(r): r
    ]
    at(e): ext 0
    at(blk): e 0
    btree(r):
    btput(_): r "kind" kind
    btput(_): r "next" 0
    btput(_): r "block" blk
    btput(_): r "dirty" true
    btput(_): r "inode" false
    if(_): {type != ""} [
        btput(_): r "inode" true
        btput(_): r "type" type
        btput(_): r "size" 0
        bl_now(now):
        btput(_): r "mtime" now
    ]
    btree(map):
    btput(_): r "map" map
    btget(cache): fs "nodes"
    btput(_): cache blk r
]

bl_inode(r): fs ino [
    bl_node(r): fs ino true
]

# what a node is on disk: [type, size, mtime,] kind, next, pairs
bl_node_value(r): node [
    vec(r): ""
    btget(inode): node "inode"
    if(_): inode [
        btget(ty): node "type"
        btget(sz): node "size"
        btget(mt): node "mtime"
        push(_): r ty
        push(_): r sz
        push(_): r mt
    ]
    btget(kind): node "kind"
    btget(next): node "next"
    btget(map): node "map"
    push(_): r kind
    push(_): r next
    push(_): r map
]

bl_touch(r): node [
    btput(r): node "dirty" true
]

# the blocks from the inode down to the leaf for block index idx
bl_map_path(r): fs ino idx [
    vec(r): ""
    push(_): r ino
    bl_inode(node): fs ino
    while(_): true [
        btget(kind): node "kind"
        if(_): {kind = "L"} [ return(r): r ]
        btget(map): node "map"
        btfloor(sep): map idx
        btget(child): map sep
        push(_): r child
        bl_node(node): fs child false
    ]
]

# The LBA of block idx of the file, or null when the file has no such
# block.
bl_bmap(r): fs ino idx [
    bl_map_path(path): fs ino idx
    len(n): path
    at(blk): path {n - 1}
    set(isino): {n = 1}
    bl_node(leaf): fs blk isino
    btget(map): leaf "map"
    btget(r): map idx
]

# Maps block idx of the file to lba, splitting what overflows.
bl_bmap_put(r): fs ino idx lba [
    set(r): 0
    bl_map_path(path): fs ino idx
    len(n): path
    at(blk): path {n - 1}
    set(isino): {n = 1}
    bl_node(leaf): fs blk isino
    btget(map): leaf "map"
    btput(_): map idx lba
    bl_touch(_): leaf
    bl_fanout(max):
    set(i): {n - 1}
    while(_): {i >= 0} [
        at(blk): path i
        set(isino): {i = 0}
        bl_node(node): fs blk isino
        btget(map): node "map"
        btlen(count): map
        if(_): {count <= max} [ return(r): r ]
        if(_): isino [
            # the inode's root moves down a level
            btget(kind): node "kind"
            bl_node_new(down): fs kind ""
            typeof(td): down
            if(_): {td != "btree"} [
                set(r): -1
                return(r): r
            ]
            btget(dblk): down "block"
            btput(_): down "map" map
            btget(next): node "next"
            btput(_): down "next" next
            btree(top):
            btput(_): top 0 dblk
            btput(_): node "map" top
            btput(_): node "kind" "I"
            btput(_): node "next" 0
            bl_touch(_): node
            # and splits there
            vec(path): ""
            push(_): path blk
            push(_): path dblk
            set(i): 1
            set(blk): dblk
            set(node): down
        ]
        bl_split(s): fs node
        typeof(ts): s
        if(_): {ts != "vector"} [
            set(r): -1
            return(r): r
        ]
        at(sep): s 0
        at(rblk): s 1
        at(pblk): path {i - 1}
        set(pino): {i - 1 = 0}
        bl_node(parent): fs pblk pino
        btget(pmap): parent "map"
        btput(_): pmap sep rblk
        bl_touch(_): parent
        set(i): {i - 1}
    ]
]

# Splits a full node: the new right node gets the upper half of the
# entries. [separator, right block], or null.
bl_split(r): fs node [
    set(r): null
    btget(kind): node "kind"
    btget(map): node "map"
    btrange(pairs): map
    len(n): pairs
    bl_node_new(right): fs kind ""
    typeof(tr): right
    if(_): {tr != "btree"} [ return(r): r ]
    btget(rmap): right "map"
    set(half): {n >> 1}
    at(p): pairs half
    at(sep): p 0
    set(i): half
    while(_): {i < n} [
        at(p): pairs i
        at(k): p 0
        at(x): p 1
        btdel(_): map k
        btput(_): rmap k x
        set(i): {i + 1}
    ]
    btget(rblk): right "block"
    if(_): {kind = "L"} [
        btget(next): node "next"
        btput(_): right "next" next
        btput(_): node "next" rblk
    ]
    bl_touch(_): node
    vec(r): ""
    push(_): r sep
    push(_): r rblk
]

# Every [index, lba] of the file in index order, along the leaf chain.
bl_bmap_all(r): fs ino [
    vec(r): ""
    bl_inode(node): fs ino
    btget(kind): node "kind"
    while(_): {kind = "I"} [
        btget(map): node "map"
        btfirst(f): map
        btget(child): map f
        bl_node(node): fs child false
        btget(kind): node "kind"
    ]
    set(go): true
    while(_): go [
        btget(map): node "map"
        btrange(pairs): map
        len(n): pairs
        set(i): 0
        while(_): {i < n} [
            at(p): pairs i
            push(_): r p
            set(i): {i + 1}
        ]
        btget(next): node "next"
        set(go): {next != 0}
        if(_): go [ bl_node(node): fs next false ]
    ]
]

# The file's blocks as runs of consecutive LBAs: [lba, blocks] each.
bl_runs(r): fs ino [
    vec(r): ""
    bl_bmap_all(all): fs ino
    len(n): all
    set(start): -1
    set(count): 0
    set(i): 0
    while(_): {i < n} [
        at(p): all i
        at(lba): p 1
        if(_): {start >= 0 && lba = start + (count << 3)} [
            set(count): {count + 1}
        ]
        else(_): [
            if(_): {start >= 0} [
                vec(run): ""
                push(_): run start
                push(_): run count
                push(_): r run
            ]
            set(start): lba
            set(count): 1
        ]
        set(i): {i + 1}
    ]
    if(_): {start >= 0} [
        vec(run): ""
        push(_): run start
        push(_): run count
        push(_): r run
    ]
]

# The blocks of the file's map below the inode (its tree nodes).
bl_map_nodes(r): fs ino [
    vec(r): ""
    vec(stack): ""
    push(_): stack ino
    while(_): stack [
        pop(blk): stack
        set(isino): {blk = ino}
        bl_node(node): fs blk isino
        if(_): {blk != ino} [ push(_): r blk ]
        btget(kind): node "kind"
        if(_): {kind = "I"} [
            btget(map): node "map"
            btrange(pairs): map
            len(n): pairs
            set(i): 0
            while(_): {i < n} [
                at(p): pairs i
                at(c): p 1
                push(_): stack c
                set(i): {i + 1}
            ]
        ]
    ]
]

# Gives the file's data blocks and map nodes back: an empty file.
bl_truncate(r): fs ino [
    set(r): 0
    btget(base): fs "base"
    bl_runs(runs): fs ino
    len(n): runs
    set(i): 0
    while(_): {i < n} [
        at(run): runs i
        at(lba): run 0
        at(c): run 1
        bl_free(_): fs {(lba - base) >> 3} c
        set(i): {i + 1}
    ]
    bl_map_nodes(nodes): fs ino
    btget(cache): fs "nodes"
    len(n): nodes
    set(i): 0
    while(_): {i < n} [
        at(b): nodes i
        btdel(_): cache b
        bl_free(_): fs b 1
        set(i): {i + 1}
    ]
    bl_inode(node): fs ino
    btree(empty):
    btput(_): node "map" empty
    btput(_): node "kind" "L"
    btput(_): node "next" 0
    btput(_): node "size" 0
    bl_touch(_): node
]

# Gives the file count bytes of new blocks (after freeing its old ones):
# the runs [lba, blocks] to write into, or null.
bl_allocate(r): fs ino size [
    set(r): null
    bl_truncate(_): fs ino
    set(blocks): {(size + 4095) >> 12}
    vec(r): ""
    bl_inode(node): fs ino
    btput(_): node "size" size
    bl_now(now):
    btput(_): node "mtime" now
    if(_): {blocks = 0} [ return(r): r ]
    bl_alloc(ext): fs blocks
    typeof(te): ext
    if(_): {te != "vector"} [
        btput(_): node "size" 0
        set(r): null
        return(r): r
    ]
    set(idx): 0
    len(ne): ext
    set(i): 0
    while(_): {i < ne} [
        at(e): ext i
        at(s): e 0
        at(c): e 1
        bl_lba(lba): fs s
        vec(run): ""
        push(_): run lba
        push(_): run c
        push(_): r run
        set(k): 0
        while(_): {k < c} [
            bl_bmap_put(w): fs ino idx {lba + (k << 3)}
            if(_): {w != 0} [
                set(r): null
                return(r): r
            ]
            set(idx): {idx + 1}
            set(k): {k + 1}
        ]
        set(i): {i + 1}
    ]
]

# Moves blocks blocks from one list of runs to another, piece by piece
# with bcopy (the runs may be cut in different places): 0 or -1.
bl_copy_runs(r): sdev sruns ddev druns blocks [
    set(r): 0
    set(si): 0
    set(so): 0
    set(di): 0
    set(dof): 0
    set(left): blocks
    while(_): {left > 0} [
        at(sr): sruns si
        at(sl): sr 0
        at(sc): sr 1
        at(dr): druns di
        at(dl): dr 0
        at(dc): dr 1
        set(n): {sc - so}
        if(_): {dc - dof < n} [ set(n): {dc - dof} ]
        if(_): {left < n} [ set(n): left ]
        bcopy(w): sdev {sl + (so << 3)} ddev {dl + (dof << 3)} {n << 3}
        if(_): {w != (n << 3)} [
            bl_err(r): "a copy failed"
            return(r): r
        ]
        set(left): {left - n}
        set(so): {so + n}
        set(dof): {dof + n}
        if(_): {so = sc} [
            set(si): {si + 1}
            set(so): 0
        ]
        if(_): {dof = dc} [
            set(di): {di + 1}
            set(dof): 0
        ]
    ]
]

# ---------------------------------------------------------------- directories

# A directory is a file whose data is its entries, [name, inode] pairs
# in UNO, sorted by name. In memory it is a btree from name to inode,
# cached in fs "dirs"; a changed one is written back by bl_sync.

bl_dir(r): fs ino [
    btget(dirs): fs "dirs"
    btget(r): dirs ino
    typeof(t): r
    if(_): {t = "btree"} [ return(r): r ]
    btree(r):
    bl_file_bytes(v): fs ino
    len(n): v
    if(_): {n > 0} [
        bytes_text(text): v
        decode(pairs): text
        len(np): pairs
        set(i): 0
        while(_): {i < np} [
            at(p): pairs i
            at(k): p 0
            at(x): p 1
            btput(_): r k x
            set(i): {i + 1}
        ]
    ]
    btput(_): dirs ino r
]

bl_dir_changed(r): fs ino [
    btget(changed): fs "dirty_dirs"
    btput(r): changed ino true
    btput(_): fs "dirty" true
]

# Writes a directory's entries into its data blocks.
bl_dir_save(r): fs ino [
    set(r): -1
    bl_dir(map): fs ino
    encode(text): map
    text_bytes(v): text
    btlen(n): map
    if(_): {n = 0} [ vec(v): "" ]
    bl_write_ino(r): fs ino v
]

# The inode of path, or 0.
bl_lookup(r): fs path [
    bl_clean(p): path
    btget(r): fs "root"
    if(_): {p = "/"} [ return(r): r ]
    len(n): p
    set(start): 1
    set(i): 1
    while(_): {i <= n} [
        set(b): 47
        if(_): {i < n} [ byte(b): p i ]
        if(_): {b = 47} [
            slice(name): p start {i - start}
            bl_inode(node): fs r
            btget(ty): node "type"
            if(_): {ty != "d"} [
                set(r): 0
                return(r): r
            ]
            bl_dir(dir): fs r
            btget(r): dir name 0
            if(_): {r = 0} [ return(r): r ]
            set(start): {i + 1}
        ]
        set(i): {i + 1}
    ]
]

# The bytes of a file's data, by its inode.
bl_file_bytes(r): fs ino [
    vec(r): ""
    bl_inode(node): fs ino
    btget(size): node "size"
    if(_): {size = 0} [ return(r): r ]
    btget(dev): fs "dev"
    bl_runs(runs): fs ino
    len(n): runs
    set(done): 0
    set(i): 0
    while(_): {i < n} [
        at(run): runs i
        at(lba): run 0
        at(c): run 1
        set(take): {c << 12}
        if(_): {take > size - done} [ set(take): {size - done} ]
        bread(part): dev {lba << 9} take 1
        typeof(tp): part
        if(_): {tp != "vector"} [
            set(r): null
            return(r): r
        ]
        if(_): {i = 0} [ set(r): part ]
        else(_): [
            set(k): 0
            while(_): {k < take} [
                at(x): part k
                push(_): r x
                set(k): {k + 1}
            ]
        ]
        set(done): {done + take}
        set(i): {i + 1}
    ]
]

# Writes a byte vector as a file's data, by its inode: 0 or -1.
bl_write_ino(r): fs ino bytes [
    set(r): -1
    len(size): bytes
    bl_allocate(runs): fs ino size
    typeof(tr): runs
    if(_): {tr != "vector"} [
        bl_err(_): "no room for the data"
        return(r): r
    ]
    btget(dev): fs "dev"
    len(n): runs
    set(done): 0
    set(i): 0
    while(_): {i < n} [
        at(run): runs i
        at(lba): run 0
        at(c): run 1
        set(take): {c << 12}
        if(_): {take > size - done} [ set(take): {size - done} ]
        set(sectors): {(take + 511) >> 9}
        vec(chunk): ""
        set(k): 0
        while(_): {k < take} [
            at(x): bytes {done + k}
            push(_): chunk x
            set(k): {k + 1}
        ]
        while(_): {k < (sectors << 9)} [
            push(_): chunk 0
            set(k): {k + 1}
        ]
        bwrite(w): dev lba chunk
        if(_): {w < 0} [ return(r): r ]
        set(done): {done + take}
        set(i): {i + 1}
    ]
    set(r): 0
]

# ---------------------------------------------------------------- mount

bl_fs_new(r): dev base [
    btree(r):
    btput(_): r "dev" dev
    btput(_): r "base" base
    btree(nodes):
    btput(_): r "nodes" nodes
    btree(free):
    btput(_): r "free" free
    btree(dirs):
    btput(_): r "dirs" dirs
    btree(changed):
    btput(_): r "dirty_dirs" changed
    btput(_): r "dirty" false
]

# The first sector of the Belarus file system on dev: partition number
# part (1..), or 0 for the first partition holding one (the whole device
# when it starts at sector 0). -1 when there is none.
bl_locate(r): dev part [
    set(r): -1
    bread(s0): dev 0 1
    typeof(t0): s0
    if(_): {t0 != "vector"} [ return(r): r ]
    bytes_text(m): s0 0 8
    if(_): {m = "BELARUS1" && part = 0} [
        set(r): 0
        return(r): r
    ]
    bl_parts(starts): dev s0
    len(n): starts
    set(i): 0
    while(_): {i < n} [
        at(lba): starts i
        if(_): {part = i + 1} [
            set(r): lba
            return(r): r
        ]
        if(_): {part = 0 && lba > 0} [
            bread(s): dev lba 1
            typeof(ts): s
            if(_): {ts = "vector"} [
                bytes_text(m): s 0 8
                if(_): {m = "BELARUS1"} [
                    set(r): lba
                    return(r): r
                ]
            ]
        ]
        set(i): {i + 1}
    ]
]

# little-endian unsigned integer of n bytes of v at i
bl_le(r): v i n [
    set(r): 0
    set(k): {n - 1}
    while(_): {k >= 0} [
        at(b): v {i + k}
        set(r): {(r << 8) | b}
        set(k): {k - 1}
    ]
]

# the first sectors of the partitions of an MBR or GPT disk, in table
# order (0 for an unused slot)
bl_parts(r): dev s0 [
    vec(r): ""
    at(a): s0 510
    at(b): s0 511
    if(_): {a != 85 || b != 170} [ return(r): r ]
    at(t1): s0 450
    if(_): {t1 = 238} [
        # protective MBR: the GPT header is in sector 1
        bread(h): dev 1 1
        typeof(th): h
        if(_): {th != "vector"} [ return(r): r ]
        bytes_text(sig): h 0 8
        if(_): {sig != "EFI PART"} [ return(r): r ]
        bl_le(elba): h 72 8
        bl_le(count): h 80 4
        bl_le(esize): h 84 4
        if(_): {count > 128} [ set(count): 128 ]
        set(per): {512 / esize}
        str_trunc(per): per
        set(i): 0
        while(_): {i < count} [
            set(sec): {elba + (i / per)}
            str_trunc(sec): sec
            set(off): {(i % per) * esize}
            bread(e): dev sec 1
            bl_le(first): e {off + 32} 8
            push(_): r first
            set(i): {i + 1}
        ]
        return(r): r
    ]
    set(i): 0
    while(_): {i < 4} [
        set(off): {446 + i * 16}
        at(t): s0 {off + 4}
        set(first): 0
        if(_): {t != 0} [ bl_le(first): s0 {off + 8} 4 ]
        push(_): r first
        set(i): {i + 1}
    ]
]

# Mounts the file system at sector base of dev: the fs, or null.
bl_mount(r): dev base [
    bl_fs_new(r): dev base
    bl_read_meta(sb): r 0 "BELARUS1"
    typeof(ts): sb
    if(_): {ts != "vector"} [
        concat(m): dev ": no Belarus file system there"
        bl_err(_): m
        set(r): null
        return(r): r
    ]
    # the superblock is a list of [name, value] pairs
    len(n): sb
    set(i): 0
    while(_): {i < n} [
        at(p): sb i
        at(k): p 0
        at(x): p 1
        if(_): {k != "dev" && k != "base"} [ btput(_): r k x ]
        set(i): {i + 1}
    ]
    btget(version): r "version"
    if(_): {version != 2} [
        concat(m): dev ": a Belarus file system of another version; make it again (mkfs)"
        bl_err(_): m
        set(r): null
        return(r): r
    ]
    bl_read_meta(spans): r 1 "BLFREE01"
    typeof(tf): spans
    if(_): {tf != "vector"} [
        concat(m): dev ": the free-space map is damaged"
        bl_err(_): m
        set(r): null
        return(r): r
    ]
    btget(free): r "free"
    len(n): spans
    set(i): 0
    while(_): {i < n} [
        at(p): spans i
        at(s): p 0
        at(l): p 1
        btput(_): free s l
        set(i): {i + 1}
    ]
]

# Opens a device spec: "disk.img" (the first Belarus file system on it)
# or "disk.img@2" (partition 2). The fs, or null.
bl_open(r): spec [
    set(r): null
    set(dev): spec
    set(part): 0
    bl_last_at(at): spec
    if(_): {at > 0} [
        len(n): spec
        slice(dev): spec 0 at
        slice(ps): spec {at + 1} {n - at - 1}
        str_to_number(part): ps
        typeof(tp): part
        if(_): {tp != "integer"} [
            concat(m): "bad partition number in " spec
            bl_err(_): m
            return(r): r
        ]
    ]
    bl_locate(base): dev part
    if(_): {base < 0} [
        concat(m): dev ": no Belarus file system found"
        bl_err(_): m
        return(r): r
    ]
    bl_mount(r): dev base
]

bl_last_at(r): s [
    len(n): s
    set(r): {n - 1}
    while(_): {r >= 0} [
        byte(b): s r
        if(_): {b = 64} [ return(r): r ]
        set(r): {r - 1}
    ]
]

# Writes the changed directories, every changed node, the free-space
# map and the superblock, in that order.
bl_sync(r): fs [
    set(r): 0
    btget(changed): fs "dirty_dirs"
    btkeys(dd): changed
    len(n): dd
    set(i): 0
    while(_): {i < n} [
        at(ino): dd i
        bl_dir_save(w): fs ino
        if(_): {w != 0} [ set(r): -1 ]
        btdel(_): changed ino
        set(i): {i + 1}
    ]
    btget(cache): fs "nodes"
    btrange(all): cache
    len(n): all
    set(i): 0
    while(_): {i < n} [
        at(p): all i
        at(blk): p 0
        at(node): p 1
        btget(d): node "dirty"
        if(_): d [
            bl_node_value(v): node
            set(magic): "BLBMAP01"
            btget(isino): node "inode"
            if(_): isino [ set(magic): "BLINODE1" ]
            bl_write_meta(w): fs blk magic v 1
            if(_): {w != 0} [ set(r): -1 ]
            btput(_): node "dirty" false
        ]
        set(i): {i + 1}
    ]
    btget(free): fs "free"
    bl_write_meta(w): fs 1 "BLFREE01" free 16
    if(_): {w != 0} [ set(r): -1 ]
    btree(sb):
    btrange(fields): fs
    len(n): fields
    set(i): 0
    while(_): {i < n} [
        at(p): fields i
        at(k): p 0
        at(x): p 1
        if(_): {k != "dev" && k != "base" && k != "nodes" && k != "free" && k != "dirty" && k != "dirs" && k != "dirty_dirs"} [
            btput(_): sb k x
        ]
        set(i): {i + 1}
    ]
    bl_write_meta(w): fs 0 "BELARUS1" sb 1
    if(_): {w != 0} [ set(r): -1 ]
    btput(_): fs "dirty" false
]

# Makes a Belarus file system of blocks 4096-byte blocks at sector base
# of dev. The mounted fs, or null.
bl_mkfs(r): dev base blocks label [
    set(r): null
    if(_): {blocks < 64} [
        bl_err(_): "a Belarus file system needs at least 64 blocks (256 KiB)"
        return(r): r
    ]
    bl_fs_new(fs): dev base
    btput(_): fs "magic" "belarus"
    btput(_): fs "version" 2
    btput(_): fs "block" 4096
    btput(_): fs "blocks" blocks
    btput(_): fs "label" label
    bl_now(now):
    btput(_): fs "created" now
    random64(x):
    bl_hex8(u1): {x & 4294967295}
    bl_hex8(u2): {(x >> 32) & 4294967295}
    concat(uuid): u1 u2
    btput(_): fs "uuid" uuid
    btget(free): fs "free"
    btput(_): free 17 {blocks - 17}
    bl_node_new(root): fs "L" "d"
    btget(rb): root "block"
    btput(_): fs "root" rb
    bl_sync(w): fs
    if(_): {w = 0} [ set(r): fs ]
]

# ---------------------------------------------------------------- files

# [type, size, mtime, inode] of the file or directory at path, or null.
bl_get(r): fs path [
    set(r): null
    bl_lookup(ino): fs path
    if(_): {ino = 0} [ return(r): r ]
    bl_inode(node): fs ino
    vec(r): ""
    btget(ty): node "type"
    btget(sz): node "size"
    btget(mt): node "mtime"
    push(_): r ty
    push(_): r sz
    push(_): r mt
    push(_): r ino
]

bl_is_dir(r): fs path [
    bl_get(rec): fs path
    set(r): false
    typeof(t): rec
    if(_): {t = "vector"} [
        at(ty): rec 0
        set(r): {ty = "d"}
    ]
]

bl_exists(r): fs path [
    bl_lookup(ino): fs path
    set(r): {ino != 0}
]

# The inode of the entry path of type ("d" or "f"), made in its parent
# directory when it is not there; 0 after saying why.
bl_create(r): fs path type [
    set(r): 0
    bl_clean(p): path
    if(_): {p = "/"} [
        if(_): {type = "d"} [ btget(r): fs "root" ]
        else(_): [ bl_err(_): "/ is a directory" ]
        return(r): r
    ]
    bl_parent(up): p
    bl_base(name): p
    str_find(bad): name "`" 0
    if(_): {bad >= 0} [
        concat(m): "a name with a backquote: " p
        bl_err(_): m
        return(r): r
    ]
    bl_lookup(dino): fs up
    set(isdir): false
    if(_): {dino != 0} [
        bl_inode(dnode): fs dino
        btget(dty): dnode "type"
        set(isdir): {dty = "d"}
    ]
    if(_): {isdir = false} [
        concat(m): up " is not a directory"
        bl_err(_): m
        return(r): r
    ]
    bl_dir(dir): fs dino
    btget(r): dir name 0
    if(_): {r != 0} [
        bl_inode(node): fs r
        btget(ty): node "type"
        if(_): {ty != type} [
            concat(m): p " is a directory"
            if(_): {ty = "f"} [ concat(m): p " exists and is a file" ]
            bl_err(_): m
            set(r): 0
        ]
        return(r): r
    ]
    bl_node_new(node): fs "L" type
    typeof(tn): node
    if(_): {tn != "btree"} [ return(r): r ]
    btget(r): node "block"
    btput(_): dir name r
    bl_dir_changed(_): fs dino
    btput(_): fs "dirty" true
]

bl_mkdir(r): fs path [
    bl_create(ino): fs path "d"
    set(r): 0
    if(_): {ino = 0} [ set(r): -1 ]
]

# mkdir -p
bl_mkdirs(r): fs path [
    bl_clean(p): path
    set(r): 0
    if(_): {p = "/"} [ return(r): r ]
    bl_parent(up): p
    bl_mkdirs(r): fs up
    if(_): {r = 0} [ bl_mkdir(r): fs p ]
]

# Writes a byte vector as the file at path: 0 or -1.
bl_write_bytes(r): fs path bytes [
    set(r): -1
    bl_create(ino): fs path "f"
    if(_): {ino = 0} [ return(r): r ]
    bl_write_ino(r): fs ino bytes
    btput(_): fs "dirty" true
]

bl_write_text(r): fs path text [
    text_bytes(v): text
    bl_write_bytes(r): fs path v
]

# Copies size bytes of another device or file, from byte offset from,
# into the file at path, run by run with bcopy: 0 or -1.
bl_write_from(r): fs path src from size [
    set(r): -1
    bl_create(ino): fs path "f"
    if(_): {ino = 0} [ return(r): r ]
    bl_allocate(runs): fs ino size
    typeof(tr): runs
    if(_): {tr != "vector"} [
        concat(m): "no room for " path
        bl_err(_): m
        return(r): r
    ]
    btput(_): fs "dirty" true
    btget(dev): fs "dev"
    len(n): runs
    set(done): 0
    set(i): 0
    while(_): {i < n} [
        at(run): runs i
        at(lba): run 0
        at(c): run 1
        set(take): {c << 12}
        if(_): {take > size - done} [ set(take): {size - done} ]
        # byte-sized "sectors": the file's tail need not fill one
        bcopy(w): src {from + done} dev {lba << 9} take 1
        if(_): {w != take} [
            concat(m): "cannot copy into " path
            bl_err(_): m
            return(r): r
        ]
        set(done): {done + take}
        set(i): {i + 1}
    ]
    set(r): 0
]

# The file at path as a byte vector, or null.
bl_read_bytes(r): fs path [
    set(r): null
    bl_get(rec): fs path
    typeof(t): rec
    if(_): {t != "vector"} [
        bl_clean(p): path
        concat(m): "no file " p
        bl_err(_): m
        return(r): r
    ]
    at(ty): rec 0
    if(_): {ty != "f"} [
        bl_clean(p): path
        concat(m): p " is a directory"
        bl_err(_): m
        return(r): r
    ]
    at(ino): rec 3
    bl_file_bytes(r): fs ino
]

# The file at path as text, or null (also for a file holding a 0 byte).
bl_read_text(r): fs path [
    bl_read_bytes(v): fs path
    set(r): null
    typeof(t): v
    if(_): {t = "vector"} [
        len(n): v
        set(r): ""
        if(_): {n > 0} [ bytes_text(r): v ]
    ]
]

# The names in directory path, in order, or null.
bl_list(r): fs path [
    set(r): null
    bl_get(rec): fs path
    typeof(t): rec
    set(ty): ""
    if(_): {t = "vector"} [ at(ty): rec 0 ]
    if(_): {ty != "d"} [
        bl_clean(p): path
        concat(m): "no directory " p
        bl_err(_): m
        return(r): r
    ]
    at(ino): rec 3
    bl_dir(dir): fs ino
    btkeys(r): dir
]

# Every [path, record] under path, itself first, each directory before
# what it holds, names in order.
bl_walk(r): fs path [
    vec(r): ""
    bl_clean(p): path
    bl_get(rec): fs p
    typeof(t): rec
    if(_): {t != "vector"} [ return(r): r ]
    vec(stack): ""
    vec(top): ""
    push(_): top p
    push(_): top rec
    push(_): stack top
    while(_): stack [
        pop(e): stack
        push(_): r e
        at(ep): e 0
        at(er): e 1
        at(ty): er 0
        if(_): {ty = "d"} [
            at(ino): er 3
            bl_dir(dir): fs ino
            btkeys(names): dir
            len(n): names
            # backwards onto the stack: the first name comes off first
            set(i): {n - 1}
            while(_): {i >= 0} [
                at(name): names i
                concat(cp): ep "/" name
                if(_): {ep = "/"} [ concat(cp): "/" name ]
                btget(cino): dir name
                bl_inode(cn): fs cino
                vec(crec): ""
                btget(cty): cn "type"
                btget(csz): cn "size"
                btget(cmt): cn "mtime"
                push(_): crec cty
                push(_): crec csz
                push(_): crec cmt
                push(_): crec cino
                vec(ce): ""
                push(_): ce cp
                push(_): ce crec
                push(_): stack ce
                set(i): {i - 1}
            ]
        ]
    ]
]

# Removes a file or an empty directory: 0 or -1.
bl_remove(r): fs path [
    set(r): -1
    bl_clean(p): path
    if(_): {p = "/"} [
        bl_err(r): "the root directory stays"
        return(r): r
    ]
    bl_get(rec): fs p
    typeof(t): rec
    if(_): {t != "vector"} [
        concat(m): "no file " p
        bl_err(r): m
        return(r): r
    ]
    at(ty): rec 0
    at(ino): rec 3
    if(_): {ty = "d"} [
        bl_dir(dir): fs ino
        btlen(n): dir
        if(_): {n > 0} [
            concat(m): p " is not empty"
            bl_err(r): m
            return(r): r
        ]
        btget(dirs): fs "dirs"
        btdel(_): dirs ino
        btget(changed): fs "dirty_dirs"
        btdel(_): changed ino
    ]
    bl_truncate(_): fs ino
    btget(cache): fs "nodes"
    btdel(_): cache ino
    bl_free(_): fs ino 1
    bl_parent(up): p
    bl_base(name): p
    bl_lookup(dino): fs up
    bl_dir(dir): fs dino
    btdel(_): dir name
    bl_dir_changed(_): fs dino
    set(r): 0
]

# Copies a file or a whole tree from one Belarus file system to another
# (or within one), run by run with bcopy. Calls the function named report
# (when not "") with each path and its record. The number of entries
# copied, or -1.
bl_copy_tree(r): src from dst to report [
    set(r): -1
    bl_clean(f): from
    bl_clean(t): to
    bl_walk(all): src f
    len(n): all
    if(_): {n = 0} [
        concat(m): "no file " f
        bl_err(_): m
        return(r): r
    ]
    len(fl): f
    btget(sdev): src "dev"
    btget(ddev): dst "dev"
    set(copied): 0
    set(i): 0
    while(_): {i < n} [
        at(pr): all i
        at(k): pr 0
        at(rec): pr 1
        len(kl): k
        slice(rest): k fl {kl - fl}
        if(_): {f = "/" && k != "/"} [ concat(rest): "/" rest ]
        if(_): {f = "/" && k = "/"} [ set(rest): "" ]
        concat(target): t rest
        bl_clean(target): target
        at(ty): rec 0
        set(w): -1
        if(_): {ty = "d"} [
            bl_mkdirs(w): dst target
        ]
        else(_): [
            at(size): rec 1
            at(sino): rec 3
            bl_create(dino): dst target "f"
            if(_): {dino != 0} [
                bl_allocate(druns): dst dino size
                typeof(td): druns
                if(_): {td = "vector"} [
                    bl_runs(sruns): src sino
                    bl_copy_runs(w): sdev sruns ddev druns {(size + 4095) >> 12}
                ]
            ]
        ]
        if(_): {w != 0} [ return(r): r ]
        btput(_): dst "dirty" true
        if(_): {report != ""} [ try(_): report target rec ]
        set(copied): {copied + 1}
        set(i): {i + 1}
    ]
    set(r): copied
]

# Checks a mounted file system: every inode and map node reads, every
# file maps blocks 0 .. n - 1 for its size, no block is used twice or
# both used and free, and none is lost. Prints what it finds; the number
# of problems.
bl_fsck(r): fs [
    set(r): 0
    btget(base): fs "base"
    btree(used):
    set(i): 0
    while(_): {i < 17} [
        btput(_): used i "meta"
        set(i): {i + 1}
    ]
    set(files): 0
    set(dirs): 0
    set(bytes): 0
    set(nodes): 0
    set(deepest): 1
    bl_walk(all): fs "/"
    len(n): all
    set(i): 0
    while(_): {i < n} [
        at(pr): all i
        at(path): pr 0
        at(rec): pr 1
        at(ty): rec 0
        at(size): rec 1
        at(ino): rec 3
        if(_): {ty = "d"} [ set(dirs): {dirs + 1} ]
        else(_): [
            set(files): {files + 1}
            set(bytes): {bytes + size}
        ]
        vec(mine): ""
        push(_): mine ino
        bl_map_nodes(mn): fs ino
        len(nm): mn
        set(nodes): {nodes + nm}
        set(j): 0
        while(_): {j < nm} [
            at(b): mn j
            push(_): mine b
            set(j): {j + 1}
        ]
        bl_map_path(mp): fs ino 0
        len(depth): mp
        if(_): {depth > deepest} [ set(deepest): depth ]
        bl_bmap_all(maps): fs ino
        len(nb): maps
        set(want): {(size + 4095) >> 12}
        if(_): {nb != want} [
            bl_int(sb): nb
            bl_int(sw): want
            concat(m): path ": maps " sb " blocks, its size needs " sw
            print(_): m
            set(r): {r + 1}
        ]
        set(j): 0
        while(_): {j < nb} [
            at(pm): maps j
            at(idx): pm 0
            at(lba): pm 1
            if(_): {idx != j} [
                bl_int(sj): j
                concat(m): path ": block " sj " is not mapped"
                print(_): m
                set(r): {r + 1}
                set(j): nb
            ]
            push(_): mine {(lba - base) >> 3}
            set(j): {j + 1}
        ]
        len(nmine): mine
        set(j): 0
        while(_): {j < nmine} [
            at(b): mine j
            bthas(twice): used b
            if(_): twice [
                bl_int(sb): b
                concat(m): path ": block " sb " is used twice"
                print(_): m
                set(r): {r + 1}
            ]
            btput(_): used b path
            set(j): {j + 1}
        ]
        set(i): {i + 1}
    ]
    btlen(nused): used
    btget(free): fs "free"
    btrange(fp): free
    len(nf): fp
    set(nfree): 0
    set(i): 0
    while(_): {i < nf} [
        at(p): fp i
        at(s): p 0
        at(c): p 1
        set(nfree): {nfree + c}
        btceil(clash): used s
        typeof(tc): clash
        if(_): {tc = "integer"} [
            if(_): {clash < s + c} [
                bl_int(sb): clash
                concat(m): "block " sb " is both free and used"
                print(_): m
                set(r): {r + 1}
            ]
        ]
        set(i): {i + 1}
    ]
    btget(blocks): fs "blocks"
    set(lost): {blocks - nused - nfree}
    if(_): {lost != 0} [
        bl_int(sl): lost
        concat(m): sl " blocks are neither used nor free"
        print(_): m
        set(r): {r + 1}
    ]
    bl_int(sd): dirs
    bl_int(sf): files
    bl_int(sb): bytes
    set(inodes): {dirs + files}
    bl_int(si): inodes
    bl_int(sn): nodes
    bl_int(sh): deepest
    concat(m): sd " directories, " sf " files, " sb " bytes; " si " inodes, " sn " block map nodes, map depth up to " sh
    print(_): m
]

# ---------------------------------------------------------------- command line

bl_usage(r): [
    set(r): 0
    print(_): "belarus - the USSR file system (B+ tree of paths)"
    print(_): ""
    print(_): "  belarus mkfs DEV [--label L] [--part N]   new file system (whole DEV, or partition N)"
    print(_): "  belarus info DEV                          the superblock and free space"
    print(_): "  belarus ls DEV [PATH]                     a directory"
    print(_): "  belarus tree DEV [PATH]                   everything under PATH"
    print(_): "  belarus cat DEV PATH                      a file's text"
    print(_): "  belarus put DEV FILE PATH                 a host file into the file system"
    print(_): "  belarus putlist DEV LIST [PREFIX]         the host files named in LIST (one per line)"
    print(_): "  belarus get DEV PATH FILE                 a file out to the host"
    print(_): "  belarus write DEV PATH TEXT               TEXT as the file PATH"
    print(_): "  belarus mkdir DEV PATH                    a directory (and its parents)"
    print(_): "  belarus rm DEV PATH                       a file or an empty directory"
    print(_): "  belarus fsck DEV                          checks the tree and the free space"
    print(_): ""
    print(_): "DEV is a disk or disk image: the first Belarus file system on it, or"
    print(_): "DEV@N for partition N. Make the partition with stalin (--type belarus)."
]

bl_human(r): bytes [
    set(r): ""
    if(_): {bytes >= 1048576} [
        str_from_number(r): {bytes / 1048576} 1
        concat(r): r " MiB"
    ]
    else(_): [
        str_from_number(r): {bytes / 1024} 1
        concat(r): r " KiB"
    ]
]

bl_cmd_mkfs(r): p [
    set(r): 2
    len(np): p
    if(_): {np < 2} [
        bl_err(_): "mkfs DEV [--label L] [--part N]"
        return(r): r
    ]
    at(dev): p 1
    set(label): "ussr"
    set(part): 0
    set(i): 2
    while(_): {i + 1 < np} [
        at(o): p i
        at(v): p {i + 1}
        if(_): {o = "--label"} [ set(label): v ]
        if(_): {o = "--part"} [ str_to_number(part): v ]
        set(i): {i + 2}
    ]
    bsize(bytes): dev
    if(_): {bytes < 0} [
        concat(m): "cannot open " dev
        bl_err(_): m
        return(r): r
    ]
    set(base): 0
    set(sectors): {bytes >> 9}
    if(_): {part > 0} [
        bread(s0): dev 0 1
        bl_parts(starts): dev s0
        len(n): starts
        if(_): {part > n} [
            bl_err(_): "no such partition"
            return(r): r
        ]
        at(base): starts {part - 1}
        bl_part_end(end): dev s0 part
        set(sectors): {end - base}
        if(_): {base = 0} [
            bl_err(_): "no such partition"
            return(r): r
        ]
    ]
    set(blocks): {sectors >> 3}
    bl_mkfs(fs): dev base blocks label
    typeof(t): fs
    if(_): {t != "btree"} [ return(r): r ]
    bl_int(sb): blocks
    bl_human(hs): {blocks << 12}
    concat(m): dev ": Belarus file system '" label "', " sb " blocks (" hs ")"
    print(_): m
    set(r): 0
]

# the sector after partition part ends (MBR or GPT)
bl_part_end(r): dev s0 part [
    set(r): 0
    at(t1): s0 450
    if(_): {t1 = 238} [
        bread(h): dev 1 1
        bl_le(elba): h 72 8
        bl_le(esize): h 84 4
        set(i): {part - 1}
        set(per): {512 / esize}
        str_trunc(per): per
        set(sec): {elba + (i / per)}
        str_trunc(sec): sec
        set(off): {(i % per) * esize}
        bread(e): dev sec 1
        bl_le(last): e {off + 40} 8
        set(r): {last + 1}
        return(r): r
    ]
    set(off): {446 + (part - 1) * 16}
    bl_le(first): s0 {off + 8} 4
    bl_le(count): s0 {off + 12} 4
    set(r): {first + count}
]

bl_open_or_fail(r): p [
    set(r): null
    len(np): p
    if(_): {np < 2} [
        bl_err(_): "which device?"
        return(r): r
    ]
    at(dev): p 1
    bl_open(r): dev
]

bl_cmd_info(r): fs [
    set(r): 0
    btget(label): fs "label"
    btget(uuid): fs "uuid"
    btget(blocks): fs "blocks"
    btget(root): fs "root"
    btget(base): fs "base"
    bl_free_count(free): fs
    bl_human(hs): {blocks << 12}
    bl_human(hf): {free << 12}
    bl_int(sbase): base
    bl_int(sroot): root
    concat(m): "label " label ", uuid " uuid
    print(_): m
    concat(m): "size " hs ", free " hf "; starts at sector " sbase ", root directory in inode " sroot
    print(_): m
]

bl_type_char(r): rec [
    at(ty): rec 0
    set(r): "-"
    if(_): {ty = "d"} [ set(r): "d" ]
]

bl_cmd_ls(r): fs path [
    set(r): 1
    bl_clean(p): path
    bl_get(rec): fs p
    typeof(t): rec
    if(_): {t != "vector"} [
        concat(m): "no file " p
        bl_err(_): m
        return(r): r
    ]
    at(ty): rec 0
    vec(names): ""
    if(_): {ty = "d"} [ bl_list(names): fs p ]
    else(_): [
        bl_base(b): p
        push(_): names b
    ]
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(name): names i
        set(full): p
        if(_): {ty = "d"} [
            if(_): {p = "/"} [ concat(full): "/" name ]
            else(_): [ concat(full): p "/" name ]
        ]
        bl_get(e): fs full
        bl_type_char(c): e
        at(size): e 1
        bl_int(ss): size
        len(sl): ss
        str_repeat(sp): " " {10 - sl}
        concat(line): c " " sp ss "  " name
        print(_): line
        set(i): {i + 1}
    ]
    set(r): 0
]

bl_cmd_tree(r): fs path [
    set(r): 0
    bl_walk(all): fs path
    len(n): all
    set(i): 0
    while(_): {i < n} [
        at(pr): all i
        at(k): pr 0
        at(rec): pr 1
        bl_type_char(c): rec
        at(size): rec 1
        bl_int(ss): size
        len(sl): ss
        str_repeat(sp): " " {10 - sl}
        concat(line): c " " sp ss "  " k
        print(_): line
        set(i): {i + 1}
    ]
]

# Puts the host file file at path (making its directories).
bl_put_host(r): fs file path [
    set(r): -1
    bsize(size): file
    if(_): {size < 0} [
        concat(m): "cannot read " file
        bl_err(_): m
        return(r): r
    ]
    bl_clean(p): path
    bl_parent(up): p
    bl_mkdirs(w): fs up
    if(_): {w != 0} [ return(r): r ]
    bl_write_from(r): fs p file 0 size
]

bl_cmd_putlist(r): fs list prefix [
    set(r): 1
    readfile(text): list
    typeof(tt): text
    if(_): {tt != "string"} [
        concat(m): "cannot read " list
        bl_err(_): m
        return(r): r
    ]
    len(n): text
    set(start): 0
    set(count): 0
    set(i): 0
    while(_): {i <= n} [
        set(b): 10
        if(_): {i < n} [ byte(b): text i ]
        if(_): {b = 10} [
            slice(line): text start {i - start}
            str_trim(line): line
            if(_): {line != ""} [
                concat(target): prefix "/" line
                bl_put_host(w): fs line target
                if(_): {w != 0} [ return(r): r ]
                set(count): {count + 1}
            ]
            set(start): {i + 1}
        ]
        set(i): {i + 1}
    ]
    bl_int(sc): count
    concat(m): sc " files put under " prefix
    print(_): m
    set(r): 0
]

# Writes the file at path out to the host file file.
bl_get_host(r): fs path file [
    set(r): -1
    bl_read_bytes(v): fs path
    typeof(t): v
    if(_): {t != "vector"} [ return(r): r ]
    len(n): v
    # bwrite grows a file in whole "sectors": make it, then write bytes
    open_file(h): file "wb"
    close_file(_): h
    if(_): {n > 0} [ bwrite(_): file 0 v 1 ]
    set(r): 0
]

belarus_main(r): args [
    set(r): 2
    len(np): args
    set(cmd): "help"
    if(_): {np > 0} [ at(cmd): args 0 ]
    if(_): {cmd = "help" || cmd = "--help" || cmd = "-h"} [
        bl_usage(r):
        return(r): r
    ]
    if(_): {cmd = "mkfs"} [
        bl_cmd_mkfs(r): args
        return(r): r
    ]
    bl_open_or_fail(fs): args
    typeof(tf): fs
    if(_): {tf != "btree"} [ return(r): r ]
    set(a2): "/"
    set(a3): ""
    set(a4): ""
    if(_): {np > 2} [ at(a2): args 2 ]
    if(_): {np > 3} [ at(a3): args 3 ]
    if(_): {np > 4} [ at(a4): args 4 ]
    set(r): -1
    if(_): {cmd = "info"} [ bl_cmd_info(r): fs ]
    elif(_): {cmd = "ls"} [ bl_cmd_ls(r): fs a2 ]
    elif(_): {cmd = "tree"} [ bl_cmd_tree(r): fs a2 ]
    elif(_): {cmd = "fsck"} [
        bl_fsck(bad): fs
        set(r): 0
        if(_): {bad > 0} [ set(r): 1 ]
    ]
    elif(_): {cmd = "cat"} [
        bl_read_text(t): fs a2
        set(r): 1
        typeof(tt): t
        if(_): {tt = "string"} [
            print_raw(_): t
            set(r): 0
        ]
    ]
    elif(_): {cmd = "get"} [
        bl_get_host(r): fs a2 a3
    ]
    elif(_): {cmd = "put"} [
        bl_put_host(r): fs a2 a3
    ]
    elif(_): {cmd = "putlist"} [
        set(prefix): a3
        if(_): {prefix = "/"} [ set(prefix): "" ]
        bl_cmd_putlist(r): fs a2 prefix
    ]
    elif(_): {cmd = "write"} [
        bl_parent(up): a2
        bl_mkdirs(w): fs up
        bl_write_text(r): fs a2 a3
    ]
    elif(_): {cmd = "mkdir"} [ bl_mkdirs(r): fs a2 ]
    elif(_): {cmd = "rm"} [ bl_remove(r): fs a2 ]
    else(_): [
        concat(m): "unknown command '" cmd "' (belarus help lists them)"
        bl_err(_): m
        return(r): r
    ]
    if(_): {r < 0} [ set(r): 1 ]
    btget(dirty): fs "dirty"
    if(_): dirty [
        bl_sync(w): fs
        if(_): {w != 0} [ set(r): 1 ]
    ]
]

# print without the newline print adds (the text has its own)
print_raw(r): t [
    len(n): t
    set(r): 0
    if(_): {n = 0} [ return(r): r ]
    byte(last): t {n - 1}
    if(_): {last = 10} [ slice(t): t 0 {n - 1} ]
    print(_): t
]

$ifdef __MAIN__
init(ret): arg_count arg_values [
    vec(args): ""
    set(i): 0
    while(_): {i < arg_count} [
        at(a): arg_values i
        push(_): args a
        set(i): {i + 1}
    ]
    belarus_main(ret): args
]
$endif
