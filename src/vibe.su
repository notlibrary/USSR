# vibe.su - spartan vi-clone for USSR.
#
#   ussr vibe.su [file]
#
# A minimal visual console text editor with vi-style modal editing.
# Normal mode:  h l       cursor left / right     (Backspace = left)
#               j k       cursor down / up        (arrow keys work too)
#               i         insert before cursor    a   insert after cursor
#               o         open new line below     x   delete char
#               d d       delete current line     :   command line
# Commands:     :w [name] write file   :q quit   :wq write+quit   :q! quit
#               :e [name] reload / edit another file
# Insert mode:  type to insert, Enter splits the line, Backspace deletes
#               (and joins lines at column 0), ESC or Ctrl+C -> normal.
#
# Implementation: the terminal is put in raw mode through native USSR
# terminal primitives. Each key is read directly; no shell commands,
# stty, shell utilities, or POSIX-only utilities are required. The whole screen is
# rebuilt as one string per frame and written with a single template call.

# ---------- terminal helpers ----------

vb_initesc(r): [
    terminal_escape(vb_esc):
    set(r): 0
]

vb_termsize(r): [
    set(vb_rows): 24
    set(vb_cols): 80
    terminal_size(vbt_s):
    len(vbt_n): vbt_s
    set(vbt_i): 0
    set(vbt_part): 0
    set(vbt_r): 0
    set(vbt_c): 0
    while(_): {vbt_i < vbt_n} [
        byte(vbt_b): vbt_s vbt_i
        if(_): {vbt_b = 32} [
            set(vbt_part): 1
        ]
        if(_): {vbt_b > 47} [
            if(_): {vbt_b < 58} [
                if(_): {vbt_part = 0} [
                    set(vbt_r): {vbt_r * 10 + vbt_b - 48}
                ]
                if(_): {vbt_part = 1} [
                    set(vbt_c): {vbt_c * 10 + vbt_b - 48}
                ]
            ]
        ]
        set(vbt_i): {vbt_i + 1}
    ]
    if(_): {vbt_r > 2} [
        set(vb_rows): vbt_r
    ]
    if(_): {vbt_c > 2} [
        set(vb_cols): vbt_c
    ]
    set(r): 0
]

# ---------- buffer helpers ----------

vb_setline(r): idx line [
    vec(vbsl_new): ""
    len(vbsl_n): vb_buf
    set(vbsl_i): 0
    while(_): {vbsl_i < vbsl_n} [
        at(vbsl_l): vb_buf vbsl_i
        if(_): {vbsl_i = idx} [
            set(vbsl_l): line
        ]
        push(_): vbsl_new vbsl_l
        set(vbsl_i): {vbsl_i + 1}
    ]
    set(vb_buf): vbsl_new
    set(r): 0
]

vb_linedel(r): idx [
    vec(vbdl_new): ""
    len(vbdl_n): vb_buf
    set(vbdl_i): 0
    while(_): {vbdl_i < vbdl_n} [
        if(_): {vbdl_i != idx} [
            at(vbdl_l): vb_buf vbdl_i
            push(_): vbdl_new vbdl_l
        ]
        set(vbdl_i): {vbdl_i + 1}
    ]
    set(vb_buf): vbdl_new
    set(r): 0
]

vb_lineins(r): idx line [
    vec(vbil_new): ""
    len(vbil_n): vb_buf
    set(vbil_i): 0
    while(_): {vbil_i < vbil_n} [
        if(_): {vbil_i = idx} [
            push(_): vbil_new line
        ]
        at(vbil_l): vb_buf vbil_i
        push(_): vbil_new vbil_l
        set(vbil_i): {vbil_i + 1}
    ]
    if(_): {vbil_i = idx} [
        push(_): vbil_new line
    ]
    set(vb_buf): vbil_new
    set(r): 0
]

vb_fixcx(r): [
    at(vbfx_l): vb_buf vb_cy
    len(vbfx_n): vbfx_l
    set(vbfx_max): vbfx_n
    if(_): {vb_mode = 0} [
        set(vbfx_max): {vbfx_n - 1}
    ]
    if(_): {vbfx_max < 0} [
        set(vbfx_max): 0
    ]
    if(_): {vb_cx > vbfx_max} [
        set(vb_cx): vbfx_max
    ]
    set(r): 0
]

vb_scroll(r): [
    if(_): {vb_cy < vb_top} [
        set(vb_top): vb_cy
    ]
    set(vbsc_last): {vb_top + vb_rows - 2}
    if(_): {vb_cy > vbsc_last} [
        set(vb_top): {vb_cy - vb_rows + 2}
    ]
    set(r): 0
]

# ---------- movement ----------

vb_left(r): [
    if(_): {vb_cx > 0} [
        set(vb_cx): {vb_cx - 1}
    ]
    set(r): 0
]

vb_right(r): [
    at(vbm_l): vb_buf vb_cy
    len(vbm_n): vbm_l
    set(vbm_max): vbm_n
    if(_): {vb_mode = 0} [
        set(vbm_max): {vbm_n - 1}
    ]
    if(_): {vbm_max < 0} [
        set(vbm_max): 0
    ]
    if(_): {vb_cx < vbm_max} [
        set(vb_cx): {vb_cx + 1}
    ]
    set(r): 0
]

vb_up(r): [
    if(_): {vb_cy > 0} [
        set(vb_cy): {vb_cy - 1}
        vb_fixcx(_): 
    ]
    vb_scroll(_): 
    set(r): 0
]

vb_down(r): [
    len(vbm2_n): vb_buf
    if(_): {vb_cy < vbm2_n - 1} [
        set(vb_cy): {vb_cy + 1}
        vb_fixcx(_): 
    ]
    vb_scroll(_): 
    set(r): 0
]

# ---------- editing ----------

vb_insch(r): ch [
    at(vbic_l): vb_buf vb_cy
    len(vbic_n): vbic_l
    slice(vbic_a): vbic_l 0 vb_cx
    slice(vbic_b): vbic_l vb_cx {vbic_n - vb_cx}
    concat(vbic_a): vbic_a ch
    concat(vbic_a): vbic_a vbic_b
    vb_setline(_): vb_cy vbic_a
    set(vb_cx): {vb_cx + 1}
    set(vb_dirty): 1
    set(r): 0
]

vb_bs(r): [
    set(r): 0
    if(_): {vb_cx > 0} [
        at(vbbs_l): vb_buf vb_cy
        len(vbbs_n): vbbs_l
        slice(vbbs_a): vbbs_l 0 {vb_cx - 1}
        slice(vbbs_b): vbbs_l vb_cx {vbbs_n - vb_cx}
        concat(vbbs_a): vbbs_a vbbs_b
        vb_setline(_): vb_cy vbbs_a
        set(vb_cx): {vb_cx - 1}
        set(vb_dirty): 1
    ]
    if(_): {vb_cx = 0} [
        if(_): {vb_cy > 0} [
            at(vbbs_p): vb_buf {vb_cy - 1}
            at(vbbs_c): vb_buf vb_cy
            len(vbbs_pl): vbbs_p
            concat(vbbs_p): vbbs_p vbbs_c
            vb_linedel(_): vb_cy
            vb_setline(_): {vb_cy - 1} vbbs_p
            set(vb_cy): {vb_cy - 1}
            set(vb_cx): vbbs_pl
            set(vb_dirty): 1
        ]
    ]
]

vb_enter(r): [
    at(vben_l): vb_buf vb_cy
    len(vben_n): vben_l
    slice(vben_a): vben_l 0 vb_cx
    slice(vben_b): vben_l vb_cx {vben_n - vb_cx}
    vb_setline(_): vb_cy vben_a
    vb_lineins(_): {vb_cy + 1} vben_b
    set(vb_cy): {vb_cy + 1}
    set(vb_cx): 0
    set(vb_dirty): 1
    vb_scroll(_): 
    set(r): 0
]

vb_delch(r): [
    at(vbdc_l): vb_buf vb_cy
    len(vbdc_n): vbdc_l
    if(_): {vb_cx < vbdc_n} [
        slice(vbdc_a): vbdc_l 0 vb_cx
        slice(vbdc_b): vbdc_l {vb_cx + 1} {vbdc_n - vb_cx - 1}
        concat(vbdc_a): vbdc_a vbdc_b
        vb_setline(_): vb_cy vbdc_a
        set(vb_dirty): 1
        vb_fixcx(_): 
    ]
    set(r): 0
]

vb_delete_line(r): [
    vb_linedel(_): vb_cy
    len(vbdel_n): vb_buf
    if(_): {vbdel_n = 0} [
        push(_): vb_buf ""
    ]
    len(vbdel_n2): vb_buf
    if(_): {vb_cy + 1 > vbdel_n2} [
        set(vb_cy): {vbdel_n2 - 1}
    ]
    set(vb_cx): 0
    set(vb_dirty): 1
    vb_scroll(_): 
    set(r): 0
]

# ---------- file I/O ----------

# Different host builds disagree on file_exists: 1=exists, 0=exists
# (test -f style), string results, or no builtin at all. Detect the
# convention at startup: write a witness file we know exists, probe it
# and a name that cannot exist, and remember the value that means
# "exists" (vb_fe_yes). If both probes answer the same, the builtin is
# unusable -> vb_fe_ok stays 0 and vb_load falls back to `test -f`.
vb_detect(r): [
    set(vb_fe_ok): 0
    set(vb_fe_yes): 1
    writefile(vbdt_w): ".vibe_probe.tmp" "x"
    file_exists(vbdt_y): ".vibe_probe.tmp"
    file_exists(vbdt_n): ".vibe_probe_absent_9x7q.tmp"
    if(_): {vbdt_y != vbdt_n} [
        set(vb_fe_ok): 1
        set(vb_fe_yes): vbdt_y
    ]
    set(r): 0
]

vb_load(r): path [
    vec(vb_buf): ""
    set(vb_dirty): 0
    set(vbl_go): 0
    if(_): {vb_fe_ok = 1} [
        file_exists(vbl_tf): path
        if(_): {vbl_tf = vb_fe_yes} [
            set(vbl_go): 1
        ]
    ]
    if(_): {vb_fe_ok = 0} [
        test(vbl_tt): "-f" path
        if(_): {vbl_tt = 0} [
            set(vbl_go): 1
        ]
    ]
    if(_): {vbl_go = 1} [
        readfile(vbl_d): path
        len(vbl_n): vbl_d
        set(vbl_i): 0
        set(vbl_cur): ""
        while(_): {vbl_i < vbl_n} [
            byte(vbl_b): vbl_d vbl_i
            if(_): {vbl_b = 10} [
                push(_): vb_buf vbl_cur
                set(vbl_cur): ""
            ]
            if(_): {vbl_b != 10} [
                if(_): {vbl_b != 13} [
                    slice(vbl_ch): vbl_d vbl_i 1
                    concat(vbl_cur): vbl_cur vbl_ch
                ]
            ]
            set(vbl_i): {vbl_i + 1}
        ]
        len(vbl_cl): vbl_cur
        if(_): {vbl_cl > 0} [
            push(_): vb_buf vbl_cur
        ]
    ]
    len(vbl_bn): vb_buf
    if(_): {vbl_bn = 0} [
        push(_): vb_buf ""
    ]
    set(vb_cx): 0
    set(vb_cy): 0
    set(vb_top): 0
    set(r): 0
]

vb_save(r): [
    set(r): 0
    len(vbw_fn): vb_file
    if(_): {vbw_fn = 0} [
        set(vb_msg): "no file name"
    ]
    if(_): {vbw_fn > 0} [
        set(vb_payload): ""
        len(vbw_n): vb_buf
        set(vbw_i): 0
        while(_): {vbw_i < vbw_n} [
            at(vbw_l): vb_buf vbw_i
            concat(vb_payload): vb_payload vbw_l
            concat(vb_payload): vb_payload "\n"
            set(vbw_i): {vbw_i + 1}
        ]
        writefile(vbw_ok): vb_file vb_payload
        set(vb_dirty): 0
        set(vb_msg): "written"
    ]
]

# ---------- render ----------

vb_render(r): [
    set(vbrn_s): vb_esc
    concat(vbrn_s): vbrn_s "[H"
    len(vbrn_n): vb_buf
    set(vbrn_row): 0
    set(vbrn_last): {vb_rows - 1}
    while(_): {vbrn_row < vbrn_last} [
        set(vbrn_li): {vbrn_row + vb_top}
        set(vbrn_has): 0
        if(_): {vbrn_li < vbrn_n} [
            set(vbrn_has): 1
            at(vbrn_l): vb_buf vbrn_li
            len(vbrn_ll): vbrn_l
            if(_): {vbrn_ll > vb_cols} [
                slice(vbrn_l): vbrn_l 0 vb_cols
            ]
            concat(vbrn_s): vbrn_s vbrn_l
        ]
        if(_): {vbrn_has = 0} [
            concat(vbrn_s): vbrn_s "~"
        ]
        concat(vbrn_s): vbrn_s vb_esc
        concat(vbrn_s): vbrn_s "[K"
        concat(vbrn_s): vbrn_s "\r\n"
        set(vbrn_row): {vbrn_row + 1}
    ]
    concat(vbrn_s): vbrn_s vb_esc
    concat(vbrn_s): vbrn_s "[7m"
    if(_): {vb_mode = 2} [
        concat(vbrn_s): vbrn_s vb_msg
    ]
    if(_): {vb_mode < 2} [
        concat(vbrn_s): vbrn_s " "
        if(_): {vb_mode = 0} [
            concat(vbrn_s): vbrn_s "NORMAL"
        ]
        if(_): {vb_mode = 1} [
            concat(vbrn_s): vbrn_s "INSERT"
        ]
        concat(vbrn_s): vbrn_s "  "
        concat(vbrn_s): vbrn_s vb_showname
        if(_): {vb_dirty = 1} [
            concat(vbrn_s): vbrn_s " [+]"
        ]
        if(_): {vb_dirty = 0} [
            concat(vbrn_s): vbrn_s "    "
        ]
        concat(vbrn_s): vbrn_s "  "
        concat(vbrn_s): vbrn_s vb_msg
    ]
    concat(vbrn_s): vbrn_s vb_esc
    concat(vbrn_s): vbrn_s "[0m"
    concat(vbrn_s): vbrn_s vb_esc
    concat(vbrn_s): vbrn_s "[K"
    concat(vbrn_s): vbrn_s vb_esc
    concat(vbrn_s): vbrn_s "["
    encode(vbrn_y): {vb_cy - vb_top + 1}
    concat(vbrn_s): vbrn_s vbrn_y
    concat(vbrn_s): vbrn_s ";"
    encode(vbrn_x): {vb_cx + 1}
    concat(vbrn_s): vbrn_s vbrn_x
    concat(vbrn_s): vbrn_s "H"
    template(_): "STR" vbrn_s
    set(r): 0
]

# ---------- input queue ----------

vb_next(r): [
    set(vbnx_have): 0
    if(_): {vb_pb > 0 - 1} [
        set(vbnx_have): 1
        set(r): vb_pb
        set(vb_pb): {0 - 1}
    ]
    if(_): {vbnx_have = 0} [
        terminal_getch(vbnx_b):
        set(r): vbnx_b
    ]
]

# ---------- mode handlers ----------

vb_escape(r): [
    set(vb_mode): 0
    set(vb_pend): 0
    vb_fixcx(_): 
    set(r): 0
]

vb_arrow(r): c [
    if(_): {c = 65} [
        vb_up(_): 
    ]
    if(_): {c = 66} [
        vb_down(_): 
    ]
    if(_): {c = 67} [
        vb_right(_): 
    ]
    if(_): {c = 68} [
        vb_left(_): 
    ]
    set(r): 0
]

vb_insert(r): b [
    set(r): 0
    if(_): {b = 13} [
        vb_enter(_): 
    ]
    if(_): {b = 10} [
        vb_enter(_): 
    ]
    if(_): {b = 127} [
        vb_bs(_): 
    ]
    if(_): {b = 8} [
        vb_bs(_): 
    ]
    if(_): {b = 3} [
        vb_escape(_): 
    ]
    if(_): {b > 31} [
        if(_): {b < 127} [
            slice(vbin_ch): vb_ascii {b - 32} 1
            vb_insch(_): vbin_ch
        ]
    ]
]

vb_normal(r): b [
    set(r): 0
    if(_): {b != 100} [
        set(vb_pend): 0
    ]
    if(_): {b = 8} [
        vb_left(_): 
    ]
    if(_): {b = 127} [
        vb_left(_): 
    ]
    if(_): {b = 104} [
        vb_left(_): 
    ]
    if(_): {b = 108} [
        vb_right(_): 
    ]
    if(_): {b = 106} [
        vb_down(_): 
    ]
    if(_): {b = 107} [
        vb_up(_): 
    ]
    if(_): {b = 105} [
        set(vb_mode): 1
    ]
    if(_): {b = 97} [
        at(vbnm_l): vb_buf vb_cy
        len(vbnm_n): vbnm_l
        if(_): {vb_cx < vbnm_n} [
            set(vb_cx): {vb_cx + 1}
        ]
        set(vb_mode): 1
    ]
    if(_): {b = 111} [
        vb_lineins(_): {vb_cy + 1} ""
        set(vb_cy): {vb_cy + 1}
        set(vb_cx): 0
        set(vb_mode): 1
        set(vb_dirty): 1
        vb_scroll(_): 
    ]
    if(_): {b = 120} [
        vb_delch(_): 
    ]
    if(_): {b = 100} [
        set(vbnm_was): vb_pend
        set(vb_pend): 0
        if(_): {vbnm_was = 1} [
            vb_delete_line(_): 
        ]
        if(_): {vbnm_was = 0} [
            set(vb_pend): 1
        ]
    ]
    if(_): {b = 58} [
        vb_command(_): 
    ]
]

# ---------- command line ----------

vb_runcmd(r): cmd [
    set(r): 0
    set(vbrc_ok): 0
    if(_): {cmd = "q"} [
        set(vbrc_ok): 1
        set(vb_running): 0
    ]
    if(_): {cmd = "q!"} [
        set(vbrc_ok): 1
        set(vb_running): 0
    ]
    if(_): {cmd = "w"} [
        set(vbrc_ok): 1
        vb_save(_): 
    ]
    if(_): {cmd = "wq"} [
        set(vbrc_ok): 1
        vb_save(_): 
        set(vb_running): 0
    ]
    len(vbrc_n): cmd
    if(_): {vbrc_n > 2} [
        slice(vbrc_p): cmd 0 2
        if(_): {vbrc_p = "w "} [
            set(vbrc_ok): 1
            slice(vb_file): cmd 2 {vbrc_n - 2}
            set(vb_showname): vb_file
            vb_save(_): 
        ]
    ]
    if(_): {cmd = "e"} [
        set(vbrc_ok): 1
        vb_load(_): vb_file
    ]
    len(vbrc_n): cmd
    if(_): {vbrc_n > 2} [
        slice(vbrc_p2): cmd 0 2
        if(_): {vbrc_p2 = "e "} [
            set(vbrc_ok): 1
            slice(vb_file): cmd 2 {vbrc_n - 2}
            set(vb_showname): vb_file
            vb_load(_): vb_file
        ]
    ]
    if(_): {vbrc_ok = 0} [
        set(vb_msg): "not an editor command"
    ]
]

vb_command(r): [
    set(vb_mode): 2
    set(vb_msg): ":"
    set(vbcm_cmd): ""
    set(vbcm_ok): 0
    set(vbcm_done): 0
    while(_): {vbcm_done = 0} [
        vb_render(_): 
        vb_next(vbcm_b): 
        if(_): {vbcm_b < 0} [
            set(vbcm_done): 1
        ]
        if(_): {vbcm_b = 13} [
            set(vbcm_done): 1
            set(vbcm_ok): 1
        ]
        if(_): {vbcm_b = 10} [
            set(vbcm_done): 1
            set(vbcm_ok): 1
        ]
        if(_): {vbcm_b = 27} [
            set(vbcm_done): 1
        ]
        if(_): {vbcm_b = 3} [
            set(vbcm_done): 1
        ]
        if(_): {vbcm_b = 8} [
            set(vbcm_b): 127
        ]
        if(_): {vbcm_b = 127} [
            len(vbcm_cl): vbcm_cmd
            if(_): {vbcm_cl > 0} [
                slice(vbcm_cmd): vbcm_cmd 0 {vbcm_cl - 1}
                set(vb_msg): ":"
                concat(vb_msg): vb_msg vbcm_cmd
            ]
        ]
        if(_): {vbcm_b > 31} [
            if(_): {vbcm_b < 127} [
                slice(vbcm_ch): vb_ascii {vbcm_b - 32} 1
                concat(vbcm_cmd): vbcm_cmd vbcm_ch
                concat(vb_msg): vb_msg vbcm_ch
            ]
        ]
    ]
    set(vb_mode): 0
    set(vb_msg): ""
    if(_): {vbcm_ok = 1} [
        vb_runcmd(_): vbcm_cmd
    ]
    set(r): 0
]

# ---------- key dispatch ----------

vb_dispatch(r): b [
    set(r): 0
    if(_): {b = 27} [
        vb_next(vbdp_b2): 
        if(_): {vbdp_b2 = 91} [
            vb_next(vbdp_b3): 
            vb_arrow(_): vbdp_b3
        ]
        if(_): {vbdp_b2 != 91} [
            vb_escape(_): 
            if(_): {vbdp_b2 > 0 - 1} [
                set(vb_pb): vbdp_b2
            ]
        ]
    ]
    if(_): {b != 27} [
        set(vbdp_m): vb_mode
        if(_): {vbdp_m = 0} [
            vb_normal(_): b
        ]
        if(_): {vbdp_m = 1} [
            vb_insert(_): b
        ]
    ]
]

# ---------- entry ----------

init(ret): arg_cnt arg_vec [
    set(vb_file): ""
    set(vb_showname): "[No Name]"
    if(_): {arg_cnt > 0} [
        at(vb_file): arg_vec 0
        set(vb_showname): vb_file
    ]
    vb_detect(_): 
    vb_load(_): vb_file
    vb_initesc(_): 
    vb_termsize(_): 
    set(vb_ascii): " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    set(vb_inq): ""
    set(vb_pb): {0 - 1}
    terminal_raw(vbit_r1): 
    set(vb_mode): 0
    set(vb_cx): 0
    set(vb_cy): 0
    set(vb_top): 0
    set(vb_pend): 0
    set(vb_msg): ""
    set(vb_running): 1
    set(vbit_s): vb_esc
    concat(vbit_s): vbit_s "[2J"
    concat(vbit_s): vbit_s vb_esc
    concat(vbit_s): vbit_s "[H"
    template(_): "STR" vbit_s
    while(_): {vb_running = 1} [
        vb_render(_): 
        vb_next(vb_b): 
        if(_): {vb_b < 0} [
            set(vb_running): 0
        ]
        if(_): {vb_b > 0 - 1} [
            vb_dispatch(_): vb_b
        ]
    ]
    terminal_sane(vbit_r2): 
    set(vbit_s2): vb_esc
    concat(vbit_s2): vbit_s2 "[2J"
    concat(vbit_s2): vbit_s2 vb_esc
    concat(vbit_s2): vbit_s2 "[H"
    template(_): "STR" vbit_s2
    set(ret): 0
]
