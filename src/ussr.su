            set(r): i
        ]
        if(_): {rt_ffok = 0} [
            add(rt_ffi2): i 1
            rt_findf_i(r): nm rt_ffi2
        ]
    ]
]
rt_findf(r): nm [
    rt_findf_i(r): nm 0
]

# ---- function call (save-vec as param: recursion-safe) ----
rt_call(r): fd args cret [
    vec(rt_sv): ""
    getf(rt_cp): fd "prm"
    len(rt_cn): rt_cp
    ex_bind(r): fd args rt_cp rt_sv 0 rt_cn
    ex_alias(r): fd cret rt_sv
    getf(rt_cb): fd "body"
    ex_block(_): rt_cb
    if(_): {rt_flow = 3} [
        set(rt_flow): 0
        rt_write(_): cret rt_rv
    ]
    add(rt_cn1): rt_cn 1
    ex_rest(r): rt_sv 0 rt_cn1
    set(r): 0
]
ex_bind(r): fd args prm sv i n [
    if(_): {i < n} [
        at(rt_bn): prm i
        getf(rt_bnm): rt_bn "s1"
        getf(rt_ak): args "kids"
        at(rt_an): rt_ak i
        ex_val(rt_av): rt_an
        rt_find(rt_bi): rt_bnm
        new(rt_sp2): "rt_sv" rt_bnm 0 0 ""
        setf(_): rt_sp2 "n" rt_bnm
        if(_): {rt_bi < 0} [
            setf(_): rt_sp2 "had" 0
            setf(_): rt_sp2 "v" 0
            setf(_): rt_sp2 "t" ""
        ]
        if(_): {rt_bi + 1 > 0} [
            setf(_): rt_sp2 "had" 1
            at(rt_bp): rt_store rt_bi
            getf(rt_bv): rt_bp "v"
            getf(rt_bt): rt_bp "t"
            setf(_): rt_sp2 "v" rt_bv
            setf(_): rt_sp2 "t" rt_bt
        ]
        push(_): sv rt_sp2
        rt_write(_): rt_bnm rt_av
        add(rt_bi2): i 1
        ex_bind(r): fd args prm sv rt_bi2 n
    ]
    if(_): {i = n} [
        set(r): 0
    ]
]
ex_alias(r): fd cret sv [
    getf(rt_anm): fd "ret"
    rt_find(rt_ai): rt_anm
    new(rt_ap): "rt_sv" rt_anm 0 0 ""
    setf(_): rt_ap "n" rt_anm
    set(rt_asame): 0
    if(_): {rt_anm = cret} [ set(rt_asame): 1 ]
    if(_): {rt_ai < 0} [
        setf(_): rt_ap "had" 0
        setf(_): rt_ap "v" 0
        setf(_): rt_ap "t" ""
        new(rt_np): "rt_sp" rt_anm 0 ""
        setf(_): rt_np "n" rt_anm
        setf(_): rt_np "v" 0
        if(_): {rt_asame = 0} [
            setf(_): rt_np "t" cret
        ]
        push(_): rt_store rt_np
    ]
    if(_): {rt_ai + 1 > 0} [
        setf(_): rt_ap "had" 1
        at(rt_op): rt_store rt_ai
        getf(rt_ov): rt_op "v"
        getf(rt_ot): rt_op "t"
        setf(_): rt_ap "v" rt_ov
        setf(_): rt_ap "t" rt_ot
        if(_): {rt_asame = 0} [
            setf(_): rt_op "t" cret
        ]
    ]
    push(_): sv rt_ap
    set(r): 0
]
ex_rest(r): sv i n [
    if(_): {i < n} [
        at(rt_rp2): sv i
        getf(rt_rsn): rt_rp2 "n"
        getf(rt_rsh): rt_rp2 "had"
        if(_): {rt_rsh = 1} [
            rt_find(rt_ri3): rt_rsn
            if(_): {rt_ri3 + 1 > 0} [
                at(rt_rpp): rt_store rt_ri3
                getf(rt_rvv): rt_rp2 "v"
                getf(rt_rtt): rt_rp2 "t"
                setf(_): rt_rpp "v" rt_rvv
                setf(_): rt_rpp "t" rt_rtt
            ]
        ]
        add(rt_ri4): i 1
        ex_rest(r): sv rt_ri4 n
    ]
    if(_): {i = n} [
        set(r): 0
    ]
]
# ---- command execution ----
ex_cmd(r): nd [
    if(_): {rt_flow = 0} [
        getf(rt_cm): nd "s1"
        ex_cmd_n(r): nd rt_cm
    ]
]
ex_cmd_n(r): nd nm [
    set(r): 0
    if(_): {rt_flow = 0} [
        if(_): {nm = "set"} [
            getf(rt_sk): nd "kids"
