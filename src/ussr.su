    ]
]
# ---------- parser: command / block / program ----------
ps_cmd(r): [
    if(_): {ps_stop = 0} [
        ps_txt(ps_cn): 0
        ps_adv(_): 0
        set(ps_cr): ""
        ps_isk(ps_ch): 14
        if(_): {ps_ch = 1} [
            ps_adv(_): 0
            ps_txt(ps_cr): 0
            ps_adv(_): 0
            ps_isk(ps_ch2): 15
            if(_): {ps_ch2 = 0} [
                ps_fail(ps_cf): "expected ) after return var"
            ]
            if(_): {ps_ch2 = 1} [
                ps_adv(_): 0
            ]
        ]
        if(_): {ps_stop = 0} [
            ps_isk(ps_ch3): 16
            if(_): {ps_ch3 = 0} [
                ps_fail(ps_cf): "expected :"
            ]
            if(_): {ps_ch3 = 1} [
                ps_adv(_): 0
                vec(ps_cp): ""
                ps_cmd_params(r): ps_cn ps_cr ps_cp
            ]
        ]
    ]
]
ps_cmd_params(r): nm rt pv [
    ps_cur(ps_ip_k): 0
    set(ps_ip_m): 0
    if(_): {ps_ip_k = 12} [
        set(ps_ip_m): 1
    ]
    if(_): {ps_ip_k = 17} [
        set(ps_ip_m): 2
    ]
    if(_): {ps_ip_k = 99} [
        set(ps_ip_m): 2
    ]
    if(_): {ps_ip_k = 13} [
        set(ps_ip_m): 2
    ]
    ps_cmd_iter(r): nm rt pv ps_ip_k ps_ip_m
]
ps_cmd_iter(r): nm rt pv k mode [
    set(r): 0
    if(_): {ps_stop = 0} [
        if(_): {mode = 2} [
            nd_new(r): 2 nm rt 0 pv
        ]
        if(_): {mode < 2} [
            if(_): {mode = 0} [
                ps_par(ps_it_par): 
                ps_istok(ps_it_h1): "!"
                if(_): {ps_it_h1 = 1} [
                    ps_adv(_): 0
                    setf(_): ps_it_par "s2" "hash"
                ]
                if(_): {ps_it_h1 = 0} [
                    ps_istok(ps_it_h2): "?"
                    if(_): {ps_it_h2 = 1} [
                        ps_adv(_): 0
                        setf(_): ps_it_par "s2" "hashref"
                    ]
                ]
                push(_): pv ps_it_par
            ]
            if(_): {mode = 1} [
                ps_block(ps_it_blk): 
                push(_): pv ps_it_blk
            ]
            ps_cur(ps_it_k2): 0
            set(ps_it_m2): 0
            if(_): {ps_it_k2 = 12} [
                set(ps_it_m2): 1
            ]
            if(_): {ps_it_k2 = 17} [
                set(ps_it_m2): 2
            ]
            if(_): {ps_it_k2 = 99} [
                set(ps_it_m2): 2
            ]
            if(_): {ps_it_k2 = 13} [
                set(ps_it_m2): 2
            ]
            ps_cmd_iter(r): nm rt pv ps_it_k2 ps_it_m2
        ]
    ]
]
ps_block(r): [
    if(_): {ps_stop = 0} [
        ps_isk(ps_bh): 12
        if(_): {ps_bh = 0} [
