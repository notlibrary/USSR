        set(ps_par_m): 0
        if(_): {ps_par_k = 1} [
            ps_txt(ps_par_s): 0
            ps_adv(_): 0
            nd_new(r): 4 ps_par_s "" 0 ""
            set(ps_par_m): 1
        ]
        if(_): {ps_par_m = 0} [
            if(_): {ps_par_k = 2} [
                ps_txt(ps_par_s): 0
                ps_adv(_): 0
                nd_new(r): 5 ps_par_s "" 0 ""
                set(ps_par_m): 1
            ]
        ]
        if(_): {ps_par_m = 0} [
            if(_): {ps_par_k = 3} [
                ps_txt(ps_par_s): 0
                ps_adv(_): 0
                nd_new(r): 6 ps_par_s "" 0 ""
                set(ps_par_m): 1
            ]
        ]
        if(_): {ps_par_m = 0} [
            if(_): {ps_par_k = 4} [
                ps_txt(ps_par_s): 0
                ps_adv(_): 0
                nd_new(r): 7 ps_par_s "" 0 ""
                set(ps_par_m): 1
            ]
        ]
        if(_): {ps_par_m = 0} [
            if(_): {ps_par_k = 5} [
                ps_txt(ps_par_s): 0
                ps_adv(_): 0
                nd_new(r): 10 ps_par_s "" 0 ""
                set(ps_par_m): 1
            ]
        ]
        if(_): {ps_par_m = 0} [
            if(_): {ps_par_k = 6} [
                ps_txt(ps_par_s): 0
                ps_adv(_): 0
                nd_new(r): 8 ps_par_s "" 0 ""
                set(ps_par_m): 1
            ]
        ]
        if(_): {ps_par_m = 0} [
            if(_): {ps_par_k = 7} [
                ps_adv(_): 0
                nd_new(r): 9 "" "" 0 ""
                set(ps_par_m): 1
            ]
        ]
        if(_): {ps_par_m = 0} [
            if(_): {ps_par_k = 10} [
                ps_adv(_): 0
                ps_e11(r): 
                ps_isk(ps_par_h): 11
                if(_): {ps_par_h = 0} [
