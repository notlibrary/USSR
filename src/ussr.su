# ---- VM runtime ----
# register = vm_rv{v}; frame = vm_fr{rip, sv, crt}
vm_reg(r): k [
    at(r): vm_regs k
    getf(r): r "v"
]
vm_setreg(r): k val [
    at(r): vm_regs k
    setf(_): r "v" val
]
vm_loop(r): [
    set(r): 0
    len(vm_codelen): cv_code
    set(vm_lgo): 1
    while(_): {vm_lgo = 1} [
        set(vm_lgo): 0
        if(_): {vm_flow = 0} [
            if(_): {vm_ip < vm_codelen} [
                set(vm_lgo): 1
            ]
        ]
        if(_): {vm_lgo = 1} [
            at(vm_cur): cv_code vm_ip
            getf(vm_op): vm_cur "op"
            vm_step(r): vm_cur vm_op
            add(vm_ip): vm_ip 1
        ]
    ]
]
vm_bind_i(r): prm sv ab i n [
    if(_): {i < n} [
        at(vm_bn): prm i
        getf(vm_bnm): vm_bn "s1"
        add(vm_bk): ab i
        vm_reg(vm_bv): vm_bk
        rt_find(vm_bi): vm_bnm
        new(vm_bs): "rt_sv" vm_bnm 0 0 ""
        setf(_): vm_bs "n" vm_bnm
        if(_): {vm_bi < 0} [
            setf(_): vm_bs "had" 0
            setf(_): vm_bs "v" 0
            setf(_): vm_bs "t" ""
        ]
        if(_): {vm_bi + 1 > 0} [
            setf(_): vm_bs "had" 1
            at(vm_bp): rt_store vm_bi
            getf(vm_bv2): vm_bp "v"
            getf(vm_bt2): vm_bp "t"
            setf(_): vm_bs "v" vm_bv2
            setf(_): vm_bs "t" vm_bt2
        ]
        push(_): sv vm_bs
        rt_write(_): vm_bnm vm_bv
        rt_read(vm_ck): vm_bnm
