# ---------- M4: bytecode compiler + VM ----------
# In{op,a,b,c,imm}: 0 NOP 1 LOAD_CONST 2 LOAD_VAR 3 STORE_VAR 4 NATIVE
# 5 CALL 6 RET 7 JMP 8 JMP_TRUE 9 JMP_FALSE 10 ADD 11 SUB 12 MUL 13 DIV 14 MOD 15 HALT

