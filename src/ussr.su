ps_block_body(r): kids [
    set(r): 0
    if(_): {ps_stop = 0} [
        ps_skipnl(_): 0
        ps_cur(ps_bk2): 0
        set(ps_bterm): 0
        if(_): {ps_bk2 = 13} [
            set(ps_bterm): 1
        ]
        if(_): {ps_bk2 = 99} [
            set(ps_bterm): 1
        ]
        if(_): {ps_bterm = 1} [
            if(_): {ps_bk2 = 13} [
                ps_adv(_): 0
                nd_new(r): 3 "" "" 0 kids
            ]
            if(_): {ps_bk2 = 99} [
                ps_fail(ps_bf): "unterminated block"
            ]
        ]
        if(_): {ps_bterm = 0} [
            ps_cmd(ps_bc): 
            push(_): kids ps_bc
            ps_block_body(r): kids
        ]
    ]
]
ps_prog(r): [
    vec(ps_pr_items): ""
    set(ps_pr_go): 1
    while(_): {ps_pr_go = 1} [
        if(_): {ps_stop = 1} [
            set(ps_pr_go): 0
        ]
        if(_): {ps_pr_go = 1} [
            ps_skipnl(_): 0
            ps_cur(ps_pr_k): 0
            if(_): {ps_pr_k = 99} [
                set(ps_pr_go): 0
            ]
            if(_): {ps_pr_go = 1} [
                set(ps_pr_m): 0
                if(_): {ps_pr_k = 21} [
                    ps_txt(ps_pr_s): 0
                    ps_adv(_): 0
                    nd_new(ps_pr_n): 14 ps_pr_s "" 0 ""
                    push(_): ps_pr_items ps_pr_n
                    set(ps_pr_m): 1
                ]
                if(_): {ps_pr_k = 12} [
                    ps_block(ps_pr_bb): 
                    push(_): ps_pr_items ps_pr_bb
                    set(ps_pr_m): 1
                ]
                if(_): {ps_pr_k = 22} [
                    ps_adv(_): 0
                    vec(ps_pr_atkids): ""
                    set(ps_pr_atgo): 1
                    while(_): {ps_pr_atgo = 1} [
                        if(_): {ps_stop = 1} [
                            set(ps_pr_atgo): 0
                        ]
                        if(_): {ps_pr_atgo = 1} [
                            ps_isk(ps_pr_ath): 12
                            if(_): {ps_pr_ath = 0} [
                                set(ps_pr_atgo): 0
                            ]
                            if(_): {ps_pr_ath = 1} [
                                ps_block(ps_pr_atb): 
                                push(_): ps_pr_atkids ps_pr_atb
                            ]
                        ]
                    ]
                    nd_new(ps_pr_n): 23 "@" "" 0 ps_pr_atkids
                    push(_): ps_pr_items ps_pr_n
                    set(ps_pr_m): 1
                ]
                if(_): {ps_pr_m = 0} [
                    ps_cmd(ps_pr_c): 
                    push(_): ps_pr_items ps_pr_c
                ]
            ]
        ]
    ]
    nd_new(r): 1 "" "" 0 ps_pr_items
]
# ---------- parser: AST dump (preorder, depth field) ----------
ps_dump(r): nd depth [
    getf(ps_d_tag): nd "tag"
    getf(ps_d_s1): nd "s1"
    getf(ps_d_s2): nd "s2"
    getf(ps_d_n1): nd "n1"
    getf(ps_d_kids): nd "kids"
    len(ps_d_nk): ps_d_kids
    template(_): "INT;INT;INT;STR;STR;INT;INT;STR" depth ps_d_tag ps_d_tag ps_d_s1 ps_d_s2 ps_d_n1 ps_d_nk "\n"
    ps_dump_kids(r): ps_d_kids 0 depth
]
ps_dump_kids(r): kids idx depth [
    len(ps_kn): kids
    set(r): 0
    if(_): {idx < ps_kn} [
        at(ps_kd): kids idx
        add(ps_d2): depth 1
        ps_dump(_): ps_kd ps_d2
        add(ps_i2): idx 1
        ps_dump_kids(r): kids ps_i2 depth
    ]
]

# ---------- parser stage entry ----------
ps_parse(r): src [
    set(ps_i): 0
    set(ps_stop): 0
    set(ps_err): ""
    struct(nd): "tag:number" "s1:string" "s2:string" "n1:number" "kids:any"
    ps_prog(ps_root): 
    set(r): 0
    if(_): {ps_stop = 1} [
        set(r): 1
    ]
]
# store pair: n=name v=value t=alias-target
rt_find_i(r): nm i [
    len(rt_fl): rt_store
    set(r): {0 - 1}
    if(_): {i < rt_fl} [
        at(rt_fp): rt_store i
        getf(rt_fn): rt_fp "n"
        set(rt_fok): 0
        if(_): {rt_fn = nm} [
            set(rt_fok): 1
        ]
        if(_): {rt_fok = 1} [
            set(r): i
        ]
        if(_): {rt_fok = 0} [
            add(rt_fi2): i 1
            rt_find_i(r): nm rt_fi2
        ]
    ]
]
rt_find(r): nm [
    rt_find_i(r): nm 0
]
rt_write(r): nm val [
    rt_find(rt_wi): nm
    if(_): {rt_wi < 0} [
        new(rt_wp): "rt_sp" nm val ""
        setf(_): rt_wp "n" nm
        setf(_): rt_wp "v" val
        setf(_): rt_wp "t" ""
        push(_): rt_store rt_wp
    ]
    if(_): {rt_wi + 1 > 0} [
        at(rt_wp2): rt_store rt_wi
        getf(rt_wt): rt_wp2 "t"
        if(_): {rt_wt = ""} [
            setf(_): rt_wp2 "v" val
        ]
        set(rt_we): 0
        if(_): {rt_wt = ""} [
            set(rt_we): 1
        ]
        if(_): {rt_we = 0} [
            rt_write(r): rt_wt val
        ]
    ]
    set(r): 0
]
rt_read(r): nm [
    rt_find(rt_ri): nm
    set(r): 0
    if(_): {rt_ri < 0} [
        print(_): "undefined variable"
    ]
    if(_): {rt_ri + 1 > 0} [
        at(rt_rp): rt_store rt_ri
        getf(rt_rt): rt_rp "t"
        if(_): {rt_rt = ""} [
            getf(r): rt_rp "v"
        ]
        set(rt_re): 0
        if(_): {rt_rt = ""} [
            set(rt_re): 1
        ]
        if(_): {rt_re = 0} [
            rt_read(r): rt_rt
        ]
    ]
]

# expression evaluation: node -> value in r
ex_val(r): nd [
    if(_): {ps_stop = 0} [
        getf(rt_ev_t): nd "tag"
        ex_val_t(r): nd rt_ev_t
    ]
]
ex_val_t(r): nd t [
    set(r): 0
    if(_): {ps_stop = 0} [
        if(_): {t = 4} [
            getf(rt_s1): nd "s1"
            rt_read(r): rt_s1
        ]
        if(_): {t = 5} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 6} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 7} [
            getf(r): nd "s1"
        ]
        if(_): {t = 8} [
            getf(rt_b1): nd "s1"
            set(r): {1 = 2}
            if(_): {rt_b1 = "true"} [
                set(r): {1 = 1}
            ]
        ]
        if(_): {t = 9} [
            set(r): null
        ]
        if(_): {t = 10} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 12} [
            ex_bin(r): nd
        ]
        if(_): {t = 13} [
            ex_un(r): nd
        ]
    ]
]
ex_bin(r): nd [
    getf(rt_bo): nd "s1"
    getf(rt_bk): nd "kids"
    at(rt_bl): rt_bk 0
    at(rt_br): rt_bk 1
    ex_bin_a(r): rt_bo rt_bl rt_br
]
ex_bin_a(r): op ln rn [
    ex_val(rt_lx): ln
    ex_bin_b(r): op rt_lx rn
]
ex_bin_b(r): op lv rn [
    ex_val(rt_rx): rn
    ex_bin_do(r): op lv rt_rx
]
ex_bin_do(r): op lv rv [
    set(r): 0
    if(_): {op = "+"} [
        add(r): lv rv
    ]
    if(_): {op = "-"} [
        sub(r): lv rv
    ]
    if(_): {op = "*"} [
        mul(r): lv rv
    ]
    if(_): {op = "/"} [
        div(r): lv rv
    ]
    if(_): {op = "%"} [
        mod(r): lv rv
    ]
    if(_): {op = "=="} [
        set(r): {lv = rv}
    ]
    if(_): {op = "!="} [
        set(r): {lv != rv}
    ]
    if(_): {op = "<"} [
        set(r): {lv < rv}
    ]
    if(_): {op = "<="} [
        set(r): {lv <= rv}
    ]
    if(_): {op = ">"} [
        set(r): {lv > rv}
    ]
    if(_): {op = ">="} [
        set(r): {lv >= rv}
    ]
    if(_): {op = "&&"} [
        set(r): {lv && rv}
    ]
    if(_): {op = "||"} [
        set(r): {lv || rv}
    ]
    if(_): {op = "<<"} [
        set(r): {lv << rv}
    ]
    if(_): {op = ">>"} [
        set(r): {lv >> rv}
    ]
    if(_): {op = "^"} [
        set(r): {lv ^ rv}
    ]
    if(_): {op = "&"} [
        set(r): {lv & rv}
    ]
    if(_): {op = "|"} [
        set(r): {lv | rv}
    ]
