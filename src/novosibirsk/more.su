            set(depth): {depth + 1}
            nsm_copy_props(c): state
            push(_): saved c
            set(i): {i + 1}
            # destinations that are not text: font tables and the like
            nsm_slice(peek): text i 12
            re_test(dest): "^\\\\(\\*|fonttbl|colortbl|stylesheet|info|pict)" peek
            if(_): {dest && skipdepth < 0} [ set(skipdepth): depth ]
        ]
        elif(_): {b = 125} [
            if(_): {depth = skipdepth} [ set(skipdepth): -1 ]
            set(depth): {depth - 1}
            len(ns): saved
            if(_): {ns > 0} [ pop(state): saved ]
            set(i): {i + 1}
        ]
        elif(_): {b = 92} [
            nsm_slice(peek): text i 24
            re_find(cw): "^\\\\([a-z]+)(-?[0-9]+)? ?" peek
            typeof(ct): cw
            if(_): {ct = "vector"} [
                at(whole): cw 0
                at(word): cw 1
                at(arg): cw 2
                len(wl): whole
                set(i): {i + wl}
                if(_): {skipdepth < 0} [
                    if(_): {word = "par" || word = "line"} [
                        nsm_para(p): ""
                        nsm_add(_): r p
                    ]
                    elif(_): {word = "b" || word = "i" || word = "ul" || word = "strike"} [
                        set(key): "bold"
                        if(_): {word = "i"} [ set(key): "italic" ]
                        if(_): {word = "ul"} [ set(key): "underline" ]
                        if(_): {word = "strike"} [ set(key): "strike" ]
                        if(_): {arg = "0"} [ btdel(_): state key ]
                        else(_): [ btput(_): state key true ]
                    ]
                    elif(_): {word = "ulnone"} [ btdel(_): state "underline" ]
                    elif(_): {word = "u"} [
                        str_to_int(cp): arg 10
                        if(_): {cp < 0} [ set(cp): {cp + 65536} ]
                        str_utf8_char(c): cp
                        nsm_rtf_put(_): p c state
                        # the replacement character after \uN
                        if(_): {i < n} [
                            byte(rc): text i
                            if(_): {rc = 63} [ set(i): {i + 1} ]
                        ]
                    ]
                    elif(_): {word = "tab"} [ nsm_rtf_put(_): p "\t" state ]
                ]
            ]
            else(_): [
                # \\ \{ \} and \'hh
                nsm_slice(two): text {i + 1} 1
                if(_): {two = "'"} [
                    nsm_slice(hx): text {i + 2} 2
                    str_to_int(code): hx 16
                    chr(c): code
                    if(_): {skipdepth < 0} [ nsm_rtf_put(_): p c state ]
                    set(i): {i + 4}
                ]
                else(_): [
                    if(_): {skipdepth < 0 && (two = "\\" || two = "{" || two = "}")} [ nsm_rtf_put(_): p two state ]
                    set(i): {i + 2}
                ]
            ]
        ]
        elif(_): {b = 10 || b = 13} [ set(i): {i + 1} ]
        else(_): [
            slice(c): text i 1
            if(_): {skipdepth < 0} [ nsm_rtf_put(_): p c state ]
            set(i): {i + 1}
        ]
    ]
    # the last paragraph is empty after a final \par
    btget(paras): r "paras"
    len(np): paras
    if(_): {np > 1} [
        at(last): paras {np - 1}
        btget(lt): last "text"
        if(_): {lt = ""} [ pop(_): paras ]
    ]
]

nsm_copy_props(r): pr [
    btree(r):
    btkeys(ks): pr
    len(n): ks
    set(i): 0
    while(_): {i < n} [
        at(k): ks i
        btget(v): pr k
        btput(_): r k v
        set(i): {i + 1}
    ]
]

nsm_rtf_put(r): p c state [
    vec(stack): ""
    nsm_copy_props(c2): state
    push(_): stack c2
    nsm_append(r): p c stack ""
]

# --- find and replace

# [[paragraph start end]...]; regex: pattern is a regular expression
nsm_find(r): d pattern regex case [
    vec(r): ""
    btget(paras): d "paras"
    len(n): paras
    set(pat): pattern
    if(_): {regex = false} [ re_escape_tl(pat): pattern ]
    set(flags): ""
    if(_): {case = false} [ set(flags): "i" ]
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        btget(t): p "text"
        set(from): 0
        len(tl): t
        set(go): true
        while(_): {go && from <= tl} [
            re_pos(m): pat t from flags
            typeof(mt): m
            if(_): {mt != "vector"} [ set(go): false ]
            else(_): [
                at(a): m 0
                at(b): m 1
                vec(e): ""
                push(_): e i
                push(_): e a
                push(_): e b
                push(_): r e
                set(from): b
                if(_): {b = a} [ set(from): {b + 1} ]
            ]
        ]
        set(i): {i + 1}
    ]
]

re_escape_tl(r): s [
    re_replace(r): "([\\\\.^$|?*+()\\[\\]{}])" s "\\\\\\1"
]

nsm_replace(r): d find repl regex case [
    set(r): 0
    btget(paras): d "paras"
    set(pat): find
    if(_): {regex = false} [ re_escape_tl(pat): find ]
    set(flags): ""
    if(_): {case = false} [ set(flags): "i" ]
    len(n): paras
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        btget(t): p "text"
        re_all(hits): pat t flags
        typeof(ht): hits
        if(_): {ht = "vector"} [
            len(k): hits
            if(_): {k > 0} [
                set(rp): repl
                if(_): {regex = false} [ str_replace(rp): repl "\\" "\\\\" ]
                re_replace(t2): pat t rp flags
                btput(_): p "text" t2
                # the text moved: its spans go
                vec(none): ""
                btput(_): p "spans" none
                set(r): {r + k}
            ]
        ]
        set(i): {i + 1}
    ]
]

# --- statistics

nsm_stats(r): d [
    btree(r):
    btget(paras): d "paras"
    set(words): 0
    set(chars): 0
    set(nospace): 0
    set(sentences): 0
    btree(counts):
    len(n): paras
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        btget(t): p "text"
        utf8_count(c): t
        set(chars): {chars + c}
        re_replace(ns): "\\s" t ""
        utf8_count(c2): ns
        set(nospace): {nospace + c2}
        re_all(ws): "[^\\s.,;:!?()«»\"“”—–-]+" t
        typeof(wt): ws
        if(_): {wt = "vector"} [
            len(nw): ws
            set(words): {words + nw}
            set(k): 0
            while(_): {k < nw} [
                at(w): ws k
                str_lower(lw): w
                utf8_count(wl): lw
                if(_): {wl > 3} [
                    btget(c): counts lw 0
                    btput(_): counts lw {c + 1}
                ]
                set(k): {k + 1}
            ]
        ]
        re_all(ss): "[.!?…]+(\\s|$)" t
        typeof(st): ss
        set(ns_): 0
        if(_): {st = "vector"} [ len(ns_): ss ]
        str_trim(tt): t
        if(_): {ns_ = 0 && tt != ""} [ set(ns_): 1 ]
        set(sentences): {sentences + ns_}
        set(i): {i + 1}
    ]
    btput(_): r "words" words
    btput(_): r "chars" chars
    btput(_): r "chars_no_spaces" nospace
    btput(_): r "paragraphs" n
    btput(_): r "sentences" sentences
    set(avg): 0
    if(_): {sentences > 0} [ set(avg): {words / (sentences * 1.0)} ]
    btput(_): r "words_per_sentence" avg
    set(mins): {words / 200.0}
    btput(_): r "reading_minutes" mins
    # words used three times or more, most first
    vec(rep): ""
    btkeys(ks): counts
    btree(ord):
    len(nk): ks
    set(k): 0
    while(_): {k < nk} [
        at(w): ks k
        btget(c): counts w
        if(_): {c >= 3} [
            str_from_int(cs): {100000 - c}
            str_pad_left(cs): cs 6 "0"
            concat(key): cs " " w
            btput(_): ord key w
        ]
        set(k): {k + 1}
    ]
    btkeys(ok): ord
    len(no): ok
    set(k): 0
    while(_): {k < no && k < 10} [
        at(key): ok k
        btget(w): ord key
        btget(c): counts w
        vec(e): ""
        push(_): e w
        push(_): e c
        push(_): rep e
        set(k): {k + 1}
    ]
    btput(_): r "repeated" rep
]

nsm_stats_line(r): d [
    nsm_stats(s): d
    btget(w): s "words"
    btget(c): s "chars"
    str_from_int(ws): w
    str_from_int(cs): c
    concat(r): ws " words, " cs " characters"
]

# --- typing aids

# straight quotes, -- and ... as typographers set them
nsm_autocorrect(r): text style [
    set(open): "“"
    set(close): "”"
    if(_): {style = "ru"} [
        set(open): "«"
        set(close): "»"
    ]
    re_replace(r): "(^|[\\s(\\[{])\"" text "\\1OPENQ"
    str_replace(r): r "\"" close
    str_replace(r): r "OPENQ" open
    re_replace(r): "(^|[\\s(\\[{])'" r "\\1‘"
    str_replace(r): r "'" "’"
    str_replace(r): r "---" "—"
    str_replace(r): r "--" "—"
    str_replace(r): r " - " " – "
    str_replace(r): r "..." "…"
    str_replace(r): r "(c)" "©"
    str_replace(r): r "(tm)" "™"
    str_replace(r): r "<<" "«"
    str_replace(r): r ">>" "»"
]

nsm_specials(r): [
    str_split(r): "« » „ “ ” ‘ ’ — – … № § © ® ™ ° ± × ÷ ≈ ≠ ≤ ≥ € ₽ £ ¥ • ‰ ¼ ½ ¾ ² ³ → ← ↑ ↓" " "
]

# word movement: the byte column of the next or previous word start
nsm_word_right(r): text col [
    len(n): text
    set(r): col
    # past the rest of this word, then the spaces
    while(_): {r < n} [
        byte(b): text r
        if(_): {b = 32 || b = 9} [
            while(_): {r < n} [
                byte(b2): text r
                if(_): {b2 != 32 && b2 != 9} [ return(r): r ]
                set(r): {r + 1}
            ]
            return(r): r
        ]
        set(r): {r + 1}
    ]
]

nsm_word_left(r): text col [
    set(r): col
    while(_): {r > 0} [
        byte(b): text {r - 1}
        if(_): {b = 32 || b = 9} [ set(r): {r - 1} ]
        else(_): [
            while(_): {r > 0} [
                byte(b2): text {r - 1}
                if(_): {b2 = 32 || b2 = 9} [ return(r): r ]
                set(r): {r - 1}
            ]
            return(r): r
        ]
    ]
]

# smart Home: to the first non-blank, and from there to the line's start
nsm_smart_home(r): text col [
    set(first): 0
    len(n): text
    while(_): {first < n} [
        byte(b): text first
        if(_): {b != 32 && b != 9} [ set(n): first ]
        else(_): [ set(first): {first + 1} ]
    ]
    set(r): first
    if(_): {col = first} [ set(r): 0 ]
]

# --- structure: contents, outline, sections

# headings: [[paragraph level text]...]
nsm_toc(r): d [
    vec(r): ""
    btget(paras): d "paras"
    len(n): paras
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        btget(lv): p "level"
        if(_): {lv > 0} [
            btget(t): p "text"
            vec(e): ""
            push(_): e i
            push(_): e lv
            push(_): e t
            push(_): r e
        ]
        set(i): {i + 1}
    ]
]

# the contents as text lines with dot leaders to a page (one page each
# 40 paragraphs), width wide
nsm_toc_text(r): d width [
    set(r): ""
    nsm_toc(t): d
    len(n): t
    set(i): 0
    while(_): {i < n} [
        at(e): t i
        at(pi): e 0
        at(lv): e 1
        at(tx): e 2
        str_repeat(ind): "  " {lv - 1}
        concat(left): ind tx
        set(page): {pi / 40 + 1}
        str_trunc(page): page
        str_from_int(ps): page
        utf8_count(ll): left
        len(pl): ps
        set(dots): {width - ll - pl - 2}
        if(_): {dots < 3} [ set(dots): 3 ]
        str_repeat(leader): "." dots
        concat(r): r left " " leader " " ps "\n"
        set(i): {i + 1}
    ]
]

# a heading's section: from it to the next heading of its level or higher
nsm_section(r): d pi [
    btget(paras): d "paras"
    len(n): paras
    at(p): paras pi
    btget(lv): p "level"
    set(r): {pi + 1}
    while(_): {r < n} [
        at(q): paras r
        btget(ql): q "level"
        if(_): {ql > 0 && ql <= lv} [ return(r): r ]
        set(r): {r + 1}
    ]
]

nsm_outline(r): d [
    nsm_toc(r): d
]

# moves heading pi's section before the previous section of its level
# (dir -1) or after the next (dir 1); its new paragraph index
nsm_move_section(r): d pi dir [
    btget(paras): d "paras"
    nsm_section(end): d pi
    at(p): paras pi
    btget(lv): p "level"
    set(r): pi
    if(_): {dir < 0} [
        # the previous heading of the same level
        set(k): {pi - 1}
        set(prev): -1
        while(_): {k >= 0} [
            at(q): paras k
            btget(ql): q "level"
            if(_): {ql > 0 && ql < lv} [ set(k): -1 ]
            elif(_): {ql = lv} [
                set(prev): k
                set(k): -1
            ]
            set(k): {k - 1}
        ]
        if(_): {prev < 0} [ return(r): r ]
        nsm_rotate(_): d prev pi end
        set(r): prev
    ]
    else(_): [
        len(n): paras
        if(_): {end >= n} [ return(r): r ]
        at(q): paras end
        btget(ql): q "level"
        if(_): {ql != lv} [ return(r): r ]
        nsm_section(end2): d end
        nsm_rotate(_): d pi end end2
        set(r): {pi + end2 - end}
    ]
]

# paragraphs [a, m) and [m, e) swapped
nsm_rotate(r): d a m e [
    btget(paras): d "paras"
    vec(out): ""
    len(n): paras
    set(i): 0
    while(_): {i < a} [
        at(x): paras i
        push(_): out x
        set(i): {i + 1}
    ]
    set(i): m
    while(_): {i < e} [
        at(x): paras i
        push(_): out x
        set(i): {i + 1}
    ]
    set(i): a
    while(_): {i < m} [
        at(x): paras i
        push(_): out x
        set(i): {i + 1}
    ]
    set(i): e
    while(_): {i < n} [
        at(x): paras i
        push(_): out x
        set(i): {i + 1}
    ]
    btput(_): d "paras" out
    set(r): 0
]

# --- comparing documents: [[op text]...] op " " same, "-" only in a,
# "+" only in b
nsm_compare(r): a b [
    btget(pa): a "paras"
    btget(pb): b "paras"
    vec(ta): ""
    vec(tb): ""
    len(n): pa
    set(i): 0
    while(_): {i < n} [
        at(p): pa i
        btget(t): p "text"
        push(_): ta t
        set(i): {i + 1}
    ]
    len(m): pb
    set(i): 0
    while(_): {i < m} [
        at(p): pb i
        btget(t): p "text"
        push(_): tb t
        set(i): {i + 1}
    ]
    vec(tab): ""
    set(sz): {(n + 1) * (m + 1)}
    set(i): 0
    while(_): {i < sz} [
        push(_): tab 0
        set(i): {i + 1}
    ]
    set(i): {n - 1}
    while(_): {i >= 0} [
        set(j): {m - 1}
        while(_): {j >= 0} [
            at(x): ta i
            at(y): tb j
            if(_): {x = y} [
                at(v): tab {(i + 1) * (m + 1) + j + 1}
                set(tab): {i * (m + 1) + j} {v + 1}
            ]
            else(_): [
                at(v1): tab {(i + 1) * (m + 1) + j}
                at(v2): tab {i * (m + 1) + j + 1}
                set(mx): v1
                if(_): {v2 > v1} [ set(mx): v2 ]
                set(tab): {i * (m + 1) + j} mx
            ]
            set(j): {j - 1}
        ]
        set(i): {i - 1}
    ]
    vec(r): ""
    set(i): 0
    set(j): 0
    while(_): {i < n || j < m} [
        vec(e): ""
        set(same): false
        if(_): {i < n && j < m} [
            at(x): ta i
            at(y): tb j
            set(same): {x = y}
        ]
        if(_): same [
            push(_): e " "
            at(x): ta i
            push(_): e x
            set(i): {i + 1}
            set(j): {j + 1}
        ]
        else(_): [
            set(down): 0
            set(right): 0
            if(_): {i < n} [ at(down): tab {(i + 1) * (m + 1) + j} ]
            if(_): {j < m} [ at(right): tab {i * (m + 1) + j + 1} ]
            if(_): {j >= m || (i < n && down >= right)} [
                push(_): e "-"
                at(x): ta i
                push(_): e x
                set(i): {i + 1}
            ]
            else(_): [
                push(_): e "+"
                at(y): tb j
                push(_): e y
                set(j): {j + 1}
            ]
        ]
        push(_): r e
    ]
]

# --- templates and fields

nsm_template(r): name [
    nsm_new(r):
    vec(lines): ""
    if(_): {name = "letter"} [
        str_split(lines): "R|{author}|{date}|P|Dear ...,|P||P|Yours sincerely,|P|{author}" "|"
    ]
    elif(_): {name = "report"} [
        str_split(lines): "1|{title}|P|{author}, {date}|1|Summary|P||1|Introduction|P||1|Results|P||1|Conclusions|P|" "|"
    ]
    elif(_): {name = "notes"} [
        str_split(lines): "2|Notes, {date}|B|...|B|...|B|..." "|"
    ]
    else(_): [
        set(r): null
        return(r): r
    ]
    len(n): lines
    set(i): 0
    while(_): {i + 1 < n} [
        at(kind): lines i
        at(t): lines {i + 1}
        nsm_para(p): t
        if(_): {kind = "1" || kind = "2"} [
            str_to_int(lv): kind 10
            btput(_): p "level" lv
        ]
        if(_): {kind = "R"} [ btput(_): p "align" "right" ]
        if(_): {kind = "B"} [ btput(_): p "list" "bullet" ]
        nsm_add(_): r p
        set(i): {i + 2}
    ]
]

# {date} {title} {author} {file} {paragraphs} {words} in text
nsm_fields(r): d text path [
    set(r): text
    time(t):
    localtime(lt): t
    at(y): lt 0
    at(mo): lt 1
    at(dd): lt 2
    str_from_int(ys): y
    str_from_int(ms): mo
    str_pad_left(ms): ms 2 "0"
    str_from_int(ds): dd
    str_pad_left(ds): ds 2 "0"
    concat(date): ys "-" ms "-" ds
    btget(meta): d "meta"
    btget(title): meta "title" ""
    btget(author): meta "author" ""
    nsm_stats(st): d
    btget(w): st "words"
    btget(np): st "paragraphs"
    str_from_int(ws): w
    str_from_int(nps): np
    str_replace(r): r "{date}" date
    str_replace(r): r "{title}" title
    str_replace(r): r "{author}" author
    str_replace(r): r "{file}" path
    str_replace(r): r "{words}" ws
    str_replace(r): r "{paragraphs}" nps
]

nsm_fill_fields(r): d path [
    set(r): 0
    btget(paras): d "paras"
    len(n): paras
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        btget(t): p "text"
        str_contains(has): t "{"
        if(_): has [
            nsm_fields(t2): d t path
            if(_): {t2 != t} [
                btput(_): p "text" t2
                vec(none): ""
                btput(_): p "spans" none
                set(r): {r + 1}
            ]
        ]
        set(i): {i + 1}
    ]
]

# --- undo for the pad: snapshots of the paragraph texts

nsm_snapshot(r): [
    set(paras): sb_paras?
    vec(r): ""
    len(n): paras
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        getf(t): p "text"
        push(_): r t
        set(i): {i + 1}
    ]
    set(row): sb_prow?
    set(col): sb_pcol?
    vec(c): ""
    push(_): c row
    push(_): c col
    push(_): r c
]

nsm_restore(r): snap [
    vec(paras): "SbPara"
    len(n): snap
    set(i): 0
    while(_): {i < n - 1} [
        at(t): snap i
        new(p): "SbPara" t
        push(_): paras p
        set(i): {i + 1}
    ]
    set(sb_paras): paras!
    at(c): snap {n - 1}
    at(row): c 0
    at(col): c 1
    set(sb_prow): row!
    set(sb_pcol): col!
    set(r): 0
]

# before a change: kind groups typing into one step ("type", "delete" or
# "" for a step of its own)
nsm_push_undo(r): kind [
    set(r): 0
    set(last): sb_undo_kind?
    set(sb_undo_kind): kind!
    if(_): {kind != "" && kind = last} [ return(r): r ]
    nsm_snapshot(s):
    set(u): sb_pundo?
    push(_): u s
    len(n): u
    if(_): {n > 200} [
        vec(keep): ""
        set(i): {n - 200}
        while(_): {i < n} [
            at(x): u i
            push(_): keep x
            set(i): {i + 1}
        ]
        set(u): keep
    ]
    set(sb_pundo): u!
    vec(none): ""
    set(sb_predo): none!
]

nsm_undo(r): [
    set(u): sb_pundo?
    len(n): u
    set(r): false
    if(_): {n = 0} [ return(r): r ]
    nsm_snapshot(now):
    set(rd): sb_predo?
    push(_): rd now
    set(sb_predo): rd!
    pop(s): u
    set(sb_pundo): u!
    nsm_restore(_): s
    set(sb_undo_kind): ""!
    set(r): true
]

nsm_redo(r): [
    set(rd): sb_predo?
    len(n): rd
    set(r): false
    if(_): {n = 0} [ return(r): r ]
    nsm_snapshot(now):
    set(u): sb_pundo?
    push(_): u now
    set(sb_pundo): u!
    pop(s): rd
    set(sb_predo): rd!
    nsm_restore(_): s
    set(sb_undo_kind): ""!
    set(r): true
]

nsm_state(r): [
    vec(u): ""
    set(sb_pundo): u!
    vec(rd): ""
    set(sb_predo): rd!
    set(sb_undo_kind): ""!
    set(sb_autocorrect): "en"!
    set(r): 0
]

# --- the command line: --convert in out

nsm_read_doc(r): path [
    set(r): null
    sb_read(text): path
    if(_): {text = null} [ return(r): r ]
    sb_extension(ext): path
    if(_): {ext = ".fodt"} [ nsm_from_fodt(r): text ]
    elif(_): {ext = ".md"} [ nsm_from_markdown(r): text ]
    elif(_): {ext = ".html" || ext = ".htm"} [ nsm_from_html(r): text ]
    elif(_): {ext = ".rtf"} [ nsm_from_rtf(r): text ]
    else(_): [
        sbpadreset(_):
        sbpadsettext(_): text
        nsm_from_pad(r):
    ]
]

nsm_doc_text(r): d path [
    sb_extension(ext): path
    if(_): {ext = ".fodt"} [ nsm_fodt(r): d ]
    elif(_): {ext = ".md"} [ nsm_markdown(r): d ]
    elif(_): {ext = ".html" || ext = ".htm"} [ nsm_html(r): d ]
    elif(_): {ext = ".rtf"} [ nsm_rtf(r): d ]
    else(_): [ nsm_text(r): d false ]
]

# 0 when it converted, 1 when it could not, -1 when the arguments are not
# a conversion
nsm_cli(r): args [
    set(r): -1
    len(n): args
    if(_): {n < 1} [ return(r): r ]
    at(a0): args 0
    if(_): {a0 != "--convert" && a0 != "--stats"} [ return(r): r ]
    set(r): 2
    if(_): {(a0 = "--convert" && n != 3) || (a0 = "--stats" && n != 2)} [
        print(_): "usage: ussr novosibirsk.su --convert IN OUT   (.fodt .txt .md .html .rtf)"
        print(_): "       ussr novosibirsk.su --stats FILE"
        return(r): r
    ]
    at(src): args 1
    nsm_read_doc(d): src
    set(r): 1
    if(_): {d = null} [
        concat(m): "novosibirsk: cannot read " src
        print(_): m
        return(r): r
    ]
    if(_): {a0 = "--stats"} [
        nsm_stats(s): d
        btget(w): s "words"
        btget(c): s "chars"
        btget(se): s "sentences"
        btget(rm): s "reading_minutes"
        str_from_int(ws): w
        str_from_int(cs): c
        str_from_int(ss): se
        str_from_number(rms): rm 1
        concat(m): ws " words, " cs " characters, " ss " sentences, " rms " minutes to read"
        print(_): m
        set(r): 0
        return(r): r
    ]
    at(dst): args 2
    nsm_doc_text(t): d dst
    sb_write(_): dst t
    set(r): 0
    concat(m): "novosibirsk: wrote " dst
    print(_): m
]

nsm_convert(r): src dst [
    vec(a): ""
    push(_): a "--convert"
    push(_): a src
    push(_): a dst
    nsm_cli(r): a
]

# a slice that stops at the end of the text
nsm_slice(r): s from count [
    len(n): s
    set(r): ""
    if(_): {from >= n} [ return(r): r ]
    if(_): {from + count > n} [ set(count): {n - from} ]
    slice(r): s from count
]
