# more.su - Novosibirsk refine pass 1: a richer document beside the pad's
# plain paragraphs, with no window (tests/novosibirsk_more_test.su).
#
# A document (nsm_doc) is a btree: "paras", a vector of paragraph btrees
# (text, level 0 or a heading 1..6, list "", "bullet" or "number" with
# depth, align left|center|right|justify, indent, first, before, after,
# spacing (%), pagebreak, style, and spans [[start end props]...] over byte
# offsets with props bold italic underline strike sub sup color background
# size font href note), and "meta" (title author keywords).
#
#   nsm_new(d): / nsm_para(p): text / nsm_from_pad(d): / nsm_to_pad(_): d
#   nsm_format(_): d pi start end key value     character formatting
#   nsm_fodt(s): d / nsm_from_fodt(d): text      flat ODF with styles
#   nsm_html(s): d / nsm_markdown(s): d / nsm_text(s): d numbers
#   nsm_rtf(s): d / nsm_from_markdown(d): text / nsm_from_html(d): text
#   nsm_from_rtf(d): text
#   nsm_find(v): d pattern regex case / nsm_replace(n): d find repl regex case
#   nsm_stats(b): d   words chars sentences reading time, repeated words
#   nsm_autocorrect(s): text style ("ru": «» quotes, "en": “” quotes)
#   nsm_specials(v):   nsm_toc(v): d   nsm_toc_text(s): d width
#   nsm_outline(v): d   nsm_move_section(_): d heading dir
#   nsm_compare(v): a b   nsm_template(d): name   nsm_fields(s): d text path
#   nsm_word_left(n) / nsm_word_right(n): text col    nsm_smart_home(n): text col
#   nsm_convert(r): in out        (.fodt .txt .html .md .rtf)
$once
$include "../libs/lists.su"

# --- the document

nsm_new(r): [
    btree(r):
    vec(paras): ""
    btput(_): r "paras" paras
    btree(meta):
    btput(_): meta "title" ""
    btput(_): meta "author" ""
    btput(_): meta "keywords" ""
    btput(_): r "meta" meta
]

nsm_para(r): text [
    btree(r):
    btput(_): r "text" text
    btput(_): r "level" 0
    btput(_): r "list" ""
    btput(_): r "depth" 1
    btput(_): r "align" "left"
    btput(_): r "indent" 0
    btput(_): r "first" 0
    btput(_): r "before" 0
    btput(_): r "after" 0
    btput(_): r "spacing" 100
    btput(_): r "pagebreak" false
    btput(_): r "style" ""
    vec(spans): ""
    btput(_): r "spans" spans
]

nsm_add(r): d p [
    btget(paras): d "paras"
    push(_): paras p
    len(r): paras
    set(r): {r - 1}
]

nsm_paras(r): d [
    btget(r): d "paras"
]

nsm_get(r): d i [
    btget(paras): d "paras"
    at(r): paras i
]

nsm_from_pad(r): [
    nsm_new(r):
    set(paras): sb_paras?
    len(n): paras
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        getf(t): p "text"
        nsm_para(np): t
        nsm_add(_): r np
        set(i): {i + 1}
    ]
]

nsm_to_pad(r): d [
    btget(ps): d "paras"
    vec(paras): "SbPara"
    len(n): ps
    set(i): 0
    while(_): {i < n} [
        at(p): ps i
        btget(t): p "text"
        new(sp): "SbPara" t
        push(_): paras sp
        set(i): {i + 1}
    ]
    if(_): {n = 0} [
        new(sp): "SbPara" ""
        push(_): paras sp
    ]
    set(sb_paras): paras!
    set(sb_prow): 0!
    set(sb_pcol): 0!
    set(r): n
]

# a property over bytes start..end of paragraph pi: spans split and merged
nsm_format(r): d pi start end key value [
    nsm_get(p): d pi
    btget(spans): p "spans"
    btget(t): p "text"
    len(tl): t
    if(_): {end > tl} [ set(end): tl ]
    vec(out): ""
    len(n): spans
    set(i): 0
    while(_): {i < n} [
        at(s): spans i
        at(a): s 0
        at(b): s 1
        at(props): s 2
        # the parts outside [start, end) keep their props
        if(_): {b <= start || a >= end} [ push(_): out s ]
        else(_): [
            if(_): {a < start} [
                nsm_span(left): a start props
                push(_): out left
            ]
            nsm_span_copy(mid): {a < start} start a {b > end} end b props
            push(_): out mid
            if(_): {b > end} [
                nsm_span(right): end b props
                push(_): out right
            ]
        ]
        set(i): {i + 1}
    ]
    # bytes in [start, end) with no span yet get one
    btree(covered):
    len(no): out
    set(i): 0
    while(_): {i < no} [
        at(s): out i
        at(a): s 0
        at(b): s 1
        if(_): {b > start && a < end} [ btput(_): covered a b ]
        set(i): {i + 1}
    ]
    set(pos): start
    btkeys(ks): covered
    len(nk): ks
    set(k): 0
    while(_): {k <= nk} [
        set(next): end
        set(after): end
        if(_): {k < nk} [
            at(next): ks k
            btget(after): covered next
        ]
        if(_): {next > pos} [
            btree(pr):
            nsm_span(gap): pos next pr
            push(_): out gap
        ]
        if(_): {after > pos} [ set(pos): after ]
        set(k): {k + 1}
    ]
    # the property everywhere in [start, end)
    len(no): out
    set(i): 0
    while(_): {i < no} [
        at(s): out i
        at(a): s 0
        at(b): s 1
        at(props): s 2
        if(_): {a >= start && b <= end} [
            if(_): {value = false || value = null} [ btdel(_): props key ]
            else(_): [ btput(_): props key value ]
        ]
        set(i): {i + 1}
    ]
    nsm_spans_tidy(clean): out
    btput(_): p "spans" clean
    len(r): clean
]

nsm_span(r): a b props [
    vec(r): ""
    push(_): r a
    push(_): r b
    push(_): r props
]

# the part of a span inside [start, end), with a copy of its props
nsm_span_copy(r): cutl start a cutr end b props [
    set(x): a
    if(_): cutl [ set(x): start ]
    set(y): b
    if(_): cutr [ set(y): end ]
    btree(c):
    btkeys(ks): props
    len(n): ks
    set(i): 0
    while(_): {i < n} [
        at(k): ks i
        btget(v): props k
        btput(_): c k v
        set(i): {i + 1}
    ]
    nsm_span(r): x y c
]

# sorted, empty ones and plain ones gone, neighbours with the same props
# joined
nsm_spans_tidy(r): spans [
    btree(ord):
    len(n): spans
    set(i): 0
    while(_): {i < n} [
        at(s): spans i
        at(a): s 0
        at(b): s 1
        at(pr): s 2
        btlen(np): pr
        if(_): {b > a && np > 0} [ btput(_): ord {a * 1000000 + i} s ]
        set(i): {i + 1}
    ]
    vec(r): ""
    btkeys(ks): ord
    len(nk): ks
    set(i): 0
    while(_): {i < nk} [
        at(k): ks i
        btget(s): ord k
        len(nr): r
        set(joined): false
        if(_): {nr > 0} [
            at(last): r {nr - 1}
            at(lb): last 1
            at(lp): last 2
            at(sa): s 0
            at(sp): s 2
            encode(e1): lp
            encode(e2): sp
            if(_): {lb = sa && e1 = e2} [
                at(sb): s 1
                set(last): 1 sb
                set(joined): true
            ]
        ]
        if(_): {joined = false} [ push(_): r s ]
        set(i): {i + 1}
    ]
]

# the pieces of a paragraph's text with their props: [[text props]...]
nsm_pieces(r): p [
    vec(r): ""
    btget(t): p "text"
    btget(spans): p "spans"
    len(tl): t
    set(pos): 0
    len(n): spans
    set(i): 0
    while(_): {i < n} [
        at(s): spans i
        at(a): s 0
        at(b): s 1
        at(pr): s 2
        if(_): {a > pos} [
            slice(x): t pos {a - pos}
            btree(none):
            vec(e): ""
            push(_): e x
            push(_): e none
            push(_): r e
        ]
        if(_): {b > tl} [ set(b): tl ]
        slice(x): t a {b - a}
        vec(e): ""
        push(_): e x
        push(_): e pr
        push(_): r e
        set(pos): b
        set(i): {i + 1}
    ]
    if(_): {pos < tl} [
        slice(x): t pos {tl - pos}
        btree(none):
        vec(e): ""
        push(_): e x
        push(_): e none
        push(_): r e
    ]
]

# --- flat ODF text with automatic styles

nsm_prop(r): pr key default [
    btget(r): pr key default
]

# the fo: attributes of character props
nsm_text_props(r): pr [
    set(r): ""
    nsm_prop(b): pr "bold" false
    nsm_prop(it): pr "italic" false
    nsm_prop(u): pr "underline" false
    nsm_prop(s): pr "strike" false
    nsm_prop(sub): pr "sub" false
    nsm_prop(sup): pr "sup" false
    nsm_prop(color): pr "color" ""
    nsm_prop(bg): pr "background" ""
    nsm_prop(size): pr "size" 0
    nsm_prop(font): pr "font" ""
    if(_): b [ concat(r): r " fo:font-weight=\"bold\"" ]
    if(_): it [ concat(r): r " fo:font-style=\"italic\"" ]
    if(_): u [ concat(r): r " style:text-underline-style=\"solid\" style:text-underline-width=\"auto\" style:text-underline-color=\"font-color\"" ]
    if(_): s [ concat(r): r " style:text-line-through-style=\"solid\"" ]
    if(_): sub [ concat(r): r " style:text-position=\"sub 58%\"" ]
    if(_): sup [ concat(r): r " style:text-position=\"super 58%\"" ]
    if(_): {color != ""} [ concat(r): r " fo:color=\"" color "\"" ]
    if(_): {bg != ""} [ concat(r): r " fo:background-color=\"" bg "\"" ]
    if(_): {size > 0} [
        str_from_number(ss): size 1
        str_ends(z): ss ".0"
        if(_): z [
            len(sl): ss
            slice(ss): ss 0 {sl - 2}
        ]
        concat(r): r " fo:font-size=\"" ss "pt\""
    ]
    if(_): {font != ""} [
        sb_xml_escape(fe): font
        concat(r): r " style:font-name=\"" fe "\""
    ]
]

nsm_para_props(r): p [
    set(r): ""
    btget(align): p "align"
    if(_): {align != "left"} [
        set(a): align
        if(_): {align = "right"} [ set(a): "end" ]
        concat(r): r " fo:text-align=\"" a "\""
    ]
    vec(keys): ""
    str_split(keys): "indent:fo:margin-left first:fo:text-indent before:fo:margin-top after:fo:margin-bottom" " "
    set(i): 0
    while(_): {i < 4} [
        at(kv): keys i
        str_find(c): kv ":" 0
        slice(k): kv 0 c
        len(kl): kv
        slice(attr): kv {c + 1} {kl - c - 1}
        btget(v): p k
        if(_): {v != 0} [
            str_from_number(vs): v 2
            concat(r): r " " attr "=\"" vs "mm\""
        ]
        set(i): {i + 1}
    ]
    btget(sp): p "spacing"
    if(_): {sp != 100} [
        str_from_int(ss): sp
        concat(r): r " fo:line-height=\"" ss "%\""
    ]
    btget(pb): p "pagebreak"
    if(_): pb [ concat(r): r " fo:break-before=\"page\"" ]
]

nsm_fodt(r): d [
    # automatic styles, one per distinct set of props
    btree(tstyles):
    btree(pstyles):
    btget(paras): d "paras"
    len(n): paras
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        nsm_para_props(pp): p
        if(_): {pp != ""} [
            btget(have): pstyles pp null
            if(_): {have = null} [
                btlen(k): pstyles
                str_from_int(ks): {k + 1}
                concat(nm): "P" ks
                btput(_): pstyles pp nm
            ]
        ]
        btget(spans): p "spans"
        len(ns): spans
        set(j): 0
        while(_): {j < ns} [
            at(s): spans j
            at(pr): s 2
            nsm_text_props(tp): pr
            if(_): {tp != ""} [
                btget(have): tstyles tp null
                if(_): {have = null} [
                    btlen(k): tstyles
                    str_from_int(ks): {k + 1}
                    concat(nm): "T" ks
                    btput(_): tstyles tp nm
                ]
            ]
            set(j): {j + 1}
        ]
        set(i): {i + 1}
    ]
    btget(meta): d "meta"
    concat(r): SB_ODF_HEAD "xmlns:dc=\"http://purl.org/dc/elements/1.1/\" xmlns:meta=\"urn:oasis:names:tc:opendocument:xmlns:meta:1.0\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" office:mimetype=\"application/vnd.oasis.opendocument.text\">\n"
    btget(title): meta "title" ""
    btget(author): meta "author" ""
    btget(kw): meta "keywords" ""
    if(_): {title != "" || author != "" || kw != ""} [
        concat(r): r "<office:meta>\n"
        sb_xml_escape(x): title
        if(_): {title != ""} [ concat(r): r "<dc:title>" x "</dc:title>\n" ]
        sb_xml_escape(x): author
        if(_): {author != ""} [ concat(r): r "<dc:creator>" x "</dc:creator>\n" ]
        sb_xml_escape(x): kw
        if(_): {kw != ""} [ concat(r): r "<meta:keyword>" x "</meta:keyword>\n" ]
        concat(r): r "</office:meta>\n"
    ]
    concat(r): r "<office:automatic-styles>\n"
    btkeys(pk): pstyles
    len(npk): pk
    set(i): 0
    while(_): {i < npk} [
        at(props): pk i
        btget(nm): pstyles props
        concat(r): r "<style:style style:name=\"" nm "\" style:family=\"paragraph\"><style:paragraph-properties" props "/></style:style>\n"
        set(i): {i + 1}
    ]
    btkeys(tk): tstyles
    len(ntk): tk
    set(i): 0
    while(_): {i < ntk} [
        at(props): tk i
        btget(nm): tstyles props
        concat(r): r "<style:style style:name=\"" nm "\" style:family=\"text\"><style:text-properties" props "/></style:style>\n"
        set(i): {i + 1}
    ]
    concat(r): r "</office:automatic-styles>\n<office:body>\n<office:text>\n"
    set(inlist): ""
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        btget(lst): p "list"
        if(_): {lst != inlist && inlist != ""} [ concat(r): r "</text:list>\n" ]
        if(_): {lst != inlist && lst != ""} [
            set(ls): "Bullet"
            if(_): {lst = "number"} [ set(ls): "Numbering_20_123" ]
            concat(r): r "<text:list text:style-name=\"" ls "\">\n"
        ]
        set(inlist): lst
        nsm_para_props(pp): p
        set(sn): ""
        if(_): {pp != ""} [
            btget(nm): pstyles pp
            concat(sn): " text:style-name=\"" nm "\""
        ]
        btget(level): p "level"
        set(tag): "text:p"
        set(extra): ""
        if(_): {level > 0} [
            set(tag): "text:h"
            str_from_int(ls): level
            concat(extra): " text:outline-level=\"" ls "\""
            if(_): {sn = ""} [ concat(sn): " text:style-name=\"Heading_20_" ls "\"" ]
        ]
        set(body): ""
        nsm_pieces(pieces): p
        len(np): pieces
        set(j): 0
        while(_): {j < np} [
            at(pc): pieces j
            at(x): pc 0
            at(pr): pc 1
            sb_odf_text(xt): x
            nsm_text_props(tp): pr
            btget(href): pr "href" ""
            btget(note): pr "note" ""
            set(piece): xt
            if(_): {tp != ""} [
                btget(nm): tstyles tp
                concat(piece): "<text:span text:style-name=\"" nm "\">" xt "</text:span>"
            ]
            if(_): {href != ""} [
                sb_xml_escape(he): href
                concat(piece): "<text:a xlink:type=\"simple\" xlink:href=\"" he "\">" piece "</text:a>"
            ]
            concat(body): body piece
            if(_): {note != ""} [
                sb_xml_escape(ne): note
                concat(body): body "<text:note text:note-class=\"footnote\"><text:note-body><text:p>" ne "</text:p></text:note-body></text:note>"
            ]
            set(j): {j + 1}
        ]
        set(open): ""
        set(close): ""
        if(_): {lst != ""} [
            set(open): "<text:list-item>"
            set(close): "</text:list-item>"
        ]
        if(_): {body = ""} [ concat(r): r open "<" tag sn extra "/>" close "\n" ]
        else(_): [ concat(r): r open "<" tag sn extra ">" body "</" tag ">" close "\n" ]
        set(i): {i + 1}
    ]
    if(_): {inlist != ""} [ concat(r): r "</text:list>\n" ]
    concat(r): r "</office:text>\n</office:body>\n</office:document>\n"
]

# the props named by a style's text-properties attributes
nsm_props_of(r): attrs [
    btree(r):
    sb_xml_attr(w): attrs "fo:font-weight"
    if(_): {w = "bold"} [ btput(_): r "bold" true ]
    sb_xml_attr(s): attrs "fo:font-style"
    if(_): {s = "italic"} [ btput(_): r "italic" true ]
    sb_xml_attr(u): attrs "style:text-underline-style"
    if(_): {u != null && u != "none"} [ btput(_): r "underline" true ]
    sb_xml_attr(l): attrs "style:text-line-through-style"
    if(_): {l != null && l != "none"} [ btput(_): r "strike" true ]
    sb_xml_attr(pos): attrs "style:text-position"
    if(_): {pos != null} [
        str_starts(sub): pos "sub"
        str_starts(sup): pos "super"
        if(_): sub [ btput(_): r "sub" true ]
        if(_): sup [ btput(_): r "sup" true ]
    ]
    sb_xml_attr(c): attrs "fo:color"
    if(_): {c != null} [ btput(_): r "color" c ]
    sb_xml_attr(bg): attrs "fo:background-color"
    if(_): {bg != null && bg != "transparent"} [ btput(_): r "background" bg ]
    sb_xml_attr(fs): attrs "fo:font-size"
    if(_): {fs != null} [
        str_ends(pt): fs "pt"
        if(_): pt [
            len(fl): fs
            slice(fs): fs 0 {fl - 2}
            str_to_number(fsn): fs
            btput(_): r "size" fsn
        ]
    ]
    sb_xml_attr(fn): attrs "style:font-name"
    if(_): {fn != null} [ btput(_): r "font" fn ]
]

nsm_mm(r): v [
    set(r): 0
    if(_): {v = null} [ return(r): r ]
    str_ends(mm): v "mm"
    str_ends(cm): v "cm"
    str_ends(inch): v "in"
    len(n): v
    set(num): v
    if(_): {mm || cm || inch} [ slice(num): v 0 {n - 2} ]
    str_to_number(r): num
    typeof(t): r
    if(_): {t != "integer" && t != "real"} [ set(r): 0 ]
    if(_): cm [ set(r): {r * 10} ]
    if(_): inch [ set(r): {r * 25.4} ]
]

nsm_from_fodt(r): s [
    nsm_new(r):
    btget(meta): r "meta"
    re_find(m): "<dc:title>([^<]*)</dc:title>" s
    typeof(mt): m
    if(_): {mt = "vector"} [
        at(x): m 1
        sb_xml_unescape(x): x
        btput(_): meta "title" x
    ]
    re_find(m): "<dc:creator>([^<]*)</dc:creator>" s
    typeof(mt): m
    if(_): {mt = "vector"} [
        at(x): m 1
        sb_xml_unescape(x): x
        btput(_): meta "author" x
    ]
    re_find(m): "<meta:keyword>([^<]*)</meta:keyword>" s
    typeof(mt): m
    if(_): {mt = "vector"} [
        at(x): m 1
        sb_xml_unescape(x): x
        btput(_): meta "keywords" x
    ]
    # styles: name -> [family props paraattrs]
    btree(styles):
    len(n): s
    set(i): 0
    set(cur): ""
    set(curfam): ""
    str_find(body): s "<office:body" 0
    if(_): {body < 0} [ set(body): n ]
    while(_): {i < body} [
        sb_next_lt(j): s i n
        if(_): {j >= body} [ set(i): body ]
        else(_): [
            sb_xml_tag(tag): s j
            at(kind): tag 0
            at(name): tag 1
            at(attrs): tag 2
            at(i): tag 3
            if(_): {name = "style:style" && kind != "close"} [
                sb_xml_attr(cur): attrs "style:name"
                sb_xml_attr(curfam): attrs "style:family"
                vec(e): ""
                btree(pr):
                push(_): e pr
                push(_): e ""
                btput(_): styles cur e
            ]
            elif(_): {name = "style:text-properties" && cur != ""} [
                btget(e): styles cur null
                if(_): {e != null} [
                    nsm_props_of(pr): attrs
                    set(e): 0 pr
                ]
            ]
            elif(_): {name = "style:paragraph-properties" && cur != ""} [
                btget(e): styles cur null
                if(_): {e != null} [ set(e): 1 attrs ]
            ]
        ]
    ]
    str_find(start): s "<office:text" 0
    if(_): {start < 0} [ return(r): r ]
    set(i): start
    set(depth): 0
    set(hidden): 0
    set(listkind): ""
    set(p): null
    vec(stack): ""
    set(href): ""
    set(notetext): ""
    set(innote): false
    set(done): false
    while(_): {i < n && done = false} [
        byte(b): s i
        if(_): {b != 60} [
            sb_next_lt(j): s i n
            sb_xml_text(t): s i j
            if(_): innote [ concat(notetext): notetext t ]
            elif(_): {depth > 0 && hidden = 0 && p != null} [ nsm_append(_): p t stack href ]
            set(i): j
        ]
        else(_): [
            sb_xml_tag(tag): s i
            at(kind): tag 0
            at(name): tag 1
            at(attrs): tag 2
            at(i): tag 3
            set(isp): {name = "text:p" || name = "text:h"}
            if(_): {name = "text:note" && kind = "open"} [
                set(innote): true
                set(notetext): ""
            ]
            elif(_): {name = "text:note" && kind = "close"} [
                set(innote): false
                if(_): {p != null} [ nsm_note_last(_): p notetext ]
            ]
            elif(_): innote [ set(innote): innote ]
            elif(_): {name = "office:annotation"} [
                if(_): {kind = "open"} [ set(hidden): {hidden + 1} ]
                if(_): {kind = "close"} [ set(hidden): {hidden - 1} ]
