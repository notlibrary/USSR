            slice(w): words from {i - from}
            str_to_number(v): w
            if(_): {dir > 0 && v > size && (best = size || v < best)} [ set(best): v ]
            if(_): {dir < 0 && v < size && (best = size || v > best)} [ set(best): v ]
            set(from): {i + 1}
