# --- hooks for Siberia's event handlers ---------------------------------------

# A typed character in pad mode: to the font picker when it is open.
sb_pad_char(r): s [
    set(picker): sb_picker?
    if(_): {picker = true} [ sb_picker_char(r): s ] else(_): [ sbpadtype(r): s ]
]

sb_pad_wheel(r): direction [
    set(r): 0
    set(picker): sb_picker?
    if(_): {picker = true} [
        set(top): sb_pick_top?
        set(families): sb_families?
        len(n): families
        set(top): {top - direction * 3}
        if(_): {top > n - SB_PICK_ROWS} [ set(top): {n - SB_PICK_ROWS} ]
        if(_): {top < 0} [ set(top): 0 ]
        set(sel): sb_pick?
        if(_): {sel < top} [ set(sb_pick): top! ]
        if(_): {sel >= top + SB_PICK_ROWS} [ set(sb_pick): {top + SB_PICK_ROWS - 1}! ]
        set(sb_pick_top): top!
    ]
    else(_): [
        sb_pad_scroll(_): {0 - direction * 3}
        # the view stays where the wheel put it until the next edit
        set(sb_pfollow): false!
    ]
]

# A toolbar button of the pad's own (font, size, bold, italic).
sb_pad_tool(r): action [
    set(r): 0
    if(_): {action = "font"} [
        set(picker): sb_picker?
        if(_): {picker = true} [ set(sb_picker): false! ] else(_): [ sb_picker_open(_): ]
    ]
    elif(_): {action = "smaller"} [ sb_pad_size_step(_): {0 - 1} ]
    elif(_): {action = "bigger"} [ sb_pad_size_step(_): 1 ]
    elif(_): {action = "bold" || action = "italic"} [
        if(_): {action = "bold"} [
            set(b): sb_bold?
            set(sb_bold): {b != true}!
        ]
        else(_): [
            set(b): sb_italic?
            set(sb_italic): {b != true}!
        ]
        set(sb_dirty): true!
        sb_apply_font(_):
    ]
]

# The system fonts, the preferred family, and the pad's toolbar buttons.
sb_pad_toolbar(r): bar [
    set(r): 0
    sb_scan_fonts(families):
    set(sb_families): families!
    vec(prefer): ""
    push(_): prefer "Calibri"
    push(_): prefer "Liberation Serif"
    push(_): prefer "Times New Roman"
    push(_): prefer "DejaVu Serif"
    push(_): prefer "Arial"
    push(_): prefer "DejaVu Sans"
    len(pn): prefer
    set(i): 0
    set(found): false
    while(_): {i < pn && found = false} [
        at(name): prefer i
        sb_family_index(fi): families name
        if(_): {fi >= 0} [
            set(sb_family): name!
            set(found): true
        ]
        set(i): {i + 1}
    ]
    len(fn): families
    if(_): {found = false && fn > 0} [
        at(f0): families 0
        getf(n0): f0 "name"
        set(sb_family): n0!
    ]
    sb_apply_font(_):
    sb_add_button(_): bar "Font: ------------------------" "font"
    sb_add_button(_): bar "-" "smaller"
    sb_add_button(_): bar "12 pt" "size"
    sb_add_button(_): bar "+" "bigger"
    sb_add_button(_): bar "B" "bold"
    sb_add_button(_): bar "I" "italic"
]

$ifdef __MAIN__
init(result): arg_count arg_values [
    sb_app_main(result): "pad" "Novosibirsk" "usage: ussr novosibirsk.su [file.fodt|file.txt]" arg_count arg_values
]
$endif
