        set(i): {i + 1}
    ]
    set(sb_size): best!
    set(sb_dirty): true!
    sb_apply_font(_):
    sb_pad_tool_labels(_):
    set(r): best
]

# Moves the first shown line (sb_ptop, sb_ptopline) by n wrapped lines.
sb_pad_scroll(r): n [
    set(p): sb_ptop?
    set(k): sb_ptopline?
    sb_pad_count(count):
    while(_): {n > 0} [
        sb_para_text(t): p
        sb_wrap(starts): t
        len(lines): starts
        if(_): {k + 1 < lines} [ set(k): {k + 1} ]
        elif(_): {p + 1 < count} [
            set(p): {p + 1}
            set(k): 0
        ]
        set(n): {n - 1}
    ]
    while(_): {n < 0} [
        if(_): {k > 0} [ set(k): {k - 1} ]
        elif(_): {p > 0} [
            set(p): {p - 1}
            sb_para_text(t): p
            sb_wrap(starts): t
            len(lines): starts
            set(k): {lines - 1}
        ]
        set(n): {n + 1}
    ]
    set(sb_ptop): p!
    set(sb_ptopline): k!
    set(r): 0
]

# Scrolls so that the cursor's line is on screen.
sb_pad_reveal(r): [
    set(r): 0
    set(visible): sb_plines_visible?
    typeof(tv): visible
    if(_): {tv != "integer"} [ return(_): r ]
    set(row): sb_prow?
    set(col): sb_pcol?
    set(top): sb_ptop?
    set(topline): sb_ptopline?
