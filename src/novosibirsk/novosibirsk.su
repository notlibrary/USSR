    sb_wrap(starts): t
    sb_line_of(k): starts col
    if(_): {row < top || (row = top && k < topline)} [
        set(sb_ptop): row!
        set(sb_ptopline): k!
        return(_): r
    ]
    # lines from the top to the cursor, when that is at most a screen
    set(before): 0
    set(far): {row - top >= visible}
    if(_): {far = false} [
        set(p): top
        while(_): {p < row} [
            sb_para_text(tp): p
            sb_wrap(sp): tp
            len(lp): sp
            set(before): {before + lp}
            set(p): {p + 1}
        ]
        set(before): {before - topline + k}
        set(far): {before >= visible}
    ]
    if(_): far [
        set(sb_ptop): row!
        set(sb_ptopline): k!
        sb_pad_scroll(_): {1 - visible}
    ]
]

sb_pad_draw(r): [
    set(canvas): sb_canvas?
    sb_canvas_size(size):
    at(w): size 0
    at(h): size 1
    set(width): {w - 2 * SB_MARGIN}
    if(_): {width < 40} [ set(width): 40 ]
    set(sb_pwidth): width!
    sb_line_height(lh):
    str_trunc(visible): {(h - SB_STATUSH - 16) / lh}
