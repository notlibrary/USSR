# Adds the font file at path to families (a vector of SbFamily).
sb_add_font(r): families path [
    set(r): 0
    fontinfo(info): path
    if(_): {info = ""} [ return(_): r ]
    str_find(bar): info "|" 0
    len(il): info
    slice(family): info 0 bar
    slice(style): info {bar + 1} {il - bar - 1}
    str_lower(style): style
    len(n): families
    set(found): null
    set(i): 0
    while(_): {i < n} [
        at(f): families i
        getf(fname): f "name"
        if(_): {fname = family} [
            set(found): f
            set(i): n
        ]
        set(i): {i + 1}
    ]
    typeof(tf): found
    if(_): {tf = "null"} [
        str_lower(key): family
        new(found): "SbFamily" family key "" "" "" ""
        push(_): families found
    ]
    str_find(isb): style "bold" 0
    str_find(isi): style "italic" 0
    str_find(iso): style "oblique" 0
    set(slot): "regular"
    if(_): {isb >= 0 && (isi >= 0 || iso >= 0)} [ set(slot): "bolditalic" ]
    elif(_): {isb >= 0} [ set(slot): "bold" ]
    elif(_): {isi >= 0 || iso >= 0} [ set(slot): "italic" ]
    getf(old): found slot
    set(plain): {style = "regular" || style = "normal" || style = "book" || style = "roman"}
    if(_): {old = "" || (slot = "regular" && plain)} [ setf(_): found slot path ]
]

sb_scan_dir(r): families dir depth [
    set(r): 0
    list_dir(names): dir
    typeof(t): names
    if(_): {t != "vector" || depth > 4} [ return(_): r ]
    len(n): names
