            set(sb_dirty): true!
            sb_apply_font(_):
            sb_pad_tool_labels(_):
            return(_): r
        ]
        if(_): {key = 73} [
            set(i): sb_italic?
            set(sb_italic): {i != true}!
            set(sb_dirty): true!
            sb_apply_font(_):
            sb_pad_tool_labels(_):
            return(_): r
        ]
        if(_): {key = 93} [
            sb_pad_size_step(_): 1
            return(_): r
        ]
        if(_): {key = 91} [
            sb_pad_size_step(_): {0 - 1}
            return(_): r
