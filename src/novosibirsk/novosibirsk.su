    set(i): 0
    while(_): {i < k} [
        at(f): families i
        getf(reg): f "regular"
        if(_): {reg = ""} [
            getf(b): f "bold"
            getf(it): f "italic"
            getf(bi): f "bolditalic"
            set(pick): b
            if(_): {pick = ""} [ set(pick): it ]
            if(_): {pick = ""} [ set(pick): bi ]
            setf(_): f "regular" pick
