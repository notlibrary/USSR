# novosibirsk.su - Novosibirsk, a small document editor for USSR on a
# Petersburg canvas, with the system's TrueType fonts. It was
# `siberia.su --pad` before Siberia was split into the spreadsheet and this.
#
#     ussr src/novosibirsk/novosibirsk.su [file.fodt|file.txt]
#
# Files are OpenDocument text in its flat, single-XML form (.fodt), which
# LibreOffice and other ODF programs open and save, or plain text.
#
# Novosibirsk defines SB_PAD and includes Siberia for the shared parts
# (helpers, XML, the file dialog, the event handlers), so its state and
# functions keep Siberia's sb_ prefix. The engine (the document and its
# cursor) works without a window and is what tests/novosibirsk_test.su
# checks. Public API, after sbsetup(_): from siberia.su:
#   sbpadreset(r): / sbpadsettext(r): text / sbpadtext(r):
#   sbpadkey(r): key / sbpadtype(r): text   -> edits at the cursor
#   sbpadfodt(r): / sbpadload(r): text kind ("fodt" or "txt")
#
# The document's paragraphs are SbPara structs in sb_paras.
$once
$ifdef __MAIN__
$define SB_APP 1
$endif
$define SB_PAD 1
$include "../siberia/siberia.su"

# --- the document -----------------------------------------------------------
# Paragraphs are SbPara structs in sb_paras; the cursor is sb_prow (the
# paragraph) and sb_pcol (a byte offset in it). Lines wrap at sb_pwidth
# pixels, measured with the document font (sb_pfont, sb_ppx pixels per
# em) or, without one, the bitmap font at scale 2.

sbpadreset(r): [
    vec(paras): "SbPara"
    new(p): "SbPara" ""
    push(_): paras p
    set(sb_paras): paras!
    set(sb_prow): 0!
    set(sb_pcol): 0!
    set(sb_ptop): 0!
    set(sb_ptopline): 0!
    set(sb_goalx): {0 - 1}!
    set(sb_dirty): false!
    set(r): 0
]

sb_pad_count(r): [
    set(paras): sb_paras?
    len(r): paras
]

sb_para_text(r): index [
    set(paras): sb_paras?
    at(p): paras index
    getf(r): p "text"
]

sb_para_set(r): index text [
    set(paras): sb_paras?
    at(p): paras index
    setf(_): p "text" text
    set(sb_dirty): true!
    set(r): 0
]

# Tabs as four spaces, control characters dropped.
sb_clean_line(r): s [
    set(r): ""
    len(n): s
    set(i): 0
    set(from): 0
    while(_): {i < n} [
        byte(b): s i
        if(_): {b < 32} [
            slice(run): s from {i - from}
            concat(r): r run
            if(_): {b = 9} [ concat(r): r "    " ]
            set(from): {i + 1}
        ]
        set(i): {i + 1}
    ]
    slice(run): s from {n - from}
    concat(r): r run
]

sbpadsettext(r): text [
    vec(paras): "SbPara"
    len(n): text
    set(from): 0
    set(i): 0
    while(_): {i <= n} [
        set(b): 10
        if(_): {i < n} [ byte(b): text i ]
        if(_): {b = 10} [
            slice(line): text from {i - from}
            sb_clean_line(line): line
            new(p): "SbPara" line
            push(_): paras p
            set(from): {i + 1}
        ]
        set(i): {i + 1}
    ]
    set(sb_paras): paras!
    set(sb_prow): 0!
    set(sb_pcol): 0!
    set(sb_ptop): 0!
    set(sb_ptopline): 0!
    set(sb_goalx): {0 - 1}!
    set(r): 0
]

sbpadtext(r): [
    set(paras): sb_paras?
    len(n): paras
    set(r): ""
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        getf(t): p "text"
        if(_): {i > 0} [ concat(r): r "\n" ]
        concat(r): r t
        set(i): {i + 1}
    ]
]

sb_measure(r): text [
    set(font): sb_pfont?
    if(_): {font > 0} [
        set(px): sb_ppx?
        fontwidth(r): font px text
    ]
    else(_): [
        len(n): text
        set(r): {n * 14}
    ]
]

sb_line_height(r): [
    set(font): sb_pfont?
    set(r): 20
    if(_): {font > 0} [
        set(px): sb_ppx?
        fontheight(r): font px
    ]
]

# Index past the run of spaces at i.
sb_skip_spaces(r): s i n [
    set(r): i
    set(go): {r < n}
    while(_): go [
        byte(b): s r
        if(_): {b = 32} [
            set(r): {r + 1}
            set(go): {r < n}
        ]
        else(_): [ set(go): false ]
    ]
]

# Start offsets of the wrapped lines of a paragraph: words move to the
# next line when they do not fit; a word wider than the line breaks.
sb_wrap(r): text [
    vec(r): ""
    push(_): r 0
    set(width): sb_pwidth?
    len(n): text
    set(start): 0
    while(_): {start < n} [
        set(end): start
        set(go): true
        while(_): go [
            # the next word and the spaces after it
            set(j): end
            set(more): {j < n}
            while(_): more [
                byte(b): text j
                if(_): {b = 32} [ set(more): false ]
                else(_): [
                    set(j): {j + 1}
                    set(more): {j < n}
                ]
            ]
            slice(piece): text start {j - start}
            sb_measure(w): piece
            sb_skip_spaces(next): text j n
            if(_): {w <= width} [
                set(end): next
                set(go): {end < n}
            ]
            elif(_): {end = start} [
                # one word wider than the line: as many characters as fit
                utf8_next(k): text start
                set(fit): true
                while(_): {fit && k < n} [
                    utf8_next(k2): text k
                    slice(piece): text start {k2 - start}
                    sb_measure(w): piece
                    if(_): {w <= width} [ set(k): k2 ] else(_): [ set(fit): false ]
                ]
                set(end): k
                set(go): false
            ]
            else(_): [ set(go): false ]
        ]
        if(_): {end < n} [ push(_): r end ]
        set(start): end
    ]
]

# The wrapped line of starts that holds byte col.
sb_line_of(r): starts col [
    len(n): starts
    set(r): 0
    set(i): 1
    while(_): {i < n} [
        at(s): starts i
        if(_): {s <= col} [ set(r): i ]
        set(i): {i + 1}
    ]
]

# The last caret position on line k: before a wrapped line's last
# character (the space it wrapped at), or the paragraph's end.
sb_line_limit(r): text starts k [
    len(n): starts
    len(r): text
    if(_): {k + 1 < n} [
        at(next): starts {k + 1}
        utf8_prev(r): text next
    ]
]

sb_line_start(r): starts k [
    at(r): starts k
]

# The byte offset on line k nearest to x pixels.
sb_col_at_x(r): text starts k x [
    sb_line_start(start): starts k
    sb_line_limit(limit): text starts k
    set(r): start
    set(prev): 0.0
    set(go): {r < limit}
    while(_): go [
        utf8_next(next): text r
        slice(piece): text start {next - start}
        sb_measure(w): piece
        if(_): {(prev + w) / 2 > x} [ set(go): false ]
        else(_): [
            set(r): next
            set(prev): w
            set(go): {r < limit}
        ]
    ]
]

sb_caret_x(r): text starts col [
    sb_line_of(k): starts col
    at(start): starts k
    slice(piece): text start {col - start}
    sb_measure(r): piece
]

sbpadtype(r): s [
    set(row): sb_prow?
    set(col): sb_pcol?
    sb_para_text(t): row
    len(n): t
    slice(left): t 0 col
    slice(right): t col {n - col}
    concat(t): left s right
    sb_para_set(_): row t
    len(sl): s
    set(sb_pcol): {col + sl}!
    set(sb_goalx): {0 - 1}!
    set(r): 0
]

# Replaces the paragraph list: items before index, the new ones, and the
# items from index + drop on.
sb_paras_splice(r): index drop items [
    set(paras): sb_paras?
    len(n): paras
    vec(out): "SbPara"
    set(i): 0
    while(_): {i < index} [
        at(p): paras i
        push(_): out p
        set(i): {i + 1}
    ]
    len(k): items
    set(j): 0
    while(_): {j < k} [
        at(p): items j
        push(_): out p
        set(j): {j + 1}
    ]
    set(i): {index + drop}
    while(_): {i < n} [
        at(p): paras i
        push(_): out p
        set(i): {i + 1}
    ]
    set(sb_paras): out!
    set(sb_dirty): true!
    set(r): 0
]

sb_pad_enter(r): [
    set(row): sb_prow?
    set(col): sb_pcol?
    sb_para_text(t): row
    len(n): t
    slice(left): t 0 col
    slice(right): t col {n - col}
    vec(items): ""
    new(a): "SbPara" left
    new(b): "SbPara" right
    push(_): items a
    push(_): items b
    sb_paras_splice(_): row 1 items
    set(sb_prow): {row + 1}!
    set(sb_pcol): 0!
    set(r): 0
]

sb_pad_backspace(r): [
    set(row): sb_prow?
    set(col): sb_pcol?
    sb_para_text(t): row
    len(n): t
    if(_): {col > 0} [
        utf8_prev(i): t col
        slice(left): t 0 i
        slice(right): t col {n - col}
        concat(t): left right
        sb_para_set(_): row t
        set(sb_pcol): i!
    ]
    elif(_): {row > 0} [
        sb_para_text(prev): {row - 1}
        len(pl): prev
        concat(joined): prev t
        vec(items): ""
        new(a): "SbPara" joined
        push(_): items a
        sb_paras_splice(_): {row - 1} 2 items
        set(sb_prow): {row - 1}!
        set(sb_pcol): pl!
    ]
    set(r): 0
]

sb_pad_delete(r): [
    set(row): sb_prow?
    set(col): sb_pcol?
    sb_para_text(t): row
    len(n): t
    sb_pad_count(count):
    if(_): {col < n} [
        utf8_next(i): t col
        slice(left): t 0 col
        slice(right): t i {n - i}
        concat(t): left right
        sb_para_set(_): row t
    ]
    elif(_): {row + 1 < count} [
        sb_para_text(next): {row + 1}
        concat(joined): t next
        vec(items): ""
        new(a): "SbPara" joined
        push(_): items a
        sb_paras_splice(_): row 2 items
    ]
    set(r): 0
]

# Moves the cursor one wrapped line up (dir -1) or down (1), keeping the
# horizontal position of the first move in sb_goalx.
sb_pad_vertical(r): dir [
    set(row): sb_prow?
    set(col): sb_pcol?
    sb_para_text(t): row
    sb_wrap(starts): t
    sb_line_of(k): starts col
    set(goal): sb_goalx?
    if(_): {goal < 0} [
        sb_caret_x(goal): t starts col
        set(sb_goalx): goal!
    ]
    len(lines): starts
    sb_pad_count(count):
    set(k2): {k + dir}
    if(_): {k2 >= 0 && k2 < lines} [
        sb_col_at_x(c): t starts k2 goal
        set(sb_pcol): c!
    ]
    elif(_): {k2 < 0 && row > 0} [
        sb_para_text(t2): {row - 1}
        sb_wrap(s2): t2
        len(l2): s2
        sb_col_at_x(c): t2 s2 {l2 - 1} goal
        set(sb_prow): {row - 1}!
        set(sb_pcol): c!
    ]
    elif(_): {k2 >= lines && row + 1 < count} [
        sb_para_text(t2): {row + 1}
        sb_wrap(s2): t2
        sb_col_at_x(c): t2 s2 0 goal
        set(sb_prow): {row + 1}!
        set(sb_pcol): c!
    ]
    elif(_): {k2 < 0} [ set(sb_pcol): 0! ]
    else(_): [
        len(tl): t
        set(sb_pcol): tl!
    ]
    set(r): 0
]

# One editing or movement key (GLFW code); ctrl for Ctrl+Home/End.
# Returns true when the key was used.
sb_pad_key(r): key ctrl [
    set(r): true
    set(keep_goal): false
    set(row): sb_prow?
    set(col): sb_pcol?
    sb_para_text(t): row
    len(n): t
    sb_pad_count(count):
    if(_): {key = SB_KEY_ENTER || key = SB_KEY_KP_ENTER} [ sb_pad_enter(_): ]
    elif(_): {key = SB_KEY_BACKSPACE} [ sb_pad_backspace(_): ]
    elif(_): {key = SB_KEY_DELETE} [ sb_pad_delete(_): ]
    elif(_): {key = SB_KEY_TAB} [ sbpadtype(_): "    " ]
    elif(_): {key = SB_KEY_LEFT} [
        if(_): {col > 0} [
            utf8_prev(c): t col
            set(sb_pcol): c!
        ]
        elif(_): {row > 0} [
            sb_para_text(prev): {row - 1}
            len(pl): prev
            set(sb_prow): {row - 1}!
            set(sb_pcol): pl!
        ]
    ]
    elif(_): {key = SB_KEY_RIGHT} [
        if(_): {col < n} [
            utf8_next(c): t col
            set(sb_pcol): c!
        ]
        elif(_): {row + 1 < count} [
            set(sb_prow): {row + 1}!
            set(sb_pcol): 0!
        ]
    ]
    elif(_): {key = SB_KEY_UP} [
        sb_pad_vertical(_): {0 - 1}
        set(keep_goal): true
    ]
    elif(_): {key = SB_KEY_DOWN} [
        sb_pad_vertical(_): 1
        set(keep_goal): true
    ]
    elif(_): {key = SB_KEY_PAGE_UP || key = SB_KEY_PAGE_DOWN} [
        set(dir): 1
        if(_): {key = SB_KEY_PAGE_UP} [ sb_minus_one(dir): ]
        set(steps): sb_plines_visible?
        typeof(ts): steps
        if(_): {ts != "integer"} [ set(steps): 20 ]
        set(steps): {steps - 1}
        if(_): {steps < 1} [ set(steps): 1 ]
        set(i): 0
        while(_): {i < steps} [
            sb_pad_vertical(_): dir
            set(i): {i + 1}
        ]
        set(keep_goal): true
    ]
    elif(_): {key = SB_KEY_HOME && ctrl} [
        set(sb_prow): 0!
        set(sb_pcol): 0!
    ]
    elif(_): {key = SB_KEY_END && ctrl} [
        sb_para_text(last): {count - 1}
        len(ll): last
        set(sb_prow): {count - 1}!
        set(sb_pcol): ll!
    ]
    elif(_): {key = SB_KEY_HOME || key = SB_KEY_END} [
        sb_wrap(starts): t
        sb_line_of(k): starts col
        if(_): {key = SB_KEY_HOME} [ at(c): starts k ]
        else(_): [ sb_line_limit(c): t starts k ]
        set(sb_pcol): c!
    ]
    else(_): [ set(r): false ]
    if(_): {keep_goal = false} [ set(sb_goalx): {0 - 1}! ]
]

sbpadkey(r): key [
    sb_pad_key(r): key false
]

# --- document files ---------------------------------------------------------

sbpadfodt(r): [
    set(family): sb_family?
    typeof(tf): family
    if(_): {tf != "string" || family = ""} [ set(family): "Liberation Serif" ]
    set(size): sb_size?
    typeof(tz): size
    if(_): {tz != "integer"} [ set(size): 12 ]
    set(bold): sb_bold?
    set(italic): sb_italic?
    sb_xml_escape(fe): family
    str_from_int(ss): size
    concat(r): SB_ODF_HEAD "office:mimetype=\"application/vnd.oasis.opendocument.text\">\n<office:font-face-decls>\n<style:font-face style:name=\"" fe "\" svg:font-family=\"'" fe "'\"/>\n</office:font-face-decls>\n<office:styles>\n<style:default-style style:family=\"paragraph\">\n<style:text-properties style:font-name=\"" fe "\" fo:font-size=\"" ss "pt\""
    if(_): {bold = true} [ concat(r): r " fo:font-weight=\"bold\"" ]
    if(_): {italic = true} [ concat(r): r " fo:font-style=\"italic\"" ]
    concat(r): r "/>\n</style:default-style>\n</office:styles>\n<office:body>\n<office:text>\n"
    set(paras): sb_paras?
    len(n): paras
    set(i): 0
    while(_): {i < n} [
        at(p): paras i
        getf(t): p "text"
        if(_): {t = ""} [ concat(r): r "<text:p/>\n" ]
        else(_): [
            sb_odf_text(x): t
            concat(r): r "<text:p>" x "</text:p>\n"
        ]
        set(i): {i + 1}
    ]
    concat(r): r "</office:text>\n</office:body>\n</office:document>\n"
]

# The attributes of the first tag named name at or after from, or null.
sb_find_tag_attrs(r): s name from [
    set(r): null
    concat(key): "<" name " "
    str_find(at): s key from
    if(_): {at >= 0} [
        sb_xml_tag(tag): s at
        at(r): tag 2
    ]
]

# The document font from the styles: the default paragraph style, else
# the first text properties that name a font. Sets sb_family, sb_size,
# sb_bold and sb_italic for what it finds.
sb_fodt_font(r): s [
    set(r): 0
    str_find(def): s "<style:default-style style:family=\"paragraph\"" 0
    set(attrs): null
    if(_): {def >= 0} [ sb_find_tag_attrs(attrs): s "style:text-properties" def ]
    set(name): null
    typeof(ta): attrs
    if(_): {ta = "string"} [ sb_xml_attr(name): attrs "style:font-name" ]
    typeof(tn): name
    if(_): {tn != "string"} [
        str_find(at): s "style:font-name=\"" 0
        if(_): {at >= 0} [
            set(scan): 0
            if(_): {at > 2000} [ set(scan): {at - 2000} ]
            set(best): {0 - 1}
            set(go): true
            while(_): go [
                str_find(lt): s "<style:text-properties " scan
                if(_): {lt >= 0 && lt < at} [
                    set(best): lt
                    set(scan): {lt + 1}
                ]
                else(_): [ set(go): false ]
            ]
            if(_): {best >= 0} [
                sb_xml_tag(tag): s best
                at(attrs): tag 2
                sb_xml_attr(name): attrs "style:font-name"
            ]
        ]
    ]
    typeof(tn): name
    if(_): {tn = "string"} [
        # the face's family from its declaration
        set(family): name
        sb_xml_escape(en): name
        concat(key): "<style:font-face style:name=\"" en "\""
        str_find(at): s key 0
        if(_): {at >= 0} [
            sb_xml_tag(tag): s at
            at(fa): tag 2
            sb_xml_attr(ff): fa "svg:font-family"
            typeof(tff): ff
            if(_): {tff = "string"} [
                len(fl): ff
                set(family): ff
                if(_): {fl >= 2} [
                    byte(q): ff 0
                    if(_): {q = 39 || q = 34} [ slice(family): ff 1 {fl - 2} ]
                ]
            ]
        ]
        set(sb_family): family!
        sb_xml_attr(size): attrs "fo:font-size"
        typeof(tsz): size
        if(_): {tsz = "string"} [
            sb_ends(pt): size "pt"
            if(_): pt [
                len(sl): size
                slice(num): size 0 {sl - 2}
                str_to_number(v): num
                sb_is_number(isn): v
                if(_): isn [
                    str_trunc(v): {v + 0.5}
                    if(_): {v >= 4 && v <= 200} [ set(sb_size): v! ]
                ]
            ]
        ]
        sb_xml_attr(weight): attrs "fo:font-weight"
        sb_xml_attr(style): attrs "fo:font-style"
        set(sb_bold): {weight = "bold"}!
        set(sb_italic): {style = "italic"}!
        set(r): 1
    ]
]

sb_load_fodt(r): s [
    set(r): "no text in this file"
    str_find(start): s "<office:text" 0
    if(_): {start < 0} [ return(_): r ]
    set(r): ""
    set(sb_bold): false!
    set(sb_italic): false!
    sb_fodt_font(_): s
    vec(paras): "SbPara"
    len(n): s
    set(i): start
    set(text): ""
    set(depth): 0
    set(hidden): 0
    set(done): false
    while(_): {i < n && done = false} [
        byte(b): s i
        if(_): {b != 60} [
            sb_next_lt(j): s i n
            if(_): {depth > 0 && hidden = 0} [
                sb_xml_text(t): s i j
                concat(text): text t
            ]
            set(i): j
        ]
        else(_): [
            sb_xml_tag(tag): s i
            at(kind): tag 0
            at(name): tag 1
            at(attrs): tag 2
            at(i): tag 3
            set(para): {name = "text:p" || name = "text:h"}
            if(_): {name = "office:annotation" || name = "text:note"} [
                if(_): {kind = "open"} [ set(hidden): {hidden + 1} ]
                if(_): {kind = "close"} [ set(hidden): {hidden - 1} ]
            ]
            elif(_): {para && kind = "empty" && hidden = 0} [
                new(p): "SbPara" ""
                push(_): paras p
            ]
            elif(_): {para && kind = "open"} [
                if(_): {depth = 0} [ set(text): "" ]
                set(depth): {depth + 1}
            ]
            elif(_): {para && kind = "close"} [
                set(depth): {depth - 1}
                if(_): {depth <= 0 && hidden = 0} [
                    set(depth): 0
                    sb_clean_line(text): text
                    new(p): "SbPara" text
                    push(_): paras p
                    set(text): ""
                ]
            ]
            elif(_): {depth > 0 && hidden = 0} [
                if(_): {name = "text:s"} [
                    sb_attr_int(count): attrs "text:c" 1
                    str_repeat(sp): " " count
                    concat(text): text sp
                ]
                elif(_): {name = "text:tab"} [ concat(text): text "    " ]
                elif(_): {name = "text:line-break"} [
                    new(p): "SbPara" text
                    push(_): paras p
                    set(text): ""
                ]
            ]
            elif(_): {name = "office:text" && kind = "close"} [ set(done): true ]
        ]
    ]
    len(count): paras
    if(_): {count = 0} [
        new(p): "SbPara" ""
        push(_): paras p
    ]
    set(sb_paras): paras!
    set(sb_prow): 0!
    set(sb_pcol): 0!
    set(sb_ptop): 0!
    set(sb_ptopline): 0!
    set(sb_goalx): {0 - 1}!
]

sbpadload(r): text kind [
    sbpadreset(_):
    set(r): ""
    if(_): {kind = "fodt"} [ sb_load_fodt(r): text ]
    else(_): [ sbpadsettext(_): text ]
    set(sb_dirty): false!
]

# --- system fonts -----------------------------------------------------------

sb_font_dirs(r): [
    vec(r): ""
    getenv(win): "WINDIR"
    typeof(tw): win
    if(_): {tw = "string"} [
        concat(d): win "/Fonts"
        push(_): r d
    ]
    getenv(local): "LOCALAPPDATA"
    typeof(tl): local
    if(_): {tl = "string"} [
        concat(d): local "/Microsoft/Windows/Fonts"
        push(_): r d
    ]
    push(_): r "/usr/share/fonts"
    push(_): r "/usr/local/share/fonts"
