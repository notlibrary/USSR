    set(sb_plines_visible): visible!
    set(follow): sb_pfollow?
    if(_): {follow != false} [ sb_pad_reveal(_): ]
    canvasclear(_): canvas 16777215
    set(font): sb_pfont?
    set(px): sb_ppx?
    set(row): sb_prow?
    set(col): sb_pcol?
    set(p): sb_ptop?
    set(k): sb_ptopline?
    sb_pad_count(count):
    vec(lines): ""
    set(y): 12
    set(shown): 0
    while(_): {shown < visible && p < count} [
        sb_para_text(t): p
        sb_wrap(starts): t
        len(nl): starts
        if(_): {k >= nl} [ set(k): {nl - 1} ]
        while(_): {k < nl && shown < visible} [
            at(start): starts k
            len(end): t
            if(_): {k + 1 < nl} [ at(end): starts {k + 1} ]
            slice(piece): t start {end - start}
            if(_): {font > 0} [ canvasfonttext(_): canvas SB_MARGIN y piece 0 font px ]
            else(_): [ canvastextscale(_): canvas SB_MARGIN {y + 3} piece 0 2 ]
            vec(entry): ""
            push(_): entry p
            push(_): entry start
            push(_): entry k
            push(_): entry y
            push(_): lines entry
            sb_line_of(ck): starts col
            if(_): {p = row && ck = k} [
                slice(before): t start {col - start}
                sb_measure(cx): before
                str_trunc(cx): cx
                canvasfill(_): canvas {SB_MARGIN + cx} y 2 lh 0
            ]
            set(y): {y + lh}
            set(shown): {shown + 1}
            set(k): {k + 1}
        ]
        set(p): {p + 1}
        set(k): 0
    ]
    set(sb_plines): lines!
    # status: where the cursor is
    sb_para_text(t): row
    utf8_column(column): t col
    str_from_int(rs): {row + 1}
    str_from_int(cs): {column + 1}
    str_from_int(ps): count
    concat(left): "Paragraph " rs " of " ps ", column " cs
    set(sb_status_left): left!
    sb_draw_status(_): w h
    sb_pad_draw_picker(_): w h
    sb_draw_dialog(_): w h
    set(r): 0
]

sb_pad_click(r): x y [
    set(r): 0
    set(picker): sb_picker?
