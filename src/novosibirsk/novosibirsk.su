# The file of a family's face, falling back to the nearest one there is.
sb_face_path(r): family bold italic [
    getf(reg): family "regular"
    getf(b): family "bold"
    getf(it): family "italic"
    getf(bi): family "bolditalic"
    set(r): reg
    if(_): {bold && italic} [
        if(_): {bi != ""} [ set(r): bi ] elif(_): {b != ""} [ set(r): b ] elif(_): {it != ""} [ set(r): it ]
    ]
    elif(_): bold [
        if(_): {b != ""} [ set(r): b ]
    ]
    elif(_): italic [
        if(_): {it != ""} [ set(r): it ]
    ]
]

# Loads the document font from sb_family, sb_bold, sb_italic and sb_size
