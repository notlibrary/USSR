        sb_family_index(i): families name
        if(_): {i >= 0} [
            at(f): families i
            sb_face_path(path): f bold italic
            loadfont(r): path
            set(sb_pfont): r!
        ]
    ]
]

# --- the GUI: pad -------------------------------------------------------------

$define SB_SIZES "8 9 10 11 12 14 16 18 20 22 24 28 32 36 48 72"

