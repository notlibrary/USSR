# The font picker: the system's families in a list over the page.
$define SB_PICK_ROWS 14
$define SB_PICK_ROWH 24

sb_picker_box(r): w h [
    set(bw): 320
    set(bh): {SB_PICK_ROWS * SB_PICK_ROWH + 8}
    vec(r): ""
    push(_): r 140
    push(_): r 6
    push(_): r bw
    push(_): r bh
]

sb_pad_draw_picker(r): w h [
    set(r): 0
    set(picker): sb_picker?
    if(_): {picker != true} [ return(_): r ]
    set(canvas): sb_canvas?
    set(families): sb_families?
    len(n): families
    set(sel): sb_pick?
    set(top): sb_pick_top?
    if(_): {sel < top} [ set(top): sel ]
    if(_): {sel >= top + SB_PICK_ROWS} [ set(top): {sel - SB_PICK_ROWS + 1} ]
    set(sb_pick_top): top!
    sb_picker_box(box): w h
    at(x): box 0
    at(y): box 1
    at(bw): box 2
    at(bh): box 3
    canvasfill(_): canvas {x + 3} {y + 3} bw bh 10066329
    canvasfill(_): canvas x y bw bh 16777215
    canvasrect(_): canvas x y bw bh 7368816
    if(_): {n = 0} [
        sb_ui_text(_): {x + 10} {y + 8} "No TrueType fonts found" 4473924
        return(_): r
    ]
    set(i): 0
    while(_): {i < SB_PICK_ROWS && top + i < n} [
        at(f): families {top + i}
        getf(name): f "name"
        set(ry): {y + 4 + i * SB_PICK_ROWH}
        set(color): 0
        if(_): {top + i = sel} [
            canvasfill(_): canvas {x + 2} ry {bw - 4} SB_PICK_ROWH 2192198
            set(color): 16777215
        ]
        sb_fit(name): name {bw - 24}
        sb_ui_text(_): {x + 10} {ry + 4} name color
        set(i): {i + 1}
    ]
    # where in the list
    if(_): {n > SB_PICK_ROWS} [
        str_trunc(ty): {y + 4 + (bh - 8) * top / n}
        str_trunc(th): {(bh - 8) * SB_PICK_ROWS / n}
        if(_): {th < 8} [ set(th): 8 ]
        canvasfill(_): canvas {x + bw - 6} ty 3 th 11184810
    ]
]

sb_picker_open(r): [
    set(families): sb_families?
    set(name): sb_family?
    sb_family_index(i): families name
    if(_): {i < 0} [ set(i): 0 ]
    set(sb_pick): i!
    set(sb_pick_top): {i - 5}!
    set(top): sb_pick_top?
    if(_): {top < 0} [ set(sb_pick_top): 0! ]
    set(sb_picker): true!
    set(r): 0
]

sb_picker_choose(r): [
    set(families): sb_families?
    set(sel): sb_pick?
    len(n): families
    if(_): {sel >= 0 && sel < n} [
        at(f): families sel
        getf(name): f "name"
        set(sb_family): name!
        set(sb_dirty): true!
        sb_apply_font(_):
        sb_pad_tool_labels(_):
    ]
    set(sb_picker): false!
    set(r): 0
]

sb_picker_key(r): key [
    set(families): sb_families?
    len(n): families
    set(sel): sb_pick?
    if(_): {key = SB_KEY_ESC} [ set(sb_picker): false! ]
    elif(_): {key = SB_KEY_ENTER || key = SB_KEY_KP_ENTER} [ sb_picker_choose(_): ]
    elif(_): {key = SB_KEY_UP} [ set(sel): {sel - 1} ]
    elif(_): {key = SB_KEY_DOWN} [ set(sel): {sel + 1} ]
    elif(_): {key = SB_KEY_PAGE_UP} [ set(sel): {sel - SB_PICK_ROWS} ]
    elif(_): {key = SB_KEY_PAGE_DOWN} [ set(sel): {sel + SB_PICK_ROWS} ]
    elif(_): {key = SB_KEY_HOME} [ set(sel): 0 ]
    elif(_): {key = SB_KEY_END} [ set(sel): {n - 1} ]
    if(_): {sel >= n} [ set(sel): {n - 1} ]
    if(_): {sel < 0} [ set(sel): 0 ]
    set(sb_pick): sel!
    set(r): 0
]

# A typed letter jumps to the next family that starts with it.
sb_picker_char(r): s [
    set(families): sb_families?
    len(n): families
    set(sel): sb_pick?
    str_lower(s): s
    set(i): 1
    set(found): false
    while(_): {i <= n && found = false} [
        set(idx): {(sel + i) % n}
        at(f): families idx
        getf(key): f "key"
        sb_starts(m): key s
        if(_): m [
            set(sb_pick): idx!
            set(found): true
        ]
        set(i): {i + 1}
    ]
    set(r): 0
]

sb_picker_click(r): x y [
    sb_canvas_size(size):
    at(w): size 0
    at(h): size 1
    sb_picker_box(box): w h
    at(bx): box 0
    at(by): box 1
    at(bw): box 2
    at(bh): box 3
    set(r): 0
    if(_): {x < bx || x > bx + bw || y < by || y > by + bh} [
        set(sb_picker): false!
        return(_): r
    ]
    str_trunc(i): {(y - by - 4) / SB_PICK_ROWH}
    set(top): sb_pick_top?
    set(families): sb_families?
    len(n): families
    if(_): {i >= 0 && i < SB_PICK_ROWS && top + i < n} [
        set(sb_pick): {top + i}!
        sb_picker_choose(_):
    ]
]

sb_pad_key_gui(r): key [
    set(r): 0
    set(picker): sb_picker?
    if(_): {picker = true} [
        sb_picker_key(_): key
        return(_): r
    ]
    set(ctrl): sb_ctrl?
