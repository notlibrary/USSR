    set(i): 0
    while(_): {i < n} [
        at(entry): lines i
        at(ly): entry 3
        if(_): {y < ly + lh && pick = n - 1 && y >= ly} [ set(pick): i ]
        set(i): {i + 1}
    ]
    at(first): lines 0
    at(fy): first 3
    if(_): {y < fy} [ set(pick): 0 ]
    at(entry): lines pick
    at(p): entry 0
    at(k): entry 2
    sb_para_text(t): p
    sb_wrap(starts): t
    sb_col_at_x(c): t starts k {x - SB_MARGIN}
    set(sb_prow): p!
    set(sb_pcol): c!
