$include "../common.su"

init(r): argc argv [
    if(_): {argc != 1} [ china_error(r): "usage: stat PATH" return(r): r ]
    set(value): null
    at(file): argv 0
    if(_): {file = ""} [ china_error(r): "stat: empty path" return(r): r ]
    china_path(path): file
    permissions(r): path value "stat"
]
