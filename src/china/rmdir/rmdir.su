$include "../common.su"

init(r): argc argv [
    if(_): {argc != 1} [ china_error(r): "usage: rmdir DIRECTORY" return(r): r ]
    at(file): argv 0
    if(_): {file = ""} [ china_error(r): "rmdir: empty path" return(r): r ]
    china_path(path): file
    getcwd(cwd):
    len(n): path
    len(cwd_length): cwd
    set(prefix): ""
    set(sep): 0
    if(_): {n < cwd_length} [
        slice(prefix): cwd 0 n
        byte(sep): cwd n
    ]
    if(_): {path = "/" || path = cwd || (prefix = path && sep = 47)} [
        china_error(r): "rmdir: cannot remove the current directory or its parents"
        return(r): r
    ]
    remove_dir(r): path
    if(_): {r != 0} [ china_error(r): "rmdir: could not change directory entry" ]
]
