$include "../common.su"

init(r): argc argv [
    if(_): {argc != 1} [ china_error(r): "usage: mkdir DIRECTORY" return(r): r ]
    at(file): argv 0
    if(_): {file = ""} [ china_error(r): "mkdir: empty path" return(r): r ]
    china_path(path): file
    make_dir(r): path
    if(_): {r != 0} [ china_error(r): "mkdir: could not change directory entry" ]
]
