$include "../common.su"

init(r): argc argv [
    if(_): {argc < 1 || argc > 2} [ china_error(r): "usage: tail FILE [LINES]" return(r): r ]
    at(file): argv 0
    china_path(path): file
    china_operand(arg): argv 1 "10"
    china_number(lines): arg 1000000
    if(_): {lines < 0} [ china_error(r): "tail: invalid line count" return(r): r ]
    china_text_size(size): path
    if(_): {size < 0} [ china_error(r): "tail: file unavailable" return(r): r ]
    if(_): {lines = 0} [ return(r): 0 ]
    set(end): size
    while(_): {end > 0} [
        set(start): {end - 4096}
        if(_): {start < 0} [ set(start): 0 ]
        # A range can cross an extent boundary. Collect the short reads.
        set(chunk): ""
        set(pos): start
        while(_): {pos < end} [
            china_read(part): path pos {end - pos}
            if(_): {part = null || part = ""} [ china_error(r): "tail: cannot read text file" return(r): r ]
            concat(chunk): chunk part
            len(n): part
            set(pos): {pos + n}
        ]
        set(i): {end - start - 1}
        while(_): {i >= 0} [
            byte(ch): chunk i
            if(_): {ch = 10 && start + i < size - 1} [
                set(lines): {lines - 1}
                if(_): {lines = 0} [
                    china_print_from(r): path {start + i + 1}
                    return(r): r
                ]
            ]
            set(i): {i - 1}
        ]
        set(end): start
    ]
    china_print_from(r): path 0
]
