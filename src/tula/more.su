        while(_): {i < n} [
            at(m): w i
            if(_): {m != "off"} [ push(_): modes m ]
            set(i): {i + 1}
        ]
        btput(_): doc "osnap" modes
        str_join(ms): modes " "
        set(r): "object snaps off"
        if(_): {ms != ""} [ concat(r): "object snaps: " ms ]
    ]
    elif(_): {cmd = "ortho" && n >= 2} [
        at(v): w 1
        btput(_): doc "ortho" {v = "on"}
        concat(r): "ortho " v
    ]
    elif(_): {cmd = "theme" && n >= 2} [
        at(t): w 1
        btput(_): doc "theme" t
        set(r): "ok"
    ]
    elif(_): {cmd = "help"} [
        set(r): "line pline circle arc rect polygon ellipse spline point text xline ray dim hatch | select move copy rotate scale mirror array offset fillet chamfer trim extend break join erase explode undo redo | layer color ltype lweight onlayer block insert symbols sheet | dist area length list bbox centroid view units purge audit bom theme osnap ortho | NAME = EXPRESSION"
    ]
    else(_): [ concat(r): "no command " cmd " (help lists them)" ]
]

# a script of commands, one a line; the answers, one a line
tl_commands(r): doc text [
    set(r): ""
    str_replace(t): text "\r" ""
    str_split(lines): t "\n"
    len(n): lines
    set(i): 0
    while(_): {i < n} [
        at(l): lines i
        str_trim(l): l
        str_starts(c): l "#"
        if(_): {l != "" && c = false} [
            tl_command(a): doc l
            concat(r): r a "\n"
        ]
        set(i): {i + 1}
    ]
]

# --- the scripting API on the current drawing

tula_new(r): [
    tl_doc_new(tl_current):
    set(r): 0
]

tula_doc(r): [
    if(_): {tl_current = null} [ tl_doc_new(tl_current): ]
    set(r): tl_current
]

tula_line(r): x1 y1 x2 y2 [
    tula_doc(d):
    tl_line_e(e): x1 y1 x2 y2
    tl_add(r): d e
]

tula_circle(r): cx cy rad [
    tula_doc(d):
    tl_circle_e(e): cx cy rad
    tl_add(r): d e
]

tula_arc(r): cx cy rad a0 a1 [
    tula_doc(d):
    tl_arc_e(e): cx cy rad a0 a1
    tl_add(r): d e
]

tula_rect(r): x1 y1 x2 y2 [
    tula_doc(d):
    tl_rect(e): x1 y1 x2 y2
    tl_add(r): d e
]

tula_polygon(r): cx cy rad sides [
    tula_doc(d):
    tl_polygon(e): cx cy rad sides false 90
    tl_add(r): d e
]

tula_text(r): x y h text [
    tula_doc(d):
    tl_text_e(e): x y h text
    tl_add(r): d e
]

tula_layer(r): name color [
    tula_doc(d):
    tl_layer_add(_): d name color
    btput(_): d "layer" name
    set(r): 0
]

tula_do(r): line [
    tula_doc(d):
    tl_command(r): d line
]

tula_save(r): path [
    tula_doc(d):
    tl_dxf(t): d "2000"
    writefile(r): path t
]

# --- the window: tula.su draws, loads, saves and clicks through these.
# Hash keys: tula_doc (the drawing but its entities, which stay in
# tula_entities) and tula_cmdbox (the command line, 0 when none).

tl_gui_doc(r): [
    set(r): tula_doc?
    set(es): tula_entities?
    btput(_): r "entities" es
]

tl_gui_store(r): doc [
    btget(es): doc "entities"
    set(tula_entities): es!
    set(tula_doc): doc!
    set(r): 0
]

# one entity on the canvas: its layer, colour, linetype; new kinds drawn
# as their parts
tl_draw(r): canvas e [
    set(r): 0
    set(doc): tula_doc?
    tl_visible(v): doc e
    if(_): {v = false} [ return(r): r ]
    btget(theme): doc "theme" "light"
    tl_prop(c): e "color" 256
    tl_prop(ln): e "layer" "0"
    set(aci): c
    if(_): {c = 256} [
        btget(layers): doc "layers"
        btget(l): layers ln null
        set(aci): 7
        if(_): {l != null} [ btget(aci): l "color" ]
    ]
    set(ink): TULA_INK
    set(tink): TULA_TEXT_INK
    if(_): {theme = "dark"} [
        set(ink): 14211288
        set(tink): 12632256
    ]
    if(_): {aci != 7} [
        tl_aci(ink): aci
        set(tink): ink
    ]
    tl_prop(lt): e "ltype" ""
    if(_): {lt = ""} [
        btget(layers): doc "layers"
        btget(l): layers ln null
        if(_): {l != null} [ btget(lt): l "ltype" ]
    ]
    # the pattern's units are 1.5 pixels (times the drawing's ltscale),
    # whatever the zoom, so dashes stay dashes
    set(view): tula_view?
    at(s): view 2
    if(_): {s <= 0} [ set(s): 1 ]
    btget(lts): doc "ltscale" 1
    # the line weight, by layer when the entity has none
    tl_prop(lw): e "lweight" -1
    if(_): {lw < 0} [
        btget(layers): doc "layers"
        btget(l): layers ln null
        if(_): {l != null} [ btget(lw): l "lweight" -1 ]
    ]
    tl_lweight_px(pen): lw
    # a heavy line's round ends would close its gaps: longer dashes
    set(grow): 1
    if(_): {pen > 1} [ set(grow): {pen * 0.75} ]
    if(_): {grow < 1} [ set(grow): 1 ]
    tl_ltype(pat): lt {1.5 * lts * grow / s}
    set(penon): tula_pen?
    if(_): {pen > 0 && penon = true} [ canvaspen(_): canvas pen ]
    tl_explode_for_draw(parts): doc e
    len(n): parts
    set(i): 0
    while(_): {i < n} [
        at(p): parts i
        at(k): p 0
        len(npat): pat
        if(_): {(k = "LINE" || k = "POLYLINE" || k = "CIRCLE" || k = "ARC") && npat > 0} [
            tl_path_pts(path): p s
            tl_dash_path(pieces): path pat 6000
            len(nq): pieces
            set(j): 0
            while(_): {j < nq} [
                at(q): pieces j
                tula_draw_entity(_): canvas q ink tink
                set(j): {j + 1}
            ]
        ]
        else(_): [ tula_draw_entity(_): canvas p ink tink ]
        set(i): {i + 1}
    ]
    if(_): {pen > 0 && penon = true} [ canvaspen(_): canvas 0 ]
]

tl_background(r): [
    set(doc): tula_doc?
    btget(theme): doc "theme" "light"
    set(r): TULA_BACKGROUND
    if(_): {theme = "dark"} [ set(r): 2105376 ]
]

# can the old writer save it (one layer, nothing but its entity kinds)?
tl_plain(r): doc [
    set(r): false
    btget(layers): doc "layers"
    btlen(nl): layers
    btget(blocks): doc "blocks"
    btlen(nb): blocks
    btget(raw): doc "raw"
    len(nr): raw
    if(_): {nl > 1 || nb > 0 || nr > 0} [ return(r): r ]
    btget(es): doc "entities"
    len(n): es
    set(i): 0
    while(_): {i < n} [
        at(e): es i
        tl_props(p): e
        at(k): e 0
        set(basic): {k = "LINE" || k = "CIRCLE" || k = "ARC" || k = "POLYLINE" || k = "POINT" || k = "TEXT"}
        if(_): {p != null || basic = false} [ return(r): r ]
        set(i): {i + 1}
    ]
    set(r): true
]

# after tula.su's reader: blocks, inserts, layers and kept entities
tl_gui_after_load(r): path entities [
    tl_doc_new(doc):
    read_bytes(b): path
    bytes_text(text): b
    tl_dxf_extras(x): text
    at(blocks): x 0
    at(ins): x 1
    at(raw): x 2
    at(layers): x 3
    btput(_): doc "blocks" blocks
    btput(_): doc "raw" raw
    btkeys(lk): layers
    len(n): lk
    set(i): 0
    while(_): {i < n} [
        at(k): lk i
        btget(le): layers k
        at(c): le 0
        at(lt): le 1
        abs(ac): c
        tl_layer_add(_): doc k ac
        if(_): {c < 0} [ tl_layer_set(_): doc k "on" false ]
        tl_layer_set(_): doc k "ltype" lt
        set(i): {i + 1}
    ]
    list_concat(entities): entities ins
    btput(_): doc "entities" entities
    set(tula_doc): doc!
    set(r): entities
    tl_recent_add(_): path
]

# the command line's Enter
tl_gui_command(r): [
    set(r): 0
    set(box): tula_cmdbox?
    if(_): {box = 0} [ return(r): r ]
    gettext(line): box
    if(_): {line = ""} [ return(r): r ]
    tl_gui_doc(doc):
    tl_command(answer): doc line
    tl_gui_store(_): doc
    settext(_): box ""
    tula_redraw(_):
    concat(m): line ": " answer
    tula_set_status(_): m
]

# a click's point after object snaps and ortho: [x y]
tl_gui_point(r): rawx rawy snapx snapy scale [
    set(doc): tula_doc?
    tl_pt(r): snapx snapy
    btget(modes): doc "osnap" null
    if(_): {modes != null} [
        len(nm): modes
        if(_): {nm > 0} [
            set(anchor): tula_anchor?
            set(from): null
            len(na): anchor
            if(_): {na = 2} [ set(from): anchor ]
            set(es): tula_entities?
            btput(_): doc "entities" es
            tl_osnap(s): doc rawx rawy {10.0 / scale} modes from
            if(_): {s != null} [
                at(sx): s 0
                at(sy): s 1
                tl_pt(r): sx sy
            ]
        ]
    ]
    btget(ortho): doc "ortho" false
    if(_): ortho [
        set(anchor): tula_anchor?
        len(na): anchor
        if(_): {na = 2} [
            at(ax): anchor 0
            at(ay): anchor 1
            at(px): r 0
            at(py): r 1
            tl_ortho(r): ax ay px py
        ]
    ]
]

# does an entity's outline cross the box, or lie partly inside it?
tl_crosses_box(r): doc e ax ay bx by [
    set(r): false
    tl_rect(box): ax ay bx by
    tl_explode_for_draw(parts): doc e
    len(np): parts
    set(i): 0
    while(_): {i < np} [
        at(p): parts i
        at(k): p 0
        if(_): {k = "POINT" || k = "TEXT"} [
            at(x): p 1
            at(y): p 2
            if(_): {x >= ax && x <= bx && y >= ay && y <= by} [
                set(r): true
                return(r): r
            ]
        ]
        else(_): [
            tl_intersect(hits): p box
            len(nh): hits
            if(_): {nh > 0} [
                set(r): true
                return(r): r
            ]
            # wholly inside the box (a part of it)
            tl_points_of(ps): p
            len(npt): ps
            if(_): {npt >= 2} [
                at(x): ps 0
                at(y): ps 1
                if(_): {x >= ax && x <= bx && y >= ay && y <= by} [
                    set(r): true
                    return(r): r
                ]
            ]
        ]
        set(i): {i + 1}
    ]
]
