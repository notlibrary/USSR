# Tula's interactive line/circle CAD API, backed by the native geometry core.
$include "../petersburg/petersburg.su"

tulainitialize(canvas): window status filename [
    tula_initialize(canvas): window status filename
]

tulatool(result): name [
    tula_set_tool(result): name
]

tulaclick(result): canvas x y [
    tula_canvas_click(result): canvas x y
]

tulasave(result): [
    tula_save_dxf(result):
]
