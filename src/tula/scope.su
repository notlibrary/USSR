# scope.su - Tula's cursor: a crosshair ("scope", as LibreCAD draws one)
# in place of the mouse arrow, and live previews of the active drawing tool
# being drawn.
#
# The crosshair is two dashed lines across the whole canvas through the
# point a click would take (enabled grid/object snaps applied), with a
# small pick box at the centre and the point's coordinates beside it.
# Once the first point of a line or circle is down, the line to the
# cursor (or the circle through it) is drawn dashed, with its length or
# radius. The system cursor is hidden over the canvas.
#
# The canvas "motion" callback only keeps the position (it comes once per
# frame); tsc_loop redraws when it changed, so a fast mouse never queues
# more work than one redraw. And that redraw is only the overlay: the
# drawing is marked with canvaskeep after it is drawn, and a move drops
# the old crosshair (canvasback) and draws the new one, its dashes cut
# natively (canvasdash). Where Petersburg lacks these (tula_fast false)
# everything is drawn again, as before. Hash keys: tula_mx tula_my (-1:
# the cursor is away), tula_mdirty and tula_fast.
$once

$define TSC_CROSS 14697012
$define TSC_PREVIEW 2201331
$define TSC_DASH 9
$define TSC_GAP 6
$define TSC_BOX 5

tsc_state(r): [
    set(tula_mx): -1!
    set(tula_my): -1!
    set(tula_mdirty): false!
    set(tula_mbusy): false!
    set(tula_fast): false!
    set(r): 0
]

# the canvas "motion" callback body
tsc_motion(r): canvas x y [
    set(r): 0
    set(bar): tula_bar?
    if(_): {bar != ""} [
        mouseheld(held): canvas
        uilock(_):
        tula_bar_drag(_): x y {held = 1}
        uiunlock(_):
        return(r): r
    ]
    set(tula_mx): x!
    set(tula_my): y!
    set(tula_mdirty): true!
    # redraw now, unless a redraw is already running: that one goes on
    # until the last position is drawn (tsc_loop catches any it missed)
    set(busy): tula_mbusy?
    if(_): {busy = true} [ return(r): r ]
    set(tula_mbusy): true!
    set(more): true
    while(_): more [
        uilock(_):
        set(tula_mdirty): false!
        tsc_refresh(_):
        uiunlock(_):
        set(more): tula_mdirty?
    ]
    set(tula_mbusy): false!
]

# the point a click at canvas x, y would take: [world x, world y]
tsc_point(r): x y [
    set(v): tula_view?
    at(ox): v 0
    at(oy): v 1
    at(s): v 2
    tula_pick_point(r): {(x - ox) / s} {(oy - y) / s} s
]

# a dashed line from (x1, y1) to (x2, y2)
tsc_dashed(r): canvas x1 y1 x2 y2 color [
    set(r): 0
    set(fast): tula_fast?
    if(_): {fast = true} [
        canvasdash(_): canvas x1 y1 x2 y2 color TSC_DASH TSC_GAP
        return(r): r
    ]
    set(dx): {x2 - x1}
    set(dy): {y2 - y1}
    sqrt(len_): {dx * dx + dy * dy}
    if(_): {len_ < 1} [ return(r): r ]
    set(ux): {dx / len_}
    set(uy): {dy / len_}
    set(d): 0
    while(_): {d < len_} [
        set(e): {d + TSC_DASH}
        if(_): {e > len_} [ set(e): len_ ]
        canvasline(_): canvas {x1 + ux * d} {y1 + uy * d} {x1 + ux * e} {y1 + uy * e} color
        set(d): {e + TSC_GAP}
    ]
]

# a dashed circle: arcs of about TSC_DASH pixels
tsc_dashed_circle(r): canvas cx cy radius color [
    set(r): 0
    if(_): {radius < 1} [ return(r): r ]
    set(fast): tula_fast?
    if(_): {fast = true} [
        canvasdashcircle(_): canvas cx cy radius color TSC_DASH TSC_GAP
        return(r): r
    ]
    set(circ): {2 * 3.14159265 * radius}
    str_trunc(n): {circ / (TSC_DASH + TSC_GAP)}
    if(_): {n < 8} [
        canvascircle(_): canvas cx cy radius color
        return(r): r
    ]
    if(_): {n > 120} [ set(n): 120 ]
    set(step): {360.0 / n}
    set(on): {step * TSC_DASH / (TSC_DASH + TSC_GAP)}
    set(i): 0
    while(_): {i < n} [
        canvasarc(_): canvas cx cy radius {i * step} {i * step + on} color
        set(i): {i + 1}
    ]
]

# drawn last by tula_redraw: the preview, then the crosshair over it
tsc_overlay(r): canvas [
    set(r): 0
    set(mx): tula_mx?
    set(my): tula_my?
    if(_): {mx < 0 || my < 0} [ return(r): r ]
    set(boxing): tula_sel_on?
    if(_): {boxing = true} [
        set(from): tula_sel_from?
        at(bx): from 0
        at(by): from 1
        set(color): 2003199
        if(_): {mx < bx} [ set(color): 3381555 ]
        tsc_dashed(_): canvas bx by mx by color
        tsc_dashed(_): canvas mx by mx my color
        tsc_dashed(_): canvas mx my bx my color
        tsc_dashed(_): canvas bx my bx by color
    ]
    tsc_point(pt): mx my
    at(wx): pt 0
    at(wy): pt 1
    tula_to_screen_x(px): wx
    tula_to_screen_y(py): wy
    # the active tool's preview follows the same snapped cursor as a click
    set(tool): tula_tool?
    set(anchor): tula_anchor?
    len(na): anchor
    set(note): ""
    if(_): {na >= 2 && tool = "line"} [
        set(last): {na - 2}
        at(ax): anchor last
        at(ay): anchor {last + 1}
        tula_to_screen_x(sax): ax
        tula_to_screen_y(say): ay
        tsc_dashed(_): canvas sax say px py TSC_PREVIEW
        tl_readout(readout): ax ay wx wy
        set(note): readout
    ]
    elif(_): {na = 2 && tool = "circle"} [
        at(ax): anchor 0
        at(ay): anchor 1
        tula_to_screen_x(sax): ax
        tula_to_screen_y(say): ay
        set(dx): {wx - ax}
        set(dy): {wy - ay}
        sqrt(dist): {dx * dx + dy * dy}
        str_from_number(ds): dist 3
        set(v): tula_view?
        at(s): v 2
        tsc_dashed_circle(_): canvas sax say {dist * s} TSC_PREVIEW
        tsc_dashed(_): canvas sax say px py TSC_PREVIEW
        concat(note): "radius " ds
    ]
    elif(_): {na = 2 && tool = "arc"} [
        at(ax): anchor 0
        at(ay): anchor 1
        tula_to_screen_x(sax): ax
        tula_to_screen_y(say): ay
        set(v): tula_view?
        at(s): v 2
        tl_dist(dist): ax ay wx wy
        str_from_number(dist_text): dist 3
        tsc_dashed_circle(_): canvas sax say {dist * s} TSC_PREVIEW
        tsc_dashed(_): canvas sax say px py TSC_PREVIEW
        concat(note): "radius " dist_text
    ]
    elif(_): {na = 4 && tool = "arc"} [
        at(ax): anchor 0
        at(ay): anchor 1
        at(radius): anchor 2
        at(start): anchor 3
        tl_angle(angle): ax ay wx wy
        tl_norm_deg(sweep): {angle - start}
        str_from_number(angle_text): angle 1
        set(v): tula_view?
        at(s): v 2
        tula_to_screen_x(sax): ax
        tula_to_screen_y(say): ay
        canvasarc(_): canvas sax say {radius * s} start {start + sweep} TSC_PREVIEW
        tsc_dashed(_): canvas sax say px py TSC_PREVIEW
        concat(note): "angle " angle_text
    ]
    elif(_): {na >= 2 && tool = "spline"} [
        vec(ctrl): ""
        list_concat(ctrl): ctrl anchor
        push(_): ctrl wx
        push(_): ctrl wy
        len(nctrl): ctrl
        str_trunc(npoints): {nctrl / 2}
        set(steps): {npoints * 8}
        if(_): {steps < 24} [ set(steps): 24 ]
        if(_): {steps > 96} [ set(steps): 96 ]
        tl_bspline_points(curve): 3 ctrl steps
        len(ncurve): curve
        set(i): 0
        str_from_int(npoints_text): npoints
        if(_): {ncurve >= 4} [
            at(x1): curve 0
            at(y1): curve 1
            tula_to_screen_x(sx1): x1
            tula_to_screen_y(sy1): y1
            set(i): 2
            while(_): {i + 1 < ncurve} [
                at(x2): curve i
                at(y2): curve {i + 1}
                tula_to_screen_x(sx2): x2
                tula_to_screen_y(sy2): y2
                tsc_dashed(_): canvas sx1 sy1 sx2 sy2 TSC_PREVIEW
                set(sx1): sx2
                set(sy1): sy2
                set(i): {i + 2}
            ]
        ]
        concat(note): "spline " npoints_text " points"
    ]
    # the crosshair across the canvas and its pick box
    getwidth(w): canvas
    getheight(h): canvas
    if(_): {w < 10} [ set(w): TULA_EXTENT_X ]
    if(_): {h < 10} [ set(h): TULA_EXTENT_Y ]
    tsc_dashed(_): canvas 0 py w py TSC_CROSS
    tsc_dashed(_): canvas px 0 px h TSC_CROSS
    canvasrect(_): canvas {px - TSC_BOX} {py - TSC_BOX} {TSC_BOX * 2} {TSC_BOX * 2} TSC_CROSS
    str_from_number(xs): wx 3
    str_from_number(ys): wy 3
    concat(t): xs ", " ys
    if(_): {note != ""} [ concat(t): t "   " note ]
    canvastext(_): canvas {px + 12} {py + 10} t TSC_CROSS
]

# a move: just the overlay again over the kept drawing (or all of it)
tsc_refresh(r): [
    set(r): 0
    set(canvas): tula_canvas?
    set(fast): tula_fast?
    if(_): {fast = true} [
        canvasback(_): canvas
        tsc_overlay(_): canvas
        return(r): r
    ]
    tula_redraw(_):
]

# the window's redraw loop: a redraw when the cursor moved
tsc_loop(r): window [
    set(r): 0
    alive(up): window
    set(canvas): tula_canvas?
    set(lastw): -1
    set(lasth): -1
    getenv(os): "OS"
    while(_): up [
        if(_): {os = "Moscow"} [
            petersburg_poll_events(running):
            alive(still_open): window
            if(_): {running = 0 || still_open = false} [ return(r): r ]
        ]
        set(dirty): tula_mdirty?
        if(_): {dirty = true} [
            uilock(_):
            set(tula_mdirty): false!
            tsc_refresh(_):
            uiunlock(_):
        ]
        # the select tool's box: done when the button is let go
        set(boxing): tula_sel_on?
        if(_): {boxing = true} [
            mouseheld(held): canvas
            if(_): {held = 0} [
                uilock(_):
                set(mx): tula_mx?
                set(my): tula_my?
                tula_sel_finish(_): mx my
                uiunlock(_):
            ]
        ]
        # a new size (the window resized, maximized or restored): the
        # whole drawing again, so the grid and the scrollbars fit it
        getwidth(w): canvas
        getheight(h): canvas
        if(_): {w != lastw || h != lasth} [
            if(_): {lastw >= 0} [
                uilock(_):
                tula_redraw(_):
                uiunlock(_):
            ]
            set(lastw): w
            set(lasth): h
        ]
        sleep(_): 15
        alive(up): window
    ]
]
