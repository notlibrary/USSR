            uq_reg(_uqx_v): _uqx_a
            set(_uqx_true): false
            if(_): _uqx_v [
                set(_uqx_true): true
            ]
            if(_): {(_uqx_op = 49 && _uqx_true) || (_uqx_op = 50 && _uqx_true = false)} [
                set(uq_ip): _uqx_imm
            ]
        ]
        elif(_): {_uqx_op = 65} [
            uq_reg(_uqx_v): _uqx_a
            print(_): _uqx_v
        ]
        elif(_): {_uqx_op = 66} [
            if(_): {_uqx_c > _uqx_a || _uqx_a >= 31} [
                uq_error(_): "invalid CONCAT operands"
            ]
            set(_uqx_text): ""
            set(_uqx_k): 0
            while(_): {_uqx_k < _uqx_c} [
                uq_reg(_uqx_v): _uqx_k
                typeof(_uqx_vt): _uqx_v
                if(_): {_uqx_vt != "string"} [
                    uq_error(_): "CONCAT requires strings"
                ]
                concat(_uqx_text): _uqx_text _uqx_v
                set(_uqx_k): {_uqx_k + 1}
            ]
            uq_setreg(_): _uqx_a _uqx_text
        ]
        elif(_): {_uqx_op = 68} [
            at(_uqx_name): uq_strings _uqx_imm
            uq_oop(_uqx_v): _uqx_name _uqx_b
            uq_setreg(_): _uqx_a _uqx_v
        ]
        elif(_): {_uqx_op = 70} [
            random64(_uqx_v):
            uq_setreg(_): _uqx_a _uqx_v
        ]
        elif(_): {_uqx_op = 71} [
            uq_reg(_uqx_v): 0
            uq_is_integer(_uqx_ii): _uqx_v
            if(_): {_uqx_ii = false} [
                uq_error(_): "seed_random64 requires an integer seed"
