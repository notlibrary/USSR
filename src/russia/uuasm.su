]

uq_is_assembly(r): path [
    len(_uqia_n): path
    set(r): false
    if(_): {_uqia_n > 3} [
        slice(_uqia_ext): path {_uqia_n - 3} 3
        str_lower(_uqia_ext): _uqia_ext
        set(r): {_uqia_ext = ".ua"}
    ]
    if(_): {_uqia_n > 6} [
        slice(_uqia_ext): path {_uqia_n - 6} 6
        str_lower(_uqia_ext): _uqia_ext
        if(_): {_uqia_ext = ".uuasm"} [
            set(r): true
        ]
    ]
]

# Entry from russia.su's init: mode "dump" prints the program, anything else
# runs it. Returns the process status.
uq_main(r): path mode [
    uq_assemble(_uqm_err): path
    # An assembly error is reported as ussr reports it: the message alone
    # on stderr and exit status 1.
    if(_): {_uqm_err != ""} [
        concat(_uqm_line): _uqm_err "\n"
        write_stderr(_): _uqm_line
        set(r): 1
        return(_): r
    ]
    if(_): {mode = "dump"} [
        uq_dump(_):
    ]
    else(_): [
        uq_execute(_):
    ]
    set(r): 0
]
