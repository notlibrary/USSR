        ]
        elif(_): {_uqx_op >= 16 && _uqx_op <= 34 && _uqx_op != 21} [
            uq_reg(_uqx_vb): _uqx_b
            uq_reg(_uqx_vc): _uqx_c
            uq_binary(_uqx_v): _uqx_op _uqx_vb _uqx_vc
