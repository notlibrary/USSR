            push(_): pjn_q pjn_a
            add(pjn_k): pjn_k 2
        ]
        set(pjn_p): pjn_q
        len(pjn_n): pjn_p
    ]
    set(r): ""
    if(_): {pjn_n = 1} [ at(r): pjn_p 0 ]
