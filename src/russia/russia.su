# ---------- parser: AST dump (preorder, depth field) ----------
ps_dump(r): nd depth [
    getf(ps_d_tag): nd "tag"
    getf(ps_d_s1): nd "s1"
    getf(ps_d_s2): nd "s2"
    getf(ps_d_n1): nd "n1"
    getf(ps_d_kids): nd "kids"
    len(ps_d_nk): ps_d_kids
    template(_): "INT;INT;INT;STR;STR;INT;INT;STR" depth ps_d_tag ps_d_tag ps_d_s1 ps_d_s2 ps_d_n1 ps_d_nk "\n"
    ps_dump_kids(r): ps_d_kids 0 depth
]
ps_dump_kids(r): kids idx depth [
    len(ps_kn): kids
    set(r): 0
    if(_): {idx < ps_kn} [
        at(ps_kd): kids idx
        add(ps_d2): depth 1
        ps_dump(_): ps_kd ps_d2
        add(ps_i2): idx 1
        ps_dump_kids(r): kids ps_i2 depth
    ]
]

# ---------- parser stage entry ----------
ps_parse(r): src [
    set(ps_i): 0
    set(ps_stop): 0
    vec(ps_opstack): ""
    set(ps_err): ""
    if(_): {ps_nddef = 0} [
        struct(nd): "tag:number" "s1:string" "s2:string" "n1:number" "kids:any"
        set(ps_nddef): 1
    ]
    ps_prog(ps_root): 
    set(r): 0
    if(_): {ps_stop = 1} [
        set(r): 1
    ]
]
# store pair: n=name v=value t=alias-target
rt_find_i(r): nm i [
    len(rt_fl): rt_store
    set(r): {0 - 1}
    if(_): {i < rt_fl} [
        at(rt_fp): rt_store i
        getf(rt_fn): rt_fp "n"
        set(rt_fok): 0
        if(_): {rt_fn = nm} [
            set(rt_fok): 1
        ]
        if(_): {rt_fok = 1} [
            set(r): i
        ]
        if(_): {rt_fok = 0} [
            add(rt_fi2): i 1
            rt_find_i(r): nm rt_fi2
        ]
    ]
]
rt_find(r): nm [
    rt_find_i(r): nm 0
]
rt_write(r): nm val [
    rt_find(rt_wi): nm
    if(_): {rt_wi < 0} [
        new(rt_wp): "rt_sp" nm val ""
        setf(_): rt_wp "n" nm
        setf(_): rt_wp "v" val
        setf(_): rt_wp "t" ""
        push(_): rt_store rt_wp
    ]
    if(_): {rt_wi + 1 > 0} [
        at(rt_wp2): rt_store rt_wi
        getf(rt_wt): rt_wp2 "t"
        if(_): {rt_wt = ""} [
            setf(_): rt_wp2 "v" val
        ]
        set(rt_we): 0
        if(_): {rt_wt = ""} [
            set(rt_we): 1
        ]
        if(_): {rt_we = 0} [
            rt_write(r): rt_wt val
        ]
    ]
    set(r): 0
]
# An undefined name reads as null, as a bare command argument does in
# ussr; rt_undef tells callers that must fail on it (expressions).
rt_read(r): nm [
    rt_find(rt_ri): nm
    set(r): null
    if(_): {rt_ri < 0} [
        set(rt_undef): 1
    ]
    if(_): {rt_ri + 1 > 0} [
        at(rt_rp): rt_store rt_ri
        getf(rt_rt): rt_rp "t"
        if(_): {rt_rt = ""} [
            getf(r): rt_rp "v"
        ]
        set(rt_re): 0
        if(_): {rt_rt = ""} [
            set(rt_re): 1
        ]
        if(_): {rt_re = 0} [
            rt_read(r): rt_rt
        ]
    ]
]

# eval(r): src parses src as a program of its own. 0 when it parsed (the
# tree is in ps_root); a lexer, grammar or compiler error is reported as
# ussr reports it ("<eval>:LINE: reason" on stderr) and fails the process.
rt_eval_parse(r): src [
    set(r): 1
    typeof(rt_ept): src
    if(_): {rt_ept != "string"} [
        rt_fatal(_):
    ]
    vec(rt_epnone): ""
    ck_run(rt_epck): src "<eval>" rt_epnone rt_epnone
    if(_): {rt_epck = 1} [
        write_stderr(_): ck_msg
        rt_fatal(_):
    ]
    set(rt_epq): ps_quiet
    set(ps_quiet): 1
    vec(lx_tokens): "lx_Tok"
    lx_scan(rt_epl): src
    if(_): {rt_epl = 0} [
        ps_parse(r): src
    ]
    set(ps_quiet): rt_epq
    # the checker accepted it: a parse failure here is this parser's own
    if(_): {r != 0} [ rt_fatal(_): ]
]

# A preprocessor error on stderr as ussr prints it ("USSR: reason"; some
# fail without a message).
rt_pp_report(r): [
    set(r): 0
    if(_): {pp_msg != ""} [
        concat(rt_ppm): "USSR: " pp_msg
        concat(rt_ppm): rt_ppm "\n"
        write_stderr(_): rt_ppm
    ]
]

# Fail the interpreted program the way ussr fails it: the host reports
# "USSR scheduler: process 2 (init) failed" and exits 1, the exact output
# ussr gives for the same error (russia.su itself runs as that process).
rt_fatal(r): [
    set(r): {__russia_fatal_error + 0}
]

# expression evaluation: node -> value in r
ex_val(r): nd [
    if(_): {ps_stop = 0} [
        getf(rt_ev_t): nd "tag"
        ex_val_t(r): nd rt_ev_t
    ]
]
ex_val_t(r): nd t [
    set(r): 0
    if(_): {ps_stop = 0} [
        if(_): {t = 4} [
            getf(rt_s1): nd "s1"
            rt_read(r): rt_s1
        ]
        if(_): {t = 5} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 6} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 7} [
            getf(r): nd "s1"
        ]
        if(_): {t = 8} [
            getf(rt_b1): nd "s1"
            set(r): {1 = 2}
            if(_): {rt_b1 = "true"} [
                set(r): {1 = 1}
            ]
        ]
        if(_): {t = 9} [
            set(r): null
        ]
        if(_): {t = 10} [
            getf(rt_s1): nd "s1"
            decode(r): rt_s1
        ]
        if(_): {t = 12} [
            ex_bin(r): nd
        ]
        if(_): {t = 13} [
            ex_un(r): nd
        ]
    ]
]
ex_bin(r): nd [
    getf(rt_bo): nd "s1"
    getf(rt_bk): nd "kids"
    at(rt_bl): rt_bk 0
    at(rt_br): rt_bk 1
    ex_bin_a(r): rt_bo rt_bl rt_br
]
ex_bin_a(r): op ln rn [
    ex_val(rt_lx): ln
    ex_bin_b(r): op rt_lx rn
]
ex_bin_b(r): op lv rn [
    ex_val(rt_rx): rn
    ex_bin_do(r): op lv rt_rx
]
ex_bin_do(r): op lv rv [
    set(r): 0
    if(_): {op = "+"} [
        add(r): lv rv
    ]
    if(_): {op = "-"} [
        sub(r): lv rv
    ]
    if(_): {op = "*"} [
        mul(r): lv rv
    ]
    if(_): {op = "/"} [
        div(r): lv rv
    ]
    if(_): {op = "%"} [
        mod(r): lv rv
    ]
    if(_): {op = "="} [
        set(r): {lv = rv}
    ]
    if(_): {op = "!="} [
        set(r): {lv != rv}
    ]
    if(_): {op = "<"} [
        set(r): {lv < rv}
    ]
    if(_): {op = "<="} [
        set(r): {lv <= rv}
    ]
    if(_): {op = ">"} [
        set(r): {lv > rv}
    ]
    if(_): {op = ">="} [
        set(r): {lv >= rv}
    ]
    if(_): {op = "&&"} [
        set(r): {lv && rv}
    ]
    if(_): {op = "||"} [
        set(r): {lv || rv}
    ]
    if(_): {op = "<<"} [
        set(r): {lv << rv}
    ]
    if(_): {op = ">>"} [
        set(r): {lv >> rv}
    ]
    if(_): {op = "^"} [
        set(r): {lv ^ rv}
    ]
    if(_): {op = "&"} [
        set(r): {lv & rv}
    ]
    if(_): {op = "|"} [
        set(r): {lv | rv}
    ]
]
ex_un(r): nd [
    getf(rt_uo): nd "s1"
    getf(rt_uk): nd "kids"
    at(rt_uc): rt_uk 0
    ex_val(rt_uv): rt_uc
    if(_): {rt_uo = "-"} [
        sub(r): 0 rt_uv
    ]
    if(_): {rt_uo = "!"} [
        set(r): {rt_uv = false}
    ]
]
# ---- flow state: 0 normal 1 break 2 continue 3 return (deepest-writer discipline) ----

# ---- function definitions table ----
rt_reg(r): cmd [
    getf(rt_rn): cmd "s1"
    getf(rt_rr): cmd "s2"
    getf(rt_rk): cmd "kids"
    len(rt_rkl): rt_rk
    set(rt_rb): {0 - 1}
    if(_): {rt_rkl > 0} [
        sub(rt_rl1): rt_rkl 1
        at(rt_rlast): rt_rk rt_rl1
        getf(rt_rlt): rt_rlast "tag"
        if(_): {rt_rlt = 3} [
            set(rt_rb): rt_rl1
        ]
    ]
    vec(rt_prm): ""
    set(rt_ri): 0
    ex_reg_i(r): cmd rt_prm rt_ri rt_rb
]
ex_reg_i(r): cmd prm i blim [
    if(_): {i < blim} [
        getf(rt_rk2): cmd "kids"
        at(rt_pk): rt_rk2 i
        push(_): prm rt_pk
        add(rt_ri2): i 1
        ex_reg_i(r): cmd prm rt_ri2 blim
    ]
    if(_): {i = blim} [
        getf(rt_rk3): cmd "kids"
        set(rt_body): {0 - 1}
        if(_): {blim + 1 > 0} [
            at(rt_body): rt_rk3 blim
        ]
        getf(rt_nm2): cmd "s1"
        getf(rt_rt2): cmd "s2"
        new(rt_fd): "rt_fd" rt_nm2 prm rt_rt2 rt_body
        setf(_): rt_fd "n" rt_nm2
        setf(_): rt_fd "prm" prm
        setf(_): rt_fd "ret" rt_rt2
        setf(_): rt_fd "body" rt_body
        push(_): rt_fdefs rt_fd
        set(r): 0
    ]
]
rt_findf_i(r): nm i [
    set(r): {0 - 1}
    if(_): {i + 1 > 0} [
        at(rt_fp): rt_fdefs i
        getf(rt_fn): rt_fp "n"
        if(_): {rt_fn = nm} [
            set(r): i
        ]
        if(_): {rt_fn != nm} [
            sub(rt_fi2): i 1
            rt_findf_i(r): nm rt_fi2
        ]
    ]
]
rt_findf(r): nm [
    len(rt_fl2): rt_fdefs
    set(r): {0 - 1}
    if(_): {rt_fl2 > 0} [
        sub(rt_fstart): rt_fl2 1
        rt_findf_i(r): nm rt_fstart
    ]
]

# ---- function call (save-vec as param: recursion-safe) ----
rt_call(r): fd args cret [
    vec(rt_sv): ""
    getf(rt_cp): fd "prm"
    len(rt_cn): rt_cp
    # Evaluate every argument before binding any parameter, as ussr does:
    # f(r): b a with parameters a b must not see the freshly bound a.
    vec(rt_avals): ""
    getf(rt_cak): args "kids"
    set(rt_cai): 0
    while(_): {rt_cai < rt_cn} [
        at(rt_can): rt_cak rt_cai
        ex_val(rt_cav): rt_can
        push(_): rt_avals rt_cav
        add(rt_cai): rt_cai 1
    ]
    ex_bind(r): fd rt_avals rt_cp rt_sv 0 rt_cn
    ex_alias(r): fd cret rt_sv
    getf(rt_cb): fd "body"
    ex_block(_): rt_cb
    if(_): {rt_flow = 3} [
        set(rt_flow): 0
        rt_write(_): cret rt_rv
    ]
    add(rt_cn1): rt_cn 1
    ex_rest(r): rt_sv 0 rt_cn1
    set(r): 0
]
ex_bind(r): fd avals prm sv i n [
    if(_): {i < n} [
        at(rt_bn): prm i
        getf(rt_bnm): rt_bn "s1"
        at(rt_av): avals i
        rt_find(rt_bi): rt_bnm
        new(rt_sp2): "rt_sv" rt_bnm 0 0 ""
        setf(_): rt_sp2 "n" rt_bnm
        if(_): {rt_bi < 0} [
            setf(_): rt_sp2 "had" 0
            setf(_): rt_sp2 "v" 0
            setf(_): rt_sp2 "t" ""
        ]
        if(_): {rt_bi + 1 > 0} [
            setf(_): rt_sp2 "had" 1
            at(rt_bp): rt_store rt_bi
            getf(rt_bv): rt_bp "v"
            getf(rt_bt): rt_bp "t"
            setf(_): rt_sp2 "v" rt_bv
            setf(_): rt_sp2 "t" rt_bt
        ]
        push(_): sv rt_sp2
        rt_write(_): rt_bnm rt_av
        add(rt_bi2): i 1
        ex_bind(r): fd avals prm sv rt_bi2 n
    ]
    if(_): {i = n} [
        set(r): 0
    ]
]
ex_alias(r): fd cret sv [
    getf(rt_anm): fd "ret"
    rt_find(rt_ai): rt_anm
    new(rt_ap): "rt_sv" rt_anm 0 0 ""
    setf(_): rt_ap "n" rt_anm
    set(rt_asame): 0
    if(_): {rt_anm = cret} [ set(rt_asame): 1 ]
    if(_): {rt_ai < 0} [
        setf(_): rt_ap "had" 0
        setf(_): rt_ap "v" 0
        setf(_): rt_ap "t" ""
        new(rt_np): "rt_sp" rt_anm 0 ""
        setf(_): rt_np "n" rt_anm
        setf(_): rt_np "v" 0
        if(_): {rt_asame = 0} [
            setf(_): rt_np "t" cret
        ]
        push(_): rt_store rt_np
    ]
    if(_): {rt_ai + 1 > 0} [
        setf(_): rt_ap "had" 1
        at(rt_op): rt_store rt_ai
        getf(rt_ov): rt_op "v"
        getf(rt_ot): rt_op "t"
        setf(_): rt_ap "v" rt_ov
        setf(_): rt_ap "t" rt_ot
        if(_): {rt_asame = 0} [
            setf(_): rt_op "t" cret
        ]
        if(_): {rt_asame = 1} [
            setf(_): rt_ap "had" 2
        ]
    ]
    push(_): sv rt_ap
    set(r): 0
]
ex_rest(r): sv i n [
    if(_): {i < n} [
        at(rt_rp2): sv i
        getf(rt_rsn): rt_rp2 "n"
        getf(rt_rsh): rt_rp2 "had"
        if(_): {rt_rsh = 1} [
            rt_find(rt_ri3): rt_rsn
            if(_): {rt_ri3 + 1 > 0} [
                at(rt_rpp): rt_store rt_ri3
                getf(rt_rvv): rt_rp2 "v"
                getf(rt_rtt): rt_rp2 "t"
                setf(_): rt_rpp "v" rt_rvv
                setf(_): rt_rpp "t" rt_rtt
            ]
        ]
        add(rt_ri4): i 1
        ex_rest(r): sv rt_ri4 n
    ]
    if(_): {i = n} [
        set(r): 0
    ]
]
# ---- command execution ----
ex_cmd(r): nd [
    if(_): {rt_flow = 0} [
        getf(rt_cm): nd "s1"
        ex_cmd_n(r): nd rt_cm
    ]
]
ex_cmd_n(r): nd nm [
    set(r): 0
    if(_): {rt_flow = 0} [
        if(_): {nm = "set"} [
            getf(rt_sk): nd "kids"
            len(rt_skn): rt_sk
            getf(rt_dn): nd "s2"
            if(_): {rt_skn = 1} [
                at(rt_s0): rt_sk 0
                ex_val(rt_dv): rt_s0
                rt_write(_): rt_dn rt_dv
            ]
            if(_): {rt_skn = 2} [
                at(rt_s0): rt_sk 0
                at(rt_s1b): rt_sk 1
                ex_val(rt_didx): rt_s0
                ex_val(rt_dval): rt_s1b
                rt_read(rt_dvec): rt_dn
                set(rt_dvec): rt_didx rt_dval
            ]
        ]
        if(_): {nm = "get"} [
            getf(rt_gk): nd "kids"
            len(rt_gkn): rt_gk
            getf(rt_gv2): nd "s2"
            if(_): {rt_gkn = 1} [
                at(rt_g0): rt_gk 0
                getf(rt_gdn): rt_g0 "s1"
                rt_read(rt_gval): rt_gv2
                rt_write(_): rt_gdn rt_gval
            ]
            if(_): {rt_gkn = 2} [
                at(rt_g0): rt_gk 0
                ex_val(rt_gidx): rt_g0
                rt_read(rt_gvec): rt_gv2
                get(rt_gvec): rt_gidx rt_gval2
                at(rt_g1): rt_gk 1
                getf(rt_gdn2): rt_g1 "s1"
                rt_write(_): rt_gdn2 rt_gval2
            ]
        ]
        if(_): {nm = "template"} [
            ex_template(r): nd
        ]
        if(_): {nm = "print"} [
            getf(rt_pk): nd "kids"
            ex_print_i(r): rt_pk 0
        ]
        if(_): {nm = "add"} [
            ex_arith(r): nd nm
        ]
        if(_): {nm = "sub"} [
            ex_arith(r): nd nm
        ]
        if(_): {nm = "mul"} [
            ex_arith(r): nd nm
        ]
        if(_): {nm = "div"} [
            ex_arith(r): nd nm
        ]
        if(_): {nm = "mod"} [
            ex_arith(r): nd nm
        ]
        if(_): {nm = "concat"} [
            ex_concat(r): nd
        ]
        if(_): {nm = "break"} [
            set(rt_flow): 1
        ]
        if(_): {nm = "continue"} [
            set(rt_flow): 2
        ]
        if(_): {nm = "return"} [
            getf(rt_rk2): nd "kids"
            at(rt_r0): rt_rk2 0
            ex_val(rt_rvv): rt_r0
            set(rt_rv): rt_rvv
            set(rt_flow): 3
            getf(rt_rn2): nd "s2"
            rt_write(_): rt_rn2 rt_rvv
        ]
        if(_): {nm = "while"} [
            ex_while(r): nd
        ]
        if(_): {nm = "for"} [
            ex_for(r): nd
        ]
        if(_): {nm = "scan"} [
            ex_scan(r): nd
        ]
        if(_): {nm = "push"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "at"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "len"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "typeof"} [
            ex_oop(r): nd nm
        ]
        rt_host_call(rt_ish): nd nm
        if(_): {rt_ish = 1} [
            getf(rt_hk): nd "kids"
            vec(rt_hv): ""
            len(rt_hkn): rt_hk
            set(rt_hki): 0
            while(_): {rt_hki < rt_hkn} [
                at(rt_hkc): rt_hk rt_hki
                ex_val(rt_hkx): rt_hkc
                push(_): rt_hv rt_hkx
                add(rt_hki): rt_hki 1
            ]
            rt_host(rt_hres): nm rt_hv
            getf(rt_hr): nd "s2"
            rt_write(_): rt_hr rt_hres
        ]
        if(_): {nm = "getf"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "vec"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "encode"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "new"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "struct"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "setf"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "decode"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "byte"} [
            ex_oop(r): nd nm
        ]
        if(_): {nm = "slice"} [
            ex_oop(r): nd nm
