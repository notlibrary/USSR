    struct(sc_pr): "pid:number" "name:string" "state:number" "ip:number" "sp:number" "regs:vector" "frames:vector" "store:vector" "wake_at:number" "wait_pid:number" "wreg:number" "result:any"
    vec(sc_procs): "sc_pr"
    vec(sc_runq): ""
    vec(sc_marks): ""
    set(sc_cur): 0
    set(sc_tick): 0
    set(vm_suspend): 0
    set(vm_qleft): 0
    if(_): {rt_conly = 1} [
        set(rt_nowarn): 0
        cv_progglobals(_): ps_root
        cv_predecl(_): ps_root
        cv_stmt(_): ps_root
        cv_warnings(_):
        rt_conly_write(_):
        return(_): 0
