        vec(rt_stv): ""
        len(rt_stn): rt_stk
        set(rt_sti): 0
        while(_): {rt_sti < rt_stn} [
            at(rt_stc): rt_stk rt_sti
            ex_val(rt_stx): rt_stc
            push(_): rt_stv rt_stx
            add(rt_sti): rt_sti 1
        ]
        getf(rt_stnm): nd "s2"
        rt_struct_decl(_): rt_stnm rt_stv
    ]
]
# ---- blocks, chains, loops ----
# ---- host builtins ----
# Builtins this interpreter runs by calling the host's own command with
# the same arguments, so results and errors are exactly ussr's. Each takes
# one argument count; any other fails the process.
rt_is_host(r): nm [
    set(r): 0
    if(_): {nm = "pop"} [ set(r): 1 ]
    if(_): {nm = "read_line"} [ set(r): 1 ]
    if(_): {nm = "sin"} [ set(r): 1 ]
    if(_): {nm = "ln"} [ set(r): 1 ]
    if(_): {nm = "file_exists"} [ set(r): 1 ]
    if(_): {nm = "getenv"} [ set(r): 1 ]
    if(_): {nm = "setenv"} [ set(r): 1 ]
    if(_): {nm = "unsetenv"} [ set(r): 1 ]
    if(_): {nm = "chr"} [ set(r): 1 ]
    if(_): {nm = "fail"} [ set(r): 1 ]
    if(_): {nm = "list_dir"} [ set(r): 1 ]
    if(_): {nm = "is_dir"} [ set(r): 1 ]
    if(_): {nm = "getcwd"} [ set(r): 1 ]
    if(_): {nm = "rename_path"} [ set(r): 1 ]
    if(_): {nm = "copy_file"} [ set(r): 1 ]
    if(_): {nm = "remove_file"} [ set(r): 1 ]
    if(_): {nm = "remove_dir"} [ set(r): 1 ]
    if(_): {nm = "make_dir"} [ set(r): 1 ]
    if(_): {nm = "writefile"} [ set(r): 1 ]
    if(_): {nm = "terminal_escape"} [ set(r): 1 ]
    if(_): {nm = "terminal_raw"} [ set(r): 1 ]
    if(_): {nm = "terminal_sane"} [ set(r): 1 ]
    if(_): {nm = "terminal_getch"} [ set(r): 1 ]
    if(_): {nm = "terminal_size"} [ set(r): 1 ]
    if(_): {nm = "write_stderr"} [ set(r): 1 ]
    if(_): {nm = "finv_sqrt"} [ set(r): 1 ]
]
# A host builtin call in the tree walker: nm is one and the program has
# no function of that name (programs may shadow these, as math.su does).
rt_host_call(r): nd nm [
    rt_is_host(r): nm
    if(_): {r = 1} [
        rt_findf(rt_hcf): nm
        cv_hasblk(rt_hcb): nd
        if(_): {rt_hcf >= 0 || rt_hcb = 1} [ set(r): 0 ]
    ]
]
rt_host(r): nm vals [
    set(r): null
    len(rt_hn): vals
    if(_): {rt_hn > 0} [ at(rt_ha0): vals 0 ]
    if(_): {rt_hn > 1} [ at(rt_ha1): vals 1 ]
    if(_): {rt_hn > 2} [ rt_fatal(_): ]
    if(_): {nm = "pop"} [
        if(_): {rt_hn = 1} [ pop(r): rt_ha0 ]
        if(_): {rt_hn != 1} [ rt_fatal(_): ]
    ]
    if(_): {nm = "read_line"} [
        if(_): {rt_hn = 1} [ read_line(r): rt_ha0 ]
        if(_): {rt_hn != 1} [ rt_fatal(_): ]
    ]
    if(_): {nm = "sin"} [
