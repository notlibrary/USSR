        if(_): {rt_hn != 1} [ rt_fatal(_): ]
    ]
    if(_): {nm = "writefile"} [
        if(_): {rt_hn = 2} [ writefile(r): rt_ha0 rt_ha1 ]
        if(_): {rt_hn != 2} [ rt_fatal(_): ]
    ]
    if(_): {nm = "terminal_escape"} [
        if(_): {rt_hn = 0} [ terminal_escape(r): ]
        if(_): {rt_hn != 0} [ rt_fatal(_): ]
    ]
    if(_): {nm = "terminal_raw"} [
        if(_): {rt_hn = 0} [ terminal_raw(r): ]
        if(_): {rt_hn != 0} [ rt_fatal(_): ]
    ]
    if(_): {nm = "terminal_sane"} [
        if(_): {rt_hn = 0} [ terminal_sane(r): ]
        if(_): {rt_hn != 0} [ rt_fatal(_): ]
    ]
    if(_): {nm = "terminal_getch"} [
        if(_): {rt_hn = 0} [ terminal_getch(r): ]
        if(_): {rt_hn != 0} [ rt_fatal(_): ]
