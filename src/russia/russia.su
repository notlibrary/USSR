    if(_): {op = 10} [ set(r): 16 ]
    if(_): {op = 11} [ set(r): 17 ]
    if(_): {op = 12} [ set(r): 18 ]
    if(_): {op = 13} [ set(r): 19 ]
    if(_): {op = 14} [ set(r): 20 ]
    if(_): {op = 15} [ set(r): 240 ]
    if(_): {op = 16} [ set(r): 22 ]
    if(_): {op = 17} [ set(r): 23 ]
    if(_): {op = 18} [ set(r): 24 ]
    if(_): {op = 19} [ set(r): 25 ]
    if(_): {op = 20} [ set(r): 26 ]
    if(_): {op = 21} [ set(r): 27 ]
    if(_): {op = 22} [ set(r): 28 ]
    if(_): {op = 23} [ set(r): 29 ]
