    ]
]
cv_driver(r): prog acnt avec [
    # Every program runs on the bytecode VM, as in ussr (the tree walker
    # stays available as the "walk" mode).
    cv_progglobals(_): prog
    cv_predecl(_): prog
    cv_stmt(r): prog
    if(_): {rt_nowarn = 0} [ cv_warnings(_): ]
    cv_findf2(cv_mi): "init"
    set(r): 0
    if(_): {cv_mi + 1 > 0} [
        cv_const(cv_mc1): acnt
        cv_emit(_): 1 0 0 0 cv_mc1
        cv_const(cv_mc2): avec
        cv_emit(_): 1 1 0 0 cv_mc2
        # The main process's init return value lands in __sc_result,
        # where sc_zombify picks it up as the process result.
        cv_name(cv_mn): "__sc_result"
        cv_emit(_): 5 0 2 cv_mn cv_mi
        cv_emit(_): 3 31 0 0 cv_mn
    ]
    cv_emit(_): 15 0 0 0 0
    set(vm_ip): 0
    set(vm_flow): 0
    set(vm_sp): 0
    # Every VM program runs under the scheduler; main is pid 1.
    sc_boot(_):
    sc_run(r):
    if(_): {r = 0 && cv_mi + 1 > 0} [
        at(cv_mp): sc_procs 0
        getf(cv_mres): cv_mp "result"
        rt_exitcode(r): cv_mres
    ]
]
vm_init_i(r): i [
    if(_): {i < 32} [
        new(vm_rvx): "vm_rv" 0
        push(_): vm_regs vm_rvx
        add(vm_ri): i 1
        vm_init_i(r): vm_ri
    ]
    if(_): {i = 32} [
        set(r): 0
    ]
]
# ---- entry point ----
# Reads the target program through the preprocessor, exactly as ussr reads
# the file it is started on ($include, $define, $if..., $once). r = 1 when
# it could not be read or parsed.
# ---------- -c and .ru ----------
# russia.su -c script.su [program.ru] checks script.su exactly as ussr -c
# does (same diagnostics, nothing written on error) and writes russia's
# own .ru: a "#russia-ru 1" line, the line map's length, its file/line
# pairs one per line, then the preprocessed source. Running a .ru skips
# the preprocessor. (ussr's .ru is its binary bytecode; neither reads the
# other's.)

# 1 when s ends with suffix.
rt_has_suffix(r): s suffix [
    set(r): 0
    len(rhs_n): s
    len(rhs_k): suffix
    if(_): {rhs_n >= rhs_k} [
        slice(rhs_t): s {rhs_n - rhs_k} rhs_k
        if(_): {rhs_t = suffix} [ set(r): 1 ]
    ]
]

# input with its extension (after the last path separator) replaced by .ru
rt_ru_default(r): input [
    len(rrd_n): input
    set(rrd_stem): rrd_n
    set(rrd_i): {rrd_n - 1}
    set(rrd_go): 1
    while(_): {rrd_go = 1 && rrd_i >= 0} [
        byte(rrd_b): input rrd_i
        if(_): {rrd_b = 47 || rrd_b = 92} [ set(rrd_go): 0 ]
        if(_): {rrd_b = 46} [
            set(rrd_stem): rrd_i
            set(rrd_go): 0
        ]
        sub(rrd_i): rrd_i 1
    ]
    slice(r): input 0 rrd_stem
    concat(r): r ".ru"
]

rt_compile_only(r): cnt avec [
    set(r): 1
    if(_): {cnt < 2 || cnt > 3} [
        write_stderr(_): "Usage: russia.su -c script.su [program.ru]\n"
        return(_): r
    ]
    at(rco_in): avec 1
    rt_has_suffix(rco_isru): rco_in ".ru"
    if(_): {rco_isru = 1} [
        concat(rco_m): "USSR compile: '" rco_in
        concat(rco_m): rco_m "' is already bytecode\n"
        write_stderr(_): rco_m
        return(_): r
    ]
    if(_): {cnt = 3} [ at(rco_out): avec 2 ]
    else(_): [ rt_ru_default(rco_out): rco_in ]
    pp_run(rco_src): rco_in
    if(_): {pp_failed = 1} [
        rt_pp_report(_):
        return(_): r
    ]
    ck_run(rco_ck): rco_src rco_in pp_mapf pp_mapl
    if(_): {rco_ck = 1} [
        write_stderr(_): ck_msg
        concat(rco_m2): "USSR compile: '" rco_out
        concat(rco_m2): rco_m2 "' was not written\n"
        write_stderr(_): rco_m2
        return(_): r
    ]
    vec(lx_tokens): "lx_Tok"
    lx_scan(rco_ls): rco_src
    if(_): {rco_ls = 0} [ ps_parse(rco_ls): rco_src ]
    if(_): {rco_ls != 0} [ return(_): r ]
    set(rt_cosrc): rco_src
    set(rt_coout): rco_out
    set(r): 0
]
# Write the checked program (rt_cosrc, line map pp_mapf/pp_mapl) to
# rt_coout as a russia .ru.
rt_conly_write(r): [
    len(rco_n): pp_mapl
    encode(rco_ns): rco_n
    concat(rco_t): "#russia-ru 1\n" rco_ns
    concat(rco_t): rco_t "\n"
    set(rco_i): 0
    while(_): {rco_i < rco_n} [
        at(rco_f): pp_mapf rco_i
        at(rco_l): pp_mapl rco_i
        encode(rco_ls): rco_l
        concat(rco_t): rco_t rco_f
        concat(rco_t): rco_t "\n"
        concat(rco_t): rco_t rco_ls
        concat(rco_t): rco_t "\n"
        add(rco_i): rco_i 1
    ]
    concat(rco_t): rco_t rt_cosrc
    writefile(rco_w): rt_coout rco_t
    set(r): 0
]

# The next line of t from rru_at on (without its LF); moves rru_at past it.
rt_ru_line(r): t [
    global(_): rru_at
    len(rrl_n): t
    set(rrl_j): rru_at
    set(rrl_go): 1
    while(_): {rrl_go = 1 && rrl_j < rrl_n} [
        byte(rrl_b): t rrl_j
        if(_): {rrl_b = 10} [ set(rrl_go): 0 ]
        else(_): [ add(rrl_j): rrl_j 1 ]
    ]
    slice(r): t rru_at {rrl_j - rru_at}
    set(rru_at): {rrl_j + 1}
]

# A russia .ru file's source, with pp_mapf/pp_mapl set from its line map;
# null (after reporting why) when it cannot be read.
rt_ru_read(r): path [
    global(_): rru_at
    set(r): null
    file_exists(rr_ex): path
    if(_): {rr_ex = false} [
        concat(rr_m): "USSR: cannot open '" path
        concat(rr_m): rr_m "'\n"
        write_stderr(_): rr_m
        return(_): r
    ]
    readfile(rr_t): path
    set(rru_at): 0
    rt_ru_line(rr_h): rr_t
    if(_): {rr_h != "#russia-ru 1"} [
        concat(rr_m2): "USSR: '" path
        concat(rr_m2): rr_m2 "': not a russia.su bytecode file (bad signature)\n"
        write_stderr(_): rr_m2
        return(_): r
    ]
    rt_ru_line(rr_ns): rr_t
    decode(rr_n): rr_ns
    vec(pp_mapf): ""
    vec(pp_mapl): ""
    set(rr_i): 0
    while(_): {rr_i < rr_n} [
        rt_ru_line(rr_f): rr_t
        rt_ru_line(rr_ls): rr_t
        decode(rr_l): rr_ls
        push(_): pp_mapf rr_f
        push(_): pp_mapl rr_l
        add(rr_i): rr_i 1
    ]
    len(rr_tn): rr_t
    set(r): ""
    if(_): {rru_at < rr_tn} [ slice(r): rr_t rru_at {rr_tn - rru_at} ]
]

init_src(r): avec [
    set(r): 0
    set(rt_nowarn): 0
    set(rt_eflag): 0
    at(lx_path): avec 0
    rt_has_suffix(lx_isru): lx_path ".ru"
    # -e code [args...]: run code as ussr -e does (no preprocessor, named
    # "<command line>")
    if(_): {lx_path = "-e"} [
        set(rt_eflag): 1
        set(lx_isru): 2
        set(lx_src): ""
        len(lx_ac): avec
        if(_): {lx_ac > 1} [ at(lx_src): avec 1 ]
        set(lx_path): "<command line>"
        vec(pp_mapf): ""
        vec(pp_mapl): ""
    ]
    if(_): {lx_isru = 1} [
        set(rt_nowarn): 1
        rt_ru_read(lx_src): lx_path
        if(_): {lx_src = null} [
            set(r): 1
            return(_): r
        ]
    ]
    if(_): {lx_isru = 0} [
        pp_run(lx_src): lx_path
        if(_): {pp_failed = 1} [
            rt_pp_report(_):
            set(r): 1
            return(_): r
        ]
    ]
    # Lexer, grammar and compiler errors: one "file:line: reason" line on
    # stderr and exit status 1, before anything runs.
    ck_run(lx_ckf): lx_src lx_path pp_mapf pp_mapl
    if(_): {lx_ckf = 1} [
        write_stderr(_): ck_msg
        set(r): 1
        return(_): r
    ]

    vec(lx_tokens): "lx_Tok"
    lx_scan(lx_status): lx_src
    if(_): {lx_status = 1} [
        set(r): 1
    ]
    if(_): {lx_status = 0} [
        ps_parse(ps_st): lx_src
        if(_): {ps_st = 1} [
            set(r): 1
        ]
    ]
]
init(ret): arg_cnt arg_vec [
    # .ua/.uuasm targets are assembled and run by uuasm.su; an optional
    # trailing "dump" prints the assembled program instead.
    if(_): {arg_cnt > 0} [
        at(init_target): arg_vec 0
        uq_is_assembly(init_is_ua): init_target
        if(_): init_is_ua [
            set(init_mode): ""
            if(_): {arg_cnt > 1} [
                at(init_mode): arg_vec {arg_cnt - 1}
            ]
            uq_main(ret): init_target init_mode
            return(_): ret
        ]
    ]
    struct(lx_Tok): "kind:number" "text:string" "line:number"
    set(ps_nddef): 0
    set(rt_conly): 0
    if(_): {arg_cnt > 0} [
        at(init_c): arg_vec 0
        if(_): {init_c = "-c"} [
            rt_compile_only(init_cst): arg_cnt arg_vec
            if(_): {init_cst != 0} [ return(_): 1 ]
            set(rt_conly): 1
