# Compile a name argument: a bare identifier means the literal name
# (async(p): worker n), anything else is a normal expression
# (async(p): "worker" n, load(p): pathvar entry).
cv_scname(r): nd tgt [
    getf(cv_snt): nd "tag"
    if(_): {cv_snt = 4} [
        getf(cv_snn): nd "s1"
        cv_const(cv_sci): cv_snn
        cv_emit(_): 1 tgt 0 0 cv_sci
    ]
    if(_): {cv_snt != 4} [
        cv_e(r): nd tgt
    ]
]
# cv_native2 variant where argument position sp is a name (cv_scname)
# instead of a value expression. async/process: sp=0, load: sp=1.
cv_nat3_i(r): nd kids nm idx sp [
    len(cv_n3l): kids
    set(r): 0
