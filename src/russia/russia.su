# USSR interpreter in USSR. Stage M1: lexer + token dump.
# Usage: ./ussr russia.su program.su
# The interpreted program is lexed by this code; nothing is handed
# back to the host interpreter (no eval no chain/capture).

# Standard library: keep the interpreter's shared calls out of the VM loop.
# standard.su is not included: its PRNG definitions shadow host builtins
# that the host parser refuses to redefine. random64/seed_random64/time
# are used here as host natives.
$include "../libs/io.su"
$include "../libs/math.su"
$include "../libs/bytes.su"
$include "../libs/strings.su"
# Textual UUASM (.ua/.uuasm): assembler, disassembler and C-ABI executor.
$include "uuasm.su"
# The preprocessor for target programs (pp.c ported).
$include "pp.su"
# Compile-time diagnostics, reported as ussr reports them.
$include "check.su"

# Interpreter state shared across the stages (lx_ lexer, ps_ parser, rt_
# tree runtime, cv_ compiler, vm_ VM, sc_ scheduler); every other variable
# a function sets is local to it.
global(_): rt_hash cv_own cv_pglob cv_pall cv_gall cv_regpush ps_quiet ps_errline ps_i ps_nddef rt_flow vm_suspend vm_ip vm_qleft vm_sp
global(_): sc_runq sc_tick lx_tokens ps_stop
global(_): ps_root rt_store rt_fdefs rt_rv rt_tn rt_xrv vm_flow cv_code
global(_): cv_names cv_consts cv_lps cv_funcs cv_ent vm_av
global(_): rt_na1 rt_na2 rt_na3 rt_na4 rt_na5 rt_na0 vm_regs vm_frames
global(_): rt_na6 sc_procs sc_cur sc_lhas sc_marks rt_undef cv_strict vm_nbase
global(_): cv_iline cv_icmd cv_curl cv_curc rt_nowarn rt_eflag
global(_): rt_conly rt_coout rt_cosrc

# Almost impossible programming task
# Write USSR interpreter in USSR
# Kimi K3 died in hallucinations ChatGPT go went to eval cheat
# Need to pay Antropics 20$ and check how Claude fails it

# ---- char classes ----
lx_alpha_p(r): b [
    set(r): 0
    if(_): {b = 95} [
        set(r): 1
    ]
    if(_): {b > 96} [
        if(_): {b < 123} [
            set(r): 1
        ]
    ]
    if(_): {b > 64} [
        if(_): {b < 91} [
            set(r): 1
        ]
    ]
]

lx_digit_p(r): b [
    set(r): 0
    if(_): {b > 47} [
        if(_): {b < 58} [
            set(r): 1
        ]
    ]
]

# ---- emit one token: kind text line ----
lx_emit(r): kind text tline [
    new(lx_t): "lx_Tok" 0 "" 0
    setf(_): lx_t "kind" kind
    setf(_): lx_t "text" text
    setf(_): lx_t "line" tline
    push(_): lx_tokens lx_t
    set(r): 0
]

# ---- scan a whole source string ----
lx_scan(r): s [
    set(lx_src): s
    len(lx_n): lx_src
    set(lx_pos): 0
    set(lx_ln): 1
    set(lx_err): ""
    set(lx_failed): 0
    while(_): {lx_pos < lx_n} [
        set(lx_b): {0 - 1}
        byte(lx_b): lx_src lx_pos
        set(lx_adv): 0
        # LF
        if(_): {lx_b = 10} [
            lx_emit(_): 17 "" lx_ln
            set(lx_pos): {lx_pos + 1}
            set(lx_ln): {lx_ln + 1}
            set(lx_adv): 1
        ]
        # CR
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 13} [
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # space
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 32} [
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # tab
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 9} [
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # comment to end of line
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 35} [
                set(lx_cdone): 0
                while(_): {lx_cdone = 0} [
                    if(_): {lx_pos > lx_n - 1} [
                        set(lx_cdone): 1
                    ]
                    if(_): {lx_cdone = 0} [
                        set(lx_cb): {0 - 1}
                        byte(lx_cb): lx_src lx_pos
                        if(_): {lx_cb = 10} [
                            set(lx_cdone): 1
                        ]
                        if(_): {lx_cdone = 0} [
                            set(lx_pos): {lx_pos + 1}
                        ]
                    ]
                ]
                set(lx_adv): 1
            ]
        ]
        # preprocessor directive: whole line, kind 21
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 36} [
                set(lx_start): {lx_pos + 1}
                set(lx_pdone): 0
                while(_): {lx_pdone = 0} [
                    if(_): {lx_pos > lx_n - 1} [
                        set(lx_pdone): 1
                    ]
                    if(_): {lx_pdone = 0} [
                        set(lx_pb): {0 - 1}
                        byte(lx_pb): lx_src lx_pos
                        if(_): {lx_pb = 10} [
                            set(lx_pdone): 1
                        ]
                        if(_): {lx_pdone = 0} [
                            set(lx_pos): {lx_pos + 1}
                        ]
                    ]
                ]
                slice(lx_ptxt): lx_src lx_start {lx_pos - lx_start}
                lx_emit(_): 21 lx_ptxt lx_ln
                set(lx_adv): 1
            ]
        ]
        # advanced control marker: kind 22
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 64} [
                lx_emit(_): 22 "@" lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # identifier or keyword
        if(_): {lx_adv = 0} [
            lx_alpha_p(lx_ap): lx_b
            if(_): {lx_ap = 1} [
                set(lx_start): lx_pos
                set(lx_pos): {lx_pos + 1}
                set(lx_more): 1
                while(_): {lx_more = 1} [
                    set(lx_c2): {0 - 1}
                    if(_): {lx_pos < lx_n} [
                        byte(lx_c2): lx_src lx_pos
                    ]
                    if(_): {lx_c2 = -1} [
                        set(lx_more): 0
                    ]
                    if(_): {lx_more = 1} [
                        lx_alpha_p(lx_a2): lx_c2
                        lx_digit_p(lx_d2): lx_c2
                        if(_): {lx_a2 = 1} [
                            set(lx_pos): {lx_pos + 1}
                        ]
                        if(_): {lx_a2 = 0} [
                            if(_): {lx_d2 = 1} [
                                set(lx_pos): {lx_pos + 1}
                            ]
                            if(_): {lx_d2 = 0} [
                                set(lx_more): 0
                            ]
                        ]
                    ]
                ]
                slice(lx_txt): lx_src lx_start {lx_pos - lx_start}
                set(lx_k): 1
                if(_): {lx_txt = "true"} [
                    set(lx_k): 6
                ]
                if(_): {lx_txt = "false"} [
                    set(lx_k): 6
                ]
                if(_): {lx_txt = "null"} [
                    set(lx_k): 7
                ]
                lx_emit(_): lx_k lx_txt lx_ln
                set(lx_adv): 1
            ]
        ]
        # number
        if(_): {lx_adv = 0} [
            lx_digit_p(lx_dp): lx_b
            if(_): {lx_dp = 1} [
                set(lx_start): lx_pos
                while(_): {lx_dp = 1} [
                    set(lx_pos): {lx_pos + 1}
                    set(lx_c2): {0 - 1}
                    if(_): {lx_pos < lx_n} [
                        byte(lx_c2): lx_src lx_pos
                    ]
                    lx_digit_p(lx_dp): lx_c2
                ]
                set(lx_k): 2
                set(lx_dot): {0 - 1}
                if(_): {lx_pos < lx_n} [
                    byte(lx_dot): lx_src lx_pos
                ]
                set(lx_c2): {0 - 1}
                if(_): {lx_pos + 1 < lx_n} [
                    byte(lx_c2): lx_src {lx_pos + 1}
                ]
                lx_digit_p(lx_dp2): lx_c2
                if(_): {lx_dot = 46} [
                    if(_): {lx_dp2 = 1} [
                        set(lx_pos): {lx_pos + 1}
                        set(lx_dp): 1
                        while(_): {lx_dp = 1} [
                            set(lx_pos): {lx_pos + 1}
                            set(lx_c2): {0 - 1}
                            if(_): {lx_pos < lx_n} [
                                byte(lx_c2): lx_src lx_pos
                            ]
                            lx_digit_p(lx_dp): lx_c2
                        ]
                        set(lx_k): 3
                    ]
                ]
                slice(lx_tmp): lx_src lx_start {lx_pos - lx_start}
                lx_emit(_): lx_k lx_tmp lx_ln
                set(lx_adv): 1
            ]
        ]
        # string literal
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 34} [
                set(lx_pos): {lx_pos + 1}
                set(lx_acc): ""
                set(lx_sdone): 0
                while(_): {lx_sdone = 0} [
                    if(_): {lx_pos > lx_n - 1} [
                        set(lx_failed): 1
                        set(lx_err): "unterminated string"
                        set(lx_sdone): 1
                    ]
                    if(_): {lx_sdone = 0} [
                        set(lx_cb): {0 - 1}
                        byte(lx_cb): lx_src lx_pos
                        if(_): {lx_cb = 34} [
                            set(lx_pos): {lx_pos + 1}
                            set(lx_sdone): 1
                        ]
                        if(_): {lx_sdone = 0} [
                            set(lx_isesc): 0
                            if(_): {lx_cb = 92} [
                                set(lx_isesc): 1
                                set(lx_pos): {lx_pos + 1}
                                set(lx_eb): {0 - 1}
                                if(_): {lx_pos < lx_n} [
                                    byte(lx_eb): lx_src lx_pos
                                ]
                                set(lx_ec): ""
                                if(_): {lx_eb = 110} [
                                    set(lx_ec): "\n"
                                ]
                                if(_): {lx_eb = 116} [
                                    set(lx_ec): "\t"
                                ]
                                if(_): {lx_eb = 114} [
                                    set(lx_ec): "\r"
                                ]
                                if(_): {lx_eb = 92} [
                                    set(lx_ec): "\\"
                                ]
                                if(_): {lx_eb = 34} [
                                    set(lx_ec): "\""
                                ]
                                if(_): {lx_ec = ""} [
                                    if(_): {lx_eb + 1 > 0} [
                                        slice(lx_tmp): lx_src lx_pos 1
                                        set(lx_ec): lx_tmp
                                    ]
                                ]
                                concat(lx_acc): lx_acc lx_ec
                                set(lx_pos): {lx_pos + 1}
                            ]
                            if(_): {lx_isesc = 0} [
                                slice(lx_tmp): lx_src lx_pos 1
                                concat(lx_acc): lx_acc lx_tmp
                                set(lx_pos): {lx_pos + 1}
                            ]
                        ]
                    ]
                ]
                if(_): {lx_err = ""} [
                    lx_emit(_): 4 lx_acc lx_ln
                ]
                set(lx_adv): 1
            ]
        ]
        # UNO literal '...'
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 39} [
                set(lx_start): {lx_pos + 1}
                set(lx_pos): lx_start
                set(lx_udone): 0
                while(_): {lx_udone = 0} [
                    if(_): {lx_pos > lx_n - 1} [
                        set(lx_failed): 1
                        set(lx_err): "unterminated UNO literal"
                        set(lx_udone): 1
                    ]
                    if(_): {lx_udone = 0} [
                        set(lx_ub): {0 - 1}
                        byte(lx_ub): lx_src lx_pos
                        if(_): {lx_ub = 39} [
                            set(lx_udone): 1
                        ]
                        if(_): {lx_udone = 0} [
                            set(lx_pos): {lx_pos + 1}
                        ]
                    ]
                ]
                if(_): {lx_err = ""} [
                    slice(lx_tmp): lx_src lx_start {lx_pos - lx_start}
                    lx_emit(_): 5 lx_tmp lx_ln
                ]
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # punctuation
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 123} [
                lx_emit(_): 10 "" lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # punctuation
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 125} [
                lx_emit(_): 11 "" lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # punctuation
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 91} [
                lx_emit(_): 12 "" lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # punctuation
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 93} [
                lx_emit(_): 13 "" lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # punctuation
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 40} [
                lx_emit(_): 14 "" lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # punctuation
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 41} [
                lx_emit(_): 15 "" lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # punctuation
        if(_): {lx_adv = 0} [
            if(_): {lx_b = 58} [
                lx_emit(_): 16 "" lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # operators longest match
        if(_): {lx_adv = 0} [
            set(lx_hasop): 1
            set(lx_op): ""
            set(lx_hasop): 0
            set(lx_p1): {0 - 1}
            if(_): {lx_pos + 1 < lx_n} [
                byte(lx_p1): lx_src {lx_pos + 1}
            ]
            if(_): {lx_b = 43} [
                set(lx_hasop): 1
                set(lx_op): "+"
            ]
            if(_): {lx_b = 45} [
                set(lx_hasop): 1
                set(lx_op): "-"
            ]
            if(_): {lx_b = 42} [
                set(lx_hasop): 1
                set(lx_op): "*"
            ]
            if(_): {lx_b = 47} [
                set(lx_hasop): 1
                set(lx_op): "/"
            ]
            if(_): {lx_b = 37} [
                set(lx_hasop): 1
                set(lx_op): "%"
            ]
            if(_): {lx_b = 94} [
                set(lx_hasop): 1
                set(lx_op): "^"
            ]
            if(_): {lx_b = 63} [
                set(lx_hasop): 1
                set(lx_op): "?"
            ]
            if(_): {lx_b = 62} [
                set(lx_hasop): 1
                set(lx_op): ">"
                if(_): {lx_p1 = 61} [
                    set(lx_hasop): 1
                    set(lx_op): ">="
                    set(lx_pos): {lx_pos + 1}
                ]
                if(_): {lx_p1 = 62} [
                    set(lx_hasop): 1
                    set(lx_op): ">>"
                    set(lx_pos): {lx_pos + 1}
                ]
            ]
            if(_): {lx_b = 60} [
                set(lx_hasop): 1
                set(lx_op): "<"
                if(_): {lx_p1 = 61} [
                    set(lx_hasop): 1
                    set(lx_op): "<="
                    set(lx_pos): {lx_pos + 1}
                ]
                if(_): {lx_p1 = 60} [
                    set(lx_hasop): 1
                    set(lx_op): "<<"
                    set(lx_pos): {lx_pos + 1}
                ]
            ]
            if(_): {lx_b = 61} [
                set(lx_hasop): 1
                set(lx_op): "="
            ]
            if(_): {lx_b = 33} [
                set(lx_hasop): 1
                set(lx_op): "!"
                if(_): {lx_p1 = 61} [
                    set(lx_hasop): 1
                    set(lx_op): "!="
                    set(lx_pos): {lx_pos + 1}
                ]
            ]
            if(_): {lx_b = 38} [
                set(lx_hasop): 1
                set(lx_op): "&"
                if(_): {lx_p1 = 38} [
                    set(lx_hasop): 1
                    set(lx_op): "&&"
                    set(lx_pos): {lx_pos + 1}
                ]
            ]
            if(_): {lx_b = 124} [
                set(lx_hasop): 1
                set(lx_op): "|"
                if(_): {lx_p1 = 124} [
                    set(lx_hasop): 1
                    set(lx_op): "||"
                    set(lx_pos): {lx_pos + 1}
                ]
            ]
            if(_): {lx_hasop = 1} [
                lx_emit(_): 20 lx_op lx_ln
                set(lx_pos): {lx_pos + 1}
                set(lx_adv): 1
            ]
        ]
        # anything else is an error
        if(_): {lx_adv = 0} [
            set(lx_failed): 1
            set(lx_err): "unexpected character"
            set(lx_pos): {lx_pos + 1}
        ]
    ]
    if(_): {lx_err = ""} [
        lx_emit(_): 99 "" lx_ln
        set(r): 0
    ]
    if(_): {lx_failed = 1} [
        print(_): lx_err
        set(r): 1
    ]
]

# ---------- parser: token cursor helpers ----------
ps_at(r): idx [
    add(ps_ii): ps_i idx
    at(r): lx_tokens ps_ii
]
ps_cur(r): k [
    ps_at(ps_tk): 0
    getf(r): ps_tk "kind"
]
ps_txt(r): k [
    ps_at(ps_tk): k
    getf(r): ps_tk "text"
]
ps_adv(r): k [
    add(ps_i): ps_i 1
    set(r): 0
]
ps_skipnl(r): k [
    ps_cur(ps_sn_k): 0
    while(_): {ps_sn_k = 17} [
        ps_adv(_): 0
        ps_cur(ps_sn_k): 0
    ]
    set(r): 0
]
ps_isk(r): k [
    ps_cur(ps_ck): 0
    set(r): 0
    if(_): {ps_ck = k} [
        set(r): 1
    ]
]
ps_istok(r): s [
    ps_cur(ps_tk2): 0
    set(r): 0
    if(_): {ps_tk2 = 20} [
        ps_txt(ps_tt): 0
        if(_): {ps_tt = s} [
            set(r): 1
        ]
    ]
]
ps_fail(r): msg [
    set(ps_stop): 1
    set(ps_err): msg
    ps_at(ps_ftk): 0
    getf(ps_fk): ps_ftk "kind"
    getf(ps_fx): ps_ftk "text"
    getf(ps_fl): ps_ftk "line"
    set(ps_errline): ps_fl
    if(_): {ps_quiet = 0} [
        print(_): msg
        template(_): "INT;STR;INT;STR" ps_fk ps_fx ps_fl "\n"
    ]
    set(r): 1
]

# ---------- parser: node constructor ----------
nd_new(r): tag s1 s2 n1 kids [
    new(r): "nd" tag s1 s2 n1 kids
]

# ---------- parser: expressions ----------
ps_e1(r): [
    if(_): {ps_stop = 0} [
        set(ps_u1op): ""
        ps_istok(ps_u1t): "-"
        if(_): {ps_u1t = 1} [
            set(ps_u1op): "-"
        ]
        ps_istok(ps_u1t): "!"
        if(_): {ps_u1t = 1} [
            set(ps_u1op): "!"
        ]
        ps_e1_head(r): ps_u1op
    ]
]
ps_e1_head(r): optxt [
    set(r): 0
    if(_): {ps_stop = 0} [
        if(_): {optxt = ""} [
            ps_prim(r): 
        ]
        if(_): {optxt = "-"} [
            ps_adv(_): 0
            ps_e1(r): 
            vec(ps_uk): ""
            push(_): ps_uk r
            nd_new(r): 13 optxt "" 0 ps_uk
        ]
        if(_): {optxt = "!"} [
            ps_adv(_): 0
            ps_e1(r): 
            vec(ps_uk): ""
            push(_): ps_uk r
            nd_new(r): 13 optxt "" 0 ps_uk
        ]
    ]
]
ps_prim(r): [
    if(_): {ps_stop = 0} [
        ps_cur(ps_p1k): 0
        set(ps_p1m): 0
        if(_): {ps_p1k = 2} [
            ps_txt(ps_p1s): 0
            ps_adv(_): 0
            nd_new(r): 5 ps_p1s "" 0 ""
            set(ps_p1m): 1
        ]
        if(_): {ps_p1m = 0} [
            if(_): {ps_p1k = 3} [
                ps_txt(ps_p1s): 0
                ps_adv(_): 0
                nd_new(r): 6 ps_p1s "" 0 ""
                set(ps_p1m): 1
            ]
        ]
        if(_): {ps_p1m = 0} [
            if(_): {ps_p1k = 4} [
                ps_txt(ps_p1s): 0
                ps_adv(_): 0
                nd_new(r): 7 ps_p1s "" 0 ""
                set(ps_p1m): 1
            ]
        ]
        if(_): {ps_p1m = 0} [
            if(_): {ps_p1k = 6} [
                ps_txt(ps_p1s): 0
                ps_adv(_): 0
                nd_new(r): 8 ps_p1s "" 0 ""
                set(ps_p1m): 1
            ]
        ]
        if(_): {ps_p1m = 0} [
            if(_): {ps_p1k = 7} [
                ps_adv(_): 0
                nd_new(r): 9 "" "" 0 ""
                set(ps_p1m): 1
            ]
        ]
        if(_): {ps_p1m = 0} [
            if(_): {ps_p1k = 5} [
                ps_txt(ps_p1s): 0
                ps_adv(_): 0
                nd_new(r): 10 ps_p1s "" 0 ""
                set(ps_p1m): 1
            ]
        ]
        if(_): {ps_p1m = 0} [
            if(_): {ps_p1k = 1} [
                ps_txt(ps_p1s): 0
                ps_adv(_): 0
                nd_new(r): 4 ps_p1s "" 0 ""
                set(ps_p1m): 1
            ]
        ]
        if(_): {ps_p1m = 0} [
            if(_): {ps_p1k = 14} [
                ps_adv(_): 0
                ps_e11(r): 
                ps_isk(ps_pp): 15
                if(_): {ps_pp = 0} [
                    ps_fail(ps_pf): "expected )"
                ]
                if(_): {ps_pp = 1} [
                    ps_adv(_): 0
                    set(ps_p1m): 1
                ]
            ]
        ]
        if(_): {ps_p1m = 0} [
            ps_fail(ps_pf): "unexpected token in expression"
        ]
    ]
]
ps_e11(r): [
    if(_): {ps_stop = 0} [
        ps_e10(r):
        ps_e11_loop(r): r
    ]
]
ps_e11_loop(r): left [
    set(r): left
    if(_): {ps_stop = 0} [
        set(ps_l11_m): 0
        set(ps_l11_op): ""
        ps_istok(ps_l11_t): "||"
        if(_): {ps_l11_t = 1} [
            set(ps_l11_m): 1
            set(ps_l11_op): "||"
        ]
        if(_): {ps_l11_m = 1} [
            ps_adv(_): 0
            ps_e10(ps_l11_right):
            vec(ps_l11_kids): ""
            push(_): ps_l11_kids left
            push(_): ps_l11_kids ps_l11_right
