        if(_): {sc_aok = 1} [
            sub(sc_api): rt_na0 1
            at(sc_apr): sc_procs sc_api
            getf(sc_ast): sc_apr "state"
            if(_): {sc_ast = 3} [
                getf(r): sc_apr "result"
            ]
            if(_): {sc_ast < 3} [
                if(_): {sc_cur > 0} [
                    sub(sc_aci): sc_cur 1
                    at(sc_mpr): sc_procs sc_aci
                    setf(_): sc_mpr "state" 2
                    setf(_): sc_mpr "wait_pid" rt_na0
                    setf(_): sc_mpr "wreg" dst
                    set(vm_suspend): 1
                ]
            ]
        ]
    ]
    if(_): {name = "load"} [
        set(sc_lproc): "init"
        set(sc_lhas): 0
        if(_): {nb > 1} [
            set(sc_lproc): rt_na1
            set(sc_lhas): 1
        ]
        sc_n_load(r): rt_na0 sc_lproc sc_lhas
