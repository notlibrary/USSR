        rt_read(rt_irv): "rt_initret"
        rt_exitcode(r): rt_irv
        ex_rest(_): rt_sv2 0 1
    ]
    if(_): {rt_fi < 0} [
        set(r): 0
    ]
]
# ---------- M4: UUASM compiler + bootstrap VM ----------
# UUASM uses the C VM opcode ABI. Bootstrap compilation goes through ua_emit,
# which validates a mnemonic/opcode and records exactly one instruction.
# vm_step translates that opcode one-to-one to the legacy dispatch number.
ua_to_vm(r): op [
    set(r): {0 - 1}
    if(_): {op = 0} [ set(r): 0 ]
    if(_): {op = 1} [ set(r): 1 ]
