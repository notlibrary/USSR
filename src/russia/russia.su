ex_tout(r): s [
    # Write each byte directly. Using template("STR" s) can alter the
    # final byte/newline when this interpreter is running under bootstrap.
    len(rt_tout_len): s
    set(rt_tout_i): 0
    while(_): {rt_tout_i < rt_tout_len} [
        byte(rt_tout_ch): s rt_tout_i
        putch(_): rt_tout_ch
        add(rt_tout_i): rt_tout_i 1
    ]
    set(r): 0
]

# ---- template: one engine for the tree walker and the VM ----
# Mirrors ussr's template exactly: a slot is STR, INT, REAL or BOOL at the
# start or after a space, tab or ';', ending the format or followed by ';',
# space or tab (one ';' after it is consumed); ";;" prints ';' and every
# other byte is printed as is, so output streams up to the first bad value.
# Numbers and booleans are printed by the host's own one-slot template,
# which formats them (REAL is %.17g) and rejects a wrong type with ussr's
# own error; strings go out byte by byte (see ex_tout).
rt_tpl(r): fmt vals [
    set(r): {1 = 1}
    len(rt_tpn): fmt
    len(rt_tpc): vals
    set(rt_tpp): 0
    set(rt_tpv): 0
    while(_): {rt_tpp < rt_tpn} [
        byte(rt_tpb): fmt rt_tpp
        set(rt_tpdone): 0
        if(_): {rt_tpb = 59 && rt_tpp + 1 < rt_tpn} [
            byte(rt_tpb2): fmt {rt_tpp + 1}
            if(_): {rt_tpb2 = 59} [
                putch(_): 59
                add(rt_tpp): rt_tpp 2
                set(rt_tpdone): 1
            ]
        ]
        if(_): {rt_tpdone = 0} [
            set(rt_tpst): 0
            if(_): {rt_tpp = 0} [ set(rt_tpst): 1 ]
            if(_): {rt_tpp > 0} [
                byte(rt_tppr): fmt {rt_tpp - 1}
                if(_): {rt_tppr = 32 || rt_tppr = 9 || rt_tppr = 59} [
                    set(rt_tpst): 1
                ]
            ]
            set(rt_tpty): ""
            if(_): {rt_tpst = 1} [
                rt_tpl_slot(rt_tpty): fmt rt_tpp rt_tpn
            ]
            if(_): {rt_tpty != ""} [
                if(_): {rt_tpv >= rt_tpc} [
                    rt_tpl_fail(_):
                ]
                at(rt_tpval): vals rt_tpv
                rt_tpl_emit(_): rt_tpty rt_tpval
                add(rt_tpv): rt_tpv 1
                len(rt_tptl): rt_tpty
                add(rt_tpp): rt_tpp rt_tptl
                if(_): {rt_tpp < rt_tpn} [
                    byte(rt_tpb3): fmt rt_tpp
                    if(_): {rt_tpb3 = 59} [
                        add(rt_tpp): rt_tpp 1
                    ]
                ]
                set(rt_tpdone): 1
            ]
        ]
        if(_): {rt_tpdone = 0} [
            putch(_): rt_tpb
            add(rt_tpp): rt_tpp 1
        ]
    ]
    if(_): {rt_tpv != rt_tpc} [
        rt_tpl_fail(_):
    ]
]
# The slot type starting at p, or "" when none starts there.
rt_tpl_slot(r): fmt p n [
    set(r): ""
    vec(rt_tsl): ""
    push(_): rt_tsl "STR"
    push(_): rt_tsl "INT"
    push(_): rt_tsl "REAL"
    push(_): rt_tsl "BOOL"
    set(rt_tsi): 0
    while(_): {rt_tsi < 4 && r = ""} [
        at(rt_tst): rt_tsl rt_tsi
        len(rt_tsn): rt_tst
        if(_): {p + rt_tsn <= n} [
            slice(rt_tss): fmt p rt_tsn
            if(_): {rt_tss = rt_tst} [
                set(rt_tsok): 1
                if(_): {p + rt_tsn < n} [
                    byte(rt_tsb): fmt {p + rt_tsn}
                    set(rt_tsok): 0
                    if(_): {rt_tsb = 59 || rt_tsb = 32 || rt_tsb = 9} [
                        set(rt_tsok): 1
                    ]
                ]
                if(_): {rt_tsok = 1} [
                    set(r): rt_tst
                ]
            ]
        ]
        add(rt_tsi): rt_tsi 1
    ]
]
rt_tpl_emit(r): ty v [
    set(r): 0
    if(_): {ty = "STR"} [
        typeof(rt_tet): v
        if(_): {rt_tet != "string"} [
            rt_tpl_fail(_):
        ]
        ex_tout(_): v
    ]
    if(_): {ty = "INT"} [ template(_): "INT;" v ]
    if(_): {ty = "REAL"} [ template(_): "REAL;" v ]
    if(_): {ty = "BOOL"} [ template(_): "BOOL;" v ]
]
# Too few or too many values: let the host fail the template the same way.
rt_tpl_fail(r): [
    template(r): "INT;" "russia: template arguments do not match format"
]

ex_template(r): nd [
    getf(rt_tk): nd "kids"
    at(rt_tf0): rt_tk 0
    ex_val(rt_fmt): rt_tf0
    len(rt_tkn): rt_tk
    vec(rt_tvals): ""
    set(rt_tki): 1
    while(_): {rt_tki < rt_tkn} [
        at(rt_tkv): rt_tk rt_tki
        ex_val(rt_tkx): rt_tkv
        push(_): rt_tvals rt_tkx
        add(rt_tki): rt_tki 1
    ]
    rt_tpl(rt_tr2): rt_fmt rt_tvals
    getf(rt_tr): nd "s2"
    rt_write(_): rt_tr rt_tr2
    set(r): 0
]

ex_oop(r): nd nm [
    set(r): 0
    getf(rt_ok2): nd "kids"
    getf(rt_or): nd "s2"
    if(_): {nm = "push"} [
        at(rt_o1): rt_ok2 0
        at(rt_o2): rt_ok2 1
        ex_val(rt_ov1): rt_o1
        ex_val(rt_ov2): rt_o2
        push(_): rt_ov1 rt_ov2
    ]
    if(_): {nm = "at"} [
        at(rt_o1): rt_ok2 0
        at(rt_o2): rt_ok2 1
        ex_val(rt_ov1): rt_o1
        ex_val(rt_ov2): rt_o2
        at(rt_rv2): rt_ov1 rt_ov2
        rt_write(_): rt_or rt_rv2
    ]
    if(_): {nm = "typeof"} [
        at(rt_o1): rt_ok2 0
        ex_val(rt_ov1): rt_o1
        typeof(rt_rv3t): rt_ov1
        rt_write(_): rt_or rt_rv3t
    ]
    if(_): {nm = "len"} [
        at(rt_o1): rt_ok2 0
        ex_val(rt_ov1): rt_o1
        len(rt_rv3): rt_ov1
        rt_write(_): rt_or rt_rv3
    ]
    if(_): {nm = "getf"} [
        at(rt_o1): rt_ok2 0
        at(rt_o2): rt_ok2 1
        ex_val(rt_ov1): rt_o1
        ex_val(rt_ov2): rt_o2
        getf(rt_rv4): rt_ov1 rt_ov2
        rt_write(_): rt_or rt_rv4
    ]
    if(_): {nm = "setf"} [
        at(rt_o1): rt_ok2 0
        at(rt_o2): rt_ok2 1
        at(rt_o3): rt_ok2 2
        ex_val(rt_ov1): rt_o1
        ex_val(rt_ov2): rt_o2
        ex_val(rt_ov3): rt_o3
        setf(_): rt_ov1 rt_ov2 rt_ov3
    ]
    if(_): {nm = "vec"} [
        at(rt_o1): rt_ok2 0
        ex_val(rt_ov1): rt_o1
        vec(rt_rv5): rt_ov1
        rt_write(_): rt_or rt_rv5
    ]
    if(_): {nm = "encode"} [
        at(rt_o1): rt_ok2 0
        ex_val(rt_ov1): rt_o1
        encode(rt_rv6): rt_ov1
        rt_write(_): rt_or rt_rv6
    ]
    if(_): {nm = "decode"} [
        at(rt_o1): rt_ok2 0
        ex_val(rt_ov1): rt_o1
        decode(rt_rv7): rt_ov1
        rt_write(_): rt_or rt_rv7
    ]
    if(_): {nm = "byte"} [
        at(rt_o1): rt_ok2 0
        at(rt_o2): rt_ok2 1
        ex_val(rt_ov1): rt_o1
        ex_val(rt_ov2): rt_o2
        byte(rt_rv8): rt_ov1 rt_ov2
        rt_write(_): rt_or rt_rv8
    ]
    if(_): {nm = "slice"} [
        at(rt_o1): rt_ok2 0
        at(rt_o2): rt_ok2 1
        at(rt_o3): rt_ok2 2
        ex_val(rt_ov1): rt_o1
        ex_val(rt_ov2): rt_o2
        ex_val(rt_ov3): rt_o3
        slice(rt_rv9): rt_ov1 rt_ov2 rt_ov3
        rt_write(_): rt_or rt_rv9
    ]
    if(_): {nm = "readfile"} [
        at(rt_o1): rt_ok2 0
        ex_val(rt_ov1): rt_o1
        readfile(rt_rv10): rt_ov1
        rt_write(_): rt_or rt_rv10
    ]
    if(_): {nm = "new"} [
