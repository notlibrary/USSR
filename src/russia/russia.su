ps_cmd_iter(r): nm rt pv k mode [
    set(r): 0
    if(_): {ps_stop = 0} [
        if(_): {mode = 2} [
            nd_new(r): 2 nm rt 0 pv
        ]
        if(_): {mode < 2} [
            if(_): {mode = 0} [
                ps_par(ps_it_par): 
                ps_istok(ps_it_h1): "!"
                if(_): {ps_it_h1 = 1} [
                    ps_adv(_): 0
                    setf(_): ps_it_par "s2" "hash"
                ]
                if(_): {ps_it_h1 = 0} [
                    ps_istok(ps_it_h2): "?"
                    if(_): {ps_it_h2 = 1} [
                        ps_adv(_): 0
                        setf(_): ps_it_par "s2" "hashref"
                    ]
                ]
                push(_): pv ps_it_par
            ]
            if(_): {mode = 1} [
                ps_block(ps_it_blk): 
                push(_): pv ps_it_blk
            ]
            ps_cur(ps_it_k2): 0
            set(ps_it_m2): 0
            if(_): {ps_it_k2 = 12} [
                set(ps_it_m2): 1
            ]
            if(_): {ps_it_k2 = 17} [
                set(ps_it_m2): 2
            ]
            if(_): {ps_it_k2 = 99} [
                set(ps_it_m2): 2
            ]
            if(_): {ps_it_k2 = 13} [
                set(ps_it_m2): 2
            ]
            # A block is the last element of a command: after one,
            # only another block (inline else) may continue it.
            if(_): {mode = 1} [
                if(_): {ps_it_m2 = 0} [
                    set(ps_it_m2): 2
