        if(_): {cv_s4h = "hashref"} [ cv_emit(_): 31 tgt 0 0 cv_ni3 ]
        else(_): [ cv_emit(_): 2 tgt cv_strict 0 cv_ni3 ]
    ]
    if(_): {t = 5} [
        getf(cv_s1): nd "s1"
        decode(cv_cv): cv_s1
        cv_const(cv_ci): cv_cv
        cv_emit(_): 1 tgt 0 0 cv_ci
    ]
    if(_): {t = 6} [
        getf(cv_s1): nd "s1"
        decode(cv_cv): cv_s1
        cv_const(cv_ci): cv_cv
        cv_emit(_): 1 tgt 0 0 cv_ci
    ]
    if(_): {t = 7} [
        getf(cv_s1): nd "s1"
        cv_const(cv_ci): cv_s1
        cv_emit(_): 1 tgt 0 0 cv_ci
    ]
    if(_): {t = 8} [
        getf(cv_s1): nd "s1"
        set(cv_cv): {1 = 2}
        if(_): {cv_s1 = "true"} [
            set(cv_cv): {1 = 1}
        ]
        cv_const(cv_ci): cv_cv
        cv_emit(_): 1 tgt 0 0 cv_ci
    ]
    if(_): {t = 9} [
        cv_const(cv_ci): null
        cv_emit(_): 1 tgt 0 0 cv_ci
    ]
    # a 'UNO' literal is decoded when it runs (its struct types may be
    # declared by then), as in ussr
    if(_): {t = 10} [
        getf(cv_s1): nd "s1"
        cv_const(cv_ci): cv_s1
        cv_emit(_): 1 tgt 0 0 cv_ci
        cv_name(cv_dni): "decode"
        cv_emit(_): 4 tgt 1 tgt cv_dni
    ]
    if(_): {t = 12} [
        set(cv_strict_was): cv_strict
        set(cv_strict): 1
        getf(cv_kd): nd "kids"
        at(cv_kr): cv_kd 1
        cv_e(r): cv_kr tgt
        getf(cv_kd): nd "kids"
