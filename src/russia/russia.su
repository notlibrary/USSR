    set(rt_repl): 0
    if(_): {arg_cnt = 0} [
        set(rt_repl): 1
    ]
    if(_): {rt_repl = 0 && rt_conly = 0} [
        init_src(init_st): arg_vec
        if(_): {init_st = 1} [
            return(_): 1
        ]
    ]
    struct(In): "op:number" "a:number" "b:number" "c:number" "imm:number" "mnemonic:string"
    struct(vm_rv): "v:any"
    struct(vm_fr): "rip:number" "sv:vector" "crt:string" "loc:vector" "ln:vector"
    struct(cv_lp): "top:number" "brk:vector" "cnt:vector" "done:number"
    struct(cv_fd2): "name:string" "entry:number" "nparams:number" "retname:string" "prm:vector" "locs:vector"
    vec(cv_code): "In"
    vec(cv_consts): ""
    vec(cv_names): ""
    vec(cv_funcs): "cv_fd2"
    vec(cv_own): ""
    vec(cv_iline): ""
    vec(cv_icmd): ""
    set(cv_curl): 0
    set(cv_curc): ""
    vec(rt_hash): "rt_sp"
    vec(cv_pglob): ""
    set(cv_pall): 0
    vec(cv_lps): "cv_lp"
    vec(vm_frames): "vm_fr"
    vec(vm_regs): "vm_rv"
    set(vm_ip): 0
    set(vm_flow): 0
    set(vm_sp): 0
    set(rt_na0): 0
    set(rt_na1): 0
    set(rt_na2): 0
    set(rt_na3): 0
    set(rt_na4): 0
    set(rt_na5): 0
    set(rt_na6): 0
    vm_init_i(_): 0
