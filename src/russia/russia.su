        if(_): {ps_par_m = 0} [
            if(_): {ps_par_k = 20} [
                ps_txt(ps_par_op): 0
                ps_at(ps_par_nx): 1
                getf(ps_par_nk): ps_par_nx "kind"
                getf(ps_par_ns): ps_par_nx "text"
                concat(ps_par_neg): "-" ps_par_ns
                if(_): {ps_par_op = "-" && ps_par_nk = 2} [
                    ps_adv(_): 0
