        add(cv_t3r): 16 idx
        at(cv_p3): kids idx
        set(cv_isc): 0
        if(_): {idx = sp} [ set(cv_isc): 1 ]
        if(_): {cv_isc = 1} [
            cv_scname(_): cv_p3 cv_t3r
        ]
        if(_): {cv_isc = 0} [
            cv_e(_): cv_p3 cv_t3r
        ]
        add(cv_i3n): idx 1
        cv_nat3_i(r): nd kids nm cv_i3n sp
    ]
    if(_): {idx = cv_n3l} [
        cv_name(cv_n3i): nm
        getf(cv_r3): nd "s2"
        cv_name(cv_r3i): cv_r3
        cv_emit(_): 4 16 cv_n3l 16 cv_n3i
        cv_emit(_): 3 16 0 0 cv_r3i
    ]
]
cv_async2(r): nd [
    getf(cv_nk): nd "kids"
    cv_nat3_i(r): nd cv_nk "async" 0 0
]
cv_process2(r): nd [
    getf(cv_nk): nd "kids"
    cv_nat3_i(r): nd cv_nk "process" 0 0
]
cv_load2(r): nd [
    getf(cv_nk): nd "kids"
    cv_nat3_i(r): nd cv_nk "load" 0 1
]
# Does this program use scheduler commands anywhere? When it does the
# bytecode route is mandatory (the tree walker cannot suspend), so
# cv_driver clears rt_need_ast and forces the VM path.
rt_need_vm(r): nd [
    set(r): 0
    getf(rt_nvt): nd "tag"
    if(_): {rt_nvt = 2} [
        getf(rt_nvn): nd "s1"
        if(_): {rt_nvn = "async"} [ set(r): 1 ]
        if(_): {rt_nvn = "await"} [ set(r): 1 ]
        if(_): {rt_nvn = "sleep"} [ set(r): 1 ]
        if(_): {rt_nvn = "yield"} [ set(r): 1 ]
        if(_): {rt_nvn = "gc"} [ set(r): 1 ]
        if(_): {rt_nvn = "process"} [ set(r): 1 ]
        if(_): {rt_nvn = "load"} [ set(r): 1 ]
    ]
    if(_): {r = 0} [
        getf(rt_nvk): nd "kids"
        rt_need_vm_i(r): rt_nvk 0
    ]
]
rt_need_vm_i(r): items i [
    set(r): 0
    len(rt_nvl): items
    if(_): {i < rt_nvl} [
        at(rt_nvd): items i
        rt_need_vm(rt_nvr): rt_nvd
        if(_): {rt_nvr = 1} [
            set(r): 1
        ]
        if(_): {rt_nvr = 0} [
            add(rt_nvi): i 1
            rt_need_vm_i(r): items rt_nvi
