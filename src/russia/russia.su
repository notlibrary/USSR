    if(_): {op = 26} [ set(r): 30 ]
    if(_): {op = 27} [ set(r): 31 ]
    if(_): {op = 28} [ set(r): 32 ]
    if(_): {op = 29} [ set(r): 21 ]
    if(_): {op = 30} [ set(r): 69 ]
    if(_): {op = 31} [ set(r): 4 ]
    if(_): {op = 32} [ set(r): 5 ]
]
