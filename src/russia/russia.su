            getf(rt_eroot): ps_root "kids"
            ex_block_h(_): rt_eroot 0
            set(rt_flow): 0
            getf(rt_en): nd "s2"
            rt_read(rt_evr): rt_en
            rt_write(_): rt_en rt_evr
        ]
        if(_): {nm = "random64"} [
            getf(rt_rrn): nd "s2"
            random64(rt_rrv):
            rt_write(_): rt_rrn rt_rrv
        ]
        if(_): {nm = "seed_random64"} [
            getf(rt_srk): nd "kids"
            at(rt_sr0): rt_srk 0
            ex_val(rt_srv): rt_sr0
            seed_random64(rt_srr): rt_srv
            getf(rt_srn): nd "s2"
            rt_write(_): rt_srn rt_srv
