# ---- VM runtime ----
# register = vm_rv{v}; frame = vm_fr{rip, sv, crt}
vm_reg(r): k [
    at(r): vm_regs k
    getf(r): r "v"
]
vm_setreg(r): k val [
    at(r): vm_regs k
