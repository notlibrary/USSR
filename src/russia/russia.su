# ---- structs and objects: real host structs ----
# struct(Name): "field:type" ... declares Name on the host itself (through
# eval: the host's struct takes literal text), so new, getf, setf, vec,
# encode, decode and typeof work on host objects with ussr's own checks
# and error messages.
rt_struct_decl(r): name specs [
    set(rt_sds): "struct("
    concat(rt_sds): rt_sds name
    concat(rt_sds): rt_sds "):"
    len(rt_sdn): specs
    set(rt_sdi): 0
    while(_): {rt_sdi < rt_sdn} [
        at(rt_sdp): specs rt_sdi
        ex_scape(rt_sde): rt_sdp
        concat(rt_sds): rt_sds " \""
        concat(rt_sds): rt_sds rt_sde
        concat(rt_sds): rt_sds "\""
        add(rt_sdi): rt_sdi 1
    ]
    eval(r): rt_sds
]
# new(o): tn v1 ... with the values in vals (up to 10 of them).
rt_new(r): tn vals [
    set(r): null
    len(rt_nwn): vals
    if(_): {rt_nwn = 0} [
        new(r): tn
    ]
    if(_): {rt_nwn = 1} [
        at(rt_nw0): vals 0
        new(r): tn rt_nw0
    ]
    if(_): {rt_nwn = 2} [
        at(rt_nw0): vals 0
        at(rt_nw1): vals 1
        new(r): tn rt_nw0 rt_nw1
    ]
    if(_): {rt_nwn = 3} [
        at(rt_nw0): vals 0
        at(rt_nw1): vals 1
        at(rt_nw2): vals 2
        new(r): tn rt_nw0 rt_nw1 rt_nw2
    ]
    if(_): {rt_nwn = 4} [
        at(rt_nw0): vals 0
        at(rt_nw1): vals 1
        at(rt_nw2): vals 2
        at(rt_nw3): vals 3
        new(r): tn rt_nw0 rt_nw1 rt_nw2 rt_nw3
    ]
    if(_): {rt_nwn = 5} [
        at(rt_nw0): vals 0
        at(rt_nw1): vals 1
        at(rt_nw2): vals 2
        at(rt_nw3): vals 3
        at(rt_nw4): vals 4
        new(r): tn rt_nw0 rt_nw1 rt_nw2 rt_nw3 rt_nw4
    ]
    if(_): {rt_nwn = 6} [
        at(rt_nw0): vals 0
        at(rt_nw1): vals 1
        at(rt_nw2): vals 2
        at(rt_nw3): vals 3
        at(rt_nw4): vals 4
        at(rt_nw5): vals 5
        new(r): tn rt_nw0 rt_nw1 rt_nw2 rt_nw3 rt_nw4 rt_nw5
