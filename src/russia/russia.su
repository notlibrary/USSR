    struct(rt_sv): "n:string" "had:number" "v:any" "t:string"
    struct(rt_fd): "n:string" "prm:vector" "ret:string" "body:any"
    vec(rt_store): "rt_sp"
    vec(rt_fdefs): "rt_fd"
    set(rt_flow): 0
    set(rt_undef): 0
    set(cv_strict): 0
    set(ps_quiet): 0
    set(ps_errline): 0
    set(cv_regpush): 0
    set(vm_nbase): 16
    # Scheduler state: process table, run queue, process(_) marks,
