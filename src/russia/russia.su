ua_emit(r): op a b c imm [
    ua_name(cv_mnemonic): op
    if(_): {cv_mnemonic = "INVALID"} [
        print(_): "UUASM assembler: unsupported opcode"
        set(vm_flow): 1
        set(r): {0 - 1}
        return(r): r
    ]
    new(cv_in): "In" op a b c imm cv_mnemonic
    push(_): cv_code cv_in
    push(_): cv_own {0 - 1}
    push(_): cv_iline cv_curl
    push(_): cv_icmd cv_curc
    len(cv_el): cv_code
    sub(r): cv_el 1
]
cv_emit(r): op a b c imm [
