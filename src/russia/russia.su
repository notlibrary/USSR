    len(cobl): items
    set(r): 0
    if(_): {i < cobl} [
        at(cob): items i
        getf(cobt): cob "tag"
        set(cisbrk): 0
        if(_): {cobt = 2} [
            getf(cobn): cob "s1"
            if(_): {cobn = "break"} [ set(cisbrk): 1 ]
            if(_): {cobn = "option"} [ set(cisbrk): 2 ]
            if(_): {cobn = "default"} [ set(cisbrk): 2 ]
        ]
        if(_): {cisbrk = 1} [
            cv_emit(cobj): 7 0 0 0 0
            getf(clst3): lp "brk"
            push(_): clst3 cobj
            add(cobn2): i 1
            getf(ccnt3): lp "cnt"
            at(ccx): ccnt3 0
            setf(_): ccx "v" cobn2
        ]
        if(_): {cisbrk = 2} [
            getf(ccnt5): lp "cnt"
            at(ccx3): ccnt5 0
            setf(_): ccx3 "v" i
        ]
        set(cbgo): 1
        if(_): {cisbrk = 1} [ set(cbgo): 0 ]
        if(_): {cisbrk = 2} [ set(cbgo): 0 ]
        if(_): {cbgo = 1} [
            cv_one(r): cob
            add(cobn3): i 1
            cv_opt_body(r): items cobn3 lp
        ]
    ]
    if(_): {i = cobl} [
        getf(ccnt4): lp "cnt"
        at(ccx2): ccnt4 0
        setf(_): ccx2 "v" i
    ]
]
cv_ch_end(r): items nexti lp [
    len(cend): cv_code
    getf(clst2): lp "brk"
    cv_pv_i(r): clst2 0 cend
    setf(_): lp "done" 1
    cv_stmt_i(r): items nexti
]
cv_one(r): item [
    getf(cv_ot): item "tag"
    set(r): 0
    if(_): {cv_ot = 3} [
        cv_stmt(r): item
    ]
    if(_): {cv_ot = 2} [
        cv_cmd(r): item
    ]
]
# ---- while with break/continue fixups ----
cv_while(r): nd [
    getf(cv_wk): nd "kids"
    at(cv_wc): cv_wk 0
    len(cv_wcl): cv_code
    vec(cv_lb): ""
    vec(cv_lc): ""
    new(cv_lp): "cv_lp" cv_wcl cv_lb cv_lc 0
    push(_): cv_lps cv_lp
    set(cv_wi2): cv_wcl
    cv_e(_): cv_wc 16
    cv_emit(cv_wp): 9 16 0 0 0
    at(cv_wb2): cv_wk 1
    cv_stmt(r): cv_wb2
    cv_emit(_): 7 0 0 0 cv_wi2
    len(cv_wend): cv_code
    cv_patch(_): cv_code cv_wp {0 - 1} cv_wend
    cv_patchv(_): cv_lp cv_wend cv_wi2
    setf(_): cv_lp "done" 1
    set(r): 0
]
cv_for(r): nd [
    getf(cv_fk): nd "kids"
    len(cv_fnl): cv_fk
    if(_): {cv_fnl = 2} [
        at(cv_fblock): cv_fk 1
        getf(cv_fbk): cv_fblock "kids"
        len(cv_fbn): cv_fbk
        if(_): {cv_fbn < 2} [
            print(_): "for requires initializer and iterator commands"
        ]
        if(_): {cv_fbn > 1} [
            at(cv_finit): cv_fbk 0
            at(cv_fiter): cv_fbk 1
            cv_cmd(r): cv_finit
            len(cv_fcond): cv_code
            vec(cv_fbrk): ""
            vec(cv_fcnt): ""
            new(cv_flp): "cv_lp" cv_fcond cv_fbrk cv_fcnt 0
            push(_): cv_lps cv_flp
            at(cv_fcondarg): cv_fk 0
            cv_e(_): cv_fcondarg 16
            cv_emit(cv_ffj): 9 16 0 0 0
            set(cv_fbody_i): 2
            cv_stmt_i(r): cv_fbk cv_fbody_i
            len(cv_fiterpos): cv_code
            cv_cmd(r): cv_fiter
            cv_emit(_): 7 0 0 0 cv_fcond
            len(cv_fend): cv_code
            cv_patch(_): cv_code cv_ffj {0 - 1} cv_fend
            cv_patchv(_): cv_flp cv_fend cv_fiterpos
            setf(_): cv_flp "done" 1
        ]
    ]
    if(_): {cv_fnl != 2} [
        print(_): "for requires condition and body"
    ]
    set(r): 0
]
cv_patchv(r): lp end top [
    getf(cv_pb): lp "brk"
    getf(cv_pc): lp "cnt"
    cv_pv_i(r): cv_pb 0 end
    cv_pv_i(r): cv_pc 0 top
    set(r): 0
]
cv_pv_i(r): vec i target [
    len(cv_pvl): vec
    set(r): 0
    if(_): {i < cv_pvl} [
        at(cv_pvi): vec i
        cv_patch(_): cv_code cv_pvi {0 - 1} target
        add(cv_pv2): i 1
        cv_pv_i(r): vec cv_pv2 target
    ]
]
cv_break(r): nd [
    len(cv_bll): cv_lps
    sub(cv_bl2): cv_bll 1
    cv_findlp(cv_bl3): cv_bl2
    if(_): {cv_bl3 < 0} [
        print(_): "break outside loop"
    ]
    if(_): {cv_bl3 + 1 > 0} [
        at(cv_blp): cv_lps cv_bl3
        cv_emit(cv_bx): 7 0 0 0 0
        getf(cv_blb): cv_blp "brk"
        push(_): cv_blb cv_bx
    ]
    set(r): 0
]
cv_continue(r): nd [
    len(cv_cll): cv_lps
    sub(cv_cl3): cv_cll 1
    cv_findlp(cv_cl4): cv_cl3
    if(_): {cv_cl4 < 0} [
        print(_): "continue outside loop"
    ]
    if(_): {cv_cl4 + 1 > 0} [
        at(cv_clp): cv_lps cv_cl4
        getf(cv_clc): cv_clp "cnt"
        cv_emit(cv_cj): 7 0 0 0 0
        push(_): cv_clc cv_cj
    ]
    set(r): 0
]
cv_findlp(r): i [
    set(r): {0 - 1}
    if(_): {i + 1 > 0} [
        at(cv_flp): cv_lps i
        getf(cv_fld): cv_flp "done"
        if(_): {cv_fld = 0} [
            set(r): i
        ]
        if(_): {cv_fld = 1} [
            sub(cv_fi2): i 1
            cv_findlp(r): cv_fi2
        ]
    ]
]
cv_return(r): nd [
    getf(cv_rk2): nd "kids"
    len(cv_rl2): cv_rk2
    if(_): {cv_rl2 = 1} [
        at(cv_r0): cv_rk2 0
        cv_e(_): cv_r0 16
    ]
    cv_emit(_): 6 16 1 0 0
    set(r): 0
]

# ---- definitions and calls ----
cv_findf2_i(r): nm i [
    len(cv_ffl): cv_funcs
    set(r): {0 - 1}
    if(_): {i < cv_ffl} [
        at(cv_ffp): cv_funcs i
        getf(cv_ffn): cv_ffp "name"
        set(cv_ffok): 0
        if(_): {cv_ffn = nm} [
            set(cv_ffok): 1
        ]
        if(_): {cv_ffok = 1} [
            set(r): i
        ]
        if(_): {cv_ffok = 0} [
            add(cv_ffi2): i 1
            cv_findf2_i(r): nm cv_ffi2
        ]
    ]
]
cv_findf2(r): nm [
    cv_findf2_i(r): nm 0
]
# 1 when the compiler handles nm itself (a builtin or control command),
# 0 when nm is a user function call or definition.
cv_known(r): nm [
    set(r): 0
    if(_): {nm = "set"} [ set(r): 1 ]
    if(_): {nm = "print"} [ set(r): 1 ]
    if(_): {nm = "add"} [ set(r): 1 ]
    if(_): {nm = "sub"} [ set(r): 1 ]
    if(_): {nm = "mul"} [ set(r): 1 ]
    if(_): {nm = "div"} [ set(r): 1 ]
    if(_): {nm = "mod"} [ set(r): 1 ]
    if(_): {nm = "concat"} [ set(r): 1 ]
    if(_): {nm = "break"} [ set(r): 1 ]
    if(_): {nm = "continue"} [ set(r): 1 ]
    if(_): {nm = "return"} [ set(r): 1 ]
    if(_): {nm = "while"} [ set(r): 1 ]
    if(_): {nm = "for"} [ set(r): 1 ]
    if(_): {nm = "push"} [ set(r): 1 ]
    if(_): {nm = "at"} [ set(r): 1 ]
    if(_): {nm = "len"} [ set(r): 1 ]
    if(_): {nm = "typeof"} [ set(r): 1 ]
    if(_): {nm = "getf"} [ set(r): 1 ]
    if(_): {nm = "setf"} [ set(r): 1 ]
    if(_): {nm = "vec"} [ set(r): 1 ]
    if(_): {nm = "encode"} [ set(r): 1 ]
    if(_): {nm = "decode"} [ set(r): 1 ]
    if(_): {nm = "new"} [ set(r): 1 ]
    if(_): {nm = "template"} [ set(r): 1 ]
    if(_): {nm = "byte"} [ set(r): 1 ]
    if(_): {nm = "slice"} [ set(r): 1 ]
    if(_): {nm = "readfile"} [ set(r): 1 ]
    if(_): {nm = "random64"} [ set(r): 1 ]
    if(_): {nm = "time"} [ set(r): 1 ]
    if(_): {nm = "eval"} [ set(r): 1 ]
    if(_): {nm = "get"} [ set(r): 1 ]
    if(_): {nm = "global"} [ set(r): 1 ]
    if(_): {nm = "seed_random64"} [ set(r): 1 ]
    if(_): {nm = "scan"} [ set(r): 1 ]
    if(_): {nm = "do"} [ set(r): 1 ]
    if(_): {nm = "struct"} [ set(r): 1 ]
    if(_): {nm = "await"} [ set(r): 1 ]
    if(_): {nm = "sleep"} [ set(r): 1 ]
    if(_): {nm = "yield"} [ set(r): 1 ]
    if(_): {nm = "gc"} [ set(r): 1 ]
    if(_): {nm = "async"} [ set(r): 1 ]
    if(_): {nm = "process"} [ set(r): 1 ]
    if(_): {nm = "load"} [ set(r): 1 ]
    if(_): {nm = "open_file"} [ set(r): 1 ]
    if(_): {nm = "close_file"} [ set(r): 1 ]
    if(_): {nm = "write_file"} [ set(r): 1 ]
    if(_): {nm = "read_file"} [ set(r): 1 ]
    if(_): {nm = "set_bytes"} [ set(r): 1 ]
    if(_): {nm = "clear_bytes"} [ set(r): 1 ]
    if(_): {nm = "if"} [ set(r): 1 ]
    if(_): {nm = "elif"} [ set(r): 1 ]
    if(_): {nm = "else"} [ set(r): 1 ]
    if(_): {nm = "choose"} [ set(r): 1 ]
    if(_): {nm = "option"} [ set(r): 1 ]
    if(_): {nm = "loop"} [ set(r): 1 ]
]
# A command with a trailing block defines nm (ussr's rule: a builtin
# cannot take a block); without one it calls nm. Calling an unknown name
# fails the process when it runs, as in ussr.
cv_defcall2(r): nd nm [
    cv_hasblk(cv_hb): nd
    if(_): {cv_hb = 1} [
        cv_regdef(r): nd nm
    ]
    if(_): {cv_hb = 0} [
        cv_findf2(cv_df): nm
        if(_): {cv_df + 1 > 0} [
            cv_call(r): nd cv_df
        ]
        # anything else is an external command, run by the host as ussr
        # runs it (a program that does not exist fails the process)
        if(_): {cv_df < 0} [
            cv_const(cv_xnc): nm
            cv_emit(_): 1 16 0 0 cv_xnc
            getf(cv_xk): nd "kids"
            len(cv_xn): cv_xk
            set(cv_xi): 0
            while(_): {cv_xi < cv_xn} [
                at(cv_xa): cv_xk cv_xi
                cv_e(_): cv_xa {17 + cv_xi}
                add(cv_xi): cv_xi 1
            ]
            cv_name(cv_xni): "__ext"
            cv_emit(_): 4 16 {cv_xn + 1} 16 cv_xni
            cv_store(_): 16 nd
        ]
    ]
]
cv_hasblk(r): nd [
    set(r): 0
    getf(cv_hk): nd "kids"
    len(cv_hkl): cv_hk
    if(_): {cv_hkl > 0} [
        at(cv_hkn): cv_hk {cv_hkl - 1}
        getf(cv_hkt): cv_hkn "tag"
        if(_): {cv_hkt = 3} [ set(r): 1 ]
    ]
]
# Register every top-level definition before compiling, so a call may
# come before the definition (as ussr allows). Entries are filled in by
# cv_regdef when the body is compiled.
cv_predecl(r): prog [
    set(r): 0
    getf(cv_pdk): prog "kids"
    len(cv_pdn): cv_pdk
    set(cv_pdi): 0
    while(_): {cv_pdi < cv_pdn} [
        at(cv_pdc): cv_pdk cv_pdi
        getf(cv_pdt): cv_pdc "tag"
        if(_): {cv_pdt = 2} [
            getf(cv_pdnm): cv_pdc "s1"
            cv_known(cv_pdkn): cv_pdnm
            cv_hasblk(cv_pdhb): cv_pdc
            if(_): {cv_pdkn = 0 && cv_pdhb = 1} [
                cv_findf2(cv_pdf): cv_pdnm
                if(_): {cv_pdf < 0} [
                    vec(cv_pdprm): ""
                    vec(cv_pdlocs): ""
                    new(cv_pdfd): "cv_fd2" "" 0 0 "" cv_pdprm cv_pdlocs
                    setf(_): cv_pdfd "name" cv_pdnm
                    setf(_): cv_pdfd "entry" {0 - 1}
                    getf(cv_pdkids): cv_pdc "kids"
                    len(cv_pdkl): cv_pdkids
                    sub(cv_pdnp): cv_pdkl 1
                    setf(_): cv_pdfd "nparams" cv_pdnp
                    getf(cv_pdrt): cv_pdc "s2"
                    setf(_): cv_pdfd "retname" cv_pdrt
                    set(cv_pdj): 0
                    while(_): {cv_pdj < cv_pdnp} [
                        at(cv_pdp): cv_pdkids cv_pdj
                        push(_): cv_pdprm cv_pdp
                        add(cv_pdj): cv_pdj 1
                    ]
                    setf(_): cv_pdfd "prm" cv_pdprm
                    push(_): cv_funcs cv_pdfd
                ]
            ]
        ]
        add(cv_pdi): cv_pdi 1
    ]
]
cv_regdef(r): nd nm [
    getf(cv_rk3): nd "kids"
    len(cv_rkl): cv_rk3
    sub(cv_rb): cv_rkl 1
    getf(cv_rr): nd "s2"
    cv_emit(cv_jx): 7 0 0 0 0
    len(cv_ent): cv_code
    vec(cv_prm): ""
    set(cv_ri): 0
    set(cv_rent): cv_ent
    cv_regdef_i(r): nd cv_prm cv_ri cv_rb
    cv_name(cv_rrn): cv_rr
    cv_emit(_): 2 16 0 0 cv_rrn
    cv_emit(_): 6 16 1 0 0
    getf(cv_rnm): nd "s1"
    cv_findf2(cv_rfx): cv_rnm
    if(_): {cv_regpush = 1} [
        len(cv_rfl): cv_funcs
        set(cv_rfx): {cv_rfl - 1}
    ]
    getf(cv_rbk): nd "kids"
    at(cv_rbody): cv_rbk cv_rb
    cv_locals(_): cv_rfx cv_rent cv_rbody
    len(cv_la2): cv_code
    cv_patch(_): cv_code cv_jx {0 - 1} cv_la2
    set(r): 0
]
# The top level's global(_) declarations for the program being compiled.
cv_progglobals(r): prog [
    set(cv_gall): 0
    vec(cv_pglob): ""
    cv_gnames(r): prog cv_pglob
    set(cv_pall): cv_gall
]
# global(_) names declared in list and its blocks, not inside the
# definitions there (they have their own); "*" sets cv_gall.
cv_gnames(r): list names [
    set(r): 0
    getf(cv_gnk): list "kids"
    len(cv_gnn): cv_gnk
    set(cv_gni): 0
    while(_): {cv_gni < cv_gnn} [
        at(cv_gnc): cv_gnk cv_gni
        getf(cv_gnt): cv_gnc "tag"
        if(_): {cv_gnt = 3} [ cv_gnames(_): cv_gnc names ]
        if(_): {cv_gnt = 2} [
            getf(cv_gnm): cv_gnc "s1"
            cv_hasblk(cv_gnb): cv_gnc
            cv_known(cv_gnkn): cv_gnm
            set(cv_gndef): 0
            if(_): {cv_gnb = 1 && cv_gnkn = 0} [ set(cv_gndef): 1 ]
            getf(cv_gnargs): cv_gnc "kids"
            len(cv_gnan): cv_gnargs
            set(cv_gnj): 0
            while(_): {cv_gndef = 0 && cv_gnj < cv_gnan} [
                at(cv_gna): cv_gnargs cv_gnj
                getf(cv_gnat): cv_gna "tag"
                if(_): {cv_gnm = "global" && cv_gnat = 4} [
                    getf(cv_gnas): cv_gna "s1"
                    push(_): names cv_gnas
                ]
                if(_): {cv_gnm = "global" && cv_gnat = 7} [
                    getf(cv_gnas2): cv_gna "s1"
                    if(_): {cv_gnas2 = "*"} [ set(cv_gall): 1 ]
                ]
                if(_): {cv_gnm != "global" && cv_gnat = 3} [ cv_gnames(_): cv_gna names ]
                add(cv_gnj): cv_gnj 1
            ]
        ]
        add(cv_gni): cv_gni 1
    ]
]
cv_inlist(r): v x [
    set(r): 0
    len(cv_iln): v
    set(cv_ili): 0
    while(_): {r = 0 && cv_ili < cv_iln} [
        at(cv_ilx): v cv_ili
        if(_): {cv_ilx = x} [ set(r): 1 ]
        add(cv_ili): cv_ili 1
    ]
]
# bc_function_locals: function fi's locals are its parameters, its return
# variable and every name its own code (from entry on, not its nested
# functions') stores to, except names declared global in it or at the top
# level ("*" makes all of those global). Its LOAD_VAR/STORE_VAR of a local
# get the slot + 1 in c; c = 0 means global.
# ---------- scope warnings (bc_scope_warnings) ----------
# The mistakes function locals make likely, warned about on stderr after
# compiling (never stopping it), worded exactly as ussr words them:
#  - a function reads one of its locals before setting it;
#  - a function sets a local it never reads while other code reads that
#    name (a flag or result meant for the caller);
#  - a name is read as a global but only ever set as a local.
# A function's closing LOAD of its return variable (before RET), and the
# LOAD after an EVAL, are not reads: ussr has neither.

# 1 when name is one of function fi's parameters.
cv_w_isparam(r): fi name [
    set(r): 0
    at(cwp_fd): cv_funcs fi
    getf(cwp_prm): cwp_fd "prm"
    len(cwp_n): cwp_prm
    set(cwp_i): 0
    while(_): {r = 0 && cwp_i < cwp_n} [
        at(cwp_x): cwp_prm cwp_i
        getf(cwp_xs): cwp_x "s1"
        if(_): {cwp_xs = name} [ set(r): 1 ]
        add(cwp_i): cwp_i 1
    ]
]
# 1 when instruction k is a LOAD_VAR/STORE_VAR that counts as an access.
cv_w_access(r): k [
    set(r): 0
    at(cwa_in): cv_code k
    getf(cwa_op): cwa_in "op"
    if(_): {cwa_op = 3} [ set(r): 1 ]
    if(_): {cwa_op = 2} [
        set(r): 1
        # eval's result is read back after EVAL; ussr's EVAL reads it
        # itself
        if(_): {k > 0} [
            at(cwa_pv): cv_code {k - 1}
            getf(cwa_pop): cwa_pv "op"
            if(_): {cwa_pop = 69} [ set(r): 0 ]
        ]
        len(cwa_n): cv_code
        if(_): {k + 1 < cwa_n} [
            at(cwa_nx): cv_code {k + 1}
            getf(cwa_nop): cwa_nx "op"
            getf(cwa_nb): cwa_nx "b"
            at(cwa_ow): cv_own k
            if(_): {cwa_nop = 81 && cwa_nb = 1 && cwa_ow >= 0} [
                getf(cwa_im): cwa_in "imm"
                at(cwa_nm): cv_names cwa_im
                at(cwa_fd): cv_funcs cwa_ow
                getf(cwa_ret): cwa_fd "retname"
                if(_): {cwa_nm = cwa_ret} [ set(r): 0 ]
            ]
        ]
    ]
]
# "file:line: warning: " for instruction k's command, or ussr's
# "USSR compiler: warning: " when it has no line.
cv_w_at(r): k [
    at(cwt_l): cv_iline k
    set(r): "USSR compiler: warning: "
    if(_): {cwt_l > 0} [
        ck_loc(r): cwt_l
        concat(r): r "warning: "
    ]
]
cv_w_say(r): k msg [
    cv_w_at(cws_p): k
    concat(cws_m): cws_p msg
    concat(cws_m): cws_m "\n"
    write_stderr(r): cws_m
]
# A vector of n zeros.
cv_w_zeros(r): n [
    vec(r): ""
    set(cwz_i): 0
    while(_): {cwz_i < n} [
        push(_): r 0
        add(cwz_i): cwz_i 1
    ]
]
cv_warnings(r): [
    set(r): 0
    if(_): {cv_pall = 1} [ return(_): r ]
    len(cw_nn): cv_names
    len(cw_cn): cv_code
    len(cw_fn): cv_funcs
    # LOAD_VAR count per name, the whole program (reads of a function's
    # own parameter excepted)
    cv_w_zeros(cw_reads): cw_nn
    set(cw_k): 0
    while(_): {cw_k < cw_cn} [
        cv_w_access(cw_ok): cw_k
        at(cw_in): cv_code cw_k
        getf(cw_op): cw_in "op"
        if(_): {cw_ok = 1 && cw_op = 2} [
            getf(cw_im): cw_in "imm"
            at(cw_nm): cv_names cw_im
            at(cw_ow): cv_own cw_k
            set(cw_cnt): 1
            if(_): {cw_ow >= 0} [
                cv_w_isparam(cw_ip): cw_ow cw_nm
                if(_): {cw_ip = 1} [ set(cw_cnt): 0 ]
            ]
            if(_): {cw_cnt = 1} [
                at(cw_rv): cw_reads cw_im
                set(cw_reads): cw_im {cw_rv + 1}
            ]
        ]
        add(cw_k): cw_k 1
    ]
    # per function: locals read before set, and locals set but never read
    set(cw_f): 0
    while(_): {cw_f < cw_fn} [
        at(cw_fd): cv_funcs cw_f
        getf(cw_fname): cw_fd "name"
        getf(cw_fret): cw_fd "retname"
        cv_w_zeros(cw_seen): cw_nn
        cv_w_zeros(cw_lr): cw_nn
        cv_w_zeros(cw_fs): cw_nn
        vec(cw_touch): ""
        set(cw_k): 0
        while(_): {cw_k < cw_cn} [
            at(cw_ow): cv_own cw_k
            cv_w_access(cw_ok): cw_k
            at(cw_in): cv_code cw_k
            getf(cw_c): cw_in "c"
            if(_): {cw_ow = cw_f && cw_ok = 1 && cw_c > 0} [
                getf(cw_op): cw_in "op"
                getf(cw_im): cw_in "imm"
                at(cw_nm): cv_names cw_im
                at(cw_sn): cw_seen cw_im
                at(cw_lrn): cw_lr cw_im
                at(cw_fsn): cw_fs cw_im
                if(_): {cw_sn = 0 && cw_lrn = 0 && cw_fsn = 0} [
                    push(_): cw_touch cw_im
                ]
                if(_): {cw_op = 3} [
