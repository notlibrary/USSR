]

# ---------- REPL ----------
# Read-eval-print loop, entered when russia.su itself runs with no target
# program (./ussr russia.su), like ussr's run_repl. Lines are read from
# standard input a byte at a time (terminal_getch, -1 at end of input).
# Empty lines are skipped and not counted; input accumulates until square
# brackets balance (string-aware), then the entry is checked like a file
# named <stdin> (its lines numbered from the entry's first one), reported
# as ussr reports it, and otherwise run by the tree walker against the
# persistent rt_store/rt_fdefs, so variables and function definitions
# survive between entries. End of input exits the loop.

# One line without its line ending; sets rp_eof at end of input.
repl_rd(r): [
    global(_): rp_eof
    set(r): ""
    set(rrd_go): 1
    set(rrd_any): 0
    while(_): {rrd_go = 1} [
        terminal_getch(rrd_c):
        if(_): {rrd_c < 0} [ set(rrd_go): 0 ]
        if(_): {rrd_c = 10} [
            set(rrd_go): 0
            set(rrd_any): 1
        ]
        if(_): {rrd_c > 0 && rrd_c != 10 && rrd_c != 13} [
            set(rrd_any): 1
            chr(rrd_ch): rrd_c
            concat(r): r rrd_ch
        ]
        if(_): {rrd_c = 13} [ set(rrd_any): 1 ]
    ]
    if(_): {rrd_any = 0} [ set(rp_eof): 1 ]
]

repl_dep(r): s d [
    len(rd_n): s
    set(rd_i): 0
    set(rd_str): 0
    set(rd_esc): 0
    set(rd_d): d
    while(_): {rd_i < rd_n} [
        byte(rd_b): s rd_i
        set(rd_was): rd_str
        if(_): {rd_was = 1} [
            set(rd_skip): 0
            if(_): {rd_esc = 1} [
                set(rd_esc): 0
                set(rd_skip): 1
            ]
            if(_): {rd_skip = 0} [
                if(_): {rd_b = 92} [
                    set(rd_esc): 1
                ]
                if(_): {rd_b = 34} [
                    set(rd_str): 0
                ]
            ]
        ]
        if(_): {rd_was = 0} [
            if(_): {rd_b = 34} [
                set(rd_str): 1
            ]
            if(_): {rd_b = 91} [
                set(rd_d): {rd_d + 1}
            ]
            if(_): {rd_b = 93} [
                if(_): {rd_d > 0} [
                    set(rd_d): {rd_d - 1}
                ]
            ]
        ]
        set(rd_i): {rd_i + 1}
    ]
    set(r): rd_d
]

repl_exec(r): src first [
    vec(rex_mf): ""
    vec(rex_ml): ""
    len(rex_n): src
    set(rex_i): 0
    set(rex_ln): first
    push(_): rex_mf "<stdin>"
    push(_): rex_ml rex_ln
    while(_): {rex_i < rex_n} [
        byte(rex_b): src rex_i
        if(_): {rex_b = 10} [
            add(rex_ln): rex_ln 1
            push(_): rex_mf "<stdin>"
            push(_): rex_ml rex_ln
        ]
        add(rex_i): rex_i 1
    ]
    ck_run(rex_ck): src "<stdin>" rex_mf rex_ml
    if(_): {rex_ck = 1} [
        write_stderr(_): ck_msg
    ]
    if(_): {rex_ck = 0} [
        vec(lx_tokens): "lx_Tok"
        lx_scan(rex_ls): src
        if(_): {rex_ls = 0} [
            ps_parse(rex_ps): src
            if(_): {rex_ps = 0} [
                getf(rex_kids): ps_root "kids"
                ex_block_h(_): rex_kids 0
            ]
        ]
    ]
    set(rt_flow): 0
    set(r): 0
]

repl(r): [
    global(_): rp_eof
    print(_): "USSR Unified Shell Script REPL"
    print(_): "USSR v0.4"
    print(_): "Enter a command list or press Ctrl-D to exit."
    print(_): ""
    set(rp_buf): ""
    set(rp_dep): 0
    set(rp_eof): 0
    set(rp_lines): 0
    set(rp_first): 1
    while(_): {rp_eof = 0} [
        if(_): {rp_dep = 0} [
            template(_): "STR" "ussr> "
        ]
        if(_): {rp_dep > 0} [
            template(_): "STR" "... "
        ]
        repl_rd(rp_line): 
        len(rp_ll): rp_line
        if(_): {rp_eof = 0 && rp_ll > 0} [
            add(rp_lines): rp_lines 1
            len(rp_bl): rp_buf
            if(_): {rp_bl = 0} [ set(rp_first): rp_lines ]
            concat(rp_buf): rp_buf rp_line
            concat(rp_buf): rp_buf "\n"
            repl_dep(rp_dep): rp_line rp_dep
            if(_): {rp_dep < 1} [
                repl_exec(_): rp_buf rp_first
                set(rp_buf): ""
                set(rp_dep): 0
            ]
        ]
    ]
    print(_): ""
    set(r): 0
]
