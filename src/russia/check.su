]
ck_choose_label_p(r): cmd [
    getf(ck_clpn): cmd "name"
    set(r): 0
    if(_): {ck_clpn = "option" || ck_clpn = "default"} [ set(r): 1 ]
]
# bc_compile_until: commands start..stop of list (chains and do/loop
# pairs consume their followers).
ck_until(r): list start stop loop cur [
    set(r): 0
    len(ck_utn): list
    set(ck_uti): start
    while(_): {r = 0 && ck_uti < stop && ck_uti < ck_utn} [
        at(ck_utc): list ck_uti
        getf(ck_utnm): ck_utc "name"
        ck_argc(ck_utac): ck_utc
        set(ck_utouter): ck_ecmd
        set(ck_ecmd): ck_utc
        set(ck_utnext): {0 - 1}
        set(ck_uttried): 0
        if(_): {ck_utnm = "if" && ck_utac = 1} [
            set(ck_uttried): 1
            ck_cchain(ck_utnext): list ck_uti loop cur
        ]
        if(_): {ck_uttried = 0 && ck_utnm = "if" && ck_utac = 2 && ck_uti + 1 < ck_utn} [
            ck_argkind(ck_utk1): ck_utc 1
            at(ck_utnx): list {ck_uti + 1}
            ck_label_p(ck_utlab): ck_utnx
            if(_): {ck_utk1 = "block" && ck_utlab = 1} [
                set(ck_uttried): 1
                ck_bchain(ck_utnext): list ck_uti loop cur
            ]
        ]
        if(_): {ck_uttried = 0 && ck_utnm = "choose" && ck_utac = 1} [
            set(ck_uttried): 1
            ck_choose(ck_utnext): list ck_uti loop cur
        ]
        if(_): {ck_uttried = 1} [
            if(_): {ck_utnext < 0} [
                concat(ck_utm): "cannot compile '" ck_utnm
                concat(ck_utm): ck_utm "'"
                ck_err(r): ck_utc ck_utm
            ]
            set(ck_ecmd): ck_utouter
            set(ck_uti): ck_utnext
        ]
        if(_): {ck_uttried = 0} [
            set(ck_ecmd): ck_utouter
            ck_label_p(ck_utl1): ck_utc
            ck_choose_label_p(ck_utl2): ck_utc
            if(_): {ck_utl1 = 1 || ck_utl2 = 1} [
                set(ck_utwant): "if"
                if(_): {ck_utl2 = 1} [ set(ck_utwant): "choose" ]
                concat(ck_utm2): ck_utnm " without a matching "
                concat(ck_utm2): ck_utm2 ck_utwant
                concat(ck_utm2): ck_utm2 " before it"
                ck_err(r): ck_utc ck_utm2
            ]
            if(_): {r = 0} [ ck_command_c(r): list ck_uti loop cur ]
            if(_): {r = 0} [
                if(_): {ck_utnm = "do"} [
                    set(ck_utdl): 0
                    if(_): {ck_uti + 1 < ck_utn} [
                        at(ck_utdn): list {ck_uti + 1}
                        getf(ck_utdnm): ck_utdn "name"
                        if(_): {ck_utdnm = "loop"} [ set(ck_utdl): 1 ]
                    ]
                    if(_): {ck_utdl = 0} [
                        ck_err(r): ck_utc "do must be followed by loop(_): condition"
                    ]
                    add(ck_uti): ck_uti 2
                ]
                else(_): [
                    if(_): {ck_utnm = "loop"} [
                        ck_err(r): ck_utc "loop without a do before it"
                    ]
                    add(ck_uti): ck_uti 1
                ]
            ]
        ]
    ]
]
# if(_): c (block-less chain): returns the index after it, -1 on error.
ck_cchain(r): list first loop cur [
    set(r): {0 - 1}
    len(ck_ccn): list
    set(ck_ccb): first
    set(ck_ccok): 1
    set(ck_ccgo): 1
    while(_): {ck_ccok = 1 && ck_ccgo = 1} [
        set(ck_ccgo): 0
        if(_): {ck_ccb < ck_ccn} [
            at(ck_ccc): list ck_ccb
            ck_label_p(ck_cclab): ck_ccc
            if(_): {ck_ccb = first || ck_cclab = 1} [ set(ck_ccgo): 1 ]
        ]
        if(_): {ck_ccgo = 1} [
            add(ck_ccstop): ck_ccb 1
            set(ck_ccsgo): 1
            while(_): {ck_ccsgo = 1 && ck_ccstop < ck_ccn} [
                at(ck_ccs): list ck_ccstop
                ck_label_p(ck_ccsl): ck_ccs
                if(_): {ck_ccsl = 1} [ set(ck_ccsgo): 0 ]
                else(_): [ add(ck_ccstop): ck_ccstop 1 ]
            ]
            getf(ck_ccnm): ck_ccc "name"
            ck_argc(ck_ccac): ck_ccc
            if(_): {ck_ccnm = "else"} [
                if(_): {ck_ccac != 0} [
                    ck_err(_): ck_ccc "else takes no parameters here"
                    set(ck_ccok): 0
                ]
            ]
            else(_): [
                if(_): {ck_ccac != 1} [
                    concat(ck_ccm): ck_ccnm " expects one condition"
                    ck_err(_): ck_ccc ck_ccm
                    set(ck_ccok): 0
                ]
                if(_): {ck_ccok = 1} [
                    ck_cmd_arg(ck_ccr): ck_ccc 0 0
                    if(_): {ck_ccr != 0} [ set(ck_ccok): 0 ]
                ]
            ]
            if(_): {ck_ccok = 1} [
                ck_until(ck_ccr2): list {ck_ccb + 1} ck_ccstop loop cur
                if(_): {ck_ccr2 != 0} [ set(ck_ccok): 0 ]
            ]
            set(ck_ccb): ck_ccstop
        ]
    ]
    if(_): {ck_ccok = 1} [ set(r): ck_ccb ]
]
# if(_): c [ ] elif(_): c [ ] else(_): [ ]: index after it, -1 on error.
ck_bchain(r): list first loop cur [
    set(r): {0 - 1}
    len(ck_bcn): list
    set(ck_bcb): first
    set(ck_bcok): 1
    set(ck_bcgo): 1
    while(_): {ck_bcok = 1 && ck_bcgo = 1} [
        at(ck_bcc): list ck_bcb
        getf(ck_bcnm): ck_bcc "name"
        ck_argc(ck_bcac): ck_bcc
