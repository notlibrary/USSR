# bc_function_locals' check: a parameter or the return variable cannot be
# declared global.
ck_fn_locals(r): def fn body [
    vec(ck_flg): ""
    ck_globals(r): body ck_flg
    len(ck_fln): ck_flg
    set(ck_fli): 0
    getf(ck_flret): fn "ret"
    getf(ck_flprm): fn "prm"
    getf(ck_flname): fn "name"
    len(ck_flpn): ck_flprm
    while(_): {r = 0 && ck_fli < ck_fln} [
        at(ck_flx): ck_flg ck_fli
        set(ck_flis): 0
        if(_): {ck_flx = ck_flret} [ set(ck_flis): 1 ]
        set(ck_flj): 0
        while(_): {ck_flj < ck_flpn} [
            at(ck_flp): ck_flprm ck_flj
            if(_): {ck_flp = ck_flx} [ set(ck_flis): 1 ]
            add(ck_flj): ck_flj 1
        ]
        if(_): {ck_flis = 1} [
            concat(ck_flm): "'" ck_flx
            concat(ck_flm): ck_flm "' is a parameter or the return variable of '"
            concat(ck_flm): ck_flm ck_flname
            concat(ck_flm): ck_flm "' and cannot be global"
            ck_err(r): def ck_flm
        ]
        add(ck_fli): ck_fli 1
    ]
]
# bc_compile_functions: every function body, in source order.
ck_functions(r): list [
    set(r): 0
    len(ck_fun): list
    set(ck_fui): 0
    while(_): {r = 0 && ck_fui < ck_fun} [
        at(ck_fuc): list ck_fui
        ck_is_def(ck_fud): ck_fuc
        if(_): {ck_fud = 1} [
            getf(ck_funm): ck_fuc "name"
            ck_find_fn(ck_fufn): ck_funm
            ck_body_of(ck_fubody): ck_fuc
            ck_list(r): ck_fubody 0 1
            if(_): {r = 0} [ ck_fn_locals(r): ck_fuc ck_fufn ck_fubody ]
            if(_): {r = 0} [ ck_functions(r): ck_fubody ]
        ]
        if(_): {ck_fud = 0} [
            ck_argc(ck_fuac): ck_fuc
            set(ck_fuk): 0
            while(_): {r = 0 && ck_fuk < ck_fuac} [
                ck_arg(ck_fua): ck_fuc ck_fuk
                getf(ck_fuak): ck_fua "kind"
                if(_): {ck_fuak = "block"} [
                    getf(ck_fub): ck_fua "blk"
                    ck_functions(r): ck_fub
                ]
                add(ck_fuk): ck_fuk 1
            ]
        ]
        add(ck_fui): ck_fui 1
    ]
]
ck_compile(r): prog [
    vec(ck_fns): "ck_Fn"
    set(ck_ecmd): null
    set(ck_ccont): 0
    vec(ck_pglob): ""
    ck_globals(r): prog ck_pglob
    if(_): {r = 0} [ ck_collect(r): prog ]
    if(_): {r = 0} [ ck_functions(r): prog ]
    if(_): {r = 0} [ ck_list(r): prog 0 0 ]
]

ck_run(r): text name mapf mapl [
    if(_): {ck_sdef != 1} [
        struct(ck_Tok): "k:string" "s:string" "line:number"
        struct(ck_Arg): "kind:string" "s:string" "vt:string" "asg:number" "blk:any" "ex:any"
        struct(ck_E): "op:string" "l:any" "r:any"
        struct(ck_Cmd): "name:string" "ret:string" "line:number" "args:vector"
        struct(ck_Fn): "name:string" "np:number" "prm:vector" "ret:string"
        # byte classes for ck_lex: 1 digit, 2 identifier start
        # [A-Za-z_], 4 the other command-head bytes [./\:-]
        vec(ck_cls): ""
        set(ck_ci): 0
        while(_): {ck_ci < 256} [
            set(ck_cc): 0
            if(_): {ck_ci > 47 && ck_ci < 58} [ set(ck_cc): 1 ]
            if(_): {(ck_ci > 64 && ck_ci < 91) || (ck_ci > 96 && ck_ci < 123) || ck_ci = 95} [ set(ck_cc): 2 ]
            if(_): {ck_ci = 46 || ck_ci = 47 || ck_ci = 92 || ck_ci = 58 || ck_ci = 45} [ set(ck_cc): 4 ]
            push(_): ck_cls ck_cc
            add(ck_ci): ck_ci 1
        ]
        set(ck_sdef): 1
    ]
    set(ck_failed): 0
    set(ck_msg): ""
    set(ck_name): name
    set(ck_mapf): mapf
    set(ck_mapl): mapl
    set(ck_stage): 1
    ck_lex(_): text
    ck_parse(ck_prog):
    if(_): {ck_failed = 0} [
        set(ck_stage): 2
        ck_compile(_): ck_prog
    ]
    set(r): ck_failed
]
