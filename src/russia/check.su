    ]
]
ck_find_fn(r): name [
    set(r): null
    len(ck_ffn): ck_fns
    set(ck_ffi): 0
    while(_): {r = null && ck_ffi < ck_ffn} [
        at(ck_ffx): ck_fns ck_ffi
        getf(ck_ffnm): ck_ffx "name"
        if(_): {ck_ffnm = name} [ set(r): ck_ffx ]
        add(ck_ffi): ck_ffi 1
    ]
]
# bc_collect_functions: the function table, with its duplicate and
# parameter checks.
ck_collect(r): list [
    set(r): 0
    len(ck_cln): list
    set(ck_cli): 0
    while(_): {r = 0 && ck_cli < ck_cln} [
        at(ck_clc): list ck_cli
        ck_is_def(ck_cld): ck_clc
        if(_): {ck_cld = 1} [
            getf(ck_clnm): ck_clc "name"
            ck_find_fn(ck_clex): ck_clnm
            if(_): {ck_clex != null} [
                concat(ck_clm): "function '" ck_clnm
                concat(ck_clm): ck_clm "' is defined twice"
                ck_err(r): ck_clc ck_clm
            ]
            if(_): {r = 0} [
                ck_argc(ck_cln2): ck_clc
                sub(ck_clnp): ck_cln2 1
                vec(ck_clprm): ""
                set(ck_clj): 0
                while(_): {r = 0 && ck_clj < ck_clnp} [
                    ck_arg(ck_clp): ck_clc ck_clj
                    getf(ck_clpk): ck_clp "kind"
                    if(_): {ck_clpk != "var"} [
                        ck_num(ck_clpn): {ck_clj + 1}
                        concat(ck_clm2): "parameter " ck_clpn
                        concat(ck_clm2): ck_clm2 " of function '"
                        concat(ck_clm2): ck_clm2 ck_clnm
                        concat(ck_clm2): ck_clm2 "' must be a name"
                        ck_err(r): ck_clc ck_clm2
                    ]
                    if(_): {r = 0} [
                        getf(ck_clps): ck_clp "s"
                        push(_): ck_clprm ck_clps
                    ]
                    add(ck_clj): ck_clj 1
                ]
            ]
            if(_): {r = 0} [
                getf(ck_clret): ck_clc "ret"
                new(ck_clfn): "ck_Fn" ck_clnm ck_clnp ck_clprm ck_clret
                push(_): ck_fns ck_clfn
                ck_body_of(ck_clbody): ck_clc
                ck_collect(r): ck_clbody
            ]
        ]
        if(_): {ck_cld = 0} [
            ck_argc(ck_cln3): ck_clc
            set(ck_clk): 0
            while(_): {r = 0 && ck_clk < ck_cln3} [
                ck_arg(ck_cla): ck_clc ck_clk
                getf(ck_clak): ck_cla "kind"
                if(_): {ck_clak = "block"} [
                    getf(ck_clb): ck_cla "blk"
                    ck_collect(r): ck_clb
                ]
                add(ck_clk): ck_clk 1
            ]
        ]
        add(ck_cli): ck_cli 1
    ]
]
# ---- expressions and arguments (register depth as the compiler uses) ----
ck_short(r): e dst [
    set(r): 0
    getf(ck_shop): e "op"
    if(_): {ck_shop = "and" || ck_shop = "or"} [
        getf(ck_shl): e "l"
        getf(ck_shr2): e "r"
        ck_short(r): ck_shl dst
        if(_): {r = 0} [ ck_short(r): ck_shr2 dst ]
    ]
    else(_): [ ck_expr(r): e dst ]
]
ck_expr(r): e dst [
    set(r): 0
    if(_): {dst >= 31} [ set(r): 1 ]
    if(_): {r = 0} [
        getf(ck_exop): e "op"
        if(_): {ck_exop = "neg"} [
            getf(ck_exl): e "l"
            ck_expr(r): ck_exl dst
        ]
        if(_): {ck_exop = "bin" || ck_exop = "and" || ck_exop = "or"} [
            if(_): {dst + 2 >= 31} [
                ck_err(r): null "expression is nested too deeply; split it with set"
            ]
            if(_): {r = 0} [
                if(_): {ck_exop = "bin"} [
                    getf(ck_exl2): e "l"
                    getf(ck_exr2): e "r"
                    ck_expr(r): ck_exl2 {dst + 1}
                    if(_): {r = 0} [ ck_expr(r): ck_exr2 {dst + 2} ]
                ]
                else(_): [ ck_short(r): e dst ]
            ]
        ]
    ]
]
ck_argument_ok(r): a dst [
    set(r): 0
    if(_): {dst > 31} [ set(r): 1 ]
    if(_): {r = 0} [
        getf(ck_aok): a "kind"
        if(_): {ck_aok = "var" || ck_aok = "expr"} [
            getf(ck_aoe): a "ex"
            ck_short(r): ck_aoe dst
        ]
        if(_): {ck_aok = "block"} [
            ck_err(r): null "a [ ] block cannot be used as a value here"
        ]
    ]
]
ck_cmd_arg(r): cmd i dst [
    ck_arg(ck_caa): cmd i
    ck_argument_ok(r): ck_caa dst
]
ck_list(r): list loop cur [
    len(ck_lln): list
