    if(_): {done = 0 && nm = "file"} [
        set(done): 1
        if(_): {n != 1} [
            ck_got(m): "file expects one file name, got " n ""
            ck_err(r): c m
        ]
        if(_): {r = 0} [ ck_cmd_arg(r): c 0 0 ]
    ]
    if(_): {done = 0 && nm = "eval"} [
