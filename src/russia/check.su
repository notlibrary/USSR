]

# ---------- compiler checks ----------
ck_argc(r): cmd [
    getf(ck_acv): cmd "args"
    len(r): ck_acv
]
ck_arg(r): cmd i [
    getf(ck_agv): cmd "args"
    at(r): ck_agv i
]
ck_argkind(r): cmd i [
    ck_arg(ck_akx): cmd i
    getf(r): ck_akx "kind"
]
ck_name_of(r): cmd [
    getf(r): cmd "name"
]
# bc_is_definition: a trailing block on anything but a control command
ck_is_def(r): cmd [
    set(r): 0
    ck_argc(ck_idn): cmd
    if(_): {ck_idn > 0} [
        ck_argkind(ck_idk): cmd {ck_idn - 1}
        if(_): {ck_idk = "block"} [ set(r): 1 ]
    ]
    if(_): {r = 1} [
        getf(ck_idnm): cmd "name"
        if(_): {ck_idnm = "@" || ck_idnm = "if" || ck_idnm = "elif" || ck_idnm = "else"} [ set(r): 0 ]
        if(_): {ck_idnm = "choose" || ck_idnm = "option" || ck_idnm = "default" || ck_idnm = "for"} [ set(r): 0 ]
        if(_): {ck_idnm = "while" || ck_idnm = "break" || ck_idnm = "continue" || ck_idnm = "return"} [ set(r): 0 ]
        if(_): {ck_idnm = "do" || ck_idnm = "loop" || ck_idnm = "method" || ck_idnm = "each"} [ set(r): 0 ]
        if(_): {ck_idnm = "map" || ck_idnm = "filter"} [ set(r): 0 ]
    ]
]
ck_body_of(r): cmd [
    ck_argc(ck_bon): cmd
    ck_arg(ck_boa): cmd {ck_bon - 1}
    getf(r): ck_boa "blk"
]
# global(_) names in list and its blocks (not inside definitions) into
# names; a value other than a name or "*" is an error.
ck_globals(r): list names [
    set(r): 0
    len(ck_gln): list
    set(ck_gli): 0
    while(_): {r = 0 && ck_gli < ck_gln} [
        at(ck_glc): list ck_gli
        ck_is_def(ck_gld): ck_glc
        getf(ck_glnm): ck_glc "name"
        if(_): {ck_gld = 0 && ck_glnm = "global"} [
            ck_argc(ck_glac): ck_glc
            set(ck_glj): 0
            while(_): {r = 0 && ck_glj < ck_glac} [
                ck_arg(ck_gla): ck_glc ck_glj
                getf(ck_glak): ck_gla "kind"
                getf(ck_glas): ck_gla "s"
                getf(ck_glvt): ck_gla "vt"
                if(_): {ck_glak = "var"} [ push(_): names ck_glas ]
                elif(_): {ck_glak = "value" && ck_glvt = "string" && ck_glas = "*"} [ set(ck_glall): 1 ]
                else(_): [
                    ck_err(r): ck_glc "global expects variable names (or \"*\")"
                ]
                add(ck_glj): ck_glj 1
            ]
        ]
        if(_): {ck_gld = 0 && ck_glnm != "global"} [
            ck_argc(ck_glac2): ck_glc
            set(ck_glk): 0
            while(_): {r = 0 && ck_glk < ck_glac2} [
                ck_arg(ck_gla2): ck_glc ck_glk
                getf(ck_glak2): ck_gla2 "kind"
