        ]
        if(_): {bad = 1} [ ck_err(r): c "do expects a value and a [ ] body" ]
        if(_): {r = 0} [
            len(ln): list
            set(lbad): 1
            if(_): {i + 1 < ln} [
                at(lc): list {i + 1}
                getf(lnm): lc "name"
                ck_argc(lac): lc
                if(_): {lnm = "loop" && lac = 1} [ set(lbad): 0 ]
            ]
            if(_): {lbad = 1} [ ck_err(r): c "do must be followed by loop(_): condition" ]
        ]
        if(_): {r = 0} [
            ck_arg(b1): c 1
            getf(l1): b1 "blk"
