            ck_err(r): c m
        ]
        if(_): {r = 0} [ ck_cmd_arg(r): c 0 0 ]
        if(_): {r = 0} [ ck_cmd_arg(r): c 1 1 ]
    ]
    if(_): {done = 0 && nm = "concat"} [
        set(done): 1
        if(_): {n < 2 || n >= 31} [
            ck_got(m): "concat expects 2 to 30 values, got " n ""
