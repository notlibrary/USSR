# comparisons do not chain: at most one per operand pair
ck_cmp(r): [
    ck_shift(r):
    if(_): {ck_failed = 0} [
        ck_k(ck_cpk):
        if(_): {ck_cpk = ">" || ck_cpk = "<" || ck_cpk = ">=" || ck_cpk = "<=" || ck_cpk = "=" || ck_cpk = "!="} [
            ck_adv(_):
            ck_shift(ck_cpr):
            ck_ex_new(r): "bin" r ck_cpr
