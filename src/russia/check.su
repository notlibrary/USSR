        set(bad): 0
        if(_): {n < 2 || n - 1 > 255} [ set(bad): 1 ]
        if(_): {bad = 0} [
            ck_is_string_value(sv): c 0
            if(_): {sv = 0} [ set(bad): 1 ]
        ]
        if(_): {bad = 1} [ ck_err(r): c "template expects a format string and 1 to 255 values" ]
        set(ai): 1
