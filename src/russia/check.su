        set(bad): 1
        if(_): {n = 2} [
            ck_argkind(k1): c 1
            if(_): {k1 = "block"} [ set(bad): 0 ]
        ]
        if(_): {bad = 1} [ ck_err(r): c "while expects a condition and a [ ] body" ]
        if(_): {r = 0} [ ck_cmd_arg(r): c 0 0 ]
        if(_): {r = 0} [
            ck_arg(b1): c 1
            getf(l1): b1 "blk"
            ck_list(r): l1 1 cur
