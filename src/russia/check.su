        if(_): {r = 0} [ ck_cmd_arg(r): c 0 1 ]
    ]
    if(_): {done = 0 && nm = "get"} [
        set(done): 1
        set(bad): 1
        if(_): {n = 1} [
            ck_argkind(k0): c 0
            if(_): {k0 = "var"} [ set(bad): 0 ]
        ]
        if(_): {bad = 1} [
            set(m): "get expects a destination (or an index and a destination for a vector)"
