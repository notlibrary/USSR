# Compile-time diagnostics in USSR: the errors ussr reports before it runs
# a program, with its messages and locations ("file:line: reason").
#
#     ck_run(failed): text name mapf mapl
#
# text is preprocessed source; mapf/mapl map its lines back to files and
# lines (pp_mapf/pp_mapl; empty vectors mean name and the raw line, as for
# eval text). On failure ck_msg holds the one line ussr prints on stderr
# and ck_stage says where it failed: 1 lexing/parsing, 2 compiling.
#
# Three stages, each ported from ussr:
#   ck_lex      src/lexer.l    tokens with their lines; a bad character or
#                              an out-of-range integer stops the scan
#   ck_parse    src/parser.y   the grammar, failing at the first token that
#                              cannot continue it ("syntax error"), plus the
#                              checks its command rule makes
#   ck_compile  src/ussr_bytecode.c   the compiler's checks, in its order:
#                              globals, function table, function bodies,
#                              then the top level
# This module only reports; russia.su's own parser builds what it runs.

global(_): ck_toks ck_ti ck_failed ck_msg ck_name ck_mapf ck_mapl ck_sdef ck_cls
global(_): ck_fns ck_ecmd ck_ccont ck_lasttl ck_stage

# ---------- reporting ----------
# "file:line: " for a line of the checked text (ussr_parse_locate).
ck_loc(r): tl [
    set(ck_lf): ck_name
    set(ck_ll): tl
    len(ck_lc): ck_mapl
    set(ck_lidx): {tl - 1}
    if(_): {ck_lc > 0 && ck_lidx >= 0 && ck_lidx <= ck_lc} [
        if(_): {ck_lidx = ck_lc} [ set(ck_lidx): {ck_lc - 1} ]
        at(ck_lf): ck_mapf ck_lidx
        at(ck_ll): ck_mapl ck_lidx
    ]
    encode(ck_lls): ck_ll
    concat(r): ck_lf ":"
    concat(r): r ck_lls
    concat(r): r ": "
]
# Report msg at text line tl, unless an error is already reported.
ck_at(r): tl msg [
    set(r): 1
    if(_): {ck_failed = 0} [
        ck_loc(ck_atl): tl
        concat(ck_msg): ck_atl msg
        concat(ck_msg): ck_msg "\n"
        set(ck_failed): 1
    ]
]
# Report msg at command cmd (null: the command being compiled; none: the
# compiler's own prefix), as bc_error does.
ck_err(r): cmd msg [
    set(r): 1
    set(ck_ec): cmd
    if(_): {ck_ec = null} [ set(ck_ec): ck_ecmd ]
    if(_): {ck_ec = null && ck_failed = 0} [
        concat(ck_msg): "USSR compiler: " msg
        concat(ck_msg): ck_msg "\n"
        set(ck_failed): 1
    ]
    if(_): {ck_ec != null} [
        getf(ck_ecl): ck_ec "line"
        ck_at(_): ck_ecl msg
    ]
]
ck_num(r): n [
    encode(r): n
]

# ---------- lexer ----------
ck_digit_p(r): b [
    set(r): 0
    if(_): {b > 47 && b < 58} [ set(r): 1 ]
]
ck_idstart_p(r): b [
    set(r): 0
    if(_): {(b > 64 && b < 91) || (b > 96 && b < 123) || b = 95} [ set(r): 1 ]
]
ck_idchar_p(r): b [
    ck_idstart_p(r): b
    if(_): {r = 0} [ ck_digit_p(r): b ]
]
# A byte of a command head: [A-Za-z0-9_./\:-]
ck_headchar_p(r): b [
    ck_idchar_p(r): b
    if(_): {b = 46 || b = 47 || b = 92 || b = 58 || b = 45} [ set(r): 1 ]
]
ck_tok(r): k s line [
    new(ck_tk): "ck_Tok" k s line
    push(_): ck_toks ck_tk
    set(ck_lasttl): line
    set(r): 0
]
# The decimal digits s as a 64-bit integer literal: 1 when out of range.
ck_too_big(r): s [
    set(r): 0
    len(ck_tbn): s
    set(ck_tbi): 0
    set(ck_tbgo): 1
    while(_): {ck_tbgo = 1 && ck_tbi < ck_tbn - 1} [
        byte(ck_tbb): s ck_tbi
        if(_): {ck_tbb = 48} [ add(ck_tbi): ck_tbi 1 ]
        else(_): [ set(ck_tbgo): 0 ]
    ]
    slice(ck_tbd): s ck_tbi {ck_tbn - ck_tbi}
    len(ck_tbl): ck_tbd
    if(_): {ck_tbl > 19} [ set(r): 1 ]
    if(_): {ck_tbl = 19} [
        set(ck_tbmax): "9223372036854775807"
        set(ck_tbj): 0
        set(ck_tbgo2): 1
        while(_): {ck_tbgo2 = 1 && ck_tbj < 19} [
            byte(ck_tbx): ck_tbd ck_tbj
            byte(ck_tby): ck_tbmax ck_tbj
            if(_): {ck_tbx > ck_tby} [
                set(r): 1
                set(ck_tbgo2): 0
            ]
            if(_): {ck_tbx < ck_tby} [ set(ck_tbgo2): 0 ]
            add(ck_tbj): ck_tbj 1
        ]
    ]
]
# A two-byte operator at p, or "".
ck_op2(r): s p n [
    set(r): ""
    if(_): {p + 1 < n} [
        slice(ck_o2): s p 2
        if(_): {ck_o2 = ">=" || ck_o2 = "<=" || ck_o2 = "!=" || ck_o2 = "&&"} [ set(r): ck_o2 ]
        if(_): {ck_o2 = "||" || ck_o2 = "<<" || ck_o2 = ">>"} [ set(r): ck_o2 ]
    ]
]
ck_op1_p(r): b [
    set(r): 0
    if(_): {b = 61 || b = 62 || b = 60 || b = 94 || b = 38 || b = 124} [ set(r): 1 ]
    if(_): {b = 43 || b = 45 || b = 42 || b = 47 || b = 37 || b = 63} [ set(r): 1 ]
    if(_): {b = 33 || b = 91 || b = 64 || b = 93 || b = 123 || b = 125} [ set(r): 1 ]
    if(_): {b = 40 || b = 41 || b = 58} [ set(r): 1 ]
]
# Tokens of text into ck_toks, ending with EOF, or with ERR (its message
# in s) at the first character the lexer rejects.
ck_lex(r): text [
    set(r): 0
    vec(ck_toks): "ck_Tok"
    set(ck_lasttl): 1
    len(ck_xn): text
    set(ck_xp): 0
    set(ck_xl): 1
    set(ck_xerr): 0
    while(_): {ck_xerr = 0 && ck_xp < ck_xn} [
        byte(ck_xb): text ck_xp
        set(ck_xdone): 0
        if(_): {ck_xb = 32 || ck_xb = 9 || ck_xb = 13} [
            # the whole run of blanks at once
            add(ck_xp): ck_xp 1
            set(ck_xws): 1
            while(_): {ck_xws = 1 && ck_xp < ck_xn} [
                byte(ck_xwb): text ck_xp
                if(_): {ck_xwb = 32 || ck_xwb = 9 || ck_xwb = 13} [ add(ck_xp): ck_xp 1 ]
                else(_): [ set(ck_xws): 0 ]
            ]
            set(ck_xdone): 1
        ]
        if(_): {ck_xdone = 0 && ck_xb = 35} [
            set(ck_xgo): 1
            while(_): {ck_xgo = 1 && ck_xp < ck_xn} [
                byte(ck_xcb): text ck_xp
                if(_): {ck_xcb = 10 || ck_xcb = 13} [ set(ck_xgo): 0 ]
                else(_): [ add(ck_xp): ck_xp 1 ]
            ]
            set(ck_xdone): 1
        ]
        if(_): {ck_xdone = 0 && ck_xb = 10} [
            ck_tok(_): "NL" "" ck_xl
            add(ck_xl): ck_xl 1
            add(ck_xp): ck_xp 1
            set(ck_xdone): 1
        ]
        # a command head: the longest [A-Za-z0-9_./\:-]+ directly before '('
        if(_): {ck_xdone = 0} [
            set(ck_xq): ck_xp
            set(ck_xgo2): 1
            while(_): {ck_xgo2 = 1 && ck_xq < ck_xn} [
                byte(ck_xhb): text ck_xq
                at(ck_xcl): ck_cls ck_xhb
                set(ck_xgo2): 0
                if(_): {(ck_xcl & 7) > 0} [ set(ck_xgo2): 1 ]
                if(_): {ck_xgo2 = 1} [ add(ck_xq): ck_xq 1 ]
            ]
            if(_): {ck_xq > ck_xp && ck_xq < ck_xn} [
                byte(ck_xhp): text ck_xq
                if(_): {ck_xhp = 40} [
                    slice(ck_xhead): text ck_xp {ck_xq - ck_xp}
                    ck_tok(_): "HEAD" ck_xhead ck_xl
                    set(ck_xp): ck_xq
                    set(ck_xdone): 1
                ]
            ]
        ]
        # "string" or 'uno' (closed on the same line)
        if(_): {ck_xdone = 0 && (ck_xb = 34 || ck_xb = 39)} [
            add(ck_xq2): ck_xp 1
            set(ck_xend): {0 - 1}
            set(ck_xgo3): 1
            while(_): {ck_xgo3 = 1 && ck_xq2 < ck_xn} [
                byte(ck_xsb): text ck_xq2
                if(_): {ck_xsb = 10} [ set(ck_xgo3): 0 ]
                elif(_): {ck_xsb = 92} [
                    set(ck_xsb2): 10
                    if(_): {ck_xq2 + 1 < ck_xn} [ byte(ck_xsb2): text {ck_xq2 + 1} ]
                    if(_): {ck_xsb2 = 10} [ set(ck_xgo3): 0 ]
                    else(_): [ add(ck_xq2): ck_xq2 2 ]
                ]
                elif(_): {ck_xsb = ck_xb} [
                    set(ck_xend): {ck_xq2 + 1}
                    set(ck_xgo3): 0
                ]
                else(_): [ add(ck_xq2): ck_xq2 1 ]
            ]
            if(_): {ck_xend > 0} [
                slice(ck_xstr): text {ck_xp + 1} {ck_xend - ck_xp - 2}
                set(ck_xsk): "STR"
                if(_): {ck_xb = 39} [ set(ck_xsk): "UNO" ]
                ck_tok(_): ck_xsk ck_xstr ck_xl
                set(ck_xp): ck_xend
                set(ck_xdone): 1
            ]
        ]
        # numbers: REAL is digits.digits, else INTEGER
        if(_): {ck_xdone = 0} [
            at(ck_xcl): ck_cls ck_xb
            set(ck_xdg): 0
            if(_): {(ck_xcl & 1) > 0} [ set(ck_xdg): 1 ]
            if(_): {ck_xdg = 1} [
                set(ck_xq3): ck_xp
                set(ck_xgo4): 1
                while(_): {ck_xgo4 = 1 && ck_xq3 < ck_xn} [
                    byte(ck_xdb): text ck_xq3
                    at(ck_xcl): ck_cls ck_xdb
                    set(ck_xgo4): 0
                    if(_): {(ck_xcl & 1) > 0} [ set(ck_xgo4): 1 ]
                    if(_): {ck_xgo4 = 1} [ add(ck_xq3): ck_xq3 1 ]
                ]
                set(ck_xreal): 0
                if(_): {ck_xq3 + 1 < ck_xn} [
                    byte(ck_xdot): text ck_xq3
                    byte(ck_xd2): text {ck_xq3 + 1}
                    at(ck_xcl): ck_cls ck_xd2
                    set(ck_xd2d): 0
                    if(_): {(ck_xcl & 1) > 0} [ set(ck_xd2d): 1 ]
                    if(_): {ck_xdot = 46 && ck_xd2d = 1} [ set(ck_xreal): 1 ]
                ]
                if(_): {ck_xreal = 1} [
                    add(ck_xq3): ck_xq3 1
                    set(ck_xgo5): 1
                    while(_): {ck_xgo5 = 1 && ck_xq3 < ck_xn} [
                        byte(ck_xdb2): text ck_xq3
                        at(ck_xcl): ck_cls ck_xdb2
                        set(ck_xgo5): 0
                        if(_): {(ck_xcl & 1) > 0} [ set(ck_xgo5): 1 ]
                        if(_): {ck_xgo5 = 1} [ add(ck_xq3): ck_xq3 1 ]
                    ]
                    slice(ck_xnum): text ck_xp {ck_xq3 - ck_xp}
                    ck_tok(_): "REAL" ck_xnum ck_xl
                ]
                if(_): {ck_xreal = 0} [
                    slice(ck_xnum2): text ck_xp {ck_xq3 - ck_xp}
                    ck_too_big(ck_xbig): ck_xnum2
                    if(_): {ck_xbig = 1} [
                        concat(ck_xm): "integer " ck_xnum2
                        concat(ck_xm): ck_xm " is outside -9223372036854775808..9223372036854775807 (write it as a real, e.g. "
                        concat(ck_xm): ck_xm ck_xnum2
                        concat(ck_xm): ck_xm ".0)"
                        ck_tok(_): "ERR" ck_xm ck_xl
                        set(ck_xerr): 1
                    ]
                    if(_): {ck_xbig = 0} [ ck_tok(_): "INT" ck_xnum2 ck_xl ]
                ]
                set(ck_xp): ck_xq3
                set(ck_xdone): 1
            ]
        ]
        # identifiers and the true/false/null keywords
        if(_): {ck_xdone = 0} [
            at(ck_xcl): ck_cls ck_xb
            set(ck_xid): 0
            if(_): {(ck_xcl & 2) > 0} [ set(ck_xid): 1 ]
            if(_): {ck_xid = 1} [
                set(ck_xq4): ck_xp
                set(ck_xgo6): 1
                while(_): {ck_xgo6 = 1 && ck_xq4 < ck_xn} [
                    byte(ck_xib): text ck_xq4
                    at(ck_xcl): ck_cls ck_xib
                    set(ck_xgo6): 0
                    if(_): {(ck_xcl & 3) > 0} [ set(ck_xgo6): 1 ]
                    if(_): {ck_xgo6 = 1} [ add(ck_xq4): ck_xq4 1 ]
                ]
                slice(ck_xword): text ck_xp {ck_xq4 - ck_xp}
                set(ck_xwk): "IDENT"
                if(_): {ck_xword = "true" || ck_xword = "false"} [ set(ck_xwk): "BOOL" ]
                if(_): {ck_xword = "null"} [ set(ck_xwk): "NULL" ]
                ck_tok(_): ck_xwk ck_xword ck_xl
                set(ck_xp): ck_xq4
                set(ck_xdone): 1
            ]
        ]
        if(_): {ck_xdone = 0} [
            ck_op2(ck_xo2): text ck_xp ck_xn
            if(_): {ck_xo2 != ""} [
                ck_tok(_): ck_xo2 ck_xo2 ck_xl
                add(ck_xp): ck_xp 2
                set(ck_xdone): 1
            ]
        ]
        if(_): {ck_xdone = 0} [
            ck_op1_p(ck_xo1): ck_xb
            slice(ck_xch): text ck_xp 1
            if(_): {ck_xo1 = 1} [
                ck_tok(_): ck_xch ck_xch ck_xl
            ]
            if(_): {ck_xo1 = 0} [
                concat(ck_xm2): "unexpected character '" ck_xch
                concat(ck_xm2): ck_xm2 "'"
                ck_tok(_): "ERR" ck_xm2 ck_xl
                set(ck_xerr): 1
            ]
            add(ck_xp): ck_xp 1
        ]
    ]
    if(_): {ck_xerr = 0} [
        ck_tok(_): "EOF" "" ck_lasttl
    ]
]

# ---------- parser ----------
ck_cur(r): [
    at(r): ck_toks ck_ti
]
ck_k(r): [
    at(ck_kt): ck_toks ck_ti
    getf(r): ck_kt "k"
]
ck_adv(r): [
    add(ck_ti): ck_ti 1
    set(r): 0
]
# The parse stops at the current token: ussr's lexer message when that is
# the rejected character, else a syntax error there.
ck_syntax(r): [
    set(r): 1
    ck_cur(ck_st):
    getf(ck_stk): ck_st "k"
    getf(ck_stl): ck_st "line"
    set(ck_stm): "syntax error"
    if(_): {ck_stk = "ERR"} [ getf(ck_stm): ck_st "s" ]
    ck_at(_): ck_stl ck_stm
]
ck_expect(r): k [
    set(r): 0
    ck_k(ck_ek):
    if(_): {ck_ek = k} [ ck_adv(_): ]
    else(_): [ ck_syntax(r): ]
]
ck_arg_new(r): kind s vt [
    new(r): "ck_Arg" kind s vt 0 null null
]
ck_ex_new(r): op l rr [
    new(r): "ck_E" op l rr
]
# command_lines: until a token that cannot start a command line.
ck_lines(r): [
    vec(r): "ck_Cmd"
    set(ck_lgo): 1
    while(_): {ck_lgo = 1 && ck_failed = 0} [
        ck_k(ck_lk):
        if(_): {ck_lk = "NL"} [ ck_adv(_): ]
        elif(_): {ck_lk = "HEAD"} [
            ck_command(ck_lc):
            if(_): {ck_failed = 0} [ push(_): r ck_lc ]
        ]
        elif(_): {ck_lk = "@"} [
            ck_advanced(ck_lc2):
            if(_): {ck_failed = 0} [ push(_): r ck_lc2 ]
        ]
        else(_): [ set(ck_lgo): 0 ]
    ]
]
ck_block(r): [
    set(r): null
    ck_adv(_):
    ck_lines(ck_blines):
    if(_): {ck_failed = 0} [ ck_expect(_): "]" ]
    if(_): {ck_failed = 0} [ set(r): ck_blines ]
]
# @[ lines ] (newlines) [ lines ]
ck_advanced(r): [
    ck_cur(ck_avt):
    getf(ck_avl): ck_avt "line"
    set(r): null
    ck_adv(_):
    ck_k(ck_avk):
    if(_): {ck_avk != "["} [ ck_syntax(_): ]
    if(_): {ck_failed = 0} [ ck_block(ck_av1): ]
    if(_): {ck_failed = 0} [
        set(ck_avgo): 1
        while(_): {ck_avgo = 1} [
            ck_k(ck_avk2):
            if(_): {ck_avk2 = "NL"} [ ck_adv(_): ]
            else(_): [ set(ck_avgo): 0 ]
        ]
        ck_k(ck_avk3):
        if(_): {ck_avk3 != "["} [ ck_syntax(_): ]
    ]
    if(_): {ck_failed = 0} [ ck_block(ck_av2): ]
    if(_): {ck_failed = 0} [
        vec(ck_avargs): "ck_Arg"
        ck_arg_new(ck_ava1): "block" "" ""
        setf(_): ck_ava1 "blk" ck_av1
        push(_): ck_avargs ck_ava1
        ck_arg_new(ck_ava2): "block" "" ""
        setf(_): ck_ava2 "blk" ck_av2
        push(_): ck_avargs ck_ava2
        new(r): "ck_Cmd" "@" "_" ck_avl ck_avargs
    ]
]
# Command name after the last / or \ of a head (the rest is its path).
ck_headname(r): head [
    set(r): head
    len(ck_hnn): head
    set(ck_hns): {0 - 1}
    set(ck_hni): 0
    while(_): {ck_hni < ck_hnn} [
        byte(ck_hnb): head ck_hni
        if(_): {ck_hnb = 47 || ck_hnb = 92} [ set(ck_hns): ck_hni ]
        add(ck_hni): ck_hni 1
    ]
    if(_): {ck_hns >= 0} [
        slice(r): head {ck_hns + 1} {ck_hnn - ck_hns - 1}
    ]
]
ck_block_allowed(r): name [
    set(r): 1
    if(_): {name = "break" || name = "continue" || name = "return" || name = "set"} [ set(r): 0 ]
    if(_): {name = "print" || name = "add" || name = "sub" || name = "mul"} [ set(r): 0 ]
    if(_): {name = "div" || name = "mod" || name = "concat" || name = "eval"} [ set(r): 0 ]
    if(_): {name = "get" || name = "random64" || name = "seed_random64" || name = "scan"} [ set(r): 0 ]
    if(_): {name = "time" || name = "cd" || name = "chain" || name = "file"} [ set(r): 0 ]
]
# COMMAND_HEAD ( IDENTIFIER ) : argument*
ck_command(r): [
    set(r): null
    ck_cur(ck_cmt):
    getf(ck_cmhead): ck_cmt "s"
    getf(ck_cmline): ck_cmt "line"
    ck_adv(_):
    ck_expect(_): "("
    set(ck_cmret): ""
    if(_): {ck_failed = 0} [
        ck_cur(ck_cmrt):
        getf(ck_cmret): ck_cmrt "s"
        ck_expect(_): "IDENT"
    ]
    if(_): {ck_failed = 0} [ ck_expect(_): ")" ]
    if(_): {ck_failed = 0} [ ck_expect(_): ":" ]
    vec(ck_cmargs): "ck_Arg"
    set(ck_cmgo): 1
    while(_): {ck_cmgo = 1 && ck_failed = 0} [
        ck_argument(ck_cma):
        if(_): {ck_cma = null} [ set(ck_cmgo): 0 ]
        else(_): [ push(_): ck_cmargs ck_cma ]
    ]
    if(_): {ck_failed = 0} [
        ck_headname(ck_cmname): ck_cmhead
        # the checks of parser.y's command rule, made on its reduction
        len(ck_cmn): ck_cmargs
        set(ck_cmblocks): 0
        set(ck_cmtrail): 1
        set(ck_cmi): 0
        while(_): {ck_cmi < ck_cmn} [
            at(ck_cmx): ck_cmargs ck_cmi
            getf(ck_cmxk): ck_cmx "kind"
            if(_): {ck_cmxk = "block"} [
                add(ck_cmblocks): ck_cmblocks 1
                if(_): {ck_cmi + 1 < ck_cmn} [ set(ck_cmtrail): 0 ]
            ]
            add(ck_cmi): ck_cmi 1
        ]
        if(_): {ck_cmtrail = 0} [
            ck_cur(ck_cmla):
            getf(ck_cmlak): ck_cmla "k"
            if(_): {ck_cmlak = "ERR"} [ ck_syntax(_): ]
            else(_): [
                getf(ck_cmlal): ck_cmla "line"
                ck_at(_): ck_cmlal "[] blocks must be trailing command blocks"
            ]
        ]
        if(_): {ck_failed = 0 && ck_cmblocks > 0} [
            ck_block_allowed(ck_cmok): ck_cmname
            if(_): {ck_cmok = 0} [
                concat(ck_cmm): "command '" ck_cmname
                concat(ck_cmm): ck_cmm "' cannot have a [] block"
                ck_at(_): ck_cmline ck_cmm
            ]
        ]
        if(_): {ck_failed = 0} [
            new(r): "ck_Cmd" ck_cmname ck_cmret ck_cmline ck_cmargs
        ]
    ]
]
# One argument, or null (without consuming) when none starts here.
ck_argument(r): [
    set(r): null
    ck_cur(ck_agt):
    getf(ck_agk): ck_agt "k"
    getf(ck_ags): ck_agt "s"
    if(_): {ck_agk = "STR"} [
        ck_adv(_):
        ck_arg_new(r): "value" ck_ags "string"
    ]
    elif(_): {ck_agk = "INT" || ck_agk = "REAL" || ck_agk = "BOOL" || ck_agk = "NULL"} [
        ck_adv(_):
        ck_arg_new(r): "value" ck_ags ck_agk
    ]
    elif(_): {ck_agk = "-"} [
        ck_adv(_):
        ck_k(ck_agk2):
        if(_): {ck_agk2 = "INT" || ck_agk2 = "REAL"} [
            ck_adv(_):
            ck_arg_new(r): "value" "" ck_agk2
        ]
        else(_): [ ck_syntax(_): ]
    ]
    elif(_): {ck_agk = "IDENT"} [
        ck_adv(_):
        ck_k(ck_agk3):
        if(_): {ck_agk3 = "?"} [
            ck_adv(_):
            ck_arg_new(r): "lookup" ck_ags ""
        ]
        else(_): [
            ck_arg_new(r): "var" ck_ags ""
            ck_ex_new(ck_agvx): "var" null null
            setf(_): r "ex" ck_agvx
        ]
    ]
    elif(_): {ck_agk = "{"} [
        ck_adv(_):
        ck_or(ck_agex):
        if(_): {ck_failed = 0} [ ck_expect(_): "}" ]
        if(_): {ck_failed = 0} [
            ck_arg_new(r): "expr" "" ""
            setf(_): r "ex" ck_agex
        ]
    ]
    elif(_): {ck_agk = "["} [
        ck_block(ck_agb):
        if(_): {ck_failed = 0} [
            ck_arg_new(r): "block" "" ""
            setf(_): r "blk" ck_agb
        ]
    ]
    elif(_): {ck_agk = "UNO"} [
        ck_adv(_):
        ck_arg_new(r): "uno" ck_ags ""
    ]
    # argument_base ! (assignment); a '?' lookup takes none
    if(_): {r != null && ck_failed = 0} [
        getf(ck_agkind): r "kind"
