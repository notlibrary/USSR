            ]
        ]
        if(_): {ck_bcelse = 0} [
            set(ck_bcbad2): 1
            if(_): {ck_bcac = 2} [
                ck_argkind(ck_bck1): ck_bcc 1
                if(_): {ck_bck1 = "block"} [ set(ck_bcbad2): 0 ]
            ]
            if(_): {ck_bcbad2 = 1} [
                concat(ck_bcm): ck_bcnm " expects a condition and a [ ] block"
                ck_err(_): ck_bcc ck_bcm
                set(ck_bcok): 0
            ]
            if(_): {ck_bcok = 1} [
                ck_arg(ck_bca1): ck_bcc 1
                getf(ck_bcbody): ck_bca1 "blk"
                ck_cmd_arg(ck_bcr): ck_bcc 0 0
                if(_): {ck_bcr != 0} [ set(ck_bcok): 0 ]
            ]
        ]
        if(_): {ck_bcok = 1} [
            ck_list(ck_bcr2): ck_bcbody loop cur
            if(_): {ck_bcr2 != 0} [ set(ck_bcok): 0 ]
        ]
        if(_): {ck_bcok = 1} [
            add(ck_bcnx): ck_bcb 1
            set(ck_bcnl): 0
            if(_): {ck_bcnx < ck_bcn} [
                at(ck_bcnc): list ck_bcnx
                ck_label_p(ck_bcnl): ck_bcnc
            ]
            if(_): {ck_bcnl = 0} [
                set(ck_bcb): ck_bcnx
                set(ck_bcgo): 0
            ]
            if(_): {ck_bcnl = 1 && ck_bcelse = 1} [
                getf(ck_bcnn): ck_bcnc "name"
                concat(ck_bcm2): ck_bcnn " after else"
                ck_err(_): ck_bcnc ck_bcm2
                set(ck_bcok): 0
            ]
            if(_): {ck_bcnl = 1 && ck_bcelse = 0} [ set(ck_bcb): ck_bcnx ]
        ]
    ]
    if(_): {ck_bcok = 1} [ set(r): ck_bcb ]
]
# choose(_): v / option(_): x / default(_):  -> index after it, -1 on error.
# loop: 0 none, 1 a loop, 2 a choose (break leaves it; continue belongs
# to the loop around it).
ck_choose(r): list first loop cur [
    set(r): {0 - 1}
    len(ck_chn): list
    at(ck_chf): list first
    ck_cmd_arg(ck_chr): ck_chf 0 0
    set(ck_chok): 1
    if(_): {ck_chr != 0} [ set(ck_chok): 0 ]
    vec(ck_chlab): ""
    vec(ck_chstop): ""
    set(ck_chdef): 0
    set(ck_chl): {first + 1}
    set(ck_chgo): 1
    while(_): {ck_chok = 1 && ck_chgo = 1} [
        set(ck_chgo): 0
        if(_): {ck_chl < ck_chn} [
            at(ck_chlc): list ck_chl
            ck_choose_label_p(ck_chgo): ck_chlc
        ]
        if(_): {ck_chgo = 1} [
            add(ck_chcur): ck_chl 1
            set(ck_chsgo): 1
            while(_): {ck_chsgo = 1 && ck_chcur < ck_chn} [
                at(ck_chcc): list ck_chcur
                ck_choose_label_p(ck_chsl): ck_chcc
                if(_): {ck_chsl = 1} [ set(ck_chsgo): 0 ]
                else(_): [ add(ck_chcur): ck_chcur 1 ]
            ]
            push(_): ck_chlab ck_chl
            push(_): ck_chstop ck_chcur
            getf(ck_chlnm): ck_chlc "name"
            ck_argc(ck_chlac): ck_chlc
            if(_): {ck_chlnm = "default"} [
                if(_): {ck_chlac != 0 || ck_chdef = 1} [
                    set(ck_chm): "default takes no parameters"
                    if(_): {ck_chdef = 1} [ set(ck_chm): "choose has a second default" ]
                    ck_err(_): ck_chlc ck_chm
                    set(ck_chok): 0
                ]
                set(ck_chdef): 1
            ]
            elif(_): {ck_chlac != 1} [
                ck_err(_): ck_chlc "option expects one value"
                set(ck_chok): 0
            ]
            set(ck_chl): ck_chcur
        ]
    ]
    len(ck_chcount): ck_chlab
    if(_): {ck_chok = 1 && ck_chcount = 0} [
        ck_err(_): ck_chf "choose must be followed by option or default"
        set(ck_chok): 0
    ]
    set(ck_chi): 0
    while(_): {ck_chok = 1 && ck_chi < ck_chcount} [
        at(ck_chli): ck_chlab ck_chi
        at(ck_chlx): list ck_chli
        getf(ck_chlxn): ck_chlx "name"
        if(_): {ck_chlxn = "option"} [
            ck_cmd_arg(ck_chr2): ck_chlx 0 1
            if(_): {ck_chr2 != 0} [ set(ck_chok): 0 ]
        ]
        add(ck_chi): ck_chi 1
    ]
    set(ck_chsaved): ck_ccont
    set(ck_ccont): 0
    set(ck_chj): 0
    while(_): {ck_chok = 1 && ck_chj < ck_chcount} [
        at(ck_chlj): ck_chlab ck_chj
        at(ck_chsj): ck_chstop ck_chj
        ck_until(ck_chr3): list {ck_chlj + 1} ck_chsj 2 cur
        if(_): {ck_chr3 != 0} [ set(ck_chok): 0 ]
        add(ck_chj): ck_chj 1
    ]
    if(_): {ck_chok = 1 && ck_ccont > 0} [
        if(_): {loop = 0} [
            ck_err(_): ck_chf "continue inside choose but outside a loop"
            set(ck_chok): 0
        ]
    ]
    # continues the enclosing choose must account for in turn
    if(_): {loop = 2} [ add(ck_ccont): ck_chsaved ck_ccont ]
    else(_): [ set(ck_ccont): ck_chsaved ]
    if(_): {ck_chok = 1} [ set(r): ck_chl ]
]
# bc_compile_command: a failure without its own message is reported as
# "cannot compile 'name'".
ck_command_c(r): list i loop cur [
    at(ck_ccmd): list i
    set(ck_ccouter): ck_ecmd
    set(ck_ecmd): ck_ccmd
    ck_body(r): list i loop cur
    if(_): {r != 0} [
        getf(ck_ccnm2): ck_ccmd "name"
        concat(ck_ccm3): "cannot compile '" ck_ccnm2
        concat(ck_ccm3): ck_ccm3 "'"
        ck_err(_): ck_ccmd ck_ccm3
    ]
    set(ck_ecmd): ck_ccouter
]
# "<name> expects ..., got N"-style message helper
ck_got(r): head n tail [
    ck_num(ck_gtn): n
    concat(r): head ck_gtn
    concat(r): r tail
]
ck_is_string_value(r): cmd i [
    ck_arg(ck_isa): cmd i
    getf(ck_isk): ck_isa "kind"
    getf(ck_isv): ck_isa "vt"
    set(r): 0
    if(_): {ck_isk = "value" && ck_isv = "string"} [ set(r): 1 ]
]
# bc_compile_command_body, in its order of cases
ck_body(r): list i loop cur [
    set(r): 0
    at(c): list i
    getf(nm): c "name"
    ck_argc(n): c
    ck_is_def(isdef): c
    set(done): isdef
    if(_): {done = 0 && nm = "global"} [ set(done): 1 ]
    if(_): {done = 0 && nm = "if"} [
        set(done): 1
        set(bad): 0
        if(_): {n < 2 || n > 3} [ set(bad): 1 ]
        if(_): {bad = 0} [
            ck_argkind(k1): c 1
            if(_): {k1 != "block"} [ set(bad): 1 ]
            if(_): {n = 3} [
                ck_argkind(k2): c 2
                if(_): {k2 != "block"} [ set(bad): 1 ]
            ]
        ]
        if(_): {bad = 1} [
            ck_err(r): c "if expects a condition and a [ ] block (optionally followed by an else block)"
        ]
        if(_): {r = 0} [ ck_cmd_arg(r): c 0 0 ]
        if(_): {r = 0} [
            ck_arg(b1): c 1
            getf(l1): b1 "blk"
            ck_list(r): l1 loop cur
