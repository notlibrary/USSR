# Shared Russia and Rush console input, history, and prompts.

# One line without its line ending; sets rp_eof at end of input.
repl_rd(r): [
    global(_): rp_tty
    if(_): {rp_tty = 1} [ repl_rd_tty(r): ]
    else(_): [ repl_rd_pipe(r): ]
]

# A line typed at a terminal, read in raw mode and echoed here, so that a
# key bound with keybind fires when pressed: its bytes (a control key or a
# whole escape sequence) go to keybind_match, and a bound line replaces
# what was typed, as ussr's line editor does. Backspace removes a whole
# UTF-8 character, Ctrl-C drops the line, Ctrl-D or Ctrl-Z on an empty
# line ends input.
repl_rd_tty(r): [
    global(_): rp_eof rp_hist
    set(r): ""
    set(rrt_n): 0
    set(rrt_need): 0
    set(rrt_pend): ""
    chr(rrt_bs): 8
    chr(rrt_esc): 27
    # history position: len(rp_hist) is the line being typed, kept in
    # rrt_live while Up shows older entries
    len(rrt_hi): rp_hist
    set(rrt_live): ""
    concat(rrt_up): rrt_esc "[A"
    concat(rrt_up2): rrt_esc "OA"
    concat(rrt_dn): rrt_esc "[B"
    concat(rrt_dn2): rrt_esc "OB"
    terminal_raw(_):
    set(rrt_go): 1
    while(_): {rrt_go = 1} [
        terminal_getch(rrt_c):
        set(rrt_key): ""
        if(_): {rrt_c < 0} [
            set(rrt_go): 0
            len(rrt_l): r
            if(_): {rrt_l = 0} [ set(rp_eof): 1 ]
        ]
        elif(_): {rrt_c = 13 || rrt_c = 10} [ set(rrt_go): 0 ]
        elif(_): {rrt_c = 127 || rrt_c = 8} [
            if(_): {rrt_n > 0} [
                repl_rubout(r): r
                sub(rrt_n): rrt_n 1
                concat(rrt_er): rrt_bs " " rrt_bs
                template(_): "STR" rrt_er
            ]
        ]
        elif(_): {rrt_c = 27} [ repl_esc(rrt_key): ]
        elif(_): {rrt_c > 0 && rrt_c < 32 && rrt_c != 9} [ chr(rrt_key): rrt_c ]
        elif(_): {rrt_c > 0} [
            chr(rrt_ch): rrt_c
            if(_): {rrt_c >= 128 && rrt_c < 192} [
                if(_): {rrt_need > 0} [
                    concat(rrt_pend): rrt_pend rrt_ch
                    sub(rrt_need): rrt_need 1
                    if(_): {rrt_need = 0} [
                        concat(r): r rrt_pend
                        template(_): "STR" rrt_pend
                        add(rrt_n): rrt_n 1
                    ]
                ]
            ]
            elif(_): {rrt_c >= 192} [
                set(rrt_pend): rrt_ch
                set(rrt_need): 1
                if(_): {rrt_c >= 224} [ set(rrt_need): 2 ]
                if(_): {rrt_c >= 240} [ set(rrt_need): 3 ]
            ]
            else(_): [
                concat(r): r rrt_ch
                template(_): "STR" rrt_ch
                add(rrt_n): rrt_n 1
            ]
        ]
        len(rrt_kl): rrt_key
        if(_): {rrt_kl > 0} [
            keybind_match(rrt_bound): rrt_key
            typeof(rrt_bt): rrt_bound
            if(_): {rrt_bt = "string"} [
                set(rrt_er): ""
                set(rrt_i): 0
                while(_): {rrt_i < rrt_n} [
                    concat(rrt_er): rrt_er rrt_bs
                    add(rrt_i): rrt_i 1
                ]
                set(r): rrt_bound
                concat(rrt_er): rrt_er rrt_esc "[K" r
                template(_): "STR" rrt_er
                set(rrt_go): 0
            ]
            elif(_): {rrt_c = 3} [
                set(r): ""
                set(rrt_go): 0
            ]
            elif(_): {rrt_key = rrt_up || rrt_key = rrt_up2} [
                len(rrt_hn): rp_hist
                if(_): {rrt_hi > 0} [
                    if(_): {rrt_hi = rrt_hn} [ set(rrt_live): r ]
                    sub(rrt_hi): rrt_hi 1
                    at(rrt_shown): rp_hist rrt_hi
                    repl_replace(r): rrt_n rrt_shown
                    repl_nchars(rrt_n): r
                    set(rrt_need): 0
                ]
            ]
            elif(_): {rrt_key = rrt_dn || rrt_key = rrt_dn2} [
                len(rrt_hn): rp_hist
                if(_): {rrt_hi < rrt_hn} [
                    add(rrt_hi): rrt_hi 1
                    set(rrt_shown): rrt_live
                    if(_): {rrt_hi < rrt_hn} [ at(rrt_shown): rp_hist rrt_hi ]
                    repl_replace(r): rrt_n rrt_shown
                    repl_nchars(rrt_n): r
                    set(rrt_need): 0
                ]
            ]
            elif(_): {rrt_c = 4 || rrt_c = 26} [
                len(rrt_l): r
                if(_): {rrt_l = 0} [
                    set(rp_eof): 1
                    set(rrt_go): 0
                ]
            ]
        ]
    ]
    terminal_sane(_):
    print(_): ""
]

# Replace the n characters typed on this line with text on the screen;
# returns text.
repl_replace(r): n text [
    chr(rrp_bs): 8
    chr(rrp_esc): 27
    set(rrp_er): ""
    set(rrp_i): 0
    while(_): {rrp_i < n} [
        concat(rrp_er): rrp_er rrp_bs
        add(rrp_i): rrp_i 1
    ]
    concat(rrp_er): rrp_er rrp_esc "[K" text
    template(_): "STR" rrp_er
    set(r): text
]

# How many UTF-8 characters s holds.
repl_nchars(r): s [
    len(rnc_l): s
    set(r): 0
    set(rnc_i): 0
    while(_): {rnc_i < rnc_l} [
        byte(rnc_b): s rnc_i
        if(_): {rnc_b < 128 || rnc_b >= 192} [ add(r): r 1 ]
        add(rnc_i): rnc_i 1
    ]
]

# The history file, as ussr keeps it (src/history.c): USSR_HISTFILE, else
# .ussr_history in the home folder (HOME, else USERPROFILE); set but empty
# keeps none. USSR_HISTSIZE entries (default 1000) are loaded and kept.
# One entry per line, oldest first; only a REPL on a terminal uses it.
repl_hist_load(r): [
    global(_): rp_hist rp_hpath
    set(r): 0
    vec(rp_hist): ""
    set(rp_hpath): ""
    set(rhl_size): 1000
    getenv(rhl_sz): "USSR_HISTSIZE"
    typeof(rhl_szt): rhl_sz
    if(_): {rhl_szt = "string"} [
        repl_digits(rhl_ok): rhl_sz
        if(_): {rhl_ok = 1} [ decode(rhl_size): rhl_sz ]
    ]
    getenv(rhl_f): "USSR_HISTFILE"
    typeof(rhl_ft): rhl_f
    if(_): {rhl_ft = "string"} [ set(rp_hpath): rhl_f ]
    else(_): [
        getenv(rhl_home): "HOME"
        typeof(rhl_ht): rhl_home
        if(_): {rhl_ht != "string"} [ set(rhl_home): "" ]
        if(_): {rhl_home = ""} [
            getenv(rhl_home): "USERPROFILE"
            typeof(rhl_ht): rhl_home
            if(_): {rhl_ht != "string"} [ set(rhl_home): "" ]
        ]
        len(rhl_hl): rhl_home
        if(_): {rhl_hl > 0} [
            sub(rhl_last): rhl_hl 1
            byte(rhl_lb): rhl_home rhl_last
            set(rhl_sep): "/"
            if(_): {rhl_lb = 47 || rhl_lb = 92} [ set(rhl_sep): "" ]
            concat(rp_hpath): rhl_home rhl_sep ".ussr_history"
        ]
    ]
    if(_): {rhl_size = 0} [ set(rp_hpath): "" ]
    file_exists(rhl_e): rp_hpath
    if(_): {rp_hpath != "" && rhl_e = true} [
        readfile(rhl_t): rp_hpath
        vec(rhl_all): ""
        len(rhl_n): rhl_t
        set(rhl_i): 0
        set(rhl_s): 0
        while(_): {rhl_i <= rhl_n} [
            set(rhl_b): 10
            if(_): {rhl_i < rhl_n} [ byte(rhl_b): rhl_t rhl_i ]
            if(_): {rhl_b = 10} [
                sub(rhl_k): rhl_i rhl_s
                if(_): {rhl_k > 0} [
                    sub(rhl_lst): rhl_i 1
                    byte(rhl_cr): rhl_t rhl_lst
                    if(_): {rhl_cr = 13} [ sub(rhl_k): rhl_k 1 ]
                ]
                if(_): {rhl_k > 0} [
                    slice(rhl_line): rhl_t rhl_s rhl_k
                    push(_): rhl_all rhl_line
                ]
                add(rhl_s): rhl_i 1
            ]
            add(rhl_i): rhl_i 1
        ]
        len(rhl_c): rhl_all
        set(rhl_first): 0
        if(_): {rhl_c > rhl_size} [ sub(rhl_first): rhl_c rhl_size ]
        set(rhl_j): rhl_first
        set(rhl_kept): ""
        chr(rhl_nl): 10
        while(_): {rhl_j < rhl_c} [
            at(rhl_line): rhl_all rhl_j
            push(_): rp_hist rhl_line
            concat(rhl_kept): rhl_kept rhl_line rhl_nl
            add(rhl_j): rhl_j 1
        ]
        if(_): {rhl_first > 0} [ writefile(_): rp_hpath rhl_kept ]
    ]
]

# 1 when s is a non-empty run of decimal digits.
repl_digits(r): s [
    len(rdg_n): s
    set(r): 0
    if(_): {rdg_n > 0 && rdg_n < 8} [ set(r): 1 ]
    set(rdg_i): 0
    while(_): {rdg_i < rdg_n} [
        byte(rdg_b): s rdg_i
        if(_): {rdg_b < 48 || rdg_b > 57} [ set(r): 0 ]
        add(rdg_i): rdg_i 1
    ]
]

# Record a typed line: in memory for Up/Down, and appended to the file.
# A repeat of the previous entry is skipped, as ussr skips it.
repl_hist_add(r): line [
    global(_): rp_hist rp_hpath
    set(r): 0
    len(rha_n): rp_hist
    set(rha_dup): 0
    if(_): {rha_n > 0} [
        sub(rha_l): rha_n 1
        at(rha_prev): rp_hist rha_l
        if(_): {rha_prev = line} [ set(rha_dup): 1 ]
    ]
    if(_): {rha_dup = 0} [
        push(_): rp_hist line
        if(_): {rp_hpath != ""} [
            open_file(rha_h): rp_hpath "a"
            if(_): {rha_h >= 0} [
                chr(rha_nl): 10
                concat(rha_out): line rha_nl
                write_file(_): rha_h rha_out
                close_file(_): rha_h
            ]
        ]
    ]
]

# s without its last UTF-8 character.
repl_rubout(r): s [
    len(rru_i): s
    set(rru_go): 1
    while(_): {rru_go = 1 && rru_i > 0} [
        sub(rru_i): rru_i 1
        byte(rru_b): s rru_i
        if(_): {rru_b < 128 || rru_b >= 192} [ set(rru_go): 0 ]
    ]
    slice(r): s 0 rru_i
]

# The rest of an escape sequence whose ESC was just read, ESC included:
# ESC x (Alt+x), ESC [ ... final (CSI, also ESC [ [ A Linux console F-keys),
# ESC O [digits] x (SS3), each possibly after a second ESC (Alt).
repl_esc(r): [
    chr(r): 27
    terminal_getch(re_c):
    if(_): {re_c = 27} [
        concat(r): r r
        terminal_getch(re_c):
    ]
    if(_): {re_c > 0} [
        chr(re_ch): re_c
        concat(r): r re_ch
        if(_): {re_c = 91} [
            set(re_go): 1
            set(re_k): 0
            while(_): {re_go = 1} [
                terminal_getch(re_d):
                if(_): {re_d < 1} [ set(re_go): 0 ]
                else(_): [
                    chr(re_dh): re_d
                    concat(r): r re_dh
                    add(re_k): re_k 1
                    if(_): {re_d >= 64 && re_d <= 126} [
                        if(_): {re_d != 91 || re_k > 1} [ set(re_go): 0 ]
                    ]
                ]
            ]
        ]
        elif(_): {re_c = 79} [
            set(re_go): 1
            while(_): {re_go = 1} [
                terminal_getch(re_d):
                if(_): {re_d < 1} [ set(re_go): 0 ]
                else(_): [
                    chr(re_dh): re_d
                    concat(r): r re_dh
                    if(_): {re_d < 48 || re_d > 57} [ set(re_go): 0 ]
                ]
            ]
        ]
    ]
]

# A piped or redirected line, byte by byte.
repl_rd_pipe(r): [
    global(_): rp_eof
    set(r): ""
    set(rrd_go): 1
    set(rrd_any): 0
    while(_): {rrd_go = 1} [
        terminal_getch(rrd_c):
        if(_): {rrd_c < 0} [ set(rrd_go): 0 ]
        if(_): {rrd_c = 10} [
            set(rrd_go): 0
            set(rrd_any): 1
        ]
        if(_): {rrd_c > 0 && rrd_c != 10 && rrd_c != 13} [
            set(rrd_any): 1
            chr(rrd_ch): rrd_c
            concat(r): r rrd_ch
        ]
        if(_): {rrd_c = 13} [ set(rrd_any): 1 ]
    ]
    if(_): {rrd_any = 0} [ set(rp_eof): 1 ]
]

# Keep reading while a command block is open. Brackets in quoted
# arguments and comments are ordinary text.
repl_dep(r): s d [
    len(n): s
    set(i): 0
    set(quote): 0
    set(r): d
    while(_): {i < n} [
        byte(ch): s i
        if(_): {quote != 0} [
            if(_): {ch = 92} [ add(i): i 1 ]
            elif(_): {ch = quote} [ set(quote): 0 ]
        ]
        elif(_): {ch = 35} [ return(r): r ]
        elif(_): {ch = 34 || ch = 39} [ set(quote): ch ]
        elif(_): {ch = 91} [ add(r): r 1 ]
        elif(_): {ch = 93 && r > 0} [ sub(r): r 1 ]
        add(i): i 1
    ]
]

# The prompt, as ussr's repl_prompt makes it: PS1 (PS2 while brackets
# are open), read again for every prompt so setenv takes effect at once;
# unset or empty gives the shell's default / "... ". The text is only
# shown. Escapes: \u user, \h host, \w working directory, \W its last
# component, \v version, \$ "$", \\ backslash; any other backslash pair
# is shown as written.
repl_prompt(r): cont default [
    set(rpp_var): "PS1"
    set(rpp_def): default
    if(_): {cont = 1} [
        set(rpp_var): "PS2"
        set(rpp_def): "... "
    ]
    getenv(rpp_f): rpp_var
    if(_): {rpp_f = null} [ set(rpp_f): "" ]
    if(_): {rpp_f = ""} [ set(rpp_f): rpp_def ]
    set(r): ""
    len(rpp_n): rpp_f
    set(rpp_i): 0
    while(_): {rpp_i < rpp_n} [
        slice(rpp_c): rpp_f rpp_i 1
        if(_): {rpp_c != "\\" || rpp_i + 1 = rpp_n} [
            concat(r): r rpp_c
        ]
        else(_): [
            add(rpp_i): rpp_i 1
            slice(rpp_e): rpp_f rpp_i 1
            set(rpp_done): 0
            if(_): {rpp_e = "u" || rpp_e = "h"} [
                set(rpp_a): "USERNAME"
                set(rpp_b): "USER"
                if(_): {rpp_e = "h"} [
                    set(rpp_a): "COMPUTERNAME"
                    set(rpp_b): "HOSTNAME"
                ]
                getenv(rpp_v): rpp_a
                if(_): {rpp_v = null} [ getenv(rpp_v): rpp_b ]
                if(_): {rpp_v = null} [ set(rpp_v): "?" ]
                concat(r): r rpp_v
                set(rpp_done): 1
            ]
            if(_): {rpp_e = "w" || rpp_e = "W"} [
                getcwd(rpp_w):
                if(_): {rpp_w = null} [ set(rpp_w): "?" ]
                if(_): {rpp_e = "W"} [
                    # the part after the last / or \, unless that is empty
                    len(rpp_wn): rpp_w
                    set(rpp_wl): {0 - 1}
                    set(rpp_wi): 0
                    while(_): {rpp_wi < rpp_wn} [
                        byte(rpp_wb): rpp_w rpp_wi
                        if(_): {rpp_wb = 47 || rpp_wb = 92} [ set(rpp_wl): rpp_wi ]
                        add(rpp_wi): rpp_wi 1
                    ]
                    if(_): {rpp_wl >= 0 && rpp_wl + 1 < rpp_wn} [
                        slice(rpp_w): rpp_w {rpp_wl + 1} {rpp_wn - rpp_wl - 1}
                    ]
                ]
                concat(r): r rpp_w
                set(rpp_done): 1
            ]
            if(_): {rpp_e = "v"} [
                concat(r): r "0.5"
                set(rpp_done): 1
            ]
            if(_): {rpp_e = "$" || rpp_e = "\\"} [
                concat(r): r rpp_e
                set(rpp_done): 1
            ]
            if(_): {rpp_done = 0} [
                concat(r): r "\\"
                concat(r): r rpp_e
            ]
        ]
        add(rpp_i): rpp_i 1
    ]
]
