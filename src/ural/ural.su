# ural.su — Ural package manager API
# Include this file with: $include "ural.su"
#
# Native commands required by this first implementation:
#   ural_init(ok): "ussr.boxes"
#   ural_install(code): "ukraine russia"
#   ural_uninstall(code): "ukraine"
#   ural_update(code): "ukraine"
#   ural_list(code):
#   ural_search(code): "ukraine"
#   ural_server_add(code): "https://packages.example.invalid"
#   ural_server_remove(code): "https://packages.example.invalid"
#
# The ural_* commands are intended to be registered by the native SQLite /
# transport bridge. They are not stock USSR built-ins yet.

ural_init(ok): "ussr.boxes"

install(code): packages [
    ural_install(code): packages
]

uninstall(code): package [
    ural_uninstall(code): package
]

update(code): package [
    ural_update(code): package
]

list_packages(code): [
    ural_list(code):
]

search_packages(code): query [
    ural_search(code): query
]

trust_server(code): url [
    ural_server_add(code): url
]

untrust_server(code): url [
    ural_server_remove(code): url
]
