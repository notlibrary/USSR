# ural.su — Ural package manager API
# Include this file with: $include "ural.su"
#
# These functions call the standalone native `ural` executable. Install the
# executable from the Ural package or put it on PATH before including this API.

install(code): packages [
    ural(code): "install" packages
]

uninstall(code): package [
    ural(code): "uninstall" package
]

update(code): package [
    ural(code): "update" package
]

list_packages(code): [
    ural(code): "list"
]

search_packages(code): query [
    ural(code): "search" query
]

trust_server(code): url [
    ural(code): "server" "add" url
]

untrust_server(code): url [
    ural(code): "server" "remove" url
]

# Recursively finds every box.uno under target_dir. Generated archives and
# metadata are written at the repository root.
pack(code): target_dir public_url [
    ural(code): "pack" target_dir public_url
]

# Recursively uploads .ural and *-box.uno files, preserving relative paths.
upload(code): target_dir ftp_url login password [
    ural(code): "upload" target_dir ftp_url login password
]
