# Omsk - image thumbnails for USSR: the O of the ROUND stack (Ryazan TLS,
# Omsk images, Ukraine HTTP, Novgorod forum, Dubna PostgreSQL).
#
# Pure USSR, no native image code: Omsk reads PNG and baseline JPEG,
# shrinks the picture to fit a square box (200x200 for Novgorod), keeping
# its proportions, and writes the thumbnail as a baseline JPEG.
#
#   omsk_thumb(t): bytes side         -> [w h tw th jpeg-bytes] or null
#   omsk_thumb_base64(t): text side   -> [w h tw th jpeg-base64] or null
#   omsk_info(i): bytes               -> ["png"|"jpeg" w h] or null
#   omsk_fit(d): w h side             -> [tw th], the thumbnail's size
#   omsk_unbase64(v): text            -> bytes, or null if not base64
#   omsk_base64(s): bytes             -> base64 text
#   omsk_error(s):                    -> why the last call gave null
#
# PNG: every colour type at bit depths 1-16, not interlaced; transparent
# pixels go on white. JPEG: baseline and extended sequential Huffman,
# greyscale or YCbCr, any 1x/2x/4x sampling, restart intervals; not
# progressive or arithmetic coded. Pictures larger than omsk_max_pixels
# (2048x2048 by default) are refused, so a small file cannot make Omsk
# spend minutes on a huge one.
#
# How it stays fast enough in an interpreter: a JPEG is decoded at 1/8,
# 1/4 or 1/2 of its size when that is still larger than the thumbnail (a
# reduced inverse DCT, as libjpeg's scaled decoding does), and each
# thumbnail pixel averages at most 4x4 samples of its source area. A PNG is
# inflated and unfiltered row by row, keeping only the 32 KiB window and
# the rows it samples. USSR vectors only grow at the end (push), so every
# table here is built in order and read with at.
$once
$include "../libs/strings.su"

global(_): omsk_ready omsk_err omsk_max_pixels omsk_b64v omsk_b64c omsk_rev omsk_lbase omsk_lext omsk_dbase omsk_dext omsk_clpos omsk_fixl omsk_fixd omsk_zz omsk_nat2zz omsk_idct omsk_fdct omsk_qlum omsk_qchr omsk_rlum omsk_rchr omsk_edcl omsk_edcc omsk_eacl omsk_eacc omsk_jhead omsk_nbits omsk_recip
global(_): omsk_pw omsk_ph omsk_ptype omsk_pdepth omsk_pch omsk_pstride omsk_pbpp omsk_plte omsk_trns omsk_prev omsk_pc omsk_py omsk_rowmap omsk_rowlast omsk_rowk omsk_coff omsk_ccnt omsk_cpos omsk_ptw omsk_acc omsk_rgb omsk_zero omsk_trim_kept

# ---------------------------------------------------------------- tables

omsk_setup(r): [
    set(r): 0
    set(ready): omsk_ready
    if(_): {ready = true} [
        return(r): r
    ]
    set(omsk_ready): true
    set(omsk_err): ""
    set(limit): omsk_max_pixels
    if(_): {limit = null} [
        set(omsk_max_pixels): 4194304
    ]
    set(omsk_b64c): "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    # base64 digit values; 64 marks "=", 128 anything else
    vec(omsk_b64v): ""
    set(i): 0
    while(_): {i < 256} [
        set(x): 128
        if(_): {i >= 65 && i <= 90} [
            set(x): {i - 65}
        ]
        elif(_): {i >= 97 && i <= 122} [
            set(x): {i - 71}
        ]
        elif(_): {i >= 48 && i <= 57} [
            set(x): {i + 4}
        ]
        elif(_): {i = 43} [
            set(x): 62
        ]
        elif(_): {i = 47} [
            set(x): 63
        ]
        elif(_): {i = 61} [
            set(x): 64
        ]
        push(_): omsk_b64v x
        add(i): i 1
    ]
