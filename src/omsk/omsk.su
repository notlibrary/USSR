    # bits needed for 0..4095
    vec(omsk_nbits): ""
    push(_): omsk_nbits 0
    set(s): 1
    while(_): {s <= 12} [
        set(k): {1 << (s - 1)}
        while(_): {k > 0} [
            push(_): omsk_nbits s
            set(k): {k - 1}
        ]
        add(s): s 1
    ]
