# lenin.su - Lenin, the brain center of the USSR: an agent that enriches and
# refines neuroslop code. It refines a prompt, gives it to "centrifuge" models
# from different developers for a number of cycles, each cycle seeing the best
# so far and how it measured, and extracts the best file by your criterion.
# With --method chain the best is passed on after every model, not every cycle;
# --method enrich is that chain, stopping after --patience cycles find nothing
# better, and refining again first if the best still fails. --holdout is a test
# the models never see; --target and --budget stop a run sooner.
# --refine N refines the prompt N rounds against drafts; --task adds sub-tasks.
# --score is a "what is better" test suite: how much of it passes ranks them.
#
#     ussr src/lenin/lenin.su --models models.conf --dir out --cycles 3 \
#          --criteria size --test "python {file}" --ext .py "the prompt"
#
# "Best" comes from measuring: a candidate that fails --test cannot win, then
# size is its bytes and speed its runs of --test a second. Only without --test
# the models vote, and the report says that nothing was run. See README.md.

$include "../libs/strings.su"

global(_): lenin_reply
# true: tests run with no shell, their words as they are (Moscow has none)
global(_): lenin_direct
# paid calls made in this run, and the most it may make (-1: no limit)
global(_): lenin_calls
global(_): lenin_budget

# --- text

lenin_lines(r): text [
    vec(r): ""
    chr(nl): 10
    len(n): text
    set(from): 0
    while(_): {from <= n} [
        str_find(i): text nl from
        if(_): {i < 0} [ set(i): n ]
        slice(line): text from {i - from}
        push(_): r line
        set(from): {i + 1}
    ]
]

# the words of a line, split at spaces and tabs
lenin_words(r): line [
    vec(r): ""
    len(n): line
    set(i): 0
    set(from): -1
    while(_): {i <= n} [
        set(space): true
        if(_): {i < n} [
            byte(b): line i
            set(space): {b = 32 || b = 9 || b = 13}
        ]
        if(_): {space && from >= 0} [
            slice(w): line from {i - from}
            push(_): r w
            set(from): -1
        ]
        elif(_): {space = false && from < 0} [ set(from): i ]
        set(i): {i + 1}
    ]
]

lenin_replace(r): text from to [
    set(r): ""
    len(n): text
    len(nf): from
    set(at_): 0
    while(_): {at_ <= n} [
        str_find(i): text from at_
        if(_): {i < 0} [
            slice(tail): text at_ {n - at_}
            concat(r): r tail
            return(r): r
        ]
        slice(part): text at_ {i - at_}
        concat(r): r part to
        set(at_): {i + nf}
    ]
]

# letters, digits, - and . of a name, the rest _: for a file name
lenin_safe(r): name [
    set(r): ""
    len(n): name
    set(i): 0
    while(_): {i < n} [
        byte(b): name i
        set(ok): {(b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b = 45 || b = 46}
        if(_): {ok = false} [ set(b): 95 ]
        chr(c): b
        concat(r): r c
        set(i): {i + 1}
    ]
]

# what is in the first fenced block of a reply, else all of it
lenin_code(r): reply [
    set(fence): "```"
    str_find(a): reply fence 0
    if(_): {a < 0} [
        str_trim(r): reply
        return(r): r
    ]
    chr(nl): 10
    str_find(start): reply nl a
    if(_): {start < 0} [
        str_trim(r): reply
        return(r): r
    ]
    set(start): {start + 1}
    str_find(b): reply fence start
    len(n): reply
    if(_): {b < 0} [ set(b): n ]
    slice(r): reply start {b - start}
]

lenin_read(r): path [
    set(r): null
    open_file(h): path "rb"
    if(_): {h < 0} [ return(r): r ]
    close_file(_): h
    readfile(r): path
]

# the last whole number in a text, -1 when it has none: a --score suite
# prints its score last, "9 checks, passed 7", as of "7/9" this reads 9
lenin_last_number(r): text [
    set(r): -1
    len(i): text
    set(i): {i - 1}
    set(end_): -1
    while(_): {i >= 0} [
        byte(b): text i
        set(digit): {b >= 48 && b <= 57}
        if(_): {digit && end_ < 0} [ set(end_): i ]
        if(_): {digit = false && end_ >= 0} [
            slice(s): text {i + 1} {end_ - i}
            str_to_number(r): s
            return(r): r
        ]
        set(i): {i - 1}
    ]
    if(_): {end_ >= 0} [
        slice(s): text 0 {end_ + 1}
        str_to_number(r): s
    ]
]

lenin_has(r): v x [
    set(r): false
    len(n): v
    set(i): 0
    while(_): {i < n} [
        at(y): v i
        if(_): {y = x} [
            set(r): true
            return(r): r
        ]
        set(i): {i + 1}
    ]
]

# the end of a text, for showing a model what went wrong
lenin_tail(r): text max [
    len(n): text
    set(r): text
    if(_): {n > max} [ slice(r): text {n - max} max ]
]

# --- the models

# a file of lines "provider model key_env [url]"; key_env "-": no key. Gives a
# vector of [provider, model, key_env, url], null when it cannot be read.
lenin_load_models(r): path [
    lenin_read(text): path
    set(r): null
    if(_): {text = null} [ return(r): r ]
    lenin_lines(lines): text
    vec(r): ""
    len(n): lines
    set(i): 0
    while(_): {i < n} [
        at(line): lines i
        lenin_words(w): line
        len(nw): w
        if(_): {nw >= 3} [
            at(first): w 0
            byte(b0): first 0
            if(_): {b0 != 35} [
                at(mkey): w 2
                at(mmodel): w 1
                set(url): ""
                if(_): {nw > 3} [ at(url): w 3 ]
                vec(m): ""
                push(_): m first
                push(_): m mmodel
                push(_): m mkey
                push(_): m url
                push(_): r m
            ]
        ]
        set(i): {i + 1}
    ]
]

# the environment prompt reads, for model m: false when its key is not set
lenin_use_model(r): m system [
    at(provider): m 0
    at(model): m 1
    at(key_env): m 2
    at(url): m 3
    set(r): true
    setenv(_): "USSR_AI_PROVIDER" provider
    setenv(_): "USSR_AI_MODEL" model
    setenv(_): "USSR_AI_MAX_TOKENS" "8192"
    setenv(_): "USSR_AI_TIMEOUT" "600"
    setenv(_): "USSR_AI_SYSTEM" system
    if(_): {url = ""} [ unsetenv(_): "USSR_AI_URL" ]
    else(_): [ setenv(_): "USSR_AI_URL" url ]
    if(_): {key_env = "-"} [
        # not unset: prompt would fall back on OPENAI_API_KEY and send your
        # real key to this model's URL
        setenv(_): "USSR_AI_KEY" "none"
    ]
    else(_): [
        getenv(key): key_env
        if(_): {key = null || key = ""} [
            concat(m2): "lenin: " key_env " is not set: skipping " model
            print(_): m2
            set(r): false
            return(r): r
        ]
        setenv(_): "USSR_AI_KEY" key
    ]
]

lenin_prompt_call(r): question [
    set(r): 0
    prompt(answer): question
    set(lenin_reply): answer
]

# true once the run has made as many calls as --budget allows
lenin_spent(r): [
    set(r): false
    if(_): {lenin_budget = null || lenin_calls = null} [ return(r): r ]
    if(_): {lenin_budget >= 0} [ set(r): {lenin_calls >= lenin_budget} ]
]

# model m's answer, null when it failed: one model failing ends no run. Over
# the budget no call goes out.
lenin_ask(r): m system question [
    set(r): null
    lenin_spent(spent):
    if(_): spent [ return(r): r ]
    lenin_use_model(ok): m system
    if(_): {ok = false} [ return(r): r ]
    if(_): {lenin_calls != null} [ set(lenin_calls): {lenin_calls + 1} ]
    set(lenin_reply): null
    try(failed): "lenin_prompt_call" question
    unsetenv(_): "USSR_AI_KEY"
    if(_): {failed = 0} [ set(r): lenin_reply ]
]

# --- measuring

# a line through the shell -> its exit status
lenin_shell(r): line [
    getenv(os): "OS"
    if(_): {os = "Windows_NT"} [ cmd(r): "/c" line ]
    else(_): [ sh(r): "-c" line ]
]

# true where there is no shell to run a test line: Moscow, the USSR kernel,
# has no /bin/sh
lenin_no_shell(r): [
    set(r): false
    getenv(os): "OS"
    if(_): {os = "Windows_NT"} [ return(r): r ]
    file_exists(sh): "/bin/sh"
    set(r): {sh = false}
]

# a test run with no shell: its words, {file} in one of them or the file
# after the last, are a program on PATH and its arguments; what it prints,
# stdout and stderr, goes to log (USSR_EXTERNAL_OUTPUT). No quotes, pipes or
# redirections: there is nothing to read them. -> its exit status, 127 when
# its first word is not a program's name
lenin_direct_run(r): test file log [
    set(r): 127
    lenin_words(words): test
    len(nw): words
    if(_): {nw = 0} [ return(r): r ]
    at(prog): words 0
    # the program's name goes into code: a name, nothing else
    len(np): prog
    set(ok): {np > 0}
    set(i): 0
    while(_): {i < np} [
        byte(b): prog i
        set(ch): {(b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b = 95}
        if(_): {ch = false} [ set(ok): false ]
        set(i): {i + 1}
    ]
    if(_): {ok = false} [
        concat(said): "lenin: with no shell a test is a program's name on PATH and its arguments, not " prog
        print(_): said
        return(r): r
    ]
    set(code): ""
    concat(code): prog "(st):"
    set(placed): false
    set(i): 1
    while(_): {i < nw} [
        at(w): words i
        str_find(k): w "{file}" 0
        if(_): {k >= 0} [
            lenin_replace(w): w "{file}" file
            set(placed): true
        ]
        lenin_quote(q): w
        concat(code): code " " q
        set(i): {i + 1}
    ]
    if(_): {placed = false} [
        lenin_quote(q): file
        concat(code): code " " q
    ]
    setenv(_): "USSR_EXTERNAL_OUTPUT" log
    eval(st): code
    unsetenv(_): "USSR_EXTERNAL_OUTPUT"
    set(r): st
]

# text as a USSR string in double quotes, for eval: \ and " escaped
lenin_quote(r): text [
    chr(bs): 92
    chr(dq): 34
    concat(bb): bs bs
    concat(bq): bs dq
    lenin_replace(t): text bs bb
    lenin_replace(t): t dq bq
    concat(r): dq t dq
]

# command run on file, what it prints to log -> its exit status: through
# the shell, or with none (lenin_direct)
lenin_check(r): command file log [
    if(_): {lenin_direct = true} [
        lenin_direct_run(r): command file log
        return(r): r
    ]
    lenin_test_line(line): command file log
    lenin_shell(r): line
]

# the test line for a file: {file} in it, else the file goes at its end. Its
# output goes to log.
lenin_test_line(r): test file log [
    # cmd's tools take a / for an option
    getenv(os): "OS"
    if(_): {os = "Windows_NT"} [
        chr(bs): 92
        lenin_replace(file): file "/" bs
        lenin_replace(log): log "/" bs
    ]
    str_find(i): test "{file}" 0
    if(_): {i >= 0} [ lenin_replace(line): test "{file}" file ]
    else(_): [ concat(line): test " " file ]
    concat(r): line " > " log " 2>&1"
]

# a candidate: a btree of model, cycle, path, code, size, tested, passed, rate,
# score, and log, what its test said when it failed. test exits 0 when the
# file works. score is a "what is better" suite: the last number it prints is
# how much of it passes, so a candidate that fails can still be nearer; with
# no test, it passes when the suite exits 0. score -1: no suite. holdout is a
# hidden test: it must pass too, and what it says goes to no model. hidden is
# none, passed or FAILED.
lenin_measure(r): name path code test score holdout log window [
    btree(r):
    btput(_): r "model" name
    btput(_): r "path" path
    btput(_): r "code" code
    len(size): code
    btput(_): r "size" size
    btput(_): r "tested" false
    btput(_): r "passed" true
    btput(_): r "rate" 0
    btput(_): r "score" -1
    btput(_): r "hidden" "none"
    btput(_): r "log" ""
    if(_): {test = "" && score = ""} [ return(r): r ]
    btput(_): r "tested" true
    set(timed): test
    if(_): {test != ""} [
        lenin_check(st): test path log
        if(_): {st != 0} [
            btput(_): r "passed" false
            lenin_read(said): log
            if(_): {said = null} [ set(said): "" ]
            lenin_tail(said): said 2000
            btput(_): r "log" said
        ]
    ]
    if(_): {score != ""} [
        if(_): {test = ""} [ set(timed): score ]
        concat(slog): log ".score"
        lenin_check(st): score path slog
        lenin_read(said): slog
        if(_): {said = null} [ set(said): "" ]
        lenin_last_number(n): said
        if(_): {n < 0} [ set(n): 0 ]
        btput(_): r "score" n
        if(_): {test = "" && st != 0} [
            btput(_): r "passed" false
            lenin_tail(said): said 2000
            btput(_): r "log" said
        ]
    ]
    btget(passed): r "passed"
    if(_): {holdout != "" && passed} [
        concat(hlog): log ".holdout"
        lenin_check(st): holdout path hlog
        if(_): {st = 0} [ btput(_): r "hidden" "passed" ]
        else(_): [
            btput(_): r "hidden" "FAILED"
            btput(_): r "passed" false
            set(passed): false
        ]
    ]
    if(_): {passed = false || window <= 0} [ return(r): r ]
    # the clock has whole seconds: runs a second, over the window
    time(t0):
    set(runs): 0
    set(now): t0
    while(_): {now - t0 < window} [
        lenin_check(st): timed path log
        if(_): {st != 0} [
            btput(_): r "passed" false
            btput(_): r "log" "it failed when run again: it does not always pass"
            return(r): r
        ]
        set(runs): {runs + 1}
        time(now):
    ]
    btput(_): r "rate" {runs / (now - t0)}
]

# does a beat b? One that passes first; then the criterion; then the other one
lenin_better(r): a b criteria [
    btget(pa): a "passed"
    btget(pb): b "passed"
    if(_): {pa != pb} [
        set(r): pa
        return(r): r
    ]
    # more of the suite passes
    btget(qa): a "score" -1
    btget(qb): b "score" -1
    if(_): {qa != qb} [
        set(r): {qa > qb}
        return(r): r
    ]
    btget(sa): a "size"
    btget(sb): b "size"
    btget(ra): a "rate"
    btget(rb): b "rate"
    if(_): {criteria = "speed" && ra != rb} [
        set(r): {ra > rb}
        return(r): r
    ]
    if(_): {sa != sb} [
        set(r): {sa < sb}
        return(r): r
    ]
    set(r): {ra > rb}
]

lenin_best(r): candidates criteria [
    set(r): null
    len(n): candidates
    set(i): 0
    while(_): {i < n} [
        at(c): candidates i
        if(_): {r = null} [ set(r): c ]
        else(_): [
            lenin_better(b): c r criteria
            if(_): b [ set(r): c ]
        ]
        set(i): {i + 1}
    ]
]

# without a test the models choose: each is shown the answers under letters,
# not whose they are. Gives the candidate with the most votes (the first of
# them on a tie), or null when nobody voted.
lenin_vote(r): models candidates task [
    set(r): null
    len(nc): candidates
    set(listing): ""
    set(i): 0
    while(_): {i < nc} [
        at(c): candidates i
        btget(code): c "code"
        chr(letter): {65 + i}
        chr(nl): 10
        concat(listing): listing "=== " letter " ===" nl code nl
        set(i): {i + 1}
    ]
    chr(nl): 10
    concat(q): "The task:" nl task nl nl "The answers:" nl listing nl "Which answer does the task best? Reply with its letter only."
    vec(votes): ""
    set(i): 0
    while(_): {i < nc} [
        push(_): votes 0
        set(i): {i + 1}
    ]
    set(system): "You judge code. Look for what is wrong with each answer before you choose. Reply with one letter."
    len(nm): models
    set(j): 0
    set(any): false
    while(_): {j < nm} [
        at(m): models j
        lenin_ask(answer): m system q
        if(_): {answer != null} [
            str_trim(answer): answer
            len(la): answer
            # the letter alone: "Answer B" is no vote for A
            if(_): {la = 1} [
                byte(b): answer 0
                set(k): {b - 65}
                if(_): {k >= 0 && k < nc} [
                    set(any): true
                    vec(next): ""
                    set(i): 0
                    while(_): {i < nc} [
                        at(v): votes i
                        if(_): {i = k} [ set(v): {v + 1} ]
                        push(_): next v
                        set(i): {i + 1}
                    ]
                    set(votes): next
                ]
            ]
        ]
        set(j): {j + 1}
    ]
    if(_): {any = false} [ return(r): r ]
    set(top): -1
    set(i): 0
    while(_): {i < nc} [
        at(v): votes i
        if(_): {v > top} [
            set(top): v
            at(r): candidates i
        ]
        set(i): {i + 1}
    ]
]

# --- the pipeline

lenin_refine_system(r): [
    set(r): "You turn a request for code into a precise prompt for a programmer. State the language, the inputs, the outputs, the limits and how to tell it works. Keep to what the request says or plainly implies: do not invent requirements, and list any assumption you make as an assumption. Reply with the prompt only."
]

lenin_make_system(r): criteria [
    concat(r): "You write code. Reply with one complete file in one fenced code block, with nothing else after it. What counts is that it works and then its " criteria "."
]

# what a model is asked in a cycle: the task, and after the first cycle the
# best so far and how it measured
# how a candidate measured, in words for a model
lenin_state(r): c [
    btget(passed): c "passed"
    btget(tested): c "tested"
    btget(size): c "size"
    btget(rate): c "rate"
    btget(score): c "score" -1
    btget(hidden): c "hidden" "none"
    btget(said): c "log"
    chr(nl): 10
    str_from_int(ss): size
    str_from_number(rs): rate 2
    set(r): "It was not run."
    if(_): tested [
        set(r): "It failed its test."
        if(_): passed [ concat(r): "It passes its test, " ss " bytes, " rs " runs a second." ]
        # one bit and no output: the hidden test stays hidden
        if(_): {hidden = "FAILED"} [ set(r): "It passes the test you are shown but fails a hidden one, whose output is kept from you: make it work for every input the task allows, not only those." ]
        if(_): {score >= 0} [
            str_from_int(qs): score
            concat(r): r " Its test suite scores " qs "."
        ]
        if(_): {passed = false && hidden != "FAILED"} [ concat(r): r " The test said:" nl said ]
    ]
]

# what the answers that failed said about themselves, the last few, other than
# best: so the next model does not make the same mistakes
lenin_defects(r): all best max [
    set(r): ""
    chr(nl): 10
    set(bpath): ""
    if(_): {best != null} [ btget(bpath): best "path" ]
    vec(seen): ""
    set(k): 0
    len(i): all
    set(i): {i - 1}
    while(_): {i >= 0 && k < max} [
        at(x): all i
        btget(xp): x "passed"
        btget(xt): x "tested"
        btget(path): x "path"
        if(_): {xt && xp = false && path != bpath} [
            btget(xh): x "hidden" "none"
            btget(xlog): x "log"
            set(what): ""
            if(_): {xh = "FAILED"} [ set(what): "it passed the test shown but failed the hidden one" ]
            else(_): [
                lenin_tail(t): xlog 300
                lenin_cell(what): t 300
                str_trim(what): what
                if(_): {what = ""} [ set(what): "it failed, and its test said nothing" ]
            ]
            lenin_has(dup): seen what
            if(_): {dup = false} [
                push(_): seen what
                btget(xm): x "model"
                btget(xc): x "cycle"
                str_from_int(xcs): xc
                concat(r): r "- cycle " xcs ", " xm ": " what nl
                set(k): {k + 1}
            ]
        ]
        set(i): {i - 1}
    ]
]

# what goes with the best to the next model, besides the task: the sub-tasks
# found so far and the known defects
lenin_handoff(r): all best reqs [
    set(r): ""
    chr(nl): 10
    len(n): reqs
    if(_): {n > 0} [
        concat(r): "Requirements so far:" nl
        set(i): 0
        while(_): {i < n} [
            at(t): reqs i
            concat(r): r "- " t nl
            set(i): {i + 1}
        ]
        concat(r): r nl
    ]
    lenin_defects(d): all best 3
    if(_): {d != ""} [ concat(r): r "Known defects of other answers, not to repeat:" nl d nl ]
]

lenin_question(r): task best criteria notes [
    set(r): task
    if(_): {best = null} [ return(r): r ]
    btget(code): best "code"
    btget(tested): best "tested"
    chr(nl): 10
    lenin_state(state): best
    set(title): "The answer so far:"
    if(_): tested [ set(title): "The best answer so far:" ]
    concat(r): task nl nl title nl "```" nl code nl "```" nl state nl nl notes "Give a better one, by " criteria ", that still does the task."
]

# --- the record: every run adds to one file, so that many runs can answer
# what one cannot: do later cycles win, does anything beat a classic baseline?
# Lines of tab-separated fields:
#   run  id time task method criteria cycles models tested winner cycle passed baseline title
#   answer  id cycle model state bytes rate won
# state is passed, FAILED, notrun or noanswer; baseline is none, beaten or stands.

# LENIN_HISTORY, else .lenin/history.tsv in the home directory
lenin_history_path(r): [
    getenv(r): "LENIN_HISTORY"
    if(_): {r != null && r != ""} [ return(r): r ]
    getenv(home): "HOME"
    if(_): {home = null || home = ""} [ getenv(home): "USERPROFILE" ]
    if(_): {home = null || home = ""} [
        set(r): "lenin-history.tsv"
        return(r): r
    ]
    concat(r): home "/.lenin/history.tsv"
]

# the fields of a line, split at tabs; empty fields count
lenin_fields(r): line [
    vec(r): ""
    chr(tab): 9
    len(n): line
    set(from): 0
    while(_): {from <= n} [
        str_find(i): line tab from
        if(_): {i < 0} [ set(i): n ]
        slice(field): line from {i - from}
        push(_): r field
        set(from): {i + 1}
    ]
]

# a number for a prompt, so runs of one task can be told apart without it
lenin_task_id(r): text [
    set(h): 2166136261
    len(n): text
    set(i): 0
    while(_): {i < n} [
        byte(b): text i
        set(h): {(h * 16777619 + b) & 4294967295}
        set(i): {i + 1}
    ]
    str_from_int(r): h
]

# text for one field: on one line, no tabs, at most max bytes, no cut letter
lenin_cell(r): text max [
    set(r): ""
    len(n): text
    if(_): {n > max} [
        set(n): max
        set(more): true
        while(_): more [
            set(more): false
            if(_): {n > 0} [
                byte(b): text n
                if(_): {(b & 192) = 128} [
                    set(n): {n - 1}
                    set(more): true
                ]
            ]
        ]
    ]
    set(i): 0
    while(_): {i < n} [
        byte(b): text i
        if(_): {b = 9 || b = 10 || b = 13} [ set(b): 32 ]
        chr(c): b
        concat(r): r c
        set(i): {i + 1}
    ]
]

# makes the directory a file goes in, one level
lenin_make_parent(r): path [
    set(r): 0
