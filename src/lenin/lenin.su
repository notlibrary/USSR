        lenin_count(a): answers name
        lenin_count(na): noanswer name
        lenin_count(te): tested name
        lenin_count(pa): passed name
        lenin_count(wi): wins name
        btget(pn): passed name 0
        btget(tn): tested name 0
        lenin_percent(rate): pn tn
        concat(out): out "| " name " | " a " | " na " | " te " | " pa " | " rate " | " wi " |" nl
        set(i): {i + 1}
    ]
    concat(out): out nl "| method | runs | a passing winner | won after cycle 1 | baseline beaten | baseline stands |" nl
    concat(out): out "|---|---|---|---|---|---|" nl
    btkeys(k): runs
    len(n): k
    set(i): 0
    while(_): {i < n} [
        at(name): k i
        lenin_count(ru): runs name
        lenin_count(me): measured name
        lenin_count(la): later name
        lenin_count(be): beaten name
        lenin_count(st): stands name
        concat(out): out "| " name " | " ru " | " me " | " la " | " be " | " st " |" nl
        set(i): {i + 1}
    ]
    str_from_int(ms): total_measured
    str_from_int(ls): total_later
    lenin_percent(lp): total_later total_measured
    concat(out): out nl "Refining: a later cycle won " ls " of " ms " runs with a passing winner (" lp ")." nl
    set(with_base): {total_beaten + total_stands}
