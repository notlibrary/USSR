]

# --- refining: the prompt, improved until it reflects the request.
# Prompt A "make a text editor" and sub-task A "it supports bold text" make
# prompt B "make a text editor that supports bold text". Sub-tasks are yours
# (--task) or found: a draft is written from the prompt, run through the test,
# and a model lists what the draft shows the prompt leaves out.

# the request with its sub-tasks after it
lenin_fold(r): task tasks [
    set(r): task
    len(n): tasks
    if(_): {n = 0} [ return(r): r ]
    chr(nl): 10
    concat(r): task nl nl "It must also:"
    set(i): 0
    while(_): {i < n} [
        at(t): tasks i
        concat(r): r nl "- " t
        set(i): {i + 1}
    ]
]

lenin_subtask_system(r): [
    set(r): "You check a prompt against the request it was made from, using code a programmer wrote from the prompt and what its test said. List what the prompt must also say so that code made from it does what the request asks: each thing the code got wrong or left out because the prompt did not say it. One sub-task per line, starting with - and a space. Add nothing the request does not ask for or plainly imply. If the prompt already says it all, reply NONE."
]

# the sub-tasks in a reply, lines "- x" or "* x", that are not in known
lenin_subtasks(r): reply known [
    vec(r): ""
    lenin_lines(lines): reply
    len(n): lines
    set(i): 0
    while(_): {i < n} [
        at(line): lines i
        str_trim(line): line
        len(ln): line
        if(_): {ln > 2} [
            slice(head): line 0 2
            if(_): {head = "- " || head = "* "} [
                slice(t): line 2 {ln - 2}
                str_trim(t): t
                lenin_has(old): known t
                lenin_has(twice): r t
                if(_): {t != "" && old = false && twice = false} [ push(_): r t ]
            ]
        ]
        set(i): {i + 1}
    ]
]

# the prompt the centrifuge gets. Round 1 refines the request with your
# sub-tasks in it; each round after that drafts, lists what is missing and adds
# it, until a round finds nothing new. Writes sep/tasks.md and the drafts.
lenin_refine(r): args sep [
    btget(models): args "models"
    btget(task0): args "prompt"
    btget(tasks): args "tasks" null
    if(_): {tasks = null} [ vec(tasks): "" ]
    btget(refine): args "refine"
    btget(rounds): args "refine_rounds" 1
    btget(test): args "test"
    btget(score): args "score" ""
    btget(holdout): args "holdout" ""
    btget(ext): args "ext"
    btget(criteria): args "criteria"
    at(m0): models 0
    chr(nl): 10
    lenin_fold(request): task0 tasks
    set(r): request
    concat(notes): "# Sub-tasks" nl nl
    len(nt): tasks
    set(i): 0
    while(_): {i < nt} [
        at(t): tasks i
        concat(notes): notes "- " t " (yours)" nl
        set(i): {i + 1}
    ]
    set(nfound): 0
    concat(tpath): sep "tasks.md"
    btput(_): args "all_tasks" tasks
    btput(_): args "task_notes" notes
    if(_): {refine = false} [
        if(_): {nt > 0} [ writefile(_): tpath notes ]
        return(r): r
    ]
    lenin_refine_system(sys):
    lenin_ask(better): m0 sys request
    if(_): {better = null} [
        print(_): "lenin: refining failed: the prompt goes as it is"
        if(_): {nt > 0} [ writefile(_): tpath notes ]
        return(r): r
    ]
    str_trim(r): better
    print(_): "lenin: prompt refined"
    set(base): r
    vec(found): ""
    lenin_make_system(msys): criteria
    lenin_subtask_system(ssys):
    set(k): 2
    set(go): true
    while(_): {go && k <= rounds} [
        str_from_int(ks): k
        concat(round): sep "refine" ks
        concat(said): "lenin: refining, round " ks ": a draft from the prompt"
        print(_): said
        concat(rp): round ".md"
        writefile(_): rp r
        lenin_ask(reply): m0 msys r
        set(listed): null
        if(_): {reply = null} [ print(_): "lenin: no draft came: refining stops here" ]
        else(_): [
            lenin_code(code): reply
            concat(dfile): round "_draft" ext
            writefile(_): dfile code
            concat(dlog): round "_draft.log"
            lenin_measure(draft): "draft" dfile code test score holdout dlog 0
            lenin_state(state): draft
            lenin_find_question(q): request r code state
            lenin_ask(listed): m0 ssys q
            if(_): {listed = null} [ print(_): "lenin: no sub-tasks came: refining stops here" ]
        ]
        if(_): {listed = null} [ set(go): false ]
        else(_): [
            vec(known): ""
            set(i): 0
            while(_): {i < nt} [
                at(t): tasks i
                push(_): known t
                set(i): {i + 1}
            ]
            len(nf): found
            set(i): 0
            while(_): {i < nf} [
                at(t): found i
                push(_): known t
                set(i): {i + 1}
            ]
            lenin_subtasks(new): listed known
            len(nn): new
            if(_): {nn = 0} [
                concat(said): "lenin: round " ks " found nothing new: the prompt says what the request asks"
                print(_): said
                set(go): false
            ]
            else(_): [
                set(i): 0
                while(_): {i < nn} [
                    at(t): new i
                    push(_): found t
                    concat(notes): notes "- " t " (round " ks ")" nl
                    set(i): {i + 1}
                ]
                set(nfound): {nfound + nn}
                lenin_fold(r): base found
                str_from_int(ns): nn
                concat(said): "lenin: round " ks " added " ns " sub-tasks"
                print(_): said
            ]
        ]
        set(k): {k + 1}
    ]
    if(_): {nt + nfound > 0} [ writefile(_): tpath notes ]
    vec(all_tasks): ""
    set(i): 0
    while(_): {i < nt} [
        at(t): tasks i
        push(_): all_tasks t
        set(i): {i + 1}
    ]
    len(nf): found
    set(i): 0
    while(_): {i < nf} [
        at(t): found i
        push(_): all_tasks t
        set(i): {i + 1}
    ]
    btput(_): args "all_tasks" all_tasks
    btput(_): args "task_notes" notes
]

# what the model that finds sub-tasks is asked about code written from a prompt
lenin_find_question(r): request prompt code state [
    chr(nl): 10
    concat(r): "The request:" nl request nl nl "The prompt made from it:" nl prompt nl nl
    concat(r): r "Code written from the prompt:" nl "```" nl code nl "```" nl state
]

# args: a btree of models, prompt, criteria, method, dir, cycles, test, ext,
# baseline, window, refine. Writes dir/refined.md, the candidates with the prompt
# each was made from, dir/best<ext> and dir/report.md. Gives 0 when there is a
# winner, 1 when none.
#
# method rounds: every model in a cycle gets the best from the cycles before it.
# method chain: one model after another, each getting the best so far, what the
# one before it did included. With no test there is no best to pass on, only the
# smallest, and a stub is small: the chain then passes on the latest answer.
lenin_run(r): args [
    set(r): 1
    btget(models): args "models"
    btget(criteria): args "criteria"
    btget(method): args "method"
    # enrich: a chain that stops once a cycle finds nothing better
    set(enrich): {method = "enrich"}
    set(chain): {method = "chain" || enrich}
    btget(dir): args "dir"
    btget(cycles): args "cycles"
    btget(test): args "test"
    btget(score): args "score" ""
    btget(holdout): args "holdout" ""
    btget(patience): args "patience" 1
    btget(target): args "target" -1
    btget(budget): args "budget" -1
    set(lenin_calls): 0
    # no shell, as in Moscow: the tests run as a program and its arguments
    btget(direct): args "direct" null
    if(_): {direct = null} [ lenin_no_shell(direct): ]
    set(lenin_direct): direct
    set(lenin_budget): budget
    set(measured): {test != "" || score != ""}
    btget(ext): args "ext"
    btget(baseline): args "baseline"
    btget(window): args "window"
    btget(refine): args "refine"
    btget(rounds): args "refine_rounds" 1
    if(_): {criteria != "speed"} [ set(window): 0 ]
    is_dir(there): dir
    if(_): {there = 0} [ make_dir(_): dir ]
    len(nm): models
    chr(nl): 10
    concat(sep): dir "/"
    set(calls): {nm * cycles}
    if(_): {refine && rounds > 0} [ set(calls): {calls + 1 + 2 * (rounds - 1)} ]
    if(_): {measured = false} [ set(calls): {calls + nm} ]
    # enrich refines again when it stalls on a failing best: once a cycle at most
    if(_): {enrich && refine && rounds > 0} [ set(calls): {calls + cycles - 1} ]
    str_from_int(cs): calls
    concat(said): "lenin: up to " cs " paid model calls"
    if(_): {budget >= 0 && budget < calls} [
        str_from_int(bs): budget
        concat(said): "lenin: up to " bs " paid model calls, the budget"
    ]
    print(_): said
    if(_): measured [
        print(_): "lenin: --test, --score and --holdout run code no person has read, with your rights: use a sandbox"
        if(_): {lenin_direct = true} [
            print(_): "lenin: no shell: a test runs as a program on PATH and its arguments"
        ]
    ]
    # 1. the prompt, refined
    if(_): {rounds < 1} [ btput(_): args "refine" false ]
    lenin_refine(task): args sep
    btput(_): args "refine" refine
    concat(path): sep "refined.md"
    writefile(_): path task
    # 2, 3. the centrifuge
    lenin_make_system(sys): criteria
    lenin_subtask_system(ssys):
    btget(reqs): args "all_tasks" null
    if(_): {reqs = null} [ vec(reqs): "" ]
    btget(task_notes): args "task_notes" ""
    btget(task0): args "prompt"
    btget(utasks): args "tasks" null
    if(_): {utasks = null} [ vec(utasks): "" ]
    lenin_fold(request): task0 utasks
    vec(all): ""
    vec(missed): ""
    set(best): null
    # what the next model is shown
    set(current): null
    set(stopped): ""
    # cycles in a row that found nothing better
    set(stale): 0
    set(go): true
    set(c): 1
    while(_): {go && c <= cycles} [
        set(before): ""
        if(_): {best != null} [ btget(before): best "path" ]
        lenin_handoff(notes): all current reqs
        lenin_question(q): task current criteria notes
        str_from_int(cn): c
        set(j): 0
        while(_): {go && j < nm} [
            lenin_spent(spent):
            if(_): spent [
                str_from_int(bs): budget
                concat(stopped): "Stopped in cycle " cn ": the budget of " bs " calls is spent."
                concat(said): "lenin: " stopped
                print(_): said
                set(go): false
            ]
            else(_): [
                if(_): chain [
                    lenin_handoff(notes): all current reqs
                    lenin_question(q): task current criteria notes
                ]
                at(m): models j
                at(mname): m 1
                lenin_safe(safe): mname
                concat(file): sep "cycle" cn "_" safe ext
                concat(log): sep "cycle" cn "_" safe ".log"
                concat(said): "lenin: cycle " cn ": " mname
                print(_): said
                # what it was sent, for reading afterwards
                concat(sent): sep "cycle" cn "_" safe ".prompt.md"
                writefile(_): sent q
                lenin_ask(reply): m sys q
                if(_): {reply != null} [
                    lenin_code(code): reply
                    writefile(_): file code
                    lenin_measure(cand): mname file code test score holdout log window
                    btput(_): cand "cycle" c
                    push(_): all cand
                    lenin_describe(d): cand
                    concat(said): "lenin:   " d
                    print(_): said
                    if(_): chain [
                        if(_): {measured = false} [ set(current): cand ]
                        else(_): [ lenin_best(current): all criteria ]
                    ]
                    # the requirements are met: no need to go on
                    if(_): {target >= 0} [
                        btget(cp): cand "passed"
                        btget(cq): cand "score" -1
                        if(_): {cp && cq >= target} [
                            str_from_int(ts): target
                            concat(stopped): "Stopped in cycle " cn ": an answer passes and scores " ts ", the target."
                            concat(said): "lenin: " stopped
                            print(_): said
                            set(go): false
                        ]
                    ]
                ]
                else(_): [
                    lenin_spent(spent):
                    if(_): {spent = false} [
                        vec(miss): ""
                        push(_): miss mname
                        push(_): miss cn
                        push(_): missed miss
                    ]
                ]
            ]
            set(j): {j + 1}
        ]
        lenin_best(best): all criteria
        if(_): {chain = false} [ set(current): best ]
        # the best the tests can tell apart: no better one came this cycle
        set(after): ""
        if(_): {best != null} [ btget(after): best "path" ]
        if(_): {after = before} [ set(stale): {stale + 1} ]
        else(_): [ set(stale): 0 ]
        if(_): {enrich && go && stale >= patience && c < cycles} [
            str_from_int(ps): patience
            concat(why): "Stopped after cycle " cn ": " ps " cycles in a row found nothing better, by the test."
            if(_): {patience = 1} [ concat(why): "Stopped after cycle " cn ": it found nothing better than the cycles before it, by the test." ]
            # more answers to an unclear task do not make it clear: when the
            # best still fails, ask what the prompt leaves out before stopping
            set(more): false
            set(bp): true
            if(_): {best != null} [ btget(bp): best "passed" ]
            if(_): {refine && rounds > 0 && bp = false} [
                at(m0): models 0
                btget(bcode): best "code"
                lenin_state(bstate): best
                lenin_find_question(fq): request task bcode bstate
                concat(said): "lenin: cycle " cn " found nothing better and the best still fails: back to refining"
                print(_): said
                lenin_ask(listed): m0 ssys fq
                set(nn): 0
                if(_): {listed != null} [
                    lenin_subtasks(new): listed reqs
                    len(nn): new
                ]
                if(_): {nn > 0} [
                    set(i): 0
                    while(_): {i < nn} [
                        at(t): new i
                        push(_): reqs t
                        concat(task_notes): task_notes "- " t " (cycle " cn ", the best still failing)" nl
                        set(i): {i + 1}
                    ]
                    lenin_fold(task): task new
                    concat(rp): sep "refine_cycle" cn ".md"
                    writefile(_): rp task
                    concat(tp): sep "tasks.md"
                    writefile(_): tp task_notes
                    str_from_int(ns): nn
                    concat(said): "lenin: refining added " ns " sub-tasks: the centrifuge goes on with the new prompt"
                    print(_): said
                    set(stale): 0
                    set(more): true
                ]
                else(_): [ concat(why): why " Refining found nothing the prompt leaves out." ]
            ]
            if(_): {more = false} [
                set(stopped): why
                concat(said): "lenin: " stopped
                print(_): said
                set(go): false
            ]
        ]
        set(c): {c + 1}
    ]
    len(ncand): all
    if(_): {ncand = 0} [
        print(_): "lenin: no model answered: no result"
        lenin_record(_): args all missed null "none"
        return(r): r
    ]
    # 4. the extract
    set(how): "measured: the candidate that passes its test and is best by the criterion"
    if(_): {holdout != ""} [ set(how): "measured: the candidate that passes its test and the hidden one, and is best by the criterion" ]
    if(_): {score != ""} [ set(how): "measured: the candidate that passes, then scores highest on the suite, then is best by the criterion" ]
    if(_): {measured = false} [
        lenin_vote(voted): models all task
        set(how): "by the models' vote: nothing was run, so nothing here is shown to work"
        if(_): {voted != null} [ set(best): voted ]
        else(_): [ set(how): "the smallest answer: nothing was run and no model voted" ]
    ]
    btget(bestpassed): best "passed"
    btget(bestcode): best "code"
    btget(bestmodel): best "model"
    btget(bestcycle): best "cycle"
    concat(bestpath): sep "best" ext
    writefile(_): bestpath bestcode
    # the classic solution, measured the same way
    set(base): null
    set(base_state): "none"
    if(_): {baseline != ""} [
        lenin_read(basecode): baseline
        if(_): {basecode = null} [
            concat(said): "lenin: cannot read the baseline " baseline
            print(_): said
        ]
        else(_): [
            concat(baselog): sep "baseline.log"
            lenin_measure(base): "baseline" baseline basecode test score holdout baselog window
        ]
    ]
    # the report
    str_from_int(bc): bestcycle
    concat(rep): "# Lenin's report" nl nl "Criterion: " criteria nl "Method: " method nl "Chosen: " how nl nl "| cycle | model | state | bytes | runs/s | score |" nl "|---|---|---|---|---|---|" nl
    set(i): 0
    while(_): {i < ncand} [
        at(x): all i
        btget(xc): x "cycle"
        btget(xm): x "model"
        lenin_describe(d): x
        str_from_int(xcs): xc
        concat(rep): rep "| " xcs " | " xm " | " d " |" nl
        set(i): {i + 1}
    ]
    if(_): {bestpassed = false} [
        concat(rep): rep nl "No candidate passed its test: the one in best" ext " does not work." nl
    ]
    else(_): [ concat(rep): rep nl "Best: cycle " bc ", " bestmodel "." nl ]
    if(_): {stopped != ""} [ concat(rep): rep stopped nl ]
    # what the test the models saw let through
    set(hid): 0
    set(i): 0
    while(_): {i < ncand} [
        at(x): all i
        btget(xh): x "hidden" "none"
        if(_): {xh = "FAILED"} [ set(hid): {hid + 1} ]
        set(i): {i + 1}
    ]
    if(_): {holdout != ""} [
        str_from_int(hs): hid
        concat(rep): rep "Hidden test: " hs " of the answers passed the test the models saw and failed the hidden one." nl
    ]
    if(_): {base != null} [
        lenin_describe(bd): base
        concat(rep): rep nl "Baseline, " baseline ": " bd nl
        lenin_better(wins): best base criteria
        if(_): wins [
            set(base_state): "beaten"
            concat(rep): rep "The best candidate beats the baseline on this test, by " criteria ". That is one task and one test." nl
        ]
        else(_): [
            set(base_state): "stands"
            concat(rep): rep "The baseline stands: no candidate beat it, by " criteria "." nl
        ]
    ]
    concat(path): sep "report.md"
    writefile(_): path rep
    print(_): rep
    lenin_record(_): args all missed best base_state
    set(r): 0
    if(_): {bestpassed = false} [ set(r): 1 ]
]

lenin_usage(r): [
    set(r): 2
    print(_): "usage: lenin --models FILE [--dir DIR] [--cycles N] [--criteria speed|size]"
    print(_): "             [--method rounds|chain|enrich]"
    print(_): "             [--test COMMAND] [--score COMMAND] [--ext .EXT] [--baseline FILE]"
    print(_): "             [--window SECONDS] [--refine N] [--no-refine] [--holdout COMMAND]"
    print(_): "             [--patience N] [--target SCORE] [--budget CALLS] [--direct]"
    print(_): "             [--task TEXT] [--tasks FILE] [--prompt-file FILE] [prompt ...]"
    print(_): "             [--history FILE] [--no-history]"
    print(_): "       lenin --stats [--history FILE]"
    print(_): "--models: a file of lines: provider model KEY_ENV [url]; KEY_ENV - for no key"
    print(_): "--test: a command that exits 0 when a candidate works; {file} is the candidate"
    print(_): "--score: a test suite that prints, last, how many of its checks {file} passes"
]

# the sub-tasks of a file: its lines, without a leading - or *
lenin_task_file(r): text [
    vec(r): ""
    lenin_lines(lines): text
    len(n): lines
    set(i): 0
    while(_): {i < n} [
        at(line): lines i
        str_trim(line): line
        len(ln): line
        if(_): {ln > 1} [
            slice(head): line 0 2
            if(_): {head = "- " || head = "* "} [
                slice(line): line 2 {ln - 2}
                str_trim(line): line
            ]
        ]
        if(_): {line != ""} [ push(_): r line ]
        set(i): {i + 1}
    ]
]

lenin_main(r): argv [
    btree(args):
    btput(_): args "criteria" "size"
    btput(_): args "method" "rounds"
    btput(_): args "dir" "lenin-out"
    btput(_): args "cycles" 2
    btput(_): args "test" ""
    btput(_): args "ext" ".txt"
    btput(_): args "baseline" ""
    btput(_): args "window" 3
    btput(_): args "refine" true
    btput(_): args "refine_rounds" 1
    btput(_): args "score" ""
    btput(_): args "holdout" ""
    btput(_): args "patience" 1
    btput(_): args "target" -1
    btput(_): args "budget" -1
    vec(tasks): ""
    set(modelfile): ""
    set(task): ""
    set(histfile): ""
    set(keep_history): true
    set(stats): false
    len(n): argv
    set(i): 0
    while(_): {i < n} [
        at(a): argv i
        set(more): {i + 1 < n}
        set(value): ""
        if(_): more [ at(value): argv {i + 1} ]
        set(took): more
        len(len_a): a
        if(_): {a = "--models"} [ set(modelfile): value ]
        elif(_): {a = "--dir"} [ btput(_): args "dir" value ]
        elif(_): {a = "--criteria"} [ btput(_): args "criteria" value ]
        elif(_): {a = "--method"} [ btput(_): args "method" value ]
        elif(_): {a = "--test"} [ btput(_): args "test" value ]
        elif(_): {a = "--score"} [ btput(_): args "score" value ]
        elif(_): {a = "--holdout"} [ btput(_): args "holdout" value ]
        elif(_): {a = "--patience" || a = "--target" || a = "--budget"} [
            str_to_number(v): value
            str_trunc(v): v
            slice(key): a 2 {len_a - 2}
            btput(_): args key v
        ]
        elif(_): {a = "--task"} [ push(_): tasks value ]
        elif(_): {a = "--tasks"} [
            lenin_read(text): value
            if(_): {text = null} [
                concat(m): "lenin: cannot read " value
                print(_): m
                set(r): 2
                return(r): r
            ]
            lenin_task_file(more_tasks): text
            len(nmt): more_tasks
            set(k): 0
            while(_): {k < nmt} [
                at(t): more_tasks k
                push(_): tasks t
                set(k): {k + 1}
            ]
        ]
        elif(_): {a = "--refine"} [
            str_to_number(v): value
            str_trunc(v): v
            btput(_): args "refine_rounds" v
            if(_): {v < 1} [ btput(_): args "refine" false ]
        ]
        elif(_): {a = "--ext"} [ btput(_): args "ext" value ]
        elif(_): {a = "--baseline"} [ btput(_): args "baseline" value ]
        elif(_): {a = "--history"} [ set(histfile): value ]
        elif(_): {a = "--cycles"} [
            str_to_number(v): value
            str_trunc(v): v
            btput(_): args "cycles" v
        ]
        elif(_): {a = "--window"} [
            str_to_number(v): value
            str_trunc(v): v
            btput(_): args "window" v
        ]
        elif(_): {a = "--prompt-file"} [
            lenin_read(task): value
            if(_): {task = null} [
                concat(m): "lenin: cannot read " value
                print(_): m
                set(r): 2
                return(r): r
            ]
        ]
        else(_): [
            set(took): false
            if(_): {a = "--no-refine"} [ btput(_): args "refine" false ]
            elif(_): {a = "--no-history"} [ set(keep_history): false ]
            elif(_): {a = "--direct"} [ btput(_): args "direct" true ]
            elif(_): {a = "--stats"} [ set(stats): true ]
            elif(_): {a = "--help" || a = "-h"} [
                lenin_usage(r):
                return(r): r
            ]
            elif(_): {task = ""} [ set(task): a ]
            else(_): [ concat(task): task " " a ]
        ]
        set(i): {i + 1}
        if(_): took [ set(i): {i + 1} ]
    ]
    if(_): {histfile = ""} [ lenin_history_path(histfile): ]
    if(_): stats [
        lenin_stats(r): histfile
        return(r): r
    ]
    if(_): keep_history [ btput(_): args "history" histfile ]
    btget(criteria): args "criteria"
    btget(cycles): args "cycles"
    btget(method): args "method"
    btput(_): args "tasks" tasks
    if(_): {modelfile = "" || task = "" || cycles < 1 || (criteria != "speed" && criteria != "size") || (method != "rounds" && method != "chain" && method != "enrich")} [
        lenin_usage(r):
        return(r): r
    ]
    lenin_load_models(models): modelfile
    set(nm): 0
    if(_): {models != null} [ len(nm): models ]
    if(_): {nm = 0} [
        concat(m): "lenin: no models in " modelfile
        print(_): m
        set(r): 2
        return(r): r
    ]
    btget(test): args "test"
    btget(score): args "score"
    if(_): {criteria = "speed" && test = "" && score = ""} [
        print(_): "lenin: speed needs --test or --score: there is nothing to time without one"
        set(r): 2
        return(r): r
    ]
    btget(holdout): args "holdout"
    btget(patience): args "patience"
    btget(target): args "target"
    if(_): {holdout != "" && test = "" && score = ""} [
        print(_): "lenin: --holdout goes with --test or --score: it hides a test, it is not the only one"
        set(r): 2
        return(r): r
    ]
    if(_): {target >= 0 && score = ""} [
        print(_): "lenin: --target is a --score: give the suite too"
        set(r): 2
        return(r): r
    ]
    if(_): {patience < 1} [
        print(_): "lenin: --patience is 1 or more cycles"
        set(r): 2
        return(r): r
    ]
    if(_): {method = "enrich" && test = "" && score = ""} [
        print(_): "lenin: enrich needs --test or --score: without one nothing can be better"
        set(r): 2
        return(r): r
    ]
    btput(_): args "models" models
    btput(_): args "prompt" task
    lenin_run(r): args
]

$ifdef __MAIN__
init(ret): arg_count arg_values [
    vec(argv): ""
    set(i): 0
    while(_): {i < arg_count} [
        at(a): arg_values i
        push(_): argv a
        set(i): {i + 1}
    ]
    lenin_main(ret): argv
]
$endif
