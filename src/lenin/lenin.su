    set(i): {i - 1}
    while(_): {i > 0} [
        byte(b): path i
        if(_): {b = 47 || b = 92} [
            slice(parent): path 0 i
            is_dir(there): parent
            if(_): {there = 0} [ make_dir(_): parent ]
            return(r): r
        ]
        set(i): {i - 1}
    ]
]

