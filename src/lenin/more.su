        str_starts(d1): t "import "
        str_starts(d2): t "from "
        str_starts(d3): t "#include"
        str_starts(d4): t "$include"
        str_starts(d5): t "use "
        str_starts(d6): t "using "
        str_contains(d7): t "require("
        if(_): {d1 || d2 || d3 || d4 || d5 || d6 || d7} [ set(deps): {deps + 1} ]
        set(i): {i + 1}
    ]
    re_all(kw): "(^|[^A-Za-z0-9_])(if|elif|for|while|case|catch|except)[^A-Za-z0-9_]" code
    re_all(ands): "&&|[|][|]" code
    set(cx): 1
    typeof(kt): kw
    if(_): {kt = "vector"} [
        len(nk): kw
        set(cx): {cx + nk}
    ]
    typeof(andt): ands
    if(_): {andt = "vector"} [
        len(na): ands
        set(cx): {cx + na}
    ]
    btput(_): c "lines" nonblank
    btput(_): c "deps" deps
    btput(_): c "complexity" cx
]

# the share of lines two texts have in common, 0 to 1
lenin_similar(r): a b [
    btree(sa):
    btree(sb):
    lenin_lines(la): a
    lenin_lines(lb): b
    len(na): la
    set(i): 0
    while(_): {i < na} [
        at(l): la i
        str_trim(t): l
        if(_): {t != ""} [ btput(_): sa t true ]
        set(i): {i + 1}
    ]
    len(nb): lb
    set(i): 0
    while(_): {i < nb} [
        at(l): lb i
        str_trim(t): l
        if(_): {t != ""} [ btput(_): sb t true ]
        set(i): {i + 1}
    ]
    btkeys(ka): sa
    btkeys(kb): sb
    len(nka): ka
    len(nkb): kb
    set(both): 0
    set(i): 0
    while(_): {i < nka} [
        at(k): ka i
        bthas(h): sb k
        if(_): h [ set(both): {both + 1} ]
        set(i): {i + 1}
    ]
    set(union): {nka + nkb - both}
    set(r): 1.0
    if(_): {union > 0} [ set(r): {both * 1.0 / union} ]
]

lenin_more_measure(r): cand all args [
    set(r): 0
    lenin_more_metrics(_): cand
