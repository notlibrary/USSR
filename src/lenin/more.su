]

lenin_median(r): v [
    vec(s): ""
    len(n): v
    set(i): 0
    while(_): {i < n} [
        at(x): v i
        push(_): s x
        set(i): {i + 1}
    ]
    list_sort(s): s
    set(r): 0
    if(_): {n = 0} [ return(r): r ]
    set(h): {n / 2}
    str_trunc(h): h
    if(_): {n % 2 = 1} [ at(r): s h ]
    else(_): [
        at(a): s {h - 1}
        at(b): s h
        set(r): {(a + b) / 2.0}
    ]
]

# (largest - smallest) / median: how far one timing may be from another
lenin_spread(r): v [
    set(r): 0
    len(n): v
    if(_): {n < 2} [ return(r): r ]
    at(lo): v 0
    set(hi): lo
    set(i): 0
    while(_): {i < n} [
        at(x): v i
        if(_): {x < lo} [ set(lo): x ]
        if(_): {x > hi} [ set(hi): x ]
        set(i): {i + 1}
    ]
    lenin_median(m): v
    if(_): {m > 0} [ set(r): {(hi - lo) * 1.0 / m} ]
]

lenin_more_bench(r): cand args repeat [
    set(r): 0
    btget(passed): cand "passed"
    btget(criteria): args "criteria" "size"
    lenin_more_uses_speed(sp): criteria
    btget(window): args "window" 0
    if(_): {passed = false || sp = false || window <= 0} [ return(r): r ]
    btget(test): args "test" ""
    btget(score): args "score" ""
    set(timed): test
    if(_): {test = ""} [ set(timed): score ]
    btget(path): cand "path"
    concat(log): path ".bench.log"
    vec(rates): ""
    btget(r0): cand "rate"
    push(_): rates r0
    set(k): 1
    while(_): {k < repeat} [
        time(t0):
        set(runs): 0
        set(now): t0
        while(_): {now - t0 < window} [
            lenin_check(st): timed path log
            if(_): {st != 0} [
                btput(_): cand "passed" false
                btput(_): cand "log" "it failed when timed again: it does not always pass"
                return(r): r
            ]
            set(runs): {runs + 1}
            time(now):
        ]
        push(_): rates {runs / (now - t0)}
        set(k): {k + 1}
    ]
    lenin_median(m): rates
    lenin_spread(s): rates
    btput(_): cand "rate" m
    btput(_): cand "spread" s
    btput(_): cand "rates" rates
]

# a beats b by criteria other than size and speed alone: 1 yes, 0 no, -1
# undecided (lenin_better goes on)
lenin_more_better(r): a b criteria [
    set(r): -1
    btget(da): a "dup" false
    btget(db): b "dup" false
    if(_): {da != db} [
        set(r): 0
        if(_): db [ set(r): 1 ]
        return(r): r
    ]
    if(_): {criteria = "size" || criteria = "speed"} [ return(r): r ]
    if(_): {criteria = "lines" || criteria = "complexity" || criteria = "deps"} [
        btget(va): a criteria 0
        btget(vb): b criteria 0
        if(_): {va != vb} [
            set(r): 0
            if(_): {va < vb} [ set(r): 1 ]
        ]
        return(r): r
    ]
    lenin_weights(w): criteria
    if(_): {w = null} [ return(r): r ]
    btkeys(ks): w
    set(sum): 0.0
    len(n): ks
    set(i): 0
    while(_): {i < n} [
        at(k): ks i
        btget(wt): w k
        set(key): k
        if(_): {k = "speed"} [ set(key): "rate" ]
        btget(va): a key 0
        btget(vb): b key 0
        set(big): va
        if(_): {vb > big} [ set(big): vb ]
        if(_): {big > 0} [
            if(_): {k = "speed"} [ set(sum): {sum + wt * (va - vb) / big} ]
            else(_): [ set(sum): {sum + wt * (vb - va) / big} ]
        ]
        set(i): {i + 1}
    ]
    if(_): {sum > 0.000001} [ set(r): 1 ]
    elif(_): {sum < -0.000001} [ set(r): 0 ]
]

