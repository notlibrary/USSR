    if(_): {keep < 2} [ set(keep): 2 ]
    set(head): {keep * 2 / 3}
    str_trunc(head): head
    set(tail): {keep - head}
    slice(a): text 0 head
    slice(b): text {tl - tail} tail
    concat(r): a mark b
]

