# more.su - Lenin refine pass 1: what the centrifuge, the measuring and the
# report do beyond 0.1. lenin.su includes it and calls in at a few points.
#
# Flags (lenin_more_arg):
#   --lang python|ussr|c|js|sh|ruby   --ext, a --test and the language in
#                                     the system prompt
#   --criteria size:0.3,speed:0.7     weighted; also lines, complexity, deps
#   --beam K        the next model sees the top K answers, not only the best
#   --mutate        each model gets a change to try ("make it shorter")
#   --crossover     after a cycle a model merges the two best that pass
#   --diverse       an answer too like an earlier one loses ties
#   --adaptive      models in order of their wins in the history
#   --repeat N      the speed is the median of N timings, with its spread
#   --mutants N     N copies of the best, each without one line, run through
#                   --test: the ones that pass show where the test is weak
#   --explain       a model says why the winner beat the runner-up
#   --sandbox       tests run with HOME in DIR/sandbox
#   --prices FILE   "model input output" per million tokens: the report
#                   gives the tokens and what they cost; --money X stops
#                   the run there
#   --retries N [--retry-ms MS]   a failed call again, with backoff
#   --fake DIR      every model answers from DIR/<model>.json (no network)
#   --resume        answers already in --dir are reused, not asked again
#   --multi         every fenced block of an answer is kept, as files in
#                   cycleN_model.ext.files/ ({dir} in a test)
#   --json          answers are a JSON envelope {files, notes, assumptions}
#   --context N     what a model is sent is cut to N characters
#   --save-prompt NAME / --use-prompt NAME[@V]   a versioned prompt library
#   --dry-run       prints the models, calls, cost and prompts; calls nobody
#   --config FILE   key = value lines as flags (./lenin.conf by default;
#                   --no-config skips it)
# models.conf lines may end in key=value words: role=refine|draft|critic|
#   judge, max_tokens=N, timeout=S.
# Every run also writes report.html, run.json and each reply, beside
# report.md.
$once
$include "../libs/strings.su"
$include "../libs/json.su"
$include "../libs/lists.su"

global(_): lenin_opts
global(_): lenin_roles
global(_): lenin_ledger
global(_): lenin_prices
global(_): lenin_raw

lenin_opt(r): key default [
    set(r): default
    if(_): {lenin_opts != null} [ btget(r): lenin_opts key default ]
]

# --- flags

# 0: not one of these; 1: a flag on its own; 2: a flag and its value
lenin_more_arg(r): a value more args [
    set(r): 0
    str_starts(dash): a "--"
    if(_): {dash = false} [ return(r): r ]
    len(al): a
    slice(key): a 2 {al - 2}
    lenin_replace(key): key "-" "_"
    vec(valued): ""
    str_split(valued): "lang beam repeat prices money retries retry_ms fake save_prompt use_prompt context mutants config" " "
    vec(flags): ""
    str_split(flags): "mutate crossover adaptive diverse sandbox dry_run multi json explain resume no_config" " "
    lenin_has(isv): valued key
    lenin_has(isf): flags key
    if(_): {isv && more} [
        set(v): value
        vec(nums): ""
        str_split(nums): "beam repeat retries retry_ms context mutants money" " "
        lenin_has(isn): nums key
        if(_): isn [
            str_to_number(v): value
            typeof(vt): v
            if(_): {vt != "integer" && vt != "real"} [ set(v): 0 ]
            if(_): {key != "money"} [ str_trunc(v): v ]
        ]
        btput(_): args key v
        set(r): 2
    ]
    elif(_): isf [
        btput(_): args key true
        set(r): 1
    ]
]

# the config file's lines as flags, before the command line's own
lenin_more_config(r): argv [
    set(path): ""
    set(skip): false
    len(n): argv
    set(i): 0
    while(_): {i < n} [
        at(a): argv i
        if(_): {a = "--config" && i + 1 < n} [ at(path): argv {i + 1} ]
        if(_): {a = "--no-config"} [ set(skip): true ]
        set(i): {i + 1}
    ]
    if(_): {path = "" && skip = false} [
        file_exists(here): "lenin.conf"
        if(_): here [ set(path): "lenin.conf" ]
    ]
    vec(r): ""
    if(_): {path != ""} [
        lenin_read(text): path
        if(_): {text != null} [
            lenin_lines(lines): text
            len(nl): lines
            set(i): 0
            while(_): {i < nl} [
                at(l): lines i
                str_trim(l): l
                str_starts(c): l "#"
                if(_): {l != "" && c = false} [
                    str_find(eq): l "=" 0
                    if(_): {eq > 0} [
                        slice(k): l 0 eq
                        str_trim(k): k
                        len(ll): l
                        slice(v): l {eq + 1} {ll - eq - 1}
                        str_trim(v): v
                        lenin_replace(k): k "_" "-"
                        concat(flag): "--" k
                        push(_): r flag
                        push(_): r v
                    ]
                    else(_): [
                        lenin_replace(l): l "_" "-"
                        concat(flag): "--" l
                        push(_): r flag
                    ]
                ]
                set(i): {i + 1}
            ]
        ]
    ]
    set(i): 0
    while(_): {i < n} [
        at(a): argv i
        push(_): r a
        set(i): {i + 1}
    ]
]

lenin_more_preset(r): lang [
    # [ext test]
    vec(r): ""
    btree(p):
    btput(_): p "python" ".py|python {file}"
    btput(_): p "ussr" ".su|ussr {file}"
    btput(_): p "js" ".js|node {file}"
    btput(_): p "sh" ".sh|sh {file}"
    btput(_): p "ruby" ".rb|ruby {file}"
    btput(_): p "c" ".c|"
    btget(v): p lang ""
    if(_): {v = ""} [ return(r): r ]
    str_split(r): v "|"
]

# after the flags: presets and the prompt library; the task to run
lenin_more_post(r): args task [
    set(r): task
    btget(lang): args "lang" ""
    if(_): {lang != ""} [
        lenin_more_preset(p): lang
        len(np): p
        if(_): {np = 2} [
            at(e): p 0
            at(t): p 1
            btget(ext): args "ext" ".txt"
            if(_): {ext = ".txt"} [ btput(_): args "ext" e ]
            btget(test): args "test" ""
            btget(score): args "score" ""
            if(_): {test = "" && score = "" && t != ""} [ btput(_): args "test" t ]
        ]
    ]
    btget(use): args "use_prompt" ""
    if(_): {use != ""} [
        set(name): use
        set(ver): 0
        str_find(atp): use "@" 0
        if(_): {atp > 0} [
            slice(name): use 0 atp
            len(ul): use
            slice(vs): use {atp + 1} {ul - atp - 1}
            str_to_number(ver): vs
        ]
        lenin_prompt_load(text): name ver
        if(_): {text != null} [
            set(r): text
            btput(_): args "refine" false
        ]
        else(_): [
            concat(m): "lenin: no prompt " use " in the library"
            print(_): m
        ]
    ]
]

lenin_more_criteria_ok(r): criteria [
    vec(known): ""
    str_split(known): "size speed lines complexity deps" " "
    lenin_has(r): known criteria
    if(_): r [ return(r): r ]
    lenin_weights(w): criteria
    set(r): {w != null}
]

# "size:0.3,speed:0.7" -> btree of weights, or null
lenin_weights(r): criteria [
    set(r): null
    str_find(colon): criteria ":" 0
    if(_): {colon < 0} [ return(r): r ]
    vec(known): ""
    str_split(known): "size speed lines complexity deps" " "
    btree(w):
    str_split(parts): criteria ","
    len(n): parts
    set(i): 0
    while(_): {i < n} [
        at(p): parts i
        str_split(kv): p ":"
        len(nk): kv
        if(_): {nk != 2} [ return(r): r ]
        at(k): kv 0
        str_trim(k): k
        at(v): kv 1
        str_to_number(x): v
        typeof(xt): x
        lenin_has(good): known k
        if(_): {good = false || (xt != "integer" && xt != "real")} [ return(r): r ]
        btput(_): w k x
        set(i): {i + 1}
    ]
    set(r): w
]

lenin_more_uses_speed(r): criteria [
    set(r): {criteria = "speed"}
    if(_): r [ return(r): r ]
    lenin_weights(w): criteria
    if(_): {w != null} [ bthas(r): w "speed" ]
]

# --- models: roles, options, fakes, order

# the key=value words at the end of a models.conf line -> [words opts]
lenin_more_model_words(r): w [
    vec(r): ""
    vec(kept): ""
    btree(opts):
    len(n): w
    set(i): 0
    while(_): {i < n} [
        at(x): w i
        str_find(eq): x "=" 0
        str_contains(isurl): x "://"
        if(_): {i >= 3 && eq > 0 && isurl = false} [
            slice(k): x 0 eq
            len(xl): x
            slice(v): x {eq + 1} {xl - eq - 1}
            btput(_): opts k v
        ]
        else(_): [ push(_): kept x ]
        set(i): {i + 1}
    ]
    push(_): r kept
    push(_): r opts
]

lenin_more_model_opt(r): m key default [
    set(r): default
    len(n): m
    if(_): {n >= 5} [
        at(o): m 4
        btget(r): o key default
    ]
]

# the models of a run: fakes, roles, the history's order; who drafts
lenin_more_models(r): models args [
    set(lenin_opts): args
    btree(lg):
    set(lenin_ledger): lg
    set(lenin_prices): null
    btget(pf): args "prices" ""
    if(_): {pf != ""} [ lenin_load_prices(lenin_prices): pf ]
    btget(fake): args "fake" ""
    set(all): models
    if(_): {fake != ""} [ lenin_fake_models(all): models fake ]
    btree(roles):
    vec(judges): ""
    vec(r): ""
    len(n): all
    set(i): 0
    while(_): {i < n} [
        at(m): all i
        lenin_more_model_opt(role): m "role" ""
        if(_): {role = "" || role = "draft" || role = "any"} [ push(_): r m ]
        else(_): [
            bthas(had): roles role
            if(_): {had = false} [ btput(_): roles role m ]
            if(_): {role = "judge"} [ push(_): judges m ]
        ]
        set(i): {i + 1}
    ]
    btput(_): roles "judges" judges
    set(lenin_roles): roles
    len(nr): r
    if(_): {nr = 0} [ set(r): all ]
    btget(adaptive): args "adaptive" false
    if(_): adaptive [
        btget(hist): args "history" ""
        if(_): {hist = ""} [ lenin_history_path(hist): ]
        lenin_more_adapt(r): r hist
    ]
    btput(_): args "models" r
]

lenin_fake_models(r): models dir [
    vec(r): ""
    getcwd(cwd):
    lenin_replace(d): dir "\\" "/"
    byte(b0): d 0
    set(abs): {b0 = 47}
    len(dl): d
    if(_): {dl > 1} [
        byte(b1): d 1
        if(_): {b1 = 58} [ set(abs): true ]
    ]
    if(_): {abs = false} [
        lenin_replace(cwd): cwd "\\" "/"
        concat(d): cwd "/" d
    ]
    byte(c0): d 0
    set(u): "file:///"
    if(_): {c0 = 47} [ set(u): "file://" ]
    len(n): models
    set(i): 0
    while(_): {i < n} [
        at(m): models i
        at(name): m 1
        lenin_safe(safe): name
        concat(url): u d "/" safe ".json"
        vec(f): ""
        push(_): f "openai"
        push(_): f name
        push(_): f "-"
        push(_): f url
        len(ml): m
        if(_): {ml >= 5} [
            at(o): m 4
            push(_): f o
        ]
        push(_): r f
        set(i): {i + 1}
    ]
]

lenin_more_role(r): role fallback [
    set(r): fallback
    if(_): {lenin_roles != null} [ btget(r): lenin_roles role fallback ]
]

lenin_more_judges(r): models [
    set(r): models
    lenin_more_role(j): "judges" null
    if(_): {j != null} [
        len(n): j
        if(_): {n > 0} [ set(r): j ]
    ]
]

# wins per model from a history file: btree name -> [wins answers]
lenin_win_rates(r): path [
    btree(r):
    lenin_read(text): path
    if(_): {text = null} [ return(r): r ]
    lenin_lines(lines): text
    len(n): lines
    set(i): 0
    while(_): {i < n} [
        at(l): lines i
        lenin_fields(f): l
        len(nf): f
        if(_): {nf >= 8} [
            at(kind): f 0
            if(_): {kind = "answer"} [
                at(name): f 3
                at(won): f 7
                vec(z): ""
                push(_): z 0
                push(_): z 0
                btget(e): r name z
                at(w): e 0
                at(a): e 1
                if(_): {won = "1"} [ set(w): {w + 1} ]
                vec(e2): ""
                push(_): e2 w
                push(_): e2 {a + 1}
                btput(_): r name e2
            ]
        ]
        set(i): {i + 1}
    ]
]

# models by (wins + 1) / (answers + 2), most first; a tie keeps the order
lenin_more_adapt(r): models path [
    lenin_win_rates(rates): path
    vec(r): ""
    vec(left): ""
    len(n): models
    set(i): 0
    while(_): {i < n} [
        at(m): models i
        push(_): left m
        set(i): {i + 1}
    ]
    vec(z): ""
    push(_): z 0
    push(_): z 0
    while(_): {n > 0} [
        set(bi): 0
        set(bv): -1
        set(i): 0
        while(_): {i < n} [
            at(m): left i
            at(name): m 1
            btget(e): rates name z
            at(w): e 0
            at(a): e 1
            set(v): {(w + 1.0) / (a + 2.0)}
            if(_): {v > bv} [
                set(bv): v
                set(bi): i
            ]
            set(i): {i + 1}
        ]
        at(m): left bi
        push(_): r m
        vec(rest): ""
        set(i): 0
        while(_): {i < n} [
            if(_): {i != bi} [
                at(x): left i
                push(_): rest x
            ]
            set(i): {i + 1}
        ]
        set(left): rest
        set(n): {n - 1}
    ]
]

# --- money

lenin_load_prices(r): path [
    btree(r):
    lenin_read(text): path
    if(_): {text = null} [ return(r): r ]
    lenin_lines(lines): text
    len(n): lines
    set(i): 0
    while(_): {i < n} [
        at(l): lines i
        lenin_words(w): l
        len(nw): w
        if(_): {nw >= 3} [
            at(name): w 0
            byte(b): name 0
            if(_): {b != 35} [
                at(pi): w 1
                at(po): w 2
                str_to_number(xi): pi
                str_to_number(xo): po
                vec(e): ""
                push(_): e xi
                push(_): e xo
                btput(_): r name e
            ]
        ]
        set(i): {i + 1}
    ]
]

# a call's tokens, guessed at four bytes each
lenin_more_account(r): m system question reply [
    set(r): 0
    if(_): {lenin_ledger = null} [
        btree(lg):
        set(lenin_ledger): lg
    ]
    at(name): m 1
    len(a): system
    len(b): question
    set(tin): {(a + b + 3) / 4}
    str_trunc(tin): tin
    set(tout): 0
    if(_): {reply != null} [
        len(c): reply
        set(tout): {(c + 3) / 4}
        str_trunc(tout): tout
    ]
    vec(z): ""
    push(_): z 0
    push(_): z 0
    push(_): z 0
    btget(e): lenin_ledger name z
    at(k): e 0
    at(i0): e 1
    at(o0): e 2
    vec(e2): ""
    push(_): e2 {k + 1}
    push(_): e2 {i0 + tin}
    push(_): e2 {o0 + tout}
    btput(_): lenin_ledger name e2
]

# what tokens cost by the prices file; -1 when the model has no price
lenin_cost(r): name tin tout [
    set(r): -1
    if(_): {lenin_prices = null} [ return(r): r ]
    btget(p): lenin_prices name null
    if(_): {p = null} [ return(r): r ]
    at(pi): p 0
    at(po): p 1
    set(r): {(tin * pi + tout * po) / 1000000.0}
]

lenin_money_spent(r): [
    set(r): 0.0
    if(_): {lenin_ledger = null} [ return(r): r ]
    btkeys(ks): lenin_ledger
    len(n): ks
    set(i): 0
    while(_): {i < n} [
        at(k): ks i
        btget(e): lenin_ledger k
        at(ti): e 1
        at(to): e 2
        lenin_cost(c): k ti to
        if(_): {c > 0} [ set(r): {r + c} ]
        set(i): {i + 1}
    ]
]

lenin_more_over_money(r): [
    set(r): false
    lenin_opt(cap): "money" 0
    if(_): {cap > 0} [
        lenin_money_spent(s):
        set(r): {s >= cap}
    ]
]

# --- asking

lenin_more_ask(r): m system question file [
    set(lenin_raw): false
    lenin_opt(resume): "resume" false
    if(_): resume [
        file_exists(had): file
        if(_): had [
            readfile(r): file
            set(lenin_raw): true
            concat(said): "lenin:   resumed from " file
            print(_): said
            return(r): r
        ]
    ]
    lenin_ask(r): m system question
    lenin_opt(retries): "retries" 0
    lenin_opt(ms): "retry_ms" 1000
    set(k): 0
    while(_): {r = null && k < retries} [
        lenin_spent(spent):
        if(_): spent [ set(k): retries ]
        else(_): [
            set(wait): ms
            set(j): 0
            while(_): {j < k} [
                set(wait): {wait * 2}
                set(j): {j + 1}
            ]
            sleep(_): wait
            at(mname): m 1
            concat(said): "lenin:   " mname " again, after a failed call"
            print(_): said
            lenin_ask(r): m system question
            set(k): {k + 1}
        ]
    ]
    if(_): {r != null} [
        concat(rp): file ".reply.md"
        writefile(_): rp r
    ]
]

# the code of a reply: as it was when resumed, a JSON envelope, or the
# first fenced block (all of them kept with --multi)
lenin_more_code(r): reply file [
    if(_): {lenin_raw = true} [
        set(lenin_raw): false
        set(r): reply
        return(r): r
    ]
    lenin_opt(js): "json" false
    if(_): js [
        lenin_envelope(env): reply
        if(_): {env != null} [
            at(files): env 0
            at(notes): env 1
            len(nf): files
            if(_): {nf > 0} [
                at(f0): files 0
                at(r): f0 1
                if(_): {nf > 1} [ lenin_write_files(_): files file ]
                if(_): {notes != ""} [
                    concat(np): file ".notes.md"
                    writefile(_): np notes
                ]
                return(r): r
            ]
        ]
    ]
    lenin_code(r): reply
    lenin_opt(multi): "multi" false
    if(_): multi [
        lenin_files(fs): reply
        len(nf): fs
        if(_): {nf > 1} [ lenin_write_files(_): fs file ]
    ]
]

# a JSON envelope -> [[name code]...] and notes, or null
lenin_envelope(r): reply [
    set(r): null
    str_trim(t): reply
    str_starts(fence): t "```"
    if(_): fence [ lenin_code(t): t ]
    str_trim(t): t
    str_starts(obj): t "{"
    if(_): {obj = false} [ return(r): r ]
    json_parse(v): t
    typeof(vt): v
    if(_): {vt != "btree"} [ return(r): r ]
    btget(files): v "files" null
    typeof(ft): files
    vec(out): ""
    if(_): {ft = "btree"} [
        btkeys(ks): files
        len(n): ks
        set(i): 0
        while(_): {i < n} [
            at(k): ks i
            btget(c): files k
            vec(e): ""
            push(_): e k
            push(_): e c
            push(_): out e
            set(i): {i + 1}
        ]
    ]
    btget(notes): v "notes" ""
    typeof(nt): notes
    if(_): {nt != "string"} [ set(notes): "" ]
    btget(asm): v "assumptions" null
    typeof(asmt): asm
    if(_): {asmt = "vector"} [
        len(na): asm
        set(i): 0
        chr(nl): 10
        while(_): {i < na} [
            at(x): asm i
            concat(notes): notes nl "- assumption: " x
            set(i): {i + 1}
        ]
    ]
    vec(r): ""
    push(_): r out
    push(_): r notes
]

# every fenced block of a reply as [name code]; a name from the fence
# ("```python a.py") or the line before it ("**a.py**", "File: a.py")
lenin_files(r): reply [
    vec(r): ""
    lenin_lines(lines): reply
    len(n): lines
    set(inside): false
    set(prev): ""
    set(name): ""
    set(code): ""
    chr(nl): 10
    set(k): 0
    set(i): 0
    while(_): {i < n} [
        at(l): lines i
        str_trim(t): l
        str_starts(f): t "```"
        if(_): {f && inside = false} [
            set(inside): true
            set(code): ""
            set(k): {k + 1}
            len(tl): t
            slice(info): t 3 {tl - 3}
            lenin_words(iw): info
            set(name): ""
            len(niw): iw
            if(_): {niw > 1} [ at(name): iw 1 ]
            if(_): {niw = 1} [
                at(w0): iw 0
                str_find(dot): w0 "." 0
                if(_): {dot > 0} [ set(name): w0 ]
            ]
            if(_): {name = ""} [ lenin_file_name(name): prev ]
            if(_): {name = ""} [
                str_from_int(ks): k
                concat(name): "file" ks
            ]
        ]
        elif(_): {f && inside} [
            set(inside): false
            vec(e): ""
            push(_): e name
            push(_): e code
            push(_): r e
        ]
        elif(_): inside [ concat(code): code l nl ]
        elif(_): {t != ""} [ set(prev): t ]
        set(i): {i + 1}
    ]
]

# a file name in a line like "**src/a.py**", "File: a.py", "`a.py`:"
lenin_file_name(r): line [
    set(r): ""
    re_find(m): "([A-Za-z0-9_./-]+[.][A-Za-z0-9]+)" line
    typeof(mt): m
    if(_): {mt = "vector"} [ at(r): m 1 ]
    len(ll): line
    if(_): {ll > 80} [ set(r): "" ]
]

lenin_write_files(r): files file [
    concat(dir): file ".files"
    is_dir(there): dir
    if(_): {there = 0} [ make_dir(_): dir ]
    len(n): files
    set(r): 0
    set(i): 0
    while(_): {i < n} [
        at(e): files i
        at(name): e 0
        at(code): e 1
