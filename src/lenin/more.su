# --- the report

lenin_pareto(r): all [
    vec(r): ""
    vec(ok): ""
    len(n): all
    set(i): 0
    while(_): {i < n} [
        at(x): all i
        btget(p): x "passed"
        btget(t): x "tested"
        if(_): {p && t} [ push(_): ok x ]
        set(i): {i + 1}
    ]
    len(n): ok
    set(i): 0
    while(_): {i < n} [
        at(x): ok i
        btget(xs): x "size"
        btget(xr): x "rate"
        btget(xq): x "score" -1
        set(beaten): false
        set(j): 0
        while(_): {j < n} [
            if(_): {j != i} [
                at(y): ok j
                btget(ys): y "size"
                btget(yr): y "rate"
                btget(yq): y "score" -1
                set(noworse): {ys <= xs && yr >= xr && yq >= xq}
                set(better): {ys < xs || yr > xr || yq > xq}
                if(_): {noworse && better} [ set(beaten): true ]
            ]
            set(j): {j + 1}
        ]
        if(_): {beaten = false} [ push(_): r x ]
        set(i): {i + 1}
    ]
]

