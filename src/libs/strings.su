            set(vi): 0
            set(go): true
            while(_): go [
                byte(x): a i
                set(go): {x >= 48 && x <= 57}
                if(_): go [
                    set(vi): {vi * 10 + x - 48}
                    set(i): {i + 1}
                    set(go): {i < na}
                ]
            ]
            set(vj): 0
            set(go): true
            while(_): go [
                byte(y): b j
                set(go): {y >= 48 && y <= 57}
                if(_): go [
                    set(vj): {vj * 10 + y - 48}
                    set(j): {j + 1}
                    set(go): {j < nb}
                ]
            ]
            if(_): {vi < vj} [
                set(r): {0 - 1}
            ]
            elif(_): {vi > vj} [
                set(r): 1
            ]
        ]
        else(_): [
            if(_): {x < y} [
                set(r): {0 - 1}
            ]
            elif(_): {x > y} [
                set(r): 1
            ]
            set(i): {i + 1}
            set(j): {j + 1}
        ]
    ]
    if(_): {r = 0} [
        set(ra): {na - i}
        set(rb): {nb - j}
        if(_): {ra < rb} [
