$include "petersburg.su"

clicked(result): widget [
    settext(_): status "BUTTON CLICKED"
]

init(result): arg_count arg_values [
    createwindow(window): "Petersburg demo" 640 420
    label(title): window "Hello from USSR"
    textbox(name): window "Type here"
    checkbox(enabled): window "Enable the feature"
    listbox(options): window "FIRST|SECOND|THIRD"
    combobox(choice): window "RED|GREEN|BLUE"
    button(ok): window "OK"
    label(status): window "Waiting for input"
    on(_): ok "click" "clicked"
    pack(_): options true
    run(_):
]
