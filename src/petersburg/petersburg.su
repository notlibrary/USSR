# petersburg.su — portable OpenGL widgets for USSR.
# Handles are integers owned by the C runtime; event callbacks are definition
# names passed as strings and run as normal USSR scheduler processes.
$once

createwindow(result): title width height [
    petersburg_create_window(result): title width height
    set(petersburg_busy): 0!
]

# --- callback serialization -------------------------------------------------
# Every callback runs as its own scheduler process. Handlers that touch shared
# state bracket their work with uilock/uiunlock. The test-and-set happens in
# the callback's first scheduler slice, so it cannot be interleaved; a lock
# older than five seconds belongs to a handler that died on a runtime error
# and is taken over.
uilock(r): [
    time(_pbl_now):
    set(_pbl_held): petersburg_busy?
    while(_): {_pbl_held != 0 && _pbl_now - _pbl_held < 5} [
        sleep(_): 5
        time(_pbl_now):
        set(_pbl_held): petersburg_busy?
    ]
    set(petersburg_busy): _pbl_now!
    set(r): 0
]

uiunlock(r): [
    set(petersburg_busy): 0!
    set(r): 0
]

# True while no handler holds uilock (used by tests to wait for handlers).
uiidle(r): [
    set(_pbi_held): petersburg_busy?
    set(r): {_pbi_held = 0}
]

maximize(result): window [
    petersburg_maximize(result): window
]

# Covers the whole primary monitor with a borderless window; 1 when there
# is no monitor to cover and the window was maximized instead.
fullscreen(result): window [
    petersburg_fullscreen(result): window
]

label(result): window text [
    petersburg_create_label(result): window text
]

# The parent may be a window or a toolbar.
button(result): window text [
    petersburg_create_button(result): window text
]

# A horizontal strip; buttons created with the toolbar as their parent are
# laid out left to right at their natural width.
toolbar(result): window [
    petersburg_create_toolbar(result): window ""
]

textbox(result): window initial_text [
    petersburg_create_textbox(result): window initial_text
]

checkbox(result): window text [
    petersburg_create_checkbox(result): window text
]

listbox(result): window items [
    petersburg_create_list(result): window items
]

combobox(result): window items [
    petersburg_create_combobox(result): window items
]

image(result): window ppm_path [
    petersburg_create_image(result): window ppm_path
]

reloadimage(result): widget ppm_path [
    petersburg_reload_image(result): widget ppm_path
]

pack(result): widget expand [
    petersburg_pack(result): widget expand
]

grid(result): widget row column expand [
    petersburg_grid(result): widget row column expand
]

settext(result): widget text [
    petersburg_set_text(result): widget text
]

gettext(result): widget [
    petersburg_get_text(result): widget
]

getselection(result): widget [
    petersburg_get_selection(result): widget
]

getindex(result): widget [
    petersburg_get_index(result): widget
]

setindex(result): widget index [
    petersburg_set_index(result): widget index
]

setfocus(result): widget [
    petersburg_set_focus(result): widget
]

# Handle of the window's focused text box or list, or 0 when none has focus.
getfocus(result): window [
    petersburg_get_focus(result): window
]

getchecked(result): widget [
    petersburg_get_checked(result): widget
]

setchecked(result): widget checked [
    petersburg_set_checked(result): widget checked
]

on(result): widget event callback_name [
    petersburg_on(result): widget event callback_name
]

show(result): window [
    petersburg_show(result): window
]

close(result): window [
    petersburg_close(result): window
]

destroy(result): widget [
    petersburg_destroy(result): widget
]

run(result): [
    petersburg_run(result):
]

messagebox(result): title text [
    petersburg_message_box(result): title text
]

# --- canvas: retained vector drawing ---------------------------------------
# Coordinates are canvas-local pixels with y growing downward; numbers may be
# integers or reals. Colors are 0xRRGGBB integers. Arc angles are degrees,
# counter-clockwise as seen on screen, drawn from start to end.

canvas(result): window [
    petersburg_create_canvas(result): window
]

canvasclear(result): canvas color [
    petersburg_canvas_clear(result): canvas color
]

canvasline(result): canvas x1 y1 x2 y2 color [
    petersburg_canvas_line(result): canvas x1 y1 x2 y2 color
]

canvascircle(result): canvas cx cy radius color [
    petersburg_canvas_circle(result): canvas cx cy radius color
]

canvasarc(result): canvas cx cy radius start_angle end_angle color [
    petersburg_canvas_arc(result): canvas cx cy radius start_angle end_angle color
]

canvasrect(result): canvas x y width height color [
    petersburg_canvas_rect(result): canvas x y width height color
]

canvasfill(result): canvas x y width height color [
    petersburg_canvas_fill(result): canvas x y width height color
]

canvastext(result): canvas x y text color [
    petersburg_canvas_text(result): canvas x y text color
]

# Text at scale 1..16: each font pixel becomes a scale x scale square, so a
# character cell is 7 * scale pixels wide and 7 * scale high.
canvastextscale(result): canvas x y text color scale [
    petersburg_canvas_text_scaled(result): canvas x y text color scale
]

canvascount(result): canvas [
    petersburg_canvas_count(result): canvas
]

# --- outline fonts ------------------------------------------------------------
# TrueType files from the system (.ttf, first face of a .ttc).
# fontinfo: "Family|Style", or "" when the file is not a usable font.
fontinfo(result): path [
    petersburg_font_info(result): path
]

# A font handle (1, 2, ...), the same one for the same path; 0 if unusable.
loadfont(result): path [
    petersburg_font_load(result): path
]

# Advance of text in pixels at size pixels per em.
fontwidth(result): font size text [
    petersburg_font_width(result): font size text
]

# Line height in pixels at size pixels per em.
fontheight(result): font size [
    petersburg_font_height(result): font size
]

# Anti-aliased text whose line box starts at (x, y).
canvasfonttext(result): canvas x y text color font size [
    petersburg_canvas_font_text(result): canvas x y text color font size
]

getwidth(result): widget [
    petersburg_get_width(result): widget
]

getheight(result): widget [
    petersburg_get_height(result): widget
]

# --- list marks: per-row highlight independent of the cursor ---------------

setmark(result): list index marked [
    petersburg_set_mark(result): list index marked
]

getmark(result): list index [
    petersburg_get_mark(result): list index
]

# --- lifetime and testing ----------------------------------------------------

alive(result): widget [
    petersburg_alive(result): widget
]

# Sends a synthetic "key"/"keyup"/"focus" (window), "pointer"/"wheel"
# (canvas) or "click" (widget) event through the normal input path.
inject(result): widget event a b c [
    petersburg_inject(result): widget event a b c
]
