# One key press, without the lock and the redraw (the tests call it).
kremlinkeybody(r): key [
    km_modifier(r): key true
    if(_): {r = false} [
        set(_kkb_dialog): km_dialog?
        set(_kkb_popup): km_popup?
        if(_): {_kkb_dialog != ""} [ km_dialog_key(_): key ]
        elif(_): {_kkb_popup != ""} [ km_popup_key(_): key ]
