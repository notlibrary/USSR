        set(_kst2_j): {(_kst2_j + step + _kst2_n) % _kst2_n}
        at(_kst2_it): _kst2_items _kst2_j
        at(_kst2_l): _kst2_it 0
        if(_): {_kst2_l != "-"} [
            set(_kst2_found): true
            set(r): _kst2_j
        ]
        set(_kst2_k): {_kst2_k + 1}
    ]
]

km_popup_key(r): key [
    set(_kpk_kind): km_popup?
    set(_kpk_sel): km_popup_sel?
    if(_): {key = KM_KEY_ESCAPE || key = KM_KEY_F10 || key = KM_KEY_LSUPER || key = KM_KEY_RSUPER} [
        km_close_popup(_):
    ]
    elif(_): {_kpk_kind = "calendar"} [
        if(_): {key = KM_KEY_LEFT || key = KM_KEY_UP || key = KM_KEY_PAGE_UP} [ km_cal_shift(_): {0 - 1} ]
        elif(_): {key = KM_KEY_RIGHT || key = KM_KEY_DOWN || key = KM_KEY_PAGE_DOWN} [ km_cal_shift(_): 1 ]
        elif(_): {key = KM_KEY_HOME} [ km_open_calendar(_): ]
        elif(_): {key = KM_KEY_ENTER} [ km_close_popup(_): ]
    ]
    elif(_): {key = KM_KEY_DOWN || key = KM_KEY_TAB} [
        km_menu_step(_kpk_sel): _kpk_sel 1
        set(km_popup_sel): _kpk_sel!
    ]
    elif(_): {key = KM_KEY_UP} [
        if(_): {_kpk_sel < 0} [ set(_kpk_sel): 0 ]
        km_menu_step(_kpk_sel): _kpk_sel {0 - 1}
        set(km_popup_sel): _kpk_sel!
    ]
    elif(_): {key = KM_KEY_ENTER || key = KM_KEY_KP_ENTER || key = KM_KEY_SPACE} [
        km_menu_pick(_): _kpk_sel
    ]
    else(_): [
        # a letter picks the next item that starts with it
        km_key_char(_kpk_c): key false
        if(_): {_kpk_c != ""} [
            set(_kpk_items): km_popup_items?
            len(_kpk_n): _kpk_items
