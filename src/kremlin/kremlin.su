    set(r): 0
]

# Where a keyboard-opened context menu goes: next to the selected icon.
km_context_point(r): [
    set(_kcp_m): km_metrics?
    set(_kcp_sel): km_sel?
    set(_kcp_scroll): km_scroll?
    vec(r): ""
    if(_): {_kcp_sel >= 0} [
        km_cell(_kcp_xy): _kcp_sel _kcp_m _kcp_scroll
        at(_kcp_cw): _kcp_m 1
        at(_kcp_x): _kcp_xy 0
        at(_kcp_y): _kcp_xy 1
        push(_): r {_kcp_x + _kcp_cw}
        push(_): r _kcp_y
    ]
    else(_): [
        push(_): r 40
        push(_): r 40
    ]
]

km_desktop_key(r): key [
    set(_kdk3_shift): km_shift?
    set(_kdk3_ctrl): km_ctrl?
    set(_kdk3_alt): km_alt?
    kremlinselected(_kdk3_name):
    set(_kdk3_err): ""
    set(_kdk3_m): km_metrics?
    at(_kdk3_rows): _kdk3_m 5
    at(_kdk3_cols): _kdk3_m 6
    set(_kdk3_items): km_items?
    len(_kdk3_n): _kdk3_items
    set(_kdk3_sel): km_sel?
    set(_kdk3_nav): {key = KM_KEY_RIGHT || key = KM_KEY_LEFT || key = KM_KEY_DOWN || key = KM_KEY_UP || key = KM_KEY_HOME || key = KM_KEY_END || key = KM_KEY_PAGE_UP || key = KM_KEY_PAGE_DOWN}
