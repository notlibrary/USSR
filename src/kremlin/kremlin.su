kremlinkeyup(r): key [
    km_modifier(_): key false
    set(r): 0
]

# Modifier keys released while another window had the focus never reach
# us: forget them when the focus moves.
kremlinfocus(r): focused [
    set(km_shift): false!
    set(km_ctrl): false!
    set(km_alt): false!
    set(r): 0
]

# Once a second: the clock, messages that are old, the canvas size, and
# every three seconds changes to the folder made by other programs.
km_tick_once(r): [
    set(_kto_redraw): false
    localtime(_kto_t):
    km_clock_text(_kto_clock): _kto_t
    set(_kto_shown): km_clock_shown?
    if(_): {_kto_clock != _kto_shown} [ set(_kto_redraw): true ]
    set(_kto_msg): km_status?
    set(_kto_when): km_status_time?
    time(_kto_now):
    if(_): {_kto_msg != "" && _kto_now - _kto_when >= 6} [
        set(km_status): ""!
        set(_kto_redraw): true
    ]
    km_canvas_size(_kto_size):
    at(_kto_w): _kto_size 0
    at(_kto_h): _kto_size 1
    str_from_int(_kto_sz_a): _kto_w
    str_from_int(_kto_sz_b): _kto_h
    concat(_kto_sz): _kto_sz_a "x" _kto_sz_b
    set(_kto_szs): km_size_shown?
    if(_): {_kto_sz != _kto_szs} [ set(_kto_redraw): true ]
    set(_kto_count): km_tick_count?
    set(km_tick_count): {_kto_count + 1}!
    if(_): {_kto_count % 3 = 0} [
        set(_kto_dir): km_dir?
        km_raw_listing(_kto_raw): _kto_dir
        set(_kto_old): km_raw?
        if(_): {_kto_raw != _kto_old} [
            kremlinrefresh(_):
            set(_kto_redraw): true
        ]
    ]
    if(_): _kto_redraw [ kremlindraw(_): ]
    set(r): _kto_redraw
]

km_tick(result): window generation [
    set(result): 0
    set(_ktk_go): true
    while(_): _ktk_go [
        sleep(_): 1000
        alive(_ktk_alive): window
        set(_ktk_gen): km_tick_gen?
        set(_ktk_go): {_ktk_alive && _ktk_gen = generation}
        if(_): _ktk_go [
            uilock(_):
            km_tick_once(_):
            uiunlock(_):
        ]
    ]
]

# The canvas in window, drawn; returns it.
kremlininitialize(canvas): window [
    set(km_window): window!
    set(km_tick_count): 0!
    set(km_bands_for): {0 - 1}!
    set(km_clock_shown): ""!
    set(km_size_shown): ""!
    canvas(canvas): window
    set(km_canvas): canvas!
    pack(_): canvas true
    kremlindraw(_):
]

# Starts Kremlin again without a console window (Windows autostart);
# false when it cannot, and Kremlin runs here instead.
km_detach(r): args [
    set(_kdt2_src): km_source?
    set(_kdt2_ussr): km_ussr?
    set(r): false
    if(_): {_kdt2_src != ""} [
        km_join(_kdt2_script): _kdt2_src "kremlin/kremlin.su"
        km_quote(_kdt2_params): _kdt2_script
        concat(_kdt2_params): _kdt2_params " " args
        launch(_kdt2_ok): _kdt2_ussr _kdt2_params true
        set(r): {_kdt2_ok = 0}
    ]
]

# `ussr src/kremlin/kremlin.su` runs the desktop; scripts that $include
# kremlin.su (the tests) keep their own init.
$ifdef __MAIN__
kremlin_app_pointer(result): canvas x y [
    kremlinclick(_): x y
]

kremlin_app_double(result): canvas x y [
    kremlindouble(_): x y
]

kremlin_app_menu(result): canvas x y [
    kremlinmenu(_): x y
]

kremlin_app_wheel(result): canvas x y direction [
    kremlinwheel(_): direction
]

kremlin_app_key(result): window key [
    kremlinkey(_): key
]

kremlin_app_keyup(result): window key [
    kremlinkeyup(_): key
]

kremlin_app_focus(result): window focused [
    kremlinfocus(_): focused
]

init(result): arg_count arg_values [
    set(result): 0
    set(_kin_window): false
    set(_kin_detach): false
    set(_kin_auto): ""
    set(_kin_root): ""
    set(_kin_bad): false
    set(_kin_i): 0
    while(_): {_kin_i < arg_count} [
        at(_kin_a): arg_values _kin_i
        if(_): {_kin_a = "--window"} [ set(_kin_window): true ]
        elif(_): {_kin_a = "--detach"} [ set(_kin_detach): true ]
        elif(_): {_kin_a = "--autostart" && _kin_i + 1 < arg_count} [
            at(_kin_auto): arg_values {_kin_i + 1}
            set(_kin_i): {_kin_i + 1}
            if(_): {_kin_auto != "on" && _kin_auto != "off"} [ set(_kin_bad): true ]
        ]
        else(_): [
            km_starts_with(_kin_opt): _kin_a "-"
            if(_): {_kin_opt || _kin_root != ""} [ set(_kin_bad): true ]
            else(_): [ set(_kin_root): _kin_a ]
        ]
        set(_kin_i): {_kin_i + 1}
    ]
    if(_): _kin_bad [
        print(_): "usage: ussr kremlin.su [--window] [--detach] [folder]"
        print(_): "       ussr kremlin.su --autostart on|off [folder]"
        set(result): 2
        return(_): result
    ]
    if(_): {_kin_root = ""} [ km_default_root(_kin_root): ]
    else(_): [
        # a folder given relative to where Kremlin was started
        km_slashes(_kin_root): _kin_root
        km_is_absolute(_kin_abs): _kin_root
        if(_): {_kin_abs = false} [
            getcwd(_kin_cwd):
            km_slashes(_kin_cwd): _kin_cwd
            km_join(_kin_root): _kin_cwd _kin_root
        ]
    ]
    kremlinreset(_): _kin_root
    if(_): {_kin_auto != ""} [
        kremlinautostart(_kin_msg): {_kin_auto = "on"}
        print(_): _kin_msg
        return(_): result
    ]
    if(_): _kin_detach [
        set(_kin_rest): ""
        if(_): _kin_window [ set(_kin_rest): "--window " ]
        km_quote(_kin_qr): _kin_root
        concat(_kin_rest): _kin_rest _kin_qr
        km_detach(_kin_gone): _kin_rest
        if(_): _kin_gone [ return(_): result ]
    ]
    createwindow(window): "Kremlin" KM_WIDTH KM_HEIGHT
    kremlininitialize(canvas): window
    on(_): canvas "pointer" "kremlin_app_pointer"
    on(_): canvas "double" "kremlin_app_double"
    on(_): canvas "menu" "kremlin_app_menu"
    on(_): canvas "wheel" "kremlin_app_wheel"
    on(_): window "key" "kremlin_app_key"
    on(_): window "keyup" "kremlin_app_keyup"
    on(_): window "focus" "kremlin_app_focus"
    if(_): {_kin_window = false} [ fullscreen(_): window ]
    show(_): window
    set(km_tick_gen): 1!
    async(_): "km_tick" window 1
    run(_):
    # redraw once the canvas has its real size
    sleep(_): 150
    uilock(_):
    kremlindraw(_):
    uiunlock(_):
]
$endif
