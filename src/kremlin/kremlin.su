        if(_): {_kdk3_c != "" && _kdk3_c != " "} [ km_type_ahead(_): _kdk3_c ]
    ]
    km_report(_): _kdk3_err
    set(r): 0
]

km_modifier(r): key down [
    set(r): true
    if(_): {key = KM_KEY_LSHIFT || key = KM_KEY_RSHIFT} [ set(km_shift): down! ]
    elif(_): {key = KM_KEY_LCTRL || key = KM_KEY_RCTRL} [ set(km_ctrl): down! ]
    elif(_): {key = KM_KEY_LALT || key = KM_KEY_RALT} [ set(km_alt): down! ]
