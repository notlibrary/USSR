    ]
    elif(_): {key = KM_KEY_MENU || (key = KM_KEY_F10 && _kdk3_shift)} [
        km_context_point(_kdk3_pt):
        at(_kdk3_px): _kdk3_pt 0
        at(_kdk3_py): _kdk3_pt 1
        km_open_context(_): _kdk3_px _kdk3_py true
    ]
    elif(_): {key = KM_KEY_F10 || key = KM_KEY_LSUPER || key = KM_KEY_RSUPER} [ km_open_start(_): true ]
    elif(_): _kdk3_ctrl [
        if(_): {key = 78 && _kdk3_shift} [ kremlinaction(_): "newfile" "" ]
        elif(_): {key = 78} [ kremlinaction(_): "newfolder" "" ]
        elif(_): {key = 76} [ kremlinaction(_): "newlauncher" "" ]
        elif(_): {key = 82} [ kremlinaction(_): "run" "" ]
        elif(_): {key = 81} [ kremlinaction(_): "exit" "" ]
        elif(_): {key = 68 && _kdk3_name != ""} [ kremlinaction(_kdk3_err): "duplicate" _kdk3_name ]
        elif(_): {key = 80 && _kdk3_name != ""} [ kremlinaction(_kdk3_err): "pin" _kdk3_name ]
    ]
    elif(_): {_kdk3_alt = false} [
