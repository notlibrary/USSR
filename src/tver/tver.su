# Tver native runtime API. The graphical application is assembled from
# Petersburg widgets and the existing USSR scheduler.
$include "../petersburg/petersburg.su"

tverinitialize(result): window left_path left_list right_path right_list status [
    tver_initialize(result): window left_path left_list right_path right_list status
]

tverhandlekey(result): window key [
    tver_handle_key(result): window key
]

tveractivatepanel(result): widget [
    tver_activate_panel(result): widget
]
