        ]
        set(i): {i + 1}
    ]
]

tvm_zip_extract(r): path dir [
    set(r): 0
    tvm_zip_list(es): path
    if(_): {es = null} [
        set(r): -1
        return(r): r
    ]
    len(n): es
    set(i): 0
    while(_): {i < n} [
        at(en): es i
        btget(nm): en "name"
        str_ends(isd): nm "/"
        str_contains(up): nm ".."
        if(_): {up = false} [
            tvm_join(p): dir nm
            if(_): isd [ tvm_mkdirs(_): p ]
            else(_): [
                path_dir(pd): p
                tvm_mkdirs(_): pd
                tvm_zip_read(data): path nm
                if(_): {data != null} [
                    write_bytes(_): p data
                    set(r): {r + 1}
                ]
            ]
        ]
        set(i): {i + 1}
    ]
]

tvm_push16(r): v x [
    set(r): 0
    push(_): v {x & 255}
