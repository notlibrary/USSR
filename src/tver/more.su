# more.su - Tver refine pass 1: the file manager's engine beyond 0.5, in
# functions that need no window (tests/tver_more_test.su), and the keys
# tver.su hands to it (tvm_key).
#
# Files:     tvm_rename tvm_new_file tvm_stats tvm_delete_tree tvm_trash
#            tvm_copy_item (policy overwrite|skip|rename|different) tvm_job
#            tvm_job_step tvm_queue_* tvm_compare tvm_sync tvm_shred
# Archives:  tvm_zip_list tvm_zip_read tvm_zip_extract tvm_zip_pack
#            tvm_zip_folder (a ZIP's folder as names, like list_dir)
# Viewing:   tvm_view (UTF-8, UTF-16, Latin-1 or a hex dump) tvm_hex
#            tvm_image_info tvm_editor tvm_open_plan (.su, .dxf, .kl, others)
# Moving:    tvm_roots tvm_history_* tvm_bookmarks_* tvm_jump tvm_sort
#            tvm_detail tvm_brief tvm_listing_filter (hidden files, filters)
# Marking:   tvm_select tvm_invert tvm_select_all tvm_totals
# Tools:     tvm_find tvm_rename_plan tvm_rename_apply tvm_sums tvm_verify
#            tvm_split tvm_join tvm_diff tvm_dupes tvm_usage tvm_info
# Settings:  ~/.tver: "bookmark PATH", "filter DIR PATTERN",
#            "menu LABEL: COMMAND" (%f file, %d folder, %n name), "hidden
#            off" (dot files left out), "key NAME ACTION", "left
#            PATH", "right PATH"; tvm_settings_load / _save
# Display:   tvm_kind tvm_keybar tvm_tui
$once
$include "../libs/strings.su"
$include "../libs/lists.su"
$include "../libs/paths.su"
$include "../libs/encoding.su"

# --- small things

tvm_join(r): dir name [
    path_join(r): dir name
]

tvm_base(r): path [
    lenin_tvm_strip(p): path
    path_base(r): p
]

lenin_tvm_strip(r): path [
    set(r): path
    str_ends(sl): r "/"
    len(n): r
    if(_): {sl && n > 1} [ slice(r): r 0 {n - 1} ]
]

tvm_size(r): path [
    read_bytes(b): path
    set(r): 0
    typeof(t): b
    if(_): {t = "vector"} [ len(r): b ]
]

tvm_isdir(r): path [
    is_dir(d): path
    set(r): {d = 1}
]

tvm_plain(r): name [
    lenin_tvm_strip(r): name
]

tvm_human(r): bytes [
    str_from_int(r): bytes
    concat(r): r " B"
    if(_): {bytes >= 1024} [
        str_from_number(k): {bytes / 1024.0} 1
        concat(r): k " KiB"
    ]
    if(_): {bytes >= 1048576} [
        str_from_number(m): {bytes / 1048576.0} 1
        concat(r): m " MiB"
    ]
    if(_): {bytes >= 1073741824} [
        str_from_number(g): {bytes / 1073741824.0} 2
        concat(r): g " GiB"
    ]
]

# a free name in dir: "a.txt", "a (2).txt", ...
tvm_free_name(r): dir name [
    set(r): name
    tvm_join(p): dir name
    file_exists(e): p
    if(_): {e = false} [ return(r): r ]
    path_ext(ext): name
    path_stem(stem): name
    set(k): 2
    while(_): e [
        str_from_int(ks): k
        concat(r): stem " (" ks ")" ext
        tvm_join(p): dir r
        file_exists(e): p
        set(k): {k + 1}
    ]
]

# --- file operations

tvm_bad_name(r): name [
    set(r): ""
    str_contains(sl): name "/"
    str_contains(bs): name "\\"
    if(_): {name = "" || name = "." || name = ".."} [ set(r): "a name is needed" ]
    elif(_): {sl || bs} [ set(r): "a name cannot contain / or \\" ]
]

# "" or why not
tvm_rename(r): dir old new [
    tvm_plain(o): old
    tvm_bad_name(r): new
    if(_): {r != ""} [ return(r): r ]
    if(_): {o = new} [ return(r): r ]
    tvm_join(from): dir o
    tvm_join(to): dir new
    file_exists(e): to
    str_lower(ol): o
    str_lower(nl): new
    if(_): {e && ol != nl} [
        concat(r): new " is there already"
        return(r): r
    ]
    if(_): {ol = nl} [
        # only the case changes: through another name (Windows sees one file)
        concat(mid): from ".tver-case"
        rename_path(bad): from mid
        if(_): {bad = 0} [ rename_path(bad): mid to ]
    ]
    else(_): [ rename_path(bad): from to ]
    if(_): {bad != 0} [ set(r): "could not rename it (is it open?)" ]
]

tvm_new_file(r): dir name [
    tvm_bad_name(r): name
    if(_): {r != ""} [ return(r): r ]
    tvm_join(p): dir name
    file_exists(e): p
    if(_): e [
        concat(r): name " is there already"
        return(r): r
    ]
    open_file(h): p "wb"
    if(_): {h < 0} [
        set(r): "this system does not take that name"
        return(r): r
    ]
    close_file(_): h
]

# files, dirs and bytes under a path (the path itself when a file)
tvm_stats(r): path [
    btree(r):
    btput(_): r "files" 0
    btput(_): r "dirs" 0
    btput(_): r "bytes" 0
    tvm_isdir(d): path
    if(_): {d = false} [
        btput(_): r "files" 1
        tvm_size(s): path
        btput(_): r "bytes" s
        return(r): r
    ]
    tvm_stats_into(_): path r
]

tvm_stats_into(r): dir acc [
    set(r): 0
    list_dir(names): dir
    typeof(t): names
    if(_): {t != "vector"} [ return(r): r ]
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(nm): names i
        str_ends(isd): nm "/"
        tvm_plain(pn): nm
        tvm_join(p): dir pn
        if(_): isd [
            btget(dc): acc "dirs"
            btput(_): acc "dirs" {dc + 1}
            tvm_stats_into(_): p acc
        ]
        else(_): [
            btget(fc): acc "files"
            btput(_): acc "files" {fc + 1}
            tvm_size(s): p
            btget(bc): acc "bytes"
            btput(_): acc "bytes" {bc + s}
        ]
        set(i): {i + 1}
    ]
]

# a confirmation text: "3 files and 1 folder, 12.0 KiB"
tvm_describe(r): stats [
    btget(f): stats "files"
    btget(d): stats "dirs"
    btget(b): stats "bytes"
    str_from_int(fs): f
    str_from_int(ds): d
    tvm_human(hs): b
    set(fw): " files"
    if(_): {f = 1} [ set(fw): " file" ]
    set(dw): " folders"
    if(_): {d = 1} [ set(dw): " folder" ]
    concat(r): fs fw " and " ds dw ", " hs
]

# everything under path: [deleted failures], failures [[path why]...]
tvm_delete_tree(r): path [
    vec(fails): ""
    set(done): 0
    tvm_isdir(d): path
    if(_): d [ tvm_delete_into(done): path fails ]
    else(_): [
        remove_file(bad): path
        if(_): {bad = 0} [ set(done): 1 ]
        else(_): [
            vec(f): ""
            push(_): f path
            push(_): f "could not delete it"
            push(_): fails f
        ]
    ]
    vec(r): ""
    push(_): r done
    push(_): r fails
]

tvm_delete_into(r): dir fails [
    set(r): 0
    list_dir(names): dir
    typeof(t): names
    if(_): {t = "vector"} [
        len(n): names
        set(i): 0
        while(_): {i < n} [
            at(nm): names i
            str_ends(isd): nm "/"
            tvm_plain(pn): nm
            tvm_join(p): dir pn
            if(_): isd [
                tvm_delete_into(k): p fails
                set(r): {r + k}
            ]
            else(_): [
                remove_file(bad): p
                if(_): {bad = 0} [ set(r): {r + 1} ]
                else(_): [
                    vec(f): ""
                    push(_): f p
                    push(_): f "could not delete it"
                    push(_): fails f
                ]
            ]
            set(i): {i + 1}
        ]
    ]
    remove_dir(bad): dir
    if(_): {bad = 0} [ set(r): {r + 1} ]
    else(_): [
        vec(f): ""
        push(_): f dir
        push(_): f "the folder is not empty or is locked"
        push(_): fails f
    ]
]

# the trash: Kremlin's (~/kremlin/.trash) when there is one, else
# ~/.tver-trash; an .index line per item says where it came from
tvm_trash_dir(r): [
    getenv(home): "HOME"
    if(_): {home = null || home = ""} [ getenv(home): "USERPROFILE" ]
    if(_): {home = null} [ set(home): "." ]
    lenin_tvm_slashes(home): home
    path_join(km): home "kremlin"
    tvm_isdir(hask): km
    if(_): hask [ path_join(r): km ".trash" ]
    else(_): [ path_join(r): home ".tver-trash" ]
    tvm_isdir(there): r
    if(_): {there = false} [ make_dir(_): r ]
]

lenin_tvm_slashes(r): s [
    str_replace(r): s "\\" "/"
]

tvm_trash(r): path [
    set(r): ""
    file_exists(e): path
    if(_): {e = false} [
        set(r): "it is gone already"
        return(r): r
    ]
    tvm_trash_dir(td):
    tvm_base(b): path
    tvm_free_name(nm): td b
    tvm_join(to): td nm
    rename_path(bad): path to
    if(_): {bad != 0} [
        tvm_isdir(d): path
        if(_): d [ copy_dir(bad): path to ]
        else(_): [ copy_file(bad): path to ]
        if(_): {bad = 0} [ tvm_delete_tree(_): path ]
    ]
    if(_): {bad != 0} [
        set(r): "could not move it to the trash"
        return(r): r
    ]
    tvm_join(idx): td ".index"
    concat(line): nm "\t" path "\n"
    open_file(h): idx "ab"
    if(_): {h >= 0} [
        write_file(_): h line
        close_file(_): h
    ]
]

# copies src to dst (a file or a folder) by a policy for what is there:
# overwrite, skip, rename, different (overwrite when size or content
# differ); "copied", "skipped", "overwrote", "renamed NAME", or "failed: why"
tvm_copy_item(r): src dst policy [
    file_exists(there): dst
    tvm_isdir(sd): src
    set(target): dst
    set(r): "copied"
    if(_): there [
        if(_): {policy = "skip"} [
            set(r): "skipped"
            return(r): r
        ]
        if(_): {policy = "rename"} [
            path_dir(dd): dst
            tvm_base(db): dst
            tvm_free_name(nm): dd db
            tvm_join(target): dd nm
            concat(r): "renamed " nm
        ]
        elif(_): {policy = "different" && sd = false} [
            tvm_same_file(same): src dst
            if(_): same [
                set(r): "skipped"
                return(r): r
            ]
            set(r): "overwrote"
        ]
        elif(_): {policy = "overwrite" || policy = "different"} [ set(r): "overwrote" ]
        else(_): [
            set(r): "failed: it is there already"
            return(r): r
        ]
    ]
    if(_): sd [
        tvm_inside(loop): target src
        if(_): loop [
            set(r): "failed: a folder cannot go inside itself"
            return(r): r
        ]
        copy_dir(bad): src target
    ]
    else(_): [
        file_exists(old): target
        if(_): old [ remove_file(_): target ]
        copy_file(bad): src target
    ]
    if(_): {bad != 0} [ set(r): "failed: could not copy it" ]
]

tvm_inside(r): path dir [
    path_normalize(p): path
    path_normalize(d): dir
    concat(dslash): d "/"
    str_starts(r): p dslash
    if(_): {p = d} [ set(r): true ]
]

tvm_same_file(r): a b [
    tvm_size(sa): a
    tvm_size(sb): b
    set(r): false
    if(_): {sa != sb} [ return(r): r ]
    read_bytes(ba): a
    read_bytes(bb): b
    sha256(ha): ba
    sha256(hb): bb
    hex_encode(xa): ha
    hex_encode(xb): hb
    set(r): {xa = xb}
]

# --- jobs: a copy or move in steps, with progress, cancel and a report

tvm_job(r): kind pairs policy [
    btree(r):
    btput(_): r "kind" kind
    btput(_): r "pairs" pairs
    btput(_): r "policy" policy
    btput(_): r "next" 0
    vec(fails): ""
    btput(_): r "fails" fails
    btput(_): r "cancel" false
    btput(_): r "state" "waiting"
    set(total): 0
    len(n): pairs
    set(i): 0
    while(_): {i < n} [
        at(pr): pairs i
        at(src): pr 0
        tvm_stats(st): src
        btget(b): st "bytes"
        set(total): {total + b}
        set(i): {i + 1}
    ]
    btput(_): r "bytes" total
    btput(_): r "done_bytes" 0
]

# one item; false when the job is over (finished or cancelled)
tvm_job_step(r): job [
    set(r): false
    btget(c): job "cancel"
    if(_): c [
        btput(_): job "state" "cancelled"
        return(r): r
    ]
    btget(pairs): job "pairs"
    btget(k): job "next"
    len(n): pairs
    if(_): {k >= n} [
        btput(_): job "state" "finished"
        return(r): r
    ]
    btput(_): job "state" "running"
    at(pr): pairs k
    at(src): pr 0
    at(dst): pr 1
    tvm_stats(st): src
    btget(b): st "bytes"
    btget(policy): job "policy"
    btget(kind): job "kind"
    tvm_copy_item(res): src dst policy
    str_starts(failed): res "failed"
    if(_): {failed = false && kind = "move" && res != "skipped"} [
        tvm_delete_tree(dr): src
        at(dfails): dr 1
        len(ndf): dfails
        if(_): {ndf > 0} [ set(res): "failed: copied, but the original could not be removed" ]
    ]
    str_starts(failed): res "failed"
    if(_): failed [
        btget(fails): job "fails"
        vec(f): ""
        push(_): f src
        len(rl): res
        slice(why): res 8 {rl - 8}
        push(_): f why
        push(_): fails f
    ]
    btget(db): job "done_bytes"
    btput(_): job "done_bytes" {db + b}
    btput(_): job "next" {k + 1}
    set(r): {k + 1 < n}
    if(_): {r = false} [ btput(_): job "state" "finished" ]
]

tvm_job_cancel(r): job [
    btput(_): job "cancel" true
    set(r): 0
]

tvm_job_percent(r): job [
    btget(t): job "bytes"
    btget(d): job "done_bytes"
    set(r): 100
    if(_): {t > 0} [
        set(r): {d * 100 / t}
        str_trunc(r): r
    ]
]

tvm_job_report(r): job [
    btget(fails): job "fails"
    btget(k): job "next"
    len(nf): fails
    str_from_int(ks): {k - nf}
    concat(r): ks " done"
    if(_): {nf > 0} [
        str_from_int(fs): nf
        concat(r): r ", " fs " failed:"
        set(i): 0
        while(_): {i < nf} [
            at(f): fails i
            at(p): f 0
            at(w): f 1
            concat(r): r "\n  " p ": " w
            set(i): {i + 1}
        ]
    ]
]

tvm_queue(r): [
    vec(r): ""
]

tvm_queue_add(r): q job [
    push(_): q job
    len(r): q
]

# a step of the first job not over; false when the queue is empty
tvm_queue_step(r): q [
    set(r): false
    len(n): q
    set(i): 0
    while(_): {i < n} [
        at(j): q i
        btget(st): j "state"
        if(_): {st = "waiting" || st = "running"} [
            tvm_job_step(_): j
            set(r): true
            return(r): r
        ]
        set(i): {i + 1}
    ]
]

# --- comparing and synchronising folders

# [[name state]...]: same, left (only there), right, size, content
tvm_compare(r): a b deep [
    vec(r): ""
    list_dir(la): a
    list_dir(lb): b
    btree(all):
    tvm_compare_add(_): all la 1
    tvm_compare_add(_): all lb 2
    btkeys(ks): all
    len(n): ks
    set(i): 0
    while(_): {i < n} [
        at(nm): ks i
        btget(where): all nm
        set(state): "same"
        if(_): {where = 1} [ set(state): "left" ]
        elif(_): {where = 2} [ set(state): "right" ]
        else(_): [
            str_ends(isd): nm "/"
            tvm_plain(pn): nm
            tvm_join(pa): a pn
            tvm_join(pb): b pn
            if(_): isd [
                if(_): deep [
                    tvm_compare(sub): pa pb deep
                    len(ns): sub
                    set(j): 0
                    while(_): {j < ns} [
                        at(e): sub j
                        at(sn): e 0
                        at(ss): e 1
                        if(_): {ss != "same"} [ set(state): "content" ]
                        set(j): {j + 1}
                    ]
                ]
            ]
            else(_): [
                tvm_size(sa): pa
                tvm_size(sb): pb
                if(_): {sa != sb} [ set(state): "size" ]
                elif(_): deep [
                    tvm_same_file(same): pa pb
                    if(_): {same = false} [ set(state): "content" ]
                ]
            ]
        ]
        vec(e): ""
        push(_): e nm
        push(_): e state
        push(_): r e
        set(i): {i + 1}
    ]
]

tvm_compare_add(r): all names side [
    set(r): 0
    typeof(t): names
    if(_): {t != "vector"} [ return(r): r ]
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(nm): names i
        btget(v): all nm 0
        btput(_): all nm {v | side}
        set(i): {i + 1}
    ]
]

# what is missing on a side is copied there; both: both ways. Files that
# differ are left alone (Tver cannot tell which is newer) and reported.
tvm_sync(r): a b both [
    btree(r):
    btput(_): r "copied" 0
    vec(left): ""
    btput(_): r "differ" left
    tvm_compare(cmp): a b true
    len(n): cmp
    set(i): 0
    while(_): {i < n} [
        at(e): cmp i
        at(nm): e 0
        at(st): e 1
        tvm_plain(pn): nm
        tvm_join(pa): a pn
        tvm_join(pb): b pn
        if(_): {st = "left"} [
            tvm_copy_item(res): pa pb "skip"
            if(_): {res = "copied"} [
                btget(c): r "copied"
                btput(_): r "copied" {c + 1}
            ]
        ]
        elif(_): {st = "right" && both} [
            tvm_copy_item(res): pb pa "skip"
            if(_): {res = "copied"} [
                btget(c): r "copied"
                btput(_): r "copied" {c + 1}
            ]
        ]
        elif(_): {st = "size" || st = "content"} [ push(_): left nm ]
        elif(_): {st = "same"} [
            str_ends(isd): nm "/"
            if(_): isd [
                tvm_sync(sub): pa pb both
                btget(sc): sub "copied"
                btget(c): r "copied"
                btput(_): r "copied" {c + sc}
                btget(sd): sub "differ"
                len(nsd): sd
                set(j): 0
                while(_): {j < nsd} [
                    at(x): sd j
                    concat(xn): nm x
                    push(_): left xn
                    set(j): {j + 1}
                ]
            ]
        ]
        set(i): {i + 1}
    ]
]

# overwritten with zeros, then with other bytes, then removed
tvm_shred(r): path [
    tvm_size(n): path
    vec(z): ""
    vec(o): ""
    set(i): 0
    while(_): {i < n} [
        push(_): z 0
        push(_): o {(i * 37 + 91) % 256}
        set(i): {i + 1}
    ]
    write_bytes(_): path z
    write_bytes(_): path o
    remove_file(r): path
]

# --- ZIP archives (stored and deflated entries; packing stores)

tvm_u16(r): b p [
    at(x0): b p
    at(x1): b {p + 1}
    set(r): {x0 | (x1 << 8)}
]

tvm_u32(r): b p [
    at(x0): b p
    at(x1): b {p + 1}
    at(x2): b {p + 2}
    at(x3): b {p + 3}
    set(r): {x0 | (x1 << 8) | (x2 << 16) | (x3 << 24)}
]

tvm_bytes_text(r): b p n [
    set(r): ""
    set(i): 0
    while(_): {i < n} [
        at(x): b {p + i}
        chr(c): x
        concat(r): r c
        set(i): {i + 1}
    ]
]

# entries: btrees name size csize method offset (of the local header)
tvm_zip_list(r): path [
    set(r): null
    read_bytes(b): path
    typeof(t): b
    if(_): {t != "vector"} [ return(r): r ]
    len(n): b
    # the end of central directory record, searched from the end
    set(e): {n - 22}
    set(found): -1
    while(_): {e >= 0 && e >= n - 65557 && found < 0} [
        tvm_u32(sig): b e
        if(_): {sig = 101010256} [ set(found): e ]
        set(e): {e - 1}
    ]
    if(_): {found < 0} [ return(r): r ]
    tvm_u16(count): b {found + 10}
    tvm_u32(cd): b {found + 16}
    vec(r): ""
    set(p): cd
    set(k): 0
    while(_): {k < count} [
        tvm_u32(sig): b p
        if(_): {sig != 33639248} [ return(r): r ]
        tvm_u16(method): b {p + 10}
        tvm_u32(csize): b {p + 20}
        tvm_u32(size): b {p + 24}
        tvm_u16(nl): b {p + 28}
        tvm_u16(xl): b {p + 30}
        tvm_u16(cl): b {p + 32}
        tvm_u32(off): b {p + 42}
        tvm_bytes_text(name): b {p + 46} nl
        btree(en):
        btput(_): en "name" name
        btput(_): en "size" size
        btput(_): en "csize" csize
        btput(_): en "method" method
        btput(_): en "offset" off
        push(_): r en
        set(p): {p + 46 + nl + xl + cl}
        set(k): {k + 1}
    ]
]

# an entry's bytes, or null
tvm_zip_read(r): path name [
    set(r): null
    tvm_zip_list(es): path
    if(_): {es = null} [ return(r): r ]
    read_bytes(b): path
    len(n): es
    set(i): 0
    while(_): {i < n} [
        at(en): es i
        btget(nm): en "name"
        if(_): {nm = name} [
            btget(off): en "offset"
            btget(method): en "method"
            btget(csize): en "csize"
            tvm_u16(nl): b {off + 26}
            tvm_u16(xl): b {off + 28}
            set(start): {off + 30 + nl + xl}
            vec(data): ""
            set(j): 0
            while(_): {j < csize} [
                at(x): b {start + j}
                push(_): data x
                set(j): {j + 1}
            ]
            if(_): {method = 0} [ set(r): data ]
            elif(_): {method = 8} [ tvm_inflate(r): data ]
