    ]
]

# files (paths) into a ZIP, named relative to base; folders with all in
# them; the number of files
tvm_zip_pack(r): paths base out [
    vec(z): ""
    vec(central): ""
    set(r): 0
    vec(all): ""
    len(n): paths
    set(i): 0
    while(_): {i < n} [
        at(p): paths i
        tvm_isdir(d): p
        if(_): d [
            walk_dir(fs): p
            len(nf): fs
            set(j): 0
            while(_): {j < nf} [
                at(f): fs j
                push(_): all f
                set(j): {j + 1}
            ]
        ]
        else(_): [ push(_): all p ]
        set(i): {i + 1}
    ]
    path_normalize(b0): base
    concat(bslash): b0 "/"
    len(bl): bslash
    len(na): all
    set(i): 0
    while(_): {i < na} [
        at(f): all i
        path_normalize(fn): f
        set(name): fn
        str_starts(under): fn bslash
        if(_): under [
            len(fl): fn
            slice(name): fn bl {fl - bl}
        ]
        read_bytes(data): f
        len(size): data
        crc32(crc): data
        len(off): z
        tvm_push32(_): z 67324752
        tvm_push16(_): z 20
        tvm_push16(_): z 0
        tvm_push16(_): z 0
        tvm_push16(_): z 0
        tvm_push16(_): z 33
        tvm_push32(_): z crc
        tvm_push32(_): z size
        tvm_push32(_): z size
        len(nl): name
        tvm_push16(_): z nl
        tvm_push16(_): z 0
        tvm_push_text(_): z name
        set(j): 0
        while(_): {j < size} [
            at(x): data j
            push(_): z x
            set(j): {j + 1}
        ]
        tvm_push32(_): central 33639248
        tvm_push16(_): central 20
        tvm_push16(_): central 20
        tvm_push16(_): central 0
        tvm_push16(_): central 0
        tvm_push16(_): central 0
        tvm_push16(_): central 33
        tvm_push32(_): central crc
        tvm_push32(_): central size
        tvm_push32(_): central size
        tvm_push16(_): central nl
        tvm_push16(_): central 0
        tvm_push16(_): central 0
        tvm_push16(_): central 0
        tvm_push16(_): central 0
        tvm_push32(_): central 0
        tvm_push32(_): central off
        tvm_push_text(_): central name
        set(r): {r + 1}
        set(i): {i + 1}
    ]
    len(cdo): z
    len(cds): central
    set(i): 0
    while(_): {i < cds} [
        at(x): central i
        push(_): z x
        set(i): {i + 1}
    ]
    tvm_push32(_): z 101010256
    tvm_push16(_): z 0
    tvm_push16(_): z 0
    tvm_push16(_): z r
    tvm_push16(_): z r
    tvm_push32(_): z cds
    tvm_push32(_): z cdo
    tvm_push16(_): z 0
    write_bytes(_): out z
]

# the names in a folder of the archive ("" is the top), as list_dir gives
tvm_zip_folder(r): path inner [
    vec(r): ""
    tvm_zip_list(es): path
    if(_): {es = null} [ return(r): r ]
    set(pre): inner
    if(_): {pre != ""} [
        str_ends(sl): pre "/"
        if(_): {sl = false} [ concat(pre): pre "/" ]
    ]
    len(pl): pre
    btree(seen):
    len(n): es
    set(i): 0
    while(_): {i < n} [
        at(en): es i
        btget(nm): en "name"
        str_starts(under): nm pre
        len(nl): nm
        if(_): {under && nl > pl} [
            slice(rest): nm pl {nl - pl}
            str_find(sl): rest "/" 0
            set(item): rest
            if(_): {sl >= 0} [ slice(item): rest 0 {sl + 1} ]
            btput(_): seen item true
        ]
        set(i): {i + 1}
    ]
    btkeys(ks): seen
    # folders first, as list_dir
    set(pass): 0
    while(_): {pass < 2} [
        len(nk): ks
        set(i): 0
        while(_): {i < nk} [
            at(k): ks i
            str_ends(isd): k "/"
            if(_): {(pass = 0 && isd) || (pass = 1 && isd = false)} [ push(_): r k ]
            set(i): {i + 1}
        ]
        set(pass): {pass + 1}
    ]
]

# --- viewing

# a file as text for the viewer: [kind text], kind utf-8, utf-16, latin-1
# or hex (a binary file), at most max bytes read
tvm_view(r): path max [
    read_bytes(b): path
    vec(r): ""
    typeof(t): b
    if(_): {t != "vector"} [
        push(_): r "error"
        push(_): r "cannot read it"
        return(r): r
    ]
    len(n): b
    if(_): {n > max} [
        vec(c): ""
        set(i): 0
        while(_): {i < max} [
            at(x): b i
            push(_): c x
            set(i): {i + 1}
        ]
        set(b): c
        set(n): max
    ]
    set(kind): "utf-8"
    set(start): 0
    if(_): {n >= 3} [
        at(a): b 0
        at(c): b 1
        at(d): b 2
        if(_): {a = 239 && c = 187 && d = 191} [ set(start): 3 ]
    ]
    if(_): {n >= 2} [
        at(a): b 0
        at(c): b 1
        if(_): {(a = 255 && c = 254) || (a = 254 && c = 255)} [
            push(_): r "utf-16"
            tvm_utf16(text): b {a = 255}
            push(_): r text
            return(r): r
        ]
    ]
    # binary: a NUL in the first 8000 bytes
    set(i): 0
    while(_): {i < n && i < 8000} [
        at(x): b i
        if(_): {x = 0} [
            push(_): r "hex"
            tvm_hex(h): b 0 n
            push(_): r h
            return(r): r
        ]
        set(i): {i + 1}
    ]
    tvm_valid_utf8(ok): b start
    vec(body): ""
    set(i): start
    while(_): {i < n} [
        at(x): b i
        push(_): body x
        set(i): {i + 1}
    ]
    if(_): ok [
        bytes_text(text): body
    ]
    else(_): [
        set(kind): "latin-1"
        tvm_latin1(text): body
    ]
    push(_): r kind
    push(_): r text
]

tvm_valid_utf8(r): b start [
    set(r): true
    len(n): b
    set(i): start
    while(_): {i < n} [
        at(x): b i
        set(need): 0
        if(_): {x >= 128} [
            if(_): {x >= 194 && x <= 223} [ set(need): 1 ]
            elif(_): {x >= 224 && x <= 239} [ set(need): 2 ]
            elif(_): {x >= 240 && x <= 244} [ set(need): 3 ]
            else(_): [
                set(r): false
                return(r): r
            ]
        ]
        set(k): 1
        while(_): {k <= need} [
            if(_): {i + k >= n} [
                set(r): false
                return(r): r
            ]
            at(y): b {i + k}
            if(_): {y < 128 || y > 191} [
                set(r): false
                return(r): r
            ]
            set(k): {k + 1}
        ]
        set(i): {i + 1 + need}
    ]
]

# a code point as UTF-8 bytes onto v
tvm_put_utf8(r): v cp [
    set(r): 0
    if(_): {cp < 128} [ push(_): v cp ]
    elif(_): {cp < 2048} [
        push(_): v {192 | (cp >> 6)}
        push(_): v {128 | (cp & 63)}
    ]
    elif(_): {cp < 65536} [
        push(_): v {224 | (cp >> 12)}
        push(_): v {128 | ((cp >> 6) & 63)}
        push(_): v {128 | (cp & 63)}
    ]
    else(_): [
        push(_): v {240 | (cp >> 18)}
        push(_): v {128 | ((cp >> 12) & 63)}
        push(_): v {128 | ((cp >> 6) & 63)}
        push(_): v {128 | (cp & 63)}
    ]
]

tvm_latin1(r): b [
    vec(o): ""
    len(n): b
    set(i): 0
    while(_): {i < n} [
        at(x): b i
        tvm_put_utf8(_): o x
        set(i): {i + 1}
    ]
    bytes_text(r): o
]

tvm_utf16(r): b little [
    vec(o): ""
    len(n): b
    set(i): 2
    while(_): {i + 1 < n} [
        at(x0): b i
        at(x1): b {i + 1}
        set(u): {(x1 << 8) | x0}
        if(_): {little = false} [ set(u): {(x0 << 8) | x1} ]
        set(i): {i + 2}
        if(_): {u >= 55296 && u <= 56319 && i + 1 < n} [
            at(y0): b i
            at(y1): b {i + 1}
            set(lo): {(y1 << 8) | y0}
            if(_): {little = false} [ set(lo): {(y0 << 8) | y1} ]
            set(u): {65536 + ((u - 55296) << 10) + (lo - 56320)}
            set(i): {i + 2}
        ]
        tvm_put_utf8(_): o u
    ]
    bytes_text(r): o
]

# a hex dump: offset, 16 bytes, their printable characters
tvm_hex(r): b offset count [
    set(r): ""
    len(n): b
    set(end): {offset + count}
    if(_): {end > n} [ set(end): n ]
    set(p): offset
    while(_): {p < end} [
        tvm_hexn(oh): p 8
        concat(line): oh "  "
        set(chars): ""
        set(k): 0
        while(_): {k < 16} [
            if(_): {p + k < end} [
                at(x): b {p + k}
                tvm_hexn(hx): x 2
                concat(line): line hx " "
                set(ch): "."
                if(_): {x >= 32 && x < 127} [ chr(ch): x ]
                concat(chars): chars ch
            ]
            else(_): [ concat(line): line "   " ]
            if(_): {k = 7} [ concat(line): line " " ]
            set(k): {k + 1}
        ]
        concat(r): r line " |" chars "|\n"
        set(p): {p + 16}
    ]
]

# "PNG 640x480" and the like, or ""
tvm_image_info(r): path [
    set(r): ""
    read_bytes(b): path
    typeof(t): b
    if(_): {t != "vector"} [ return(r): r ]
    len(n): b
    if(_): {n < 26} [ return(r): r ]
    at(a0): b 0
    at(a1): b 1
    at(a2): b 2
    at(a3): b 3
    if(_): {a0 = 137 && a1 = 80 && a2 = 78 && a3 = 71} [
        set(w): 0
        set(h): 0
        set(k): 16
        while(_): {k < 20} [
            at(x): b k
            set(w): {(w << 8) | x}
            at(y): b {k + 4}
            set(h): {(h << 8) | y}
            set(k): {k + 1}
        ]
        str_from_int(ws): w
        str_from_int(hs): h
        concat(r): "PNG " ws "x" hs
    ]
    elif(_): {a0 = 71 && a1 = 73 && a2 = 70} [
        tvm_u16(w): b 6
        tvm_u16(h): b 8
        str_from_int(ws): w
        str_from_int(hs): h
        concat(r): "GIF " ws "x" hs
    ]
    elif(_): {a0 = 66 && a1 = 77} [
        tvm_u32(w): b 18
        tvm_u32(h): b 22
        str_from_int(ws): w
        str_from_int(hs): h
        concat(r): "BMP " ws "x" hs
    ]
    elif(_): {a0 = 255 && a1 = 216} [ set(r): "JPEG" ]
    elif(_): {a0 = 80 && (a1 = 54 || a1 = 53)} [ set(r): "PNM" ]
]

# what F4 runs: $EDITOR, else Mbl through ussr; [program arguments]
tvm_editor(r): path [
    vec(r): ""
    getenv(ed): "EDITOR"
    if(_): {ed != null && ed != ""} [
        push(_): r ed
        chr(q): 34
        concat(a): q path q
        push(_): r a
        return(r): r
    ]
    tvm_ussr_src(src):
    push(_): r "ussr"
    path_join(mbl): src "Mbl/Mbl.su"
    chr(q): 34
    concat(a): q mbl q " " q path q
    push(_): r a
]

tvm_ussr_src(r): [
    getenv(h): "USSR_HOME"
    if(_): {h != null && h != ""} [
        lenin_tvm_slashes(h): h
        path_join(r): h "src"
        return(r): r
    ]
    set(r): "src"
]

# how a file opens: [program arguments], as Kremlin does
tvm_open_plan(r): path [
    vec(r): ""
    path_ext(e): path
    str_lower(e): e
    chr(q): 34
    tvm_ussr_src(src):
    if(_): {e = ".su"} [
        push(_): r "ussr"
        concat(a): q path q
        push(_): r a
    ]
    elif(_): {e = ".dxf"} [
        push(_): r "ussr"
        path_join(tula): src "tula/tula.su"
        concat(a): q tula q " " q path q
        push(_): r a
    ]
    elif(_): {e = ".kl"} [
        readfile(t): path
        str_split(lines): t "\n"
        set(cmd): ""
        len(n): lines
        set(i): 0
        while(_): {i < n} [
            at(l): lines i
            str_trim(l): l
            str_starts(c): l "command:"
            if(_): c [
                len(ll): l
                slice(cmd): l 8 {ll - 8}
                str_trim(cmd): cmd
            ]
            set(i): {i + 1}
        ]
        str_find(sp): cmd " " 0
        set(prog): cmd
        set(args): ""
        if(_): {sp > 0} [
            slice(prog): cmd 0 sp
            len(cl): cmd
            slice(args): cmd {sp + 1} {cl - sp - 1}
        ]
        push(_): r prog
        push(_): r args
    ]
    else(_): [
        getenv(os): "OS"
        if(_): {os = "Windows_NT"} [
            push(_): r "cmd"
            concat(a): "/c start " q q " " q path q
            push(_): r a
        ]
        else(_): [
            push(_): r "xdg-open"
            concat(a): q path q
            push(_): r a
        ]
    ]
]

# --- moving about

tvm_roots(r): [
    vec(r): ""
    getenv(os): "OS"
    if(_): {os = "Windows_NT"} [
        set(c): 65
        while(_): {c <= 90} [
            chr(l): c
            concat(root): l ":/"
            tvm_isdir(d): root
            if(_): d [ push(_): r root ]
            set(c): {c + 1}
        ]
    ]
    else(_): [ push(_): r "/" ]
]

tvm_history(r): [
    btree(r):
    vec(v): ""
    btput(_): r "items" v
    btput(_): r "at" -1
]

tvm_history_go(r): h path [
    btget(items): h "items"
    btget(k): h "at"
    vec(keep): ""
    set(i): 0
    while(_): {i <= k} [
        at(x): items i
        push(_): keep x
        set(i): {i + 1}
    ]
    len(n): keep
    set(same): false
    if(_): {n > 0} [
        at(last): keep {n - 1}
        set(same): {last = path}
    ]
    if(_): {same = false} [ push(_): keep path ]
    btput(_): h "items" keep
    len(n): keep
    btput(_): h "at" {n - 1}
    set(r): n
]

tvm_history_back(r): h [
    set(r): null
    btget(k): h "at"
    if(_): {k > 0} [
        btput(_): h "at" {k - 1}
        btget(items): h "items"
        at(r): items {k - 1}
    ]
]

tvm_history_forward(r): h [
    set(r): null
    btget(k): h "at"
    btget(items): h "items"
    len(n): items
    if(_): {k + 1 < n} [
        btput(_): h "at" {k + 1}
        at(r): items {k + 1}
    ]
]

# the first name that starts with prefix (case folded), from the cursor on
tvm_jump(r): names prefix from [
    set(r): -1
    str_lower(p): prefix
    len(n): names
    set(k): 0
    while(_): {k < n} [
        set(i): {(from + k) % n}
        at(nm): names i
        str_lower(l): nm
        str_starts(hit): l p
        if(_): hit [
            set(r): i
            return(r): r
        ]
        set(k): {k + 1}
    ]
]

# entries [name size] sorted: mode name|ext|size, reverse, folders first;
# "../" stays on top
tvm_sort(r): entries mode reverse dirsfirst [
    vec(r): ""
    btree(ord):
    len(n): entries
    set(i): 0
    while(_): {i < n} [
        at(e): entries i
        at(nm): e 0
        at(sz): e 1
        str_ends(isd): nm "/"
        str_lower(l): nm
        set(key): l
        if(_): {mode = "ext"} [
            path_ext(x): l
            concat(key): x " " l
        ]
        if(_): {mode = "size"} [
            str_from_int(ss): sz
            str_pad_left(ss): ss 15 "0"
            concat(key): ss " " l
        ]
        set(group): "1"
        if(_): {dirsfirst && isd} [ set(group): "0" ]
        str_from_int(is): i
        str_pad_left(is): is 8 "0"
        concat(k): group key " " is
        btput(_): ord k e
        set(i): {i + 1}
    ]
    btkeys(ks): ord
    vec(sorted): ""
    len(nk): ks
    set(i): 0
    while(_): {i < nk} [
        at(k): ks i
        btget(e): ord k
        push(_): sorted e
        set(i): {i + 1}
    ]
    if(_): reverse [
        # the groups stay in order: folders first still
        vec(dirs): ""
        vec(files): ""
        set(i): {nk - 1}
        while(_): {i >= 0} [
            at(e): sorted i
            at(nm): e 0
            str_ends(isd): nm "/"
            if(_): {dirsfirst && isd} [ push(_): dirs e ]
            else(_): [ push(_): files e ]
            set(i): {i - 1}
        ]
        vec(sorted): ""
        list_concat(sorted): dirs files
    ]
    # the parent on top
    set(i): 0
    while(_): {i < nk} [
        at(e): sorted i
        at(nm): e 0
        if(_): {nm = "../"} [ push(_): r e ]
        set(i): {i + 1}
    ]
    set(i): 0
    while(_): {i < nk} [
        at(e): sorted i
        at(nm): e 0
        if(_): {nm != "../"} [ push(_): r e ]
        set(i): {i + 1}
    ]
]

# names with their sizes: [[name size]...]; folders size -1
tvm_entries(r): dir names [
    vec(r): ""
    len(n): names
    set(i): 0
    while(_): {i < n} [
        at(nm): names i
        str_ends(isd): nm "/"
        set(sz): -1
