        vec(e): ""
        push(_): e nm
        push(_): e sz
        push(_): r e
        set(i): {i + 1}
    ]
]

# the detail view: name, size, kind in columns
tvm_detail(r): entries width [
    vec(r): ""
    len(n): entries
    set(nw): {width - 26}
    if(_): {nw < 8} [ set(nw): 8 ]
    set(i): 0
