# Mbl.su - spartan vi-clone for USSR.
#
#   ussr Mbl.su [file]
#
# A minimal visual console text editor with vi-style modal editing.
# Normal mode:  h l       cursor left / right     (Backspace = left)
#               j k       cursor down / up        (arrow keys work too)
#               i         insert before cursor    a   insert after cursor
#               o         open new line below     x   delete char
#               d d       delete current line     :   command line
#               w         start of next word      c w change word
#               count     a number before a motion or command repeats it:
#                         3l 5j 2k 4x 2dd 3w c2w 2cw, and arrow keys
#               (no undo: Mbl does not keep an undo history)
# Commands:     :w [name] write file   :q quit   :wq write+quit   :q! quit
#               :e [name] reload / edit another file
# Insert mode:  type to insert, Enter splits the line, Backspace deletes
#               (and joins lines at column 0), ESC or Ctrl+C -> normal.
#
# Text is UTF-8 (Russian and other Cyrillic included): lines are byte
# strings, the cursor Mbl_cx is a byte offset that always sits on a
# character boundary, and movement, deletion and the screen column count
# characters. Each character takes one screen column (wide CJK glyphs are
# not measured). A UTF-8 byte-order mark is kept when the file is saved.
#
# Implementation: the terminal is put in raw mode through native USSR
# terminal primitives.Each key is read directly; no shell commands,
# stty, shell utilities, or POSIX-only utilities are required. The whole screen is
# rebuilt as one string per frame and written with a single template call.

$include "../libs/strings.su"

# ---------- terminal helpers ----------

Mbl_initesc(r): [
    terminal_escape(Mbl_esc):
    set(r): 0
]

Mbl_termsize(r): [
    set(Mbl_rows): 24
    set(Mbl_cols): 80
    terminal_size(Mblt_s):
    len(Mblt_n): Mblt_s
    set(Mblt_i): 0
    set(Mblt_part): 0
    set(Mblt_r): 0
    set(Mblt_c): 0
    while(_): {Mblt_i < Mblt_n} [
        byte(Mblt_b): Mblt_s Mblt_i
        if(_): {Mblt_b = 32} [
            set(Mblt_part): 1
        ]
        if(_): {Mblt_b > 47} [
            if(_): {Mblt_b < 58} [
                if(_): {Mblt_part = 0} [
                    set(Mblt_r): {Mblt_r * 10 + Mblt_b - 48}
                ]
                if(_): {Mblt_part = 1} [
                    set(Mblt_c): {Mblt_c * 10 + Mblt_b - 48}
                ]
            ]
        ]
        set(Mblt_i): {Mblt_i + 1}
    ]
    if(_): {Mblt_r > 2} [
        set(Mbl_rows): Mblt_r
    ]
    if(_): {Mblt_c > 2} [
        set(Mbl_cols): Mblt_c
    ]
    set(r): 0
]

# ---------- buffer helpers ----------

Mbl_setline(r): idx line [
    vec(Mblsl_new): ""
    len(Mblsl_n): Mbl_buf
    set(Mblsl_i): 0
    while(_): {Mblsl_i < Mblsl_n} [
        at(Mblsl_l): Mbl_buf Mblsl_i
        if(_): {Mblsl_i = idx} [
            set(Mblsl_l): line
        ]
        push(_): Mblsl_new Mblsl_l
        set(Mblsl_i): {Mblsl_i + 1}
    ]
    set(Mbl_buf): Mblsl_new
    set(r): 0
]

Mbl_linedel(r): idx [
    vec(Mbldl_new): ""
    len(Mbldl_n): Mbl_buf
    set(Mbldl_i): 0
    while(_): {Mbldl_i < Mbldl_n} [
        if(_): {Mbldl_i != idx} [
            at(Mbldl_l): Mbl_buf Mbldl_i
            push(_): Mbldl_new Mbldl_l
        ]
        set(Mbldl_i): {Mbldl_i + 1}
    ]
    set(Mbl_buf): Mbldl_new
    set(r): 0
]

Mbl_lineins(r): idx line [
    vec(Mblil_new): ""
    len(Mblil_n): Mbl_buf
    set(Mblil_i): 0
    while(_): {Mblil_i < Mblil_n} [
        if(_): {Mblil_i = idx} [
            push(_): Mblil_new line
        ]
        at(Mblil_l): Mbl_buf Mblil_i
        push(_): Mblil_new Mblil_l
        set(Mblil_i): {Mblil_i + 1}
    ]
    if(_): {Mblil_i = idx} [
        push(_): Mblil_new line
    ]
    set(Mbl_buf): Mblil_new
    set(r): 0
]

# Keeps Mbl_cx on a character start inside the line; in normal mode the
# cursor rests on the last character, in insert mode it may follow it.
Mbl_fixcx(r): [
    at(Mblfx_l): Mbl_buf Mbl_cy
    len(Mblfx_n): Mblfx_l
    utf8_column(Mblfx_col): Mblfx_l Mbl_cx
    utf8_index(Mbl_cx): Mblfx_l Mblfx_col
    set(Mblfx_max): Mblfx_n
    if(_): {Mbl_mode = 0} [
        utf8_prev(Mblfx_max): Mblfx_l Mblfx_n
    ]
    if(_): {Mbl_cx > Mblfx_max} [
        set(Mbl_cx): Mblfx_max
    ]
    set(r): 0
]

# Moves to line `target`, keeping the cursor's character column.
Mbl_goto_line(r): target [
    at(Mblgl_l): Mbl_buf Mbl_cy
    utf8_column(Mblgl_col): Mblgl_l Mbl_cx
    set(Mbl_cy): target
    at(Mblgl_l): Mbl_buf Mbl_cy
    utf8_index(Mbl_cx): Mblgl_l Mblgl_col
    Mbl_fixcx(_):
    set(r): 0
]

Mbl_scroll(r): [
    if(_): {Mbl_cy < Mbl_top} [
        set(Mbl_top): Mbl_cy
    ]
    set(Mblsc_last): {Mbl_top + Mbl_rows - 2}
    if(_): {Mbl_cy > Mblsc_last} [
        set(Mbl_top): {Mbl_cy - Mbl_rows + 2}
    ]
    set(r): 0
]

# ---------- movement ----------

Mbl_left(r): [
    at(Mblm_l): Mbl_buf Mbl_cy
    utf8_prev(Mbl_cx): Mblm_l Mbl_cx
    set(r): 0
]

Mbl_right(r): [
    at(Mblm_l): Mbl_buf Mbl_cy
    len(Mblm_n): Mblm_l
    utf8_next(Mblm_next): Mblm_l Mbl_cx
    set(Mblm_ok): {Mblm_next > Mbl_cx}
    if(_): {Mbl_mode = 0 && Mblm_next >= Mblm_n} [
        set(Mblm_ok): false
    ]
    if(_): Mblm_ok [
        set(Mbl_cx): Mblm_next
    ]
    set(r): 0
]

Mbl_up(r): [
    if(_): {Mbl_cy > 0} [
        Mbl_goto_line(_): {Mbl_cy - 1}
    ]
    Mbl_scroll(_):
    set(r): 0
]

Mbl_down(r): [
    len(Mblm2_n): Mbl_buf
    if(_): {Mbl_cy < Mblm2_n - 1} [
        Mbl_goto_line(_): {Mbl_cy + 1}
    ]
    Mbl_scroll(_):
    set(r): 0
]

# ---------- editing ----------

Mbl_insch(r): ch [
    at(Mblic_l): Mbl_buf Mbl_cy
    len(Mblic_n): Mblic_l
    slice(Mblic_a): Mblic_l 0 Mbl_cx
    slice(Mblic_b): Mblic_l Mbl_cx {Mblic_n - Mbl_cx}
    concat(Mblic_a): Mblic_a ch
    concat(Mblic_a): Mblic_a Mblic_b
    Mbl_setline(_): Mbl_cy Mblic_a
    len(Mblic_cl): ch
    set(Mbl_cx): {Mbl_cx + Mblic_cl}
    set(Mbl_dirty): 1
    set(r): 0
]

Mbl_bs(r): [
    set(r): 0
    if(_): {Mbl_cx > 0} [
        at(Mblbs_l): Mbl_buf Mbl_cy
        len(Mblbs_n): Mblbs_l
        utf8_prev(Mblbs_start): Mblbs_l Mbl_cx
        slice(Mblbs_a): Mblbs_l 0 Mblbs_start
        slice(Mblbs_b): Mblbs_l Mbl_cx {Mblbs_n - Mbl_cx}
        concat(Mblbs_a): Mblbs_a Mblbs_b
        Mbl_setline(_): Mbl_cy Mblbs_a
        set(Mbl_cx): Mblbs_start
        set(Mbl_dirty): 1
        return(_): r
    ]
    if(_): {Mbl_cx = 0} [
        if(_): {Mbl_cy > 0} [
            at(Mblbs_p): Mbl_buf {Mbl_cy - 1}
            at(Mblbs_c): Mbl_buf Mbl_cy
            len(Mblbs_pl): Mblbs_p
            concat(Mblbs_p): Mblbs_p Mblbs_c
            Mbl_linedel(_): Mbl_cy
            Mbl_setline(_): {Mbl_cy - 1} Mblbs_p
            set(Mbl_cy): {Mbl_cy - 1}
            set(Mbl_cx): Mblbs_pl
            set(Mbl_dirty): 1
        ]
    ]
]

Mbl_enter(r): [
    at(Mblen_l): Mbl_buf Mbl_cy
    len(Mblen_n): Mblen_l
    slice(Mblen_a): Mblen_l 0 Mbl_cx
    slice(Mblen_b): Mblen_l Mbl_cx {Mblen_n - Mbl_cx}
    Mbl_setline(_): Mbl_cy Mblen_a
    Mbl_lineins(_): {Mbl_cy + 1} Mblen_b
    set(Mbl_cy): {Mbl_cy + 1}
    set(Mbl_cx): 0
    set(Mbl_dirty): 1
    Mbl_scroll(_): 
    set(r): 0
]

Mbl_delch(r): [
    at(Mbldc_l): Mbl_buf Mbl_cy
    len(Mbldc_n): Mbldc_l
    if(_): {Mbl_cx < Mbldc_n} [
        utf8_next(Mbldc_end): Mbldc_l Mbl_cx
        slice(Mbldc_a): Mbldc_l 0 Mbl_cx
        slice(Mbldc_b): Mbldc_l Mbldc_end {Mbldc_n - Mbldc_end}
        concat(Mbldc_a): Mbldc_a Mbldc_b
        Mbl_setline(_): Mbl_cy Mbldc_a
        set(Mbl_dirty): 1
        Mbl_fixcx(_): 
    ]
    set(r): 0
]

Mbl_delete_line(r): [
    Mbl_linedel(_): Mbl_cy
    len(Mbldel_n): Mbl_buf
    if(_): {Mbldel_n = 0} [
        push(_): Mbl_buf ""
    ]
    len(Mbldel_n2): Mbl_buf
    if(_): {Mbl_cy + 1 > Mbldel_n2} [
        set(Mbl_cy): {Mbldel_n2 - 1}
    ]
    set(Mbl_cx): 0
    set(Mbl_dirty): 1
    Mbl_scroll(_): 
    set(r): 0
]

# ---------- file I/O ----------

# Different host builds disagree on file_exists: 1=exists, 0=exists
# (test -f style), string results, or no builtin at all. Detect the
# convention at startup: write a witness file we know exists, probe it
# and a name that cannot exist, and remember the value that means
# "exists" (Mbl_fe_yes). If both probes answer the same, the builtin is
# unusable -> Mbl_fe_ok stays 0 and Mbl_load falls back to `test -f`.
Mbl_detect(r): [
    set(Mbl_fe_ok): 0
    set(Mbl_fe_yes): 1
    writefile(Mbldt_w): ".Mbl_probe.tmp" "x"
    file_exists(Mbldt_y): ".Mbl_probe.tmp"
    file_exists(Mbldt_n): ".Mbl_probe_absent_9x7q.tmp"
    if(_): {Mbldt_y != Mbldt_n} [
        set(Mbl_fe_ok): 1
        set(Mbl_fe_yes): Mbldt_y
    ]
    set(r): 0
]

Mbl_load(r): path [
    vec(Mbl_buf): ""
    set(Mbl_dirty): 0
    set(Mbll_go): 0
    if(_): {Mbl_fe_ok = 1} [
        file_exists(Mbll_tf): path
        if(_): {Mbll_tf = Mbl_fe_yes} [
            set(Mbll_go): 1
        ]
    ]
    if(_): {Mbl_fe_ok = 0} [
        test(Mbll_tt): "-f" path
        if(_): {Mbll_tt = 0} [
            set(Mbll_go): 1
        ]
    ]
    set(Mbl_bom): 0
    if(_): {Mbll_go = 1} [
        # Line by line: CRLF and LF both end a line; bytes are kept as-is,
        # so UTF-8 text loads unchanged.
        open_file(Mbll_h): path "rb"
        if(_): {Mbll_h >= 0} [
            read_line(Mbll_cur): Mbll_h
            set(Mbll_first): 1
            while(_): {Mbll_cur != null} [
                if(_): {Mbll_first = 1} [
                    set(Mbll_first): 0
                    len(Mbll_cl): Mbll_cur
                    if(_): {Mbll_cl >= 3} [
                        slice(Mbll_head): Mbll_cur 0 3
                        if(_): {Mbll_head = Mbl_bom_text} [
                            set(Mbl_bom): 1
                            slice(Mbll_cur): Mbll_cur 3 {Mbll_cl - 3}
                        ]
                    ]
                ]
                push(_): Mbl_buf Mbll_cur
                read_line(Mbll_cur): Mbll_h
            ]
            close_file(_): Mbll_h
        ]
    ]
    len(Mbll_bn): Mbl_buf
    if(_): {Mbll_bn = 0} [
        push(_): Mbl_buf ""
    ]
    set(Mbl_cx): 0
    set(Mbl_cy): 0
    set(Mbl_top): 0
    set(r): 0
]

Mbl_save(r): [
    set(r): 0
    len(Mblw_fn): Mbl_file
    if(_): {Mblw_fn = 0} [
        set(Mbl_msg): "no file name"
    ]
    if(_): {Mblw_fn > 0} [
        set(Mbl_payload): ""
        if(_): {Mbl_bom = 1} [
            set(Mbl_payload): Mbl_bom_text
        ]
        len(Mblw_n): Mbl_buf
        set(Mblw_i): 0
        while(_): {Mblw_i < Mblw_n} [
            at(Mblw_l): Mbl_buf Mblw_i
            concat(Mbl_payload): Mbl_payload Mblw_l
            concat(Mbl_payload): Mbl_payload "\n"
            set(Mblw_i): {Mblw_i + 1}
        ]
        writefile(Mblw_ok): Mbl_file Mbl_payload
        set(Mbl_dirty): 0
        set(Mbl_msg): "written"
    ]
]

# ---------- render ----------

Mbl_render(r): [
    set(Mblrn_s): Mbl_esc
    concat(Mblrn_s): Mblrn_s "[H"
    len(Mblrn_n): Mbl_buf
    set(Mblrn_row): 0
    set(Mblrn_last): {Mbl_rows - 1}
    while(_): {Mblrn_row < Mblrn_last} [
        set(Mblrn_li): {Mblrn_row + Mbl_top}
        set(Mblrn_has): 0
        if(_): {Mblrn_li < Mblrn_n} [
            set(Mblrn_has): 1
            at(Mblrn_l): Mbl_buf Mblrn_li
            # cut at Mbl_cols characters, never inside a UTF-8 sequence
            utf8_index(Mblrn_cut): Mblrn_l Mbl_cols
            len(Mblrn_ll): Mblrn_l
            if(_): {Mblrn_cut < Mblrn_ll} [
                slice(Mblrn_l): Mblrn_l 0 Mblrn_cut
            ]
            concat(Mblrn_s): Mblrn_s Mblrn_l
        ]
        if(_): {Mblrn_has = 0} [
            concat(Mblrn_s): Mblrn_s "~"
        ]
        concat(Mblrn_s): Mblrn_s Mbl_esc
        concat(Mblrn_s): Mblrn_s "[K"
        concat(Mblrn_s): Mblrn_s "\r\n"
        set(Mblrn_row): {Mblrn_row + 1}
    ]
    concat(Mblrn_s): Mblrn_s Mbl_esc
    concat(Mblrn_s): Mblrn_s "[7m"
    if(_): {Mbl_mode = 2} [
        concat(Mblrn_s): Mblrn_s Mbl_msg
    ]
    if(_): {Mbl_mode < 2} [
        concat(Mblrn_s): Mblrn_s " "
        if(_): {Mbl_mode = 0} [
            concat(Mblrn_s): Mblrn_s "NORMAL"
        ]
        if(_): {Mbl_mode = 1} [
            concat(Mblrn_s): Mblrn_s "INSERT"
        ]
        concat(Mblrn_s): Mblrn_s "  "
        concat(Mblrn_s): Mblrn_s Mbl_showname
        if(_): {Mbl_dirty = 1} [
            concat(Mblrn_s): Mblrn_s " [+]"
        ]
        if(_): {Mbl_dirty = 0} [
            concat(Mblrn_s): Mblrn_s "    "
        ]
        concat(Mblrn_s): Mblrn_s "  "
        concat(Mblrn_s): Mblrn_s Mbl_msg
    ]
    concat(Mblrn_s): Mblrn_s Mbl_esc
    concat(Mblrn_s): Mblrn_s "[0m"
    concat(Mblrn_s): Mblrn_s Mbl_esc
    concat(Mblrn_s): Mblrn_s "[K"
    concat(Mblrn_s): Mblrn_s Mbl_esc
    concat(Mblrn_s): Mblrn_s "["
    encode(Mblrn_y): {Mbl_cy - Mbl_top + 1}
    concat(Mblrn_s): Mblrn_s Mblrn_y
    concat(Mblrn_s): Mblrn_s ";"
    at(Mblrn_cl): Mbl_buf Mbl_cy
    utf8_column(Mblrn_col): Mblrn_cl Mbl_cx
    encode(Mblrn_x): {Mblrn_col + 1}
    concat(Mblrn_s): Mblrn_s Mblrn_x
    concat(Mblrn_s): Mblrn_s "H"
    template(_): "STR" Mblrn_s
    set(r): 0
]

# ---------- input queue ----------

Mbl_next(r): [
    set(Mblnx_have): 0
    if(_): {Mbl_pb > 0 - 1} [
        set(Mblnx_have): 1
        set(r): Mbl_pb
        set(Mbl_pb): {0 - 1}
    ]
    if(_): {Mblnx_have = 0} [
        terminal_getch(Mblnx_b):
        set(r): Mblnx_b
    ]
]

# Completes the character whose first byte is b: reads the UTF-8
# continuation bytes and returns the whole character as a string, or ""
# for a stray continuation byte or a control byte.
Mbl_readchar(r): b [
    set(r): ""
    if(_): {b > 31 && b < 127} [
        chr(r): b
    ]
    elif(_): {b >= 192 && b < 248} [
        utf8_len(Mblrc_k): b
        chr(r): b
        set(Mblrc_i): 1
        while(_): {Mblrc_i < Mblrc_k} [
            Mbl_next(Mblrc_b):
            if(_): {Mblrc_b >= 128 && Mblrc_b < 192} [
                chr(Mblrc_c): Mblrc_b
                concat(r): r Mblrc_c
                set(Mblrc_i): {Mblrc_i + 1}
            ]
            else(_): [
                # broken sequence: drop it and replay the byte
                set(r): ""
                if(_): {Mblrc_b > 0 - 1} [
                    set(Mbl_pb): Mblrc_b
                ]
                set(Mblrc_i): Mblrc_k
            ]
        ]
    ]
]

# ---------- words ----------

# Character class at byte i of line: 0 blank, 1 word, 2 punctuation.
# Word characters are ASCII letters, digits, "_" and non-ASCII letters
# (Cyrillic included). Latin-1 symbols (U+0080..U+00BF, e.g. << >>) and
# general punctuation (U+2000..U+206F, e.g. dashes, quotes, ellipsis) are
# punctuation; the no-break space U+00A0 is blank.
Mbl_class(r): line i [
    byte(Mblcl_b): line i
    set(r): 2
    if(_): {Mblcl_b = 32 || Mblcl_b = 9} [
        set(r): 0
    ]
    elif(_): {(Mblcl_b >= 48 && Mblcl_b <= 57) || (Mblcl_b >= 65 && Mblcl_b <= 90) || (Mblcl_b >= 97 && Mblcl_b <= 122) || Mblcl_b = 95} [
        set(r): 1
    ]
    elif(_): {Mblcl_b >= 192} [
        set(r): 1
        len(Mblcl_n): line
        if(_): {Mblcl_b = 194 && i + 1 < Mblcl_n} [
            byte(Mblcl_b2): line {i + 1}
            set(r): 2
            if(_): {Mblcl_b2 = 160} [
                set(r): 0
            ]
        ]
        if(_): {Mblcl_b = 226 && i + 1 < Mblcl_n} [
            byte(Mblcl_b2): line {i + 1}
            if(_): {Mblcl_b2 = 128 || Mblcl_b2 = 129} [
                set(r): 2
            ]
        ]
    ]
]

# Byte index just past the end of `count` words starting at byte i, staying
# inside the line. On blanks the first "word" is the run of blanks.
Mbl_word_end(r): line i count [
    len(Mblwe_n): line
    set(r): i
    set(Mblwe_k): 0
    while(_): {Mblwe_k < count && r < Mblwe_n} [
        if(_): {Mblwe_k > 0} [
            set(Mblwe_go): true
            while(_): {Mblwe_go && r < Mblwe_n} [
                Mbl_class(Mblwe_c): line r
                set(Mblwe_go): {Mblwe_c = 0}
                if(_): Mblwe_go [
                    utf8_next(r): line r
                ]
            ]
        ]
        if(_): {r < Mblwe_n} [
            Mbl_class(Mblwe_start): line r
            set(Mblwe_go): true
            while(_): {Mblwe_go && r < Mblwe_n} [
                Mbl_class(Mblwe_c): line r
                set(Mblwe_go): {Mblwe_c = Mblwe_start}
                if(_): Mblwe_go [
                    utf8_next(r): line r
                ]
            ]
        ]
        set(Mblwe_k): {Mblwe_k + 1}
    ]
]

# w: start of the next word, continuing on following lines like vi.
Mbl_word_forward(r): [
    at(Mblwf_l): Mbl_buf Mbl_cy
    len(Mblwf_n): Mblwf_l
    set(Mblwf_i): Mbl_cx
    if(_): {Mblwf_i < Mblwf_n} [
        Mbl_class(Mblwf_start): Mblwf_l Mblwf_i
        if(_): {Mblwf_start != 0} [
            Mbl_word_end(Mblwf_i): Mblwf_l Mblwf_i 1
        ]
    ]
    set(Mblwf_found): false
    while(_): {Mblwf_found = false} [
        # skip blanks on this line
        set(Mblwf_go): {Mblwf_i < Mblwf_n}
        while(_): Mblwf_go [
            Mbl_class(Mblwf_c): Mblwf_l Mblwf_i
            set(Mblwf_go): {Mblwf_c = 0}
            if(_): Mblwf_go [
                utf8_next(Mblwf_i): Mblwf_l Mblwf_i
                set(Mblwf_go): {Mblwf_i < Mblwf_n}
            ]
        ]
        len(Mblwf_lines): Mbl_buf
        if(_): {Mblwf_i < Mblwf_n} [
            set(Mblwf_found): true
        ]
        elif(_): {Mbl_cy + 1 < Mblwf_lines} [
            # an empty line counts as a word start; otherwise go on
            set(Mbl_cy): {Mbl_cy + 1}
            at(Mblwf_l): Mbl_buf Mbl_cy
            len(Mblwf_n): Mblwf_l
            set(Mblwf_i): 0
            if(_): {Mblwf_n = 0} [
                set(Mblwf_found): true
            ]
        ]
        else(_): [
            # end of file: rest on the last character
            set(Mblwf_found): true
        ]
    ]
    set(Mbl_cx): Mblwf_i
    Mbl_fixcx(_):
    Mbl_scroll(_):
    set(r): 0
]

# cw: replaces `count` words from the cursor and enters insert mode.
Mbl_change_word(r): count [
    at(Mblcw_l): Mbl_buf Mbl_cy
    len(Mblcw_n): Mblcw_l
    set(Mbl_mode): 1
    if(_): {Mbl_cx < Mblcw_n} [
        Mbl_word_end(Mblcw_end): Mblcw_l Mbl_cx count
        slice(Mblcw_a): Mblcw_l 0 Mbl_cx
        slice(Mblcw_b): Mblcw_l Mblcw_end {Mblcw_n - Mblcw_end}
        concat(Mblcw_a): Mblcw_a Mblcw_b
        Mbl_setline(_): Mbl_cy Mblcw_a
        set(Mbl_dirty): 1
    ]
    set(r): 0
]

# ---------- mode handlers ----------

Mbl_escape(r): [
    set(Mbl_mode): 0
    set(Mbl_pend): 0
    set(Mbl_count): 0
    Mbl_fixcx(_): 
    set(r): 0
]

Mbl_arrow(r): c [
    set(Mblar_n): Mbl_count
    set(Mbl_count): 0
    set(Mbl_pend): 0
    if(_): {Mblar_n < 1} [
        set(Mblar_n): 1
    ]
    while(_): {Mblar_n > 0} [
        if(_): {c = 65} [
            Mbl_up(_):
        ]
        if(_): {c = 66} [
            Mbl_down(_):
        ]
        if(_): {c = 67} [
            Mbl_right(_):
        ]
        if(_): {c = 68} [
            Mbl_left(_):
        ]
        set(Mblar_n): {Mblar_n - 1}
    ]
    set(r): 0
]

Mbl_insert(r): b [
    set(r): 0
    if(_): {b = 13} [
        Mbl_enter(_): 
    ]
    if(_): {b = 10} [
        Mbl_enter(_): 
    ]
    if(_): {b = 127} [
        Mbl_bs(_): 
    ]
    if(_): {b = 8} [
        Mbl_bs(_): 
    ]
    if(_): {b = 3} [
        Mbl_escape(_): 
    ]
    if(_): {b > 31 && b != 127} [
        Mbl_readchar(Mblin_ch): b
        if(_): {Mblin_ch != ""} [
            Mbl_insch(_): Mblin_ch
        ]
    ]
]

# Normal mode. Digits build Mbl_count (a leading 0 is not a count); the
# next motion or command runs that many times. d and c wait in Mbl_pend
# (1 = d, 2 = c) with their own count in Mbl_pend_count; a count typed
# after the operator multiplies it (2c3w changes six words).
Mbl_normal(r): b [
    set(r): 0
    if(_): {(b >= 49 && b <= 57) || (b = 48 && Mbl_count > 0)} [
        if(_): {Mbl_count < 100000} [
            set(Mbl_count): {Mbl_count * 10 + b - 48}
        ]
        return(_): r
    ]
    set(Mblnm_n): Mbl_count
    set(Mbl_count): 0
    if(_): {Mblnm_n < 1} [
        set(Mblnm_n): 1
    ]
    if(_): {Mbl_pend > 0} [
        set(Mblnm_op): Mbl_pend
        set(Mbl_pend): 0
        set(Mblnm_n): {Mblnm_n * Mbl_pend_count}
        if(_): {Mblnm_op = 1 && b = 100} [
            while(_): {Mblnm_n > 0} [
                Mbl_delete_line(_):
                set(Mblnm_n): {Mblnm_n - 1}
            ]
        ]
        if(_): {Mblnm_op = 2 && b = 119} [
            Mbl_change_word(_): Mblnm_n
        ]
        return(_): r
    ]
    if(_): {b = 100 || b = 99} [
        set(Mbl_pend): 1
        if(_): {b = 99} [
            set(Mbl_pend): 2
        ]
        set(Mbl_pend_count): Mblnm_n
        return(_): r
    ]
    while(_): {Mblnm_n > 0} [
        if(_): {b = 8 || b = 127 || b = 104} [
            Mbl_left(_):
        ]
        elif(_): {b = 108} [
            Mbl_right(_):
        ]
        elif(_): {b = 106} [
            Mbl_down(_):
        ]
        elif(_): {b = 107} [
            Mbl_up(_):
        ]
        elif(_): {b = 119} [
            Mbl_word_forward(_):
        ]
        elif(_): {b = 120} [
            # like vi, a count never deletes past the end of the line
            at(Mblnm_l): Mbl_buf Mbl_cy
            len(Mblnm_len): Mblnm_l
            utf8_next(Mblnm_next): Mblnm_l Mbl_cx
            Mbl_delch(_):
            if(_): {Mblnm_next >= Mblnm_len} [
                set(Mblnm_n): 1
            ]
        ]
        else(_): [
            # not a repeatable command: run it once below
            set(Mblnm_n): 1
        ]
        set(Mblnm_n): {Mblnm_n - 1}
    ]
    if(_): {b = 105} [
        set(Mbl_mode): 1
    ]
    if(_): {b = 97} [
        at(Mblnm_l): Mbl_buf Mbl_cy
        utf8_next(Mbl_cx): Mblnm_l Mbl_cx
        set(Mbl_mode): 1
    ]
    if(_): {b = 111} [
        Mbl_lineins(_): {Mbl_cy + 1} ""
        set(Mbl_cy): {Mbl_cy + 1}
        set(Mbl_cx): 0
        set(Mbl_mode): 1
        set(Mbl_dirty): 1
        Mbl_scroll(_): 
    ]
    if(_): {b = 58} [
        Mbl_command(_): 
    ]
]

# ---------- command line ----------

Mbl_runcmd(r): cmd [
    set(r): 0
    set(Mblrc_ok): 0
    if(_): {cmd = "q"} [
        set(Mblrc_ok): 1
        set(Mbl_running): 0
    ]
    if(_): {cmd = "q!"} [
        set(Mblrc_ok): 1
        set(Mbl_running): 0
    ]
    if(_): {cmd = "w"} [
        set(Mblrc_ok): 1
        Mbl_save(_): 
    ]
    if(_): {cmd = "wq"} [
        set(Mblrc_ok): 1
        Mbl_save(_): 
        set(Mbl_running): 0
    ]
    len(Mblrc_n): cmd
    if(_): {Mblrc_n > 2} [
        slice(Mblrc_p): cmd 0 2
        if(_): {Mblrc_p = "w "} [
            set(Mblrc_ok): 1
            slice(Mbl_file): cmd 2 {Mblrc_n - 2}
            set(Mbl_showname): Mbl_file
            Mbl_save(_): 
        ]
    ]
    if(_): {cmd = "e"} [
        set(Mblrc_ok): 1
        Mbl_load(_): Mbl_file
    ]
    len(Mblrc_n): cmd
    if(_): {Mblrc_n > 2} [
        slice(Mblrc_p2): cmd 0 2
        if(_): {Mblrc_p2 = "e "} [
            set(Mblrc_ok): 1
            slice(Mbl_file): cmd 2 {Mblrc_n - 2}
            set(Mbl_showname): Mbl_file
            Mbl_load(_): Mbl_file
        ]
    ]
    if(_): {Mblrc_ok = 0} [
        set(Mbl_msg): "not an editor command"
    ]
]

Mbl_command(r): [
    set(Mbl_mode): 2
    set(Mbl_msg): ":"
    set(Mblcm_cmd): ""
    set(Mblcm_ok): 0
    set(Mblcm_done): 0
    while(_): {Mblcm_done = 0} [
        Mbl_render(_): 
        Mbl_next(Mblcm_b): 
        if(_): {Mblcm_b < 0} [
            set(Mblcm_done): 1
        ]
        if(_): {Mblcm_b = 13} [
            set(Mblcm_done): 1
            set(Mblcm_ok): 1
        ]
        if(_): {Mblcm_b = 10} [
            set(Mblcm_done): 1
            set(Mblcm_ok): 1
        ]
        if(_): {Mblcm_b = 27} [
            set(Mblcm_done): 1
        ]
        if(_): {Mblcm_b = 3} [
            set(Mblcm_done): 1
        ]
        if(_): {Mblcm_b = 8} [
            set(Mblcm_b): 127
        ]
        if(_): {Mblcm_b = 127} [
            len(Mblcm_cl): Mblcm_cmd
            if(_): {Mblcm_cl > 0} [
                utf8_prev(Mblcm_cut): Mblcm_cmd Mblcm_cl
                slice(Mblcm_cmd): Mblcm_cmd 0 Mblcm_cut
                set(Mbl_msg): ":"
                concat(Mbl_msg): Mbl_msg Mblcm_cmd
            ]
        ]
        if(_): {Mblcm_b > 31 && Mblcm_b != 127} [
            Mbl_readchar(Mblcm_ch): Mblcm_b
            concat(Mblcm_cmd): Mblcm_cmd Mblcm_ch
            concat(Mbl_msg): Mbl_msg Mblcm_ch
        ]
    ]
    set(Mbl_mode): 0
    set(Mbl_msg): ""
    if(_): {Mblcm_ok = 1} [
        Mbl_runcmd(_): Mblcm_cmd
    ]
    set(r): 0
]

# ---------- key dispatch ----------

Mbl_dispatch(r): b [
    set(r): 0
    if(_): {b = 27} [
        Mbl_next(Mbldp_b2): 
        if(_): {Mbldp_b2 = 91} [
            Mbl_next(Mbldp_b3): 
            Mbl_arrow(_): Mbldp_b3
        ]
        if(_): {Mbldp_b2 != 91} [
            Mbl_escape(_): 
            if(_): {Mbldp_b2 > 0 - 1} [
                set(Mbl_pb): Mbldp_b2
            ]
        ]
    ]
    if(_): {b != 27} [
        set(Mbldp_m): Mbl_mode
        if(_): {Mbldp_m = 0} [
            Mbl_normal(_): b
        ]
        if(_): {Mbldp_m = 1} [
            Mbl_insert(_): b
        ]
    ]
]

# ---------- entry ----------

init(ret): arg_cnt arg_vec [
    set(Mbl_file): ""
    set(Mbl_showname): "[No Name]"
    set(Mbl_pb): {0 - 1}
    vec(Mblit_bom): ""
    push(_): Mblit_bom 239
    push(_): Mblit_bom 187
    push(_): Mblit_bom 191
    utf8_from_bytes(Mbl_bom_text): Mblit_bom
    if(_): {arg_cnt > 0} [
        at(Mbl_file): arg_vec 0
        set(Mbl_showname): Mbl_file
    ]
    Mbl_detect(_): 
    Mbl_load(_): Mbl_file
    Mbl_initesc(_): 
    Mbl_termsize(_): 
    set(Mbl_ascii): " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    set(Mbl_inq): ""
    set(Mbl_pb): {0 - 1}
    terminal_raw(Mblit_r1): 
    set(Mbl_mode): 0
    set(Mbl_cx): 0
    set(Mbl_cy): 0
    set(Mbl_top): 0
    set(Mbl_pend): 0
    set(Mbl_pend_count): 1
    set(Mbl_count): 0
    set(Mbl_msg): ""
    set(Mbl_running): 1
    set(Mblit_s): Mbl_esc
    concat(Mblit_s): Mblit_s "[2J"
    concat(Mblit_s): Mblit_s Mbl_esc
    concat(Mblit_s): Mblit_s "[H"
    template(_): "STR" Mblit_s
    while(_): {Mbl_running = 1} [
        Mbl_render(_): 
        Mbl_next(Mbl_b): 
        if(_): {Mbl_b < 0} [
            set(Mbl_running): 0
        ]
        if(_): {Mbl_b > 0 - 1} [
            Mbl_dispatch(_): Mbl_b
        ]
    ]
    terminal_sane(Mblit_r2): 
    set(Mblit_s2): Mbl_esc
    concat(Mblit_s2): Mblit_s2 "[2J"
    concat(Mblit_s2): Mblit_s2 Mbl_esc
    concat(Mblit_s2): Mblit_s2 "[H"
    template(_): "STR" Mblit_s2
    set(ret): 0
]
