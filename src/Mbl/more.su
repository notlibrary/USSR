# more.su - Mbl refine pass 1: motions, operators, text objects,
# registers, search, ex commands, macros, repeat, marks and settings.
# Mbl.su includes this file and calls into it from Mbl_next, Mbl_normal,
# Mbl_insert, Mbl_runcmd, Mbl_load, Mbl_save and Mbl_render.
#
# Normal mode (with counts):
#   b e W B E 0 ^ $ gg G NG f F t T ; , % { } H M L    motions
#   Ctrl+D Ctrl+U Ctrl+F Ctrl+B  half and full pages;  zz zt zb  recentre
#   d c y g~ gu gU > <  + motion or text object (iw aw iW aW i" a" i' a'
#                 i( a( ib i[ a[ i{ a{ iB i< a<); dd cc yy >> << g~~ guu
#                 gUU work on lines
#   D C Y s S X r ~ J gJ p P  .  q{a-z} @{a-z} @@  m{a-z} '{a-z} `{a-z}
#   / ? n N * #   search (regex); Ctrl+A Ctrl+X  add to the number
#   "{a-z}        names the register of the next d/c/y/p/P
# Insert mode: Tab inserts a tab (or spaces with :set et), Ctrl+W deletes
#   a word, Ctrl+U to the line start, Enter keeps the indent with :set ai.
# Ex commands: :N  :x  :sav F  :r F  :noh  :reg  :marks
#   [range]d|y|>|<|j|s/pat/rep/[g][i]|g/pat/d|v/pat/d|sort [n] [u] [r]
#   ranges: N  N,M  .  $  %  'a  .+N  $-N
#   :set nu|nonu|ai|noai|et|noet|ic|noic|ws|nows|ts=N|sw=N|ff=dos|ff=unix|ro|noro
# Files: CRLF line ends are kept (ff), writes go through a temporary file,
#   "+N file" opens at line N, -R opens read-only.

global(_): Mbl_kq Mbl_kq_pos Mbl_keylog Mbl_dot Mbl_rec_reg Mbl_rec Mbl_macros Mbl_last_macro
global(_): Mbl_regs Mbl_reg_name Mbl_marks Mbl_search Mbl_search_back Mbl_find
global(_): Mbl_opt_nu Mbl_opt_ai Mbl_opt_et Mbl_opt_ic Mbl_opt_ws Mbl_opt_ts Mbl_opt_sw
global(_): Mbl_crlf Mbl_ro Mbl_cmd_start Mbl_cmd_ver Mbl_replaying

Mbl_more_init(r): [
    vec(Mbl_kq): ""
    set(Mbl_kq_pos): 0
    vec(Mbl_keylog): ""
    vec(Mbl_dot): ""
    set(Mbl_rec_reg): ""
    vec(Mbl_rec): ""
    btree(Mbl_macros):
    set(Mbl_last_macro): ""
    btree(Mbl_regs):
    set(Mbl_reg_name): ""
    btree(Mbl_marks):
    set(Mbl_search): ""
    set(Mbl_search_back): false
    set(Mbl_find): ""
    set(Mbl_opt_nu): false
    set(Mbl_opt_ai): false
    set(Mbl_opt_et): false
    set(Mbl_opt_ic): false
    set(Mbl_opt_ws): true
    set(Mbl_opt_ts): 8
    set(Mbl_opt_sw): 4
    set(Mbl_crlf): false
    set(Mbl_ro): false
    set(Mbl_cmd_start): 0
    set(Mbl_cmd_ver): 0
    set(Mbl_replaying): false
    set(r): 0
]

# ---------- the key queue (macros, ., mappings) ----------

Mbl_queue_keys(r): keys [
    len(n): keys
    set(i): 0
    vec(fresh): ""
    # the new keys come first, then whatever was still queued
    while(_): {i < n} [
        at(b): keys i
        push(_): fresh b
        set(i): {i + 1}
    ]
    len(m): Mbl_kq
    set(i): Mbl_kq_pos
    while(_): {i < m} [
        at(b): Mbl_kq i
        push(_): fresh b
        set(i): {i + 1}
    ]
    set(Mbl_kq): fresh
    set(Mbl_kq_pos): 0
    set(r): 0
]

# a queued key, or -2 when the queue is empty
Mbl_queue_next(r): [
    set(r): {0 - 2}
    len(n): Mbl_kq
    if(_): {Mbl_kq_pos < n} [
        at(r): Mbl_kq Mbl_kq_pos
        set(Mbl_kq_pos): {Mbl_kq_pos + 1}
        if(_): {Mbl_kq_pos >= n} [
            vec(Mbl_kq): ""
            set(Mbl_kq_pos): 0
        ]
    ]
]

Mbl_log_key(r): b [
    push(_): Mbl_keylog b
    if(_): {Mbl_rec_reg != ""} [
        push(_): Mbl_rec b
    ]
    set(r): 0
]

# called by the main loop around each dispatched key: keeps the keys of
# the last change for "."
Mbl_cmd_begin(r): [
    if(_): {Mbl_mode = 0 && Mbl_count = 0 && Mbl_pend = 0} [
        len(n): Mbl_keylog
        set(Mbl_cmd_start): {n - 1}
        set(Mbl_cmd_ver): Mbl_ver
    ]
    set(r): 0
]

Mbl_cmd_end(r): [
    set(r): 0
    if(_): {Mbl_mode = 0 && Mbl_count = 0 && Mbl_pend = 0} [
        len(n): Mbl_keylog
        # a key read ahead and pushed back (after ESC) starts the next command
        set(ahead): {Mbl_pb > 0 - 1 && n > 0}
        if(_): ahead [
            set(n): {n - 1}
        ]
        if(_): {Mbl_ver != Mbl_cmd_ver && Mbl_cmd_start >= 0 && Mbl_cmd_start < n} [
            at(first): Mbl_keylog Mbl_cmd_start
            # u, Ctrl+R, :, . and @ are not repeated by .
            if(_): {first != 117 && first != 18 && first != 58 && first != 46 && first != 64} [
                vec(Mbl_dot): ""
                set(i): Mbl_cmd_start
                while(_): {i < n} [
                    at(b): Mbl_keylog i
                    push(_): Mbl_dot b
                    set(i): {i + 1}
                ]
            ]
        ]
        if(_): ahead [
            at(last): Mbl_keylog n
            vec(Mbl_keylog): ""
            push(_): Mbl_keylog last
        ]
        else(_): [
            vec(Mbl_keylog): ""
        ]
        set(Mbl_cmd_start): 0
    ]
]

# ---------- small helpers ----------

Mbl_line(r): y [
    at(r): Mbl_buf y
]

Mbl_nlines(r): [
    len(r): Mbl_buf
]

Mbl_indent_of(r): line [
    re_find(m): "^[ \\t]*" line
    set(r): ""
    typeof(t): m
    if(_): {t = "vector"} [
        at(r): m 0
    ]
]

Mbl_first_nonblank(r): line [
    Mbl_indent_of(ind): line
    len(r): ind
    len(n): line
    if(_): {r >= n && n > 0} [
        utf8_prev(r): line n
    ]
]

Mbl_last_char(r): line [
    len(n): line
    set(r): 0
    if(_): {n > 0} [
        utf8_prev(r): line n
    ]
]

Mbl_reg_set(r): text linewise [
    vec(v): ""
    push(_): v text
    push(_): v linewise
    set(name): Mbl_reg_name
    if(_): {name = ""} [
        set(name): "\""
    ]
    btput(_): Mbl_regs name v
    btput(_): Mbl_regs "\"" v
    set(Mbl_reg_name): ""
    set(r): 0
]

Mbl_reg_get(r): [
    set(name): Mbl_reg_name
    if(_): {name = ""} [
        set(name): "\""
    ]
    set(Mbl_reg_name): ""
    btget(r): Mbl_regs name null
]

# ---------- motions ----------

# A motion from the cursor: [found y x linewise inclusive]; it may read
# more keys (f x, g g, ...). count >= 1.
Mbl_motion(r): b count [
    set(y): Mbl_cy
    set(x): Mbl_cx
    set(found): true
    set(linewise): false
    set(inclusive): false
    Mbl_line(line): y
    len(n): line
    Mbl_nlines(nl):
    if(_): {b = 104 || b = 8 || b = 127} [
        set(k): 0
        while(_): {k < count && x > 0} [
            utf8_prev(x): line x
            set(k): {k + 1}
        ]
    ]
    elif(_): {b = 108 || b = 32} [
        set(k): 0
        while(_): {k < count && x < n} [
            utf8_next(x): line x
            set(k): {k + 1}
        ]
    ]
    elif(_): {b = 106 || b = 107} [
        set(linewise): true
        if(_): {b = 106} [
            set(y): {y + count}
        ]
        else(_): [
            set(y): {y - count}
        ]
        if(_): {y < 0} [
            set(y): 0
        ]
        if(_): {y >= nl} [
            set(y): {nl - 1}
        ]
    ]
    elif(_): {b = 48} [
        set(x): 0
    ]
    elif(_): {b = 94} [
        Mbl_first_nonblank(x): line
    ]
    elif(_): {b = 36} [
        set(y): {y + count - 1}
        if(_): {y >= nl} [
            set(y): {nl - 1}
        ]
        Mbl_line(l2): y
        Mbl_last_char(x): l2
        set(inclusive): true
    ]
    elif(_): {b = 119 || b = 87} [
        set(k): 0
        while(_): {k < count} [
            Mbl_word_next_pos(p): y x {b = 87}
            at(y): p 0
            at(x): p 1
            set(k): {k + 1}
        ]
    ]
    elif(_): {b = 98 || b = 66} [
        set(k): 0
        while(_): {k < count} [
            Mbl_word_back_pos(p): y x {b = 66}
            at(y): p 0
            at(x): p 1
            set(k): {k + 1}
        ]
    ]
    elif(_): {b = 101 || b = 69} [
        set(k): 0
        while(_): {k < count} [
            Mbl_word_end_pos(p): y x {b = 69}
            at(y): p 0
            at(x): p 1
            set(k): {k + 1}
        ]
        set(inclusive): true
    ]
    elif(_): {b = 71} [
        set(linewise): true
        set(y): {nl - 1}
        if(_): {Mbl_count_given} [
            set(y): {count - 1}
        ]
        if(_): {y >= nl} [
            set(y): {nl - 1}
        ]
        Mbl_line(l2): y
        Mbl_first_nonblank(x): l2
    ]
    elif(_): {b = 103} [
        Mbl_next(b2):
        if(_): {b2 = 103} [
            set(linewise): true
            set(y): {count - 1}
            if(_): {y >= nl} [
                set(y): {nl - 1}
            ]
            Mbl_line(l2): y
            Mbl_first_nonblank(x): l2
        ]
        elif(_): {b2 = 101 || b2 = 69} [
            set(k): 0
            while(_): {k < count} [
                Mbl_word_end_back_pos(p): y x {b2 = 69}
                at(y): p 0
                at(x): p 1
                set(k): {k + 1}
            ]
            set(inclusive): true
        ]
        else(_): [
            set(found): false
        ]
    ]
    elif(_): {b = 102 || b = 70 || b = 116 || b = 84} [
        Mbl_next(cb):
        Mbl_readchar(ch): cb
        set(found): {ch != ""}
        if(_): found [
            chr(kind): b
            concat(Mbl_find): kind ch
            Mbl_find_pos(p): Mbl_find count false
            at(found): p 0
            at(x): p 1
            set(inclusive): {b = 102 || b = 116}
        ]
    ]
    elif(_): {b = 59 || b = 44} [
        set(found): {Mbl_find != ""}
        if(_): found [
            Mbl_find_pos(p): Mbl_find count {b = 44}
            at(found): p 0
            at(x): p 1
            slice(kind): Mbl_find 0 1
            set(inclusive): {kind = "f" || kind = "t"}
            if(_): {b = 44} [
                set(inclusive): {kind = "F" || kind = "T"}
                set(inclusive): false
            ]
        ]
    ]
    elif(_): {b = 37} [
        Mbl_match_pos(p): y x
        at(found): p 0
        at(y): p 1
        at(x): p 2
        set(inclusive): true
    ]
    elif(_): {b = 125 || b = 123} [
        set(k): 0
        while(_): {k < count} [
            if(_): {b = 125} [
                set(y): {y + 1}
                set(go): {y < nl - 1}
                while(_): go [
                    Mbl_line(l2): y
                    str_trim(t2): l2
                    set(go): {t2 != "" && y < nl - 1}
                    if(_): go [
                        set(y): {y + 1}
                    ]
                ]
                if(_): {y >= nl} [
                    set(y): {nl - 1}
                ]
            ]
            else(_): [
                set(y): {y - 1}
                set(go): {y > 0}
                while(_): go [
                    Mbl_line(l2): y
                    str_trim(t2): l2
                    set(go): {t2 != "" && y > 0}
                    if(_): go [
                        set(y): {y - 1}
                    ]
                ]
                if(_): {y < 0} [
                    set(y): 0
                ]
            ]
            set(k): {k + 1}
        ]
        set(x): 0
    ]
    elif(_): {b = 72 || b = 77 || b = 76} [
        set(linewise): true
        set(rows): {Mbl_rows - 1}
        set(last): {Mbl_top + rows - 1}
        if(_): {last >= nl} [
            set(last): {nl - 1}
        ]
        if(_): {b = 72} [
            set(y): {Mbl_top + count - 1}
        ]
        elif(_): {b = 76} [
            set(y): {last - count + 1}
        ]
        else(_): [
            str_trunc(y): {(Mbl_top + last) / 2}
        ]
        if(_): {y > last} [
            set(y): last
        ]
        if(_): {y < Mbl_top} [
            set(y): Mbl_top
        ]
        Mbl_line(l2): y
        Mbl_first_nonblank(x): l2
    ]
    elif(_): {b = 39 || b = 96} [
        Mbl_next(mb):
        chr(mk): mb
        btget(m): Mbl_marks mk null
        typeof(mt): m
        set(found): {mt = "vector"}
        if(_): found [
            at(y): m 0
            at(x): m 1
            if(_): {y >= nl} [
                set(y): {nl - 1}
            ]
            if(_): {b = 39} [
                set(linewise): true
                Mbl_line(l2): y
                Mbl_first_nonblank(x): l2
            ]
        ]
    ]
    else(_): [
        set(found): false
    ]
    vec(r): ""
    push(_): r found
    push(_): r y
    push(_): r x
    push(_): r linewise
    push(_): r inclusive
]

# class of the character at (y, x), with big words seeing only blanks
Mbl_cls(r): line x big [
    len(n): line
    set(r): 0
    if(_): {x < n} [
        Mbl_class(r): line x
        if(_): {big && r != 0} [
            set(r): 1
        ]
    ]
]

Mbl_word_next_pos(r): y x big [
    Mbl_nlines(nl):
    Mbl_line(line): y
    len(n): line
    Mbl_cls(c): line x big
    if(_): {c != 0} [
        set(go): true
        while(_): go [
            utf8_next(x): line x
            Mbl_cls(c2): line x big
            set(go): {x < n && c2 = c}
        ]
    ]
    set(go): true
    while(_): go [
        if(_): {x >= n} [
            if(_): {y + 1 < nl} [
                set(y): {y + 1}
                Mbl_line(line): y
                len(n): line
                set(x): 0
                if(_): {n = 0} [
                    set(go): false
                ]
            ]
            else(_): [
                set(go): false
            ]
        ]
        else(_): [
            Mbl_cls(c2): line x big
            if(_): {c2 = 0} [
                utf8_next(x): line x
            ]
            else(_): [
                set(go): false
            ]
        ]
    ]
    vec(r): ""
    push(_): r y
    push(_): r x
]

Mbl_word_back_pos(r): y x big [
    Mbl_line(line): y
    # step back once, over blanks and line starts
    set(go): true
    while(_): go [
        if(_): {x = 0} [
            if(_): {y > 0} [
                set(y): {y - 1}
                Mbl_line(line): y
                len(x): line
                if(_): {x = 0} [
                    set(go): false
                ]
            ]
            else(_): [
                set(go): false
            ]
        ]
        else(_): [
            utf8_prev(x): line x
            Mbl_cls(c): line x big
            if(_): {c != 0} [
                set(go): false
            ]
        ]
    ]
    len(n): line
    if(_): {n > 0 && x < n} [
        Mbl_cls(c): line x big
        set(go): {x > 0}
        while(_): go [
            utf8_prev(px): line x
            Mbl_cls(pc): line px big
            if(_): {pc = c && c != 0} [
                set(x): px
                set(go): {x > 0}
            ]
            else(_): [
                set(go): false
            ]
        ]
    ]
    vec(r): ""
    push(_): r y
    push(_): r x
]

Mbl_word_end_pos(r): y x big [
    Mbl_nlines(nl):
    Mbl_line(line): y
    len(n): line
    # move at least one character, then over blanks and lines
    utf8_next(x): line x
    set(go): true
    while(_): go [
        if(_): {x >= n} [
            if(_): {y + 1 < nl} [
                set(y): {y + 1}
                Mbl_line(line): y
                len(n): line
                set(x): 0
            ]
            else(_): [
                Mbl_last_char(x): line
                set(go): false
            ]
        ]
        else(_): [
            Mbl_cls(c): line x big
            if(_): {c = 0} [
                utf8_next(x): line x
            ]
            else(_): [
                set(go): false
            ]
        ]
    ]
    if(_): {x < n} [
        Mbl_cls(c): line x big
        set(go): true
        while(_): go [
            utf8_next(nx): line x
            Mbl_cls(nc): line nx big
            if(_): {nx < n && nc = c} [
                set(x): nx
            ]
            else(_): [
                set(go): false
            ]
        ]
    ]
    vec(r): ""
    push(_): r y
    push(_): r x
]

Mbl_word_end_back_pos(r): y x big [
    Mbl_line(line): y
    len(n): line
    set(c0): 0
    if(_): {x < n} [
        Mbl_cls(c0): line x big
    ]
    # leave the current word, then skip blanks backwards
    set(go): true
    while(_): go [
        if(_): {x = 0} [
            if(_): {y > 0} [
                set(y): {y - 1}
                Mbl_line(line): y
                len(n): line
                set(x): n
                if(_): {n = 0} [
                    set(go): false
                ]
            ]
            else(_): [
                set(go): false
            ]
        ]
        else(_): [
            utf8_prev(x): line x
            Mbl_cls(c): line x big
            if(_): {c != 0 && c != c0} [
                set(go): false
            ]
            if(_): {c = 0} [
                set(c0): 0
            ]
        ]
    ]
    vec(r): ""
    push(_): r y
    push(_): r x
]

# f F t T on the cursor line: [found x]
Mbl_find_pos(r): spec count reverse [
    slice(kind): spec 0 1
    len(sl): spec
    slice(ch): spec 1 {sl - 1}
    Mbl_line(line): Mbl_cy
    len(n): line
    set(forward): {kind = "f" || kind = "t"}
    if(_): reverse [
        set(forward): {forward = false}
    ]
    set(till): {kind = "t" || kind = "T"}
    set(x): Mbl_cx
    set(k): 0
    set(found): true
    while(_): {found && k < count} [
        set(hit): false
        set(p): x
        set(go): true
        while(_): {go && hit = false} [
            if(_): forward [
                utf8_next(np): line p
                set(go): {np > p && np < n}
                set(p): np
            ]
            else(_): [
                set(go): {p > 0}
                if(_): go [
                    utf8_prev(p): line p
                ]
            ]
            if(_): go [
                utf8_next(e): line p
                slice(c): line p {e - p}
                if(_): {c = ch} [
                    set(hit): true
                ]
            ]
        ]
        if(_): hit [
            set(x): p
        ]
        else(_): [
            set(found): false
        ]
        set(k): {k + 1}
    ]
    if(_): {found && till} [
        if(_): forward [
            utf8_prev(x): line x
        ]
        else(_): [
            utf8_next(x): line x
        ]
    ]
    vec(r): ""
    push(_): r found
    push(_): r x
]

# % : the bracket matching the first one at or after the cursor
Mbl_match_pos(r): y x [
    set(open): "([{"
    set(close): ")]}"
    Mbl_line(line): y
    len(n): line
    set(at_): {0 - 1}
    set(p): x
    while(_): {at_ < 0 && p < n} [
        at(c): line p
        str_find(io): open c 0
        str_find(ic): close c 0
        if(_): {io >= 0 || ic >= 0} [
            set(at_): p
        ]
        else(_): [
            set(p): {p + 1}
        ]
    ]
    vec(r): ""
    if(_): {at_ < 0} [
        push(_): r false
        push(_): r y
        push(_): r x
        return(r): r
    ]
    at(c): line at_
    str_find(io): open c 0
    set(forward): {io >= 0}
    if(_): forward [
        at(mate): close io
    ]
    else(_): [
        str_find(ic): close c 0
        at(mate): open ic
    ]
    set(depth): 0
    set(cy): y
    set(cx): at_
    Mbl_nlines(nl):
    set(found): false
    set(go): true
    while(_): go [
        Mbl_line(l2): cy
        len(n2): l2
        if(_): {cx >= 0 && cx < n2} [
            at(ch): l2 cx
            if(_): {ch = c} [
                set(depth): {depth + 1}
            ]
            elif(_): {ch = mate} [
                set(depth): {depth - 1}
                if(_): {depth = 0} [
                    set(found): true
                    set(go): false
                ]
            ]
        ]
        if(_): go [
            if(_): forward [
                set(cx): {cx + 1}
                if(_): {cx >= n2} [
                    set(cy): {cy + 1}
                    set(cx): 0
                    if(_): {cy >= nl} [
                        set(go): false
                    ]
                    else(_): [
                        set(cx): {0 - 1}
                        set(cx): 0
                        Mbl_line(l3): cy
                        len(n3): l3
                        if(_): {n3 = 0} [
                            set(cx): {0 - 1}
                        ]
                    ]
                ]
            ]
            else(_): [
                set(cx): {cx - 1}
                while(_): {cx < 0 && go} [
                    set(cy): {cy - 1}
                    if(_): {cy < 0} [
                        set(go): false
                    ]
                    else(_): [
                        Mbl_line(l3): cy
                        len(n3): l3
                        set(cx): {n3 - 1}
                    ]
                ]
            ]
        ]
        if(_): {cx < 0 && go && forward} [
            set(cy): {cy + 1}
            set(cx): 0
            if(_): {cy >= nl} [
                set(go): false
            ]
        ]
    ]
    push(_): r found
    push(_): r cy
    push(_): r cx
]

