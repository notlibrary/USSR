# ---------- ex commands ----------

# a line address at the start of text: [found line rest]
Mbl_address(r): text [
    vec(r): ""
    set(rest): text
    set(found): true
    set(line): Mbl_cy
    re_find(m): "^([0-9]+|\\.|\\$|'[a-z])(?:([+-])([0-9]*))?" text
    typeof(mt): m
    if(_): {mt != "vector"} [
        re_find(m2): "^([+-])([0-9]*)" text
        typeof(m2t): m2
        if(_): {m2t = "vector"} [
            vec(m): ""
            push(_): m ""
            push(_): m "."
            at(sg): m2 1
            at(nm): m2 2
            push(_): m sg
            push(_): m nm
            at(whole): m2 0
            set(m0): whole
            set(mt): "vector"
        ]
    ]
    else(_): [
        at(m0): m 0
    ]
    if(_): {mt != "vector"} [
        push(_): r false
        push(_): r Mbl_cy
        push(_): r text
        return(r): r
    ]
    at(base): m 1
    Mbl_nlines(nl):
    if(_): {base = "."} [
        set(line): Mbl_cy
    ]
    elif(_): {base = "$"} [
        set(line): {nl - 1}
    ]
    else(_): [
        str_starts(isq): base "'"
        if(_): isq [
            slice(mk): base 1 1
            btget(pos): Mbl_marks mk null
            typeof(pt): pos
            if(_): {pt = "vector"} [
                at(line): pos 0
            ]
            else(_): [
                set(found): false
            ]
        ]
        else(_): [
            str_to_int(ln): base 10
            set(line): {ln - 1}
        ]
    ]
    at(sign): m 2
    typeof(st): sign
    if(_): {st = "string"} [
        if(_): {sign != ""} [
            at(num): m 3
            set(d): 1
            if(_): {num != ""} [
                str_to_int(d): num 10
            ]
            if(_): {sign = "-"} [
                set(d): {0 - d}
            ]
            set(line): {line + d}
        ]
    ]
    if(_): {line < 0} [
        set(line): 0
    ]
    if(_): {line >= nl} [
        set(line): {nl - 1}
    ]
    len(ml): m0
    len(tl): text
    slice(rest): text ml {tl - ml}
    push(_): r found
    push(_): r line
    push(_): r rest
]

# [has_range y1 y2 rest]
Mbl_range(r): cmd [
    vec(r): ""
    Mbl_nlines(nl):
    str_starts(all): cmd "%"
    if(_): all [
        len(cl): cmd
        slice(rest): cmd 1 {cl - 1}
        push(_): r true
        push(_): r 0
        push(_): r {nl - 1}
        push(_): r rest
        return(r): r
    ]
    Mbl_address(a): cmd
    at(fa): a 0
    if(_): {fa = false} [
        push(_): r false
        push(_): r Mbl_cy
        push(_): r Mbl_cy
        push(_): r cmd
        return(r): r
    ]
    at(y1): a 1
    at(rest): a 2
    set(y2): y1
    str_starts(comma): rest ","
    if(_): comma [
        len(rl): rest
        slice(rest2): rest 1 {rl - 1}
        Mbl_address(b): rest2
        at(fb): b 0
        if(_): fb [
            at(y2): b 1
            at(rest): b 2
        ]
    ]
    if(_): {y2 < y1} [
        set(t): y1
        set(y1): y2
        set(y2): t
    ]
    push(_): r true
    push(_): r y1
    push(_): r y2
    push(_): r rest
]

# :s/pat/rep/flags on lines y1..y2: the number of lines changed
Mbl_substitute(r): y1 y2 spec [
    set(r): 0
    len(n): spec
    if(_): {n < 2} [
        return(r): r
    ]
    slice(delim): spec 0 1
    slice(body): spec 1 {n - 1}
    # split at unescaped delimiters
    vec(parts): ""
    set(cur): ""
    len(bn): body
    set(i): 0
    while(_): {i < bn} [
        at(c): body i
        if(_): {c = "\\" && i + 1 < bn} [
            at(nx): body {i + 1}
            if(_): {nx = delim} [
                concat(cur): cur nx
            ]
            else(_): [
                concat(cur): cur c nx
            ]
            set(i): {i + 2}
        ]
        elif(_): {c = delim} [
            push(_): parts cur
            set(cur): ""
            set(i): {i + 1}
        ]
        else(_): [
            concat(cur): cur c
            set(i): {i + 1}
        ]
    ]
    push(_): parts cur
    len(np): parts
    at(pat): parts 0
    set(rep): ""
    set(flags): ""
    if(_): {np > 1} [
        at(rep): parts 1
    ]
    if(_): {np > 2} [
        at(flags): parts 2
    ]
    if(_): {pat = ""} [
        set(pat): Mbl_search
    ]
    set(Mbl_search): pat
    # vi's & is the whole match
    str_replace(rep): rep "&" "\\0"
    str_contains(global_): flags "g"
    str_contains(icase): flags "i"
    set(fl): ""
    if(_): {icase || Mbl_opt_ic} [
        set(fl): "i"
    ]
    vec(out): ""
    set(y): y1
    set(changed): 0
    set(last): y1
    while(_): {y <= y2} [
        Mbl_line(l): y
        re_test(hit): pat l fl
        if(_): hit [
            if(_): global_ [
                re_replace(nl2): pat l rep fl
            ]
            else(_): [
                re_pos(p): pat l 0 fl
                at(s): p 0
                at(e): p 1
                len(ln): l
                slice(head): l 0 s
                slice(mid): l s {e - s}
                slice(tail): l e {ln - e}
                re_replace(mid2): pat mid rep fl
                concat(nl2): head mid2 tail
            ]
            push(_): out nl2
            set(changed): {changed + 1}
            set(last): y
        ]
        else(_): [
            push(_): out l
        ]
        set(y): {y + 1}
    ]
    if(_): {changed > 0} [
        Mbl_replace_lines(_): y1 y2 out
        set(Mbl_cy): last
        set(Mbl_cx): 0
    ]
    set(r): changed
]

Mbl_sort_lines(r): y1 y2 opts [
    vec(lines): ""
    set(y): y1
    while(_): {y <= y2} [
        Mbl_line(l): y
        push(_): lines l
        set(y): {y + 1}
    ]
    str_contains(numeric): opts "n"
    str_contains(unique): opts "u"
    str_contains(rev): opts "r"
    if(_): numeric [
        # sort by the first number in each line (lines without one first)
        vec(keyed): ""
        len(n): lines
        set(i): 0
        while(_): {i < n} [
            at(l): lines i
            re_find(m): "-?[0-9]+" l
            set(key): {0 - 9000000000000000000}
            typeof(mt): m
            if(_): {mt = "vector"} [
                at(ks): m 0
                str_to_int(key): ks 10
            ]
            vec(pair): ""
            push(_): pair key
            push(_): pair i
            push(_): keyed pair
            set(i): {i + 1}
        ]
        # stable insertion by key
        vec(order): ""
        set(i): 0
        while(_): {i < n} [
            at(pr): keyed i
            at(k): pr 0
            vec(next): ""
            set(placed): false
            len(m): order
            set(j): 0
            while(_): {j < m} [
                at(q): order j
                at(qk): q 0
                if(_): {placed = false && k < qk} [
                    push(_): next pr
                    set(placed): true
                ]
                push(_): next q
                set(j): {j + 1}
            ]
            if(_): {placed = false} [
                push(_): next pr
            ]
            set(order): next
            set(i): {i + 1}
        ]
        vec(sorted): ""
        set(i): 0
        while(_): {i < n} [
            at(pr): order i
            at(idx): pr 1
            at(l): lines idx
            push(_): sorted l
            set(i): {i + 1}
        ]
    ]
    else(_): [
        list_sort(sorted): lines
    ]
    if(_): rev [
        list_reverse(sorted): sorted
    ]
    if(_): unique [
        vec(u): ""
        len(n): sorted
        set(i): 0
        set(prev): null
        while(_): {i < n} [
            at(l): sorted i
            typeof(pt): prev
            set(dup): false
            if(_): {pt = "string"} [
                set(dup): {prev = l}
            ]
            if(_): {dup = false} [
                push(_): u l
            ]
            set(prev): l
            set(i): {i + 1}
        ]
        set(sorted): u
    ]
    Mbl_replace_lines(_): y1 y2 sorted
    set(Mbl_cy): y1
    set(Mbl_cx): 0
    set(r): 0
]

Mbl_set(r): opt [
    set(r): true
    re_find(m): "^([a-z]+)=([0-9a-z]+)$" opt
    typeof(mt): m
    if(_): {mt = "vector"} [
        at(name): m 1
        at(val): m 2
        str_to_int(nv): val 10
        typeof(nt): nv
        if(_): {(name = "ts" || name = "tabstop") && nt = "integer"} [
            if(_): {nv > 0} [
                set(Mbl_opt_ts): nv
            ]
        ]
        elif(_): {(name = "sw" || name = "shiftwidth") && nt = "integer"} [
            if(_): {nv > 0} [
                set(Mbl_opt_sw): nv
            ]
        ]
        elif(_): {name = "ff" || name = "fileformat"} [
            set(Mbl_crlf): {val = "dos"}
            set(Mbl_dirty): 1
        ]
        else(_): [
            set(r): false
        ]
        return(r): r
    ]
    if(_): {opt = "nu" || opt = "number"} [
        set(Mbl_opt_nu): true
    ]
    elif(_): {opt = "nonu" || opt = "nonumber"} [
        set(Mbl_opt_nu): false
    ]
    elif(_): {opt = "ai" || opt = "autoindent"} [
        set(Mbl_opt_ai): true
    ]
    elif(_): {opt = "noai" || opt = "noautoindent"} [
        set(Mbl_opt_ai): false
    ]
    elif(_): {opt = "et" || opt = "expandtab"} [
        set(Mbl_opt_et): true
    ]
    elif(_): {opt = "noet" || opt = "noexpandtab"} [
        set(Mbl_opt_et): false
    ]
    elif(_): {opt = "ic" || opt = "ignorecase"} [
        set(Mbl_opt_ic): true
    ]
    elif(_): {opt = "noic" || opt = "noignorecase"} [
        set(Mbl_opt_ic): false
    ]
    elif(_): {opt = "ws" || opt = "wrapscan"} [
        set(Mbl_opt_ws): true
    ]
    elif(_): {opt = "nows" || opt = "nowrapscan"} [
        set(Mbl_opt_ws): false
    ]
    elif(_): {opt = "ro" || opt = "readonly"} [
        set(Mbl_ro): true
    ]
    elif(_): {opt = "noro" || opt = "noreadonly"} [
        set(Mbl_ro): false
    ]
    else(_): [
        set(r): false
    ]
]

# true when cmd was one of these
Mbl_more_cmd(r): cmd [
    set(r): true
    str_trim(cmd): cmd
    if(_): {cmd = "x"} [
        if(_): {Mbl_dirty = 1} [
            Mbl_save(_):
        ]
        set(Mbl_running): 0
        return(r): r
    ]
    if(_): {cmd = "noh"} [
        return(r): r
    ]
    str_starts(isset): cmd "set "
    if(_): isset [
        len(cl): cmd
        slice(opts): cmd 4 {cl - 4}
        str_split(list): opts " "
        len(n): list
        set(i): 0
        while(_): {i < n} [
            at(o): list i
            if(_): {o != ""} [
                Mbl_set(ok): o
                if(_): {ok = false} [
                    concat(Mbl_msg): "unknown option: " o
                ]
            ]
            set(i): {i + 1}
        ]
        return(r): r
    ]
    str_starts(issav): cmd "sav "
    if(_): issav [
        len(cl): cmd
        slice(Mbl_file): cmd 4 {cl - 4}
        set(Mbl_showname): Mbl_file
        Mbl_save(_):
        return(r): r
    ]
    str_starts(isread): cmd "r "
    if(_): isread [
        len(cl): cmd
        slice(path): cmd 2 {cl - 2}
        read_lines(lines): path
        typeof(lt): lines
        if(_): {lt = "vector"} [
            Mbl_begin_change(_):
            vec(both): ""
            Mbl_line(cur): Mbl_cy
            push(_): both cur
            len(n): lines
            set(i): 0
            while(_): {i < n} [
                at(l): lines i
                push(_): both l
                set(i): {i + 1}
            ]
            Mbl_replace_lines(_): Mbl_cy Mbl_cy both
            set(Mbl_cy): {Mbl_cy + 1}
            set(Mbl_cx): 0
        ]
        else(_): [
            concat(Mbl_msg): "cannot read " path
        ]
        return(r): r
    ]
    Mbl_range(rg): cmd
    at(has): rg 0
    at(y1): rg 1
    at(y2): rg 2
    at(rest): rg 3
    str_trim(rest): rest
    if(_): {has && rest = ""} [
        # :N goes to a line
        set(Mbl_cy): y2
        Mbl_line(l): y2
        Mbl_first_nonblank(Mbl_cx): l
        Mbl_scroll(_):
        return(r): r
    ]
    if(_): {rest = "d"} [
        Mbl_begin_change(_):
        Mbl_lines_text(t): y1 y2
        Mbl_reg_set(_): t true
        Mbl_del_lines(_): y1 y2
        return(r): r
    ]
    if(_): {rest = "y"} [
        Mbl_lines_text(t): y1 y2
        Mbl_reg_set(_): t true
        return(r): r
    ]
    if(_): {rest = ">" || rest = "<"} [
        Mbl_begin_change(_):
        set(dir): 1
        if(_): {rest = "<"} [
            set(dir): {0 - 1}
        ]
        Mbl_shift_lines(_): y1 y2 dir
        return(r): r
    ]
    if(_): {rest = "j"} [
        set(Mbl_cy): y1
        set(k): {y2 - y1 + 1}
        if(_): {k < 2} [
            set(k): 2
        ]
        Mbl_join(_): k true
        return(r): r
    ]
    len(rl): rest
    str_starts(issort): rest "sort"
    if(_): issort [
        if(_): {has = false} [
            set(y1): 0
            Mbl_nlines(nl):
            set(y2): {nl - 1}
        ]
        slice(opts): rest 4 {rl - 4}
        Mbl_begin_change(_):
        Mbl_sort_lines(_): y1 y2 opts
        return(r): r
    ]
    str_starts(iss): rest "s"
    if(_): {iss && rl > 1} [
        slice(spec): rest 1 {rl - 1}
        Mbl_begin_change(_):
        try(bad): "Mbl_sub_try" y1 y2 spec
        if(_): {bad = 1} [
            set(Mbl_msg): "bad pattern"
        ]
        return(r): r
    ]
    str_starts(isg): rest "g/"
    str_starts(isv): rest "v/"
    if(_): {isg || isv} [
        slice(spec): rest 2 {rl - 2}
        str_ends(isd): spec "/d"
        if(_): isd [
            len(sl): spec
            slice(pat): spec 0 {sl - 2}
            if(_): {has = false} [
                set(y1): 0
                Mbl_nlines(nl):
                set(y2): {nl - 1}
            ]
            Mbl_flags(fl):
            Mbl_begin_change(_):
            vec(keep): ""
            set(y): y1
            set(removed): 0
            while(_): {y <= y2} [
                Mbl_line(l): y
                re_test(hit): pat l fl
                if(_): {hit = isg} [
                    set(removed): {removed + 1}
                ]
                else(_): [
                    push(_): keep l
                ]
                set(y): {y + 1}
            ]
            Mbl_replace_lines(_): y1 y2 keep
            Mbl_nlines(nl):
            set(Mbl_cy): y1
            if(_): {Mbl_cy >= nl} [
                set(Mbl_cy): {nl - 1}
            ]
            set(Mbl_cx): 0
            str_from_int(rs): removed
            concat(Mbl_msg): rs " lines deleted"
            return(r): r
        ]
    ]
    if(_): {cmd = "reg" || cmd = "registers"} [
        btkeys(keys): Mbl_regs
        str_join(Mbl_msg): keys " "
        return(r): r
    ]
    if(_): {cmd = "marks"} [
        btkeys(keys): Mbl_marks
        str_join(Mbl_msg): keys " "
        return(r): r
    ]
    set(r): false
]

Mbl_sub_try(r): y1 y2 spec [
    Mbl_substitute(n): y1 y2 spec
    if(_): {n = 0} [
        set(Mbl_msg): "pattern not found"
    ]
    set(r): 0
]

# ---------- status line ruler ----------

Mbl_ruler(r): [
    Mbl_nlines(nl):
    Mbl_line(l): Mbl_cy
    utf8_column(col): l Mbl_cx
    str_from_int(ys): {Mbl_cy + 1}
    str_from_int(xs): {col + 1}
    str_trunc(pct): {(Mbl_cy + 1) * 100 / nl}
    str_from_int(ps): pct
    concat(r): ys ":" xs " " ps "%"
    if(_): Mbl_crlf [
        concat(r): r " dos"
    ]
    if(_): Mbl_ro [
        concat(r): r " [RO]"
    ]
    if(_): {Mbl_rec_reg != ""} [
        concat(r): r " @" Mbl_rec_reg
    ]
]

Mbl_gutter(r): [
    set(r): 0
    if(_): Mbl_opt_nu [
        Mbl_nlines(nl):
        str_from_int(s): nl
        len(w): s
        set(r): {w + 1}
        if(_): {r < 4} [
            set(r): 4
        ]
    ]
]
