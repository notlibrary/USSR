                set(x): px
                set(go): {x > 0}
            ]
            else(_): [
                set(go): false
            ]
        ]
        if(_): {x > 0} [
            utf8_prev(px): l x
            Mbl_class(c0): l px
            set(go): true
            while(_): go [
                utf8_prev(px): l x
