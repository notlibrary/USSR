# a plain motion moves the cursor: true when b was one
Mbl_move(r): b count [
    set(known): "beWBE0^$Gg%{}HML;,fFtT'`"
    chr(c): b
    str_find(k): known c 0
    set(r): false
    if(_): {k < 0 || b = 0} [
        return(r): r
    ]
    # a jump remembers where it came from in the mark '
    if(_): {b = 71 || b = 103 || b = 37 || b = 39 || b = 96} [
        vec(pos): ""
        push(_): pos Mbl_cy
        push(_): pos Mbl_cx
        btput(_): Mbl_marks "''" pos
    ]
    Mbl_motion(m): b count
    at(found): m 0
    if(_): found [
        at(Mbl_cy): m 1
        at(Mbl_cx): m 2
        Mbl_fixcx(_):
        Mbl_scroll(_):
    ]
    set(r): true
]

Mbl_join(r): count spaces [
    Mbl_nlines(nl):
    set(times): {count - 1}
    if(_): {times < 1} [
        set(times): 1
    ]
    set(r): 0
    if(_): {Mbl_cy + 1 >= nl} [
        return(r): r
    ]
    Mbl_begin_change(_):
    set(k): 0
    while(_): {k < times && Mbl_cy + 1 < nl} [
        Mbl_line(a): Mbl_cy
        Mbl_line(b): {Mbl_cy + 1}
        if(_): spaces [
            str_trim(bt): b
            re_replace(a): "[ \\t]+$" a ""
            len(al): a
            set(sep): " "
            str_starts(close): bt ")"
            if(_): {bt = "" || al = 0 || close} [
                set(sep): ""
            ]
            concat(j): a sep bt
        ]
        else(_): [
            len(al): a
            concat(j): a b
        ]
        vec(one): ""
        push(_): one j
        Mbl_replace_lines(_): Mbl_cy {Mbl_cy + 1} one
        set(Mbl_cx): al
        Mbl_nlines(nl):
        set(k): {k + 1}
    ]
    Mbl_fixcx(_):
]

# ---------- insert mode additions ----------

# true when the key was handled
Mbl_more_insert(r): b [
    set(r): false
