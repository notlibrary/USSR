# usa's code generator: USSR VM bytecode from the parser's nodes, the
# link step, and the .ru writer (docs/RU_BYTECODE_FORMAT.md).
#
# The C machine on the USSR VM:
#   memory    one USSR vector, the global M; an address is an index into
#             it. Objects have their C sizes and alignments and each
#             scalar lives in the cell at its address (the other cells
#             of a long or a pointer stay unused), so sizeof, pointer
#             arithmetic, memcpy and memset work as in C.
#             Layout: globals and string literals from 8, then the stack
#             (SP, a global, grows up), then the heap (malloc pushes).
#   registers R29 holds M in every function (loaded on entry), R28 the
#             frame pointer of a function with objects in memory; R0..R27
#             evaluate expressions, a node into its register d with the
#             ones above it as temporaries.
#   locals    scalars whose address is never taken are VM locals of the
#             call (LOAD_VAR/STORE_VAR, B=1, by slot); arrays, structs
#             and the rest live in the frame.
#   calls     CALL with the arguments in consecutive registers. The
#             variadic part goes into memory on the stack, its address
#             as a hidden last parameter (%va), 8 bytes per argument.
#             A struct is passed as its address (the callee copies it)
#             and returned as the address of a per-function buffer.
#   pointers  to functions are function index + 1; calls through them go
#             to a generated dispatcher for that number of arguments.
#   integers  are VM integers (64 bits) kept in the range of their C
#             type: narrowing conversions mask or sign-extend; unsigned
#             int results are masked to 32 bits.
#   reals     double and float are VM reals.

global(_): co_op co_a co_b co_c co_i k_tag k_val k_tab st_s st_tab
global(_): fn_name fn_entry fn_params fn_locals fn_defined fn_np fn_sym fn_kind fn_taken fn_rbuf fn_va
global(_): g_fix_at g_fix_sym g_endfix g_calls g_calls_f
global(_): g_slots g_slotn g_fp g_brk g_cont g_labels g_labn g_gotos g_goton g_cur g_icall
global(_): g_leaves g_ret_slot g_va_slot g_frame usa_zero usa_trace

# ======================= pools =======================
gen_init(r): [
    set(r): 0
    vec(co_op): ""
    vec(co_a): ""
    vec(co_b): ""
    vec(co_c): ""
    vec(co_i): ""
    vec(k_tag): ""
    vec(k_val): ""
    ht_new(k_tab): 4096
    vec(st_s): ""
    ht_new(st_tab): 1024
    vec(fn_name): ""
    vec(fn_entry): ""
    vec(fn_params): ""
    vec(fn_locals): ""
    vec(fn_defined): ""
    vec(fn_np): ""
    vec(fn_sym): ""
    vec(fn_kind): ""
    vec(fn_taken): ""
    vec(fn_rbuf): ""
    vec(fn_va): ""
    vec(g_fix_at): ""
    vec(g_fix_sym): ""
    vec(g_endfix): ""
    vec(g_calls): ""
    vec(g_calls_f): ""
    vec(g_icall): ""
    vec(g_leaves): ""
    # instruction 0: top-level code, which does not run (init is the entry)
    e(_): 240 0 0 0 0
]
e(r): op a b c imm [
    len(r): co_op
    push(_): co_op op
    push(_): co_a a
    push(_): co_b b
    push(_): co_c c
    push(_): co_i imm
]
here(r): [
    len(r): co_op
]
patch(r): at to [
    set(r): 0
    set(co_i): at to
]
patch_all(r): v to [
    set(r): 0
    len(n): v
    set(i): 0
    while(_): {i < n} [
        at(j): v i
        set(co_i): j to
        add(i): i 1
    ]
]
# Constant pool entries: tag 1 integer, 2 real (IEEE bits), 3 string.
k_int(r): v [
    encode(ks): v
    concat(key): "i" ks
    ht_get(r): k_tab key
    if(_): {r < 0} [
        len(r): k_tag
        push(_): k_tag 1
        push(_): k_val v
        ht_put(_): k_tab key r
    ]
]
k_real(r): bits [
    encode(ks): bits
    concat(key): "r" ks
    ht_get(r): k_tab key
    if(_): {r < 0} [
        len(r): k_tag
        push(_): k_tag 2
        push(_): k_val bits
        ht_put(_): k_tab key r
    ]
]
k_str(r): s [
    concat(key): "s" s
    ht_get(r): k_tab key
    if(_): {r < 0} [
        len(r): k_tag
        push(_): k_tag 3
        push(_): k_val s
        ht_put(_): k_tab key r
    ]
]
s_idx(r): s [
    ht_get(r): st_tab s
    if(_): {r < 0} [
        len(r): st_s
        push(_): st_s s
        ht_put(_): st_tab s r
    ]
]
# LOAD_CONST d, the integer v.
e_int(r): d v [
    k_int(k): v
    e(r): 1 d 0 0 k
]
e_gload(r): d name [
    s_idx(s): name
    e(r): 2 d 2 0 s
]
e_gstore(r): d name [
    s_idx(s): name
    e(r): 3 d 2 0 s
]
# IEEE-754 binary64 bits of the integer v (rounded to nearest even).
real_bits(r): v [
    set(r): 0
    if(_): {v = 0} [ return(_): r ]
    set(sign): 0
    if(_): {v < 0} [
        set(sign): 1
        set(v): {0 - v}
    ]
    if(_): {v < 0} [
        # -2^63
        set(r): {(1 << 63) | ((1023 + 63) << 52)}
        return(_): r
    ]
    set(ex): 0
    set(x): v
    while(_): {x > 1} [
        set(x): {x >> 1}
        add(ex): ex 1
    ]
    if(_): {ex <= 52} [
        set(m): {v << (52 - ex)}
    ]
    else(_): [
        set(sh): {ex - 52}
        set(m): {v >> sh}
        set(rem): {v & ((1 << sh) - 1)}
        set(half): {1 << (sh - 1)}
        if(_): {rem > half || (rem = half && (m & 1) = 1)} [
            add(m): m 1
            if(_): {m >= (1 << 53)} [
                set(m): {m >> 1}
                add(ex): ex 1
            ]
        ]
    ]
    set(r): {((ex + 1023) << 52) | (m & ((1 << 52) - 1))}
    if(_): {sign = 1} [ set(r): {r | (1 << 63)} ]
]
# Load the floating constant spelled s (or a whole number) into d.
e_flt(r): d s [
    set(r): 0
    typeof(ty): s
    if(_): {ty = "integer"} [
        real_bits(b): s
        k_real(k): b
        e(_): 1 d 0 0 k
        return(_): r
    ]
    # digits and exponent: value = m * 10^ex
    len(n): s
    set(m): 0
    set(ex): 0
    set(nd): 0
    set(i): 0
    set(seen): 0
    set(go): 1
    while(_): {go = 1 && i < n} [
        byte(b): s i
        if(_): {b > 47 && b < 58} [
            if(_): {nd < 18} [
                set(m): {m * 10 + b - 48}
                if(_): {m > 0} [ add(nd): nd 1 ]
                if(_): {seen = 1} [ sub(ex): ex 1 ]
            ]
            elif(_): {seen = 0} [ add(ex): ex 1 ]
            add(i): i 1
        ]
        elif(_): {b = 46} [
            set(seen): 1
            add(i): i 1
        ]
        else(_): [ set(go): 0 ]
    ]
    if(_): {i < n} [
        byte(b): s i
        if(_): {b = 101 || b = 69} [
            add(i): i 1
            set(neg): 0
            byte(b2): s i
            if(_): {b2 = 45} [
                set(neg): 1
                add(i): i 1
            ]
            elif(_): {b2 = 43} [ add(i): i 1 ]
            set(e2): 0
            set(go): 1
            while(_): {go = 1 && i < n} [
                byte(b3): s i
                if(_): {b3 > 47 && b3 < 58} [
                    set(e2): {e2 * 10 + b3 - 48}
                    add(i): i 1
                ]
                else(_): [ set(go): 0 ]
            ]
            if(_): {neg = 1} [ set(e2): {0 - e2} ]
            add(ex): ex e2
        ]
    ]
    if(_): {m = 0} [
        k_real(k): 0
        e(_): 1 d 0 0 k
        return(_): r
    ]
    # m * 10^ex: whole while it fits, else divisions/multiplications of
    # exact reals
    while(_): {ex > 0 && m < 922337203685477580} [
        set(m): {m * 10}
        sub(ex): ex 1
    ]
    real_bits(mb): m
    k_real(km): mb
    e(_): 1 d 0 0 km
    while(_): {ex < 0} [
        set(step): ex
        if(_): {step < (0 - 18)} [ set(step): {0 - 18} ]
        set(p): 1
        set(j): 0
        while(_): {j < 0 - step} [
            set(p): {p * 10}
            add(j): j 1
        ]
        real_bits(pb): p
        k_real(kp): pb
        e(_): 1 {d + 1} 0 0 kp
        e(_): 19 d d {d + 1} 0
        sub(ex): ex step
    ]
    while(_): {ex > 0} [
        set(step): ex
        if(_): {step > 18} [ set(step): 18 ]
        set(p): 1
        set(j): 0
        while(_): {j < step} [
            set(p): {p * 10}
            add(j): j 1
        ]
        real_bits(pb): p
        k_real(kp): pb
        e(_): 1 {d + 1} 0 0 kp
        e(_): 18 d d {d + 1} 0
        sub(ex): ex step
    ]
]

# ======================= functions =======================
# A function table entry for function symbol s (its index in sy_v).
fn_declare(r): s [
    len(r): fn_name
    at(name): sy_n s
    if(_): {name = "init"} [ set(name): "c.init" ]
    at(t): sy_t s
    at(ps): ty_m t
    len(np): ps
    at(va): ty_va t
    if(_): {va = 1} [ add(np): np 1 ]
    push(_): fn_name name
    push(_): fn_entry 0
    push(_): fn_params null
    push(_): fn_locals null
    push(_): fn_defined 0
    push(_): fn_np np
    push(_): fn_sym s
    push(_): fn_kind 0
    push(_): fn_taken 0
    push(_): fn_rbuf 0
    push(_): fn_va va
    set(sy_v): s r
]
# A function the code generator makes itself: its index.
fn_internal(r): name np [
    len(r): fn_name
    push(_): fn_name name
    push(_): fn_entry 0
    push(_): fn_params null
    push(_): fn_locals null
    push(_): fn_defined 1
    push(_): fn_np np
    push(_): fn_sym {0 - 1}
    push(_): fn_kind 2
    push(_): fn_taken 0
    push(_): fn_rbuf 0
    push(_): fn_va 0
]
# The function index of the C function called name (declared by the
# prelude), for the helpers the code calls.
fn_rt(r): name [
    ht_get(s): lk_tab name
    if(_): {s < 0} [
        concat(m): "usa: the runtime function '" name
        concat(m): m "' is not declared (is include/__usa.h there?)"
        usa_error(_): {0 - 1} m
    ]
    at(r): sy_v s
]

# ---- per-function state ----
# A VM local of the current function: its slot.
g_newlocal(r): name [
    len(r): g_slots
    push(_): g_slots name
]
# Storage for every parameter and local of the function being compiled.
g_layout(r): psyms lsyms va [
    set(r): 0
    vec(g_slots): ""
    set(g_frame): 0
    len(np): psyms
    set(i): 0
    while(_): {i < np} [
        at(s): psyms i
        at(nm): sy_n s
        encode(is): s
        concat(vn): nm "."
        concat(vn): vn is
        g_newlocal(slot): vn
        set(sy_vn): s vn
        set(sy_a): s slot
        add(i): i 1
    ]
    set(g_va_slot): {0 - 1}
    if(_): {va = 1} [ g_newlocal(g_va_slot): "%va" ]
    g_newlocal(g_ret_slot): "%r"
    # parameters that must be in memory get a frame copy
    set(i): 0
    while(_): {i < np} [
        at(s): psyms i
        g_place(_): s
        add(i): i 1
    ]
    len(nl): lsyms
    set(i): 0
    while(_): {i < nl} [
        at(s): lsyms i
        at(st): sy_st s
        if(_): {st = 2} [
            at(nm): sy_n s
            encode(is): s
            concat(vn): nm "."
            concat(vn): vn is
            set(sy_vn): s vn
            g_place(_): s
            at(st2): sy_st s
            if(_): {st2 = 2} [
                g_newlocal(slot): vn
                set(sy_a): s slot
            ]
        ]
        add(i): i 1
    ]
]
# Put automatic object s in the frame (storage 4, offset in sy_v... sy_a)
# when it needs an address.
g_place(r): s [
    set(r): 0
    at(t): sy_t s
    at(k): ty_k t
    at(taken): sy_at s
    if(_): {taken = 1 || k = 10 || k = 12 || k = 13} [
        at(sz): ty_sz t
        at(al): ty_al t
        if(_): {al < 8} [ set(al): 8 ]
        set(g_frame): {(g_frame + al - 1) - (g_frame + al - 1) % al}
        at(st): sy_st s
        if(_): {st = 3} [
            # a parameter: keep its slot for the copy in the prologue
            at(slot): sy_a s
            set(sy_v): s slot
        ]
        set(sy_a): s g_frame
        set(sy_st): s 4
        if(_): {sz < 1} [ set(sz): 1 ]
        add(g_frame): g_frame sz
        set(g_frame): {(g_frame + 7) - (g_frame + 7) % 8}
    ]
]
g_reg(r): d [
    set(r): 0
    if(_): {d > 27} [ usa_error(_): g_cur "expression too complex (out of registers)" ]
]

gen_function(r): s psyms lsyms body [
    set(r): 0
    at(fi): sy_v s
    at(t): sy_t s
    at(va): ty_va t
    set(g_cur): p_ln
    g_layout(_): psyms lsyms va
    vec(g_brk): ""
    vec(g_cont): ""
    vec(g_labels): ""
    vec(g_labn): ""
    vec(g_gotos): ""
    vec(g_goton): ""
    set(g_fp): 0
    here(entry):
    set(fn_entry): fi entry
    e_gload(_): 29 "M"
    if(_): {usa_trace = 1} [
        # -trace: each call says which function it enters
        at(tn): sy_n s
        concat(tm): "> " tn
        concat(tm): tm "\n"
        k_str(tk): tm
        e(_): 1 0 0 0 tk
        s_idx(ws): "write_stderr"
        e(_): 68 1 1 0 ws
    ]
    if(_): {g_frame > 0} [
        set(g_fp): 1
        e_gload(_): 28 "SP"
        e_int(_): 27 g_frame
        e(_): 16 27 28 27 0
        e_gstore(_): 27 "SP"
    ]
    # parameters kept in the frame: copy them in
    len(np): psyms
    set(i): 0
    while(_): {i < np} [
        at(ps): psyms i
        at(st): sy_st ps
        if(_): {st = 4} [
            at(slot): sy_v ps
            at(vn): sy_vn ps
            s_idx(sv): vn
            e(_): 2 0 1 slot sv
            at(off): sy_a ps
            e_int(_): 1 off
            e(_): 16 1 28 1 0
            at(pt): sy_t ps
            ty_isagg(ag): pt
            if(_): {ag = 1} [ g_copy(_): 1 0 pt 2 ]
            else(_): [ e(_): 9 29 1 0 0 ]
        ]
        add(i): i 1
    ]
    gen_stmt(_): body
    # falling off the end returns 0
    e_int(_): 0 0
    g_ret(_): 0
    # gotos
    len(ng): g_gotos
    set(j): 0
    while(_): {j < ng} [
        at(gi): g_gotos j
        at(gn): g_goton j
        set(hit): {0 - 1}
        len(nlab): g_labn
        set(k): 0
        while(_): {k < nlab} [
            at(ln): g_labn k
            if(_): {ln = gn} [ at(hit): g_labels k ]
            add(k): k 1
        ]
        if(_): {hit < 0} [
            concat(m): "label '" gn
            concat(m): m "' used but not defined"
            usa_error(_): g_cur m
        ]
        patch(_): gi hit
        add(j): j 1
    ]
    vec(pn): ""
    set(i): 0
    set(nparams): np
    if(_): {va = 1} [ add(nparams): nparams 1 ]
    # the definition decides the parameter count (main may be declared ())
    set(fn_np): fi nparams
    set(fn_va): fi va
    while(_): {i < nparams} [
        at(x): g_slots i
        push(_): pn x
        add(i): i 1
    ]
    set(fn_params): fi pn
    set(fn_locals): fi g_slots
]
# Return the value in register d from the current function.
g_ret(r): d [
    set(r): 0
    s_idx(rs): "%r"
    e(_): 3 d 1 g_ret_slot rs
    if(_): {g_fp = 1} [ e_gstore(_): 28 "SP" ]
    e(_): 81 0 0 0 0
]

# ======================= expressions =======================
# Load or store a VM local or the memory of symbol s.
g_isvm(r): s [
    at(st): sy_st s
    set(r): 0
    if(_): {st = 2 || st = 3} [ set(r): 1 ]
]
g_loadvar(r): s d [
    set(r): 0
    at(vn): sy_vn s
    at(slot): sy_a s
    s_idx(sv): vn
    if(_): {slot < 256} [ e(_): 2 d 1 slot sv ]
    else(_): [ e(_): 2 d 0 0 sv ]
]
g_storevar(r): s d [
    set(r): 0
    at(vn): sy_vn s
    at(slot): sy_a s
    s_idx(sv): vn
    if(_): {slot < 256} [ e(_): 3 d 1 slot sv ]
    else(_): [ e(_): 3 d 0 0 sv ]
]
# The address of lvalue (or aggregate) node n into d.
gen_addr(r): n d [
    set(r): 0
    g_reg(_): d
    at(k): nd_k n
    if(_): {k = 3} [
        at(s): nd_a n
        at(st): sy_st s
        if(_): {st = 1} [
            # a static address, fixed when the program is linked
            e(at): 1 d 0 0 0
            push(_): g_fix_at at
            push(_): g_fix_sym s
        ]
        elif(_): {st = 4} [
            at(off): sy_a s
            e_int(_): d off
            e(_): 16 d 28 d 0
        ]
        else(_): [
            at(nm): sy_n s
            concat(m): "cannot take the address of '" nm
            concat(m): m "'"
            usa_error(_): g_cur m
        ]
        return(_): r
    ]
    if(_): {k = 12} [
        at(a): nd_a n
        gen_expr(_): a d
        return(_): r
    ]
    gen_expr(_): n d
]
# The scalar leaves (cell offsets) of a struct/union/array type.
g_leafs(r): t [
    vec(r): ""
    g_leafs_into(_): t 0 r
]
g_leafs_into(r): t base out [
    set(r): 0
    at(k): ty_k t
    if(_): {k = 10} [
        at(b): ty_b t
        at(n): ty_n t
        at(es): ty_sz b
        set(i): 0
        while(_): {i < n} [
            g_leafs_into(_): b {base + i * es} out
            len(cnt): out
            if(_): {cnt > 64} [ set(i): n ]
            add(i): i 1
        ]
    ]
    elif(_): {k = 12 || k = 13} [
        at(ms): ty_m t
        len(nm): ms
        set(i): 0
        while(_): {i < nm} [
            at(m): ms i
            at(mt): mb_t m
            at(mo): mb_o m
            g_leafs_into(_): mt {base + mo} out
            add(i): i 1
        ]
        if(_): {k = 13} [
            # members overlap: every offset once
            len(cnt): out
            vec(u): ""
            set(i): 0
            while(_): {i < cnt} [
                at(x): out i
                set(dup): 0
                len(un): u
                set(j): 0
                while(_): {j < un} [
                    at(y): u j
                    if(_): {y = x} [ set(dup): 1 ]
                    add(j): j 1
                ]
                if(_): {dup = 0} [ push(_): u x ]
                add(i): i 1
            ]
            while(_): {cnt > 0} [
                pop(_): out
                sub(cnt): cnt 1
            ]
            len(un): u
            set(i): 0
            while(_): {i < un} [
                at(x): u i
                push(_): out x
                add(i): i 1
            ]
        ]
    ]
    else(_): [ push(_): out base ]
]
# Copy the object of type t at the address in src to the address in dst;
# registers from tmp up are free.
g_copy(r): dst src t tmp [
    set(r): 0
    g_leafs(lv): t
    len(n): lv
    at(sz): ty_sz t
    if(_): {n <= 24} [
        set(i): 0
        while(_): {i < n} [
            at(off): lv i
            if(_): {off = 0} [
                e(_): 8 tmp 29 src 0
                e(_): 9 29 dst tmp 0
            ]
            else(_): [
                e_int(_): tmp off
                e(_): 16 {tmp + 1} src tmp 0
                e(_): 8 {tmp + 1} 29 {tmp + 1} 0
                e(_): 16 tmp dst tmp 0
                e(_): 9 29 tmp {tmp + 1} 0
            ]
            add(i): i 1
        ]
        return(_): r
    ]
    # memcpy(dst, src, size): the arguments must be consecutive
    g_reg(_): {tmp + 2}
    e_int(_): tmp 0
    e(_): 16 tmp dst tmp 0
    e_int(_): {tmp + 1} 0
    e(_): 16 {tmp + 1} src {tmp + 1} 0
    e_int(_): {tmp + 2} sz
    fn_rt(f): "memcpy"
    e(at): 80 tmp 3 tmp f
    push(_): g_calls at
    push(_): g_calls_f f
]
# Normalize the integer in d to type t: mask an unsigned type narrower
# than 64 bits, sign-extend a signed one; _Bool to 0/1.
g_norm(r): d t [
    set(r): 0
    at(k): ty_k t
    if(_): {k = 1} [
        g_tobool(_): d
        return(_): r
    ]
    ty_bits(b): t
    if(_): {b >= 64} [ return(_): r ]
    at(u): ty_u t
    if(_): {u = 1} [
        e_int(_): 30 {(1 << b) - 1}
        e(_): 31 d d 30 0
    ]
    else(_): [
        e_int(_): 30 {64 - b}
        e(_): 33 d d 30 0
        e(_): 34 d d 30 0
    ]
]
# The truth of the value in d as 0 or 1.
g_tobool(r): d [
    set(r): 0
    e(j): 50 d 0 0 0
    e_int(_): d 1
    e(j2): 48 0 0 0 0
    here(h):
    patch(_): j h
    e_int(_): d 0
    here(h2):
    patch(_): j2 h2
]
# A VM boolean in d as the int 0 or 1.
g_bool2int(r): d [
    set(r): 0
    g_tobool(_): d
]
# Convert the value in d from type from to type to.
g_conv(r): d from to [
    set(r): 0
    if(_): {from = to} [ return(_): r ]
    at(fk): ty_k from
    at(tk): ty_k to
    if(_): {tk = 0 || tk = 14 || tk = 10 || tk = 11 || tk = 12 || tk = 13} [ return(_): r ]
    if(_): {fk = 14} [
        if(_): {tk = 1} [ g_tobool(_): d ]
        else(_): [ g_norm(_): d to ]
        return(_): r
    ]
    if(_): {tk = 7 || tk = 8} [
