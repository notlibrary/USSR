# C parser for usa: types, scopes, declarations, expressions and
# statements, by hand-written recursive descent over the tokens of lex.su.
#
# Expressions come out lowered for the code generator: every implicit
# conversion is a CAST node, a.b and p->b are *(base + offset), a[i] is
# *(a + i * size), sizeof and constant enum names are numbers.
#
# Types (ty_*): kind 0 void, 1 _Bool, 2 char, 3 short, 4 int, 5 long,
# 6 long long, 7 float, 8 double, 9 pointer, 10 array, 11 function,
# 12 struct, 13 union, 14 __uval (a USSR value as it is: libc's way to
# hold vectors and strings). Enumerations are int.
#
# Symbols (sy_*): kind 1 object, 2 typedef, 3 function, 4 enumerator;
# storage 1 static (a memory address), 2 automatic, 3 parameter.

global(_): ty_k ty_u ty_sz ty_al ty_b ty_n ty_m ty_va ty_cpl ty_tag ty_ptrc ty_proto
global(_): ty_void ty_bool ty_char ty_schar ty_uchar ty_short ty_ushort ty_int ty_uint
global(_): ty_long ty_ulong ty_llong ty_ullong ty_float ty_double ty_uval ty_charp
global(_): mb_n mb_t mb_o
global(_): sy_n sy_k sy_t sy_st sy_a sy_v sy_at sy_vn sy_def sy_ext sy_ln
global(_): sc_tab sc_names sc_lv lk_tab
global(_): nd_k nd_t nd_a nd_b nd_c nd_v nd_ln
global(_): p_i p_fn p_fsyms p_brk p_cont p_sw p_tu p_static_n p_ginit p_strs
global(_): g_top p_lab

# ======================= errors =======================
# file:line of output line ln of the current translation unit.
usa_where(r): ln [
    set(r): "<input>"
    len(n): pp_mapl
    if(_): {ln >= 0 && ln < n} [
        at(f): pp_mapf ln
        at(l): pp_mapl ln
        encode(ls): l
        concat(r): f ":"
        concat(r): r ls
    ]
]
usa_error(r): ln msg [
    usa_where(w): ln
    concat(m): w ": error: "
    concat(m): m msg
    concat(m): m "\n"
    write_stderr(_): m
    # stop here: usa_main runs under try, which ends the compile quietly
    set(r): {1 % usa_zero}
]
usa_warn(r): ln msg [
    set(r): 0
    usa_where(w): ln
    concat(m): w ": warning: "
    concat(m): m msg
    concat(m): m "\n"
    write_stderr(_): m
]
p_fail(r): msg [
    at(ln): tk_l p_i
    usa_error(r): ln msg
]
# error mentioning the current token
p_failat(r): msg [
    at(k): tk_k p_i
    at(s): tk_s p_i
    set(t): "end of input"
    if(_): {k = 1 || k = 5} [ concat(t): "'" s ]
    if(_): {k = 1 || k = 5} [ concat(t): t "'" ]
    if(_): {k = 2 || k = 3} [ set(t): "a number" ]
    if(_): {k = 4} [ set(t): "a string" ]
    concat(m): msg " before "
    concat(m): m t
    p_fail(r): m
]

# ======================= types =======================
ty_new(r): kind size align uns [
    len(r): ty_k
    push(_): ty_k kind
    push(_): ty_u uns
    push(_): ty_sz size
    push(_): ty_al align
    push(_): ty_b {0 - 1}
    push(_): ty_n 0
    push(_): ty_m null
    push(_): ty_va 0
    push(_): ty_cpl 1
    push(_): ty_tag ""
    push(_): ty_ptrc {0 - 1}
    push(_): ty_proto 1
]
ty_init(r): [
    set(r): 0
    vec(ty_k): ""
    vec(ty_u): ""
    vec(ty_sz): ""
    vec(ty_al): ""
    vec(ty_b): ""
    vec(ty_n): ""
    vec(ty_m): ""
    vec(ty_va): ""
    vec(ty_cpl): ""
    vec(ty_tag): ""
    vec(ty_ptrc): ""
    vec(ty_proto): ""
    vec(mb_n): ""
    vec(mb_t): ""
    vec(mb_o): ""
    ty_new(ty_void): 0 1 1 0
    ty_new(ty_bool): 1 1 1 1
    ty_new(ty_char): 2 1 1 1
    ty_new(ty_schar): 2 1 1 0
    ty_new(ty_uchar): 2 1 1 1
    ty_new(ty_short): 3 2 2 0
    ty_new(ty_ushort): 3 2 2 1
    ty_new(ty_int): 4 4 4 0
    ty_new(ty_uint): 4 4 4 1
    ty_new(ty_long): 5 8 8 0
    ty_new(ty_ulong): 5 8 8 1
    ty_new(ty_llong): 6 8 8 0
    ty_new(ty_ullong): 6 8 8 1
    ty_new(ty_float): 7 4 4 0
    ty_new(ty_double): 8 8 8 0
    ty_new(ty_uval): 14 8 8 0
    ty_ptr(ty_charp): ty_char
]
ty_ptr(r): t [
    at(r): ty_ptrc t
    if(_): {r < 0} [
        ty_new(r): 9 8 8 1
        set(ty_b): r t
        set(ty_ptrc): t r
    ]
]
ty_arr(r): t n [
    at(es): ty_sz t
    at(ea): ty_al t
    set(sz): {es * n}
    if(_): {n < 0} [ set(sz): 0 ]
    ty_new(r): 10 sz ea 0
    set(ty_b): r t
    set(ty_n): r n
]
ty_fn(r): ret params va [
    ty_new(r): 11 1 1 0
    set(ty_b): r ret
    set(ty_m): r params
    set(ty_va): r va
]
# (the predicates give 0 or 1: a VM boolean never equals 1)
ty_isint(r): t [
    at(k): ty_k t
    set(r): 0
    if(_): {k >= 1 && k <= 6} [ set(r): 1 ]
]
ty_isflt(r): t [
    at(k): ty_k t
    set(r): 0
    if(_): {k = 7 || k = 8} [ set(r): 1 ]
]
ty_isarith(r): t [
    at(k): ty_k t
    set(r): 0
    if(_): {(k >= 1 && k <= 8) || k = 14} [ set(r): 1 ]
]
ty_isptr(r): t [
    at(k): ty_k t
    set(r): 0
    if(_): {k = 9 || k = 10} [ set(r): 1 ]
]
ty_isscalar(r): t [
    at(k): ty_k t
    set(r): 0
    if(_): {(k >= 1 && k <= 10) || k = 14} [ set(r): 1 ]
]
ty_isagg(r): t [
    at(k): ty_k t
    set(r): 0
    if(_): {k = 12 || k = 13} [ set(r): 1 ]
]
# Bits of an integer type (64 for pointers).
ty_bits(r): t [
    at(k): ty_k t
    set(r): 64
    if(_): {k = 1 || k = 2} [ set(r): 8 ]
    elif(_): {k = 3} [ set(r): 16 ]
    elif(_): {k = 4} [ set(r): 32 ]
]
# The integer promotion of t.
ty_promote(r): t [
    set(r): t
    at(k): ty_k t
    if(_): {k >= 1 && k <= 3} [ set(r): ty_int ]
]
# The common type of the usual arithmetic conversions.
ty_common(r): a b [
    at(ka): ty_k a
    at(kb): ty_k b
    if(_): {ka = 14 || kb = 14} [
        set(r): ty_uval
        return(_): r
    ]
    if(_): {ka = 8 || kb = 8 || ka = 7 || kb = 7} [
        set(r): ty_double
        return(_): r
    ]
    ty_promote(a): a
    ty_promote(b): b
    if(_): {a = b} [
        set(r): a
        return(_): r
    ]
    at(ka): ty_k a
    at(kb): ty_k b
    at(ua): ty_u a
    at(ub): ty_u b
    # long long ranks as long here (both 64 bits)
    if(_): {ka = 6} [ set(ka): 5 ]
    if(_): {kb = 6} [ set(kb): 5 ]
    if(_): {ua = ub} [
        set(r): a
        if(_): {kb > ka} [ set(r): b ]
    ]
    elif(_): {ua = 1 && ka >= kb} [ set(r): a ]
    elif(_): {ub = 1 && kb >= ka} [ set(r): b ]
    elif(_): {ua = 0} [
        # signed a is wider than unsigned b: a holds every b
        set(r): a
    ]
    else(_): [ set(r): b ]
]
# t as an element of an expression: arrays are their first element's
# pointer, functions their pointer.
ty_decayed(r): t [
    set(r): t
    at(k): ty_k t
    if(_): {k = 10} [
        at(b): ty_b t
        ty_ptr(r): b
    ]
    elif(_): {k = 11} [ ty_ptr(r): t ]
]
# Whether two types are the same for redeclarations (loosely: kinds).
ty_sizeof(r): t ln [
    at(k): ty_k t
    at(r): ty_sz t
    if(_): {k = 11} [ set(r): 1 ]
    at(cpl): ty_cpl t
    if(_): {cpl = 0} [ usa_error(_): ln "invalid application of 'sizeof' to an incomplete type" ]
]

# ======================= nodes =======================
nd_new(r): kind t a b c v [
    len(r): nd_k
    push(_): nd_k kind
    push(_): nd_t t
    push(_): nd_a a
    push(_): nd_b b
    push(_): nd_c c
    push(_): nd_v v
    push(_): nd_ln p_ln
]
global(_): p_ln
p_mark(r): [
    at(p_ln): tk_l p_i
    set(r): p_ln
]
nd_num(r): v t [
    nd_new(r): 1 t 0 0 0 v
]

# ======================= symbols and scopes =======================
sy_new(r): name kind t [
    len(r): sy_n
    push(_): sy_n name
    push(_): sy_k kind
    push(_): sy_t t
    push(_): sy_st 0
    push(_): sy_a 0
    push(_): sy_v 0
    push(_): sy_at 0
    push(_): sy_vn ""
    push(_): sy_def 0
    push(_): sy_ext 0
    push(_): sy_ln p_ln
]
# Make name (in the ordinary or, with a "struct " prefix, the tag
# namespace) refer to symbol s in the innermost scope.
sc_bind(r): name s [
    set(r): 0
    ht_get(st): sc_tab name
    if(_): {st = (0 - 1)} [
        vec(st): ""
        ht_put(_): sc_tab name st
    ]
    push(_): st s
    len(d): sc_names
    at(top): sc_names {d - 1}
    push(_): top name
]
sc_find(r): name [
    set(r): {0 - 1}
    ht_get(st): sc_tab name
    if(_): {st != (0 - 1)} [
        len(n): st
        if(_): {n > 0} [ at(r): st {n - 1} ]
    ]
]
# The symbol bound to name in the innermost scope only, else -1.
sc_find_here(r): name [
    set(r): {0 - 1}
    sc_find(s): name
    if(_): {s >= 0} [
        len(d): sc_names
        at(top): sc_names {d - 1}
        len(n): top
        set(i): 0
        while(_): {i < n} [
            at(x): top i
            if(_): {x = name} [
                set(r): s
                set(i): n
            ]
            add(i): i 1
        ]
    ]
]
sc_push(r): [
    vec(l): ""
    push(_): sc_names l
    set(r): 0
]
sc_pop(r): [
    set(r): 0
    pop(top): sc_names
    len(n): top
    set(i): 0
    while(_): {i < n} [
        at(name): top i
        ht_get(st): sc_tab name
        pop(_): st
        add(i): i 1
    ]
]

# ======================= tokens =======================
p_tok(r): [
    at(r): tk_s p_i
]
p_kind(r): [
    at(r): tk_k p_i
]
# 1 when the current token is the identifier or punctuator s.
p_is(r): s [
    set(r): 0
    at(k): tk_k p_i
    if(_): {k = 1 || k = 5} [
        at(t): tk_s p_i
        if(_): {t = s} [ set(r): 1 ]
    ]
]
p_is_at(r): i s [
    set(r): 0
    at(k): tk_k i
    if(_): {k = 1 || k = 5} [
        at(t): tk_s i
        if(_): {t = s} [ set(r): 1 ]
    ]
]
# Consume s if it is next: 1, else 0.
p_accept(r): s [
    p_is(r): s
    if(_): {r = 1} [ add(p_i): p_i 1 ]
]
p_expect(r): s [
    p_is(r): s
    if(_): {r = 0} [
        concat(m): "expected '" s
        concat(m): m "'"
        p_failat(_): m
    ]
    add(p_i): p_i 1
]
p_ident(r): [
    at(k): tk_k p_i
    if(_): {k != 1} [ p_failat(_): "expected identifier" ]
    at(r): tk_s p_i
    add(p_i): p_i 1
]

# ======================= declarations =======================
# Whether the token at i begins a type name.
p_istype_at(r): i [
    set(r): 0
    at(k): tk_k i
    if(_): {k != 1} [ return(_): r ]
    at(s): tk_s i
    if(_): {s = "void" || s = "char" || s = "short" || s = "int" || s = "long" || s = "float" || s = "double" || s = "signed" || s = "unsigned" || s = "_Bool" || s = "struct" || s = "union" || s = "enum" || s = "const" || s = "volatile" || s = "static" || s = "extern" || s = "typedef" || s = "inline" || s = "register" || s = "auto" || s = "restrict" || s = "__uval" || s = "__inline" || s = "__inline__" || s = "__restrict" || s = "__restrict__" || s = "_Noreturn" || s = "__extension__" || s = "__const" || s = "_Alignas" || s = "__signed__" || s = "bool"} [
        set(r): 1
        return(_): r
    ]
    sc_find(sy): s
    if(_): {sy >= 0} [
        at(sk): sy_k sy
        if(_): {sk = 2} [ set(r): 1 ]
    ]
]
p_istype(r): [
    p_istype_at(r): p_i
]
# GNU __attribute__((...)) and similar annotations are skipped.
p_skip_attr(r): [
    set(r): 0
    set(go): 1
    while(_): {go = 1} [
        p_is(a): "__attribute__"
        p_is(a2): "__attribute"
        p_is(a3): "__declspec"
        p_is(a4): "__asm__"
        p_is(a5): "__asm"
        p_is(a6): "asm"
        if(_): {a = 1 || a2 = 1 || a3 = 1 || a4 = 1 || a5 = 1 || a6 = 1} [
            add(p_i): p_i 1
            p_skip_parens(_):
        ]
        else(_): [ set(go): 0 ]
    ]
]
# Skip a balanced ( ... ) group starting at the current token.
p_skip_parens(r): [
    set(r): 0
    p_expect(_): "("
    set(d): 1
    while(_): {d > 0} [
        at(k): tk_k p_i
        if(_): {k = 0} [ p_fail(_): "unbalanced parentheses" ]
        p_is(o): "("
        p_is(c): ")"
        if(_): {o = 1} [ add(d): d 1 ]
        if(_): {c = 1} [ sub(d): d 1 ]
        add(p_i): p_i 1
    ]
]
# Storage class of the last declaration specifiers: 0 none, 1 typedef,
# 2 static, 3 extern.
global(_): p_sclass p_inline
p_declspec(r): [
    set(sclass): 0
    set(p_inline): 0
    set(r): {0 - 1}
    set(nsig): 0
    set(nuns): 0
    set(nshort): 0
    set(nlong): 0
    set(base): ""
    set(go): 1
    while(_): {go = 1} [
        p_skip_attr(_):
        at(k): tk_k p_i
        at(s): tk_s p_i
        set(used): 0
        if(_): {k = 1} [
            if(_): {s = "typedef"} [ set(sclass): 1 ]
            elif(_): {s = "static"} [ set(sclass): 2 ]
            elif(_): {s = "extern"} [ set(sclass): 3 ]
            elif(_): {s = "inline" || s = "__inline" || s = "__inline__" || s = "_Noreturn"} [ set(p_inline): 1 ]
            elif(_): {s = "const" || s = "volatile" || s = "register" || s = "auto" || s = "restrict" || s = "__restrict" || s = "__restrict__" || s = "__extension__" || s = "__const" || s = "__volatile__"} [ set(used): 0 ]
            elif(_): {s = "_Alignas"} [
                add(p_i): p_i 1
                p_skip_parens(_):
                sub(p_i): p_i 1
            ]
            elif(_): {s = "signed" || s = "__signed__"} [ add(nsig): nsig 1 ]
            elif(_): {s = "unsigned"} [ add(nuns): nuns 1 ]
            elif(_): {s = "short"} [ add(nshort): nshort 1 ]
            elif(_): {s = "long"} [ add(nlong): nlong 1 ]
            elif(_): {s = "void" || s = "char" || s = "int" || s = "float" || s = "double" || s = "_Bool" || s = "bool" || s = "__uval"} [
                if(_): {base != "" && base != "int" && s != "int"} [ p_fail(_): "two or more data types in declaration specifiers" ]
                if(_): {base = "" || s != "int"} [ set(base): s ]
            ]
            elif(_): {s = "struct" || s = "union"} [
                if(_): {r >= 0 || base != ""} [ p_fail(_): "two or more data types in declaration specifiers" ]
                add(p_i): p_i 1
                p_struct(r): s
                sub(p_i): p_i 1
            ]
            elif(_): {s = "enum"} [
                if(_): {r >= 0 || base != ""} [ p_fail(_): "two or more data types in declaration specifiers" ]
                add(p_i): p_i 1
                p_enum(r):
                sub(p_i): p_i 1
            ]
            else(_): [
                # a typedef name, when no other type is given yet
                set(go): 0
                if(_): {r < 0 && base = "" && nsig = 0 && nuns = 0 && nshort = 0 && nlong = 0} [
                    sc_find(sy): s
                    if(_): {sy >= 0} [
                        at(sk): sy_k sy
                        if(_): {sk = 2} [
                            at(r): sy_t sy
                            set(go): 1
                        ]
                    ]
                ]
            ]
        ]
        else(_): [ set(go): 0 ]
        if(_): {go = 1} [ add(p_i): p_i 1 ]
    ]
    # set last: a struct's member declarations come through here too
    set(p_sclass): sclass
    if(_): {r >= 0} [
        if(_): {base != "" || nsig + nuns + nshort + nlong > 0} [ p_fail(_): "two or more data types in declaration specifiers" ]
        return(_): r
    ]
    if(_): {base = "void"} [ set(r): ty_void ]
    elif(_): {base = "_Bool" || base = "bool"} [ set(r): ty_bool ]
    elif(_): {base = "__uval"} [ set(r): ty_uval ]
    elif(_): {base = "float"} [ set(r): ty_float ]
    elif(_): {base = "double"} [ set(r): ty_double ]
    elif(_): {base = "char"} [
        set(r): ty_char
        if(_): {nuns > 0} [ set(r): ty_uchar ]
        if(_): {nsig > 0} [ set(r): ty_schar ]
    ]
    else(_): [
        # int, possibly short/long/unsigned
        if(_): {base = "" && nsig + nuns + nshort + nlong = 0} [
            # implicit int (old C); not in a statement position
            p_fail(_): "expected declaration specifiers"
        ]
        set(r): ty_int
        if(_): {nuns > 0} [ set(r): ty_uint ]
        if(_): {nshort > 0} [
            set(r): ty_short
            if(_): {nuns > 0} [ set(r): ty_ushort ]
        ]
        if(_): {nlong = 1} [
            set(r): ty_long
            if(_): {nuns > 0} [ set(r): ty_ulong ]
        ]
        if(_): {nlong > 1} [
            set(r): ty_llong
            if(_): {nuns > 0} [ set(r): ty_ullong ]
        ]
    ]
]

# struct or union (the keyword already taken): its type.
p_struct(r): which [
    p_skip_attr(_):
    set(tag): ""
    at(k): tk_k p_i
    if(_): {k = 1} [ p_ident(tag): ]
    p_skip_attr(_):
    p_is(body): "{"
    set(kind): 12
    if(_): {which = "union"} [ set(kind): 13 ]
    set(r): {0 - 1}
    if(_): {tag != ""} [
        concat(key): "struct " tag
        if(_): {body = 1} [ sc_find_here(r): key ]
        else(_): [ sc_find(r): key ]
        if(_): {r >= 0} [
            at(tt): sy_t r
            set(r): tt
            at(tk2): ty_k tt
            at(tc): ty_cpl tt
            if(_): {tk2 != kind} [ p_fail(_): "tag used as the wrong kind of struct/union" ]
            if(_): {body = 1 && tc = 1} [
                concat(m): "redefinition of '" which
                concat(m): m " "
                concat(m): m tag
                concat(m): m "'"
                p_fail(_): m
            ]
        ]
        if(_): {r < 0} [
            ty_new(r): kind 0 1 0
            set(ty_cpl): r 0
            set(ty_tag): r tag
            sy_new(s): key 2 r
            sc_bind(_): key s
        ]
    ]
    if(_): {body = 0} [
        if(_): {tag = ""} [ p_failat(_): "expected '{'" ]
        return(_): r
    ]
    if(_): {r < 0} [
        ty_new(r): kind 0 1 0
        set(ty_cpl): r 0
    ]
    p_expect(_): "{"
    vec(ms): ""
    set(off): 0
    set(al): 1
    set(size): 0
    while(_): {1 = 1} [
        p_accept(cl): "}"
        if(_): {cl = 1} [ break(_): "" ]
        p_declspec(bt):
        p_is(semi): ";"
        if(_): {semi = 1} [
            # an anonymous struct or union: its members belong here
            at(bk): ty_k bt
            if(_): {bk = 12 || bk = 13} [
                at(sub): ty_m bt
                at(sa): ty_al bt
                at(ssz): ty_sz bt
                if(_): {kind = 12} [
                    set(off): {(off + sa - 1) - (off + sa - 1) % sa}
                ]
                else(_): [ set(off): 0 ]
                len(sn): sub
                set(j): 0
                while(_): {j < sn} [
                    at(mm): sub j
                    at(mn): mb_n mm
                    at(mt): mb_t mm
                    at(mo): mb_o mm
                    len(nm): mb_n
                    push(_): mb_n mn
                    push(_): mb_t mt
                    push(_): mb_o {mo + off}
                    push(_): ms nm
                    add(j): j 1
                ]
                if(_): {sa > al} [ set(al): sa ]
                if(_): {kind = 12} [ add(off): off ssz ]
                elif(_): {ssz > size} [ set(size): ssz ]
            ]
            add(p_i): p_i 1
        ]
        else(_): [
            set(more): 1
            while(_): {more = 1} [
                set(mname): ""
                set(mt): bt
                p_is(colon): ":"
                if(_): {colon = 0} [
                    p_declarator(mt): bt 0
                    set(mname): p_dname
                ]
                p_accept(bf): ":"
                if(_): {bf = 1} [
                    # a bit-field: its own storage of its declared type
                    p_cond(we):
                    p_const(_): we
                ]
                p_skip_attr(_):
                at(ma): ty_al mt
                at(msz): ty_sz mt
                at(mk): ty_k mt
                if(_): {mk = 10} [
                    at(mn0): ty_n mt
                    if(_): {mn0 < 0} [ set(msz): 0 ]
                ]
                if(_): {kind = 12} [
                    set(off): {(off + ma - 1) - (off + ma - 1) % ma}
                ]
                else(_): [ set(off): 0 ]
                if(_): {mname != ""} [
                    len(nm): mb_n
                    push(_): mb_n mname
                    push(_): mb_t mt
                    push(_): mb_o off
                    push(_): ms nm
                ]
                if(_): {ma > al} [ set(al): ma ]
