        add(i): i 1
    ]
    # __func__
    at(fname): sy_n s
    len(fl): fname
    vec(fv): ""
    set(j): 0
    while(_): {j < fl} [
        byte(fb): fname j
        push(_): fv fb
        add(j): j 1
    ]
    p_strnode(fsn): fv
    sy_new(fs): "__func__" 4 ty_int
    set(sy_k): fs 5
    set(sy_v): fs fsn
    sc_bind(_): "__func__" fs
    sc_bind(_): "__FUNCTION__" fs
    p_block(body):
    sc_pop(_):
    p_check_labels(_):
    gen_function(_): s psyms p_fsyms body
    set(p_fn): {0 - 1}
]
p_check_labels(r): [
    set(r): 0
]

# ---- file scope ----
p_unit(r): [
    set(r): 0
    while(_): {1 = 1} [
        at(k): tk_k p_i
        if(_): {k = 0} [ break(_): "" ]
        p_accept(semi): ";"
        p_skip_attr(_):
        if(_): {semi = 0} [
            p_mark(_):
            p_is(sa): "_Static_assert"
            if(_): {sa = 1} [
                add(p_i): p_i 1
                p_skip_parens(_):
                p_expect(_): ";"
            ]
            else(_): [
                p_istype(isty):
                set(bt): ty_int
                if(_): {isty = 1} [ p_declspec(bt): ]
                else(_): [
                    # old C: a declaration with no type is int
                    set(p_sclass): 0
                    at(k2): tk_k p_i
                    if(_): {k2 != 1} [ p_failat(_): "expected declaration" ]
                ]
                p_decl_rest(_): bt 1
            ]
        ]
    ]
]

# ======================= constant expressions =======================
# The value of integer constant expression node n (an error if it is not
# one).
p_const(r): n [
    p_ceval(r): n
    if(_): {r = null} [ p_fail(_): "expression is not an integer constant" ]
]
# The value of node n when it is constant, else null.
p_ceval(r): n [
    set(r): null
    at(k): nd_k n
    at(t): nd_t n
    if(_): {k = 1} [
        at(r): nd_v n
        return(_): r
    ]
    if(_): {k = 19} [
        at(a): nd_a n
        p_ceval(v): a
        if(_): {v = null} [ return(_): r ]
        ty_isint(ii): t
        at(tk): ty_k t
        if(_): {ii = 1} [
            ty_bits(bits): t
            at(u): ty_u t
            set(r): v
            if(_): {tk = 1} [
                set(r): 0
                if(_): {v != 0} [ set(r): 1 ]
            ]
            elif(_): {bits < 64 && u = 1} [ set(r): {v & ((1 << bits) - 1)} ]
            elif(_): {bits < 64} [ set(r): {(v << (64 - bits)) >> (64 - bits)} ]
        ]
        elif(_): {tk = 9} [ set(r): v ]
        return(_): r
    ]
    if(_): {k = 5} [
        at(a): nd_a n
        at(b): nd_b n
        at(op): nd_c n
        p_ceval(x): a
        p_ceval(y): b
        if(_): {x = null || y = null} [ return(_): r ]
        at(at2): nd_t a
        at(u): ty_u at2
        if(_): {op = 16} [ set(r): {x + y} ]
        elif(_): {op = 17} [ set(r): {x - y} ]
        elif(_): {op = 18} [ set(r): {x * y} ]
        elif(_): {op = 19 || op = 20} [
            if(_): {y = 0} [ p_fail(_): "division by zero in a constant expression" ]
            if(_): {op = 19} [ pp_idiv(r): x y ]
            else(_): [ set(r): {x % y} ]
        ]
        elif(_): {op = 22} [ set(r): {x = y} ]
        elif(_): {op = 23} [ set(r): {x != y} ]
        elif(_): {op = 24} [ set(r): {x < y} ]
        elif(_): {op = 25} [ set(r): {x <= y} ]
        elif(_): {op = 26} [ set(r): {x > y} ]
        elif(_): {op = 27} [ set(r): {x >= y} ]
        elif(_): {op = 30} [ set(r): {x ^ y} ]
        elif(_): {op = 31} [ set(r): {x & y} ]
        elif(_): {op = 32} [ set(r): {x | y} ]
        elif(_): {op = 33} [ set(r): {x << y} ]
        elif(_): {op = 34} [
            set(r): {x >> y}
            if(_): {u = 1 && x < 0 && y > 0} [ set(r): {(x >> y) & ((1 << (64 - y)) - 1)} ]
        ]
        if(_): {r = true} [ set(r): 1 ]
        if(_): {r = false} [ set(r): 0 ]
        # wrap to the result type
        ty_isint(ri): t
        if(_): {ri = 1 && r != null} [
            ty_bits(rb): t
            at(ru): ty_u t
            if(_): {rb < 64 && ru = 1} [ set(r): {r & ((1 << rb) - 1)} ]
            elif(_): {rb < 64} [ set(r): {(r << (64 - rb)) >> (64 - rb)} ]
        ]
        return(_): r
    ]
    if(_): {k = 6 || k = 7} [
        at(a): nd_a n
        at(b): nd_b n
        p_ceval(x): a
        p_ceval(y): b
        if(_): {x = null || y = null} [ return(_): r ]
        set(r): 0
        if(_): {k = 6 && x != 0 && y != 0} [ set(r): 1 ]
        if(_): {k = 7 && (x != 0 || y != 0)} [ set(r): 1 ]
        return(_): r
    ]
    if(_): {k = 8 || k = 9 || k = 10} [
        at(a): nd_a n
        p_ceval(x): a
        if(_): {x = null} [ return(_): r ]
        if(_): {k = 8} [
            set(r): 0
            if(_): {x = 0} [ set(r): 1 ]
        ]
        if(_): {k = 9} [ set(r): {0 - x} ]
        if(_): {k = 10} [ set(r): {x ^ (0 - 1)} ]
        ty_isint(ri): t
        if(_): {ri = 1} [
            ty_bits(rb): t
            at(ru): ty_u t
            if(_): {rb < 64 && ru = 1} [ set(r): {r & ((1 << rb) - 1)} ]
            elif(_): {rb < 64} [ set(r): {(r << (64 - rb)) >> (64 - rb)} ]
        ]
        return(_): r
    ]
    if(_): {k = 17} [
        at(a): nd_a n
        p_ceval(x): a
        if(_): {x = null} [ return(_): r ]
        at(b): nd_b n
        at(c): nd_c n
        if(_): {x != 0} [ p_ceval(r): b ]
        else(_): [ p_ceval(r): c ]
        return(_): r
    ]
    if(_): {k = 18} [
        at(b): nd_b n
        p_ceval(r): b
    ]
]
