# C preprocessor in USSR for usa, forked from russia's pp.su (the pass
# ussr runs before parsing) with '#' for '$' and what C code needs:
#
#     pp_run(text): path    -> preprocessed source of the file at path
#
# Directives (a line whose first non-blank byte is '#'):
#   #include "file" | <file>  "" against the including file's directory,
#                             then -I directories, then usa's include/
#   #define NAME value        object-like macro
#   #define NAME(a, b) body   function-like, with # (stringize), ## (paste)
#                             and ... / __VA_ARGS__
#   #undef NAME
#   #if expr / #ifdef / #ifndef / #elif expr / #else / #endif
#                             expr: integer constant expression with
#                             defined NAME and defined(NAME)
#   #error text               stops with text; #warning prints it
#   #pragma once              the file is read at most once (as $once);
#                             other pragmas, #line and #ident are ignored
# __FILE__ and __LINE__ expand where they are used.
#
# Comments are removed and backslash-newlines spliced before directives
# are seen; the lines they take are kept, so the line map stays right.
# A function-like macro call whose ')' is on a later line takes those
# lines in. A macro's own name is not expanded inside its expansion.
#
# Directive lines produce no output; every other active line is copied
# with its macros expanded (strings and character constants are left
# alone). On an error pp_failed is 1 and pp_msg holds the message.
#
# pp_mapf/pp_mapl give, for each line of the output, the file and the
# line it came from.

global(_): pp_inc pp_once pp_cact pp_cse pp_ctk pp_act
global(_): pp_out pp_outv pp_failed pp_msg pp_win pp_sigp pp_xargs pp_xafter
global(_): pp_mapf pp_mapl pp_curline pp_dirs pp_sysdir pp_hide pp_more
global(_): pp_dtab pp_dn pp_dv pp_dp pp_dlive pp_ndefs pp_ev_t pp_ev_k pp_ev_i
global(_): pp_pend pp_pendl pp_idx

# ---- hash tables: a vector of n key buckets then n value buckets ----
ht_new(r): n [
    vec(r): ""
    set(i): 0
    while(_): {i < n + n} [
        vec(b): ""
        push(_): r b
        add(i): i 1
    ]
]
# The value stored under key, or -1.
ht_get(r): h key [
    set(r): {0 - 1}
    len(m): h
    set(n): {m >> 1}
    crc32(c): key
    set(bi): {c & (n - 1)}
    at(ks): h bi
    len(k): ks
    while(_): {k > 0} [
        sub(k): k 1
        at(x): ks k
        if(_): {x = key} [
            at(vs): h {bi + n}
            at(r): vs k
            set(k): 0
        ]
    ]
]
ht_put(r): h key val [
    set(r): 0
    len(m): h
    set(n): {m >> 1}
    crc32(c): key
    set(bi): {c & (n - 1)}
    at(ks): h bi
    at(vs): h {bi + n}
    len(k): ks
    set(hit): 0
    while(_): {k > 0} [
        sub(k): k 1
        at(x): ks k
        if(_): {x = key} [
            set(vs): k val
            set(hit): 1
            set(k): 0
        ]
    ]
    if(_): {hit = 0} [
        push(_): ks key
        push(_): vs val
    ]
]

# Integer quotient of a by b, truncated toward zero, as C divides.
# '/' always gives a real; at() truncates a real index, so pp_idx (0..65535)
# turns the exact real quotient back into an integer 16 bits at a time.
pp_idiv(r): a b [
    set(q): {(a - a % b) / b}
    set(neg): 0
    if(_): {q < 0} [
        set(neg): 1
        set(q): {0 - q}
    ]
    pp_f2i(r): q
    if(_): {neg = 1} [ set(r): {0 - r} ]
]
# A non-negative real below 2^63 truncated to an integer.
pp_f2i(r): x [
    if(_): {pp_idx = null} [
        vec(pp_idx): ""
        set(i): 0
        while(_): {i < 65536} [
            push(_): pp_idx i
            add(i): i 1
        ]
    ]
    if(_): {x < 65536} [
        at(r): pp_idx x
    ]
    elif(_): {x < 4294967296} [
        at(h): pp_idx {x / 65536}
        at(l): pp_idx {x - h * 65536}
        set(r): {h * 65536 + l}
    ]
    else(_): [
        pp_f2i(h): {x / 4294967296}
        pp_f2i(l): {x - h * 4294967296}
        set(r): {h * 4294967296 + l}
    ]
]

# ---- bytes ----
pp_space_p(r): b [
    set(r): 0
    if(_): {b = 32 || (b > 8 && b < 14)} [ set(r): 1 ]
]
pp_alpha_p(r): b [
    set(r): 0
    if(_): {(b > 64 && b < 91) || (b > 96 && b < 123)} [ set(r): 1 ]
]
pp_digit_p(r): b [
    set(r): 0
    if(_): {b > 47 && b < 58} [ set(r): 1 ]
]
pp_idstart_p(r): b [
    set(r): 0
    if(_): {(b > 64 && b < 91) || (b > 96 && b < 123) || b = 95} [ set(r): 1 ]
]
pp_idchar_p(r): b [
    set(r): 0
    if(_): {(b > 64 && b < 91) || (b > 96 && b < 123) || b = 95 || (b > 47 && b < 58)} [ set(r): 1 ]
]
# First index at or after i in s that is not white space.
pp_skip(r): s i [
    len(n): s
    set(r): i
    set(go): 1
    while(_): {go = 1 && r < n} [
        byte(b): s r
        if(_): {b = 32 || (b > 8 && b < 14)} [ add(r): r 1 ]
        else(_): [ set(go): 0 ]
    ]
]
# End of the identifier (alnum or _) run starting at i.
pp_idend(r): s i [
    len(n): s
    set(r): i
    set(go): 1
    while(_): {go = 1 && r < n} [
        byte(b): s r
        if(_): {(b > 64 && b < 91) || (b > 96 && b < 123) || b = 95 || (b > 47 && b < 58)} [ add(r): r 1 ]
        else(_): [ set(go): 0 ]
    ]
]
# s[i..j) as a string.
pp_cut(r): s i j [
    set(r): ""
    if(_): {j > i} [ slice(r): s i {j - i} ]
]
# s from i to its end.
pp_rest(r): s i [
    len(n): s
    pp_cut(r): s i n
]
# s without white space at either end.
pp_trim(r): s [
    len(n): s
    pp_skip(i): s 0
    set(j): n
    set(go): 1
    while(_): {go = 1 && j > i} [
        byte(b): s {j - 1}
        pp_space_p(go): b
        if(_): {go = 1} [ sub(j): j 1 ]
    ]
    pp_cut(r): s i j
]
# Index just past the "..." or '...' literal opening at i (escape-aware;
# the end of s when it never closes).
pp_strend(r): s i [
    len(n): s
    byte(q): s i
    add(r): i 1
    set(esc): 0
    set(go): 1
    while(_): {go = 1 && r < n} [
        byte(b): s r
        add(r): r 1
        if(_): {esc = 1} [
            set(esc): 0
        ]
        elif(_): {b = 92} [
            set(esc): 1
        ]
        elif(_): {b = q || b = 10} [
            set(go): 0
        ]
    ]
]
pp_fail(r): msg [
    if(_): {pp_failed = 0} [
        set(pp_failed): 1
        len(d): pp_inc
        set(pp_msg): msg
        if(_): {d > 0} [
            at(f): pp_inc {d - 1}
            encode(ls): pp_curline
            concat(pp_msg): f ":"
            concat(pp_msg): pp_msg ls
            concat(pp_msg): pp_msg ": error: "
            concat(pp_msg): pp_msg msg
        ]
    ]
    set(r): 0
]

# ---- defines ----
# A define is index i into pp_dn (name), pp_dv (body), pp_dp (the
# parameter vector, null for an object-like macro) and pp_dlive.
pp_find(r): name [
    ht_get(r): pp_dtab name
    if(_): {r >= 0} [
        at(lv): pp_dlive r
        if(_): {lv = 0} [ set(r): {0 - 1} ]
    ]
]
pp_define(r): name params value [
    set(r): 0
    ht_get(i): pp_dtab name
    if(_): {i >= 0} [
        set(pp_dv): i value
        set(pp_dp): i params
        set(pp_dlive): i 1
    ]
    else(_): [
        push(_): pp_dn name
        push(_): pp_dv value
        push(_): pp_dp params
        push(_): pp_dlive 1
        ht_put(_): pp_dtab name pp_ndefs
        add(pp_ndefs): pp_ndefs 1
    ]
]
pp_undef(r): name [
    set(r): 0
    ht_get(i): pp_dtab name
    if(_): {i >= 0} [ set(pp_dlive): i 0 ]
]
# Replace the top item of a stack vector.
pp_settop(r): v x [
    pop(_): v
    push(_): v x
    set(r): 0
]
pp_isdef(r): name [
    pp_find(i): name
    set(r): 0
    if(_): {i >= 0 || name = "__FILE__" || name = "__LINE__"} [ set(r): 1 ]
]
pp_hidden(r): name [
    set(r): 0
    len(n): pp_hide
    while(_): {n > 0} [
        sub(n): n 1
        at(x): pp_hide n
        if(_): {x = name} [
            set(r): 1
            set(n): 0
        ]
    ]
]
# Parameter list of "(a, b, ...)" starting at the '(' at i of s:
# pp_sigp gets the names (... as __VA_ARGS__); r is the index just
# past ')', or -1 (reported) when it is malformed.
pp_params(r): s i [
    vec(pp_sigp): ""
    len(n): s
    pp_skip(c): s {i + 1}
    set(r): {0 - 1}
    set(go): 1
    set(ch): 0
    if(_): {c < n} [ byte(ch): s c ]
    if(_): {ch = 41} [
        set(r): {c + 1}
        set(go): 0
    ]
    while(_): {go = 1} [
        set(nm): ""
        pp_idend(e): s c
        if(_): {e > c} [
            pp_cut(nm): s c e
        ]
        elif(_): {c + 2 < n} [
            slice(dots): s c 3
            if(_): {dots = "..."} [
                set(nm): "__VA_ARGS__"
                add(e): c 3
            ]
        ]
        if(_): {nm = ""} [
            set(go): 0
        ]
        else(_): [
            # a named variadic parameter: "args..."
            pp_skip(c): s e
            if(_): {c + 2 < n} [
                slice(dots2): s c 3
                if(_): {dots2 = "..."} [
                    set(nm): "__VA_ARGS__"
                    add(c): c 3
                    pp_skip(c): s c
                ]
            ]
            push(_): pp_sigp nm
            set(ch2): 0
            if(_): {c < n} [ byte(ch2): s c ]
            if(_): {ch2 = 41} [
                set(r): {c + 1}
                set(go): 0
            ]
            elif(_): {ch2 = 44} [
                pp_skip(c): s {c + 1}
            ]
            else(_): [ set(go): 0 ]
        ]
    ]
    if(_): {r < 0} [
        pp_cut(sig): s i n
        concat(m): "invalid macro parameter list: " sig
        pp_fail(_): m
    ]
]

# ---- macro expansion ----
# Arguments of the invocation whose '(' is at open: pp_xargs, and pp_xafter
# just past its ')'. 0, or 1 when it never closes on this line (pp_more is
# then set, and the caller takes the next line in).
pp_args(r): s open [
    vec(pp_xargs): ""
    set(pp_xafter): 0
    len(n): s
    add(c): open 1
    set(st): c
    set(pd): 0
    set(r): 1
    set(go): 1
    while(_): {go = 1 && c < n} [
        byte(b): s c
        if(_): {b = 34 || b = 39} [
            pp_strend(c): s c
        ]
        elif(_): {b = 40 || b = 91 || b = 123} [
            add(pd): pd 1
            add(c): c 1
        ]
        elif(_): {(b = 41 || b = 93 || b = 125) && pd > 0} [
            sub(pd): pd 1
            add(c): c 1
        ]
        elif(_): {b = 41} [
            set(go): 0
            len(count): pp_xargs
            pp_cut(a): s st c
            pp_trim(a2): a
            if(_): {count > 0 || a2 != ""} [
                push(_): pp_xargs a2
            ]
            add(pp_xafter): c 1
            set(r): 0
        ]
        elif(_): {b = 44 && pd = 0} [
            pp_cut(a3): s st c
            pp_trim(a4): a3
            push(_): pp_xargs a4
            add(c): c 1
            set(st): c
        ]
        else(_): [
            add(c): c 1
        ]
    ]
    if(_): {r = 1} [ set(pp_more): 1 ]
]
# The string literal spelling text: "text" with \ and " escaped.
pp_stringize(r): text [
    set(r): "\""
    len(n): text
    set(i): 0
    set(inq): 0
    while(_): {i < n} [
        slice(ch): text i 1
        byte(b): text i
        if(_): {b = 34 || (b = 92 && inq != 0)} [ concat(r): r "\\" ]
        if(_): {inq = 0 && (b = 34 || b = 39)} [ set(inq): b ]
        elif(_): {inq != 0 && b = 92} [
            # keep the escaped character inside the literal as it is
            concat(r): r ch
            add(i): i 1
            slice(ch): text i 1
            byte(b2): text i
            if(_): {b2 = 34 || b2 = 92} [ concat(r): r "\\" ]
        ]
        elif(_): {inq != 0 && b = inq} [ set(inq): 0 ]
        concat(r): r ch
        add(i): i 1
    ]
    concat(r): r "\""
]
# body with each parameter identifier replaced by its argument, #param
# stringized and the ## between two pieces removed.
pp_subst(r): body params args [
    vec(out): ""
    len(n): body
    len(pc): params
    len(ac): args
    set(c): 0
    set(paste): 0
    while(_): {c < n} [
        byte(b): body c
        if(_): {b = 34 || b = 39} [
            pp_strend(e): body c
            pp_cut(s): body c e
            push(_): out s
            set(c): e
            set(paste): 0
        ]
        elif(_): {b = 35 && c + 1 < n} [
            byte(b2): body {c + 1}
            if(_): {b2 = 35} [
                # paste: drop the white space before and after
                len(on): out
                set(go): 1
                while(_): {go = 1 && on > 0} [
                    at(last): out {on - 1}
                    pp_trim(lt): last
                    if(_): {lt = ""} [
                        pop(_): out
                        sub(on): on 1
                    ]
                    else(_): [ set(go): 0 ]
                ]
                pp_skip(c): body {c + 2}
                set(paste): 1
            ]
            else(_): [
                pp_skip(c2): body {c + 1}
                pp_idend(e2): body c2
                pp_cut(nm): body c2 e2
                set(hit): {0 - 1}
                set(k): 0
                while(_): {hit < 0 && k < pc} [
                    at(p): params k
                    if(_): {p = nm} [ set(hit): k ]
                    add(k): k 1
                ]
                if(_): {hit >= 0 && e2 > c2} [
                    set(arg): ""
                    if(_): {hit < ac} [ at(arg): args hit ]
                    pp_stringize(sz): arg
                    push(_): out sz
                    set(c): e2
                ]
                else(_): [
                    push(_): out "#"
                    add(c): c 1
                ]
                set(paste): 0
            ]
        ]
        elif(_): {(b > 64 && b < 91) || (b > 96 && b < 123) || b = 95} [
            pp_idend(e3): body c
            pp_cut(nm2): body c e3
            set(hit2): {0 - 1}
            set(k2): 0
            while(_): {hit2 < 0 && k2 < pc} [
                at(p2): params k2
                if(_): {p2 = nm2} [ set(hit2): k2 ]
                add(k2): k2 1
            ]
            if(_): {hit2 >= 0} [
                set(arg2): ""
                if(_): {hit2 < ac} [ at(arg2): args hit2 ]
                # GNU: , ## __VA_ARGS__ drops the comma when it is empty
                if(_): {paste = 1 && arg2 = "" && nm2 = "__VA_ARGS__"} [
                    len(on2): out
                    if(_): {on2 > 0} [
                        at(last2): out {on2 - 1}
                        pp_trim(lt2): last2
                        if(_): {lt2 = ","} [ pop(_): out ]
                    ]
                ]
                if(_): {paste = 0} [
                    # an argument not next to ## is expanded first
                    pp_expand(arg2): arg2 0
                    # ...unless ## follows it
                    pp_skip(nx): body e3
                    if(_): {nx + 1 < n} [
                        slice(nx2): body nx 2
                        if(_): {nx2 = "##"} [
                            if(_): {hit2 < ac} [ at(arg2): args hit2 ]
                        ]
                    ]
                ]
                push(_): out arg2
            ]
            else(_): [
                push(_): out nm2
            ]
            set(c): e3
            set(paste): 0
        ]
        else(_): [
            # a run up to the next identifier, literal or #
            set(e4): {c + 1}
            set(go4): 1
            while(_): {go4 = 1 && e4 < n} [
                byte(b4): body e4
                if(_): {(b4 > 64 && b4 < 91) || (b4 > 96 && b4 < 123) || b4 = 95 || b4 = 34 || b4 = 39 || b4 = 35} [ set(go4): 0 ]
                else(_): [ add(e4): e4 1 ]
            ]
            pp_cut(run): body c e4
            push(_): out run
            set(c): e4
            set(paste): 0
        ]
    ]
    pp_join(r): out
]
# text with its macros expanded.
pp_expand(r): text depth [
    set(r): text
    if(_): {depth > 200} [
        pp_fail(_): "macro expansion too deep"
        return(_): r
    ]
    if(_): {pp_ndefs = 0} [ return(_): r ]
    vec(out): ""
    len(n): text
    set(c): 0
    set(changed): 0
    while(_): {pp_failed = 0 && c < n} [
        byte(b): text c
        if(_): {b = 34 || b = 39} [
            pp_strend(e): text c
            pp_cut(s): text c e
            push(_): out s
            set(c): e
        ]
        elif(_): {(b > 64 && b < 91) || (b > 96 && b < 123) || b = 95} [
            pp_idend(e3): text c
            pp_cut(name): text c e3
            set(c): e3
            set(done): 0
            pp_find(di): name
            if(_): {di >= 0} [
                pp_hidden(hid): name
                if(_): {hid = 1} [ set(di): {0 - 1} ]
            ]
            if(_): {di >= 0} [
                at(prm): pp_dp di
                at(body): pp_dv di
                if(_): {prm = null} [
                    push(_): pp_hide name
                    pp_expand(x): body {depth + 1}
                    pop(_): pp_hide
                    push(_): out x
                    set(changed): 1
                    set(done): 1
                ]
                else(_): [
                    pp_skip(la): text e3
                    set(lb): 0
                    if(_): {la < n} [ byte(lb): text la ]
                    if(_): {lb = 40} [
                        pp_args(ar): text la
                        if(_): {ar = 1} [ return(_): r ]
                        set(args): pp_xargs
                        set(after): pp_xafter
                        len(na): args
                        len(np): prm
                        set(va): 0
                        if(_): {np > 0} [
                            at(lastp): prm {np - 1}
                            if(_): {lastp = "__VA_ARGS__"} [ set(va): 1 ]
                        ]
                        if(_): {va = 1 && na > np} [
                            # the extra arguments join __VA_ARGS__
                            vec(a2): ""
                            set(k): 0
                            while(_): {k < np - 1} [
                                at(ak): args k
                                push(_): a2 ak
                                add(k): k 1
                            ]
                            set(rest): ""
                            while(_): {k < na} [
                                at(ak2): args k
                                if(_): {rest != ""} [ concat(rest): rest ", " ]
                                concat(rest): rest ak2
                                add(k): k 1
                            ]
                            push(_): a2 rest
                            set(args): a2
                            set(na): np
                        ]
                        if(_): {na < np && (va = 1 || (na = 0 && np = 1))} [
                            while(_): {na < np} [
                                push(_): args ""
                                add(na): na 1
                            ]
                        ]
                        if(_): {na != np} [
                            concat(m): "macro '" name
                            concat(m): m "' expects "
                            encode(nps): np
                            concat(m): m nps
                            concat(m): m " arguments, got "
                            encode(nas): na
                            concat(m): m nas
                            pp_fail(_): m
                        ]
                        if(_): {pp_failed = 0} [
                            pp_subst(sub): body prm args
                            push(_): pp_hide name
                            pp_expand(x2): sub {depth + 1}
                            pop(_): pp_hide
                            push(_): out x2
                            set(c): after
                            set(changed): 1
                        ]
                        set(done): 1
                    ]
                ]
            ]
            if(_): {done = 0} [
                if(_): {name = "__LINE__"} [
                    encode(ln): pp_curline
                    push(_): out ln
                ]
                elif(_): {name = "__FILE__"} [
                    len(d): pp_inc
                    at(f): pp_inc {d - 1}
                    pp_stringize(fs): f
                    push(_): out fs
                ]
                else(_): [ push(_): out name ]
            ]
        ]
        else(_): [
            # copy the whole run up to the next identifier or literal; a
            # number's letters (0x1F, 1e5, 10UL) belong to the number
            set(e2): {c + 1}
            if(_): {b > 47 && b < 58} [
                set(go3): 1
                while(_): {go3 = 1 && e2 < n} [
                    byte(b3): text e2
                    if(_): {(b3 > 64 && b3 < 91) || (b3 > 96 && b3 < 123) || b3 = 95 || (b3 > 47 && b3 < 58) || b3 = 46} [ add(e2): e2 1 ]
                    else(_): [ set(go3): 0 ]
                ]
            ]
            set(go): 1
            while(_): {go = 1 && e2 < n} [
                byte(b2): text e2
                if(_): {(b2 > 64 && b2 < 91) || (b2 > 96 && b2 < 123) || b2 = 95 || b2 = 34 || b2 = 39 || (b2 > 47 && b2 < 58)} [ set(go): 0 ]
                else(_): [ add(e2): e2 1 ]
            ]
            pp_cut(run): text c e2
            push(_): out run
            set(c): e2
        ]
    ]
    if(_): {changed = 1} [ pp_join(r): out ]
]

# ---- conditionals ----
pp_cpush(r): cond [
    set(r): 0
    len(d): pp_cact
    if(_): {d >= 64} [
        pp_fail(_): "conditional nesting too deep"
    ]
    if(_): {pp_failed = 0} [
        set(a): 0
        if(_): {pp_act = 1 && cond != 0} [ set(a): 1 ]
        push(_): pp_cact a
        push(_): pp_cse 0
        push(_): pp_ctk a
        set(pp_act): a
    ]
]
# Whether the conditional enclosing the innermost one is active.
pp_cparent(r): [
    len(n): pp_cact
    set(r): 1
    if(_): {n > 1} [ at(r): pp_cact {n - 2} ]
]
pp_celse(r): [
    set(r): 0
    len(n): pp_cact
    if(_): {n = 0} [ pp_fail(_): "#else without #if" ]
    if(_): {pp_failed = 0} [
        sub(i): n 1
        at(s): pp_cse i
        if(_): {s = 1} [ pp_fail(_): "#else after #else" ]
    ]
    if(_): {pp_failed = 0} [
        pp_settop(_): pp_cse 1
        pp_cparent(p):
        at(t): pp_ctk i
        set(a): 0
        if(_): {p = 1 && t = 0} [ set(a): 1 ]
