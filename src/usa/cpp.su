            pp_canon(cn): cur
            push(_): pp_once cn
        ]
    ]
    elif(_): {dn = "line" || dn = "ident" || dn = "sccs" || dn = ""} [
        set(r): 0
    ]
    else(_): [
        concat(m): "unknown preprocessing directive #" dn
        pp_fail(_): m
    ]
]
pp_pinclude(r): s [
    set(r): 0
    set(t): s
    len(n): t
    set(b): 0
    if(_): {n > 0} [ byte(b): t 0 ]
    if(_): {b != 34 && b != 60} [
        # #include MACRO
        pp_expand(t): s 0
        pp_trim(t): t
        len(n): t
        if(_): {n > 0} [ byte(b): t 0 ]
    ]
    set(close): 34
    set(quoted): 1
    if(_): {b = 60} [
        set(close): 62
        set(quoted): 0
    ]
    elif(_): {b != 34} [
        pp_fail(_): "#include expects \"FILENAME\" or <FILENAME>"
        return(_): r
    ]
    set(e): 1
    while(_): {e < n} [
        byte(b2): t e
        if(_): {b2 = close} [ set(n): e ]
        else(_): [ add(e): e 1 ]
    ]
    pp_cut(fn): t 1 e
    pp_resolve(path): fn quoted
    if(_): {path = ""} [
        concat(m): fn ": No such file or directory"
        pp_fail(_): m
        return(_): r
    ]
    pp_file(_): path
]
pp_pdefine(r): s [
    set(r): 0
    len(n): s
    set(b): 0
    if(_): {n > 0} [ byte(b): s 0 ]
    pp_idstart_p(ok): b
    if(_): {ok = 0} [
        pp_fail(_): "macro names must be identifiers"
        return(_): r
    ]
    pp_idend(ne): s 0
    pp_cut(name): s 0 ne
    set(params): null
    set(c): ne
    set(b2): 0
    if(_): {ne < n} [ byte(b2): s ne ]
    if(_): {b2 = 40} [
        pp_params(c): s ne
        if(_): {pp_failed = 1} [ return(_): r ]
        set(params): pp_sigp
    ]
    pp_rest(val): s c
    pp_trim(val): val
    pp_define(_): name params val
]

# Predefined macros: target facts usa's code generator keeps.
pp_predefine(r): [
    set(r): 0
    pp_define(_): "__STDC__" null "1"
    pp_define(_): "__STDC_VERSION__" null "199901L"
    pp_define(_): "__STDC_HOSTED__" null "1"
    pp_define(_): "__usa__" null "1"
    pp_define(_): "__USSR__" null "1"
    pp_define(_): "__LP64__" null "1"
    pp_define(_): "_LP64" null "1"
    pp_define(_): "__CHAR_BIT__" null "8"
    pp_define(_): "__CHAR_UNSIGNED__" null "1"
    pp_define(_): "__SIZEOF_SHORT__" null "2"
    pp_define(_): "__SIZEOF_INT__" null "4"
    pp_define(_): "__SIZEOF_LONG__" null "8"
    pp_define(_): "__SIZEOF_LONG_LONG__" null "8"
    pp_define(_): "__SIZEOF_POINTER__" null "8"
    pp_define(_): "__SIZEOF_FLOAT__" null "4"
    pp_define(_): "__SIZEOF_DOUBLE__" null "8"
    pp_define(_): "__DATE__" null "\"Oct 29 2026\""
    pp_define(_): "__TIME__" null "\"00:00:00\""
]

# Preprocess the file at path: dirs are the -I directories then usa's
# include directory; defs the -D NAME=VALUE pairs as a vector of
# "NAME=VALUE" strings.
pp_init(r): dirs defs [
    set(r): 0
    ht_new(pp_dtab): 1024
    vec(pp_dn): ""
    vec(pp_dv): ""
    vec(pp_dp): ""
    vec(pp_dlive): ""
    set(pp_ndefs): 0
    set(pp_dirs): dirs
    vec(pp_inc): ""
    vec(pp_once): ""
    vec(pp_cact): ""
    vec(pp_cse): ""
    vec(pp_ctk): ""
    vec(pp_hide): ""
    set(pp_act): 1
    set(pp_out): ""
    set(pp_pend): ""
    set(pp_pendl): 0
    set(pp_more): 0
    set(pp_curline): 0
    set(pp_failed): 0
    set(pp_msg): ""
    set(pp_win): 0
    getenv(os): "OS"
    if(_): {os = "Windows_NT"} [ set(pp_win): 1 ]
    pp_predefine(_):
    len(nd): defs
    set(i): 0
    while(_): {i < nd} [
        at(d): defs i
        len(dl): d
        set(eq): {0 - 1}
        set(k): 0
        while(_): {k < dl && eq < 0} [
            byte(bk): d k
            if(_): {bk = 61} [ set(eq): k ]
            add(k): k 1
        ]
        if(_): {eq < 0} [ pp_define(_): d null "1" ]
        else(_): [
            slice(dn): d 0 eq
            pp_rest(dv): d {eq + 1}
            pp_define(_): dn null dv
        ]
        add(i): i 1
    ]
]
# One translation unit: the defines are fresh for each (pp_init first).
pp_run(r): path [
    vec(pp_outv): ""
    vec(pp_mapf): ""
    vec(pp_mapl): ""
    vec(pp_inc): ""
    vec(pp_cact): ""
    pp_file(_): path
    if(_): {pp_failed = 0} [
        len(cd): pp_cact
        if(_): {cd != 0} [ pp_fail(_): "unterminated #if" ]
    ]
    pp_join(pp_out): pp_outv
    set(r): pp_out
]
