# Expressions and statements of the usa parser (parse.su has the rest).
#
# Expression nodes (nd_k): 1 integer constant (v), 2 floating constant
# (v: its spelling, or an integer for a whole value), 3 variable (a: the
# symbol), 4 string literal (v: its address), 5 binary operator (c: the
# VM opcode ADD 16 .. SHR 34), 6 &&, 7 ||, 8 !, 9 unary -, 10 ~, 11 &,
# 12 * (load through a pointer), 13 =, 14 op= (c: opcode, v: the type
# the operation is done in), 15 ++/-- (b: 1 postfix, c: the step),
# 16 call (a: callee, v: the arguments), 17 ?:, 18 comma, 19 cast,
# 22 va_start, 25 a function used as a value (a: symbol), 26 array to
# pointer (a: the array), 27 address plus offset (a: base address, v:
# bytes), 29 USSR string constant (v), 47 statement expression (a:
# block, b: value).
# Statements: 30 block (v: vector), 31 expression, 32 if, 33 while,
# 34 do, 35 for (v: body), 36 return, 37 break, 38 continue, 39 switch
# (v: the case nodes), 40 case (v: value), 41 default, 42 goto (v: name),
# 43 label (v: name), 44 empty, 45 clear (a: lvalue, v: bytes).

# ---- conversions ----
# n as an rvalue: arrays decay to pointers, functions to their address.
p_rval(r): n [
    set(r): n
    at(t): nd_t n
    at(k): ty_k t
    if(_): {k = 10} [
        at(b): ty_b t
        ty_ptr(pt): b
        nd_new(r): 26 pt n 0 0 0
    ]
    elif(_): {k = 11} [
        at(nk): nd_k n
        ty_ptr(pt): t
        if(_): {nk = 3} [
            at(s): nd_a n
            nd_new(r): 25 pt s 0 0 0
        ]
        else(_): [
            nd_new(r): 19 pt n 0 0 0
        ]
    ]
]
# n converted to type t.
p_conv(r): n t [
    p_rval(r): n
    at(f): nd_t r
    if(_): {f = t} [ return(_): r ]
    at(tk): ty_k t
    at(fk): ty_k f
    if(_): {tk = 12 || tk = 13} [
        if(_): {fk = tk} [ return(_): r ]
        p_fail(_): "incompatible types when converting to a struct or union"
    ]
    if(_): {fk = 12 || fk = 13} [
        if(_): {tk != 0} [ p_fail(_): "a struct or union cannot be converted to a scalar" ]
    ]
    at(nk): nd_k r
    if(_): {nk = 1} [
        ty_isint(ti): t
        if(_): {ti = 1 || tk = 9} [
            nd_new(c): 19 t r 0 0 0
            p_ceval(v): c
            nd_num(r): v t
            return(_): r
        ]
        if(_): {tk = 7 || tk = 8} [
            at(iv): nd_v r
            nd_new(r): 2 t 0 0 0 iv
            return(_): r
        ]
    ]
    if(_): {nk = 2 && (tk = 7 || tk = 8)} [
        at(fv): nd_v r
        nd_new(r): 2 t 0 0 0 fv
        return(_): r
    ]
    nd_new(r): 19 t r 0 0 0
]
p_isnullconst(r): n [
    set(r): 0
    at(k): nd_k n
    if(_): {k = 1} [
        at(v): nd_v n
        if(_): {v = 0} [ set(r): 1 ]
    ]
    if(_): {k = 19} [
        at(a): nd_a n
        p_isnullconst(r): a
    ]
]
p_new_assign(r): lv e [
    at(t): nd_t lv
    at(k): ty_k t
    if(_): {k = 10} [ p_fail(_): "assignment to an array" ]
    p_conv(e2): e t
    nd_new(r): 13 t lv e2 0 0
]
# A binary operator node (VM opcode op) with C's conversions applied.
p_binop(r): op l r0 [
    p_rval(a): l
    p_rval(b): r0
    at(ta): nd_t a
    at(tb): nd_t b
    ty_isptr(pa): ta
    ty_isptr(pb): tb
    ty_isarith(ia): ta
    ty_isarith(ib): tb
    if(_): {op = 16 && pb = 1 && pa = 0} [
        set(x): a
        set(a): b
        set(b): x
        set(ta): nd_t a
        set(tb): nd_t b
        at(ta): nd_t a
        at(tb): nd_t b
        set(pa): 1
        set(pb): 0
        ty_isarith(ia): ta
        ty_isarith(ib): tb
    ]
    if(_): {(op = 16 || op = 17) && pa = 1 && pb = 0} [
        if(_): {ib = 0} [ p_fail(_): "invalid operands to pointer arithmetic" ]
        at(base): ty_b ta
        at(bk): ty_k base
        set(es): 1
        if(_): {bk != 0 && bk != 11} [ ty_sizeof(es): base p_ln ]
        p_conv(idx): b ty_long
        if(_): {es != 1} [
            nd_num(sz): es ty_long
            p_fold(idx): 18 idx sz ty_long
        ]
        p_fold(r): op a idx ta
        return(_): r
    ]
    if(_): {op = 17 && pa = 1 && pb = 1} [
        at(base): ty_b ta
        at(bk): ty_k base
        set(es): 1
        if(_): {bk != 0} [ ty_sizeof(es): base p_ln ]
        p_fold(d): 17 a b ty_long
        set(r): d
        if(_): {es != 1} [
            nd_num(sz): es ty_long
            p_fold(r): 19 d sz ty_long
        ]
        return(_): r
    ]
    if(_): {op >= 22 && op <= 27} [
        if(_): {ia = 1 && ib = 1} [
            ty_common(ct): ta tb
            p_conv(a): a ct
            p_conv(b): b ct
        ]
        elif(_): {pa = 1 && pb = 0} [ p_conv(b): b ta ]
        elif(_): {pb = 1 && pa = 0} [ p_conv(a): a tb ]
        p_fold(r): op a b ty_int
        return(_): r
    ]
    if(_): {ia = 0 || ib = 0} [ p_fail(_): "invalid operands to binary operator" ]
    if(_): {op = 33 || op = 34} [
        ty_promote(pt): ta
        ty_promote(qt): tb
        p_conv(a): a pt
        p_conv(b): b qt
        p_fold(r): op a b pt
        return(_): r
    ]
    ty_common(ct): ta tb
    if(_): {op = 20 || op >= 30} [
        ty_isflt(fl): ct
        if(_): {fl = 1} [ p_fail(_): "invalid operands to binary operator (need integers)" ]
    ]
    p_conv(a): a ct
    p_conv(b): b ct
    p_fold(r): op a b ct
]
# A binary node, folded when both sides are integer constants.
p_fold(r): op a b t [
    nd_new(r): 5 t a b op 0
    at(ka): nd_k a
    at(kb): nd_k b
    ty_isint(ti): t
    at(tk): ty_k t
    if(_): {ka = 1 && kb = 1 && (ti = 1 || tk = 9)} [
        if(_): {op = 19 || op = 20} [
            at(bv): nd_v b
            if(_): {bv = 0} [ return(_): r ]
        ]
        at(at2): nd_t a
        at(au): ty_u at2
        set(fold): 1
        if(_): {au = 1 && (op = 19 || op = 20 || (op >= 24 && op <= 27))} [
            at(av): nd_v a
            at(bv2): nd_v b
            if(_): {av < 0 || bv2 < 0} [ set(fold): 0 ]
        ]
        if(_): {fold = 1} [
            p_ceval(v): r
            if(_): {v != null} [ nd_num(r): v t ]
        ]
    ]
]
# The type of node n is a struct or union: n itself (whose value is the
# object's address).
p_structval(r): n [
    set(r): n
    at(t): nd_t n
    ty_isagg(ag): t
    if(_): {ag = 0} [ p_fail(_): "request for a member in something not a structure or union" ]
]
p_member(r): base name arrow [
    if(_): {arrow = 1} [
        p_rval(p): base
        at(pt): nd_t p
        at(pk): ty_k pt
        if(_): {pk != 9} [ p_fail(_): "invalid type argument of '->'" ]
        at(st): ty_b pt
        set(sv): p
    ]
    else(_): [
        p_structval(sv): base
        at(st): nd_t sv
    ]
    ty_isagg(ag): st
    if(_): {ag = 0} [ p_fail(_): "request for a member in something not a structure or union" ]
    at(cpl): ty_cpl st
    if(_): {cpl = 0} [ p_fail(_): "dereferencing a pointer to an incomplete type" ]
    ty_member(m): st name
    if(_): {m < 0} [
        concat(msg): "no member named '" name
        concat(msg): msg "'"
        p_fail(_): msg
    ]
    at(mt): mb_t m
    at(mo): mb_o m
    ty_ptr(pt2): mt
    at(sk): nd_k sv
    if(_): {sk = 1} [
        # offsetof: a constant address
        at(bv): nd_v sv
        nd_num(off): {bv + mo} pt2
    ]
    elif(_): {mo = 0} [
        nd_new(off): 19 pt2 sv 0 0 0
    ]
    else(_): [
        nd_new(off): 27 pt2 sv 0 0 mo
    ]
    nd_new(r): 12 mt off 0 0 0
]
p_deref(r): n [
    p_rval(p): n
    at(t): nd_t p
    at(k): ty_k t
    if(_): {k != 9} [ p_fail(_): "invalid type argument of unary '*'" ]
    at(b): ty_b t
    at(bk): ty_k b
    if(_): {bk = 11} [
        # *f is f for a function pointer
        set(r): p
        return(_): r
    ]
    if(_): {bk = 0} [ p_fail(_): "dereferencing a 'void *' pointer" ]
    nd_new(r): 12 b p 0 0 0
]
p_addr(r): n [
    at(k): nd_k n
    at(t): nd_t n
    at(tk): ty_k t
    if(_): {k = 12} [
        at(p): nd_a n
        at(pt): nd_t p
        ty_ptr(want): t
        set(r): p
        if(_): {pt != want} [ nd_new(r): 19 want p 0 0 0 ]
        return(_): r
    ]
    if(_): {k = 3} [
        at(s): nd_a n
        at(sk): sy_k s
        if(_): {sk = 3} [
            ty_ptr(ft): t
            nd_new(r): 25 ft s 0 0 0
            return(_): r
        ]
        set(sy_at): s 1
        ty_ptr(pt): t
        nd_new(r): 11 pt n 0 0 0
        return(_): r
    ]
    if(_): {k = 4 || k = 47 || (k = 16 && (tk = 12 || tk = 13)) || (k = 17 && (tk = 12 || tk = 13)) || (k = 13 && (tk = 12 || tk = 13))} [
        ty_ptr(pt): t
        nd_new(r): 19 pt n 0 0 0
        return(_): r
    ]
    if(_): {k = 26 || k = 25} [
        # &array decays the same; &function
        set(r): n
        return(_): r
    ]
    p_fail(_): "lvalue required as unary '&' operand"
]
p_islvalue(r): n [
    at(k): nd_k n
    set(r): 0
    if(_): {k = 3 || k = 12} [ set(r): 1 ]
]
p_incdec(r): n post delta [
    p_islvalue(lv): n
    if(_): {lv = 0} [ p_fail(_): "lvalue required as increment operand" ]
    at(t): nd_t n
    at(k): ty_k t
    set(step): delta
    if(_): {k = 9} [
        at(b): ty_b t
        ty_sizeof(es): b p_ln
        set(step): {delta * es}
    ]
    ty_isscalar(sc): t
    if(_): {sc = 0} [ p_fail(_): "wrong type argument to increment" ]
    nd_new(r): 15 t n post step 0
]

# ---- strings ----
# The bytes of one or more adjacent string literals.
p_strlit(r): [
    at(r0): tk_s p_i
    add(p_i): p_i 1
    set(r): r0
    while(_): {1 = 1} [
        at(k): tk_k p_i
        if(_): {k != 4} [ break(_): "" ]
        at(more): tk_s p_i
        if(_): {r = r0} [
            vec(cp): ""
            len(n0): r0
            set(i): 0
            while(_): {i < n0} [
                at(b0): r0 i
                push(_): cp b0
                add(i): i 1
            ]
            set(r): cp
        ]
        len(n): more
        set(j): 0
        while(_): {j < n} [
            at(b): more j
            push(_): r b
            add(j): j 1
        ]
        add(p_i): p_i 1
    ]
]
# A string literal node for the bytes sv: static storage set up before
# main runs.
p_strnode(r): sv [
    len(n): sv
    ty_arr(t): ty_char {n + 1}
    set(addr): g_top
    add(g_top): g_top {n + 1}
    set(g_top): {(g_top + 7) - (g_top + 7) % 8}
    push(_): p_strs addr
    push(_): p_strs sv
    nd_new(r): 4 t 0 0 0 addr
]

# ---- expressions ----
p_expr(r): [
    p_assign(r):
    while(_): {1 = 1} [
        p_accept(cm): ","
        if(_): {cm = 0} [ break(_): "" ]
        p_assign(b):
        p_rval(b2): b
        at(bt): nd_t b2
        nd_new(r): 18 bt r b2 0 0
    ]
]
p_assign(r): [
    p_cond(r):
    at(k): tk_k p_i
    if(_): {k != 5} [ return(_): r ]
    at(s): tk_s p_i
    set(op): 0
    if(_): {s = "="} [ set(op): 1 ]
    elif(_): {s = "+="} [ set(op): 16 ]
    elif(_): {s = "-="} [ set(op): 17 ]
    elif(_): {s = "*="} [ set(op): 18 ]
    elif(_): {s = "/="} [ set(op): 19 ]
    elif(_): {s = "%="} [ set(op): 20 ]
    elif(_): {s = "&="} [ set(op): 31 ]
    elif(_): {s = "|="} [ set(op): 32 ]
    elif(_): {s = "^="} [ set(op): 30 ]
    elif(_): {s = "<<="} [ set(op): 33 ]
    elif(_): {s = ">>="} [ set(op): 34 ]
    if(_): {op = 0} [ return(_): r ]
    p_mark(_):
    add(p_i): p_i 1
    p_islvalue(lv): r
    if(_): {lv = 0} [ p_fail(_): "lvalue required as left operand of assignment" ]
    p_assign(rhs):
    if(_): {op = 1} [
        p_new_assign(r): r rhs
        return(_): r
    ]
    # a op= b: the operation in a's and b's common type (or pointer step)
    at(t): nd_t r
    at(tk): ty_k t
    p_rval(b): rhs
    at(bt): nd_t b
    if(_): {tk = 9 && (op = 16 || op = 17)} [
        at(base): ty_b t
        ty_sizeof(es): base p_ln
        p_conv(b): b ty_long
        if(_): {es != 1} [
            nd_num(sz): es ty_long
            p_fold(b): 18 b sz ty_long
        ]
        nd_new(r): 14 t r b op t
        return(_): r
    ]
    ty_isarith(ia): t
    ty_isarith(ib): bt
    if(_): {ia = 0 || ib = 0} [ p_fail(_): "invalid operands to compound assignment" ]
    if(_): {op = 33 || op = 34} [
        ty_promote(ct): t
        ty_promote(st): bt
        p_conv(b): b st
    ]
    else(_): [
        ty_common(ct): t bt
        p_conv(b): b ct
    ]
    nd_new(r): 14 t r b op ct
]
p_cond(r): [
    p_bin(r): 0
    p_is(q): "?"
    if(_): {q = 0} [ return(_): r ]
    p_mark(_):
    add(p_i): p_i 1
    p_rval(c): r
    # GNU a ?: b
    p_is(el): ":"
    if(_): {el = 1} [
        set(a): c
    ]
    else(_): [
        p_expr(a):
    ]
    p_expect(_): ":"
    p_cond(b):
    p_rval(a): a
    p_rval(b): b
    at(ta): nd_t a
    at(tb): nd_t b
    set(t): ta
    ty_isarith(ia): ta
    ty_isarith(ib): tb
    if(_): {ia = 1 && ib = 1} [
        ty_common(t): ta tb
        p_conv(a): a t
        p_conv(b): b t
    ]
    else(_): [
        at(ka): ty_k ta
        at(kb): ty_k tb
        p_isnullconst(na): a
        p_isnullconst(nb): b
        if(_): {ka = 9 && nb = 1} [ p_conv(b): b ta ]
        elif(_): {kb = 9 && na = 1} [
            set(t): tb
            p_conv(a): a tb
        ]
        elif(_): {ka = 9 && kb = 9} [
            # void * against another pointer: the other
            at(ba): ty_b ta
            at(bak): ty_k ba
            if(_): {bak = 0} [ set(t): tb ]
        ]
        elif(_): {ka = 0 || kb = 0} [ set(t): ty_void ]
    ]
    nd_new(r): 17 t c a b 0
    p_ceval(cv): c
    if(_): {cv != null} [
        at(ak): nd_k a
        at(bk): nd_k b
        if(_): {ak = 1 && bk = 1} [
            if(_): {cv != 0} [ set(r): a ]
            else(_): [ set(r): b ]
        ]
    ]
]
# Binding strength of a binary operator token, 0 for none; p_bop gets
# its opcode (or 6 &&, 7 ||).
global(_): p_bop
p_prec(r): s [
    set(r): 0
    if(_): {s = "||"} [
        set(r): 1
        set(p_bop): 7
    ]
    elif(_): {s = "&&"} [
        set(r): 2
        set(p_bop): 6
    ]
    elif(_): {s = "|"} [
        set(r): 3
        set(p_bop): 32
    ]
    elif(_): {s = "^"} [
        set(r): 4
        set(p_bop): 30
    ]
    elif(_): {s = "&"} [
        set(r): 5
        set(p_bop): 31
    ]
    elif(_): {s = "=="} [
        set(r): 6
        set(p_bop): 22
    ]
    elif(_): {s = "!="} [
        set(r): 6
        set(p_bop): 23
    ]
    elif(_): {s = "<"} [
        set(r): 7
        set(p_bop): 24
    ]
    elif(_): {s = "<="} [
        set(r): 7
        set(p_bop): 25
    ]
    elif(_): {s = ">"} [
        set(r): 7
        set(p_bop): 26
    ]
    elif(_): {s = ">="} [
        set(r): 7
        set(p_bop): 27
    ]
    elif(_): {s = "<<"} [
        set(r): 8
        set(p_bop): 33
    ]
    elif(_): {s = ">>"} [
        set(r): 8
        set(p_bop): 34
    ]
    elif(_): {s = "+"} [
        set(r): 9
        set(p_bop): 16
    ]
    elif(_): {s = "-"} [
        set(r): 9
        set(p_bop): 17
    ]
    elif(_): {s = "*"} [
        set(r): 10
        set(p_bop): 18
    ]
    elif(_): {s = "/"} [
        set(r): 10
        set(p_bop): 19
    ]
    elif(_): {s = "%"} [
        set(r): 10
        set(p_bop): 20
    ]
]
p_bin(r): minp [
    p_cast(r):
    while(_): {1 = 1} [
        at(k): tk_k p_i
        if(_): {k != 5} [ break(_): "" ]
        at(s): tk_s p_i
        p_prec(pr): s
        if(_): {pr = 0 || pr <= minp} [ break(_): "" ]
        set(op): p_bop
        p_mark(_):
        add(p_i): p_i 1
        p_bin(b): pr
        if(_): {op = 6 || op = 7} [
            p_rval(a2): r
            p_rval(b2): b
            nd_new(n): op ty_int a2 b2 0 0
            p_ceval(cv): n
            set(r): n
            if(_): {cv != null} [ nd_num(r): cv ty_int ]
        ]
        else(_): [
            p_binop(r): op r b
        ]
    ]
]
p_cast(r): [
    p_is(lp): "("
    if(_): {lp = 1} [
        add(nx): p_i 1
        p_istype_at(isty): nx
        if(_): {isty = 1} [
            p_mark(_):
            add(p_i): p_i 1
            p_typename(t):
            p_expect(_): ")"
            p_is(br): "{"
            if(_): {br = 1} [
                p_complit(r): t
                p_postfix(r): r
                return(_): r
            ]
            p_cast(e):
            at(tk): ty_k t
            if(_): {tk = 0} [
                p_rval(e2): e
                nd_new(r): 19 ty_void e2 0 0 0
                return(_): r
            ]
            ty_isscalar(sc): t
            if(_): {sc = 0} [ p_fail(_): "conversion to non-scalar type requested" ]
            p_rval(e2): e
            at(et): nd_t e2
            ty_isscalar(esc): et
            if(_): {esc = 0} [ p_fail(_): "aggregate value used where a scalar was expected" ]
            p_conv(r): e2 t
            if(_): {r = e2} [
                # keep a node of its own for the cast's type
                nd_new(r): 19 t e2 0 0 0
            ]
            return(_): r
        ]
    ]
    p_unary(r):
]
# A compound literal (type){...}: an unnamed object, as an lvalue.
p_complit(r): t [
    sy_new(s): "%lit" 1 t
    if(_): {p_fn < 0} [
        set(sy_st): s 1
        p_initializer(init): s
        p_alloc(_): s
        push(_): p_ginit init
        at(t2): sy_t s
        nd_new(r): 3 t2 s 0 0 0
    ]
    else(_): [
        set(sy_st): s 2
        push(_): p_fsyms s
        p_initializer(init): s
        at(t2): sy_t s
        nd_new(v): 3 t2 s 0 0 0
        nd_new(r): 47 t2 init v 0 0
    ]
]
p_unary(r): [
    p_mark(_):
    at(k): tk_k p_i
    if(_): {k = 5} [
        at(s): tk_s p_i
        if(_): {s = "++" || s = "--"} [
            add(p_i): p_i 1
            p_unary(e):
            set(d): 1
            if(_): {s = "--"} [ set(d): {0 - 1} ]
            p_incdec(r): e 0 d
            return(_): r
        ]
        if(_): {s = "&"} [
            add(p_i): p_i 1
            p_cast(e):
            p_addr(r): e
            return(_): r
        ]
        if(_): {s = "*"} [
            add(p_i): p_i 1
            p_cast(e):
            p_deref(r): e
            return(_): r
        ]
        if(_): {s = "+" || s = "-" || s = "~"} [
            add(p_i): p_i 1
            p_cast(e):
            p_rval(e2): e
            at(t): nd_t e2
            ty_isarith(ia): t
            if(_): {ia = 0} [ p_fail(_): "wrong type argument to unary operator" ]
            ty_promote(pt): t
            p_conv(e3): e2 pt
            set(r): e3
            if(_): {s = "-"} [
                nd_new(r): 9 pt e3 0 0 0
            ]
            if(_): {s = "~"} [
                ty_isflt(fl): pt
                if(_): {fl = 1} [ p_fail(_): "wrong type argument to bit-complement" ]
                nd_new(r): 10 pt e3 0 0 0
            ]
            p_ceval(cv): r
            ty_isint(ii): pt
            if(_): {cv != null && ii = 1} [ nd_num(r): cv pt ]
            return(_): r
        ]
        if(_): {s = "!"} [
            add(p_i): p_i 1
